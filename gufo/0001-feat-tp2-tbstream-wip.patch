new file mode 100644
index 0000000..72d6fa1
--- /dev/null
+++ b/tests/models/glm5_next/tokenizer_test.cpp
@@ -0,0 +1,204 @@
+// GLM-4 pre-tokenization contract of the shared Qwen tokenizer: digits
+// group one to three per piece (vs Qwen's single digit) and there is no
+// NFC normalization. Full-vocabulary parity against the official
+// tokenizer.json is qualified locally against the artifact (see the
+// glm5_next_tokenizer_probe and the goldens in the plan's evidence).
+
+#include "src/models/qwen/tokenizer.hpp"
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <string>
+#include <vector>
+
+#include "src/core/gguf_reader.hpp"
+
+namespace {
+
+using gufo::tokenization::TokenId;
+using gufo::tokenization::TokenizerOptions;
+
+void Require(bool condition, const char* message) {
+  if (!condition) {
+    std::fprintf(stderr, "FAIL: %s\n", message);
+    std::exit(1);
+  }
+}
+
+// Minimal GGUF writer for tokenizer metadata (the qwen tokenizer tests
+// use the same technique).
+class Builder {
+public:
+  void String(const std::string& key, const std::string& value) {
+    fields_[key] = value;
+  }
+  void Uint32(const std::string& key, std::uint32_t value) {
+    u32_[key] = value;
+  }
+  void Tokens(const std::vector<std::string>& tokens) { tokens_ = tokens; }
+  void Merges(const std::vector<std::string>& merges) { merges_ = merges; }
+  void TokenTypes(const std::vector<std::uint64_t>& types) { types_ = types; }
+
+  std::vector<std::uint8_t> Build() && {
+    std::vector<std::uint8_t> bytes;
+    const auto pod = [&]<class T>(T value) {
+      const auto begin = bytes.size();
+      bytes.resize(begin + sizeof(value));
+      std::memcpy(bytes.data() + begin, &value, sizeof(value));
+    };
+    const auto text = [&](const std::string& value) {
+      pod(std::uint64_t{value.size()});
+      bytes.insert(bytes.end(), value.begin(), value.end());
+    };
+    const auto array_header = [&](std::uint32_t type, std::uint64_t count) {
+      pod(std::uint32_t{9});
+      pod(type);
+      pod(count);
+    };
+    pod(std::uint32_t{0x46554747});
+    pod(std::uint32_t{3});
+    pod(std::uint64_t{0});
+    const std::uint64_t fields =
+        u32_.size() + fields_.size() + 2 + (types_.empty() ? 0 : 1);
+    pod(fields);
+    for (const auto& [key, value] : u32_) {
+      text(key);
+      pod(std::uint32_t{4});
+      pod(value);
+    }
+    for (const auto& [key, value] : fields_) {
+      text(key);
+      pod(std::uint32_t{8});
+      text(value);
+    }
+    text("tokenizer.ggml.tokens");
+    array_header(8, tokens_.size());
+    for (const auto& token : tokens_) {
+      text(token);
+    }
+    text("tokenizer.ggml.merges");
+    array_header(8, merges_.size());
+    for (const auto& merge : merges_) {
+      text(merge);
+    }
+    if (!types_.empty()) {
+      text("tokenizer.ggml.token_type");
+      array_header(10, types_.size());
+      for (const auto type : types_) {
+        pod(type);
+      }
+    }
+    bytes.resize((bytes.size() + 31) / 32 * 32);
+    return bytes;
+  }
+
+private:
+  std::map<std::string, std::uint32_t> u32_;
+  std::map<std::string, std::string> fields_;
+  std::vector<std::string> tokens_;
+  std::vector<std::string> merges_;
+  std::vector<std::uint64_t> types_;
+};
+
+std::unique_ptr<gufo::tokenization::QwenTokenizer> Load(
+    const std::string& pre, const std::vector<std::string>& extra_tokens,
+    const std::vector<std::string>& merges,
+    const std::vector<std::uint64_t>& special_indexes = {}) {
+  Builder builder;
+  builder.String("tokenizer.ggml.model", "gpt2");
+  builder.String("tokenizer.ggml.pre", pre);
+  builder.Uint32("tokenizer.ggml.eos_token_id", 0);
+  std::vector<std::string> tokens;
+  tokens.reserve(256 + extra_tokens.size());
+  for (int i = 0; i < 256; ++i) {
+    tokens.emplace_back(1, static_cast<char>(i));
+  }
+  tokens.insert(tokens.end(), extra_tokens.begin(), extra_tokens.end());
+  builder.Tokens(tokens);
+  builder.Merges(merges);
+  if (!special_indexes.empty()) {
+    std::vector<std::uint64_t> types(tokens.size(), 1);
+    for (std::uint64_t index : special_indexes) {
+      types.at(index) = 3;  // CONTROL
+    }
+    builder.TokenTypes(types);
+  }
+  auto bytes = std::move(builder).Build();
+  std::string error;
+  auto reader =
+      gufo::core::GgufReader::OpenMemory(bytes.data(), bytes.size(), &error);
+  Require(reader != nullptr, error.c_str());
+  auto tokenizer =
+      gufo::tokenization::QwenTokenizer::CreateFromGguf(*reader, &error);
+  Require(tokenizer != nullptr, error.c_str());
+  return tokenizer;
+}
+
+std::string Ids(const std::vector<TokenId>& tokens) {
+  std::string out;
+  for (auto token : tokens) {
+    out += std::to_string(token) + " ";
+  }
+  return out;
+}
+
+}  // namespace
+
+int main() {
+  // Byte-identity tokens plus "123" reachable through two merges; the
+  // intermediate "12" must exist or a ranked pair without a vocabulary
+  // entry stops the merge chain.
+  const std::vector<std::string> extra{"12", "123"};
+  const std::vector<std::string> merges{"1 2", "12 3"};
+  const auto glm = Load("glm4", extra, merges);
+  const auto qwen = Load("qwen35", extra, merges);
+  const TokenizerOptions options;
+
+  // Digit grouping: glm4 emits "123" as one piece (merged) then the rest
+  // digit by digit; qwen35 splits every digit.
+  const auto glm_number = glm->Encode("1234567", options);
+  const auto qwen_number = qwen->Encode("1234567", options);
+  Require(glm_number.size() == 5, "glm4 groups one to three digits");
+  Require(glm_number.front() == 257, "the merged 123 token is used");
+  Require(qwen_number.size() == 7, "qwen35 keeps single digits");
+
+  // No NFC: decomposed e + U+0301 stays three UTF-8 bytes under glm4 and
+  // collapses to the two-byte precomposed form under qwen35.
+  const std::string decomposed = "e\xCC\x81";
+  const auto glm_decomposed = glm->Encode(decomposed, options);
+  const auto qwen_decomposed = qwen->Encode(decomposed, options);
+  Require(glm_decomposed.size() == 3, "glm4 applies no NFC normalization");
+  Require(qwen_decomposed.size() == 2, "qwen35 NFC normalization retained");
+  Require(glm->Encode("\xC3\xA9", options).size() == 2,
+          "precomposed input is untouched under glm4");
+
+  // Everything else shares the Qwen split shape: contractions stay whole.
+  const auto glm_it = glm->Encode("it's", options);
+  const auto qwen_it = qwen->Encode("it's", options);
+  Require(glm_it == qwen_it, "contractions split identically");
+
+  // token_type CONTROL entries become specials even when the name
+  // heuristics miss them: [gMASK] and <sop> at the end of the vocabulary.
+  const std::vector<std::string> framing{"[gMASK]", "<sop>"};
+  const auto glm_framing = Load("glm4", framing, {}, {256, 257});
+  TokenId gmask = 0;
+  TokenId sop = 0;
+  {
+    gufo::tokenization::TokenizerOptions parse;
+    parse.parse_special_tokens = true;
+    const auto ids = glm_framing->Encode("[gMASK]<sop>", parse);
+    Require(ids.size() == 2, "framing tokens are single specials");
+    gmask = ids.front();
+    sop = ids.back();
+  }
+  Require(
+      glm_framing->IsSpecialToken(gmask) && glm_framing->IsSpecialToken(sop),
+      "token_type CONTROL marks specials");
+  Require(gmask == 256 && sop == 257, "special ids follow the vocabulary");
+
+  std::puts("PASS: glm5_next GLM-4 pre-tokenizer contract");
+  return 0;
+}
diff --git a/tests/models/glm5_next/tp_load_probe.cpp b/tests/models/glm5_next/tp_load_probe.cpp
new file mode 100644
index 0000000..cd2c618
--- /dev/null
+++ b/tests/models/glm5_next/tp_load_probe.cpp
@@ -0,0 +1,355 @@
+// P3.2: loads the trunk with a TP partition on this host's device and
+// byte-verifies every rank-local tensor share against the GGUF mapping.
+//
+//   glm5_next_tp_load_probe --model FIRST_SHARD.gguf [--rank 0|1]
+//     [--layers N] [--verify full|sample|off] [--json]
+//
+// The byte check downloads each tensor's local encoded bytes (fully, or
+// first/middle/last spans when sampling) and compares them against the
+// expected file bytes for the tensor's span: contiguous ranges directly,
+// per-expert row ranges per expert, column spans per row. Content
+// qualification, not a byte ledger. Prints the resident ledger, load time
+// and HIP memory headroom.
+#include <hip/hip_runtime.h>
+
+#include <algorithm>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "src/core/gguf_reader.hpp"
+#include "src/core/quant/ggml_dequant.hpp"
+#include "src/models/glm5_next/distributed/tp_partition.hpp"
+#include "src/models/glm5_next/kernels/rocm/device_model.hpp"
+#include "src/models/glm5_next/weights.hpp"
+
+namespace glm = gufo::models::glm5_next;
+namespace dist = glm::distributed;
+namespace rocm = glm::rocm;
+
+namespace {
+
+int failures = 0;
+
+void Fail(const std::string& message) {
+  std::fprintf(stderr, "FAIL: %s\n", message.c_str());
+  ++failures;
+}
+
+constexpr std::size_t kSample = 4096;
+
+using gufo::core::GgmlType;
+
+std::size_t SpanBytes(GgmlType type, std::size_t elements) {
+  switch (type) {
+    case GgmlType::kF32:
+    case GgmlType::kI32:
+      return elements * 4;
+    case GgmlType::kF16:
+    case GgmlType::kBF16:
+      return elements * 2;
+    default:
+      return gufo::quant::QuantizedRowBytes(type, elements);
+  }
+}
+
+/// Fills `out` with the expected local bytes [at, at + n) of one tensor's
+/// share, reading from the mapped GGUF payload. `at + n` must stay inside
+/// the share.
+void ExpectedLocal(const glm::TensorRef& t, const dist::TensorSpan& span,
+                   std::size_t at, std::size_t n, std::uint8_t* out) {
+  const std::uint8_t* base = static_cast<const std::uint8_t*>(t.data);
+  const std::size_t row_bytes = t.RowBytes();
+  switch (span.kind) {
+    case dist::TensorSpanKind::kFull:
+    case dist::TensorSpanKind::kElements: {
+      const std::size_t skip =
+          span.kind == dist::TensorSpanKind::kElements
+              ? SpanBytes(t.type, static_cast<std::size_t>(span.begin))
+              : 0;
+      std::memcpy(out, base + skip + at, n);
+      return;
+    }
+    case dist::TensorSpanKind::kRows: {
+      if (!span.per_expert) {
+        std::memcpy(out, base + span.begin * row_bytes + at, n);
+        return;
+      }
+      const std::size_t share =
+          static_cast<std::size_t>(span.count) * row_bytes;
+      const std::size_t e = at / share;
+      const std::size_t within = at % share;
+      const std::size_t run = std::min(n, share - within);
+      std::memcpy(out, base + (e * t.rows + span.begin) * row_bytes + within,
+                  run);
+      if (run < n) {
+        ExpectedLocal(t, span, at + run, n - run, out + run);
+      }
+      return;
+    }
+    case dist::TensorSpanKind::kStack: {
+      const std::size_t matrix = row_bytes * t.rows;
+      std::memcpy(out, base + span.begin * matrix + at, n);
+      return;
+    }
+    case dist::TensorSpanKind::kColumns: {
+      const std::size_t span_bytes =
+          SpanBytes(t.type, static_cast<std::size_t>(span.count));
+      const std::size_t span_off =
+          SpanBytes(t.type, static_cast<std::size_t>(span.begin));
+      std::size_t done = 0;
+      while (done < n) {
+        const std::size_t row = (at + done) / span_bytes;
+        const std::size_t within = (at + done) % span_bytes;
+        const std::size_t run = std::min(n - done, span_bytes - within);
+        const std::size_t rows_per_expert = t.rows;
+        const std::size_t e = row / rows_per_expert;
+        const std::size_t r = row % rows_per_expert;
+        std::memcpy(out + done,
+                    base + e * row_bytes * rows_per_expert + r * row_bytes +
+                        span_off + within,
+                    run);
+        done += run;
+      }
+      return;
+    }
+  }
+}
+
+/// Downloads and compares one tensor's local share.
+void VerifyTensor(const glm::TensorRef& t, const dist::TensorSpan& span,
+                  const rocm::DeviceTensor& d, bool full,
+                  std::size_t* checked_bytes) {
+  if (d.empty() || span.local_bytes == 0) {
+    return;
+  }
+  const std::size_t size = span.local_bytes;
+  std::vector<std::uint8_t> got(std::min<std::size_t>(size, kSample));
+  std::vector<std::uint8_t> expect(got.size());
+  const auto check = [&](const char* what, std::size_t at) {
+    const std::size_t n = std::min(got.size(), size - at);
+    if (n == 0) {
+      return;
+    }
+    if (hipMemcpy(got.data(), static_cast<const std::uint8_t*>(d.data) + at, n,
+                  hipMemcpyDeviceToHost) != hipSuccess) {
+      Fail(std::string(t.name) + ": download failed at " + what);
+      return;
+    }
+    ExpectedLocal(t, span, at, n, expect.data());
+    if (std::memcmp(got.data(), expect.data(), n) != 0) {
+      Fail(std::string(t.name) + ": local bytes mismatch at " + what);
+      return;
+    }
+    *checked_bytes += n;
+  };
+  if (full || size <= kSample) {
+    std::vector<std::uint8_t> all(size);
+    if (hipMemcpy(all.data(), d.data, size, hipMemcpyDeviceToHost) !=
+        hipSuccess) {
+      Fail(std::string(t.name) + ": download failed");
+      return;
+    }
+    std::vector<std::uint8_t> want(size);
+    ExpectedLocal(t, span, 0, size, want.data());
+    if (all != want) {
+      Fail(std::string(t.name) + ": local bytes mismatch");
+    }
+    *checked_bytes += size;
+    return;
+  }
+  check("head", 0);
+  check("middle", size / 2 & ~static_cast<std::size_t>(15));
+  check("tail", size - kSample);
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+  std::string model_path;
+  std::uint32_t rank = 0;
+  std::uint32_t layers = 0;
+  std::string verify = "sample";
+  bool json = false;
+  for (int i = 1; i < argc; ++i) {
+    const std::string arg = argv[i];
+    auto next = [&]() -> std::string {
+      return i + 1 < argc ? argv[++i] : std::string();
+    };
+    if (arg == "--model") {
+      model_path = next();
+    } else if (arg == "--rank") {
+      rank = static_cast<std::uint32_t>(std::atoi(next().c_str()));
+    } else if (arg == "--layers") {
+      layers = static_cast<std::uint32_t>(std::atoi(next().c_str()));
+    } else if (arg == "--verify") {
+      verify = next();
+    } else if (arg == "--json") {
+      json = true;
+    } else {
+      std::fprintf(stderr, "unknown argument %s\n", arg.c_str());
+      return 2;
+    }
+  }
+  if (model_path.empty()) {
+    std::fprintf(stderr, "--model is required\n");
+    return 2;
+  }
+
+  std::string error;
+  auto reader = gufo::core::GgufReader::OpenFile(model_path, &error);
+  if (!reader) {
+    Fail("open: " + error);
+    return 1;
+  }
+  auto weights = glm::ModelWeights::Bind(*reader, &error);
+  if (!weights) {
+    Fail("bind: " + error);
+    return 1;
+  }
+  const std::uint32_t total_layers =
+      layers != 0 ? layers : weights->config.num_layers;
+  auto partition = dist::TpPartition::Create(weights->config, rank, 2, &error);
+  if (!partition) {
+    Fail("partition: " + error);
+    return 1;
+  }
+  std::uint64_t free_before = 0;
+  std::uint64_t total_mem = 0;
+  (void)hipMemGetInfo(&free_before, &total_mem);
+  const auto start = std::chrono::steady_clock::now();
+  auto slice = rocm::DeviceSlice::Upload(*weights, *reader, total_layers,
+                                         &*partition, &error);
+  const auto load_ms = std::chrono::duration<double, std::milli>(
+                           std::chrono::steady_clock::now() - start)
+                           .count();
+  if (!slice) {
+    Fail("upload: " + error);
+    return 1;
+  }
+  std::uint64_t free_after = 0;
+  (void)hipMemGetInfo(&free_after, &total_mem);
+
+  std::size_t checked_tensors = 0;
+  std::size_t checked_bytes = 0;
+  if (verify != "off") {
+    auto planned = dist::PlanModelTensors(*weights, *partition, &error);
+    if (!planned) {
+      Fail("plan: " + error);
+      return 1;
+    }
+    std::map<const glm::TensorRef*, dist::TensorSpan> spans;
+    for (const auto& entry : *planned) {
+      spans.emplace(entry.tensor, entry.span);
+    }
+    const auto span_of = [&](const glm::TensorRef& t) {
+      const auto it = spans.find(&t);
+      return it != spans.end() ? it->second : dist::TensorSpan{};
+    };
+    const bool full = verify == "full";
+    const auto visit = [&](const glm::TensorRef& t,
+                           const rocm::DeviceTensor& d) {
+      const auto found = spans.find(&t);
+      if (found == spans.end() || d.empty()) {
+        return;
+      }
+      VerifyTensor(t, found->second, d, full, &checked_bytes);
+      ++checked_tensors;
+    };
+    visit(weights->token_embd, slice->token_embd());
+    visit(weights->output, slice->output());
+    visit(weights->output_norm, slice->output_norm());
+    for (std::uint32_t l = 0; l < slice->layer_count(); ++l) {
+      const glm::LayerWeights& w = weights->layers[l];
+      const rocm::DeviceLayer& d = slice->layers()[l];
+      visit(w.attn_norm, d.attn_norm);
+      visit(w.ffn_norm, d.ffn_norm);
+      visit(w.hc_attn.fn, d.hc_attn.fn);
+      visit(w.hc_attn.base, d.hc_attn.base);
+      visit(w.hc_attn.scale, d.hc_attn.scale);
+      visit(w.hc_ffn.fn, d.hc_ffn.fn);
+      visit(w.hc_ffn.base, d.hc_ffn.base);
+      visit(w.hc_ffn.scale, d.hc_ffn.scale);
+      visit(w.kda.q, d.kda.q);
+      visit(w.kda.k, d.kda.k);
+      visit(w.kda.v, d.kda.v);
+      visit(w.kda.out, d.kda.out);
+      visit(w.kda.conv_q, d.kda.conv_q);
+      visit(w.kda.conv_k, d.kda.conv_k);
+      visit(w.kda.conv_v, d.kda.conv_v);
+      visit(w.kda.f_a, d.kda.f_a);
+      visit(w.kda.f_b, d.kda.f_b);
+      visit(w.kda.g_a, d.kda.g_a);
+      visit(w.kda.g_b, d.kda.g_b);
+      visit(w.kda.beta, d.kda.beta);
+      visit(w.kda.a, d.kda.a);
+      visit(w.kda.dt_bias, d.kda.dt_bias);
+      visit(w.kda.o_norm, d.kda.o_norm);
+      visit(w.dsa.q_a, d.dsa.q_a);
+      visit(w.dsa.q_a_norm, d.dsa.q_a_norm);
+      visit(w.dsa.q_b, d.dsa.q_b);
+      visit(w.dsa.kv_a, d.dsa.kv_a);
+      visit(w.dsa.kv_a_norm, d.dsa.kv_a_norm);
+      visit(w.dsa.k_b, d.dsa.k_b);
+      visit(w.dsa.v_b, d.dsa.v_b);
+      visit(w.dsa.out, d.dsa.out);
+      visit(w.indexer.q_b, d.indexer.q_b);
+      visit(w.indexer.k, d.indexer.k);
+      visit(w.indexer.k_norm, d.indexer.k_norm);
+      visit(w.indexer.k_norm_bias, d.indexer.k_norm_bias);
+      visit(w.indexer.proj, d.indexer.proj);
+      visit(w.indexer.comp_gate, d.indexer.comp_gate);
+      visit(w.indexer.comp_ape, d.indexer.comp_ape);
+      visit(w.ffn_gate, d.ffn_gate);
+      visit(w.ffn_up, d.ffn_up);
+      visit(w.ffn_down, d.ffn_down);
+      visit(w.router, d.router);
+      visit(w.router_bias, d.router_bias);
+      visit(w.gate_exps, d.gate_exps);
+      visit(w.up_exps, d.up_exps);
+      visit(w.down_exps, d.down_exps);
+      visit(w.gate_shexp, d.gate_shexp);
+      visit(w.up_shexp, d.up_shexp);
+      visit(w.down_shexp, d.down_shexp);
+    }
+    (void)span_of;
+  }
+
+  if (json) {
+    std::printf(
+        "{\"rank\":%u,\"layers\":%u,\"tensors\":%zu,\"encoded\":%zu,"
+        "\"resident\":%zu,\"load_ms\":%.0f,\"hip_free_gib\":%.3f,"
+        "\"hip_total_gib\":%.3f,\"checked_tensors\":%zu,"
+        "\"checked_bytes\":%zu,\"failures\":%d}\n",
+        rank, slice->layer_count(), slice->tensor_count(),
+        slice->encoded_bytes(), slice->resident_bytes(), load_ms,
+        static_cast<double>(free_after) / (1024.0 * 1024.0 * 1024.0),
+        static_cast<double>(total_mem) / (1024.0 * 1024.0 * 1024.0),
+        checked_tensors, checked_bytes, failures);
+  } else {
+    std::printf(
+        "rank %u: %u layers, %zu tensors, encoded %.3f GiB, resident "
+        "%.3f GiB (tails incl.), load %.1fs, hip free %.3f of %.3f GiB\n",
+        rank, slice->layer_count(), slice->tensor_count(),
+        static_cast<double>(slice->encoded_bytes()) / (1024 * 1024 * 1024.0),
+        static_cast<double>(slice->resident_bytes()) / (1024 * 1024 * 1024.0),
+        load_ms / 1000.0,
+        static_cast<double>(free_after) / (1024 * 1024 * 1024.0),
+        static_cast<double>(total_mem) / (1024 * 1024 * 1024.0));
+    if (verify != "off") {
+      std::printf("verify %s: %zu tensors, %zu bytes checked\n", verify.c_str(),
+                  checked_tensors, checked_bytes);
+    }
+  }
+  if (failures != 0) {
+    return 1;
+  }
+  std::puts("PASS: glm5_next TP load probe");
+  return 0;
+}
