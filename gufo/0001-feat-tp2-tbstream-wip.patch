+function(add_glm5_next_test name labels)
+  set(target glm5_next_${name}_test)
+  add_executable(${target} ${name}_test.cpp)
+  target_link_libraries(${target} PRIVATE gufo_glm5_next)
+  add_test(NAME glm5_next.${name} COMMAND ${target})
+  set_tests_properties(glm5_next.${name} PROPERTIES
+    LABELS "glm5_next;${labels}")
+  add_dependencies(glm5_next_tests ${target})
+endfunction()
+
+add_glm5_next_test(config "cpu")
+add_glm5_next_test(tp_plan "cpu")
+add_glm5_next_test(tp_partition "cpu")
+add_glm5_next_test(reference "cpu")
+add_glm5_next_test(tokenizer "cpu")
+add_glm5_next_test(chat_template "cpu")
+
+# Opens a real GLM-5.3-Flash GGUF, binds every tensor and prints the TP=1
+# and TP=2 ledgers. Runs on demand against the pinned artifact.
+add_executable(glm5_next_inventory_probe EXCLUDE_FROM_ALL inventory_probe.cpp)
+target_link_libraries(glm5_next_inventory_probe PRIVATE gufo_glm5_next)
+
+# Encodes the official tokenizer.json goldens through the artifact's
+# vocabulary (all tokenizer metadata lives in shard one).
+add_executable(glm5_next_tokenizer_probe EXCLUDE_FROM_ALL tokenizer_probe.cpp)
+target_link_libraries(glm5_next_tokenizer_probe PRIVATE gufo_glm5_next)
