+++ b/src/models/glm5_next/reference.cpp
@@ -0,0 +1,907 @@
+#include "src/models/glm5_next/reference.hpp"
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <limits>
+#include <numeric>
+#include <utility>
+
+#include "src/core/quant/ggml_dequant.hpp"
+
+namespace gufo::models::glm5_next {
+namespace {
+
+constexpr float kL2Eps = 1e-6F;
+
+float Bf16ToFloat(std::uint16_t h) noexcept {
+  const std::uint32_t bits = static_cast<std::uint32_t>(h) << 16;
+  float out;
+  std::memcpy(&out, &bits, sizeof(out));
+  return out;
+}
+
+float Sigmoid(float x) noexcept {
+  return 1.0F / (1.0F + std::exp(-x));
+}
+
+float Silu(float x) noexcept {
+  return x / (1.0F + std::exp(-x));
+}
+
+void RmsNormInto(std::span<const float> x, std::span<const float> weight,
+                 float eps, std::span<float> out) {
+  double sum = 0.0;
+  for (float v : x) {
+    sum += static_cast<double>(v) * v;
+  }
+  const float inv = static_cast<float>(
+      1.0F / std::sqrt(sum / static_cast<double>(x.size()) + eps));
+  for (std::size_t i = 0; i < x.size(); ++i) {
+    out[i] = weight[i] * (x[i] * inv);
+  }
+}
+
+}  // namespace
+
+void IndexerLayerNorm(std::span<const float> x, std::span<const float> weight,
+                      std::span<const float> bias, float eps,
+                      std::span<float> out) {
+  double mean = 0.0;
+  for (float v : x) {
+    mean += v;
+  }
+  mean /= static_cast<double>(x.size());
+  double var = 0.0;
+  for (float v : x) {
+    var += static_cast<double>(v - mean) * (v - mean);
+  }
+  const float inv = static_cast<float>(
+      1.0F / std::sqrt(var / static_cast<double>(x.size()) + eps));
+  for (std::size_t i = 0; i < x.size(); ++i) {
+    const float centered = static_cast<float>(static_cast<double>(x[i]) - mean);
+    out[i] = weight[i] * (centered * inv) + bias[i];
+  }
+}
+
+void DequantTensorRow(const TensorRef& t, std::uint64_t row,
+                      std::uint64_t expert, float* dst) {
+  const auto* base = t.Expert(expert) + row * t.RowBytes();
+  const std::size_t cols = static_cast<std::size_t>(t.cols);
+  switch (t.type) {
+    case core::GgmlType::kF32:
+      std::memcpy(dst, base, cols * sizeof(float));
+      return;
+    case core::GgmlType::kF16: {
+      const auto* src = reinterpret_cast<const std::uint16_t*>(base);
+      for (std::size_t i = 0; i < cols; ++i) {
+        dst[i] = gufo::quant::Fp16ToFloat(src[i]);
+      }
+      return;
+    }
+    case core::GgmlType::kBF16: {
+      const auto* src = reinterpret_cast<const std::uint16_t*>(base);
+      for (std::size_t i = 0; i < cols; ++i) {
+        dst[i] = Bf16ToFloat(src[i]);
+      }
+      return;
+    }
+    case core::GgmlType::kQ8_0:
+      gufo::quant::DequantizeQ8_0(base, dst, cols);
+      return;
+    case core::GgmlType::kQ4_K:
+      gufo::quant::DequantizeQ4_K(base, dst, cols);
+      return;
+    case core::GgmlType::kQ5_K:
+      gufo::quant::DequantizeQ5_K(base, dst, cols);
+      return;
+    case core::GgmlType::kQ6_K:
+      gufo::quant::DequantizeQ6_K(base, dst, cols);
+      return;
+    default:
+      throw std::invalid_argument("unsupported tensor format in " +
+                                  std::string(t.name));
+  }
+}
+
+float DotTensorRow(const TensorRef& t, std::uint64_t row, std::uint64_t expert,
+                   std::span<const float> vec) {
+  const auto* base = t.Expert(expert) + row * t.RowBytes();
+  const std::size_t cols = static_cast<std::size_t>(t.cols);
+  if (cols != vec.size()) {
+    throw std::invalid_argument("dot row width mismatch in " +
+                                std::string(t.name));
+  }
+  if (t.type == core::GgmlType::kQ4_K) {
+    return gufo::quant::DotProductQ4_K(base, vec, cols);
+  }
+  if (t.type == core::GgmlType::kQ5_K) {
+    return gufo::quant::DotProductQ5_K(base, vec, cols);
+  }
+  if (t.type == core::GgmlType::kQ6_K) {
+    return gufo::quant::DotProductQ6_K(base, vec, cols);
+  }
+  if (t.type == core::GgmlType::kQ8_0) {
+    // No typed dot for Q8_0: dequantize through a shared scratch row.
+    static thread_local std::vector<float> row;
+    if (row.size() < cols) {
+      row.resize(cols);
+    }
+    gufo::quant::DequantizeQ8_0(base, row.data(), cols);
+    double sum = 0.0;
+    for (std::size_t i = 0; i < cols; ++i) {
+      sum += static_cast<double>(row[i]) * vec[i];
+    }
+    return static_cast<float>(sum);
+  }
+  double sum = 0.0;
+  switch (t.type) {
+    case core::GgmlType::kF32: {
+      const auto* src = reinterpret_cast<const float*>(base);
+      for (std::size_t i = 0; i < cols; ++i) {
+        sum += static_cast<double>(src[i]) * vec[i];
+      }
+      break;
+    }
+    case core::GgmlType::kF16: {
+      const auto* src = reinterpret_cast<const std::uint16_t*>(base);
+      for (std::size_t i = 0; i < cols; ++i) {
+        sum += static_cast<double>(gufo::quant::Fp16ToFloat(src[i])) * vec[i];
+      }
+      break;
+    }
+    case core::GgmlType::kBF16: {
+      const auto* src = reinterpret_cast<const std::uint16_t*>(base);
+      for (std::size_t i = 0; i < cols; ++i) {
+        sum += static_cast<double>(Bf16ToFloat(src[i])) * vec[i];
+      }
+      break;
+    }
+    default:
+      throw std::invalid_argument("unsupported dot format in " +
+                                  std::string(t.name));
+  }
+  return static_cast<float>(sum);
+}
+
+ReferenceModel::ReferenceModel(const ModelWeights& weights, std::string* error,
+                               bool trace, bool deep, std::uint32_t layer_limit)
+    : weights_(&weights),
+      config_(&weights.config),
+      tracing_(trace),
+      deep_trace_(deep),
+      layer_limit_(layer_limit) {
+  if (deep) {
+    tracing_ = true;
+  }
+  const Config& c = *config_;
+  const bool geometry =
+      c.num_layers > 0 && c.hidden_size > 0 && c.head_count > 0 &&
+      c.hc_count == 4 && c.kda_head_dim > 0 && c.kda_conv_kernel >= 2 &&
+      c.kda_gate_lower_bound < 0.0F && c.kv_lora_rank > 0 &&
+      c.q_lora_rank > 0 && c.qk_nope_head_dim > 0 && c.v_head_dim > 0 &&
+      c.indexer_heads > 0 && c.indexer_head_dim > 0 && c.indexer_kpool > 1 &&
+      c.indexer_top_k % c.indexer_kpool == 0 && c.expert_count > 0 &&
+      c.experts_used > 0 && c.experts_used <= c.expert_count &&
+      c.expert_ffn > 0 && c.dense_ffn > 0 && c.expert_group_count == 1 &&
+      weights.layers.size() == c.num_layers;
+  if (!geometry) {
+    if (error != nullptr) {
+      *error = "reference geometry is invalid";
+    }
+    return;
+  }
+  kda_.resize(c.num_layers);
+  dsa_.resize(c.num_layers);
+  const std::uint32_t inner = c.KdaInnerDim();
+  const std::size_t max_inter =
+      std::max<std::size_t>({c.dense_ffn, c.expert_ffn * c.shared_experts});
+  for (std::uint32_t l = 0; l < c.num_layers; ++l) {
+    if (weights.layers[l].linear) {
+      kda_[l].recurrent.assign(static_cast<std::size_t>(c.head_count) *
+                                   c.kda_head_dim * c.kda_head_dim,
+                               0.0F);
+      kda_[l].conv.assign(
+          static_cast<std::size_t>(c.kda_conv_kernel - 1) * (3 * inner), 0.0F);
+    }
+  }
+  const std::size_t hc_dim = static_cast<std::size_t>(c.HcDim());
+  streams_.assign(hc_dim, 0.0F);
+  residual_.assign(hc_dim, 0.0F);
+  hc_post_.assign(c.hc_count, 0.0F);
+  hc_comb_.assign(static_cast<std::size_t>(c.hc_count) * c.hc_count, 0.0F);
+  hc_base_.assign(c.HcMixDim(), 0.0F);
+  hc_scale_.assign(3, 0.0F);
+  hc_pre_.assign(c.hc_count, 0.0F);
+  collapsed_.assign(c.hidden_size, 0.0F);
+  block_x_.assign(c.hidden_size, 0.0F);
+  block_out_.assign(c.hidden_size, 0.0F);
+  normed_.assign(c.hidden_size, 0.0F);
+  hc_flat_.assign(hc_dim, 0.0F);
+  hc_mixes_.assign(c.HcMixDim(), 0.0F);
+  scratch_row_.assign(std::max<std::size_t>({hc_dim, c.hidden_size, max_inter}),
+                      0.0F);
+  kda_qkv_.assign(3 * inner, 0.0F);
+  kda_conv_out_.assign(3 * inner, 0.0F);
+  kda_conv_old_.assign(
+      static_cast<std::size_t>(c.kda_conv_kernel - 1) * (3 * inner), 0.0F);
+  kda_gate_.assign(inner, 0.0F);
+  kda_core_.assign(c.KdaInnerDim(), 0.0F);
+  kda_gated_.assign(c.KdaInnerDim(), 0.0F);
+  mlp_act_.assign(max_inter, 0.0F);
+  final_mean_.assign(c.hidden_size, 0.0F);
+}
+
+std::uint32_t ReferenceModel::ExecutedLayers() const noexcept {
+  const Config& c = *config_;
+  return layer_limit_ == 0 ? c.num_layers
+                           : std::min(layer_limit_, c.num_layers);
+}
+
+ReferenceModel::BlockDiagnostics* ReferenceModel::CurrentDiag(
+    std::uint32_t layer, int sub) {
+  if (!deep_trace_ || position_ >= deep_.size() ||
+      layer >= deep_[position_].size()) {
+    return nullptr;
+  }
+  return &deep_[position_][layer][static_cast<std::size_t>(sub)];
+}
+
+void ReferenceModel::HyperMix(const HcWeights& hc,
+                              std::span<const float> streams,
+                              std::span<float> post, std::span<float> comb,
+                              std::span<float> collapsed) {
+  const Config& c = *config_;
+  const std::uint32_t n = c.hc_count;
+  const std::size_t hc_dim = static_cast<std::size_t>(c.HcDim());
+  // Unweighted RMSNorm over the flattened streams.
+  double sum = 0.0;
+  for (float v : streams) {
+    sum += static_cast<double>(v) * v;
+  }
+  const float inv = static_cast<float>(
+      1.0F / std::sqrt(sum / static_cast<double>(hc_dim) + c.rms_eps));
+  for (std::size_t i = 0; i < hc_dim; ++i) {
+    hc_flat_[i] = streams[i] * inv;
+  }
+  DequantTensorRow(hc.scale, 0, 0, hc_scale_.data());
+  DequantTensorRow(hc.base, 0, 0, hc_base_.data());
+  for (std::uint32_t m = 0; m < c.HcMixDim(); ++m) {
+    hc_mixes_[m] = DotTensorRow(hc.fn, m, 0, hc_flat_);
+  }
+  const float eps = c.hc_eps;
+  for (std::uint32_t i = 0; i < n; ++i) {
+    hc_pre_[i] = Sigmoid(hc_mixes_[i] * hc_scale_[0] + hc_base_[i]) + eps;
+    post[i] = 2.0F * Sigmoid(hc_mixes_[n + i] * hc_scale_[1] + hc_base_[n + i]);
+  }
+  // comb[m][n] = softmax over the second index, plus eps.
+  for (std::uint32_t m = 0; m < n; ++m) {
+    float max_value = -std::numeric_limits<float>::infinity();
+    for (std::uint32_t j = 0; j < n; ++j) {
+      const float logit = hc_mixes_[2 * n + m * n + j] * hc_scale_[2] +
+                          hc_base_[2 * n + m * n + j];
+      comb[m * n + j] = logit;
+      max_value = std::max(max_value, logit);
+    }
+    double denom = 0.0;
+    for (std::uint32_t j = 0; j < n; ++j) {
+      denom += std::exp(static_cast<double>(comb[m * n + j] - max_value));
+    }
+    for (std::uint32_t j = 0; j < n; ++j) {
+      comb[m * n + j] =
+          static_cast<float>(
+              std::exp(static_cast<double>(comb[m * n + j] - max_value)) /
+              denom) +
+          eps;
+    }
+  }
+  const auto col_norm = [&]() {
+    for (std::uint32_t j = 0; j < n; ++j) {
+      double denom = 0.0;
+      for (std::uint32_t i = 0; i < n; ++i) {
+        denom += comb[i * n + j];
+      }
+      const float scale =
+          static_cast<float>(1.0 / (denom + static_cast<double>(eps)));
+      for (std::uint32_t i = 0; i < n; ++i) {
+        comb[i * n + j] *= scale;
+      }
+    }
+  };
+  const auto row_norm = [&]() {
+    for (std::uint32_t i = 0; i < n; ++i) {
+      double denom = 0.0;
+      for (std::uint32_t j = 0; j < n; ++j) {
+        denom += comb[i * n + j];
+      }
+      const float scale =
+          static_cast<float>(1.0 / (denom + static_cast<double>(eps)));
+      for (std::uint32_t j = 0; j < n; ++j) {
+        comb[i * n + j] *= scale;
+      }
+    }
+  };
+  col_norm();
+  for (std::uint32_t it = 1; it < c.hc_sinkhorn_iters; ++it) {
+    row_norm();
+    col_norm();
+  }
+  for (std::uint32_t d = 0; d < c.hidden_size; ++d) {
+    double value = 0.0;
+    for (std::uint32_t i = 0; i < n; ++i) {
+      value += static_cast<double>(hc_pre_[i]) * streams[i * c.hidden_size + d];
+    }
+    collapsed[d] = static_cast<float>(value);
+  }
+}
+
+bool ReferenceModel::KdaStep(std::uint32_t layer, const float* x, float* out,
+                             std::string* error) {
+  (void)error;
+  const Config& c = *config_;
+  const KdaWeights& k = weights_->layers[layer].kda;
+  KdaState& state = kda_[layer];
+  const std::uint32_t inner = c.KdaInnerDim();
+  const std::uint32_t heads = c.head_count;
+  const std::uint32_t dim = c.kda_head_dim;
+  const std::uint32_t kernel = c.kda_conv_kernel;
+  const std::uint32_t history = kernel - 1;
+  const std::uint32_t channels = 3 * inner;
+
+  // Projections, then one causal-conv step per channel with SiLU. The
+  // channel groups are q | k | v, each with its own conv taps.
+  const TensorRef* proj[3] = {&k.q, &k.k, &k.v};
+  const TensorRef* conv[3] = {&k.conv_q, &k.conv_k, &k.conv_v};
+  for (std::uint32_t part = 0; part < 3; ++part) {
+    for (std::uint32_t j = 0; j < inner; ++j) {
+      kda_qkv_[part * inner + j] =
+          DotTensorRow(*proj[part], j, 0, {x, c.hidden_size});
+    }
+  }
+  for (std::uint32_t ch = 0; ch < channels; ++ch) {
+    DequantTensorRow(*conv[ch / inner], ch % inner, 0, scratch_row_.data());
+    double acc = 0.0;
+    for (std::uint32_t t = 0; t < kernel; ++t) {
+      const float input =
+          t < history ? state.conv[t * channels + ch] : kda_qkv_[ch];
+      acc += static_cast<double>(scratch_row_[t]) * input;
+    }
+    kda_conv_out_[ch] = Silu(static_cast<float>(acc));
+  }
+  // Roll the history: drop the oldest row, append the current projections.
+  std::copy(state.conv.begin(), state.conv.end(), kda_conv_old_.begin());
+  for (std::uint32_t t = 0; t < history; ++t) {
+    const std::uint32_t source = t + 1;
+    for (std::uint32_t ch = 0; ch < channels; ++ch) {
+      state.conv[t * channels + ch] =
+          source < history ? kda_conv_old_[source * channels + ch]
+                           : kda_qkv_[ch];
+    }
+  }
+
+  // Decay gate per (head, dim): bound * sigmoid(exp(A_log) * raw), with
+  // A = -exp(A_log) stored in the artifact.
+  std::vector<float> a(heads);
+  DequantTensorRow(k.a, 0, 0, a.data());
+  std::vector<float> dt(inner);
+  DequantTensorRow(k.dt_bias, 0, 0, dt.data());
+  std::vector<float> f_a(dim);
+  std::vector<float> beta(heads);
+  for (std::uint32_t d = 0; d < dim; ++d) {
+    f_a[d] = DotTensorRow(k.f_a, d, 0, {x, c.hidden_size});
+  }
+  for (std::uint32_t h = 0; h < heads; ++h) {
+    beta[h] = Sigmoid(DotTensorRow(k.beta, h, 0, {x, c.hidden_size}));
+  }
+  for (std::uint32_t h = 0; h < heads; ++h) {
+    const float decay_rate = -a[h];
+    for (std::uint32_t d = 0; d < dim; ++d) {
+      const std::uint32_t j = h * dim + d;
+      const float raw = DotTensorRow(k.f_b, j, 0, {f_a.data(), dim}) + dt[j];
+      kda_gate_[j] = c.kda_gate_lower_bound * Sigmoid(decay_rate * raw);
+    }
+  }
+
+  // One token of the gated delta rule with channel-wise decay, FP32 state,
+  // FLA-style vector l2 norm on q and k, q scaled by 1/sqrt(dim).
+  const float q_scale =
+      static_cast<float>(1.0 / std::sqrt(static_cast<double>(dim)));
+  std::vector<float> qn(dim);
+  std::vector<float> kn(dim);
+  std::vector<float> kv_mem(dim);
+  BlockDiagnostics* diag = CurrentDiag(layer, 0);
+  if (diag != nullptr) {
+    diag->kda_conv_out.assign(kda_conv_out_.begin(), kda_conv_out_.end());
+    diag->kda_gate.assign(kda_gate_.begin(), kda_gate_.end());
+    diag->kda_qn.assign(inner, 0.0F);
+    diag->kda_kn.assign(inner, 0.0F);
+  }
+  for (std::uint32_t h = 0; h < heads; ++h) {
+    float q_sq = 0.0F;
+    float k_sq = 0.0F;
+    for (std::uint32_t d = 0; d < dim; ++d) {
+      const float q = kda_conv_out_[h * dim + d];
+      const float kk = kda_conv_out_[inner + h * dim + d];
+      q_sq += q * q;
+      k_sq += kk * kk;
+      qn[d] = q;
+      kn[d] = kk;
+    }
+    const float q_inv =
+        static_cast<float>(1.0 /
+                           std::sqrt(static_cast<double>(q_sq) + kL2Eps)) *
+        q_scale;
+    const float k_inv =
+        static_cast<float>(1.0 / std::sqrt(static_cast<double>(k_sq) + kL2Eps));
+    for (std::uint32_t d = 0; d < dim; ++d) {
+      qn[d] *= q_inv;
+      kn[d] *= k_inv;
+    }
+    if (diag != nullptr) {
+      for (std::uint32_t d = 0; d < dim; ++d) {
+        diag->kda_qn[h * dim + d] = qn[d];
+        diag->kda_kn[h * dim + d] = kn[d];
+      }
+    }
+    float* s = &state.recurrent[static_cast<std::size_t>(h) * dim * dim];
+    for (std::uint32_t v = 0; v < dim; ++v) {
+      kv_mem[v] = 0.0F;
+    }
+    for (std::uint32_t d = 0; d < dim; ++d) {
+      const float decay = std::exp(kda_gate_[h * dim + d]);
+      float* row = s + static_cast<std::size_t>(d) * dim;
+      for (std::uint32_t v = 0; v < dim; ++v) {
+        row[v] *= decay;
+        kv_mem[v] += row[v] * kn[d];
+      }
+    }
+    const float b = beta[h];
+    const float* v_in = &kda_conv_out_[2 * inner + h * dim];
+    for (std::uint32_t v = 0; v < dim; ++v) {
+      const float delta = (v_in[v] - kv_mem[v]) * b;
+      for (std::uint32_t d = 0; d < dim; ++d) {
+        s[static_cast<std::size_t>(d) * dim + v] += kn[d] * delta;
+      }
+      float acc = 0.0F;
+      for (std::uint32_t d = 0; d < dim; ++d) {
+        acc += s[static_cast<std::size_t>(d) * dim + v] * qn[d];
+      }
+      kda_core_[h * dim + v] = acc;
+    }
+  }
+
+  // RMSNorm per head over the value dim, gated by sigmoid(g_b(g_a(x))).
+  std::vector<float> o_norm(dim);
+  std::vector<float> g_a(dim);
+  DequantTensorRow(k.o_norm, 0, 0, o_norm.data());
+  for (std::uint32_t d = 0; d < dim; ++d) {
+    g_a[d] = DotTensorRow(k.g_a, d, 0, {x, c.hidden_size});
+  }
+  for (std::uint32_t h = 0; h < heads; ++h) {
+    double sum = 0.0;
+    for (std::uint32_t d = 0; d < dim; ++d) {
+      const float v = kda_core_[h * dim + d];
+      sum += static_cast<double>(v) * v;
+    }
+    const float inv = static_cast<float>(
+        1.0 / std::sqrt(sum / dim + static_cast<double>(c.rms_eps)));
+    for (std::uint32_t d = 0; d < dim; ++d) {
+      const std::uint32_t j = h * dim + d;
+      const float gate = Sigmoid(DotTensorRow(k.g_b, j, 0, {g_a.data(), dim}));
+      kda_gated_[j] = o_norm[d] * (kda_core_[j] * inv) * gate;
+    }
+  }
+  for (std::uint32_t d = 0; d < c.hidden_size; ++d) {
+    out[d] = DotTensorRow(k.out, d, 0, {kda_gated_.data(), inner});
+  }
+  return true;
+}
+
+bool ReferenceModel::DsaStep(std::uint32_t layer, const float* x, float* out,
+                             std::string* error) {
+  (void)error;
+  const Config& c = *config_;
+  const DsaWeights& m = weights_->layers[layer].dsa;
+  const IndexerWeights& idx = weights_->layers[layer].indexer;
+  DsaState& state = dsa_[layer];
+  const std::uint32_t heads = c.head_count;
+  const std::uint32_t query_dim = c.MlaQueryDim();
+  const std::uint32_t idim = c.indexer_head_dim;
+  const std::uint32_t kpool = c.indexer_kpool;
+  const std::uint32_t tokens = position_ + 1;
+
+  // Query residual and the normalized latent, which is the whole MLA
+  // per-token cache: k_b is absorbed into the query and v_b projects the
+  // attention output back out of latent space.
+  std::vector<float> q_resid(c.q_lora_rank);
+  for (std::uint32_t r = 0; r < c.q_lora_rank; ++r) {
+    q_resid[r] = DotTensorRow(m.q_a, r, 0, {x, c.hidden_size});
+  }
+  std::vector<float> q_norm(c.q_lora_rank);
+  DequantTensorRow(m.q_a_norm, 0, 0, q_norm.data());
+  RmsNormInto(q_resid, q_norm, c.rms_eps, q_resid);
+  std::vector<float> latent(c.kv_lora_rank);
+  for (std::uint32_t r = 0; r < c.kv_lora_rank; ++r) {
+    latent[r] = DotTensorRow(m.kv_a, r, 0, {x, c.hidden_size});
+  }
+  std::vector<float> kv_norm(c.kv_lora_rank);
+  DequantTensorRow(m.kv_a_norm, 0, 0, kv_norm.data());
+  RmsNormInto(latent, kv_norm, c.rms_eps, latent);
+  state.latents.insert(state.latents.end(), latent.begin(), latent.end());
+  BlockDiagnostics* diag = CurrentDiag(layer, 0);
+  if (diag != nullptr) {
+    diag->mla_latent.assign(latent.begin(), latent.end());
+  }
+
+  // Indexer per-token cache: LayerNormed key and compression gate.
+  {
+    std::vector<float> key(idim);
+    for (std::uint32_t d = 0; d < idim; ++d) {
+      key[d] = DotTensorRow(idx.k, d, 0, {x, c.hidden_size});
+    }
+    std::vector<float> ln_w(idim);
+    std::vector<float> ln_b(idim);
+    DequantTensorRow(idx.k_norm, 0, 0, ln_w.data());
+    DequantTensorRow(idx.k_norm_bias, 0, 0, ln_b.data());
+    for (std::uint32_t d = 0; d < idim; ++d) {
+      state.index_keys.push_back(0.0F);
+    }
+    IndexerLayerNorm(
+        key, ln_w, ln_b, c.layer_norm_eps,
+        {state.index_keys.data() + state.index_keys.size() - idim, idim});
+    for (std::uint32_t d = 0; d < idim; ++d) {
+      state.index_gates.push_back(
+          DotTensorRow(idx.comp_gate, d, 0, {x, c.hidden_size}));
+    }
+  }
+
+  // Complete one pool when this token closes it.
+  if (tokens % kpool == 0) {
+    const std::uint32_t pool = tokens / kpool - 1;
+    std::vector<float> ape(kpool * idim);
+    for (std::uint32_t j = 0; j < kpool; ++j) {
+      DequantTensorRow(idx.comp_ape, j, 0, ape.data() + j * idim);
+    }
+    std::vector<float> pooled(idim, 0.0F);
+    std::vector<float> logits(kpool);
+    for (std::uint32_t d = 0; d < idim; ++d) {
+      float max_value = -std::numeric_limits<float>::infinity();
+      for (std::uint32_t j = 0; j < kpool; ++j) {
+        logits[j] = state.index_gates[(pool * kpool + j) * idim + d] +
+                    ape[j * idim + d];
+        max_value = std::max(max_value, logits[j]);
+      }
+      double denom = 0.0;
+      for (std::uint32_t j = 0; j < kpool; ++j) {
+        denom += std::exp(static_cast<double>(logits[j] - max_value));
+      }
+      for (std::uint32_t j = 0; j < kpool; ++j) {
+        const float prob = static_cast<float>(
+            std::exp(static_cast<double>(logits[j] - max_value)) / denom);
+        pooled[d] += prob * state.index_keys[(pool * kpool + j) * idim + d];
+      }
+    }
+    state.pooled.insert(state.pooled.end(), pooled.begin(), pooled.end());
+    state.complete_pools = tokens / kpool;
+  }
+
+  // Score complete pools; keep the best top_k / kpool plus the incomplete
+  // tail (up to kpool - 1 tokens, always selected).
+  const std::uint32_t n_pools = state.complete_pools;
+  const std::uint32_t select_pools =
+      std::min<std::uint32_t>(c.indexer_top_k / kpool, n_pools);
+  std::vector<std::int32_t> selected;
+  selected.reserve(select_pools * kpool + (kpool - 1));
+  if (n_pools > 0) {
+    std::vector<float> iq(c.IndexerQueryDim());
+    for (std::uint32_t r = 0; r < c.IndexerQueryDim(); ++r) {
+      iq[r] = DotTensorRow(idx.q_b, r, 0, {q_resid.data(), c.q_lora_rank});
+    }
+    std::vector<float> head_weights(c.indexer_heads);
+    for (std::uint32_t h = 0; h < c.indexer_heads; ++h) {
+      head_weights[h] =
+          DotTensorRow(idx.proj, h, 0, {x, c.hidden_size}) /
+          static_cast<float>(std::sqrt(static_cast<double>(c.indexer_heads)));
+    }
+    const float scale =
+        static_cast<float>(1.0 / std::sqrt(static_cast<double>(idim)));
+    std::vector<float> index_scores(n_pools);
+    for (std::uint32_t p = 0; p < n_pools; ++p) {
+      double total = 0.0;
+      for (std::uint32_t h = 0; h < c.indexer_heads; ++h) {
+        double dot = 0.0;
+        for (std::uint32_t d = 0; d < idim; ++d) {
+          dot += static_cast<double>(iq[h * idim + d]) *
+                 state.pooled[p * idim + d];
+        }
+        total += static_cast<double>(head_weights[h]) *
+                 std::max(0.0F, static_cast<float>(dot) * scale);
+      }
+      index_scores[p] = static_cast<float>(total);
+    }
+    std::vector<std::uint32_t> order(n_pools);
+    std::iota(order.begin(), order.end(), 0U);
+    std::stable_sort(order.begin(), order.end(),
+                     [&](std::uint32_t a, std::uint32_t b) {
+                       return index_scores[a] > index_scores[b];
+                     });
+    if (diag != nullptr) {
+      diag->index_pooled.assign(state.pooled.begin(), state.pooled.end());
+      diag->index_scores.assign(index_scores.begin(), index_scores.end());
+    }
+    for (std::uint32_t i = 0; i < select_pools; ++i) {
+      for (std::uint32_t j = 0; j < kpool; ++j) {
+        selected.push_back(static_cast<std::int32_t>(order[i] * kpool + j));
+      }
+    }
+  }
+  const std::uint32_t tail_count = tokens % kpool;
+  for (std::uint32_t j = 0; j < tail_count; ++j) {
+    selected.push_back(static_cast<std::int32_t>(tokens - tail_count + j));
+  }
+  std::sort(selected.begin(), selected.end());
+  state.last_selection = selected;
+
+  // Attention over the selection with the absorbed query: q_abs[h][r] is
+  // k_b's row r of head h dotted with the query, and the score against a
+  // cached latent is their dot, scaled 1/sqrt(qk_nope). After softmax,
+  // v_b projects the probability-weighted latent out of latent space.
+  const float attn_scale = static_cast<float>(
+      1.0 / std::sqrt(static_cast<double>(c.qk_nope_head_dim)));
+  std::vector<float> q(query_dim);
+  for (std::uint32_t r = 0; r < query_dim; ++r) {
+    q[r] = DotTensorRow(m.q_b, r, 0, {q_resid.data(), c.q_lora_rank});
+  }
+  std::vector<float> q_abs(c.kv_lora_rank);
+  std::vector<float> attn_out(query_dim, 0.0F);
+  std::vector<float> scores(selected.size());
+  std::vector<float> weighted(c.kv_lora_rank);
+  if (diag != nullptr) {
+    diag->mla_q_abs.assign(static_cast<std::size_t>(heads) * c.kv_lora_rank,
+                           0.0F);
+  }
+  for (std::uint32_t h = 0; h < heads; ++h) {
+    for (std::uint32_t r = 0; r < c.kv_lora_rank; ++r) {
+      q_abs[r] = DotTensorRow(
+          m.k_b, r, h, {q.data() + h * c.qk_nope_head_dim, c.qk_nope_head_dim});
+    }
+    if (diag != nullptr) {
+      std::copy(q_abs.begin(), q_abs.end(),
+                diag->mla_q_abs.begin() +
+                    static_cast<std::size_t>(h) * c.kv_lora_rank);
+    }
+    float max_value = -std::numeric_limits<float>::infinity();
+    for (std::size_t i = 0; i < selected.size(); ++i) {
+      const auto at = static_cast<std::size_t>(selected[i]);
+      double dot = 0.0;
+      for (std::uint32_t r = 0; r < c.kv_lora_rank; ++r) {
+        dot += static_cast<double>(q_abs[r]) *
+               state.latents[at * c.kv_lora_rank + r];
+      }
+      scores[i] = static_cast<float>(dot) * attn_scale;
+      max_value = std::max(max_value, scores[i]);
+    }
+    double denom = 0.0;
+    for (float s : scores) {
+      denom += std::exp(static_cast<double>(s - max_value));
+    }
+    for (std::uint32_t r = 0; r < c.kv_lora_rank; ++r) {
+      weighted[r] = 0.0F;
+    }
+    for (std::size_t i = 0; i < selected.size(); ++i) {
+      const auto at = static_cast<std::size_t>(selected[i]);
+      const float prob = static_cast<float>(
+          std::exp(static_cast<double>(scores[i] - max_value)) / denom);
+      for (std::uint32_t r = 0; r < c.kv_lora_rank; ++r) {
+        weighted[r] += prob * state.latents[at * c.kv_lora_rank + r];
+      }
+    }
+    for (std::uint32_t j = 0; j < c.v_head_dim; ++j) {
+      attn_out[h * c.v_head_dim + j] =
+          DotTensorRow(m.v_b, j, h, {weighted.data(), c.kv_lora_rank});
+    }
+  }
+  for (std::uint32_t d = 0; d < c.hidden_size; ++d) {
+    out[d] = DotTensorRow(m.out, d, 0, {attn_out.data(), query_dim});
+  }
+  return true;
+}
+
+bool ReferenceModel::FfnStep(std::uint32_t layer, const float* x, float* out,
+                             std::string* error) {
+  (void)error;
+  const Config& c = *config_;
+  const LayerWeights& w = weights_->layers[layer];
+  const float limit = c.swiglu_limit;
+
+  // Clamped SwiGLU activations of one gate/up pair into mlp_act_.
+  const auto activations = [&](const TensorRef& gate, const TensorRef& up,
+                               std::uint32_t intermediate,
+                               std::uint64_t expert) {
+    for (std::uint32_t j = 0; j < intermediate; ++j) {
+      const float g = DotTensorRow(gate, j, expert, {x, c.hidden_size});
+      const float u = DotTensorRow(up, j, expert, {x, c.hidden_size});
+      mlp_act_[j] = Silu(std::min(g, limit)) * std::clamp(u, -limit, limit);
+    }
+  };
+  const auto down_into = [&](const TensorRef& down, std::uint32_t intermediate,
+                             std::uint64_t expert, float weight,
+                             std::vector<float>& acc) {
+    for (std::uint32_t d = 0; d < c.hidden_size; ++d) {
+      acc[d] += weight *
+                DotTensorRow(down, d, expert, {mlp_act_.data(), intermediate});
+    }
+  };
+
+  if (w.dense_ffn) {
+    activations(w.ffn_gate, w.ffn_up, c.dense_ffn, 0);
+    for (std::uint32_t d = 0; d < c.hidden_size; ++d) {
+      out[d] = DotTensorRow(w.ffn_down, d, 0, {mlp_act_.data(), c.dense_ffn});
+    }
+    return true;
+  }
+
+  // Sigmoid routing with the noaux_tc bias on selection only.
+  std::vector<float> router(c.expert_count);
+  for (std::uint32_t e = 0; e < c.expert_count; ++e) {
+    router[e] = Sigmoid(DotTensorRow(w.router, e, 0, {x, c.hidden_size}));
+  }
+  std::vector<float> bias(c.expert_count);
+  DequantTensorRow(w.router_bias, 0, 0, bias.data());
+  std::vector<std::uint32_t> order(c.expert_count);
+  std::iota(order.begin(), order.end(), 0U);
+  std::stable_sort(order.begin(), order.end(),
+                   [&](std::uint32_t a, std::uint32_t b) {
+                     return router[a] + bias[a] > router[b] + bias[b];
+                   });
+  double weight_sum = 0.0;
+  for (std::uint32_t k = 0; k < c.experts_used; ++k) {
+    weight_sum += router[order[k]];
+  }
+  if (BlockDiagnostics* diag = CurrentDiag(layer, 1); diag != nullptr) {
+    diag->router_probs.assign(router.begin(), router.end());
+    diag->experts.assign(order.begin(), order.begin() + c.experts_used);
+    diag->expert_weights.clear();
+  }
+  std::vector<float> routed(c.hidden_size, 0.0F);
+  for (std::uint32_t k = 0; k < c.experts_used; ++k) {
+    const std::uint32_t e = order[k];
+    const float weight =
+        static_cast<float>(router[e] / (weight_sum + 1e-20) * c.routed_scaling);
+    if (BlockDiagnostics* diag = CurrentDiag(layer, 1); diag != nullptr) {
+      diag->expert_weights.push_back(weight);
+    }
+    activations(w.gate_exps, w.up_exps, c.expert_ffn, e);
+    down_into(w.down_exps, c.expert_ffn, e, weight, routed);
+  }
+  const std::uint32_t shared_ff = c.expert_ffn * c.shared_experts;
+  activations(w.gate_shexp, w.up_shexp, shared_ff, 0);
+  down_into(w.down_shexp, shared_ff, 0, 1.0F, routed);
+  std::copy(routed.begin(), routed.end(), out);
+  return true;
+}
+
+bool ReferenceModel::Step(std::int32_t token, std::span<float> logits,
+                          std::string* error) {
+  const Config& c = *config_;
+  if (logits.size() != c.vocab_size) {
+    if (error != nullptr) {
+      *error = "logits span must cover the vocabulary";
+    }
+    return false;
+  }
+  if (token < 0 || static_cast<std::uint32_t>(token) >= c.vocab_size) {
+    if (error != nullptr) {
+      *error = "token id out of range";
+    }
+    return false;
+  }
+  if (position_ >= c.context_length) {
+    if (error != nullptr) {
+      *error = "context length exceeded";
+    }
+    return false;
+  }
+  const std::uint32_t hidden = c.hidden_size;
+  const std::uint32_t n = c.hc_count;
+  const std::uint32_t layers = ExecutedLayers();
+  if (tracing_) {
+    trace_.emplace_back(layers, std::vector<BlockTrace>(2, BlockTrace{}));
+    if (deep_trace_) {
+      deep_.emplace_back(layers,
+                         std::vector<BlockDiagnostics>(2, BlockDiagnostics{}));
+    }
+  }
+  DequantTensorRow(weights_->token_embd, static_cast<std::uint64_t>(token), 0,
+                   collapsed_.data());
+  for (std::uint32_t i = 0; i < n; ++i) {
+    std::copy(collapsed_.begin(), collapsed_.begin() + hidden,
+              streams_.begin() + i * hidden);
+  }
+  for (std::uint32_t layer = 0; layer < layers; ++layer) {
+    const LayerWeights& w = weights_->layers[layer];
+    for (int sub = 0; sub < 2; ++sub) {
+      const HcWeights& hc = sub == 0 ? w.hc_attn : w.hc_ffn;
+      const TensorRef& norm = sub == 0 ? w.attn_norm : w.ffn_norm;
+      std::copy(streams_.begin(), streams_.end(), residual_.begin());
+      HyperMix(hc, streams_, hc_post_, hc_comb_, collapsed_);
+      DequantTensorRow(norm, 0, 0, normed_.data());
+      RmsNormInto(collapsed_, normed_, c.rms_eps, block_x_);
+      if (BlockDiagnostics* diag = CurrentDiag(layer, sub); diag != nullptr) {
+        diag->hc_pre.assign(hc_pre_.begin(), hc_pre_.end());
+        diag->hc_post.assign(hc_post_.begin(), hc_post_.end());
+        diag->hc_comb.assign(hc_comb_.begin(), hc_comb_.end());
+      }
+      const bool ok =
+          sub == 0
+              ? (w.linear
+                     ? KdaStep(layer, block_x_.data(), block_out_.data(), error)
+                     : DsaStep(layer, block_x_.data(), block_out_.data(),
+                               error))
+              : FfnStep(layer, block_x_.data(), block_out_.data(), error);
+      if (!ok) {
+        return false;
+      }
+      if (tracing_) {
+        BlockTrace& captured = trace_[position_][layer][sub];
+        captured.input.assign(block_x_.begin(), block_x_.end());
+        captured.output.assign(block_out_.begin(), block_out_.end());
+      }
+      for (std::uint32_t d = 0; d < hidden; ++d) {
+        for (std::uint32_t i = 0; i < n; ++i) {
+          double mix = 0.0;
+          for (std::uint32_t m = 0; m < n; ++m) {
+            mix += static_cast<double>(hc_comb_[m * n + i]) *
+                   residual_[m * hidden + d];
+          }
+          streams_[i * hidden + d] = static_cast<float>(
+              static_cast<double>(hc_post_[i]) * block_out_[d] + mix);
+        }
+      }
+    }
+  }
+  // Unweighted mean over the streams, final norm, vocabulary projection.
+  // The mean is also kept unnormalized as the slice-exit readout.
+  for (std::uint32_t d = 0; d < hidden; ++d) {
+    double mean = 0.0;
+    for (std::uint32_t i = 0; i < n; ++i) {
+      mean += streams_[i * hidden + d];
+    }
+    collapsed_[d] = static_cast<float>(mean / n);
+    final_mean_[d] = collapsed_[d];
+  }
+  DequantTensorRow(weights_->output_norm, 0, 0, normed_.data());
+  RmsNormInto(collapsed_, normed_, c.rms_eps, collapsed_);
+  for (std::uint32_t v = 0; v < c.vocab_size; ++v) {
+    logits[v] =
+        DotTensorRow(weights_->output, v, 0, {collapsed_.data(), hidden});
+  }
+  ++position_;
+  return true;
+}
+
+bool ReferenceModel::Prefill(std::span<const std::int32_t> tokens,
+                             std::span<float> logits, std::string* error) {
+  if (tokens.empty()) {
+    if (error != nullptr) {
+      *error = "prefill requires at least one token";
+    }
+    return false;
+  }
+  for (const std::int32_t token : tokens) {
+    if (!Step(token, logits, error)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+std::vector<std::int32_t> ReferenceModel::LastSelection(
+    std::uint32_t layer) const {
+  if (layer >= dsa_.size()) {
+    return {};
+  }
+  return dsa_[layer].last_selection;
+}
