+#ifndef GUFO_MODELS_GLM5_NEXT_REFERENCE_HPP_
+#define GUFO_MODELS_GLM5_NEXT_REFERENCE_HPP_
+
+#include <cstddef>
+#include <cstdint>
+#include <span>
+#include <string>
+#include <vector>
+
+#include "src/models/glm5_next/weights.hpp"
+
+namespace gufo::models::glm5_next {
+
+/// Dequantizes one row (`cols` elements) of tensor `t`, row `row` of
+/// expert/head `expert`, into FP32. Supports the pinned artifact's
+/// F32/F16/BF16/Q8_0/Q4_K encodings; other types throw.
+void DequantTensorRow(const TensorRef& t, std::uint64_t row,
+                      std::uint64_t expert, float* dst);
+
+/// Dot product of one weight row with an FP32 vector, dequantizing on the
+/// fly (Q4_K uses the exact typed dot; other types round-trip a row).
+float DotTensorRow(const TensorRef& t, std::uint64_t row, std::uint64_t expert,
+                   std::span<const float> vec);
+
+/// Centered LayerNorm of the indexer key norm:
+/// `weight * (x - mean) * rsqrt(var + eps) + bias`, mean/var accumulated in
+/// double. Exposed for the P2 numerical fixtures (a nonzero-mean input
+/// distinguishes it from the RMSNorm path).
+void IndexerLayerNorm(std::span<const float> x, std::span<const float> weight,
+                      std::span<const float> bias, float eps,
+                      std::span<float> out);
+
+/// Scalar FP32 reference of the trunk, one token at a time.
+///
+/// Arithmetic follows the pinned transformers equations exactly (see
+/// docs/models/glm-5.3-flash): mHC with Sinkhorn and the unweighted head
+/// mean, KDA with channel-wise decay and the FLA l2 norm, nope-only MLA
+/// over materialized per-head keys/values, the k-pool indexer with signed
+/// head weighting and the always-selected tail, sigmoid/noaux_tc routing
+/// with normalized top-k and clamped SwiGLU. All state is FP32. The
+/// nextn block is ignored.
+///
+/// The class holds no weight copies; tensors are dequantized on demand
+/// from the bound (mapped) artifact or from synthetic in-memory weights.
+/// Context growth is bounded only by the caller; the intended use is
+/// short fixed-token references, not long contexts.
+class ReferenceModel {
+public:
+  /// `trace` captures every layer's normalized block input and block
+  /// output per token, for qualifying slice kernels against captured
+  /// intermediates. The buffer grows with the position; intended for
+  /// short fixed-token probes. `deep` additionally captures per-block
+  /// operator intermediates (see BlockDiagnostics); it implies the same
+  /// growth caveats at a larger constant. `layer_limit` (0 = all layers)
+  /// truncates the trunk after that many layers but still runs the final
+  /// stream mean, output norm and vocabulary head, so a truncated slice
+  /// produces comparable logits — the P2 four-layer oracle boundary.
+  ReferenceModel(const ModelWeights& weights, std::string* error,
+                 bool trace = false, bool deep = false,
+                 std::uint32_t layer_limit = 0);
+
+  ReferenceModel(const ReferenceModel&) = delete;
+  ReferenceModel& operator=(const ReferenceModel&) = delete;
+
+  /// Feeds one token and writes the post-token vocabulary distribution.
+  /// Tokens fed so far form positions 0..position(); each call appends to
+  /// every layer's state.
+  bool Step(std::int32_t token, std::span<float> logits, std::string* error);
+
+  /// Convenience: feeds `tokens` sequentially; `logits` receives the final
+  /// distribution. Identical to calling Step per token.
+  bool Prefill(std::span<const std::int32_t> tokens, std::span<float> logits,
+               std::string* error);
+
+  [[nodiscard]] std::uint32_t position() const noexcept { return position_; }
+  [[nodiscard]] const Config& config() const noexcept { return *config_; }
+
+  /// Absolute token indices the DSA layer's indexer selected for the query
+  /// at `position()` (empty until a DSA layer has run at that position).
+  /// Exposed for selection tests; sorted ascending.
+  [[nodiscard]] std::vector<std::int32_t> LastSelection(
+      std::uint32_t layer) const;
+
+  /// Traced capture of one block: the normalized input the mixer consumed
+  /// and its output, for the token at `position()` after it has stepped.
+  struct BlockTrace {
+    std::vector<float> input;   // [hidden], post-norm pre-mixer.
+    std::vector<float> output;  // [hidden], the mixer result.
+  };
+  /// [token][layer][sub-block 0=attention, 1=ffn]; empty without tracing.
+  [[nodiscard]] const std::vector<std::vector<std::vector<BlockTrace>>>& trace()
+      const noexcept {
+    return trace_;
+  }
+
+  /// Operator-level capture of one sub-block, filled with `deep` tracing.
+  /// Fields follow the executed order; vectors are empty when the block
+  /// does not produce them (KDA vs DSA vs FFN).
+  struct BlockDiagnostics {
+    // mHC mixer state before the block combine (both sub-blocks).
+    std::vector<float> hc_pre;   // [hc] pre weights (+eps).
+    std::vector<float> hc_post;  // [hc] post multipliers.
+    std::vector<float> hc_comb;  // [hc][hc] Sinkhorn combiner.
+    // KDA attention: conv outputs, per-channel log-decay gates and the
+    // l2-normalized q|k rows as consumed by the recurrence.
+    std::vector<float> kda_conv_out;  // [3 * inner]
+    std::vector<float> kda_gate;      // [inner] bound*sigmoid(-a*raw) < 0
+    std::vector<float> kda_qn;        // [inner] scaled normalized q
+    std::vector<float> kda_kn;        // [inner] normalized k
+    // DSA attention: the cached latent and the absorbed query.
+    std::vector<float> mla_latent;  // [kv_lora_rank] normalized
+    std::vector<float> mla_q_abs;   // [heads][kv_lora_rank]
+    // DSA indexer at this query: pooled keys snapshot and pool scores
+    // (descending selection order is exposed via LastSelection).
+    std::vector<float> index_pooled;  // [complete_pools][idim]
+    std::vector<float> index_scores;  // [complete_pools]
+    // FFN routing: sigmoid probabilities and the selected experts with
+    // their normalized, scaled combination weights.
+    std::vector<float> router_probs;    // [expert_count] sigmoid
+    std::vector<std::int32_t> experts;  // [experts_used]
+    std::vector<float> expert_weights;  // [experts_used] normalized*scale
+  };
+  /// [token][layer][sub-block]; empty without `deep`.
+  [[nodiscard]] const std::vector<std::vector<std::vector<BlockDiagnostics>>>&
+  deep() const noexcept {
+    return deep_;
+  }
+
+  /// The unweighted stream mean of the last step, before the final norm
+  /// and vocabulary head (the slice-exit boundary readout).
+  [[nodiscard]] std::span<const float> LastCollapsed() const noexcept {
+    return final_mean_;
+  }
+
+  /// Layers actually executed (the constructor limit, or all of them).
+  [[nodiscard]] std::uint32_t ExecutedLayers() const noexcept;
+
+private:
+  struct KdaState {
+    // [heads][k_dim][v_dim], decayed in place.
+    std::vector<float> recurrent;
+    // [(kernel - 1)][3 * inner] rolling causal-conv history.
+    std::vector<float> conv;
+  };
+  struct DsaState {
+    // [t][kv_lora_rank] normalized latents; the only MLA per-token cache.
+    std::vector<float> latents;
+    // Indexer per-token cache: [t][indexer_dim] LayerNormed keys and
+    // [t][indexer_dim] compression gates.
+    std::vector<float> index_keys;
+    std::vector<float> index_gates;
+    // [complete_pools][indexer_dim] pooled keys.
+    std::vector<float> pooled;
+    std::uint32_t complete_pools{0};
+    // Selection of the last query at this layer, for tests.
+    std::vector<std::int32_t> last_selection;
+  };
+
+  bool KdaStep(std::uint32_t layer, const float* x, float* out,
+               std::string* error);
+  bool DsaStep(std::uint32_t layer, const float* x, float* out,
+               std::string* error);
+  bool FfnStep(std::uint32_t layer, const float* x, float* out,
+               std::string* error);
+  /// One mHC mixer: computes pre/post/comb for the current streams,
+  /// collapses them into `collapsed`, and leaves `post`/`comb` for the
+  /// caller's combine step.
+  void HyperMix(const HcWeights& hc, std::span<const float> streams,
+                std::span<float> post, std::span<float> comb,
+                std::span<float> collapsed);
+
+  /// Diagnostics slot of the current step, or null when not deep-tracing.
+  BlockDiagnostics* CurrentDiag(std::uint32_t layer, int sub);
+
+  const ModelWeights* weights_;
+  const Config* config_;
+  std::vector<KdaState> kda_;
+  std::vector<DsaState> dsa_;
+  std::uint32_t position_{0};
+  std::uint32_t layer_limit_{0};
+  // Scratch sized to the model.
+  std::vector<float> streams_;       // [hc][hidden]
+  std::vector<float> residual_;      // [hc][hidden]
+  std::vector<float> hc_post_;       // [hc]
+  std::vector<float> hc_pre_;        // [hc]
+  std::vector<float> hc_comb_;       // [hc][hc]
+  std::vector<float> hc_base_;       // [(2 + hc) * hc]
+  std::vector<float> hc_scale_;      // [3]
+  std::vector<float> collapsed_;     // [hidden]
+  std::vector<float> block_x_;       // [hidden]
+  std::vector<float> block_out_;     // [hidden]
+  std::vector<float> normed_;        // [hidden]
+  std::vector<float> hc_flat_;       // [hc * hidden]
+  std::vector<float> hc_mixes_;      // [(2 + hc) * hc]
+  std::vector<float> scratch_row_;   // max cols
+  std::vector<float> kda_qkv_;       // [3 * inner]
+  std::vector<float> kda_conv_out_;  // [3 * inner]
+  std::vector<float> kda_conv_old_;  // [(kernel - 1)][3 * inner]
+  std::vector<float> kda_gate_;      // [inner]
+  std::vector<float> kda_core_;      // [heads * k_dim] value rows
+  std::vector<float> kda_gated_;     // [heads * k_dim]
+  std::vector<float> mlp_act_;       // max intermediate
+  // Tracing (see constructor flag): [token][layer][sub-block].
+  bool tracing_{false};
+  bool deep_trace_{false};
+  std::vector<std::vector<std::vector<BlockTrace>>> trace_;
+  std::vector<std::vector<std::vector<BlockDiagnostics>>> deep_;
+  std::vector<float> final_mean_;  // [hidden] pre-head slice readout
+};
+
+}  // namespace gufo::models::glm5_next
+
+#endif  // GUFO_MODELS_GLM5_NEXT_REFERENCE_HPP_
diff --git a/src/models/glm5_next/weights.cpp b/src/models/glm5_next/weights.cpp
new file mode 100644
index 00000000..14019525
--- /dev/null
+++ b/src/models/glm5_next/weights.cpp
@@ -0,0 +1,323 @@
+#include "src/models/glm5_next/weights.hpp"
+
+#include <string>
+#include <utility>
+
+#include "src/core/quant/ggml_dequant.hpp"
+
+namespace gufo::models::glm5_next {
+namespace {
+
+std::size_t SpanBytes(core::GgmlType type, std::size_t elements) {
+  switch (type) {
+    case core::GgmlType::kF32:
+    case core::GgmlType::kI32:
+      return elements * 4;
+    case core::GgmlType::kF16:
+    case core::GgmlType::kBF16:
+      return elements * 2;
+    default:
+      return gufo::quant::QuantizedRowBytes(type, elements);
+  }
+}
+
+struct Binder {
+  const core::GgufReader& reader;
+  const Config& config;
+  std::string* error;
+  bool ok{true};
+
+  void Fail(const std::string& message) {
+    if (ok && error != nullptr) {
+      *error = message;
+    }
+    ok = false;
+  }
+
+  [[nodiscard]] std::string LayerName(std::uint32_t layer,
+                                      std::string_view suffix) const {
+    std::string name("blk.");
+    name += std::to_string(layer);
+    name += '.';
+    name.append(suffix);
+    return name;
+  }
+
+  /// Binds one tensor and validates it against the expectation.
+  ///
+  /// Element count and the contiguous dimension must always match. With
+  /// `exact`, a three-dimensional layout is required with ne[1] == rows
+  /// and ne[2] == experts (per-head and per-expert stacking); otherwise
+  /// trailing dimensions only need to fold into rows * experts (the KDA
+  /// convolutions' [kernel, 1, channels] fold rows = channels).
+  TensorRef Bind(const std::string& name, std::uint64_t cols,
+                 std::uint64_t rows, std::uint64_t experts,
+                 bool exact = false) {
+    TensorRef ref;
+    if (!ok) {
+      return ref;
+    }
+    const core::GgufTensorInfo* info = reader.FindTensor(name);
+    if (info == nullptr) {
+      Fail("missing tensor " + name);
+      return ref;
+    }
+    const auto& dims = info->dimensions;
+    std::uint64_t elements = 1;
+    for (auto d : dims) {
+      elements *= d;
+    }
+    if (dims.empty() || dims.front() == 0 ||
+        SpanBytes(info->type, static_cast<std::size_t>(dims.front())) == 0 ||
+        elements != cols * rows * experts || dims.front() != cols ||
+        dims.size() > 3) {
+      Fail("tensor " + name + " has unexpected dimensions or format");
+      return ref;
+    }
+    ref.name = info->name;
+    ref.type = info->type;
+    ref.cols = dims.front();
+    ref.rows = 1;
+    ref.experts = 1;
+    if (dims.size() >= 2) {
+      ref.rows = dims[1];
+    }
+    if (dims.size() == 3) {
+      ref.experts = dims[2];
+    }
+    if (exact && (dims.size() != 3 || dims[1] != rows || dims[2] != experts)) {
+      Fail("tensor " + name + " must stack " + std::to_string(experts) +
+           " matrices of " + std::to_string(rows) + " rows");
+      return ref;
+    }
+    ref.file_offset = info->offset;
+    const auto regions = reader.GetMappedRegions();
+    for (std::uint32_t s = 0; s < regions.size(); ++s) {
+      const auto* base = static_cast<const std::uint8_t*>(regions[s].data);
+      const auto* data = static_cast<const std::uint8_t*>(info->data);
+      if (data >= base && data < base + regions[s].size) {
+        ref.shard = s;
+        ref.data = data;
+        // GGUF tensor offsets are relative to the shard's data section;
+        // the upload pipeline preads absolute file offsets, so derive the
+        // absolute position from the mapping.
+        ref.file_offset = static_cast<std::uint64_t>(data - base);
+        break;
+      }
+    }
+    if (ref.data == nullptr) {
+      Fail("tensor " + name + " is not backed by a mapped region");
+    }
+    return ref;
+  }
+
+  /// One-dimensional vector [n].
+  TensorRef Vector(const std::string& name, std::uint64_t n) {
+    TensorRef ref = Bind(name, n, 1, 1, false);
+    if (ok && ref.cols != n) {
+      Fail("tensor " + name + " has unexpected length");
+    }
+    return ref;
+  }
+
+  /// Folds trailing stacked dimensions into rows: [cols, 1, channels]
+  /// becomes cols x channels. Valid only for layouts whose trailing dims
+  /// fold without changing the element order or byte size.
+  static void FoldTrailing(TensorRef* ref) {
+    ref->rows = ref->rows * ref->experts;
+    ref->experts = 1;
+  }
+
+  void BindHc(HcWeights& hc, std::uint32_t layer, const char* prefix) {
+    const auto hc_dim = config.HcDim();
+    const auto mix = config.HcMixDim();
+    hc.fn = Bind(LayerName(layer, std::string(prefix) + "_fn.weight"), hc_dim,
+                 mix, 1);
+    hc.base =
+        Vector(LayerName(layer, std::string(prefix) + "_base.weight"), mix);
+    hc.scale =
+        Vector(LayerName(layer, std::string(prefix) + "_scale.weight"), 3);
+  }
+
+  void BindKda(KdaWeights& w, std::uint32_t layer) {
+    const auto inner = config.KdaInnerDim();
+    const auto head_dim = config.kda_head_dim;
+    w.q = Bind(LayerName(layer, "attn_q.weight"), config.hidden_size, inner, 1);
+    w.k = Bind(LayerName(layer, "attn_k.weight"), config.hidden_size, inner, 1);
+    w.v = Bind(LayerName(layer, "attn_v.weight"), config.hidden_size, inner, 1);
+    w.out = Bind(LayerName(layer, "attn_output.weight"), inner,
+                 config.hidden_size, 1);
+    // [kernel, 1, inner] folds to cols = kernel, rows = inner, experts = 1
+    // so one channel's taps are always row `channel`.
+    w.conv_q = Bind(LayerName(layer, "ssm_conv1d_q.weight"),
+                    config.kda_conv_kernel, inner, 1);
+    FoldTrailing(&w.conv_q);
+    w.conv_k = Bind(LayerName(layer, "ssm_conv1d_k.weight"),
+                    config.kda_conv_kernel, inner, 1);
+    FoldTrailing(&w.conv_k);
+    w.conv_v = Bind(LayerName(layer, "ssm_conv1d_v.weight"),
+                    config.kda_conv_kernel, inner, 1);
+    FoldTrailing(&w.conv_v);
+    w.f_a = Bind(LayerName(layer, "ssm_f_a.weight"), config.hidden_size,
+                 head_dim, 1);
+    w.f_b = Bind(LayerName(layer, "ssm_f_b.weight"), head_dim, inner, 1);
+    w.g_a = Bind(LayerName(layer, "ssm_g_a.weight"), config.hidden_size,
+                 head_dim, 1);
+    w.g_b = Bind(LayerName(layer, "ssm_g_b.weight"), head_dim, inner, 1);
+    w.beta = Bind(LayerName(layer, "ssm_beta.weight"), config.hidden_size,
+                  config.head_count, 1);
+    w.a = Vector(LayerName(layer, "ssm_a"), config.head_count);
+    w.dt_bias = Vector(LayerName(layer, "ssm_dt.bias"), inner);
+    w.o_norm = Vector(LayerName(layer, "ssm_norm.weight"), head_dim);
+  }
+
+  void BindDsa(DsaWeights& w, std::uint32_t layer) {
+    const auto query = config.MlaQueryDim();
+    w.q_a = Bind(LayerName(layer, "attn_q_a.weight"), config.hidden_size,
+                 config.q_lora_rank, 1);
+    w.q_a_norm =
+        Vector(LayerName(layer, "attn_q_a_norm.weight"), config.q_lora_rank);
+    w.q_b =
+        Bind(LayerName(layer, "attn_q_b.weight"), config.q_lora_rank, query, 1);
+    w.kv_a = Bind(LayerName(layer, "attn_kv_a_mqa.weight"), config.hidden_size,
+                  config.kv_lora_rank, 1);
+    w.kv_a_norm =
+        Vector(LayerName(layer, "attn_kv_a_norm.weight"), config.kv_lora_rank);
+    w.k_b = Bind(LayerName(layer, "attn_k_b.weight"), config.qk_nope_head_dim,
+                 config.kv_lora_rank, config.head_count, true);
+    w.v_b = Bind(LayerName(layer, "attn_v_b.weight"), config.kv_lora_rank,
+                 config.v_head_dim, config.head_count, true);
+    w.out = Bind(LayerName(layer, "attn_output.weight"), query,
+                 config.hidden_size, 1);
+  }
+
+  void BindIndexer(IndexerWeights& w, std::uint32_t layer) {
+    w.q_b = Bind(LayerName(layer, "indexer.attn_q_b.weight"),
+                 config.q_lora_rank, config.IndexerQueryDim(), 1);
+    w.k = Bind(LayerName(layer, "indexer.attn_k.weight"), config.hidden_size,
+               config.indexer_head_dim, 1);
+    w.k_norm = Vector(LayerName(layer, "indexer.k_norm.weight"),
+                      config.indexer_head_dim);
+    w.k_norm_bias = Vector(LayerName(layer, "indexer.k_norm.bias"),
+                           config.indexer_head_dim);
+    w.proj = Bind(LayerName(layer, "indexer.proj.weight"), config.hidden_size,
+                  config.indexer_heads, 1);
+    w.comp_gate = Bind(LayerName(layer, "indexer_compressor_gate.weight"),
+                       config.hidden_size, config.indexer_head_dim, 1);
+    w.comp_ape = Bind(LayerName(layer, "indexer_compressor_ape.weight"),
+                      config.indexer_head_dim, config.indexer_kpool, 1);
+  }
+
+  void BindFfn(LayerWeights& l, std::uint32_t layer) {
+    if (config.IsDenseFfnLayer(layer)) {
+      l.dense_ffn = true;
+      l.ffn_gate = Bind(LayerName(layer, "ffn_gate.weight"), config.hidden_size,
+                        config.dense_ffn, 1);
+      l.ffn_up = Bind(LayerName(layer, "ffn_up.weight"), config.hidden_size,
+                      config.dense_ffn, 1);
+      l.ffn_down = Bind(LayerName(layer, "ffn_down.weight"), config.dense_ffn,
+                        config.hidden_size, 1);
+      return;
+    }
+    l.router = Bind(LayerName(layer, "ffn_gate_inp.weight"), config.hidden_size,
+                    config.expert_count, 1);
+    l.router_bias =
+        Vector(LayerName(layer, "exp_probs_b.bias"), config.expert_count);
+    l.gate_exps =
+        Bind(LayerName(layer, "ffn_gate_exps.weight"), config.hidden_size,
+             config.expert_ffn, config.expert_count, true);
+    l.up_exps = Bind(LayerName(layer, "ffn_up_exps.weight"), config.hidden_size,
+                     config.expert_ffn, config.expert_count, true);
+    l.down_exps =
+        Bind(LayerName(layer, "ffn_down_exps.weight"), config.expert_ffn,
+             config.hidden_size, config.expert_count, true);
+    const auto shared_ff = config.expert_ffn * config.shared_experts;
+    l.gate_shexp = Bind(LayerName(layer, "ffn_gate_shexp.weight"),
+                        config.hidden_size, shared_ff, 1);
+    l.up_shexp = Bind(LayerName(layer, "ffn_up_shexp.weight"),
+                      config.hidden_size, shared_ff, 1);
+    l.down_shexp = Bind(LayerName(layer, "ffn_down_shexp.weight"), shared_ff,
+                        config.hidden_size, 1);
+  }
+};
+
+}  // namespace
+
+std::size_t TensorRef::RowBytes() const noexcept {
+  return SpanBytes(type, static_cast<std::size_t>(cols));
+}
+
+std::optional<ModelWeights> ModelWeights::Bind(const core::GgufReader& reader,
+                                               std::string* error_msg) {
+  auto config = Config::FromGguf(reader, error_msg);
+  if (!config.has_value()) {
+    return std::nullopt;
+  }
+  Binder binder{reader, *config, error_msg};
+  ModelWeights weights;
+  weights.config = *config;
+
+  weights.token_embd = binder.Bind("token_embd.weight", config->hidden_size,
+                                   config->vocab_size, 1);
+  weights.output =
+      binder.Bind("output.weight", config->hidden_size, config->vocab_size, 1);
+  weights.output_norm =
+      binder.Vector("output_norm.weight", config->hidden_size);
+
+  weights.layers.resize(config->num_layers);
+  for (std::uint32_t i = 0; i < config->num_layers; ++i) {
+    LayerWeights& l = weights.layers[i];
+    l.linear = !config->IsDsaLayer(i);
+    l.attn_norm = binder.Vector(binder.LayerName(i, "attn_norm.weight"),
+                                config->hidden_size);
+    l.ffn_norm = binder.Vector(binder.LayerName(i, "ffn_norm.weight"),
+                               config->hidden_size);
+    binder.BindHc(l.hc_attn, i, "hc_attn");
+    binder.BindHc(l.hc_ffn, i, "hc_ffn");
+    if (l.linear) {
+      binder.BindKda(l.kda, i);
+    } else {
+      binder.BindDsa(l.dsa, i);
+      binder.BindIndexer(l.indexer, i);
+    }
+    binder.BindFfn(l, i);
+    if (!binder.ok) {
+      return std::nullopt;
+    }
+  }
+
+  if (config->nextn_layers > 0) {
+    const std::uint32_t block = config->num_layers;
+    NextnWeights nextn;
+    nextn.eh_proj =
+        binder.Bind(binder.LayerName(block, "nextn.eh_proj.weight"),
+                    2 * config->hidden_size, config->hidden_size, 1);
+    nextn.enorm = binder.Vector(binder.LayerName(block, "nextn.enorm.weight"),
+                                config->hidden_size);
+    nextn.hnorm = binder.Vector(binder.LayerName(block, "nextn.hnorm.weight"),
+                                config->hidden_size);
+    nextn.shared_head_norm =
+        binder.Vector(binder.LayerName(block, "nextn.shared_head_norm.weight"),
+                      config->hidden_size);
+    LayerWeights& l = nextn.block;
+    l.linear = false;
+    l.attn_norm = binder.Vector(binder.LayerName(block, "attn_norm.weight"),
+                                config->hidden_size);
+    l.ffn_norm = binder.Vector(binder.LayerName(block, "ffn_norm.weight"),
+                               config->hidden_size);
+    binder.BindDsa(l.dsa, block);
+    binder.BindIndexer(l.indexer, block);
+    binder.BindFfn(l, block);
+    if (!binder.ok) {
+      return std::nullopt;
+    }
+    weights.nextn = std::move(nextn);
+  }
+
+  if (!binder.ok) {
+    return std::nullopt;
+  }
+  return weights;
+}
