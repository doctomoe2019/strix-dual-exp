--- /dev/null
+++ b/src/models/glm5_next/engine.cpp
@@ -0,0 +1,316 @@
+#include "src/models/glm5_next/engine.hpp"
+
+#include <hip/hip_runtime.h>
+
+#include <algorithm>
+#include <utility>
+
+#include "src/core/gguf_reader.hpp"
+#include "src/models/glm5_next/chat_template.hpp"
+#include "src/models/glm5_next/kernels/rocm/device_model.hpp"
+#include "src/models/glm5_next/kernels/rocm/executor.hpp"
+#include "src/models/glm5_next/weights.hpp"
+#include "src/models/qwen/tokenizer.hpp"
+
+namespace gufo::models::glm5_next {
+namespace {
+
+void SetError(std::string* error_msg, std::string message) {
+  if (error_msg != nullptr) {
+    *error_msg = std::move(message);
+  }
+}
+
+}  // namespace
+
+struct Model::Impl {
+  std::shared_ptr<const core::GgufReader> reader;
+  std::unique_ptr<rocm::Executor> executor;
+  std::unique_ptr<tokenization::QwenTokenizer> tokenizer;
+  bool has_all_reduce{false};
+};
+
+Model::~Model() = default;
+
+std::shared_ptr<Model> Model::Load(const std::string& model_path,
+                                   ModelOptions options,
+                                   std::string* error_msg) {
+  if (options.max_context == 0 || options.max_context > kMaxServingContext) {
+    SetError(error_msg, "GLM-5.3-Flash context must be within (0, " +
+                            std::to_string(kMaxServingContext) +
+                            "] — the runtime capacity ceiling");
+    return nullptr;
+  }
+  auto reader_owner = core::GgufReader::OpenFile(model_path, error_msg);
+  if (reader_owner == nullptr) {
+    return nullptr;
+  }
+  std::shared_ptr<const core::GgufReader> reader(std::move(reader_owner));
+  if (!ValidateGgufTemplate(*reader, error_msg)) {
+    return nullptr;
+  }
+  auto weights = ModelWeights::Bind(*reader, error_msg);
+  if (!weights.has_value()) {
+    return nullptr;
+  }
+  const Config& config = weights->config;
+  auto partition = distributed::TpPartition::Create(
+      config, options.tp_rank, options.tp_world_size, error_msg);
+  if (!partition.has_value()) {
+    return nullptr;
+  }
+  const auto plan =
+      distributed::PlanModelTensors(*weights, *partition, error_msg);
+  if (!plan.has_value()) {
+    return nullptr;
+  }
+  std::size_t resident_bytes = 0;
+  for (const auto& tensor : *plan) {
+    resident_bytes += tensor.span.local_bytes;
+  }
+  std::size_t free_bytes = 0;
+  std::size_t total_bytes = 0;
+  if (hipMemGetInfo(&free_bytes, &total_bytes) != hipSuccess ||
+      resident_bytes > free_bytes) {
+    SetError(error_msg,
+             "GLM resident weights exceed available device memory; "
+             "use a fitting TP partition");
+    return nullptr;
+  }
+  auto slice = rocm::DeviceSlice::Upload(*weights, *reader, config.num_layers,
+                                         &*partition, error_msg);
+  if (slice == nullptr) {
+    return nullptr;
+  }
+  rocm::Executor::Options executor_options;
+  const bool has_all_reduce = static_cast<bool>(options.all_reduce);
+  executor_options.all_reduce = std::move(options.all_reduce);
+  executor_options.prefill_chunk = options.prefill_chunk;
+  auto executor = rocm::Executor::Create(
+      std::move(slice), std::move(executor_options), error_msg);
+  if (executor == nullptr) {
+    return nullptr;
+  }
+  auto tokenizer =
+      tokenization::QwenTokenizer::CreateFromGguf(*reader, error_msg);
+  if (tokenizer == nullptr) {
+    return nullptr;
+  }
+  auto model = std::shared_ptr<Model>(new Model());
+  model->options_ = std::move(options);
+  model->impl_ = std::make_unique<Impl>();
+  model->impl_->reader = std::move(reader);
+  model->impl_->executor = std::move(executor);
+  model->impl_->tokenizer = std::move(tokenizer);
+  model->impl_->has_all_reduce = has_all_reduce;
+  return model;
+}
+
+struct Session::Impl {
+  std::shared_ptr<const Model> model;
+  std::unique_ptr<rocm::Executor::Session> session;
+  std::vector<std::int32_t> tokens;
+  std::vector<float> logits;
+  bool valid{true};
+  bool logits_valid{false};
+};
+
+std::unique_ptr<Session> Model::CreateSession(std::uint32_t capacity,
+                                              std::string* error_msg) const {
+  if (capacity == 0 || capacity > options_.max_context) {
+    SetError(error_msg, "session capacity must be within (0, max_context=" +
+                            std::to_string(options_.max_context) + "]");
+    return nullptr;
+  }
+  auto rocm_session = impl_->executor->CreateSession(capacity, error_msg);
+  if (rocm_session == nullptr) {
+    return nullptr;
+  }
+  auto impl = std::make_unique<Session::Impl>();
+  impl->model = shared_from_this();
+  impl->session = std::move(rocm_session);
+  impl->logits.resize(config().vocab_size);
+  return std::unique_ptr<Session>(new Session(std::move(impl)));
+}
+
+std::vector<std::int32_t> Model::Tokenize(std::string_view text) const {
+  const tokenization::TokenizerOptions options;
+  auto ids = impl_->tokenizer->Encode(text, options);
+  return std::vector<std::int32_t>(ids.begin(), ids.end());
+}
+
+std::string Model::Decode(std::span<const std::int32_t> tokens) const {
+  return impl_->tokenizer->Decode(std::span<const tokenization::TokenId>(
+      reinterpret_cast<const tokenization::TokenId*>(tokens.data()),
+      tokens.size()));
+}
+
+std::string Model::TokenText(std::int32_t token) const {
+  return impl_->tokenizer->DecodeTokenCopy(
+      static_cast<tokenization::TokenId>(token));
+}
+
+bool Model::IsStopToken(std::int32_t token) const noexcept {
+  for (std::uint32_t id : config().eos_token_ids) {
+    if (static_cast<std::int32_t>(id) == token) {
+      return true;
+    }
+  }
+  return false;
+}
+
+std::int32_t Model::EosToken() const noexcept {
+  const auto& ids = config().eos_token_ids;
+  return ids.empty() ? -1 : static_cast<std::int32_t>(ids.front());
+}
+
+std::uint32_t Model::VocabSize() const noexcept {
+  return config().vocab_size;
+}
+
+std::uint32_t Model::PrefillChunk() const noexcept {
+  if (options_.prefill_chunk == 0) {
+    return rocm::Executor::kMaxBatch;
+  }
+  return std::min(options_.prefill_chunk, rocm::Executor::kMaxBatch);
+}
+
+std::size_t Model::ResidentBytes() const noexcept {
+  return impl_->executor->slice().resident_bytes();
+}
+
+std::size_t Model::ScratchBytes() const noexcept {
+  return impl_->executor->scratch_bytes();
+}
+
+bool Model::HasAllReduce() const noexcept {
+  return impl_->has_all_reduce;
+}
+
+std::size_t Model::SessionBytes(std::uint32_t capacity) const noexcept {
+  if (capacity == 0) {
+    return 0;
+  }
+  const Config& c = config();
+  const distributed::TpPartition& p = impl_->executor->partition();
+  const std::uint32_t heads = p.head_count;
+  const std::uint32_t inner = heads * c.kda_head_dim;
+  const std::size_t pools =
+      static_cast<std::size_t>(capacity) / c.indexer_kpool + 1;
+  std::size_t bytes = 0;
+  for (std::uint32_t layer = 0; layer < c.num_layers; ++layer) {
+    if (c.IsDsaLayer(layer)) {
+      bytes +=
+          static_cast<std::size_t>(capacity) * c.kv_lora_rank * sizeof(float);
+      bytes += pools * c.indexer_head_dim * sizeof(float);
+      bytes += pools * sizeof(float);
+      bytes += 2 * static_cast<std::size_t>(c.indexer_kpool) *
+               c.indexer_head_dim * sizeof(float);
+    } else {
+      bytes += static_cast<std::size_t>(c.kda_conv_kernel - 1) * 3 * inner *
+               sizeof(float);
+      bytes += static_cast<std::size_t>(heads) * c.kda_head_dim *
+               c.kda_head_dim * sizeof(float);
+    }
+  }
+  return bytes;
+}
+
+const Config& Model::config() const noexcept {
+  return impl_->executor->config();
+}
+
+Session::Session(std::unique_ptr<Impl> impl) : impl_(std::move(impl)) {}
+
+Session::~Session() = default;
+
+bool Session::Sync(std::span<const std::int32_t> prompt,
+                   std::string* error_msg) {
+  if (!impl_->valid) {
+    SetError(error_msg, "session is invalid; Reset before reuse");
+    return false;
+  }
+  std::size_t common = 0;
+  while (common < impl_->tokens.size() && common < prompt.size() &&
+         impl_->tokens[common] == prompt[common]) {
+    ++common;
+  }
+  if (common != impl_->tokens.size()) {
+    // The prompt truncates or diverges from the executed history; the
+    // recurrent state cannot roll back, so replay in full.
+    impl_->session->Reset();
+    impl_->tokens.clear();
+    impl_->logits_valid = false;
+    common = 0;
+  }
+  if (common < prompt.size()) {
+    if (!impl_->model->impl_->executor->Prefill(
+            *impl_->session, prompt.subspan(common), impl_->logits.data(),
+            error_msg)) {
+      impl_->valid = false;
+      impl_->logits_valid = false;
+      return false;
+    }
+    impl_->tokens.insert(impl_->tokens.end(),
+                         prompt.begin() + static_cast<std::ptrdiff_t>(common),
+                         prompt.end());
+    impl_->logits_valid = true;
+  }
+  return true;
+}
+
+bool Session::Evaluate(std::int32_t token, std::string* error_msg) {
+  if (!impl_->valid) {
+    SetError(error_msg, "session is invalid; Reset before reuse");
+    return false;
+  }
+  if (!impl_->model->impl_->executor->Step(*impl_->session, token,
+                                           impl_->logits.data(), error_msg)) {
+    impl_->valid = false;
+    impl_->logits_valid = false;
+    return false;
+  }
+  impl_->tokens.push_back(token);
+  impl_->logits_valid = true;
+  return true;
+}
+
+std::span<const float> Session::Logits() const noexcept {
+  return impl_->logits_valid ? std::span<const float>(impl_->logits)
+                             : std::span<const float>{};
+}
+
+std::uint32_t Session::Position() const noexcept {
+  return impl_->session->position();
+}
+
+std::uint32_t Session::Capacity() const noexcept {
+  return impl_->session->capacity();
+}
+
+std::span<const std::int32_t> Session::Tokens() const noexcept {
+  return impl_->valid ? std::span<const std::int32_t>(impl_->tokens)
+                      : std::span<const std::int32_t>{};
+}
+
+void Session::Reset() noexcept {
+  impl_->session->Reset();
+  impl_->tokens.clear();
+  impl_->logits_valid = false;
+  impl_->valid = true;
+}
+
+bool Session::valid() const noexcept {
+  return impl_->valid;
+}
+
+std::size_t Session::StateBytes() const noexcept {
+  return impl_->session->state_bytes();
+}
+
+bool Session::StateHash(std::uint64_t* hash, std::string* error_msg) const {
+  return impl_->model->impl_->executor->HashState(*impl_->session, hash,
+                                                  error_msg);
+}
+
+}  // namespace gufo::models::glm5_next
