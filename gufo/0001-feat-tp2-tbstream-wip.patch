+/// HcCombineVec4Kernel<__half> that also emits the NEXT mixer's inject
+/// partials from the F16 norm row it writes: the norm is staged in LDS and
+/// replayed with the inject pass's exact thread grouping (part p's block
+/// covers columns [p*kThreads*4, ...) across all four streams), stream-major
+/// per-thread adds, WaveSum tree and wave-ordered partial sums, so the
+/// emitted partials match HcInjectPartialF16 over the same row bit for bit
+/// and the mixer's separate inject pass disappears. `inject_out` may alias
+/// `inject`: every block reads its own token's logits before rewriting them.
+__global__ void HcCombineVec4InjectF16Kernel(
+    float* res, const float* block_out, const float* inject,
+    std::uint32_t inject_parts, float* inject_out, const float* inject_w,
+    const float* gamma, __half* xn, void* xn_q8, std::uint32_t hidden,
+    float eps) {
+  constexpr std::uint32_t kStreams = 4;
+  constexpr std::uint32_t kMaxChunks = 10;  // 4 x 2560 / 4 / kThreads
+  __shared__ float shared[kStreams][kThreads / 32];
+  __shared__ __half s_xn[4 * 2560];
+  const std::uint32_t t = blockIdx.x;
+  const std::size_t hc_dim = static_cast<std::size_t>(kStreams) * hidden;
