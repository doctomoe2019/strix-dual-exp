+// A wedged state capture parks its request in the capturing deque forever:
+// the future never completes, the admission gate holds every queued request,
+// and before the stall watchdog nothing ever failed. The watchdog must shed
+// the parked set with retryable 408s so the server keeps serving.
+void TestStallWatchdogShedsWedgedCaptures() {
+  auto control = std::make_shared<FakeControl>();
+  control->max_context = 4096;
+  auto release = std::promise<void>{};
+  auto blocked = release.get_future().share();
+  control->snapshot_callback = [blocked] {
+    (void)blocked.wait_for(std::chrono::seconds(10));
+  };
+  TextSchedulerPolicy policy;
+  policy.stall_shed_interval = std::chrono::milliseconds(150);
+  auto scheduler = MakeScheduler(control, 2, {}, policy);
+  const auto started = std::chrono::steady_clock::now();
+  std::vector<gufo::server::TextGenerationScheduler::Request> requests;
+  requests.reserve(3);
+  for (const TextRunnerToken label : {41, 42, 43})
+    requests.push_back(scheduler->Submit({label}, 2, 0.0F));
+  for (auto& request : requests) {
+    bool stalled = false;
+    try {
+      (void)request.Wait();
+    } catch (const TextGenerationError& error) {
+      stalled = error.code() == TextGenerationErrorCode::kDeadlineExceeded;
+    }
+    Expect(stalled, "the stall watchdog fails a wedged capture with a 408");
+  }
+  const auto elapsed = std::chrono::duration_cast<std::chrono::milliseconds>(
+                           std::chrono::steady_clock::now() - started)
+                           .count();
+  // The first shed lands on the configured interval; later rounds may follow
+  // this test's own 10 s future-timeout when a retried capture parks again.
+  Expect(elapsed < 25000, "the watchdog fires on the configured interval");
+  release.set_value();
+}
+
+// The same wedged capture used to swallow the request deadline: the capture
+// harvest only checked CompleteIfStopped after SnapshotPending resolved, so
+// a pending-forever future made its request undeadeadlineable. The deadline
+// must fire while the capture is still pending.
+void TestDeadlineFiresDuringWedgedCapture() {
+  auto control = std::make_shared<FakeControl>();
+  control->max_context = 4096;
+  auto release = std::promise<void>{};
+  auto blocked = release.get_future().share();
+  control->snapshot_callback = [blocked] {
+    (void)blocked.wait_for(std::chrono::seconds(10));
+  };
+  TextSchedulerPolicy policy;
+  policy.stall_shed_interval = std::chrono::milliseconds(0);
+  policy.request_timeout = std::chrono::milliseconds(150);
+  auto scheduler = MakeScheduler(control, 2, {}, policy);
+  auto request = scheduler->Submit({44}, 2, 0.0F);
+  bool timed_out = false;
+  try {
+    (void)request.Wait();
+  } catch (const TextGenerationError& error) {
+    timed_out = error.code() == TextGenerationErrorCode::kDeadlineExceeded;
+  }
+  Expect(timed_out,
+         "a request deadline fires even while its capture is pending");
+  release.set_value();
+}
