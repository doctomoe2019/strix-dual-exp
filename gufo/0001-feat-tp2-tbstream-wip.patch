+/// HcCombineVec4Kernel<XnT> whose block output is the elementwise FP32 sum
+/// of a local partial and the peer's exchange partial (AddRowsBroadcast's
+/// sum, local + peer, formed in registers): the paired-prefill reduction
+/// folds into the combine, so the summed block output never round-trips
+/// memory. A non-null `block_summed` still receives the sum, for observers
+/// that read the reduced output.
+template<typename XnT>
+__global__ void HcCombinePeerVec4Kernel(
+    float* res, const float* block_local, const float* peer,
+    float* block_summed, const float* inject, std::uint32_t inject_parts,
+    const float* gamma, XnT* xn, void* xn_q8, std::uint32_t hidden, float eps) {
