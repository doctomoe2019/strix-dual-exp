+void BatchMlaAttention(const float* q_abs, const float* latents,
+                       const std::int32_t* selections,
+                       const std::uint32_t* counts, std::uint32_t sel_stride,
+                       const float* v_b, float* attn_out, float* probs,
+                       float* weighted, std::uint32_t tokens,
+                       std::uint32_t heads, std::uint32_t kv_lora,
+                       std::uint32_t qk_nope, std::uint32_t v_head, float scale,
+                       hipStream_t stream) {
+  // Same exact-geometry requirement as the absorb launcher: the score and
+  // epilogue stages assume whole kMlaLoraLanes lane strides of kv_lora.
+  if (kv_lora == kMlaLoraLanes * 32u && heads % kMlaHeads == 0) {
+    const dim3 grid(heads / kMlaHeads,
+                    (tokens + kMlaTileTokens - 1) / kMlaTileTokens);
+    // Split launch: the score kernel leaves the probabilities in the probs
+    // stripe, the gather kernel (same stream, launched next) reads them
+    // back. The shared exp staging of the score kernel needs one double per
+    // selection slot plus one per head.
+    const std::size_t score_lds =
+        (static_cast<std::size_t>(sel_stride) + kMlaHeads) * sizeof(double);
+    BatchMlaScoreTiledKernel<kMlaHeads><<<grid, kv_lora, score_lds, stream>>>(
+        q_abs, latents, selections, counts, sel_stride, probs, tokens, heads,
+        kv_lora, kMlaTileTokens, scale);
+    BatchMlaGatherTiledKernel<kMlaHeads><<<grid, kv_lora, 0, stream>>>(
+        latents, selections, counts, sel_stride, v_b, probs, attn_out, weighted,
+        tokens, heads, kv_lora, v_head, kMlaTileTokens);
+    return;
+  }
+  const std::uint32_t shared_floats = sel_stride + 1;
+  const dim3 grid(heads, tokens);
+  BatchMlaAttentionKernel<<<grid, kv_lora, shared_floats * sizeof(float),
+                            stream>>>(
+      q_abs, latents, selections, counts, sel_stride, v_b, attn_out, probs,
+      weighted, heads, kv_lora, qk_nope, v_head, scale);
+}
+
+void ScaleAddRowsWeighted(float* acc, const float* x, const float* weights,
+                          std::uint32_t tokens, std::uint32_t hidden,
+                          std::size_t x_stride, hipStream_t stream) {
+  const std::size_t count = static_cast<std::size_t>(tokens) * hidden;
+  ScaleAddRowsWeightedKernel<<<GridBlocks(count), kBlockThreads, 0, stream>>>(
+      acc, x, weights, hidden, x_stride, count);
+}
+
+void BatchAppendRows(const float* src, float* dst, std::uint32_t row,
+                     std::uint32_t offset, std::uint32_t tokens,
+                     hipStream_t stream) {
+  BatchAppendRowsKernel<<<GridBlocks(static_cast<std::size_t>(tokens) * row),
+                          kBlockThreads, 0, stream>>>(src, dst, row, offset,
+                                                      tokens);
+}
+
+}  // namespace gufo::models::glm5_next::rocm
