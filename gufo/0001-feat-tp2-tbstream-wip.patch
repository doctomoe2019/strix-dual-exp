+
+/// The source `ParseResponseFormat` compiled, for a TP2 peer that must
+/// rebuild the same grammar: the dumped schema and strict flag for
+/// `json_schema`, the object flag for `json_object`, and empty for `text`.
+/// Both spellings are described: Chat nests the specification under
+/// "json_schema", Responses keeps its members at the top level.
+struct ResponseFormatSource {
+  bool object{false};
+  std::string schema;
+  bool strict{false};
+};
+inline ResponseFormatSource DescribeResponseFormat(const json::Value* format) {
+  ResponseFormatSource source;
+  if (!format || !format->is_object())
+    return source;
+  const auto type = format->member_str("type");
+  if (type == "json_object") {
+    source.object = true;
+    return source;
+  }
+  if (type != "json_schema")
+    return source;
+  const json::Value* specification = format->find("json_schema");
+  if (specification == nullptr && format->find("schema") != nullptr)
+    specification = format;
+  if (!specification || !specification->is_object())
+    return source;
+  if (const auto* strict = specification->find("strict");
+      strict && !strict->is_null())
+    source.strict = strict->as_bool();
+  if (const auto* schema = specification->find("schema"))
+    source.schema = schema->dump();
+  return source;
+}
