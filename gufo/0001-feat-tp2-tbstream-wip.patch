+#include "src/models/glm5_next/chat_template.hpp"
+
+#include <algorithm>
+#include <cctype>
+#include <cstddef>
+#include <cstdint>
+#include <unordered_set>
+#include <utility>
+
+#include "src/core/crypto/sha256.hpp"
+
+namespace gufo::models::glm5_next {
+namespace {
+
+constexpr std::string_view kHeader = "[gMASK]<sop>";
+constexpr std::string_view kSystem = "<|system|>";
+constexpr std::string_view kUser = "<|user|>";
+constexpr std::string_view kAssistant = "<|assistant|>";
+constexpr std::string_view kObservation = "<|observation|>";
+constexpr std::string_view kThink = "<think>";
+constexpr std::string_view kThinkEnd = "</think>";
+
+std::string_view NormalizeEffort(
+    const std::optional<std::string_view>& effort) {
+  if (!effort.has_value()) {
+    return "max";
+  }
+  if (*effort == "low" || *effort == "high" || *effort == "max") {
+    return *effort;
+  }
+  return "max";
+}
+
+void AppendEffortLine(std::string& out,
+                      const std::optional<std::string_view>& effort) {
+  out.append(kSystem);
+  out.append("Reasoning Effort: ");
+  const std::string_view value = NormalizeEffort(effort);
+  out.push_back(static_cast<char>(
+      std::toupper(static_cast<unsigned char>(value.front()))));
+  out.append(value.substr(1));
+}
+
+void AppendJsonString(std::string& out, std::string_view value) {
+  out.push_back('"');
+  for (const unsigned char character : value) {
+    switch (character) {
+      case '"':
+        out.append("\\\"");
+        break;
+      case '\\':
+        out.append("\\\\");
+        break;
+      case '\b':
+        out.append("\\b");
+        break;
+      case '\f':
+        out.append("\\f");
+        break;
+      case '\n':
+        out.append("\\n");
+        break;
+      case '\r':
+        out.append("\\r");
+        break;
+      case '\t':
+        out.append("\\t");
+        break;
+      default:
+        out.push_back(static_cast<char>(character));
+        break;
+    }
+  }
+  out.push_back('"');
+}
+
+/// The template's tool_to_json macro: `{"name": ..., "description": ...,
+/// "parameters": ...}` with ", " separators and compact JSON values.
+void AppendToolJson(std::string& out, const ChatTool& tool) {
+  out.append("{\"name\": ");
+  AppendJsonString(out, tool.name);
+  out.append(", \"description\": ");
+  AppendJsonString(out, tool.description);
+  out.append(", \"parameters\": ");
+  out.append(tool.parameters_json);
+  out.push_back('}');
+}
+
+void AppendToolsBlock(std::string& out, std::span<const ChatTool> tools) {
+  if (tools.empty()) {
+    return;
+  }
+  out.append(kSystem);
+  out.append(
+      "\n# Tools\n\n"
+      "You may call one or more functions to assist with the user query.\n\n"
+      "You are provided with function signatures within <tools></tools> XML "
+      "tags:\n<tools>\n");
+  for (const auto& tool : tools) {
+    out.push_back('\n');
+    AppendToolJson(out, tool);
+    out.append("\n\n");
+  }
+  out.append(
+      "\n</tools>\n\n"
+      "For each function call, output the function name and arguments "
+      "within the following XML format:\n"
+      "<tool_call>{function-name}<arg_key>{arg-key-1}</arg_key>"
+      "<arg_value>{arg-value-1}</arg_value><arg_key>{arg-key-2}</arg_key>"
+      "<arg_value>{arg-value-2}</arg_value>...</tool_call>");
+}
+
+std::string_view Stripped(std::string_view text) {
+  while (!text.empty() &&
+         std::isspace(static_cast<unsigned char>(text.front()))) {
+    text.remove_prefix(1);
+  }
+  while (!text.empty() &&
+         std::isspace(static_cast<unsigned char>(text.back()))) {
+    text.remove_suffix(1);
+  }
+  return text;
+}
+
+/// Reasoning shown for one assistant turn: explicit reasoning_content, or
+/// the <think> span embedded in content (which is then removed).
+void SplitReasoning(const ChatMessage& message, std::string& reasoning,
+                    std::string& content) {
+  content = message.content;
+  if (!message.reasoning_content.empty()) {
+    reasoning = message.reasoning_content;
+    return;
+  }
+  const std::size_t end = content.find(kThinkEnd);
+  if (end == std::string::npos) {
+    reasoning.clear();
+    return;
+  }
+  const std::size_t begin = content.find(kThink);
+  if (begin == std::string::npos || begin > end) {
+    reasoning.clear();
+    return;
+  }
+  reasoning =
+      content.substr(begin + kThink.size(), end - begin - kThink.size());
+  content = content.substr(end + kThinkEnd.size());
+}
+
+struct ToolRun {
+  std::size_t begin{0};
+  std::size_t end{0};  // Exclusive.
+  /// The assistant tool_calls preceding the run, null when absent.
+  const std::vector<ChatMessage::ToolCall>* calls{nullptr};
+  /// True when results may be reordered to match the call ids.
+  bool can_sort{false};
+};
+
+std::string_view ResultId(const ChatMessage& message) {
+  return message.tool_call_id.empty() ? std::string_view{}
+                                      : message.tool_call_id;
+}
+
+bool RunCanSort(std::span<const ChatMessage> messages, const ToolRun& run) {
+  if (run.calls == nullptr || run.calls->empty()) {
+    return false;
+  }
+  std::unordered_set<std::string_view> call_ids;
+  for (const auto& call : *run.calls) {
+    if (call.id.empty() || !call_ids.insert(call.id).second) {
+      return false;
+    }
+  }
+  std::unordered_set<std::string_view> seen;
+  for (std::size_t i = run.begin; i < run.end; ++i) {
+    const std::string_view id = ResultId(messages[i]);
+    if (id.empty() || !seen.insert(id).second ||
+        call_ids.find(id) == call_ids.end()) {
+      return false;
+    }
+  }
+  return true;
+}
+
+void AppendToolResult(std::string& out, const ChatMessage& message,
+                      const ChatTool* referenced) {
+  out.append("<tool_response>");
+  if (referenced != nullptr) {
+    out.append("<tools>\n");
+    AppendToolJson(out, *referenced);
+    out.append("\n</tools>");
+  } else {
+    out.append(message.content);
+  }
+  out.append("</tool_response>");
+}
+
+void AppendObservationRun(std::string& out, std::span<const ChatMessage> all,
+                          std::size_t begin, std::size_t end,
+                          const ToolRun& run, std::string* error) {
+  out.append(kObservation);
+  if (run.can_sort) {
+    for (const auto& call : *run.calls) {
+      for (std::size_t i = begin; i < end; ++i) {
+        if (ResultId(all[i]) == call.id) {
+          AppendToolResult(out, all[i], nullptr);
+        }
+      }
+    }
+    return;
+  }
+  for (std::size_t i = begin; i < end; ++i) {
+    AppendToolResult(out, all[i], nullptr);
+  }
+  (void)error;
+}
+
+}  // namespace
+
+std::string RenderChat(std::span<const ChatMessage> messages,
+                       std::span<const ChatTool> tools,
+                       const ChatTemplateOptions& options) {
+  std::string out;
+  out.reserve(1024);
+  out.append(kHeader);
+  AppendEffortLine(out, options.reasoning_effort);
+  AppendToolsBlock(out, tools);
+
+  // Last user position drives clear_thinking (reasoning before it drops).
+  std::size_t last_user = messages.size();
+  for (std::size_t i = 0; i < messages.size(); ++i) {
+    if (messages[i].role == "user") {
+      last_user = i;
+    }
+  }
+
+  std::size_t i = 0;
+  while (i < messages.size()) {
+    const ChatMessage& message = messages[i];
+    if (message.role == "user") {
+      out.append(kUser);
+      out.append(message.content);
+      ++i;
+      continue;
+    }
+    if (message.role == "system") {
+      out.append(kSystem);
+      out.append(message.content);
+      ++i;
+      continue;
+    }
+    if (message.role == "assistant") {
+      out.append(kAssistant);
+      std::string reasoning;
+      std::string content;
+      SplitReasoning(message, reasoning, content);
+      // Clearing drops reasoning on turns at or before the last user
+      // message; later assistant turns keep it.
+      const bool cleared = options.clear_thinking && i <= last_user;
+      const bool has_reasoning =
+          (!message.reasoning_content.empty() || !reasoning.empty()) &&
+          !cleared;
+      out.append(kThink);
+      if (has_reasoning) {
+        out.append(reasoning);
+      }
+      out.append(kThinkEnd);
+      const std::string_view stripped = Stripped(content);
+      if (!stripped.empty()) {
+        out.append(stripped);
+      }
+      if (!message.tool_calls.empty()) {
+        out.push_back('\n');
+        for (const auto& call : message.tool_calls) {
+          out.append("<tool_call>");
+          out.append(call.name);
+          for (const auto& argument : call.arguments) {
+            out.append("<arg_key>");
+            out.append(argument.name);
+            out.append("</arg_key><arg_value>");
+            if (argument.is_string) {
+              out.append(argument.value);
+            } else {
+              out.append(argument.value);  // Compact JSON, pre-encoded.
+            }
+            out.append("</arg_value>");
+          }
+          out.append("</tool_call>");
+        }
+        out.push_back('\n');
+      }
+      ++i;
+      continue;
+    }
+    if (message.role == "tool") {
+      ToolRun run;
+      run.begin = i;
+      run.end = i;
+      while (run.end < messages.size() && messages[run.end].role == "tool") {
+        ++run.end;
+      }
+      if (run.begin > 0 && messages[run.begin - 1].role == "assistant" &&
+          !messages[run.begin - 1].tool_calls.empty()) {
+        run.calls = &messages[run.begin - 1].tool_calls;
+      }
+      run.can_sort = RunCanSort(messages, run);
+      AppendObservationRun(out, messages, run.begin, run.end, run, nullptr);
+      i = run.end;
+      continue;
+    }
+    ++i;
+  }
+
+  if (options.add_generation_prompt) {
+    out.append(kAssistant);
+    out.append(kThink);
+  }
+  return out;
+}
+
+bool ValidateGgufTemplate(const core::GgufReader& reader,
+                          std::string* error_msg) {
+  const auto value = reader.GetMetadataString("tokenizer.chat_template");
+  if (!value.has_value()) {
+    if (error_msg != nullptr) {
+      *error_msg = "artifact carries no chat template";
+    }
+    return false;
+  }
+  const auto* begin = reinterpret_cast<const std::uint8_t*>(value->data());
+  const std::string sha = crypto::Sha256Hex({begin, value->size()});
+  if (sha != ArtifactTemplateSha256()) {
+    if (error_msg != nullptr) {
+      *error_msg = "unsupported GLM chat template revision: sha256=" + sha;
+    }
+    return false;
+  }
+  return true;
+}
+
+ChatTemplateOptions ResolveChatOptions(
+    const gufo::ReasoningOptions& reasoning) {
+  ChatTemplateOptions options;
+  switch (reasoning.effort.value_or(gufo::ReasoningEffort::kMax)) {
+    case gufo::ReasoningEffort::kMinimal:
+    case gufo::ReasoningEffort::kLow:
+      options.reasoning_effort = "low";
+      break;
+    case gufo::ReasoningEffort::kMedium:
+    case gufo::ReasoningEffort::kHigh:
+      options.reasoning_effort = "high";
+      break;
+    case gufo::ReasoningEffort::kXHigh:
+    case gufo::ReasoningEffort::kMax:
+      options.reasoning_effort = "max";
+      break;
+  }
+  // The template's default keeps prior reasoning; only an explicit discard
+  // clears it from turns before the last user message.
+  options.clear_thinking =
+      reasoning.preserve_thinking.has_value() && !*reasoning.preserve_thinking;
+  return options;
+}
+
+}  // namespace gufo::models::glm5_next
