+              item.contains("namespace") ? item.member_str("namespace") : "-";
+    Expect(namespaces.size() == 2 &&
+               namespaces["close_agent"] == "multi_agent_v1" &&
+               namespaces["exec"] == "-",
+           "function calls echo only their own namespace");
