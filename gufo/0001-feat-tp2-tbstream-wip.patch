+                        << " v=" << property.schema << " qwen=" << qwen
+                        << " strict=" << strict << "\n";
+            assert(Accepts(*grammar, call(value)));
+            assert(
+                Accepts(*grammar, call(argument("other", "o", true) + value)));
+            if (Accepts(*grammar, call(argument("other", "o", true))))
