+// Host harness.
+
+#define HIPCK(call)                                                 \
+  do {                                                              \
+    hipError_t err__ = (call);                                      \
+    if (err__ != hipSuccess) {                                      \
+      std::fprintf(stderr, "HIP error %s at %s:%d\n",               \
+                   hipGetErrorString(err__), __FILE__, __LINE__);  \
+      std::exit(1);                                                 \
+    }                                                               \
+  } while (0)
+
+struct Shape {
+  const char* name;
+  std::uint32_t m;
+  std::uint32_t k;
+  std::size_t x_stride;  // hidden for gate/up (shared rows), 1 for down
+};
+
+constexpr std::uint32_t kQ4KBytes = 144;
+constexpr std::uint32_t kQ4KQK = 256;
+
+std::uint32_t g_iters = 5;
+
+struct Variant {
+  const char* name;
+  void* fn;
+  std::uint32_t grid_div;  // rows per block
+  std::uint32_t threads;
+  bool needs_zero_y;
+  bool expect_v0_identical;
+};
+
+void RunRouting(const std::int32_t* d_ids, std::uint32_t* d_bins,
+                std::uint32_t* d_ranks, std::uint32_t* d_pairs,
+                std::uint32_t tokens, hipStream_t stream) {
+  const std::uint32_t count = tokens * kSlots;
+  ExpertZeroKernel<<<1, 256, 0, stream>>>(d_bins, kExperts);
+  ExpertHistogramKernel<<<(count + 255) / 256, 256, 0, stream>>>(
+      d_ids, d_bins, d_ranks, count);
+  ExpertPrefixKernel<<<1, 1, 0, stream>>>(d_bins, kExperts);
+  ExpertScatterKernel<<<(count + 255) / 256, 256, 0, stream>>>(
+      d_ids, d_bins, d_ranks, d_pairs, count);
+}
+
+/// Routing for one token whose pairs start at global index token_base*kSlots;
+/// x rows and y slots then land exactly where an N-token launch would put
+/// them.
+void RunRoutingToken(const std::int32_t* d_ids, std::uint32_t* d_bins,
+                      std::uint32_t* d_ranks, std::uint32_t* d_pairs,
+                      std::uint32_t token_base, hipStream_t stream) {
+  ExpertZeroKernel<<<1, 256, 0, stream>>>(d_bins, kExperts);
+  ExpertHistogramKernel<<<1, kSlots, 0, stream>>>(d_ids, d_bins, d_ranks,
+                                                   kSlots);
+  ExpertPrefixKernel<<<1, 1, 0, stream>>>(d_bins, kExperts);
+  ExpertScatterTokenKernel<<<1, kSlots, 0, stream>>>(
+      d_ids, d_bins, d_ranks, d_pairs, token_base * kSlots);
+}
+
+template <typename T>
+T* Device(const std::vector<T>& host) {
+  T* ptr = nullptr;
+  HIPCK(hipMalloc(&ptr, host.size() * sizeof(T)));
+  HIPCK(hipMemcpy(ptr, host.data(), host.size() * sizeof(T),
+                  hipMemcpyHostToDevice));
+  return ptr;
+}
+
+std::vector<std::uint8_t> MakeQ4KWeights(std::uint32_t experts,
+                                         std::uint32_t m, std::uint32_t k) {
+  const std::size_t row_blocks = k / kQ4KQK;
+  const std::size_t row_bytes = row_blocks * kQ4KBytes;
+  std::vector<std::uint8_t> w(static_cast<std::size_t>(experts) * m * row_bytes);
+  std::uint64_t rng = 0x9e3779b97f4a7c15ULL;
+  const auto next32 = [&]() {
+    rng ^= rng << 13;
+    rng ^= rng >> 7;
+    rng ^= rng << 17;
+    return static_cast<std::uint32_t>(rng >> 32);
+  };
+  for (std::size_t i = 0; i < w.size(); ++i) {
+    w[i] = static_cast<std::uint8_t>(next32());
+  }
+  for (std::size_t r = 0; r < static_cast<std::size_t>(experts) * m; ++r) {
+    for (std::size_t b = 0; b < row_blocks; ++b) {
+      std::uint8_t* blk = w.data() + r * row_bytes + b * kQ4KBytes;
+      const std::uint16_t d =
+          static_cast<std::uint16_t>(0x3800 + (next32() & 0xff));
+      const std::uint16_t dmin =
+          static_cast<std::uint16_t>(0x3000 + (next32() & 0x3f));
+      std::memcpy(blk, &d, 2);
+      std::memcpy(blk + 2, &dmin, 2);
+    }
+  }
+  return w;
+}
+
+int CountDiff(const float* a, const float* b, std::size_t n) {
+  int bad = 0;
+  for (std::size_t i = 0; i < n; ++i) {
+    if (std::memcmp(&a[i], &b[i], 4) != 0) {
+      if (bad < 3) {
+        std::printf("    diff at %zu: %a vs %a\n", i, a[i], b[i]);
+      }
+      ++bad;
+    }
+  }
+  return bad;
+}
