+  std::string fixtures_dir;
+  std::string prefix = "capfr";
+  std::string trace_name = "slice";
+  std::string tokens_arg = "785,6722,315,9621,374";
+  std::uint32_t random_count = 0;
+  std::uint32_t random_seed = 1;
+  bool boundary = false;
+  bool timing = false;
+  for (int i = 1; i < argc; ++i) {
+    const std::string arg = argv[i];
+    auto next = [&]() -> std::string {
+      return i + 1 < argc ? argv[++i] : std::string();
