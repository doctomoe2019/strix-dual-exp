+/// A runner that publishes its engine prefill chunk keeps intermediate
+/// checkpoints on chunk multiples: a lone cold prefill is never clamped
+/// below the engine's own chunk size, and unaligned grid points round up
+/// and merge rather than landing mid-chunk.
+void TestPrefillChunkAlignedCheckpoints() {
+  class ChunkAlignedRunner final : public SnapshotRunner {
+  public:
+    using SnapshotRunner::SnapshotRunner;
+    TextRunnerDescriptor Descriptor() const override {
+      auto descriptor = SnapshotRunner::Descriptor();
+      descriptor.max_context = 32768;
+      descriptor.prefill_chunk_tokens = 4096;
+      return descriptor;
+    }
+  };
+  auto stats = std::make_shared<FakeStats>();
+  TextRunnerPool pool(
+      std::make_shared<ChunkAlignedRunner>(stats, 64, 256, 4096), 1);
+  std::vector<TextRunnerToken> prompt(10000, 1);
+  auto original = pool.Acquire(prompt, {}, {}, {}, true, 9900);
+  stats->prefill_spans.clear();
+  Expect(original.Prefill(32768).consumed_tokens == 4096,
+         "an aligned grid never clamps a cold prefill below the engine chunk");
+  while (!original.prefill_complete())
+    (void)original.Prefill(32768);
+  original.Commit();
+  Expect(
+      stats->prefill_spans == std::vector<std::size_t>({4096, 4096, 1708, 100}),
+      "cold chunks stay at the engine's own size between checkpoints");
+
+  prompt[9000] = 2;
+  auto late_edit = pool.Acquire(prompt, {}, {}, {}, true, 9900);
+  Expect(late_edit.cache_hit() && late_edit.cached_prompt_tokens() == 8192,
+         "a grid point already on the chunk boundary is kept");
+  while (!late_edit.prefill_complete())
+    (void)late_edit.Prefill(32768);
+  late_edit.Commit();
+
+  prompt[6500] = 3;
+  auto mid_edit = pool.Acquire(prompt, {}, {}, {}, true, 9900);
+  Expect(mid_edit.cache_hit() && mid_edit.cached_prompt_tokens() == 4096,
+         "unaligned grid points round up and merge into chunk multiples");
+  mid_edit.Invalidate();
+}
