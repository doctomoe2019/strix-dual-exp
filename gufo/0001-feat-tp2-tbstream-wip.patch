+++ b/tools/llama_parity/gufo_probe.cpp
@@ -0,0 +1,52 @@
+// Print whether gufo's native tool grammar admits each candidate of cases.py.
+// Usage: gufo_probe CASES.tsv qwen|ds auto|required
+#include <fstream>
+#include <iostream>
+
+#include "src/core/json_constraint.hpp"
+using namespace gufo::sampling;
+bool Accepts(const JsonConstraint& g, std::string_view t) {
+  auto s = g.Start();
+  for (unsigned char b : t) {
+    s = g.Advance(s, b);
+    if (s.empty())
+      return false;
+  }
+  return g.Complete(s);
+}
+int main(int, char** argv) {
+  std::ifstream in(argv[1]);
+  std::string line;
+  while (std::getline(in, line)) {
+    std::vector<std::string> cols;
+    size_t pos = 0, tab;
+    while ((tab = line.find('\t', pos)) != std::string::npos) {
+      cols.push_back(line.substr(pos, tab - pos));
+      pos = tab + 1;
+    }
+    cols.push_back(line.substr(pos));
+    std::shared_ptr<const JsonConstraint> p;
+    try {
+      p = JsonConstraint::ToolParameters(
+          gufo::json::parse(cols[1]), false,
+          (std::string(argv[2]) == "ds" ? JsonConstraint::ToolFormat::kDeepSeek
+                                        : JsonConstraint::ToolFormat::kQwen));
+    } catch (const std::exception& e) {
+      std::cout << cols[0] << "\tERROR " << e.what() << "\n";
+      continue;
+    }
+    if (!p) {
+      std::cout << cols[0] << "\tJSON_FALLBACK\n";
+      continue;
+    }
+    auto g = JsonConstraint::WithTools(
+        nullptr, {{"record", p}}, std::string(argv[3]) == "required", false,
+        (std::string(argv[2]) == "ds" ? JsonConstraint::ToolFormat::kDeepSeek
+                                      : JsonConstraint::ToolFormat::kQwen));
+    for (size_t i = 2; i < cols.size(); ++i)
+      std::cout << cols[0] << "\tcand" << i - 1 << "\t"
+                << (Accepts(*g, gufo::json::parse(cols[i]).str()) ? "yes"
+                                                                  : "no")
+                << "\n";
+  }
+}
diff --git a/tools/llama_parity/llama_probe.cpp b/tools/llama_parity/llama_probe.cpp
new file mode 100644
index 0000000..123b7ec
--- /dev/null
+++ b/tools/llama_parity/llama_probe.cpp
@@ -0,0 +1,84 @@
+// For each tool schema of cases.py, print llama.cpp's parse of each candidate
+// output and whether its own tool grammar (GBNF engine) admits it.
+// Usage: llama_probe MODEL.gguf CASES.tsv (only the chat template is used).
+#include <cstdio>
+#include <fstream>
+#include <nlohmann/json.hpp>
+
+#include "../src/llama-grammar.h"
+#include "../src/unicode.h"
+#include "chat.h"
+#include "llama.h"
+int main(int argc, char** argv) {
+  llama_backend_init();
+  auto mp = llama_model_default_params();
+  mp.vocab_only = true;
+  llama_model* model = llama_model_load_from_file(argv[1], mp);
+  auto tmpls = common_chat_templates_init(model, "");
+  std::ifstream in(argv[2]);
+  std::string line;
+  while (std::getline(in, line)) {
+    // label \t schema \t candidate1 \t candidate2 ...
+    std::vector<std::string> cols;
+    size_t pos = 0, tab;
+    while ((tab = line.find('\t', pos)) != std::string::npos) {
+      cols.push_back(line.substr(pos, tab - pos));
+      pos = tab + 1;
+    }
+    cols.push_back(line.substr(pos));
+    common_chat_templates_inputs inputs;
+    common_chat_msg u;
+    u.role = "user";
+    u.content = "call";
+    inputs.messages = {u};
+    common_chat_tool t;
+    t.name = "record";
+    t.description = "";
+    t.parameters = cols[1];
+    inputs.tools = {t};
+    inputs.tool_choice = COMMON_CHAT_TOOL_CHOICE_REQUIRED;
+    inputs.enable_thinking = false;
+    common_chat_params p;
+    try {
+      p = common_chat_templates_apply(tmpls.get(), inputs);
+    } catch (const std::exception& e) {
+      printf("%s\tAPPLY_ERROR %s\n", cols[0].c_str(), e.what());
+      continue;
+    }
+    common_chat_parser_params pp(p);
+    pp.parser.load(p.parser);
+    auto grammar_accepts = [&](const std::string& text) {
+      llama_grammar* g = llama_grammar_init_impl(
+          nullptr, p.grammar.c_str(), "root", false, nullptr, 0, nullptr, 0);
+      if (!g)
+        return std::string("init-failed");
+      for (uint32_t cpt : unicode_cpts_from_utf8(text)) {
+        llama_grammar_accept(g, cpt);
+        if (llama_grammar_get_stacks(g).empty()) {
+          llama_grammar_free_impl(g);
+          return std::string("no");
+        }
+      }
+      bool done = false;
+      for (const auto& st : llama_grammar_get_stacks(g))
+        done |= st.empty();
+      llama_grammar_free_impl(g);
+      return std::string(done ? "yes" : "no");
+    };
+    for (size_t i = 2; i < cols.size(); ++i) {
+      std::string text = nlohmann::json::parse(cols[i]).get<std::string>();
+      try {
+        // common_chat_parse adds pp.generation_prompt itself.
+        auto m = common_chat_parse(text, false, pp);
+        std::string args =
+            m.tool_calls.empty() ? "-" : m.tool_calls[0].arguments;
+        printf("%s\tcand%zu\tcalls=%zu\targs=%s\tgrammar=%s\n", cols[0].c_str(),
+               i - 1, m.tool_calls.size(), args.c_str(),
+               grammar_accepts(p.generation_prompt + text).c_str());
+      } catch (const std::exception& e) {
+        printf("%s\tcand%zu\tPARSE_ERROR\tgrammar=%s\n", cols[0].c_str(), i - 1,
+               grammar_accepts(p.generation_prompt + text).c_str());
+      }
+    }
+  }
+}
diff --git a/tools/tbstream/README.md b/tools/tbstream/README.md
new file mode 100644
index 0000000..a729fa3
--- /dev/null
+++ b/tools/tbstream/README.md
@@ -0,0 +1,139 @@
+# USB4STREAM qualification for TP=2
+
+Tools for the `tbstream` TP=2 data transport (see
+`docs/models/qwen3.8-flash-next/TP2.md`): `setup-stream.sh` configures the
+kernel's USB4STREAM stream on one host, and `tbstream_probe` measures the
+link. Both run on ordinary Linux with no GPU stack.
+
+## Requirements
+
+- Linux **7.2 or newer**: the `thunderbolt_stream` driver (USB4STREAM
+  protocol, `/dev/tbstreamX`) landed there. On Ubuntu, a mainline kernel
+  from the mainline PPA or `kernel.ubuntu.com` works; verify with
+  `uname -r` and `ls /sys/kernel/config/thunderbolt/stream` after mounting
+  configfs.
+- A direct USB4 v2 (80G) or USB4 (40G) cable between the two Strix Halo
+  hosts. Use the same port pair on both ends for repeatability.
+- `bolt` (`boltctl`) only if the host enforces Thunderbolt security.
+
+## Bring-up on each host
+
+```sh
+sudo mount -t configfs none /sys/kernel/config   # if not already mounted
+sudo tools/tbstream/setup-stream.sh check        # kernel, link, authorization
+sudo tools/tbstream/setup-stream.sh up           # creates stream gufo
+```
+
+`check` names every problem: kernel too old, configfs missing, peer router
+unauthorized (`boltctl authorize <uuid>`, or BIOS security `none`), no
+`/dev/tbstream*`. The stream directory path is discovered from the peer
+router (`0-<route>.0`); override with `TB_STREAM_PATH` or `TB_STREAM_INDEX`
+when the kernel's naming differs (see the kernel's Thunderbolt
+documentation for the exact configfs layout).
+
+Bring the stream up on **both** hosts: each side announces its streams over
+XDomain properties, and the pair negotiates HopIDs automatically
+(`in_hopid`/`out_hopid` set to `-1`).
+
+For the control channel, either keep a LAN between the hosts or let it ride
+the cable on the `tb0`/`tb1` netdev (thunderbolt-net): `ip link set tb0 up`
+and use its link-local IPv6 address as `--tp-bootstrap-host`.
+
+## Qualification (Phase 0 gates)
+
+Run on both hosts; rank 1 points `--peer` at rank 0. First, verify the
+protocol logic anywhere with no hardware: `tbstream_probe --mode loop`.
+
+| Step | Command (both hosts) | Measured 2026-10-01 (Gen3, `--noverify`) |
+| --- | --- | --- |
+| Exchange latency (decode shape) | `tbstream_probe --mode exchange --bytes 10240 --frames 2000 --noverify` | **p50 22–23 µs, p99 34–42 µs** (RDMA baseline: 24 µs) |
+| One-way bandwidth (prefill shape) | `tbstream_probe --mode bw --bytes 1048576,5242880,33554432 --frames 200 --noverify` | 1.01–1.03 / 1.04–1.05 / 1.13–1.14 GB/s |
+
+`--noverify` skips the probe's payload checksums: the byte-at-a-time FNV
+pass costs ~21 µs per 10 KiB exchange and ~0.5 GB/s of receiver
+throughput, which masked the real figures in the first measurement round
+(the checksummed runs reproduce the slower numbers and still cover
+integrity). The transport itself checksums nothing — the GPU adds the
+partial sums directly, as the verbs transport does — so the `--noverify`
+figures are the ones the serving path sees.
+| Large-frame lock-step | `tbstream_probe --mode exchange --bytes 33554432 --frames 20` | deadlocks by design (rings < frame) — proves the transport's always-draining reader is required |
+| Boundary robustness | `tbstream_probe --mode smoke --bytes 10240 --frames 1000` | ok |
+
+Tuning: the stream's configfs attributes trade latency for bulk bandwidth —
+`throttling` 8192 (default) gives 43.6 µs exchanges and 0.50 GB/s at 5 MiB;
+`throttling 65536` gives ~110 µs and 0.77 GB/s. Serving keeps the default.
+
+Record the numbers in `docs/models/qwen3.8-flash-next/EXPERIMENTS.md`
+(TP2-tbstream section) with the kernel version and the negotiated link
+speed (`cat /sys/bus/thunderbolt/devices/<peer>/rx_speed rx_lanes`).
+
+## Driver behavior on Linux 7.2 (AMD Strix Halo pair)
+
+Learned the hard way on 7.2.6; all are reflected in the transport and the
+probe:
+
+- **Stream names are at most eight characters.** A longer name fails the
+  configfs `mkdir` with `ENAMETOOLONG`.
+- **Only blocking reads are reliable.** A frame that arrives while no
+  reader is parked in `read(2)` stays invisible to `poll(2)` and to
+  nonblocking reads. The transport reads on a second, blocking descriptor;
+  an empty ring reads as zero bytes (retry, do not treat as EOF).
+- **Data written before the peer opened the device is stranded.** The
+  probe's post-open barrier and the transport's bootstrap readiness
+  exchange both prevent it.
+- **Never kill a process blocked on the device.** An external kill wedges
+  the stream (next open fails EIO, teardown hangs) and a wedged link flaps
+  every ~55 s until the streams are removed. Exiting through the probe's
+  own 30 s deadline is clean. Recovery ladder: remove the stream on both
+  hosts (`setup-stream.sh down`), then PCI-rebind the controller
+  (`echo <pci> > /sys/bus/pci/drivers/thunderbolt/{un,}bind`), then reboot.
+- **The peer's route string can be any domain** (`0-2`, `1-2`, ...) and
+  changes across rebinds and reboots; `setup-stream.sh` discovers it.
+- Echo-mode (`--mode ping`) at 10 KiB still stalls; exchange and smoke —
+  the transport's shapes — are unaffected.
+
+## Dual-link striping (two cables)
+
+Two cables between the same hosts give two independent USB4 links, and the
+probe stripes frames round-robin over them: pass a comma-separated `--fd`
+list (one stream per link; `--stripe N` is an optional assertion that must
+match the count). This answers whether the single-stream ceiling is the
+link or the host: aggregate ≈ 2× means link-bound, ≈ 1× means the copies,
+rings or interrupts on the host side are the limit.
+
+Bring-up with two cables (run `check` first; it lists every peer router
+with its negotiated speed — one peer per cable):
+
+```sh
+# On each host, one stream per peer router, distinct names (<= 8 chars):
+sudo tools/tbstream/setup-stream.sh up linkA 0-2   # router names from check
+sudo tools/tbstream/setup-stream.sh up linkB 1-3
+
+# Then on both hosts (rank 1 with --peer pointing at rank 0):
+tbstream_probe --mode bw --fd /dev/tbstream0,/dev/tbstream1 \
+               --bytes 5242880 --frames 400
+```
+
+Each link reports its own throughput at the end. What to expect:
+
+- **Decode does not benefit**: the 10 KiB exchange is latency-bound and
+  one link is enough for it; striping a small frame would only add
+  skew-wait.
+- **Prefill-shaped bandwidth can scale ~2×** if the links are the
+  bottleneck (0.5–0.77 GB/s → ~1.0–1.5 GB/s). The 120 Gb/s marketing sum
+  of an 80G plus a 40G port is not reachable: discrete TB5 controllers
+  (e.g. the MS-S1 Max's Barlow Ridge) sit behind PCIe Gen4 x4 (~64 Gb/s
+  per direction shared), cross-vendor Gen4 host-to-host training is
+  unproven, and Gen3-max retimers in uncertified cables cap below that.
+  Certified TB5/USB4v2 cables are required for the 80G ports to matter.
+
+If the dual-link probe scales and prefill bandwidth matters for serving,
+the next step is striping inside the transport itself (one stream per
+link, frames striped by operation id, one reader thread per link).
+
+## Serving over tbstream
+
+Build with `-DGUFO_ENABLE_TP2_TBSTREAM=ON` (Nix: `nix build .#tp2-tbstream`)
+and pass `--tp-transport tbstream` to both ranks. The stream must exist
+(`setup-stream.sh up`) before the ranks start; the ranks pair over the TCP
+bootstrap as with RDMA.
diff --git a/tools/tbstream/setup-stream.sh b/tools/tbstream/setup-stream.sh
new file mode 100755
index 0000000..31e3274
--- /dev/null
+++ b/tools/tbstream/setup-stream.sh
@@ -0,0 +1,219 @@
+#!/usr/bin/env bash
+# USB4STREAM (thunderbolt_stream) setup for the gufo TP=2 tbstream
+# transport. Runs on ONE host of a directly connected pair; run it on both.
+#
+#   setup-stream.sh check                    report kernel, link and stream state
+#   setup-stream.sh up [NAME [ROUTER]]       create a stream (default: gufo on
+#                                            the first peer router)
+#   setup-stream.sh down [NAME [ROUTER]]     remove the stream
+#
+# ROUTER names the peer router sysfs entry the stream runs over (e.g. 0-2),
+# as listed by `check`. Give it when more than one peer is connected (one
+# cable per link): run `up` once per router with distinct names, e.g.
+#   setup-stream.sh up linkA 0-2
+#   setup-stream.sh up linkB 1-3
+#
+# Environment overrides:
+#   TB_STREAM_CONFIGFS   configfs mount point (default /sys/kernel/config)
+#   TB_STREAM_PATH       full stream directory path, e.g. .../stream/0-1.0
+#                        (default: discovered from the peer router, index 0)
+#   TB_STREAM_INDEX      stream index appended to the peer route (default 0)
+#
+# Kernel 7.2 or newer is required; the configfs directory
+# <configfs>/thunderbolt/stream exists only when the driver supports it.
+set -euo pipefail
+
+STREAM_CONFIGFS="${TB_STREAM_CONFIGFS:-/sys/kernel/config}"
+STREAM_NAME="gufo"
+STREAM_ROUTER=""
+COMMAND="${1:-check}"
+case "$COMMAND" in
+  check|up|down) ;;
+  *) echo "usage: $0 check|up|down [NAME [ROUTER]]" >&2; exit 2 ;;
+esac
+if [ "$#" -ge 2 ]; then STREAM_NAME="$2"; fi
+if [ "$#" -ge 3 ]; then STREAM_ROUTER="$3"; fi
+# The driver rejects stream names longer than eight characters (EINVAL
+# surfaces as ENAMETOOLONG from mkdir on configfs).
+if [ "${#STREAM_NAME}" -gt 8 ]; then
+  echo "setup-stream.sh: stream name '$STREAM_NAME' is longer than 8 characters" >&2
+  exit 2
+fi
+
+fail() { echo "setup-stream.sh: $*" >&2; exit 1; }
+note() { echo "setup-stream.sh: $*"; }
+
+if [ -n "$STREAM_ROUTER" ] && ! ls "/sys/bus/thunderbolt/devices/$STREAM_ROUTER" >/dev/null 2>&1; then
+  fail "router $STREAM_ROUTER does not exist under /sys/bus/thunderbolt/devices"
+fi
+
+kernel_ok() {
+  local major minor
+  major="$(uname -r | cut -d. -f1)"
+  minor="$(uname -r | cut -d. -f2 | cut -d- -f1)"
+  if [ "$major" -gt 7 ] || { [ "$major" -eq 7 ] && [ "$minor" -ge 2 ]; }; then
+    return 0
+  fi
+  return 1
+}
+
+peer_route() {
+  # The peer host router: a thunderbolt device "D-R" in any domain D whose
+  # route R is not 0 (the host router itself), and not a USB function
+  # ("D-R:F.L"). Direct connections have exactly one; report the first and
+  # warn if there are more.
+  local found="" device
+  for device in /sys/bus/thunderbolt/devices/*; do
+    device="${device##*/}"
+    case "$device" in
+      domain*|*:*|*.*) continue ;;
+      [0-9]*-[0-9]*)
+        case "$device" in
+          *-0) continue ;;
+        esac
+        if [ -z "$found" ]; then
+          found="$device"
+        else
+          note "warning: several peer routers ($found, $device); pick with TB_STREAM_PATH"
+        fi ;;
+    esac
+  done
+  [ -n "$found" ] || return 1
+  echo "$found"
+}
+
+stream_dir() {
+  if [ -n "${TB_STREAM_PATH:-}" ]; then
+    echo "$TB_STREAM_PATH"
+    return
+  fi
+  local route index="${TB_STREAM_INDEX:-0}"
+  if [ -n "$STREAM_ROUTER" ]; then
+    route="$STREAM_ROUTER"
+  else
+    route="$(peer_route)" || fail "no peer router under /sys/bus/thunderbolt/devices; is the cable connected and authorized?"
+  fi
+  echo "$STREAM_CONFIGFS/thunderbolt/stream/${route}.${index}"
+}
+
+check_kernel() {
+  if kernel_ok; then
+    note "kernel $(uname -r) is 7.2 or newer: ok"
+  else
+    note "kernel $(uname -r) is older than 7.2: thunderbolt_stream (USB4STREAM) is missing"
+    return 1
+  fi
+}
+
+check_configfs() {
+  if ! mountpoint -q "$STREAM_CONFIGFS" 2>/dev/null &&
+     ! grep -qs " $STREAM_CONFIGFS " /proc/mounts; then
+    note "configfs is not mounted at $STREAM_CONFIGFS: mount -t configfs none $STREAM_CONFIGFS"
+    return 1
+  fi
+  if [ ! -d "$STREAM_CONFIGFS/thunderbolt/stream" ]; then
+    note "no $STREAM_CONFIGFS/thunderbolt/stream: the kernel lacks thunderbolt_stream support"
+    return 1
+  fi
+  note "configfs stream interface: ok"
+}
+
+check_devices() {
+  local device
+  for device in /sys/bus/thunderbolt/devices/*; do
+    device="${device##*/}"
+    case "$device" in
+      *:*|*.*) continue ;;
+      [0-9]*-[0-9]*)
+        local name=""
+        [ -f "/sys/bus/thunderbolt/devices/$device/device_name" ] &&
+          name="$(cat "/sys/bus/thunderbolt/devices/$device/device_name")"
+        local label="peer router"
+        case "$device" in
+          *-0) label="host router" ;;
+        esac
+        if [ ! -f "/sys/bus/thunderbolt/devices/$device/authorized" ]; then
+          # Host-to-host peer routers on an unsecured link expose no
+          # authorization attribute: nothing to authorize.
+          local speed=""
+          [ -f "/sys/bus/thunderbolt/devices/$device/rx_speed" ] &&
+            speed=" at $(cat /sys/bus/thunderbolt/devices/$device/rx_speed) x$(cat /sys/bus/thunderbolt/devices/$device/rx_lanes)"
+          note "$label $device has no authorization gate$speed (device_name: ${name:-unknown})"
+        elif [ "$(cat "/sys/bus/thunderbolt/devices/$device/authorized")" = "1" ]; then
+          local speed=""
+          [ -f "/sys/bus/thunderbolt/devices/$device/rx_speed" ] &&
+            speed=" at $(cat /sys/bus/thunderbolt/devices/$device/rx_speed) x$(cat /sys/bus/thunderbolt/devices/$device/rx_lanes)"
+          note "$label $device authorized$speed (device_name: ${name:-unknown})"
+        else
+          note "router $device is NOT authorized: boltctl authorize <uuid>, or set security to none in the BIOS"
+          return 1
+        fi ;;
+    esac
+  done
+  [ -d /sys/bus/thunderbolt/devices/0-0 ] ||
+    fail "no thunderbolt host router: the USB4 controller is not bound to the thunderbolt driver"
+}
+
+check_net() {
+  local tb
+  for tb in /sys/class/net/tb*; do
+    [ -e "$tb" ] || continue
+    note "thunderbolt netdev ${tb##*/} present (control channel can ride the cable)"
+    return 0
+  done
+  note "no tb* netdev: the authenticated TCP control channel needs another network, or load thunderbolt-net"
+}
+
+do_check() {
+  local status=0
+  check_kernel || status=1
+  if [ "$status" -eq 0 ]; then
+    check_configfs || status=1
+    check_devices || status=1
+    check_net || true
+    if ls /dev/tbstream* >/dev/null 2>&1; then
+      note "stream devices present: $(ls /dev/tbstream*)"
+    else
+      note "no /dev/tbstream* yet: run '$0 up' on both hosts"
+    fi
+  fi
+  return "$status"
+}
+
+do_up() {
+  check_kernel || fail "install a 7.2+ kernel first"
+  check_configfs || fail "configfs stream interface missing"
+  check_devices || fail "peer router not ready"
+  local dir
+  dir="$(stream_dir)"
+  local stream="$dir/$STREAM_NAME"
+  note "creating stream $STREAM_NAME under $dir"
+  mkdir -p "$stream"
+  # Automatic HopID allocation on both directions: the stream is
+  # bidirectional, and each rank both sends and receives.
+  echo -1 > "$stream/in_hopid"
+  echo -1 > "$stream/out_hopid"
+  sleep 1
+  if ls /dev/tbstream* >/dev/null 2>&1; then
+    note "ok: $(ls /dev/tbstream*)"
+    note "run the same command on the peer host, then tbstream_probe --mode exchange"
+  else
+    fail "stream directory created but no /dev/tbstream* appeared; create the stream on the peer too (the pair negotiates HopIDs over XDomain properties)"
+  fi
+}
+
+do_down() {
+  local dir
+  dir="$(stream_dir)"
+  local stream="$dir/$STREAM_NAME"
+  [ -d "$stream" ] || fail "no stream $STREAM_NAME under $dir"
+  rmdir "$stream"
+  rmdir "$dir" 2>/dev/null || true
+  note "removed $stream"
+}
+
+case "$COMMAND" in
+  check) do_check ;;
+  up) do_up ;;
+  down) do_down ;;
+esac
diff --git a/tools/tbstream/tbstream_probe.cpp b/tools/tbstream/tbstream_probe.cpp
new file mode 100644
index 0000000..9cdda4d
--- /dev/null
+++ b/tools/tbstream/tbstream_probe.cpp
@@ -0,0 +1,1265 @@
+// USB4STREAM (/dev/tbstreamX) microbenchmark for the TP=2 tbstream
+// transport. Host-only: no HIP, no model. Modes:
+//
+//   loop     one process, a socketpair standing in for the cable; validates
+//            the framing, sizes and integrity end to end. Runs anywhere.
+//   ping     rank 0 writes a frame, rank 1 echoes it; rank 0 reports the
+//            round-trip latency distribution.
+//   bw       rank 0 streams frames one way; both ranks report GB/s.
+//   exchange both ranks write their frame and read the peer's, through three
+//            rotating windows: the shape and timing of one all-reduce step.
+//            A frame larger than the device's rings hangs here, which is the
+//            finding this mode exists to produce.
+//   smoke    alternating odd frame sizes with integrity checks; the stream
+//            must be a byte stream regardless of write boundaries.
+//
+// Rank 1 reaches rank 0's coordination port (--peer HOST, default same
+// host), the ranks exchange their parameters, then all traffic runs on the
+// stream device (--fd, default /dev/tbstream0). See README.md in this
+// directory for the qualification procedure.
+
+#include <arpa/inet.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cerrno>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace {
+
+// Set by --noverify: skip the payload checksums so the measurement shows
+// the link and driver alone, without the probe's own checksum CPU cost.
+bool g_skip_checksums = false;
+// --exit-open: leave every stream fd open and let process exit release
+// them (gufo's detached-reader path) instead of explicit close_all().
+bool g_exit_open = false;
+// --batch-bytes N: accumulate outgoing frames and flush in write()s of
+// at least N bytes (0 = one write per frame). The byte stream is
+// order-preserving, so batching is transparent to the peer's parser.
+std::size_t g_batch_bytes = 0;
+// --reader-glutton: the receiving side drains with maximum-size read()s
+// (byte counting) instead of per-frame reads — isolates receiver read
+// granularity as a wedge variable.
+bool g_reader_glutton = false;
+// --reader-buffered: parse frames from 1 MiB read-ahead buffering
+// instead of exact per-frame reads (keeps frame semantics, gets the
+// bulk read shape).
+bool g_reader_buffered = false;
+
+constexpr std::uint32_t kHelloMagic = 0x47504248U;  // "GPBH"
+constexpr std::uint32_t kHelloVersion = 1;
+constexpr std::uint32_t kFrameMagic = 0x47504246U;  // "GPBF"
+constexpr std::uint64_t kDataOffset = 64;
+// Largest header+payload frame written through the single-write path;
+// larger frames fall back to separate header/payload writes.
+constexpr std::size_t kStackFrameBytes = 1U << 20;
+constexpr auto kTimeout = std::chrono::seconds(30);
+
+struct Hello {
+  std::uint32_t magic{kHelloMagic};
+  std::uint32_t version{kHelloVersion};
+  std::uint32_t rank{0};
+  std::uint32_t sizes_checksum{0};
+  std::uint32_t frames{0};
+  std::uint32_t links{1};
+};
+
+struct FrameHeader {
+  std::uint32_t magic{kFrameMagic};
+  std::uint32_t version{1};
+  std::uint32_t checksum{0};
+  std::uint32_t reserved{0};
+  std::uint64_t sequence{0};
+  std::uint64_t bytes{0};
+};
+
+static_assert(sizeof(FrameHeader) <= kDataOffset);
+
+int Fail(const std::string& message) {
+  std::fprintf(stderr, "tbstream_probe: %s\n", message.c_str());
+  return 1;
+}
+
+std::string ErrnoText(const char* what) {
+  return std::string(what) + ": " + std::strerror(errno);
+}
+
+std::uint32_t Checksum(const std::uint8_t* data, std::size_t bytes,
+                       std::uint32_t seed) {
+  std::uint32_t hash = seed;
+  for (std::size_t i = 0; i < bytes; ++i) {
+    hash = (hash ^ data[i]) * 16777619U;
+  }
+  return hash;
+}
+
+void FillPayload(std::uint8_t* data, std::size_t bytes, std::uint64_t seed) {
+  std::uint32_t state = static_cast<std::uint32_t>(seed) | 1U;
+  for (std::size_t i = 0; i < bytes; ++i) {
+    state = state * 1103515245U + 12345U;
+    data[i] = static_cast<std::uint8_t>(state >> 16);
+  }
+}
+
+std::vector<std::size_t> ParseSizes(const std::string& text) {
+  std::vector<std::size_t> sizes;
+  std::size_t start = 0;
+  while (start <= text.size()) {
+    const std::size_t comma = text.find(',', start);
+    const std::string part = text.substr(
+        start, comma == std::string::npos ? std::string::npos : comma - start);
+    if (!part.empty()) {
+      sizes.push_back(
+          static_cast<std::size_t>(std::strtoull(part.c_str(), nullptr, 10)));
+    }
+    if (comma == std::string::npos) {
+      break;
+    }
+    start = comma + 1;
+  }
+  if (sizes.empty()) {
+    sizes.push_back(10240);
+  }
+  return sizes;
+}
+
+std::vector<std::string> ParseDevices(const std::string& text) {
+  std::vector<std::string> devices;
+  std::size_t start = 0;
+  while (start <= text.size()) {
+    const std::size_t comma = text.find(',', start);
+    std::string part = text.substr(
+        start, comma == std::string::npos ? std::string::npos : comma - start);
+    while (!part.empty() && part.back() == ' ') {
+      part.pop_back();
+    }
+    if (!part.empty()) {
+      devices.push_back(part);
+    }
+    if (comma == std::string::npos) {
+      break;
+    }
+    start = comma + 1;
+  }
+  if (devices.empty()) {
+    devices.push_back("/dev/tbstream0");
+  }
+  return devices;
+}
+
+std::uint32_t SizesChecksum(const std::vector<std::size_t>& sizes) {
+  std::uint32_t sum = 0;
+  for (const std::size_t size : sizes) {
+    sum = sum * 31U + static_cast<std::uint32_t>(size);
+  }
+  return sum;
+}
+
+/// A framed exchange over one ordered byte stream: a 64-byte header followed
+/// by the payload. Writes poll under a deadline on the nonblocking
+/// descriptor; reads use a second, blocking descriptor, because the device
+/// reports arriving frames through the blocking read path only (its poll
+/// mask and nonblocking reads stay quiet for frames that arrive while no
+/// reader is parked in read(2)).
+class Stream {
+public:
+  Stream(int write_fd, int read_fd) : fd_(write_fd), read_fd_(read_fd) {}
+
+  [[nodiscard]] std::uint64_t written() const noexcept { return written_; }
+  [[nodiscard]] std::uint64_t read() const noexcept { return read_; }
+  [[nodiscard]] int GluttonFd() const noexcept { return read_fd_; }
+
+  [[nodiscard]] bool WriteFrame(std::uint64_t sequence, const void* payload,
+                                std::size_t bytes, std::string* error) {
+    const std::uint32_t checksum =
+        g_skip_checksums
+            ? 0U
+            : Checksum(static_cast<const std::uint8_t*>(payload), bytes,
+                       static_cast<std::uint32_t>(sequence));
+    const FrameHeader header{
+        .checksum = checksum,
+        .sequence = sequence,
+        .bytes = bytes,
+    };
+    std::uint8_t frame[kDataOffset];
+    std::memcpy(frame, &header, sizeof(header));
+    if (g_batch_bytes > 0) {
+      // Batched mode: accumulate frames and flush in large write()s —
+      // the byte stream is order-preserving, so concatenation is
+      // transparent to the peer's frame parser.
+      const std::uint8_t* parts[2] = {frame, nullptr};
+      const std::size_t lens[2] = {sizeof(frame), bytes};
+      if (bytes != 0) {
+        parts[1] = static_cast<const std::uint8_t*>(payload);
+      }
+      for (int k = 0; k < 2; ++k) {
+        stage_.insert(stage_.end(), parts[k], parts[k] + lens[k]);
+      }
+      written_ += kDataOffset + bytes;
+      if (stage_.size() >= g_batch_bytes) {
+        return FlushStaged(error);
+      }
+      return true;
+    }
+    // Direct mode: header and payload go out in ONE write(), matching
+    // gufo's contiguous frame write (the driver chunks each write()
+    // into 4 KiB frames, so write granularity defines the remainder
+    // frames the wire actually sees).
+    if (bytes + kDataOffset <= kStackFrameBytes) {
+      std::uint8_t combined[kStackFrameBytes];
+      std::memcpy(combined, frame, sizeof(frame));
+      if (bytes != 0) {
+        std::memcpy(combined + sizeof(frame), payload, bytes);
+      }
+      if (!SendAll(combined, kDataOffset + bytes, error)) {
+        return false;
+      }
+    } else {
+      if (!SendAll(frame, sizeof(frame), error) ||
+          (bytes != 0 && !SendAll(payload, bytes, error))) {
+        return false;
+      }
+    }
+    written_ += kDataOffset + bytes;
+    return true;
+  }
+
+  [[nodiscard]] bool FlushStaged(std::string* error) {
+    if (stage_.empty()) {
+      return true;
+    }
+    if (!SendAll(stage_.data(), stage_.size(), error)) {
+      return false;
+    }
+    stage_.clear();
+    return true;
+  }
+
+  /// Buffered read-ahead parser: pulls up to 1 MiB per read() and parses
+  /// whole frames from the buffer — the receiver-side bulk shape the
+  /// wedge ablation found clean (reads of ring depth, 256 x 4 KiB).
+  [[nodiscard]] bool ReadFrameBuffered(std::uint64_t expected_sequence,
+                                        void* payload, std::size_t capacity,
+                                        std::size_t* bytes,
+                                        std::string* error) {
+    while (refill_.size() < kDataOffset ||
+           refill_.size() - parsed_ < kDataOffset) {
+      if (!RefillMore(error)) {
+        return false;
+      }
+    }
+    while (refill_.size() - parsed_ < kDataOffset + PeekPayloadSize()) {
+      if (!RefillMore(error)) {
+        return false;
+      }
+    }
+    FrameHeader header{};
+    std::memcpy(&header, refill_.data() + parsed_, sizeof(header));
+    if (header.magic != kFrameMagic || header.version != 1 ||
+        header.sequence != expected_sequence || header.bytes > capacity) {
+      *error = "frame header mismatch: sequence " +
+               std::to_string(header.sequence) + " of " +
+               std::to_string(header.bytes) + " bytes";
+      return false;
+    }
+    while (refill_.size() - parsed_ < kDataOffset + header.bytes) {
+      if (!RefillMore(error)) {
+        return false;
+      }
+    }
+    if (header.bytes != 0) {
+      std::memcpy(payload, refill_.data() + parsed_ + kDataOffset,
+                  header.bytes);
+    }
+    parsed_ += kDataOffset + header.bytes;
+    if (parsed_ == refill_.size()) {
+      refill_.clear();
+      parsed_ = 0;
+    }
+    const std::uint32_t checksum =
+        g_skip_checksums
+            ? header.checksum
+            : Checksum(static_cast<const std::uint8_t*>(payload),
+                       header.bytes,
+                       static_cast<std::uint32_t>(expected_sequence));
+    if (checksum != header.checksum) {
+      *error = "frame checksum mismatch at sequence " +
+               std::to_string(expected_sequence);
+      return false;
+    }
+    *bytes = header.bytes;
+    read_ += kDataOffset + header.bytes;
+    return true;
+  }
+
+  [[nodiscard]] std::size_t PeekPayloadSize() {
+    if (refill_.size() - parsed_ < kDataOffset) {
+      return 0;
+    }
+    FrameHeader header{};
+    std::memcpy(&header, refill_.data() + parsed_, sizeof(header));
+    return header.bytes;
+  }
+
+  [[nodiscard]] bool RefillMore(std::string* error) {
+    std::uint8_t chunk[1U << 20];
+    const ssize_t n = ::read(read_fd_, chunk, sizeof(chunk));
+    if (n > 0) {
+      refill_.insert(refill_.end(), chunk, chunk + n);
+      refill_waited_ = std::chrono::steady_clock::now();
+      return true;
+    }
+    if (n < 0 && errno == EINTR) {
+      return true;
+    }
+    if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) {
+      // Nonblocking source (loop mode) or transient empty ring.
+      ::usleep(100);
+      if (std::chrono::steady_clock::now() - refill_waited_ >
+          std::chrono::seconds(30)) {
+        *error = "buffered read timed out waiting for peer data";
+        return false;
+      }
+      return true;
+    }
+    if (n == 0) {
+      ::usleep(100);
+      if (std::chrono::steady_clock::now() - refill_waited_ >
+          std::chrono::seconds(30)) {
+        *error = "buffered read timed out waiting for peer data";
+        return false;
+      }
+      return true;
+    }
+    *error = ErrnoText("buffered read");
+    return false;
+  }
+
+  [[nodiscard]] bool ReadFrame(std::uint64_t expected_sequence, void* payload,
+                               std::size_t capacity, std::size_t* bytes,
+                               std::string* error) {
+    if (g_reader_buffered) {
+      return ReadFrameBuffered(expected_sequence, payload, capacity, bytes,
+                               error);
+    }
+    std::uint8_t head[kDataOffset];
+    if (!RecvAll(head, sizeof(head), error)) {
+      return false;
+    }
+    FrameHeader header{};
+    std::memcpy(&header, head, sizeof(header));
+    if (header.magic != kFrameMagic || header.version != 1 ||
+        header.sequence != expected_sequence || header.bytes > capacity) {
+      *error = "frame header mismatch: sequence " +
+               std::to_string(header.sequence) + " of " +
+               std::to_string(header.bytes) + " bytes";
+      return false;
+    }
+    if (header.bytes != 0 && !RecvAll(payload, header.bytes, error)) {
+      return false;
+    }
+    const std::uint32_t checksum =
+        g_skip_checksums
+            ? header.checksum
+            : Checksum(static_cast<const std::uint8_t*>(payload),
+                       header.bytes,
+                       static_cast<std::uint32_t>(expected_sequence));
+    if (checksum != header.checksum) {
+      *error = "frame checksum mismatch at sequence " +
+               std::to_string(expected_sequence);
+      return false;
+    }
+    *bytes = header.bytes;
+    read_ += kDataOffset + header.bytes;
+    return true;
+  }
+
+private:
+  [[nodiscard]] bool SendAll(const void* data, std::size_t bytes,
+                             std::string* error) {
+    const auto* cursor = static_cast<const std::uint8_t*>(data);
+    std::size_t sent = 0;
+    const auto deadline = std::chrono::steady_clock::now() + kTimeout;
+    // Spin before sleeping in poll(2): a full ring eases within microseconds
+    // once the peer drains it, and the poll wakeup pays the interrupt
+    // pacing. Mirrors the transport's write path.
+    const auto spin_deadline = std::chrono::steady_clock::now() +
+                                std::chrono::milliseconds(5);
+    while (sent < bytes) {
+      const ssize_t n = ::write(fd_, cursor + sent, bytes - sent);
+      if (n > 0) {
+        sent += static_cast<std::size_t>(n);
+        continue;
+      }
+      if (n < 0 && errno == EINTR) {
+        continue;
+      }
+      if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) {
+        if (std::chrono::steady_clock::now() < spin_deadline) {
+#if defined(__x86_64__) || defined(__i386__)
+          __builtin_ia32_pause();
+#endif
+          continue;
+        }
+        pollfd p{.fd = fd_, .events = POLLOUT, .revents = 0};
+        const int result = ::poll(&p, 1, 1000);
+        if (result < 0 && errno != EINTR) {
+          *error = ErrnoText("write poll");
+          return false;
+        }
+        if (std::chrono::steady_clock::now() >= deadline) {
+          *error = "write timed out (peer not draining, or rings full)";
+          return false;
+        }
+        continue;
+      }
+      *error = ErrnoText("write");
+      return false;
+    }
+    return true;
+  }
+
+  [[nodiscard]] bool RecvAll(void* data, std::size_t bytes,
+                             std::string* error) {
+    auto* cursor = static_cast<std::uint8_t*>(data);
+    std::size_t received = 0;
+    const auto start = std::chrono::steady_clock::now();
+    while (received < bytes) {
+      const ssize_t n =
+          ::read(read_fd_, cursor + received, bytes - received);
+      if (n > 0) {
+        received += static_cast<std::size_t>(n);
+        continue;
+      }
+      if (n < 0 && errno == EINTR) {
+        continue;
+      }
+      if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) {
+        continue;
+      }
+      if (n == 0) {
+        // The device reports an empty ring as a zero-byte read; the frame
+        // may still be in flight. Spin briefly so an imminent arrival pays
+        // no sleep granularity, then pause and read again. A peer that
+        // exited (driver CLOSE) also yields zero-byte reads — fail after
+        // a bounded wait instead of spinning forever on a truncated
+        // stream.
+        const auto spin_deadline = start + std::chrono::milliseconds(5);
+        if (std::chrono::steady_clock::now() < spin_deadline) {
+#if defined(__x86_64__) || defined(__i386__)
+          __builtin_ia32_pause();
+#endif
+        } else if (std::chrono::steady_clock::now() <
+                   start + std::chrono::seconds(30)) {
+          ::usleep(100);
+        } else {
+          *error = "read timed out waiting for peer data (peer exited "
+                   "early, or truncated stream)";
+          return false;
+        }
+        continue;
+      }
+      *error = ErrnoText("read");
+      return false;
+    }
+    return true;
+  }
+
+  int fd_;
+  int read_fd_;
+  std::uint64_t written_{0};
+  std::uint64_t read_{0};
+  std::vector<std::uint8_t> stage_;
+  std::vector<std::uint8_t> refill_;
+  std::size_t parsed_{0};
+  std::chrono::steady_clock::time_point refill_waited_{
+      std::chrono::steady_clock::now()};
+};
+
+/// The TCP coordination channel: ranks exchange their parameters and a go
+/// signal before touching the stream device. It closes after that.
+class Pairing {
+public:
+  Pairing() = default;
+  explicit Pairing(int fd) : fd_(fd) {}
+  Pairing(const Pairing&) = delete;
+  Pairing& operator=(const Pairing&) = delete;
+  Pairing(Pairing&& other) noexcept : fd_(other.fd_) { other.fd_ = -1; }
+  Pairing& operator=(Pairing&& other) noexcept {
+    if (this != &other) {
+      Close();
+      fd_ = other.fd_;
+      other.fd_ = -1;
+    }
+    return *this;
+  }
+  ~Pairing() { Close(); }
+
+  [[nodiscard]] int fd() const noexcept { return fd_; }
+
+  void Close() noexcept {
+    if (fd_ >= 0) {
+      ::close(fd_);
+      fd_ = -1;
+    }
+  }
+
+  [[nodiscard]] static Pairing Listen(std::uint16_t port, std::string* error) {
+    int fd = ::socket(AF_INET, SOCK_STREAM, 0);
+    if (fd < 0) {
+      *error = ErrnoText("coordination socket");
+      return Pairing();
+    }
+    int reuse = 1;
+    (void)::setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &reuse, sizeof(reuse));
+    sockaddr_in address{};
+    address.sin_family = AF_INET;
+    address.sin_addr.s_addr = htonl(INADDR_ANY);
+    address.sin_port = htons(port);
+    if (::bind(fd, reinterpret_cast<sockaddr*>(&address), sizeof(address)) !=
+            0 ||
+        ::listen(fd, 1) != 0) {
+      *error = ErrnoText("coordination listen");
+      ::close(fd);
+      return Pairing();
+    }
+    int peer = ::accept(fd, nullptr, nullptr);
+    ::close(fd);
+    if (peer < 0) {
+      *error = ErrnoText("coordination accept");
+      return Pairing();
+    }
+    return Pairing(peer);
+  }
+
+  [[nodiscard]] static Pairing Connect(const std::string& host,
+                                       std::uint16_t port,
+                                       std::string* error) {
+    sockaddr_in address{};
+    address.sin_family = AF_INET;
+    address.sin_port = htons(port);
+    if (::inet_pton(AF_INET, host.c_str(), &address.sin_addr) != 1) {
+      *error = "coordination peer is not an IPv4 address: " + host;
+      return Pairing();
+    }
+    const auto deadline = std::chrono::steady_clock::now() + kTimeout;
+    for (;;) {
+      int fd = ::socket(AF_INET, SOCK_STREAM, 0);
+      if (fd >= 0 &&
+          ::connect(fd, reinterpret_cast<sockaddr*>(&address),
+                    sizeof(address)) == 0) {
+        return Pairing(fd);
+      }
+      if (fd >= 0) {
+        ::close(fd);
+      }
+      if (std::chrono::steady_clock::now() >= deadline) {
+        *error = "coordination connect timed out";
+        return Pairing();
+      }
+      std::this_thread::sleep_for(std::chrono::milliseconds(100));
+    }
+  }
+
+  [[nodiscard]] bool Exchange(const Hello& mine, Hello* peers,
+                              std::string* error) const {
+    if (!SendAll(&mine, sizeof(mine), error) ||
+        !RecvAll(peers, sizeof(*peers), error) ||
+        peers->magic != kHelloMagic || peers->version != kHelloVersion ||
+        peers->sizes_checksum != mine.sizes_checksum ||
+        peers->frames != mine.frames || peers->rank == mine.rank ||
+        peers->links != mine.links) {
+      if (error->empty()) {
+        *error = "coordination hello mismatch (same --bytes/--frames/--fd "
+                 "count and opposite --rank on both ends?)";
+      }
+      return false;
+    }
+    const std::uint32_t go = 1;
+    std::uint32_t ready = 0;
+    return SendAll(&go, sizeof(go), error) &&
+           RecvAll(&ready, sizeof(ready), error) && ready == go;
+  }
+
+  /// The second barrier, after both ranks opened the stream device: the
+  /// sender must not write before the peer's reader exists.
+  [[nodiscard]] bool Ready(std::string* error) const {
+    const std::uint32_t go = 2;
+    std::uint32_t peer_go = 0;
+    return SendAll(&go, sizeof(go), error) &&
+           RecvAll(&peer_go, sizeof(peer_go), error) && peer_go == go;
+  }
+
+private:
+  [[nodiscard]] bool SendAll(const void* data, std::size_t bytes,
+                             std::string* error) const {
+    const auto* cursor = static_cast<const std::uint8_t*>(data);
+    std::size_t sent = 0;
+    while (sent < bytes) {
+      const ssize_t n =
+          ::send(fd_, cursor + sent, bytes - sent, MSG_NOSIGNAL);
+      if (n <= 0) {
+        if (n < 0 && errno == EINTR) {
+          continue;
+        }
+        *error = ErrnoText("coordination send");
+        return false;
+      }
+      sent += static_cast<std::size_t>(n);
+    }
+    return true;
+  }
+
+  [[nodiscard]] bool RecvAll(void* data, std::size_t bytes,
+                             std::string* error) const {
+    auto* cursor = static_cast<std::uint8_t*>(data);
+    std::size_t received = 0;
+    while (received < bytes) {
+      const ssize_t n = ::recv(fd_, cursor + received, bytes - received, 0);
+      if (n <= 0) {
+        if (n < 0 && errno == EINTR) {
+          continue;
+        }
+        *error = ErrnoText("coordination receive");
+        return false;
+      }
+      received += static_cast<std::size_t>(n);
+    }
+    return true;
+  }
+
+  int fd_{-1};
+};
+
+void ReportMicros(const std::vector<double>& micros) {
+  if (micros.empty()) {
+    return;
+  }
+  std::vector<double> sorted = micros;
+  std::sort(sorted.begin(), sorted.end());
+  const auto pick = [&](double fraction) {
+    return sorted[std::min(
+        sorted.size() - 1,
+        static_cast<std::size_t>(fraction * static_cast<double>(
+                                                  sorted.size())))];
+  };
+  std::printf("  n=%zu p50=%.1f p90=%.1f p99=%.1f max=%.1f us\n",
+              sorted.size(), pick(0.50), pick(0.90), pick(0.99),
+              sorted.back());
+}
+
+void ReportBandwidth(std::uint64_t bytes,
+                     std::chrono::steady_clock::duration elapsed,
+                     const char* what) {
+  const double seconds =
+      std::chrono::duration_cast<std::chrono::duration<double>>(elapsed)
+          .count();
+  std::printf("  %s: %.2f GB/s (%.1f ms, %llu MiB)\n", what,
+              static_cast<double>(bytes) / (1024.0 * 1024.0 * 1024.0) /
+                  seconds,
+              seconds * 1000.0,
+              static_cast<unsigned long long>(bytes >> 20));
+}
+
+/// Three buffers, like the transport's exchange windows, so a frame never
+/// lands in a buffer the previous exchange may still be reading.
+class Windows {
+public:
+  explicit Windows(std::size_t window_bytes)
+      : buffer_(std::make_unique<std::uint8_t[]>(3 * window_bytes)),
+        window_bytes_(window_bytes) {}
+
+  [[nodiscard]] std::uint8_t* At(std::uint64_t sequence) const {
+    return buffer_.get() + (sequence % 3) * window_bytes_;
+  }
+
+private:
+  std::unique_ptr<std::uint8_t[]> buffer_;
+  std::size_t window_bytes_;
+};
+
+int RunLoop(const std::vector<std::size_t>& sizes, std::uint32_t frames,
+            std::size_t links) {
+  std::vector<std::array<int, 2>> fds(links);
+  for (auto& pair : fds) {
+    if (::socketpair(AF_UNIX, SOCK_STREAM | SOCK_NONBLOCK | SOCK_CLOEXEC, 0,
+                     pair.data()) != 0) {
+      return Fail(ErrnoText("socketpair"));
+    }
+  }
+  std::printf("loop: %zu socketpair(s) standing in for the stream device(s)\n",
+              links);
+  // One responder per link, each serving the frames striped to its link.
+  std::vector<std::thread> responders;
+  for (std::size_t k = 0; k < links; ++k) {
+    responders.emplace_back([k, links, &fds, sizes, frames] {
+      Stream stream(fds[k][1], fds[k][1]);
+      std::string error;
+      for (std::size_t size : sizes) {
+        Windows windows(std::max<std::size_t>(size, 1));
+        for (std::uint32_t i = static_cast<std::uint32_t>(k); i < frames;
+             i += static_cast<std::uint32_t>(links)) {
+          std::size_t bytes = 0;
+          if (!stream.ReadFrame(i, windows.At(i), size, &bytes, &error) ||
+              !stream.WriteFrame(i, windows.At(i), bytes, &error)) {
+            Fail("loop responder: " + error);
+            ::shutdown(fds[k][1], SHUT_RDWR);
+            return;
+          }
+        }
+      }
+      ::close(fds[k][1]);
+    });
+  }
+  std::vector<Stream> streams;
+  for (std::size_t k = 0; k < links; ++k) {
+    streams.emplace_back(fds[k][0], fds[k][0]);
+  }
+  std::string error;
+  int status = 0;
+  for (std::size_t size : sizes) {
+    Windows windows(std::max<std::size_t>(size, 1));
+    const auto payload = std::make_unique<std::uint8_t[]>(size + 1);
+    FillPayload(payload.get(), size, 1);
+    std::vector<double> micros;
+    for (std::uint32_t i = 0; i < frames; ++i) {
+      Stream& stream = streams[i % links];
+      const auto start = std::chrono::steady_clock::now();
+      if (!stream.WriteFrame(i, payload.get(), size, &error)) {
+        status = Fail("loop requester write: " + error);
+        break;
+      }
+      std::size_t bytes = 0;
+      if (!stream.ReadFrame(i, windows.At(i), size, &bytes, &error)) {
+        status = Fail("loop requester read: " + error);
+        break;
+      }
+      const auto end = std::chrono::steady_clock::now();
+      micros.push_back(
+          std::chrono::duration_cast<std::chrono::duration<double>>(end -
+                                                                    start)
+              .count() *
+          1e6);
+    }
+    if (status != 0) {
+      break;
+    }
+    std::printf("loop %zu bytes:", size);
+    ReportMicros(micros);
+  }
+  if (status != 0) {
+    // Wake the responders out of any read so the joins are prompt.
+    for (auto& pair : fds) {
+      ::shutdown(pair[0], SHUT_RDWR);
+    }
+  }
+  for (std::thread& responder : responders) {
+    responder.join();
+  }
+  for (auto& pair : fds) {
+    ::close(pair[0]);
+  }
+  if (status == 0) {
+    std::printf("loop: ok\n");
+  }
+  return status;
+}
+
+int RunPair(const std::string& mode, std::uint32_t rank,
+            const std::string& peer, std::uint16_t port,
+            const std::vector<std::string>& devices,
+            const std::vector<std::size_t>& sizes, std::uint32_t frames,
+            int pairing_close, int idle_seconds) {
+  const std::size_t links = devices.size();
+  std::string error;
+  Pairing pairing = rank == 0 ? Pairing::Listen(port, &error)
+                              : Pairing::Connect(peer, port, &error);
+  if (pairing.fd() < 0) {
+    return Fail("pairing: " + error);
+  }
+  const Hello mine{.rank = rank,
+                   .sizes_checksum = SizesChecksum(sizes),
+                   .frames = frames,
+                   .links = static_cast<std::uint32_t>(links)};
+  Hello peers{};
+  if (!pairing.Exchange(mine, &peers, &error)) {
+    return Fail("pairing: " + error);
+  }
+  // Every link gets its own nonblocking write descriptor and blocking read
+  // descriptor, mirroring the single-stream transport per device.
+  std::vector<std::array<int, 2>> opened;
+  auto close_all = [&opened]() {
+    for (const auto& pair : opened) {
+      ::close(pair[0]);
+      ::close(pair[1]);
+    }
+  };
+  for (const std::string& device : devices) {
+    const int fd = ::open(device.c_str(), O_RDWR | O_NONBLOCK | O_CLOEXEC);
+    if (fd < 0) {
+      close_all();
+      return Fail("open " + device + ": " + std::strerror(errno) +
+                  " (is the USB4STREAM stream configured? see README.md)");
+    }
+    const int read_fd = ::open(device.c_str(), O_RDWR | O_CLOEXEC);
+    if (read_fd < 0) {
+      ::close(fd);
+      close_all();
+      return Fail("open " + device + " for reading: " +
+                  std::strerror(errno));
+    }
+    struct stat device_stat{};
+    if (::fstat(fd, &device_stat) != 0 || !S_ISCHR(device_stat.st_mode)) {
+      ::close(fd);
+      ::close(read_fd);
+      close_all();
+      return Fail(device + " is not a character device");
+    }
+    opened.push_back({fd, read_fd});
+  }
+  // A second barrier after both ranks opened every device: the driver
+  // strands data a rank writes before its peer opened, so no frame may move
+  // until every fd exists.
+  if (!pairing.Ready(&error)) {
+    close_all();
+    return Fail("pairing readiness: " + error);
+  }
+  // Pairing-socket lifecycle for the wedge ablation:
+  //   0 "early"    — close before traffic (stock probe behaviour)
+  //   1 "teardown" — hold through the session, close right before the
+  //                  stream fds (mirrors gufo's control_.reset() position)
+  //   2 "last"     — close after the stream fds (fix-candidate order)
+  if (pairing_close == 0) {
+    pairing.Close();
+  }
+  if (idle_seconds > 0) {
+    // Hold every stream fd idle-open before the traffic burst — mirrors
+    // gufo's timeline (device opened, ~36 s model load, then collectives).
+    std::printf("idle-open %d s before traffic\n", idle_seconds);
+    ::sleep(idle_seconds);
+  }
+  std::vector<Stream> streams;
+  for (const auto& pair : opened) {
+    streams.emplace_back(pair[0], pair[1]);
+  }
+  std::printf("%s rank %u over %zu link(s):", mode.c_str(), rank, links);
+  for (const std::string& device : devices) {
+    std::printf(" %s", device.c_str());
+  }
+  std::printf("\n");
+  const auto run_start = std::chrono::steady_clock::now();
+  if (mode == "fulldup") {
+    // Both ranks write continuously while a dedicated reader thread
+    // drains the peer's frames — gufo's always-draining-reader
+    // architecture with simultaneous bidirectional bulk. One pass over
+    // all sizes; the reader drains every size, the writer sweeps them.
+    // The reader context is heap-allocated so a detached reader
+    // (--exit-open) never touches destroyed locals; it is leaked
+    // deliberately, as the process exits immediately after.
+    struct ReaderCtx {
+      std::vector<int> write_fds;
+      std::vector<int> read_fds;
+      std::vector<std::size_t> sizes;
+      std::uint32_t frames;
+      bool starve_at_end;
+    };
+    ReaderCtx* ctx = new ReaderCtx{};
+    for (const auto& pair : opened) {
+      ctx->write_fds.push_back(pair[0]);
+      ctx->read_fds.push_back(pair[1]);
+    }
+    ctx->sizes = sizes;
+    ctx->frames = frames;
+    ctx->starve_at_end = g_exit_open;
+    auto* reader_ok = new std::atomic<int>{0};
+    auto* received = new std::atomic<std::uint64_t>{0};
+    auto* reader_error = new std::string{};
+    std::thread reader([ctx, reader_ok, received, reader_error]() {
+      const std::size_t links = ctx->read_fds.size();
+      std::vector<Stream> rstreams;
+      for (std::size_t k = 0; k < links; ++k) {
+        rstreams.emplace_back(ctx->write_fds[k], ctx->read_fds[k]);
+      }
+      for (std::size_t rsize : ctx->sizes) {
+        Windows rwindows(std::max<std::size_t>(rsize, 1));
+        for (std::uint32_t i = 0; i < ctx->frames; ++i) {
+          Stream& stream = rstreams[i % links];
+          std::size_t bytes = 0;
+          std::string error;
+          if (!stream.ReadFrame(i, rwindows.At(i), rsize, &bytes, &error)) {
+            *reader_error = "fulldup read: " + error;
+            reader_ok->store(1);
+            return;
+          }
+        }
+        received->fetch_add(static_cast<std::uint64_t>(rsize) * ctx->frames);
+      }
+      reader_ok->store(2);
+      if (ctx->starve_at_end) {
+        // Park in read(2) on a frame the peer never sends — gufo's
+        // end-of-life reader state; the descriptor is released at
+        // process exit with the reader still parked.
+        const std::size_t last = ctx->sizes.back();
+        std::vector<std::uint8_t> sink(last + 1);
+        std::size_t bytes = 0;
+        std::string error;
+        (void)rstreams[0].ReadFrame(ctx->frames, sink.data(), last, &bytes,
+                                    &error);
+      }
+    });
+    const auto start = std::chrono::steady_clock::now();
+    for (std::size_t size : sizes) {
+      const auto payload = std::make_unique<std::uint8_t[]>(size + 1);
+      FillPayload(payload.get(), size, 7);
+      for (std::uint32_t i = 0; i < frames; ++i) {
+        Stream& stream = streams[i % links];
+        if (!stream.WriteFrame(i, payload.get(), size, &error)) {
+          reader.detach();
+          return Fail("fulldup write: " + error);
+        }
+      }
+      std::printf("fulldup %zu bytes: written\n", size);
+    }
+    const auto end = std::chrono::steady_clock::now();
+    if (!g_exit_open) {
+      reader.join();
+      if (reader_ok->load() != 2) {
+        return Fail(reader_error->empty() ? "fulldup reader failed"
+                                          : *reader_error);
+      }
+      ReportBandwidth(
+          streams[0].written() + (links > 1 ? streams[1].written() : 0),
+          end - start, "sent");
+      ReportBandwidth(received->load(), end - start, "received");
+      delete ctx;
+      delete reader_ok;
+      delete received;
+      delete reader_error;
+    } else {
+      // gufo shape: the reader parks in read(2) after draining; leave
+      // every descriptor (and the reader context) to process exit.
+      reader.detach();
+      // Lockstep end: hold the pairing socket so both ranks reach this
+      // barrier before either exits — gufo's collectives end in
+      // lockstep, so neither side tears the stream down under the
+      // other's writes.
+      if (pairing_close != 0) {
+        std::string barrier_error;
+        if (!pairing.Ready(&barrier_error)) {
+          return Fail("exit barrier: " + barrier_error);
+        }
+      }
+    }
+    if (pairing_close == 1) {
+      pairing.Close();
+    }
+    if (g_batch_bytes > 0) {
+      for (Stream& stream : streams) {
+        if (!stream.FlushStaged(&error)) {
+          return Fail("flush staged: " + error);
+        }
+      }
+    }
+    if (!g_exit_open) {
+      close_all();
+    }
+    if (pairing_close == 2) {
+      pairing.Close();
+    }
+    std::printf("fulldup rank %u: ok\n", rank);
+    return 0;
+  }
+  for (std::size_t size : sizes) {
+    Windows windows(std::max<std::size_t>(size, 1));
+    const auto payload = std::make_unique<std::uint8_t[]>(size + 1);
+    FillPayload(payload.get(), size, 7);
+    std::vector<double> micros;
+    const auto total_start = std::chrono::steady_clock::now();
+    if (mode == "ping" || mode == "smoke") {
+      // Rank 0 drives; rank 1 echoes every frame it reads.
+      if (rank == 0) {
+        for (std::uint32_t i = 0; i < frames; ++i) {
+          Stream& stream = streams[i % links];
+          const std::size_t frame_bytes =
+              mode == "smoke" && size > 1
+                  ? ((i * 7919U + size) % size) | 1U
+                  : size;
+          const auto start = std::chrono::steady_clock::now();
+          if (!stream.WriteFrame(i, payload.get(), frame_bytes, &error)) {
+            return Fail("ping write: " + error);
+          }
+          std::size_t bytes = 0;
+          if (!stream.ReadFrame(i, windows.At(i), size, &bytes, &error)) {
+            return Fail("ping read: " + error);
+          }
+          const auto end = std::chrono::steady_clock::now();
+          if (bytes != frame_bytes) {
+            return Fail("echo size mismatch");
+          }
+          micros.push_back(
+              std::chrono::duration_cast<std::chrono::duration<double>>(
+                  end - start)
+                  .count() *
+              1e6);
+        }
+      } else {
+        for (std::uint32_t i = 0; i < frames; ++i) {
+          Stream& stream = streams[i % links];
+          std::size_t bytes = 0;
+          if (!stream.ReadFrame(i, windows.At(i), size, &bytes, &error)) {
+            return Fail("echo read: " + error);
+          }
+          if (!stream.WriteFrame(i, windows.At(i), bytes, &error)) {
+            return Fail("echo write: " + error);
+          }
+        }
+      }
+    } else if (mode == "bw") {
+      // Rank 0 streams one way; rank 1 drains.
+      const auto start = std::chrono::steady_clock::now();
+      if (rank == 0) {
+        for (std::uint32_t i = 0; i < frames; ++i) {
+          Stream& stream = streams[i % links];
+          if (!stream.WriteFrame(i, payload.get(), size, &error)) {
+            return Fail("bw write: " + error);
+          }
+        }
+      } else if (g_reader_glutton) {
+        // Wedge ablation: drain with the largest read()s possible,
+        // counting raw bytes instead of parsing frames — frees many
+        // ring slots per syscall (bulk-style) while the sender still
+        // sends small app-frames.
+        std::uint64_t total = 0;
+        const std::uint64_t expected =
+            static_cast<std::uint64_t>(size) * frames + kDataOffset * frames;
+        std::vector<std::uint8_t> sink(1U << 20);
+        while (total < expected) {
+          const ssize_t n = ::read(streams[0].GluttonFd(), sink.data(),
+                                   std::min<std::size_t>(sink.size(),
+                                                         expected - total));
+          if (n > 0) {
+            total += static_cast<std::uint64_t>(n);
+            continue;
+          }
+          if (n < 0 && errno == EINTR) {
+            continue;
+          }
+          if (n == 0) {
+            ::usleep(100);
+            continue;
+          }
+          return Fail("glutton read: " + ErrnoText("read"));
+        }
+      } else {
+        for (std::uint32_t i = 0; i < frames; ++i) {
+          Stream& stream = streams[i % links];
+          std::size_t bytes = 0;
+          if (!stream.ReadFrame(i, windows.At(i), size, &bytes, &error)) {
+            return Fail("bw read: " + error);
+          }
+        }
+      }
+      const auto end = std::chrono::steady_clock::now();
+      std::printf("%s %zu bytes\n", mode.c_str(), size);
+      ReportBandwidth(static_cast<std::uint64_t>(size) * frames, end - start,
+                      rank == 0 ? "sent" : "received");
+      continue;
+    } else {
+      // exchange: both ranks write their frame, then read the peer's,
+      // through the rotating windows: one all-reduce step.
+      for (std::uint32_t i = 0; i < frames; ++i) {
+        Stream& stream = streams[i % links];
+        const auto start = std::chrono::steady_clock::now();
+        if (!stream.WriteFrame(i, payload.get(), size, &error)) {
+          return Fail("exchange write: " + error);
+        }
+        std::size_t bytes = 0;
+        if (!stream.ReadFrame(i, windows.At(i), size, &bytes, &error)) {
+          return Fail("exchange read: " + error);
+        }
+        const auto end = std::chrono::steady_clock::now();
+        micros.push_back(
+            std::chrono::duration_cast<std::chrono::duration<double>>(
+                end - start)
+                .count() *
+            1e6);
+      }
+    }
+    std::printf("%s %zu bytes:\n", mode.c_str(), size);
+    ReportMicros(micros);
+    ReportBandwidth(static_cast<std::uint64_t>(size) * frames * 2,
+                    std::chrono::steady_clock::now() - total_start,
+                    "both directions");
+  }
+  if (links > 1) {
+    const auto elapsed = std::chrono::steady_clock::now() - run_start;
+    for (std::size_t k = 0; k < links; ++k) {
+      ReportBandwidth(streams[k].written() + streams[k].read(), elapsed,
+                      ("link " + std::to_string(k) + " both directions")
+                          .c_str());
+    }
+  }
+  if (g_batch_bytes > 0) {
+    for (Stream& stream : streams) {
+      if (!stream.FlushStaged(&error)) {
+        return Fail("flush staged: " + error);
+      }
+    }
+  }
+  if (pairing_close != 0) {
+    // Post-traffic barrier: the driver discards a sender's
+    // accepted-but-undelivered TX tail when its last fd closes, so the
+    // writer must not exit before the peer finished reading
+    // (gufo's lockstep collectives get this for free).
+    std::string barrier_error;
+    if (!pairing.Ready(&barrier_error)) {
+      return Fail("end barrier: " + barrier_error);
+    }
+  }
+  if (pairing_close == 1) {
+    pairing.Close();
+  }
+  if (!g_exit_open) {
+    close_all();
+  }
+  if (pairing_close == 2) {
+    pairing.Close();
+  }
+  std::printf("%s rank %u: ok\n", mode.c_str(), rank);
+  return 0;
+}
+
+void Usage() {
+  std::printf(
+      "usage: tbstream_probe --mode loop|ping|bw|exchange|smoke|fulldup\n"
+      "                      [--rank 0|1] [--peer HOST] [--port 18530]\n"
+      "                      [--fd /dev/tbstream0[,/dev/tbstream1...]]\n"
+      "                      [--bytes 10240[,5242880]] [--frames 1000]\n"
+      "                      [--stripe N] [--noverify]\n"
+      "                      [--pairing early|teardown|last]\n"
+      "                      [--idle-seconds N] [--exit-open]\n"
+      "                      [--batch-bytes N]\n"
+      "multiple --fd paths stripe frames round-robin over that many links\n"
+      "(--stripe must match the --fd count). loop runs in one process over\n"
+      "socketpairs; every other mode needs one process per rank, rank 1\n"
+      "given rank 0's address in --peer. --pairing controls when the\n"
+      "coordination socket closes: early (before traffic, default),\n"
+      "teardown (right before the stream fds, gufo-style) or last (after\n"
+      "the stream fds). fulldup runs a dedicated draining reader thread\n"
+      "while writing — simultaneous bidirectional bulk, gufo-style.\n");
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+  std::string mode = "loop";
+  std::uint32_t rank = 0;
+  std::string peer = "127.0.0.1";
+  std::uint16_t port = 18530;
+  std::string devices_text = "/dev/tbstream0";
+  std::string bytes_text = "10240";
+  std::uint32_t frames = 1000;
+  std::uint32_t stripe = 0;
+  int pairing_close = 0;
+  int idle_seconds = 0;
+  for (int i = 1; i < argc; ++i) {
+    const std::string arg = argv[i];
+    const auto next = [&]() -> std::string {
+      return i + 1 < argc ? argv[++i] : std::string();
+    };
+    if (arg == "--mode") {
+      mode = next();
+    } else if (arg == "--rank") {
+      rank = static_cast<std::uint32_t>(
+          std::strtoul(next().c_str(), nullptr, 10));
+    } else if (arg == "--peer") {
+      peer = next();
+    } else if (arg == "--port") {
+      port = static_cast<std::uint16_t>(
+          std::strtoul(next().c_str(), nullptr, 10));
+    } else if (arg == "--fd") {
+      devices_text = next();
+    } else if (arg == "--stripe") {
+      stripe = static_cast<std::uint32_t>(
+          std::strtoul(next().c_str(), nullptr, 10));
+    } else if (arg == "--bytes") {
+      bytes_text = next();
+    } else if (arg == "--exit-open") {
+      g_exit_open = true;
+    } else if (arg == "--reader-buffered") {
+      g_reader_buffered = true;
+    } else if (arg == "--reader-glutton") {
+      g_reader_glutton = true;
+    } else if (arg == "--batch-bytes") {
+      g_batch_bytes = static_cast<std::size_t>(
+          std::strtoull(next().c_str(), nullptr, 10));
+    } else if (arg == "--noverify") {
+      g_skip_checksums = true;
+    } else if (arg == "--frames") {
+      frames = static_cast<std::uint32_t>(
+          std::strtoul(next().c_str(), nullptr, 10));
+    } else if (arg == "--idle-seconds") {
+      idle_seconds = static_cast<int>(
+          std::strtol(next().c_str(), nullptr, 10));
+      if (idle_seconds < 0) {
+        std::fprintf(stderr, "invalid --idle-seconds\n");
+        return 2;
+      }
+    } else if (arg == "--pairing") {
+      const std::string choice = next();
+      if (choice == "early") {
+        pairing_close = 0;
+      } else if (choice == "teardown") {
+        pairing_close = 1;
+      } else if (choice == "last") {
+        pairing_close = 2;
+      } else {
+        std::fprintf(stderr, "invalid --pairing (early|teardown|last)\n");
+        return 2;
+      }
+    } else if (arg == "--help" || arg == "-h") {
+      Usage();
+      return 0;
+    } else {
+      std::fprintf(stderr, "unknown argument: %s\n", arg.c_str());
+      Usage();
+      return 2;
+    }
+  }
+  if (frames == 0 || rank > 1) {
+    std::fprintf(stderr, "invalid --frames or --rank\n");
+    return 2;
+  }
+  const std::vector<std::size_t> sizes = ParseSizes(bytes_text);
+  const std::vector<std::string> devices = ParseDevices(devices_text);
+  if (stripe != 0 && stripe != devices.size()) {
+    std::fprintf(stderr, "--stripe %u does not match the %zu --fd paths\n",
+                 stripe, devices.size());
+    return 2;
+  }
+  if (mode == "loop") {
+    return RunLoop(sizes, frames, devices.size());
+  }
+  if (mode != "ping" && mode != "bw" && mode != "exchange" &&
+      mode != "smoke" && mode != "fulldup") {
+    std::fprintf(stderr, "unknown mode: %s\n", mode.c_str());
+    Usage();
+    return 2;
+  }
+  return RunPair(mode, rank, peer, port, devices, sizes, frames,
+                 pairing_close, idle_seconds);
+}
