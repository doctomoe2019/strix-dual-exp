+constexpr std::uint32_t kTbstreamWireMagic = 0x47555453U;  // "GUTS"
+constexpr std::uint32_t kTbstreamWireVersion = 1;
+constexpr std::uint32_t kCollectiveMagic = 0x47554348U;  // "GUCH"
+constexpr std::uint32_t kCollectiveVersion = 5;
+constexpr std::uint32_t kReadyMagic = 0x47555244U;  // "GURD"
+// The same rotating windows the verbs transport uses: three, because the add
+// reading an overlapped exchange's partial may still be queued when the
+// exchange after the next one lands (see Communicator), and a queued
+// exchange's partial is staged while the previous one is in flight. A frame
+// starts with the writer's header; the partial follows at kDataOffset. Sized
+// so the widest batched all-reduce partial (glm5_next kMaxBatch=4096 tokens
+// x 4096 hidden x f32 = 64 MiB) plus its header fits a window with headroom.
+constexpr std::size_t kWindowBytes = 128U << 20;
+constexpr std::size_t kWindows = 3;
+// Ring-depth-sized syscall granularity for the coalesced transport shape
+// (256 ring slots x 4 KiB). See GUFO_TBSTREAM_COALESCE.
+constexpr std::size_t kCoalesceBytes = 1U << 20;
+constexpr std::size_t kBufferBytes = kWindows * kWindowBytes;
+constexpr std::size_t kDataOffset = 64;
+// Overlapped exchanges started and not yet finished; each has its own
+// readiness event.
+constexpr std::size_t kStartedExchanges = 4;
+// Queued exchanges not yet complete; a forward queues one per layer.
+constexpr std::size_t kQueuedExchanges = 4096;
+// A GPU wait gives up well after the exchange thread's own timeout. The
+// 240 s budget mirrors the verbs transport's slow-peer tolerance: rank
+// skew from back-to-back model loads (observed ~68 s on the tenth
+// restart in a row) must not fail an exchange against a live peer.
+constexpr std::uint64_t kWaitSeconds = 240;
+// Flag words, a cache line apart: written by the GPU, by the host, and by a
+// GPU wait that timed out.
+constexpr std::size_t kReadyOffset = 0;
+constexpr std::size_t kArrivedOffset = 64;
+constexpr std::size_t kTimedOutOffset = 128;
+constexpr std::size_t kFlagBytes = 4096;
+// A slow-but-live peer (model-load skew, throttled storage) is waited
+// for, mirroring the verbs transport's 180 s exchange deadline; a dead
+// peer is detected at once through the bootstrap socket or the stream's
+// EOF/EPIPE, not by this deadline.
+constexpr auto kCollectiveTimeout = std::chrono::seconds(180);
+
+/// Diagnostic helpers for the env-gated lockstep-exchange phase split
+/// (GUFO_TBSTREAM_TRACE_MS=1): no allocation-ordering or hot-path cost
+/// when disabled.
+bool TraceExchangePhases() noexcept {
+  static const bool enabled = std::getenv("GUFO_TBSTREAM_TRACE_MS") != nullptr;
+  return enabled;
+}
+
+double MillisSince(std::chrono::steady_clock::time_point start) noexcept {
+  return std::chrono::duration<double, std::milli>(
+             std::chrono::steady_clock::now() - start)
+      .count();
+}
+
+void NoteExchangePhase(std::size_t bytes, double stage_ms, double write_ms,
+                       double wait_ms) noexcept {
+  static std::mutex mutex;
+  static std::uint64_t count = 0;
+  static double total_stage = 0.0;
+  static double total_write = 0.0;
+  static double total_wait = 0.0;
+  static std::uint64_t total_bytes = 0;
+  std::lock_guard lock(mutex);
+  ++count;
+  total_stage += stage_ms;
+  total_write += write_ms;
+  total_wait += wait_ms;
+  total_bytes += bytes;
+  if (count % 90 == 0) {
+    std::fprintf(stderr,
+                 "[tbstream exchange phases] n=%llu bytes=%llu MiB stage=%.1f "
+                 "ms write=%.1f ms wait=%.1f ms\n",
+                 static_cast<unsigned long long>(count),
+                 static_cast<unsigned long long>(total_bytes >> 20),
+                 total_stage, total_write, total_wait);
+    std::fflush(stderr);
+  }
+}
+constexpr auto kReceiveSpinWindow = std::chrono::microseconds(500);
+// An exchange waits for a layer of GPU work, or a peer that is a layer behind:
+// spinning that long keeps the wake-up latency off every decode exchange.
+constexpr auto kExchangeSpinWindow = std::chrono::milliseconds(5);
+// Frames smaller than this stay f32 on the wire: decode-shaped exchanges are
+// latency-bound (bytes do not move the needle) and keep the exact path, so
+// quantization only ever applies to the bandwidth-bound prefill batches.
+constexpr std::size_t kQuantizeMinBytes = 256 * 1024;
+
+// Eases a spin loop off the core's shared resources and the SoC power budget,
+// which the GPU draws from too.
+inline void CpuRelax() noexcept {
+#if defined(__x86_64__) || defined(__i386__)
+  __builtin_ia32_pause();
+#endif
+}
+
+/// Pins the calling thread to `cpu` (a negative index counts from the top
+/// of the process's affinity mask), so the reader and the exchange worker
+/// never migrate under load. Failures are ignored: pinning is a latency
+/// refinement, not a correctness requirement.
+void PinToCpuFromTop(int cpu_from_top) {
+  cpu_set_t allowed;
+  CPU_ZERO(&allowed);
+  if (::sched_getaffinity(0, sizeof(allowed), &allowed) != 0) {
+    return;
+  }
+  int chosen = -1;
+  for (int cpu = CPU_SETSIZE - 1; cpu >= 0 && cpu_from_top >= 0; --cpu) {
+    if (CPU_ISSET(cpu, &allowed) && cpu_from_top-- == 0) {
+      chosen = cpu;
+      break;
+    }
+  }
+  if (chosen >= 0) {
+    cpu_set_t pinned;
+    CPU_ZERO(&pinned);
+    CPU_SET(chosen, &pinned);
+    (void)::sched_setaffinity(0, sizeof(pinned), &pinned);
+  }
+}
+
+void SetError(std::string* error_msg, std::string message) {
+  if (error_msg != nullptr) {
+    *error_msg = std::move(message);
+  }
+}
+
+std::string SystemError(const char* operation) {
+  return std::string(operation) + ": " + std::strerror(errno);
+}
+
+/// A blocking-exchange failure the reader thread reports to waiters without
+/// taking the communicator lock: the reason is a static string, so a waiter
+/// holding the lock in the synchronous exchange path can still name it.
+enum class ReaderFailure : std::uintptr_t {
+  kPeerLost = 1,
+  kStreamRead = 2,
+  kStreamClosed = 3,
+  kHeader = 4,
+  kTimeout = 5,
+};
+
+const char* ReaderFailureText(void* failure) {
+  switch (
+      static_cast<ReaderFailure>(reinterpret_cast<std::uintptr_t>(failure))) {
+    case ReaderFailure::kPeerLost:
+      return "tbstream peer closed the bootstrap connection";
+    case ReaderFailure::kStreamRead:
+      return "tbstream device read failed";
+    case ReaderFailure::kStreamClosed:
+      return "tbstream device returned end of stream";
+    case ReaderFailure::kHeader:
+      return "tbstream collective identity or size mismatch";
+    case ReaderFailure::kTimeout:
+      return "tbstream timed out waiting for the peer's frame";
+  }
+  return "tbstream reader failed";
+}
