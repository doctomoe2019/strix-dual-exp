+      "",
+      "",
+      {glm::ChatMessage::ToolCall{
+          "get_weather", {args.begin(), args.end()}, "call_9"}},
+      ""};
+  const std::array<glm::ChatMessage, 2> messages{user, assistant};
+  const glm::ChatTemplateOptions options{.add_generation_prompt = true};
+
+  const std::string rendered = glm::RenderChat(messages, {tools}, options);
+  const std::string expected =
+      R"~([gMASK]<sop><|system|>Reasoning Effort: Max<|system|>
+# Tools
