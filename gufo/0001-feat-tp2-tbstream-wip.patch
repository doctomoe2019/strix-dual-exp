diff --git a/tests/models/qwen38_flash_next/gpu_probe_sqrtf_shim.cpp b/tests/models/qwen38_flash_next/gpu_probe_sqrtf_shim.cpp
new file mode 100644
index 0000000..ab98fb8
--- /dev/null
+++ b/tests/models/qwen38_flash_next/gpu_probe_sqrtf_shim.cpp
@@ -0,0 +1,8 @@
+// Link workaround for the diagnostic gpu_probe target only: the Nix
+// toolchain's libm requires GLIBC_2.43's sqrtf, which the runtime's older
+// glibc cannot satisfy. Resolving sqrtf to the compiler builtin removes the
+// versioned symbol reference; the probe's own use is a scalar summary
+// statistic. Not production code.
+extern "C" float sqrtf(float x) {
+  return __builtin_sqrtf(x);
+}
diff --git a/tests/models/qwen38_flash_next/hc_mix_ops_test.cpp b/tests/models/qwen38_flash_next/hc_mix_ops_test.cpp
index 7b51436..bae31bc 100644
--- a/tests/models/qwen38_flash_next/hc_mix_ops_test.cpp
+++ b/tests/models/qwen38_flash_next/hc_mix_ops_test.cpp
@@ -89,6 +89,123 @@ std::vector<float> Download(HipBuffer<float>* source, std::size_t count) {
   return values;
 }
 
+// The paired-prefill fused peer combine must equal the unfused peer add
+// followed by the combine, bit for bit, on every output it writes: the
+// residual, the norm (F16 and float routes), the tiled Q8 bytes and the
+// optional summed block row. The gamma-less tail is covered too.
+void CheckFusedPeerCombine(std::uint32_t tokens) {
+  constexpr float kEps = 1e-6F;
+  constexpr std::size_t kHcDim = kStreams * kHidden;
+  const std::size_t rows = static_cast<std::size_t>(tokens) * kHcDim;
+  const std::size_t mixed = static_cast<std::size_t>(tokens) * kHidden;
+  const auto res = MakeValues(rows, 0x0F0F0F0FU, 1.0F);
+  const auto local = MakeValues(mixed, 0x12340001U, 1.0F);
+  const auto peer = MakeValues(mixed, 0x12340002U, 1.0F);
+  const auto gamma = MakeValues(kHcDim, 0x600DCAFEU, 0.5F);
+  const std::uint32_t parts = q::HcInjectPartsVec4(kHidden);
+  const auto inject = MakeValues(
+      static_cast<std::size_t>(tokens) * kStreams * parts, 0xDEADBEEFU, 0.1F);
+  const std::size_t q8_bytes = q::Q8TiledBytes(tokens, kHcDim);
+  for (int variant = 0; variant < 3; ++variant) {
+    const bool f16 = variant != 2;
+    const bool with_gamma = variant != 1;
+    HipBuffer<float> d_res_a(rows), d_res_b(rows);
+    HipBuffer<float> d_block(mixed), d_local(mixed), d_peer(mixed);
+    HipBuffer<float> d_summed(mixed), d_summed_ref(mixed);
+    HipBuffer<float> d_gamma(kHcDim);
+    HipBuffer<float> d_inject(inject.size());
+    HipBuffer<float> d_xn_ref(rows), d_xn_fused(rows);
+    HipBuffer<__half> d_xn_half_ref(rows), d_xn_half(rows);
+    HipBuffer<std::uint8_t> d_q8_ref(q8_bytes), d_q8(q8_bytes);
+    Upload(&d_res_a, res);
+    Upload(&d_res_b, res);
+    Upload(&d_local, local);
+    Upload(&d_peer, peer);
+    Upload(&d_gamma, gamma);
+    Upload(&d_inject, inject);
+    CheckHip(hipMemset(d_q8_ref.get(), 0, q8_bytes), "clear reference Q8");
+    CheckHip(hipMemset(d_q8.get(), 0, q8_bytes), "clear fused Q8");
+    // A gamma-less combine writes no norm; both buffers start zeroed so the
+    // byte comparison covers that case too.
+    CheckHip(hipMemset(d_xn_half_ref.get(), 0, d_xn_half_ref.bytes()),
+             "clear reference F16 norm");
+    CheckHip(hipMemset(d_xn_half.get(), 0, d_xn_half.bytes()),
+             "clear fused F16 norm");
+    CheckHip(hipMemset(d_xn_ref.get(), 0, d_xn_ref.bytes()),
+             "clear reference float norm");
+    CheckHip(hipMemset(d_xn_fused.get(), 0, d_xn_fused.bytes()),
+             "clear fused float norm");
+    // Reference: add the peer into a copy of the local partial, then the
+    // unfused combine.
+    CheckHip(hipMemcpy(d_block.get(), d_local.get(), d_block.bytes(),
+                       hipMemcpyDeviceToDevice),
+             "copy local partial");
+    CheckHip(hipMemcpy(d_summed_ref.get(), d_local.get(), d_summed_ref.bytes(),
+                       hipMemcpyDeviceToDevice),
+             "copy local partial for the summed reference");
+    q::AddRowsBroadcast(d_peer.get(), d_block.get(), tokens, kHidden, 1,
+                        nullptr);
+    q::AddRowsBroadcast(d_peer.get(), d_summed_ref.get(), tokens, kHidden, 1,
+                        nullptr);
+    if (f16) {
+      q::HcCombineF16(d_res_a.get(), d_block.get(), d_inject.get(), parts,
+                      with_gamma ? d_gamma.get() : nullptr, d_xn_half_ref.get(),
+                      d_q8_ref.get(), tokens, kHidden, kStreams, kEps, nullptr);
+      if (!q::HcCombinePeerF16(d_res_b.get(), d_local.get(), d_peer.get(),
+                               d_summed.get(), d_inject.get(), parts,
+                               with_gamma ? d_gamma.get() : nullptr,
+                               d_xn_half.get(), d_q8.get(), tokens, kHidden,
+                               kStreams, kEps, nullptr)) {
+        throw std::runtime_error("fused peer combine rejected the geometry");
+      }
+    } else {
+      q::HcCombine(d_res_a.get(), d_block.get(), d_inject.get(), parts,
+                   with_gamma ? d_gamma.get() : nullptr, d_xn_ref.get(), tokens,
+                   kHidden, kStreams, kEps, nullptr);
+      if (!q::HcCombinePeer(
+              d_res_b.get(), d_local.get(), d_peer.get(), d_summed.get(),
+              d_inject.get(), parts, with_gamma ? d_gamma.get() : nullptr,
+              d_xn_fused.get(), tokens, kHidden, kStreams, kEps, nullptr)) {
+        throw std::runtime_error("fused peer combine rejected the geometry");
+      }
+    }
+    // An observer that wants the summed row in the block buffer itself
+    // must be refused: every stream re-reads that row, so an in-place sum
+    // would add the peer again.
+    if (q::HcCombinePeerF16(d_res_b.get(), d_local.get(), d_peer.get(),
+                            d_local.get(), d_inject.get(), parts, d_gamma.get(),
+                            d_xn_half.get(), d_q8.get(), tokens, kHidden,
+                            kStreams, kEps, nullptr) ||
+        q::HcCombinePeer(d_res_b.get(), d_local.get(), d_peer.get(),
+                         d_local.get(), d_inject.get(), parts, d_gamma.get(),
+                         d_xn_fused.get(), tokens, kHidden, kStreams, kEps,
+                         nullptr)) {
+      throw std::runtime_error("fused peer combine accepted an aliasing sum");
+    }
+    CheckHip(hipDeviceSynchronize(), "fused peer combine synchronization");
+    const auto exact = [&](auto& a, auto& b, const char* what) {
+      std::vector<std::uint8_t> x(a.bytes()), y(b.bytes());
+      CheckHip(hipMemcpy(x.data(), a.get(), x.size(), hipMemcpyDeviceToHost),
+               "reference download");
+      CheckHip(hipMemcpy(y.data(), b.get(), y.size(), hipMemcpyDeviceToHost),
+               "fused download");
+      if (x != y) {
+        throw std::runtime_error(std::string("fused peer combine changed ") +
+                                 what);
+      }
+    };
+    exact(d_res_a, d_res_b, "the residual");
+    exact(d_summed_ref, d_summed, "the summed block row");
+    if (f16) {
+      exact(d_xn_half_ref, d_xn_half, "the F16 norm");
+      exact(d_q8_ref, d_q8, "the tiled Q8 norm");
+    } else {
+      exact(d_xn_ref, d_xn_fused, "the float norm");
+    }
+  }
+  std::cerr << "HC fused peer combine exact at " << tokens << " tokens\n";
+}
+
