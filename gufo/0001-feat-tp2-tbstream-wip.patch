+
+/// Batched (prefill) kernels for the GLM-5.3-Flash executor. Every kernel
+/// reproduces the tokenwise kernels' arithmetic exactly per row — same
+/// accumulation order, same rounding — so a chunked forward is
+/// byte-identical to the tokenwise one, the frozen P2 contract. Rows are
+/// the leading axis ([tokens][...]) unless noted.
+namespace gufo::models::glm5_next::rocm {
+
+/// Expert count the shared-memory router selection kernel accepts.
+inline constexpr std::uint32_t kRouterExpertLimit = 512;
+
+/// streams[t][s][hidden] from the embedding rows of tokens[t] (device
+/// int32 token ids). F32 and Q8_0 tables only; sets *error_msg on an
+/// unsupported encoding, geometry or launch.
+bool BatchEmbedTokenStreams(const void* table, WeightType,
+                            const std::int32_t* tokens, float* streams,
+                            std::uint32_t hidden, std::uint32_t n_streams,
+                            std::uint32_t tokens_count, hipStream_t stream,
+                            std::string* error_msg);
+
+/// y[t][m] = dot(w[m], x[t]) over quantized weights; the per-row warp
+/// arithmetic is the shared block dot the tokenwise GEMV uses. `y_stride`
+/// (0 = m) places each token's rows when y is wider than m (the KDA q|k|v
+/// concatenation).
+void BatchQ8KBlockGEMV(const void* w, WeightType, const float* x, float* y,
+                       std::uint32_t tokens, std::uint32_t m, std::uint32_t k,
+                       hipStream_t stream, std::size_t y_stride = 0);
+
+/// The same GEMV per (token, slot) pair, with each pair's expert chosen by
+/// ids[t][slot]; y is [tokens][slots][m], x is [tokens][k].
+void BatchExpertQ8KBlockGEMV(const void* w, WeightType, const std::int32_t* ids,
+                             const float* x, float* y, std::uint32_t tokens,
+                             std::uint32_t slots, std::size_t expert_stride,
+                             std::uint32_t m, std::uint32_t k,
+                             hipStream_t stream);
+
+/// Grouped expert GEMV: device-sorts the (token, slot) pairs into expert
+/// buckets (`bins`/`ranks`/`pairs` are caller scratch of at least
+/// 2*experts+2, tokens*slots and tokens*slots u32) so every expert's
+/// weight rows are read and decoded once per expert pair tile — once per
+/// 32-pair bucket at prefill batch widths (>= 64 tokens, the mean bucket
+/// at 1024-wide chunks is ~28 pairs), once per 16-pair tile below that.
+/// `x_stride` of k reads each token's shared activation row (gate/up); 1
+/// reads each pair's dense row (down). y layout matches
+/// BatchExpertQ8KBlockGEMV. Sub-16 encodings with vector-alignable rows
+/// dispatch the weight-stationary kernel (bit-identical twin of the
+/// generic tile); anything else, including Q8_0, runs the generic tile.
+/// Returns false (launching nothing) for encodings outside Q8_0 and the
+/// sub16 family.
+[[nodiscard]] bool BatchExpertQ8KGrouped(
+    const void* w, WeightType, const std::int32_t* ids, std::uint32_t* bins,
+    std::uint32_t* ranks, std::uint32_t* pairs, const float* x, float* y,
+    std::uint32_t tokens, std::uint32_t slots, std::size_t expert_stride,
+    std::uint32_t m, std::uint32_t k, std::size_t x_stride,
+    std::uint32_t experts, hipStream_t stream);
+
+/// The down-projection form: x is dense per (token, slot) pair.
+void BatchExpertQ8KBlockGEMVPairDense(const void* w, WeightType,
+                                      const std::int32_t* ids, const float* x,
+                                      float* y, std::uint32_t tokens,
+                                      std::uint32_t slots,
+                                      std::size_t expert_stride,
+                                      std::uint32_t m, std::uint32_t k,
+                                      hipStream_t stream);
+
+/// y[t][m] = dot(w[m], x[t]) over F32 weights, double accumulation.
+void BatchF32Gemm(const float* w, const float* x, float* y,
+                  std::uint32_t tokens, std::uint32_t m, std::uint32_t k,
+                  hipStream_t stream);
+
+/// Device-side MoE routing over the batched router rows: sigmoid
+/// probabilities (sigmoid in double), selection by probs + noaux_tc bias
+/// with ties to the lower expert id, normalized top-k weights in selection
+/// order. ids are [tokens][experts_used]; weights are slot-major
+/// [experts_used][tokens]. expert_count must fit kRouterExpertLimit.
+void BatchRouterSelect(const float* logits, const float* bias,
+                       std::int32_t* ids, float* weights, std::uint32_t tokens,
+                       std::uint32_t expert_count, std::uint32_t experts_used,
+                       float routed_scaling, hipStream_t stream);
+
+/// One thread per token, the tokenwise Sinkhorn body.
+void BatchHcSinkhorn(const float* mixes, const float* scale, const float* base,
+                     float* pre, float* post, float* comb, std::uint32_t n,
+                     std::uint32_t tokens, std::uint32_t sinkhorn_iters,
+                     float eps, hipStream_t stream);
+
+void BatchHcCollapse(const float* pre, const float* streams, float* collapsed,
+                     std::uint32_t hidden, std::uint32_t n,
+                     std::uint32_t tokens, hipStream_t stream);
+
+void BatchHcCombine(const float* post, const float* comb, const float* residual,
+                    const float* block_out, float* streams,
+                    std::uint32_t hidden, std::uint32_t n, std::uint32_t tokens,
+                    hipStream_t stream);
+
+void BatchMeanStreams(const float* streams, float* out, std::uint32_t hidden,
+                      std::uint32_t n, std::uint32_t tokens,
+                      hipStream_t stream);
+
+/// KDA conv over the whole chunk with the rolling history in registers;
+/// history updates in place to the state after the last token.
+void BatchKdaConv(const float* qkv, const float* taps_q, const float* taps_k,
+                  const float* taps_v, float* history, float* conv_out,
+                  std::uint32_t tokens, std::uint32_t inner,
+                  std::uint32_t kernel, hipStream_t stream);
+
+void BatchKdaPrepare(const float* conv_out, float* qn, float* kn,
+                     std::uint32_t tokens, std::uint32_t heads,
+                     std::uint32_t dim, float l2_eps, hipStream_t stream);
+
+void BatchKdaGates(const float* raw, const float* a, const float* dt,
+                   const float* beta_row, float bound, float* gate, float* beta,
+                   std::uint32_t tokens, std::uint32_t inner, std::uint32_t dim,
+                   std::uint32_t heads, hipStream_t stream);
+
+/// One block per head; the block walks the chunk's tokens in order with
+/// the tokenwise recurrence body, so the recurrent state advances exactly
+/// as one token at a time.
+void BatchKdaRecurrence(const float* qn, const float* kn, const float* gate,
+                        const float* beta, const float* conv_out, float* state,
+                        float* core, std::uint32_t tokens, std::uint32_t heads,
+                        std::uint32_t dim, hipStream_t stream);
+
+/// LayerNormed indexer keys/gates of every chunk row into the chunk
+/// scratch (rows [tokens][idim]).
+void BatchIndexerAppend(const float* keys_raw, const float* gates_raw,
+                        const float* k_norm_w, const float* k_norm_b,
+                        float* keys, float* gates, std::uint32_t tokens,
+                        std::uint32_t idim, float eps, hipStream_t stream);
+
+/// Pools [first_pool, first_pool + pools) whose global rows live in the
+/// [frontier | chunk] scratch (`rows` = 3 + tokens rows); `row_base` is
+/// the global row index of `rows[0]`.
+void BatchIndexerPool(const float* rows, const float* row_gates,
+                      const float* ape, float* pooled, std::uint32_t first_pool,
+                      std::uint32_t pools, std::size_t row_base,
+                      std::uint32_t kpool, std::uint32_t idim,
+                      hipStream_t stream);
+
+/// scores[t * pitch + p] for every query row against the pooled cache;
+/// query t scores only the pools complete at position seen_base + t.
+/// `pitch` >= pools bounds the per-token row inside the resident scratch.
+void BatchIndexerScores(const float* iq, const float* pooled,
+                        const float* weights, float* scores,
+                        std::uint32_t pitch, std::uint32_t tokens,
+                        std::uint32_t pools, std::uint32_t kpool,
+                        std::uint32_t seen_base, std::uint32_t heads,
+                        std::uint32_t idim, float scale, hipStream_t stream);
+
+/// The exact top-k selection per query row; tokens_seen of query t is
+/// seen_base + t + 1. Selections land [tokens][select_pools * kpool + 3]
+/// (padded stride, counts in counts[t]). Tiled over `pitch`-strided score
+/// rows: supports any pool count the scores buffer holds. Ties break to
+/// the lower pool index like the host stable sort, including signed zero.
+bool BatchSelectPools(const float* scores, std::uint32_t pitch,
+                      std::uint32_t tokens, std::uint32_t pools,
+                      std::uint32_t select_pools, std::uint32_t kpool,
+                      std::uint32_t seen_base, std::uint32_t sel_stride,
+                      std::int32_t* selections, std::uint32_t* counts,
+                      hipStream_t stream);
+
+void BatchMlaAbsorb(const float* k_b, const float* q, float* q_abs,
+                    std::uint32_t tokens, std::uint32_t heads,
+                    std::uint32_t kv_lora, std::uint32_t qk_nope,
+                    hipStream_t stream);
+
+/// One block per (token, head); count read from counts[t].
+void BatchMlaAttention(const float* q_abs, const float* latents,
+                       const std::int32_t* selections,
+                       const std::uint32_t* counts, std::uint32_t sel_stride,
+                       const float* v_b, float* attn_out, float* probs,
+                       float* weighted, std::uint32_t tokens,
+                       std::uint32_t heads, std::uint32_t kv_lora,
+                       std::uint32_t qk_nope, std::uint32_t v_head, float scale,
+                       hipStream_t stream);
+
+/// acc[t][c] += weights[t] * x[t][c] over [tokens][hidden].
+void ScaleAddRowsWeighted(float* acc, const float* x, const float* weights,
+                          std::uint32_t tokens, std::uint32_t hidden,
