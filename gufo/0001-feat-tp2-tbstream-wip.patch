+    }
+    float* y = nullptr;
+    float* y_ref = nullptr;
+    HIPCK(hipMalloc(&y, 2048UL * kSlots * 4096 * sizeof(float)));
+    HIPCK(hipMalloc(&y_ref, 2048UL * kSlots * 4096 * sizeof(float)));
+
+    const std::vector<Shape> shapes = {
+        {"gateTP2 m1024 k4096", 1024, 4096, 4096},
+        {"downTP2 m4096 k1024", 4096, 1024, 1},
+        {"gateTP1 m2048 k4096", 2048, 4096, 4096},
+        {"downTP1 m4096 k2048", 4096, 2048, 1},
+    };
+
+    enum class KId : std::uint32_t {
+      kV0,
+      kS16_16_2,
+      kS32_16_2,
+      kS32_32_2,
+      kS32_16_1,
+      kS32_32_1,
+      kS48_16_1,
+      kS48_32_1,
+      kS64_16_1,
