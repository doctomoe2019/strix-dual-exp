+#ifndef GUFO_MODELS_GLM5_NEXT_WEIGHTS_HPP_
+#define GUFO_MODELS_GLM5_NEXT_WEIGHTS_HPP_
+
+#include <cstdint>
+#include <optional>
+#include <string>
