+<tool_call>get_weather<arg_key>city</arg_key><arg_value>Berlin</arg_value><arg_key>units</arg_key><arg_value>c</arg_value></tool_call><tool_call>read_file<arg_key>path</arg_key><arg_value>/etc/hosts</arg_value></tool_call>
+<|user|>thanks<|assistant|><think>)~";
+  Require(rendered == expected, "ToolCallHistory golden mismatch");
+}
+
+void CheckToolCallNonStringArgs() {
+  const glm::ChatTool weather{
+      "get_weather", "Get current weather for a city",
+      R"({"type":"object","properties":{"city":{"type":"string"},"units":{"type":"string","enum":["c","f"]}},"required":["city"]})"};
+  const glm::ChatTool read_file{
