+void TestEarlyResponseReadable() {
+  RunningServer server({.max_request_body_bytes = 8192});
+  // A paced upload that keeps sending after the server has already rejected
+  // the request must still be able to read the error. Closing with unread
+  // data would surface as a mid-upload connection reset instead, which is
+  // what streaming proxies report as a 502 (RFC 9112 section 9.6).
+  const auto paced = [&](const std::string& head,
+                         const std::vector<std::string>& pieces) {
+    const int fd = server.Connect();
+    bool send_failed = false;
+    std::vector<std::string> fragments;
+    fragments.push_back(head);
+    fragments.insert(fragments.end(), pieces.begin(), pieces.end());
+    for (const std::string& fragment : fragments) {
+      std::size_t sent = 0;
+      while (sent < fragment.size()) {
+        const ssize_t count = ::send(fd, fragment.data() + sent,
+                                     fragment.size() - sent, MSG_NOSIGNAL);
+        if (count <= 0) {
+          send_failed = true;
+          break;
+        }
+        sent += static_cast<std::size_t>(count);
+      }
+      if (send_failed) {
+        break;
+      }
+      std::this_thread::sleep_for(std::chrono::milliseconds(4));
+    }
+    std::string response;
+    char buffer[4096];
+    for (;;) {
+      const ssize_t count = ::read(fd, buffer, sizeof(buffer));
+      if (count <= 0) {
+        break;
+      }
+      response.append(buffer, static_cast<std::size_t>(count));
+    }
+    ::close(fd);
+    assert(!send_failed);
+    return response;
+  };
+
+  // Length-framed oversized upload.
+  const std::string pad(4096, 'x');
+  std::vector<std::string> pieces;
+  for (int i = 0; i < 16; ++i) {
+    pieces.push_back(pad);
+  }
+  ExpectStatus(
+      paced("POST /echo HTTP/1.1\r\nContent-Length: 200000\r\n\r\n", pieces),
+      413);
+
+  // The reported proxy shape: a chunked upload rejected once the decoded
+  // size passes the limit mid-stream.
+  std::vector<std::string> chunks;
+  for (int i = 0; i < 16; ++i) {
+    chunks.push_back(std::string("2000\r\n") + std::string(8192, 'A') + "\r\n");
+  }
+  ExpectStatus(paced("POST /echo HTTP/1.1\r\nTransfer-Encoding: chunked\r\n"
+                     "\r\n",
+                     chunks),
+               413);
+}
+
+void TestExpectContinue() {
+  RunningServer server({.max_request_body_bytes = 8192});
+  const auto send_all = [](int fd, std::string_view data) {
+    std::size_t sent = 0;
+    while (sent < data.size()) {
+      const ssize_t count =
+          ::send(fd, data.data() + sent, data.size() - sent, MSG_NOSIGNAL);
+      assert(count > 0);
+      sent += static_cast<std::size_t>(count);
+    }
+  };
+  const auto read_n = [](int fd, std::size_t want) {
+    std::string out;
+    char buffer[4096];
+    while (out.size() < want) {
+      const ssize_t count = ::read(fd, buffer, sizeof(buffer));
+      if (count <= 0)
+        break;
+      out.append(buffer, static_cast<std::size_t>(count));
+    }
+    return out;
+  };
+  const auto read_message = [](int fd) {
+    std::string out;
+    char buffer[4096];
+    for (;;) {
+      const auto header_end = out.find("\r\n\r\n");
+      if (header_end != std::string::npos) {
+        const auto length_at = out.find("\r\nContent-Length: ");
+        if (length_at != std::string::npos && length_at < header_end) {
+          const auto value_begin =
+              length_at + std::string("\r\nContent-Length: ").size();
+          const auto value_end = out.find("\r\n", value_begin);
+          const std::size_t length = std::strtoull(
+              out.substr(value_begin, value_end - value_begin).c_str(), nullptr,
+              10);
+          if (out.size() >= header_end + 4 + length) {
+            return out;
+          }
+        }
+      }
+      const ssize_t count = ::read(fd, buffer, sizeof(buffer));
+      if (count <= 0)
+        return out;
+      out.append(buffer, static_cast<std::size_t>(count));
+    }
+  };
+
+  // curl-style clients wait for the interim response before streaming.
+  const int fd = server.Connect();
+  send_all(fd,
+           "POST /echo HTTP/1.1\r\nExpect: 100-continue\r\n"
+           "Content-Length: 5\r\n\r\n");
+  assert(read_n(fd, std::string("HTTP/1.1 100 Continue\r\n\r\n").size()) ==
+         "HTTP/1.1 100 Continue\r\n\r\n");
+  send_all(fd, "hello");
+  const std::string acknowledged = read_message(fd);
+  ExpectStatus(acknowledged, 200);
+  assert(BodyOf(acknowledged) == "hello");
+  ::close(fd);
+
+  // Rejections answer directly, without the interim response.
+  const int rejected = server.Connect();
+  send_all(rejected,
+           "POST /echo HTTP/1.1\r\nExpect: 100-continue\r\n"
+           "Content-Length: 99999\r\n\r\n");
+  const std::string refused = read_message(rejected);
+  ExpectStatus(refused, 413);
+  assert(refused.find("100 Continue") == std::string::npos);
+  ::close(rejected);
+
+  // Chunked uploads use the same interim response.
+  const int chunked_fd = server.Connect();
+  send_all(chunked_fd,
+           "POST /echo HTTP/1.1\r\nExpect: 100-continue\r\n"
+           "Transfer-Encoding: chunked\r\n\r\n");
+  assert(
+      read_n(chunked_fd, std::string("HTTP/1.1 100 Continue\r\n\r\n").size()) ==
+      "HTTP/1.1 100 Continue\r\n\r\n");
+  send_all(chunked_fd, "5\r\nhello\r\n0\r\n\r\n");
+  const std::string chunked_response = read_message(chunked_fd);
+  ExpectStatus(chunked_response, 200);
+  assert(BodyOf(chunked_response) == "hello");
+  ::close(chunked_fd);
+}
