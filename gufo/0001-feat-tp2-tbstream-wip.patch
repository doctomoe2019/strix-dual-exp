+#ifndef GUFO_MODELS_GLM5_NEXT_CONFIG_HPP_
+#define GUFO_MODELS_GLM5_NEXT_CONFIG_HPP_
+
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "src/core/gguf_reader.hpp"
+
+namespace gufo::models::glm5_next {
+
+/// Architecture parameters of a `glm5-next` GGUF artifact (GLM-5.3-Flash).
+/// Every value is read from the file; the checks bound what this runtime
+/// was written for: 45 trunk layers (34 KDA + 11 DSA), mHC with four
+/// streams, nope-only MLA with a k-pool DSA indexer, and a DeepSeek-style
+/// MoE with one shared expert.
+struct Config {
+  /// Trunk layers (the nextn block excluded).
+  std::uint32_t num_layers{0};
+  /// Present nextn (MTP) blocks; the AR loader skips their tensors.
+  std::uint32_t nextn_layers{0};
+  std::uint32_t hidden_size{0};     ///< 4096.
+  std::uint32_t vocab_size{0};      ///< 154880.
+  std::uint32_t context_length{0};  ///< 1048576.
+  float rms_eps{1e-5F};             ///< attention.layer_norm_rms_epsilon.
+  float layer_norm_eps{1e-6F};      ///< indexer k-norm LayerNorm epsilon.
+
+  /// Manifold-constrained hyper-connections.
+  std::uint32_t hc_count{0};           ///< 4; the runtime asserts exactly 4.
+  std::uint32_t hc_sinkhorn_iters{0};  ///< 20.
+  float hc_eps{1e-6F};
+
+  /// Shared head count of KDA and DSA layers (64).
+  std::uint32_t head_count{0};
+  std::uint32_t q_lora_rank{0};       ///< 1536.
+  std::uint32_t kv_lora_rank{0};      ///< 512; the retained MLA latent width.
+  std::uint32_t qk_nope_head_dim{0};  ///< 256; nope-only, rope dimension 0.
+  std::uint32_t v_head_dim{0};        ///< 256.
+
+  /// KDA linear attention.
+  std::uint32_t kda_head_dim{0};      ///< 128.
+  std::uint32_t kda_conv_kernel{0};   ///< 4.
+  float kda_gate_lower_bound{-5.0F};  ///< negative; sigmoid-form decay gate.
+
+  /// DSA indexer with learned k-pool compression.
+  std::uint32_t indexer_heads{0};     ///< 32.
+  std::uint32_t indexer_head_dim{0};  ///< 128.
+  std::uint32_t indexer_top_k{0};     ///< 2048 original tokens.
+  std::uint32_t indexer_kpool{0};     ///< 4 tokens per scored pool.
+  bool indexer_select_tail{true};     ///< incomplete tail always selected.
+
+  /// Feed-forward: dense lead, then routed + shared experts.
+  std::uint32_t dense_lead{0};          ///< 3 dense layers.
+  std::uint32_t dense_ffn{0};           ///< 12288.
+  std::uint32_t expert_count{0};        ///< 288.
+  std::uint32_t experts_used{0};        ///< 8.
+  std::uint32_t shared_experts{0};      ///< 1.
+  std::uint32_t expert_ffn{0};          ///< 2048.
+  std::uint32_t expert_group_count{0};  ///< 1; grouped routing unsupported.
+  std::uint32_t expert_group_used_count{0};  ///< 1.
+  float routed_scaling{2.5F};                ///< expert_weights_scale.
+  float swiglu_limit{10.0F};  ///< clamp, shared by routed and shexp.
+
+  /// Stop ids from tokenizer.ggml eos/eom/eot_token_id (deduplicated).
+  std::vector<std::uint32_t> eos_token_ids;
+
+  /// Per trunk layer: true on DSA (sparse MLA) layers, false on KDA.
+  std::vector<bool> dsa_layer;
+
+  [[nodiscard]] std::uint32_t KdaInnerDim() const noexcept {
+    return head_count * kda_head_dim;
+  }
+  [[nodiscard]] std::uint32_t MlaQueryDim() const noexcept {
+    return head_count * qk_nope_head_dim;
+  }
+  [[nodiscard]] std::uint32_t HcDim() const noexcept {
+    return hc_count * hidden_size;
+  }
+  [[nodiscard]] std::uint32_t HcMixDim() const noexcept {
+    return (2 + hc_count) * hc_count;
+  }
+  [[nodiscard]] std::uint32_t IndexerQueryDim() const noexcept {
+    return indexer_heads * indexer_head_dim;
+  }
+  [[nodiscard]] bool IsDsaLayer(std::uint32_t layer) const noexcept {
+    return layer < dsa_layer.size() && dsa_layer[layer];
+  }
+  [[nodiscard]] bool IsDenseFfnLayer(std::uint32_t layer) const noexcept {
+    return layer < dense_lead;
+  }
+  /// DSA trunk layers (11) and KDA trunk layers (34).
+  [[nodiscard]] std::uint32_t DsaLayerCount() const noexcept;
+  [[nodiscard]] std::uint32_t KdaLayerCount() const noexcept;
+
+  /// Parses and validates the trunk configuration. `error_msg` names the
+  /// first rejected key. The nextn block's presence is recorded but its
+  /// tensors are bound separately.
+  [[nodiscard]] static std::optional<Config> FromGguf(
+      const core::GgufReader& gguf, std::string* error_msg = nullptr);
+};
+
+}  // namespace gufo::models::glm5_next
+
+#endif  // GUFO_MODELS_GLM5_NEXT_CONFIG_HPP_
diff --git a/src/models/glm5_next/distributed/tp_partition.cpp b/src/models/glm5_next/distributed/tp_partition.cpp
