+
+std::string Chunked(const std::vector<std::string>& pieces) {
+  std::string out;
+  for (const std::string& piece : pieces) {
+    char size[2 * sizeof(std::size_t) + 1];
+    const auto result =
+        std::to_chars(size, size + sizeof(size), piece.size(), 16);
+    out.append(size, static_cast<std::size_t>(result.ptr - size));
+    out.append("\r\n");
+    out.append(piece);
+    out.append("\r\n");
+  }
+  out.append("0\r\n\r\n");
+  return out;
+}
