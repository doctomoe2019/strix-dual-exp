+  constexpr std::size_t kMaxTrailerBytes = 8192;
+  const auto refill = [&]() {
+    char chunk[16384];
+    const ssize_t count = ::read(fd, chunk, sizeof(chunk));
+    if (count <= 0)
+      return false;
+    buffered.append(chunk, static_cast<std::size_t>(count));
+    return true;
+  };
+  const auto line = [&]() -> std::optional<std::size_t> {
+    for (;;) {
+      const auto end = buffered.find("\r\n");
+      if (end != std::string::npos)
+        return end;
+      if (buffered.size() > kMaxLineBytes || !refill())
+        return std::nullopt;
+    }
+  };
+  for (;;) {
+    const auto end = line();
+    if (!end || *end > kMaxLineBytes)
+      return ChunkedStatus::kMalformed;
+    const auto extension = buffered.find(';');
+    const auto digits = std::min(extension, *end);
+    std::uint64_t size = 0;
+    const auto [next, error] =
+        std::from_chars(buffered.data(), buffered.data() + digits, size, 16);
+    if (digits == 0 || error != std::errc{} || next != buffered.data() + digits)
+      return ChunkedStatus::kMalformed;
+    buffered.erase(0, *end + 2);
+    if (size == 0) {
+      std::size_t trailers = 0;
+      for (;;) {
+        const auto trailer = line();
+        if (!trailer || *trailer > kMaxLineBytes ||
+            *trailer + 2 > kMaxTrailerBytes - trailers)
+          return ChunkedStatus::kMalformed;
+        trailers += *trailer + 2;
+        buffered.erase(0, *trailer + 2);
+        if (*trailer == 0)
+          return ChunkedStatus::kComplete;
+      }
+    }
+    if (size > max_bytes - body.size() ||
+        size > std::numeric_limits<std::size_t>::max() - 2)
+      return ChunkedStatus::kTooLarge;
+    while (buffered.size() < size + 2)
+      if (!refill())
+        return ChunkedStatus::kDisconnected;
+    if (buffered[size] != '\r' || buffered[size + 1] != '\n')
+      return ChunkedStatus::kMalformed;
