+// ---------------------------------------------------------------------------
+// Chunked request bodies (RFC 9112 section 7.1)
+// ---------------------------------------------------------------------------
+
+enum class ChunkedStatus { kComplete, kMalformed, kTooLarge, kDisconnected };
+
+int HexValue(char c) noexcept {
+  if (c >= '0' && c <= '9')
+    return c - '0';
+  if (c >= 'a' && c <= 'f')
+    return c - 'a' + 10;
+  if (c >= 'A' && c <= 'F')
+    return c - 'A' + 10;
+  return -1;
+}
+
+// Decodes one chunked request body. `buffered` holds the bytes already read
+// past the header terminator and is refilled from the socket as needed; the
+// decoded content appends to `body`, never exceeding `max_bytes`. Size and
+// trailer lines stay bounded so a peer cannot stream an unterminated line
+// indefinitely (sections 7.1.1/7.1.2).
+ChunkedStatus ReadChunkedBody(int fd, std::string& buffered, std::string& body,
+                              std::size_t max_bytes) {
