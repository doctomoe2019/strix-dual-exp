+  constexpr std::uint32_t kMaxChunks = 10;  // 4 x 2560 / 4 / kThreads
+  // The local and peer block rows staged once: every stream's chunk walk
+  // re-reads the same hidden element four times, and the rows of a launch
+  // far exceed the caches, so the repeated reads go to DRAM. Staged copies
+  // carry the same bytes, so every result stays bit for bit.
+  constexpr std::uint32_t kMaxRow4 = 640;  // 2560 / 4
