+
+namespace gufo::models::glm5_next {
+
+/// Non-owning view of one GGUF tensor, in the qwen38 convention: cols
+/// (ne[0]) is the contiguous reduction dimension, rows (ne[1]) the output
+/// dimension, and `experts` (ne[2]) stacks whole matrices (routed experts
+/// or per-head matrices). Trailing singleton dimensions are folded into
+/// rows, so the KDA convolutions' [kernel, 1, channels] become
+/// cols = kernel, rows = channels.
+struct TensorRef {
+  const void* data{nullptr};
+  core::GgmlType type{core::GgmlType::kF32};
+  std::uint64_t cols{0};
+  std::uint64_t rows{1};
+  std::uint64_t experts{1};
+  std::uint64_t file_offset{0};  ///< Byte offset inside the owning shard.
+  std::uint32_t shard{0};        ///< Mapped region index in the reader.
+  std::string_view name;
+
+  [[nodiscard]] bool empty() const noexcept { return data == nullptr; }
+  /// Encoded bytes of one row (`cols` elements) in this format.
+  [[nodiscard]] std::size_t RowBytes() const noexcept;
+  [[nodiscard]] std::size_t SizeBytes() const noexcept {
+    return RowBytes() * rows * experts;
+  }
+  /// Base address of one stacked expert (or head) matrix.
+  [[nodiscard]] const std::uint8_t* Expert(std::uint64_t e) const noexcept {
+    return static_cast<const std::uint8_t*>(data) + RowBytes() * rows * e;
+  }
+};
+
+/// One mHC mixer projection set (attention or FFN); fn is
+/// [hc_dim -> (2 + hc) * hc], base [(2 + hc) * hc], scale [3].
+struct HcWeights {
+  TensorRef fn;
+  TensorRef base;
+  TensorRef scale;
+};
+
+/// KDA linear-attention tensors of one trunk layer.
+struct KdaWeights {
+  TensorRef q;       ///< [hidden -> heads * kda_head_dim]
+  TensorRef k;       ///< [hidden -> heads * kda_head_dim]
+  TensorRef v;       ///< [hidden -> heads * kda_head_dim]
+  TensorRef out;     ///< [heads * kda_head_dim -> hidden]
+  TensorRef conv_q;  ///< [kernel, channels] (rows = inner dim)
+  TensorRef conv_k;
+  TensorRef conv_v;
+  TensorRef f_a;      ///< [hidden -> kda_head_dim]
+  TensorRef f_b;      ///< [kda_head_dim -> inner]
+  TensorRef g_a;      ///< [hidden -> kda_head_dim]
+  TensorRef g_b;      ///< [kda_head_dim -> inner]
+  TensorRef beta;     ///< [hidden -> heads]
+  TensorRef a;        ///< [heads] = -exp(A_log) equivalent raw values
+  TensorRef dt_bias;  ///< [inner]
+  TensorRef o_norm;   ///< [kda_head_dim]
+};
+
+/// Nope-only MLA tensors of one DSA layer.
+struct DsaWeights {
+  TensorRef q_a;        ///< [hidden -> q_lora_rank]
+  TensorRef q_a_norm;   ///< [q_lora_rank]
+  TensorRef q_b;        ///< [q_lora_rank -> heads * qk_nope_head_dim]
+  TensorRef kv_a;       ///< [hidden -> kv_lora_rank], the retained latent
+  TensorRef kv_a_norm;  ///< [kv_lora_rank]
+  /// Absorbed layout [qk_nope_head_dim, kv_lora_rank] per head: row r
+  /// holds the query-side contributions of latent element r, so the score
+  /// runs as (k_b @ q) . latent without materializing keys.
+  TensorRef k_b;
+  /// Plain projection [kv_lora_rank -> v_head_dim] per head, applied to
+  /// the attention output in latent space (row j of head h reduces over
+  /// the kv_lora_rank columns).
+  TensorRef v_b;
+  TensorRef out;  ///< [heads * v_head_dim -> hidden]
+};
+
+/// DSA indexer tensors; the pooled-key producers are replicated and their
+/// caches shared, so the plan never splits these.
+struct IndexerWeights {
+  TensorRef q_b;     ///< [q_lora_rank -> heads * indexer_head_dim]
+  TensorRef k;       ///< [hidden -> indexer_head_dim]
+  TensorRef k_norm;  ///< [indexer_head_dim]
+  TensorRef k_norm_bias;
+  TensorRef proj;       ///< [hidden -> indexer_heads]
+  TensorRef comp_gate;  ///< [hidden -> indexer_head_dim]
+  TensorRef comp_ape;   ///< [indexer_head_dim, kpool]
+};
+
+struct LayerWeights {
+  /// True on KDA (linear-attention) layers; DSA layers carry the MLA and
+  /// indexer sets below.
+  bool linear{false};
+  TensorRef attn_norm;  ///< [hidden]
+  TensorRef ffn_norm;   ///< [hidden]
+  HcWeights hc_attn;
+  HcWeights hc_ffn;
+  KdaWeights kda;
+  DsaWeights dsa;
+  IndexerWeights indexer;  ///< DSA layers only
+
+  bool dense_ffn{false};
+  TensorRef ffn_gate;  ///< [hidden -> dense_ffn]
+  TensorRef ffn_up;
+  TensorRef ffn_down;  ///< [dense_ffn -> hidden]
+
+  TensorRef router;       ///< [hidden -> expert_count] F32
+  TensorRef router_bias;  ///< [expert_count] F32, noaux_tc correction
+  TensorRef gate_exps;    ///< [hidden -> expert_ffn] x experts
+  TensorRef up_exps;
+  TensorRef down_exps;   ///< [expert_ffn -> hidden] x experts
+  TensorRef gate_shexp;  ///< [hidden -> expert_ffn * shared_experts]
+  TensorRef up_shexp;
+  TensorRef down_shexp;  ///< [expert_ffn * shared_experts -> hidden]
+};
+
+/// The nextn (MTP) block: one extra DSA layer plus its own projections.
+/// The first-leg AR loader skips it; binding keeps the inventory honest.
+struct NextnWeights {
+  TensorRef eh_proj;           ///< [2 * hidden -> hidden]
+  TensorRef enorm;             ///< [hidden]
+  TensorRef hnorm;             ///< [hidden]
+  TensorRef shared_head_norm;  ///< [hidden]
+  LayerWeights block;
+};
+
+struct ModelWeights {
+  Config config;
+  TensorRef token_embd;              ///< [hidden -> vocab]
+  TensorRef output;                  ///< [hidden -> vocab]
+  TensorRef output_norm;             ///< [hidden]
+  std::vector<LayerWeights> layers;  // Trunk layers.
+  std::optional<NextnWeights> nextn;
+
+  /// Binds and validates the artifact against the configuration. Tensor
+  /// payloads stay mapped and untouched; only headers are read. Names and
+  /// shapes follow the pinned artifact census (see the plan's inventory),
+  /// which differs from llama.cpp's arch mapping in places; the artifact
+  /// is authoritative.
+  [[nodiscard]] static std::optional<ModelWeights> Bind(
+      const core::GgufReader& reader, std::string* error_msg = nullptr);
+};
+
+}  // namespace gufo::models::glm5_next
+
+#endif  // GUFO_MODELS_GLM5_NEXT_WEIGHTS_HPP_
