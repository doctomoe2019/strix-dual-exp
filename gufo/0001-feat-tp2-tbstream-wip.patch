+/// Host-side mirror of IsSub16DecodedQuant's format set for launcher
+/// dispatch (the device helper is __device__-only).
+bool IsSub16Host(core::GgmlType t) noexcept {
+  return t == core::GgmlType::kQ4_K || t == core::GgmlType::kQ5_K ||
+         t == core::GgmlType::kQ6_K || t == core::GgmlType::kQ3_K ||
+         t == core::GgmlType::kIQ4_NL || t == core::GgmlType::kIQ4_XS ||
+         t == core::GgmlType::kIQ3_S;
+}
+
+void BatchQ8KBlockGEMV(const void* w, WeightType type, const float* x, float* y,
+                       std::uint32_t tokens, std::uint32_t m, std::uint32_t k,
+                       hipStream_t stream, std::size_t y_stride) {
+  const auto ggml_type =
+      static_cast<gufo::core::GgmlType>(static_cast<std::uint32_t>(type));
+  if (ggml_type == gufo::core::GgmlType::kQ8_0 || IsSub16Host(ggml_type)) {
+    const std::uint32_t rows_per_block = kQuantWarps * kQuantRows;
+    if (m % rows_per_block != 0) {
+      // The tiled kernel's staging/barrier collective requires blocks of
+      // whole row groups; exotic row counts fall back to the wave GEMV.
+      const dim3 grid((m + kGemmWaves - 1) / kGemmWaves, tokens);
+      BatchQ8KKernel<kGemmWaves><<<grid, kGemmWaves * 32, 0, stream>>>(
+          w, static_cast<std::uint32_t>(type), x, y, m, k,
+          y_stride != 0 ? y_stride : m);
+      return;
+    }
+    const dim3 grid(m / rows_per_block,
+                    (tokens + kQuantTokens - 1) / kQuantTokens);
+    BatchQuantTiledKernel<<<grid, kQuantWarps * 32, 0, stream>>>(
+        w, static_cast<std::uint32_t>(type), x, y, m, k, tokens,
+        y_stride != 0 ? y_stride : m);
+    return;
+  }
+  const dim3 grid((m + kGemmWaves - 1) / kGemmWaves, tokens);
+  BatchQ8KKernel<kGemmWaves><<<grid, kGemmWaves * 32, 0, stream>>>(
+      w, static_cast<std::uint32_t>(type), x, y, m, k,
+      y_stride != 0 ? y_stride : m);
+}
