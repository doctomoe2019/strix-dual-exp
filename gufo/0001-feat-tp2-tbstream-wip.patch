+      parse(R"({"text":"\n雪 <tool_call>literal</tool_call>\n",
+    "count":2,"nested":{"flag":true,"tags":["</arg_value>","<think>"]}})");
+  const auto call =
+      std::string("<tool_call>record<arg_key>text</arg_key><arg_value>") +
+      arguments.find("text")->str() +
+      "</arg_value><arg_key>count</arg_key><arg_value>2</arg_value>"
+      "<arg_key>nested</arg_key><arg_value>" +
+      arguments.find("nested")->dump() + "</arg_value></tool_call>";
+  // Each API takes the same declared schema and emits typed arguments, with
+  // native delimiters confined to framing. Split every delimiter/UTF-8 byte.
+  for (const bool responses : {false, true}) {
+    for (const std::size_t pieces :
+         {std::size_t{0}, std::size_t{1}, std::size_t{37}}) {
+      const bool stream = pieces != 0;
+      server.backend->piece_bytes = pieces;
+      server.backend->SetOutput("plan</think>" + call);
+      auto body = gufo::json::Value::object();
+      body["model"] = "test";
+      body["stream"] = stream;
+      body["tool_choice"] = "required";
+      body["tools"] = gufo::json::Value::array();
+      auto tool = gufo::json::Value::object();
+      tool["type"] = "function";
+      auto definition = gufo::json::Value::object();
+      definition["name"] = "record";
+      definition["parameters"] = schema;
+      if (responses) {
+        tool["name"] = "record";
+        tool["parameters"] = schema;
+        body["input"] = "record it";
+      } else {
+        tool["function"] = definition;
+        body["messages"] = parse(R"([{"role":"user","content":"record it"}])");
+      }
+      body["tools"].push_back(tool);
+      const auto response = server.Post(
+          responses ? "/v1/responses" : "/v1/chat/completions", body.dump());
+      ExpectStatus(response, 200);
+      const auto actual_sampling = server.backend->LastCall().sampling;
+      assert(actual_sampling.temperature == 1.0F &&
+             actual_sampling.top_p == 0.95F && actual_sampling.top_k == 0);
+      std::string emitted_arguments;
+      std::string content;
+      std::string reasoning;
+      if (!stream) {
+        const auto output =
+            parse(response.substr(response.find("\r\n\r\n") + 4));
+        if (responses) {
+          for (const auto& item : output.find("output")->items()) {
+            if (item.member_str("type") == "function_call") {
+              assert(item.member_str("name") == "record");
+              emitted_arguments = item.member_str("arguments");
+            }
+          }
+        } else {
+          const auto& message =
+              *output.find("choices")->items()[0].find("message");
+          assert(output.find("choices")->items()[0].member_str(
+                     "finish_reason") == "tool_calls");
+          const auto& function =
+              *message.find("tool_calls")->items()[0].find("function");
+          assert(function.member_str("name") == "record");
+          emitted_arguments = function.member_str("arguments");
+          assert(message.member_str("reasoning_content") == "plan");
+        }
+      } else {
+        std::size_t at = 0;
+        while ((at = response.find("data: ", at)) != std::string::npos) {
+          const auto end = response.find('\n', at);
+          const auto data = response.substr(at + 6, end - at - 6);
+          at = end;
+          if (data == "[DONE]")
