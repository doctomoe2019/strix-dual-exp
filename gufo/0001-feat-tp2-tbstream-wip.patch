+
+void Require(bool condition, const std::string& message) {
+  if (!condition) {
+    std::fprintf(stderr, "FAIL: %s\n", message.c_str());
+    std::exit(1);
+  }
+}
+
+glm::TensorRef Ref(GgmlType type, std::uint64_t cols, std::uint64_t rows,
+                   std::uint64_t experts, const char* name) {
+  return glm::TensorRef{reinterpret_cast<const void*>(0x1000),
+                        type,
+                        cols,
+                        rows,
+                        experts,
+                        0,
+                        0,
+                        name};
+}
+
+glm::Config RealConfig() {
+  glm::Config c;
+  c.num_layers = 45;
+  c.hidden_size = 4096;
+  c.vocab_size = 154880;
+  c.head_count = 64;
+  c.q_lora_rank = 1536;
+  c.kv_lora_rank = 512;
+  c.qk_nope_head_dim = 256;
+  c.v_head_dim = 256;
+  c.kda_head_dim = 128;
+  c.kda_conv_kernel = 4;
+  c.indexer_heads = 32;
+  c.indexer_head_dim = 128;
+  c.indexer_kpool = 4;
+  c.hc_count = 4;
+  c.dense_lead = 1;
+  c.dense_ffn = 12288;
+  c.expert_count = 288;
+  c.experts_used = 8;
+  c.shared_experts = 1;
+  c.expert_ffn = 2048;
+  c.dsa_layer = {false, true};
+  c.num_layers = 2;
+  return c;
+}
+
+// One dense KDA layer and one sparse DSA layer with the artifact's real
+// dimensions and encodings (mirrors the tp_plan fixture).
+glm::ModelWeights TwoLayerWeights() {
+  glm::ModelWeights w;
+  w.config = RealConfig();
+  const auto hidden = w.config.hidden_size;
+  const auto inner = w.config.KdaInnerDim();
+  const auto query = w.config.MlaQueryDim();
+  const auto head_dim = w.config.kda_head_dim;
+  const auto expert_ff = w.config.expert_ffn;
+  const auto experts = w.config.expert_count;
+
+  w.token_embd = Ref(GgmlType::kQ8_0, hidden, w.config.vocab_size, 1, "embd");
+  w.output = Ref(GgmlType::kQ8_0, hidden, w.config.vocab_size, 1, "output");
+  w.output_norm = Ref(GgmlType::kF32, hidden, 1, 1, "output_norm");
+  w.layers.resize(2);
+
+  glm::LayerWeights& kda = w.layers[0];
+  kda.linear = true;
+  kda.attn_norm = Ref(GgmlType::kF32, hidden, 1, 1, "attn_norm");
+  kda.ffn_norm = Ref(GgmlType::kF32, hidden, 1, 1, "ffn_norm");
+  kda.hc_attn.fn =
+      Ref(GgmlType::kF32, w.config.HcDim(), w.config.HcMixDim(), 1, "hc_fn");
+  kda.hc_attn.base = Ref(GgmlType::kF32, w.config.HcMixDim(), 1, 1, "hc_base");
+  kda.hc_attn.scale = Ref(GgmlType::kF32, 3, 1, 1, "hc_scale");
+  kda.hc_ffn = kda.hc_attn;
+  kda.kda.q = Ref(GgmlType::kQ8_0, hidden, inner, 1, "kda_q");
+  kda.kda.k = Ref(GgmlType::kQ8_0, hidden, inner, 1, "kda_k");
+  kda.kda.v = Ref(GgmlType::kQ8_0, hidden, inner, 1, "kda_v");
+  kda.kda.out = Ref(GgmlType::kQ8_0, inner, hidden, 1, "kda_out");
+  kda.kda.conv_q = Ref(GgmlType::kF32, 4, inner, 1, "conv_q");
+  kda.kda.conv_k = Ref(GgmlType::kF32, 4, inner, 1, "conv_k");
+  kda.kda.conv_v = Ref(GgmlType::kF32, 4, inner, 1, "conv_v");
+  kda.kda.f_a = Ref(GgmlType::kF32, hidden, head_dim, 1, "f_a");
+  kda.kda.f_b = Ref(GgmlType::kF32, head_dim, inner, 1, "f_b");
+  kda.kda.g_a = Ref(GgmlType::kF32, hidden, head_dim, 1, "g_a");
+  kda.kda.g_b = Ref(GgmlType::kF32, head_dim, inner, 1, "g_b");
+  kda.kda.beta = Ref(GgmlType::kF32, hidden, 64, 1, "beta");
+  kda.kda.a = Ref(GgmlType::kF32, 64, 1, 1, "a");
+  kda.kda.dt_bias = Ref(GgmlType::kF32, inner, 1, 1, "dt");
+  kda.kda.o_norm = Ref(GgmlType::kF32, head_dim, 1, 1, "o_norm");
+  kda.dense_ffn = true;
+  kda.ffn_gate =
+      Ref(GgmlType::kQ8_0, hidden, w.config.dense_ffn, 1, "ffn_gate");
+  kda.ffn_up = Ref(GgmlType::kQ8_0, hidden, w.config.dense_ffn, 1, "ffn_up");
+  kda.ffn_down =
+      Ref(GgmlType::kQ8_0, w.config.dense_ffn, hidden, 1, "ffn_down");
+
+  glm::LayerWeights& dsa = w.layers[1];
+  dsa.linear = false;
+  dsa.attn_norm = kda.attn_norm;
+  dsa.ffn_norm = kda.ffn_norm;
+  dsa.hc_attn = kda.hc_attn;
+  dsa.hc_ffn = kda.hc_ffn;
+  dsa.dsa.q_a = Ref(GgmlType::kQ8_0, hidden, w.config.q_lora_rank, 1, "q_a");
+  dsa.dsa.q_a_norm =
+      Ref(GgmlType::kF32, w.config.q_lora_rank, 1, 1, "q_a_norm");
+  dsa.dsa.q_b = Ref(GgmlType::kQ8_0, w.config.q_lora_rank, query, 1, "q_b");
+  dsa.dsa.kv_a = Ref(GgmlType::kF32, hidden, w.config.kv_lora_rank, 1, "kv_a");
+  dsa.dsa.kv_a_norm =
+      Ref(GgmlType::kF32, w.config.kv_lora_rank, 1, 1, "kv_a_norm");
+  dsa.dsa.k_b = Ref(GgmlType::kF32, w.config.qk_nope_head_dim,
+                    w.config.kv_lora_rank, 64, "k_b");
+  dsa.dsa.v_b = Ref(GgmlType::kF32, w.config.kv_lora_rank, w.config.v_head_dim,
+                    64, "v_b");
+  dsa.dsa.out = Ref(GgmlType::kQ8_0, query, hidden, 1, "dsa_out");
+  dsa.indexer.q_b = Ref(GgmlType::kF32, w.config.q_lora_rank,
+                        w.config.IndexerQueryDim(), 1, "idx_q");
+  dsa.indexer.k =
+      Ref(GgmlType::kF32, hidden, w.config.indexer_head_dim, 1, "idx_k");
+  dsa.indexer.k_norm =
+      Ref(GgmlType::kF32, w.config.indexer_head_dim, 1, 1, "idx_k_norm");
+  dsa.indexer.k_norm_bias =
+      Ref(GgmlType::kF32, w.config.indexer_head_dim, 1, 1, "idx_k_norm_b");
+  dsa.indexer.proj =
+      Ref(GgmlType::kF32, hidden, w.config.indexer_heads, 1, "idx_proj");
+  dsa.indexer.comp_gate =
+      Ref(GgmlType::kF32, hidden, w.config.indexer_head_dim, 1, "idx_gate");
+  dsa.indexer.comp_ape = Ref(GgmlType::kF32, w.config.indexer_head_dim,
+                             w.config.indexer_kpool, 1, "idx_ape");
+  dsa.router = Ref(GgmlType::kF32, hidden, experts, 1, "router");
+  dsa.router_bias = Ref(GgmlType::kF32, experts, 1, 1, "router_bias");
+  dsa.gate_exps = Ref(GgmlType::kQ4_K, hidden, expert_ff, experts, "gate_exps");
+  dsa.up_exps = Ref(GgmlType::kQ4_K, hidden, expert_ff, experts, "up_exps");
+  dsa.down_exps = Ref(GgmlType::kQ4_K, expert_ff, hidden, experts, "down_exps");
+  dsa.gate_shexp = Ref(GgmlType::kQ8_0, hidden, expert_ff, 1, "gate_shexp");
+  dsa.up_shexp = Ref(GgmlType::kQ8_0, hidden, expert_ff, 1, "up_shexp");
+  dsa.down_shexp = Ref(GgmlType::kQ8_0, expert_ff, hidden, 1, "down_shexp");
+  return w;
+}
+
+const glm::distributed::PlannedTensor* Find(
+    const std::vector<glm::distributed::PlannedTensor>& plan,
+    const char* name) {
+  for (const auto& entry : plan) {
+    if (entry.tensor->name == name) {
+      return &entry;
+    }
+  }
+  return nullptr;
+}
+
+}  // namespace
+
+int main() {
+  std::string error;
+  auto weights = TwoLayerWeights();
+
+  const auto part0 = TpPartition::Create(weights.config, 0, 2, &error);
+  const auto part1 = TpPartition::Create(weights.config, 1, 2, &error);
+  Require(part0.has_value() && part1.has_value(), error);
+  Require(part0->head_begin == 0 && part0->head_count == 32, "rank 0 heads");
+  Require(part1->head_begin == 32 && part1->head_count == 32, "rank 1 heads");
+  Require(part0->KdaChannelBegin() == 0 && part0->KdaChannelCount() == 4096,
+          "rank 0 KDA channels");
+  Require(part1->KdaChannelBegin() == 4096, "rank 1 KDA channels");
+  Require(part0->expert_ff_begin == 0 && part0->expert_ff_count == 1024,
+          "rank 0 expert rows");
+  Require(part1->expert_ff_begin == 1024, "rank 1 expert rows");
+  Require(part0->dense_ff_count == 6144, "dense intermediate splits");
+
+  const auto single = TpPartition::Create(weights.config, 0, 1, &error);
+  Require(single.has_value(), error);
+
+  auto plan0 = PlanModelTensors(weights, *part0, &error);
+  auto plan1 = PlanModelTensors(weights, *part1, &error);
+  Require(plan0.has_value(), error);
+  Require(plan1.has_value(), error);
+  Require(plan0->size() == plan1->size(), "both ranks plan every tensor");
+
+  // Every split axis is covered exactly, disjointly, by the two ranks, and
+  // replicated tensors carry whole-tensor bytes.
+  std::size_t local0 = 0;
+  std::size_t local1 = 0;
+  for (std::size_t i = 0; i < plan0->size(); ++i) {
+    const auto& a = (*plan0)[i];
+    const auto& b = (*plan1)[i];
+    Require(a.tensor == b.tensor, "plans walk the same tensors in order");
+    const auto& span_a = a.span;
+    const auto& span_b = b.span;
+    local0 += span_a.local_bytes;
+    local1 += span_b.local_bytes;
+    Require(
+        span_a.kind == span_b.kind && span_a.per_expert == span_b.per_expert,
+        std::string(a.tensor->name) + ": ranks agree on the span kind");
+    const glm::TensorRef& t = *a.tensor;
+    switch (span_a.kind) {
+      case glm::distributed::TensorSpanKind::kFull:
+        Require(span_a.local_bytes == t.SizeBytes() &&
+                    span_b.local_bytes == t.SizeBytes(),
+                std::string(t.name) + ": replicated bytes");
+        break;
+      case glm::distributed::TensorSpanKind::kRows:
+      case glm::distributed::TensorSpanKind::kColumns:
+      case glm::distributed::TensorSpanKind::kStack:
+      case glm::distributed::TensorSpanKind::kElements:
+        Require(span_a.begin + span_a.count == span_b.begin,
+                std::string(t.name) + ": spans are adjacent");
+        Require(span_a.count == span_b.count,
+                std::string(t.name) + ": spans are equal");
+        Require(span_a.local_bytes == span_b.local_bytes,
+                std::string(t.name) + ": split bytes are equal");
+        break;
+    }
+  }
+
+  // The per-rank encoded total must equal the P0 ledger's per-rank bytes.
+  const auto ledger = PlanTpLedger(weights, 2, &error);
+  Require(ledger.has_value(), error);
+  Require(local0 == ledger->PerRankBytes(2),
+          "descriptor walk matches the TP ledger per-rank bytes");
+  Require(local0 == local1, "both ranks hold the same encoded bytes");
+
+  // The single-rank plan is the whole model.
+  const auto plan_single = PlanModelTensors(weights, *single, &error);
+  Require(plan_single.has_value(), error);
+  std::size_t single_bytes = 0;
+  for (const auto& entry : *plan_single) {
+    single_bytes += entry.span.local_bytes;
+    Require(entry.span.kind == glm::distributed::TensorSpanKind::kFull,
+            std::string(entry.tensor->name) + ": single rank holds all");
+  }
+  Require(single_bytes == ledger->FullArBytes(),
+          "single-rank plan covers the full AR bytes");
+
+  // Geometry spot checks on the axes the loader uploads.
+  using TK = glm::distributed::TensorSpanKind;
+  const auto* conv = Find(*plan0, "conv_q");
+  Require(conv != nullptr && conv->span.kind == TK::kRows &&
+              conv->span.begin == 0 && conv->span.count == 4096 &&
+              conv->span.local_bytes == 4096 * 4 * sizeof(float),
+          "KDA conv splits by channel rows");
+  const auto* dt = Find(*plan1, "dt");
+  Require(dt != nullptr && dt->span.kind == TK::kElements &&
+              dt->span.begin == 4096 && dt->span.count == 4096,
+          "KDA dt bias splits by channel elements");
+  const auto* beta = Find(*plan1, "beta");
+  Require(beta != nullptr && beta->span.kind == TK::kRows &&
+              beta->span.begin == 32 && beta->span.count == 32,
+          "KDA beta splits by head rows");
+  const auto* a_vec = Find(*plan0, "a");
+  Require(a_vec != nullptr && a_vec->span.kind == TK::kElements &&
+              a_vec->span.begin == 0 && a_vec->span.count == 32,
+          "KDA decay a splits by head elements");
+  const auto* q_b = Find(*plan1, "q_b");
+  Require(q_b != nullptr && q_b->span.kind == TK::kRows &&
+              q_b->span.begin == 32U * 256U && q_b->span.count == 32U * 256U,
+          "MLA q_b splits by head query rows");
+  const auto* k_b = Find(*plan0, "k_b");
+  Require(k_b != nullptr && k_b->span.kind == TK::kStack &&
+              k_b->span.begin == 0 && k_b->span.count == 32 &&
+              k_b->span.local_bytes == 256 * 512 * sizeof(float) * 32,
+          "k_b keeps whole head matrices");
+  const auto* gate = Find(*plan1, "gate_exps");
+  Require(gate != nullptr && gate->span.kind == TK::kRows &&
+              gate->span.per_expert && gate->span.begin == 1024 &&
+              gate->span.count == 1024,
+          "expert gate rows repeat inside every expert");
+  const auto* down = Find(*plan0, "down_exps");
+  // Q4_K: 1024 columns = 4 super-blocks of 144 bytes per row.
+  Require(down != nullptr && down->span.kind == TK::kColumns &&
+              down->span.per_expert && down->span.begin == 0 &&
+              down->span.count == 1024 &&
+              down->span.local_bytes ==
+                  static_cast<std::size_t>(4 * 144) * 4096 * 288,
+          "expert down columns halve on super-block boundaries");
+  const auto* idx = Find(*plan1, "idx_proj");
+  Require(idx != nullptr && idx->span.kind == TK::kFull,
+          "indexer tensors stay replicated");
+
+  // A split that would cut a quantization block is rejected: an expert
+  // intermediate of 384 gives 192 columns per rank (Q4_K needs 256).
+  auto bad = TwoLayerWeights();
+  bad.config.expert_ffn = 384;
+  bad.layers[1].gate_exps = Ref(GgmlType::kQ4_K, 4096, 384, 288, "gate_exps");
+  bad.layers[1].up_exps = Ref(GgmlType::kQ4_K, 4096, 384, 288, "up_exps");
+  bad.layers[1].down_exps = Ref(GgmlType::kQ4_K, 384, 4096, 288, "down_exps");
+  const auto bad_part = TpPartition::Create(bad.config, 0, 2, &error);
+  if (bad_part.has_value()) {
+    Require(!PlanModelTensors(bad, *bad_part, &error).has_value(),
+            "a split that cuts a quantization block is rejected");
+  }
+
+  // Odd heads are rejected at partition creation.
+  auto odd = TwoLayerWeights();
+  odd.config.head_count = 63;
+  Require(!TpPartition::Create(odd.config, 0, 2, &error).has_value(),
+          "an odd head count is rejected");
+
+  std::printf("PASS: glm5_next TP partition descriptors (per-rank %zu bytes)\n",
+              local0);
+  return 0;
+}
