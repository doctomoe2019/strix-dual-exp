diff --git a/tests/models/glm5_next/batch_select_test.cpp b/tests/models/glm5_next/batch_select_test.cpp
new file mode 100644
index 0000000..eb062b9
--- /dev/null
+++ b/tests/models/glm5_next/batch_select_test.cpp
@@ -0,0 +1,229 @@
+// Host-vs-device contract for the tiled batch pool selector: the batched
+// top-cut must equal the host stable sort exactly (score descending, lower
+// pool index on ties, signed-zero normalized) for every query row, at any
+// pool count the scores buffer holds. Pure HIP test — no model weights.
+#include <hip/hip_runtime.h>
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <numeric>
+#include <random>
+#include <string>
+#include <vector>
+
+#include "src/models/glm5_next/kernels/rocm/kernels_batch.hpp"
+
+namespace {
+
+int failures = 0;
+
+void Fail(const std::string& message) {
+  std::fprintf(stderr, "FAIL: %s\n", message.c_str());
+  ++failures;
+}
+
+struct DeviceRow {
+  float* scores;
+  std::int32_t* sel;
+  std::uint32_t* counts;
+};
+
+#define HIP_CHECK(expr)                                                   \
+  do {                                                                    \
+    if ((expr) != hipSuccess) {                                           \
+      Fail(std::string("HIP error at line ") + std::to_string(__LINE__)); \
+      return false;                                                       \
+    }                                                                     \
+  } while (false)
+
+bool CheckWidth(const DeviceRow& device, std::uint32_t pools,
+                std::uint32_t select_pools, std::uint32_t kpool,
+                std::uint32_t seen_base, std::uint32_t sel_stride,
+                const std::vector<float>& scores, std::uint32_t row_ordinal) {
+  // Host reference: stable_sort descending with lower-index tie semantics,
+  // exactly the comparator the tokenwise path's SelectPools fallback uses.
+  // Only the pools visible at this query's position participate, matching
+  // the kernel's per-row pools_t cut.
+  const std::uint32_t tokens_seen = seen_base + row_ordinal;
+  const std::uint32_t pools_t = std::min(pools, tokens_seen / kpool);
+  std::vector<std::uint32_t> order(pools_t);
+  std::iota(order.begin(), order.end(), 0U);
+  std::stable_sort(
+      order.begin(), order.end(),
+      [&](std::uint32_t a, std::uint32_t b) { return scores[a] > scores[b]; });
+  const std::uint32_t select_pools_t = std::min(select_pools, pools_t);
+  const std::uint32_t tail = tokens_seen % kpool;
+  const std::uint32_t total = select_pools_t * kpool + tail;
+  std::vector<std::int32_t> expected;
+  expected.reserve(total);
+  for (std::uint32_t r = 0; r < select_pools_t; ++r) {
+    for (std::uint32_t j = 0; j < kpool; ++j) {
+      expected.push_back(static_cast<std::int32_t>(order[r] * kpool + j));
+    }
+  }
+  for (std::uint32_t j = 0; j < tail; ++j) {
+    expected.push_back(static_cast<std::int32_t>(tokens_seen - tail + j));
+  }
+  std::sort(expected.begin(), expected.end());
+
+  std::vector<std::int32_t> got(sel_stride);
+  std::uint32_t got_count = 0;
+  // The device row for tokens_seen = seen_base + row_ordinal is row
+  // (row_ordinal - 1): the kernel's query index t = row_ordinal - 1.
+  const std::size_t device_row = static_cast<std::size_t>(row_ordinal) - 1;
+  HIP_CHECK(hipMemcpy(got.data(), device.sel + device_row * sel_stride,
+                      got.size() * sizeof(std::int32_t),
+                      hipMemcpyDeviceToHost));
+  HIP_CHECK(hipMemcpy(&got_count, device.counts + device_row,
+                      sizeof(std::uint32_t), hipMemcpyDeviceToHost));
+  if (got_count != total) {
+    Fail("count " + std::to_string(got_count) + " != " + std::to_string(total) +
+         " (pools " + std::to_string(pools) + ", selected " +
+         std::to_string(select_pools) + ", base " + std::to_string(seen_base) +
+         ", row " + std::to_string(row_ordinal) + ")");
+    return false;
+  }
+  for (std::uint32_t i = 0; i < total; ++i) {
+    if (got[i] != expected[i]) {
+      std::fprintf(stderr, "got[");
+      for (std::uint32_t k = 0; k < total && k < 24; ++k) {
+        std::fprintf(stderr, " %d", got[k]);
+      }
+      std::fprintf(stderr, " ]\nexp[");
+      for (std::uint32_t k = 0; k < total && k < 24; ++k) {
+        std::fprintf(stderr, " %d", expected[k]);
+      }
+      std::fprintf(stderr, " ]\n");
+      Fail("selection[" + std::to_string(i) + "] = " + std::to_string(got[i]) +
+           " != " + std::to_string(expected[i]) + " (pools " +
+           std::to_string(pools) + ")");
+      return false;
+    }
+  }
+  return true;
+}
+
+bool RunCase(std::uint32_t pools, std::uint32_t select_pools,
+             std::uint32_t token_count, std::uint32_t seen_base, unsigned kind,
+             std::uint64_t seed) {
+  constexpr std::uint32_t kpool = 4;
+  constexpr std::uint32_t kSelStride = 2052;
+  const std::uint32_t pitch = pools == 0 ? 1024 : pools + 3;  // pad the row
+  DeviceRow device{};
+  HIP_CHECK(hipMalloc(&device.scores,
+                      static_cast<std::size_t>(std::max(1U, token_count)) *
+                          pitch * sizeof(float)));
+  HIP_CHECK(hipMalloc(&device.sel,
+                      static_cast<std::size_t>(std::max(1U, token_count)) *
+                          kSelStride * sizeof(std::int32_t)));
+  HIP_CHECK(hipMalloc(&device.counts,
+                      static_cast<std::size_t>(1) * sizeof(std::uint32_t)));
+  std::mt19937_64 rng(seed);
+  std::vector<float> scores(pitch);
+  for (std::uint32_t i = 0; i < pools; ++i) {
+    switch (kind) {
+      case 0:
+        scores[i] = static_cast<float>(rng() % 1000003U) / 1000003.0F;
+        break;
+      case 1:
+        scores[i] = 0.0F;  // every score ties
+        break;
+      case 2:
+        scores[i] = (i % 2 == 0) ? -0.0F : 0.0F;  // signed-zero ties
+        break;
+      case 3:
+        scores[i] = static_cast<float>(i % 7);  // heavy plateau ties
+        break;
+      default:
+        scores[i] = 1.0F;  // constant
+        break;
+    }
+  }
+  HIP_CHECK(hipMemcpy(device.scores, scores.data(),
+                      scores.size() * sizeof(float), hipMemcpyHostToDevice));
+  if (!gufo::models::glm5_next::rocm::BatchSelectPools(
+          device.scores, pitch, 1, pools, select_pools, kpool, seen_base,
+          kSelStride, device.sel, device.counts, nullptr)) {
+    Fail("wrapper rejected a legal case (pools " + std::to_string(pools) + ")");
+  }
+  HIP_CHECK(hipDeviceSynchronize());
+  if (!CheckWidth(device, pools, select_pools, kpool, seen_base, kSelStride,
+                  scores, token_count)) {
+    return false;
+  }
+  HIP_CHECK(hipFree(device.scores));
+  HIP_CHECK(hipFree(device.sel));
+  HIP_CHECK(hipFree(device.counts));
+  return true;
+}
+
+}  // namespace
+
+int main() {
+  if (hipDeviceSynchronize() != hipSuccess) {
+    Fail("no HIP device");
+    return 1;
+  }
+  // Width boundaries around the old single-tile bound and the new tiled
+  // regime, plus tiny and tail-heavy cases.
+  const std::uint32_t widths[] = {0,    1,    3,    4,     1023, 1024,
+                                  1025, 2048, 4097, 10240, 65536};
+  for (std::uint32_t pools : widths) {
+    for (unsigned kind = 0; kind < 5; ++kind) {
+      if (!RunCase(pools, std::min(pools, 512U), 1, 0, kind,
+                   0x9E3779B97F4A7C15ULL * (pools + 7) + kind)) {
+        std::fprintf(stderr, "  case pools=%u kind=%u seed full\n", pools,
+                     kind);
+      }
+      // Budget below the pool count exercises per-query min() truncation.
+      if (pools > 8 && !RunCase(pools, 8, 1, 12, kind,
+                                0x9E3779B97F4A7C15ULL * (pools + 9) + kind)) {
+        std::fprintf(stderr, "  case pools=%u kind=%u seed small-k\n", pools,
+                     kind);
+      }
+      if (failures != 0) {
+        return 1;
+      }
+    }
+  }
+  // Mid-chunk causal cuts: three rows with different visible pool counts.
+  {
+    DeviceRow device{};
+    constexpr std::uint32_t kPools = 1025;
+    constexpr std::uint32_t kPool4 = 4;
+    HIP_CHECK(hipMalloc(&device.scores, 3 * kPools * sizeof(float)));
+    HIP_CHECK(hipMalloc(&device.sel, 3 * 2052 * sizeof(std::int32_t)));
+    HIP_CHECK(hipMalloc(&device.counts, 3 * sizeof(std::uint32_t)));
+    std::mt19937_64 rng(42);
+    std::vector<float> scores(3 * kPools);
+    for (float& v : scores) {
+      v = static_cast<float>(rng() % 1000003U) / 1000003.0F;
+    }
+    HIP_CHECK(hipMemcpy(device.scores, scores.data(),
+                        scores.size() * sizeof(float), hipMemcpyHostToDevice));
+    if (!gufo::models::glm5_next::rocm::BatchSelectPools(
+            device.scores, kPools, 3, kPools, 512, kPool4, 4 * 1025, 2052,
+            device.sel, device.counts, nullptr)) {
+      Fail("multi-row wrapper rejected");
+    }
+    HIP_CHECK(hipDeviceSynchronize());
+    for (std::uint32_t t = 0; t < 3; ++t) {
+      if (!CheckWidth(
+              device, kPools, 512, kPool4, 4 * 1025, 2052,
+              std::vector<float>(
+                  scores.begin() + static_cast<ptrdiff_t>(t) * kPools,
+                  scores.begin() + static_cast<ptrdiff_t>(t + 1) * kPools),
+              t + 1)) {
+        return 1;
+      }
+    }
+    HIP_CHECK(hipFree(device.scores));
+    HIP_CHECK(hipFree(device.sel));
+    HIP_CHECK(hipFree(device.counts));
+  }
+  if (failures == 0) {
+    std::puts("PASS: glm5_next batch_select tiled contract");
+  }
+  return failures == 0 ? 0 : 1;
+}
diff --git a/tests/models/glm5_next/chat_template_test.cpp b/tests/models/glm5_next/chat_template_test.cpp
