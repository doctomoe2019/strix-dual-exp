+             "zero kda history");
+  }
+  // DSA working set and caches for the slice's one DSA layer.
+  const std::uint32_t kv_lora = c.kv_lora_rank;
+  const std::uint32_t q_lora = c.q_lora_rank;
+  const std::uint32_t idim = c.indexer_head_dim;
+  const std::uint32_t kpool = c.indexer_kpool;
+  const std::size_t max_tokens = tokens.size();
+  const std::size_t max_pools = max_tokens / kpool + 1;
+  auto* latent_raw = make(kv_lora);
+  auto* latent_normed = make(kv_lora);
+  auto* q_resid_raw = make(q_lora);
+  auto* q_resid = make(q_lora);
+  auto* idx_k_raw = make(idim);
+  auto* idx_g_raw = make(idim);
+  auto* iq = make(c.IndexerQueryDim());
+  auto* head_weights = make(c.indexer_heads);
+  auto* head_weights_raw = make(c.indexer_heads);
