+  auto* index_keys = make(max_tokens * idim);
+  auto* index_gates = make(max_tokens * idim);
+  auto* pooled_cache = make(max_pools * idim);
+  auto* selection_dev = static_cast<std::int32_t*>(
+      buffers.Make((max_tokens + c.indexer_top_k) * sizeof(std::int32_t)));
+  auto* selection_count =
+      static_cast<std::uint32_t*>(buffers.Make(sizeof(std::uint32_t)));
+  auto* counts_dev =
+      static_cast<std::uint32_t*>(buffers.Make(sizeof(std::uint32_t)));
+  // FFN working set (dense lead layers and the routed + shared MoE).
+  const std::size_t max_ffn = std::max<std::size_t>(c.dense_ffn, c.expert_ffn);
+  auto* ffn_gate_out = make(max_ffn);
+  auto* ffn_up_out = make(max_ffn);
+  auto* ffn_act = make(max_ffn);
+  auto* ffn_partial = make(hidden);
+  auto* router_logits = make(c.expert_count);
+  auto* expert_ids = static_cast<std::int32_t*>(
+      buffers.Make(c.experts_used * sizeof(std::int32_t)));
+  auto* expert_w = make(c.experts_used);
+  if (failures != 0) {
+    return 1;
+  }
+
+  double worst_mhc = 0.0;
+  double worst_block_in = 0.0;
+  double worst_collapsed = 0.0;
+  double worst_logits = 0.0;
+  double worst_kda = 0.0;
+  double worst_kda_out = 0.0;
+  double worst_dsa = 0.0;
+  double worst_ffn = 0.0;
+  std::size_t blocks_checked = 0;
+  std::size_t kda_checked = 0;
+  std::size_t dsa_checked = 0;
+  std::size_t ffn_checked = 0;
+  std::size_t gpu_selections = 0;
+  double token_ms_total = 0.0;
+  double token_ms_max = 0.0;
+
+  auto download = [&](const float* device, std::size_t count) {
+    std::vector<float> host(count);
+    CheckHip(hipMemcpy(host.data(), device, count * sizeof(float),
