+}
+
+void BatchMeanStreams(const float* streams, float* out, std::uint32_t hidden,
+                      std::uint32_t n, std::uint32_t tokens,
+                      hipStream_t stream) {
+  const dim3 grid(GridBlocks(hidden), tokens);
+  BatchMeanStreamsKernel<<<grid, kBlockThreads, 0, stream>>>(streams, out,
+                                                             hidden, n);
+}
+
+void BatchKdaConv(const float* qkv, const float* taps_q, const float* taps_k,
+                  const float* taps_v, float* history, float* conv_out,
+                  std::uint32_t tokens, std::uint32_t inner,
+                  std::uint32_t kernel, hipStream_t stream) {
+  BatchKdaConvKernel<<<GridBlocks(3 * static_cast<std::size_t>(inner)),
+                       kBlockThreads, 0, stream>>>(
+      qkv, taps_q, taps_k, taps_v, history, conv_out, tokens, inner, kernel);
+}
+
+void BatchKdaPrepare(const float* conv_out, float* qn, float* kn,
+                     std::uint32_t tokens, std::uint32_t heads,
+                     std::uint32_t dim, float l2_eps, hipStream_t stream) {
+  BatchKdaPrepareKernel<<<GridBlocks(static_cast<std::size_t>(tokens) * heads),
+                          kBlockThreads, 0, stream>>>(conv_out, qn, kn, tokens,
+                                                      heads, dim, l2_eps);
+}
+
+void BatchKdaGates(const float* raw, const float* a, const float* dt,
+                   const float* beta_row, float bound, float* gate, float* beta,
+                   std::uint32_t tokens, std::uint32_t inner, std::uint32_t dim,
+                   std::uint32_t heads, hipStream_t stream) {
+  BatchKdaGatesKernel<<<GridBlocks(static_cast<std::size_t>(tokens) * inner),
+                        kBlockThreads, 0, stream>>>(
+      raw, a, dt, beta_row, bound, gate, beta, tokens, inner, dim, heads);
+}
+
+void BatchKdaRecurrence(const float* qn, const float* kn, const float* gate,
+                        const float* beta, const float* conv_out, float* state,
+                        float* core, std::uint32_t tokens, std::uint32_t heads,
+                        std::uint32_t dim, hipStream_t stream) {
+  // The register-column fast path is the bit-identical twin of the generic
+  // kernel; only the model's kda.head_dim is compiled that way.
+  if (dim == 128) {
+    BatchKdaRecurrenceRegKernel<128><<<heads, 128, 0, stream>>>(
+        qn, kn, gate, beta, conv_out, state, core, tokens, heads);
+    return;
+  }
+  BatchKdaRecurrenceKernel<<<heads, dim, 0, stream>>>(
+      qn, kn, gate, beta, conv_out, state, core, tokens, heads, dim);
+}
+
+void BatchIndexerAppend(const float* keys_raw, const float* gates_raw,
+                        const float* k_norm_w, const float* k_norm_b,
+                        float* keys, float* gates, std::uint32_t tokens,
+                        std::uint32_t idim, float eps, hipStream_t stream) {
+  BatchIndexerAppendKernel<<<tokens, kBlockThreads, 0, stream>>>(
+      keys_raw, gates_raw, k_norm_w, k_norm_b, keys, gates, idim, eps);
+}
+
+void BatchIndexerPool(const float* rows, const float* row_gates,
+                      const float* ape, float* pooled, std::uint32_t first_pool,
+                      std::uint32_t pools, std::size_t row_base,
+                      std::uint32_t kpool, std::uint32_t idim,
+                      hipStream_t stream) {
+  if (pools == 0) {
+    return;
+  }
+  const dim3 grid(GridBlocks(idim), pools);
+  BatchIndexerPoolKernel<<<grid, kBlockThreads, 0, stream>>>(
+      rows, row_gates, ape, pooled, first_pool, pools, row_base, kpool, idim);
+}
+
+void BatchIndexerScores(const float* iq, const float* pooled,
+                        const float* weights, float* scores,
+                        std::uint32_t pitch, std::uint32_t tokens,
+                        std::uint32_t pools, std::uint32_t kpool,
+                        std::uint32_t seen_base, std::uint32_t heads,
+                        std::uint32_t idim, float scale, hipStream_t stream) {
+  const dim3 grid(1, (pools + kBlockThreads - 1) / kBlockThreads, tokens);
+  BatchIndexerScoresKernel<<<grid, kBlockThreads, 0, stream>>>(
+      iq, pooled, weights, scores, pitch, pools, kpool, seen_base, heads, idim,
+      scale);
+}
+
+bool BatchSelectPools(const float* scores, std::uint32_t pitch,
+                      std::uint32_t tokens, std::uint32_t pools,
+                      std::uint32_t select_pools, std::uint32_t kpool,
+                      std::uint32_t seen_base, std::uint32_t sel_stride,
+                      std::int32_t* selections, std::uint32_t* counts,
+                      hipStream_t stream) {
+  if (scores == nullptr || pitch == 0 || pools > pitch ||
+      select_pools > kSelectMaxPools / 2 || select_pools > pools ||
+      sel_stride < select_pools * kpool + 3) {
+    return false;
+  }
+  BatchSelectPoolsKernel<<<tokens, 1024, 0, stream>>>(
+      scores, pitch, pools, select_pools, kpool, seen_base, selections, counts,
+      sel_stride);
+  return true;
+}
+
+void BatchMlaAbsorb(const float* k_b, const float* q, float* q_abs,
+                    std::uint32_t tokens, std::uint32_t heads,
+                    std::uint32_t kv_lora, std::uint32_t qk_nope,
+                    hipStream_t stream) {
+  // The tiled kernels stage whole lane strides in registers, so they require
+  // the exact geometry the constants describe; anything else runs the
+  // legacy kernels.
+  if (qk_nope == kMlaNopeLanes * 32u && kv_lora % 32u == 0 &&
+      kv_lora / 32u <= kMlaMaxWarps) {
+    const dim3 grid(heads, (tokens + kMlaAbsorbTokens - 1) / kMlaAbsorbTokens);
+    BatchMlaAbsorbTiledKernel<<<grid, kv_lora, 0, stream>>>(
+        k_b, q, q_abs, tokens, heads, kv_lora, qk_nope, kMlaAbsorbTokens);
+    return;
+  }
+  const dim3 grid(heads, tokens);
+  BatchMlaAbsorbKernel<<<grid, kv_lora, 0, stream>>>(k_b, q, q_abs, heads,
+                                                     kv_lora, qk_nope);
+}
+
+void BatchMlaAttention(const float* q_abs, const float* latents,
+                       const std::int32_t* selections,
+                       const std::uint32_t* counts, std::uint32_t sel_stride,
+                       const float* v_b, float* attn_out, float* probs,
+                       float* weighted, std::uint32_t tokens,
+                       std::uint32_t heads, std::uint32_t kv_lora,
+                       std::uint32_t qk_nope, std::uint32_t v_head, float scale,
+                       hipStream_t stream) {
+  // Same exact-geometry requirement as the absorb launcher: the score and
+  // epilogue stages assume whole kMlaLoraLanes lane strides of kv_lora.
+  if (kv_lora == kMlaLoraLanes * 32u && heads % kMlaHeads == 0) {
+    const dim3 grid(heads / kMlaHeads,
+                    (tokens + kMlaTileTokens - 1) / kMlaTileTokens);
+    // Split launch: the score kernel leaves the probabilities in the probs
+    // stripe, the gather kernel (same stream, launched next) reads them
+    // back. The shared exp staging of the score kernel needs one double per
+    // selection slot plus one per head.
+    const std::size_t score_lds =
+        (static_cast<std::size_t>(sel_stride) + kMlaHeads) * sizeof(double);
+    BatchMlaScoreTiledKernel<kMlaHeads><<<grid, kv_lora, score_lds, stream>>>(
+        q_abs, latents, selections, counts, sel_stride, probs, tokens, heads,
+        kv_lora, kMlaTileTokens, scale);
+    BatchMlaGatherTiledKernel<kMlaHeads><<<grid, kv_lora, 0, stream>>>(
+        latents, selections, counts, sel_stride, v_b, probs, attn_out, weighted,
+        tokens, heads, kv_lora, v_head, kMlaTileTokens);
+    return;
+  }
+  const std::uint32_t shared_floats = sel_stride + 1;
+  const dim3 grid(heads, tokens);
+  BatchMlaAttentionKernel<<<grid, kv_lora, shared_floats * sizeof(float),
+                            stream>>>(
+      q_abs, latents, selections, counts, sel_stride, v_b, attn_out, probs,
+      weighted, heads, kv_lora, qk_nope, v_head, scale);
+}
+
+void ScaleAddRowsWeighted(float* acc, const float* x, const float* weights,
+                          std::uint32_t tokens, std::uint32_t hidden,
+                          std::size_t x_stride, hipStream_t stream) {
+  const std::size_t count = static_cast<std::size_t>(tokens) * hidden;
+  ScaleAddRowsWeightedKernel<<<GridBlocks(count), kBlockThreads, 0, stream>>>(
+      acc, x, weights, hidden, x_stride, count);
+}
+
+void BatchAppendRows(const float* src, float* dst, std::uint32_t row,
+                     std::uint32_t offset, std::uint32_t tokens,
+                     hipStream_t stream) {
+  BatchAppendRowsKernel<<<GridBlocks(static_cast<std::size_t>(tokens) * row),
+                          kBlockThreads, 0, stream>>>(src, dst, row, offset,
+                                                      tokens);
+}
