+void TestContinueAndEarlyErrors() {
+  RunningServer server({.max_request_body_bytes = 8192});
+  const auto send = [](int fd, std::string_view bytes) {
+    while (!bytes.empty()) {
+      const auto count = ::send(fd, bytes.data(), bytes.size(), MSG_NOSIGNAL);
+      assert(count > 0);
+      bytes.remove_prefix(static_cast<std::size_t>(count));
+    }
+  };
+  const auto read = [](int fd, std::size_t limit) {
+    std::string result;
+    char buffer[4096];
+    while (result.size() < limit) {
+      const auto count =
+          ::read(fd, buffer, std::min(sizeof(buffer), limit - result.size()));
+      assert(count >= 0);
+      if (!count)
+        break;
+      result.append(buffer, static_cast<std::size_t>(count));
+    }
+    return result;
+  };
+  constexpr std::string_view interim = "HTTP/1.1 100 Continue\r\n\r\n";
+  for (const bool chunked : {false, true}) {
+    const int fd = server.Connect();
+    send(fd, "POST /echo HTTP/1.1\r\nExpect: 100-continue\r\n" +
+                 std::string(chunked ? "Transfer-Encoding: chunked"
+                                     : "Content-Length: 5") +
+                 "\r\n\r\n");
+    assert(read(fd, interim.size()) == interim);
+    send(fd, chunked ? "5\r\nhello\r\n0\r\n\r\n" : "hello");
+    const auto response = read(fd, 1U << 20);
+    ExpectStatus(response, 200);
+    assert(response.substr(response.find("\r\n\r\n") + 4) == "hello");
+    ::close(fd);
+  }
+  const int refused = server.Connect();
+  send(refused,
+       "POST /echo HTTP/1.1\r\nExpect: 100-continue\r\n"
+       "Content-Length: 99999\r\n\r\n");
+  const auto response = read(refused, 1U << 20);
+  ExpectStatus(response, 413);
+  assert(response.find("100 Continue") == std::string::npos);
+  ::close(refused);
+
+  const int paced = server.Connect();
+  send(paced, "POST /echo HTTP/1.1\r\nContent-Length: 99999\r\n\r\n");
+  std::jthread upload([paced] {
+    const std::string part(1024, 'x');
+    for (int i = 0; i < 96; ++i) {
+      if (::send(paced, part.data(), part.size(), MSG_NOSIGNAL) <= 0)
+        return;
+      std::this_thread::sleep_for(std::chrono::milliseconds(2));
+    }
+  });
+  ExpectStatus(read(paced, 1U << 20), 413);
+  upload.join();
+  ::close(paced);
+}
