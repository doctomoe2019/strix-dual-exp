+int main(int argc, char** argv) {
+  setvbuf(stdout, nullptr, _IONBF, 0);
+  if (argc > 1) {
+    g_iters = static_cast<std::uint32_t>(std::atoi(argv[1]));
+  }
+  hipStream_t stream;
+  HIPCK(hipStreamCreate(&stream));
+
+  const std::uint32_t type =
+      static_cast<std::uint32_t>(gufo::core::GgmlType::kQ4_K);
+  const std::size_t row_bytes_4096 = (4096 / kQ4KQK) * kQ4KBytes;
+  const std::size_t row_bytes_2048 = (2048 / kQ4KQK) * kQ4KBytes;
+  const std::size_t row_bytes_1024 = (1024 / kQ4KQK) * kQ4KBytes;
+
+  const std::size_t gate_stride = static_cast<std::size_t>(4096) * row_bytes_4096;
+  auto wg_host = MakeQ4KWeights(kExperts, 4096, 4096);
+  auto w_gate = Device(wg_host);
