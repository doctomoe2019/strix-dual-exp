+}
+
+glm::TensorRef Ref(GgmlType type, std::uint64_t cols, std::uint64_t rows,
+                   std::uint64_t experts, const char* name) {
+  return glm::TensorRef{reinterpret_cast<const void*>(0x1000),
+                        type,
+                        cols,
+                        rows,
+                        experts,
+                        0,
+                        0,
+                        name};
+}
+
+glm::Config RealConfig() {
+  glm::Config c;
+  c.num_layers = 45;
+  c.nextn_layers = 1;
+  c.hidden_size = 4096;
+  c.vocab_size = 154880;
+  c.head_count = 64;
+  c.q_lora_rank = 1536;
+  c.kv_lora_rank = 512;
+  c.qk_nope_head_dim = 256;
+  c.v_head_dim = 256;
+  c.kda_head_dim = 128;
+  c.kda_conv_kernel = 4;
+  c.indexer_heads = 32;
+  c.indexer_head_dim = 128;
+  c.indexer_kpool = 4;
+  c.hc_count = 4;
+  c.dense_lead = 3;
+  c.dense_ffn = 12288;
+  c.expert_count = 288;
+  c.experts_used = 8;
+  c.shared_experts = 1;
+  c.expert_ffn = 2048;
+  c.dsa_layer.assign(45, false);
+  for (std::uint32_t i = 3; i < 45; i += 4)
+    c.dsa_layer[i] = true;
+  return c;
+}
+
+// One dense-KDA layer and one sparse-DSA layer with the artifact's real
+// dimensions and quantization, plus the global tensors.
+glm::ModelWeights TwoLayerWeights() {
+  glm::ModelWeights w;
+  w.config = RealConfig();
+  w.config.num_layers = 2;
+  w.config.nextn_layers = 0;
+  w.config.dense_lead = 1;
+  w.config.dsa_layer = {false, true};
+
+  const auto hidden = w.config.hidden_size;
+  const auto inner = w.config.KdaInnerDim();
+  const auto query = w.config.MlaQueryDim();
+  const auto head_dim = w.config.kda_head_dim;
+  const auto expert_ff = w.config.expert_ffn;
+  const auto experts = w.config.expert_count;
+
+  w.token_embd = Ref(GgmlType::kQ8_0, hidden, w.config.vocab_size, 1, "embd");
+  w.output = Ref(GgmlType::kQ8_0, hidden, w.config.vocab_size, 1, "output");
+  w.output_norm = Ref(GgmlType::kF32, hidden, 1, 1, "output_norm");
+  w.layers.resize(2);
+
+  glm::LayerWeights& kda = w.layers[0];
+  kda.linear = true;
+  kda.attn_norm = Ref(GgmlType::kF32, hidden, 1, 1, "attn_norm");
+  kda.ffn_norm = Ref(GgmlType::kF32, hidden, 1, 1, "ffn_norm");
+  kda.hc_attn.fn = Ref(GgmlType::kF32, w.config.HcDim(), w.config.HcMixDim(), 1,
+                       "hc_attn_fn");
+  kda.hc_attn.base =
+      Ref(GgmlType::kF32, w.config.HcMixDim(), 1, 1, "hc_attn_base");
+  kda.hc_attn.scale = Ref(GgmlType::kF32, 3, 1, 1, "hc_attn_scale");
+  kda.hc_ffn = kda.hc_attn;
+  kda.kda.q = Ref(GgmlType::kQ8_0, hidden, inner, 1, "kda_q");
+  kda.kda.k = Ref(GgmlType::kQ8_0, hidden, inner, 1, "kda_k");
+  kda.kda.v = Ref(GgmlType::kQ8_0, hidden, inner, 1, "kda_v");
+  kda.kda.out = Ref(GgmlType::kQ8_0, inner, hidden, 1, "kda_wo");
+  kda.kda.conv_q = Ref(GgmlType::kF32, 4, inner, 1, "conv_q");
+  kda.kda.conv_k = Ref(GgmlType::kF32, 4, inner, 1, "conv_k");
+  kda.kda.conv_v = Ref(GgmlType::kF32, 4, inner, 1, "conv_v");
+  kda.kda.f_a = Ref(GgmlType::kF32, hidden, head_dim, 1, "f_a");
+  kda.kda.f_b = Ref(GgmlType::kF32, head_dim, inner, 1, "f_b");
+  kda.kda.g_a = Ref(GgmlType::kF32, hidden, head_dim, 1, "g_a");
+  kda.kda.g_b = Ref(GgmlType::kF32, head_dim, inner, 1, "g_b");
+  kda.kda.beta = Ref(GgmlType::kF32, hidden, 64, 1, "beta");
+  kda.kda.a = Ref(GgmlType::kF32, 64, 1, 1, "a");
+  kda.kda.dt_bias = Ref(GgmlType::kF32, inner, 1, 1, "dt");
+  kda.kda.o_norm = Ref(GgmlType::kF32, head_dim, 1, 1, "o_norm");
+  kda.dense_ffn = true;
+  kda.ffn_gate =
+      Ref(GgmlType::kQ8_0, hidden, w.config.dense_ffn, 1, "ffn_gate");
+  kda.ffn_up = Ref(GgmlType::kQ8_0, hidden, w.config.dense_ffn, 1, "ffn_up");
+  kda.ffn_down =
+      Ref(GgmlType::kQ8_0, w.config.dense_ffn, hidden, 1, "ffn_down");
+
+  glm::LayerWeights& dsa = w.layers[1];
+  dsa.linear = false;
+  dsa.attn_norm = Ref(GgmlType::kF32, hidden, 1, 1, "attn_norm");
+  dsa.ffn_norm = Ref(GgmlType::kF32, hidden, 1, 1, "ffn_norm");
+  dsa.hc_attn = kda.hc_attn;
+  dsa.hc_ffn = kda.hc_ffn;
+  dsa.dsa.q_a = Ref(GgmlType::kQ8_0, hidden, w.config.q_lora_rank, 1, "q_a");
+  dsa.dsa.q_a_norm =
+      Ref(GgmlType::kF32, w.config.q_lora_rank, 1, 1, "q_a_norm");
+  dsa.dsa.q_b = Ref(GgmlType::kQ8_0, w.config.q_lora_rank, query, 1, "q_b");
+  dsa.dsa.kv_a = Ref(GgmlType::kF32, hidden, w.config.kv_lora_rank, 1, "kv_a");
+  dsa.dsa.kv_a_norm =
+      Ref(GgmlType::kF32, w.config.kv_lora_rank, 1, 1, "kv_a_norm");
+  dsa.dsa.k_b = Ref(GgmlType::kF32, w.config.qk_nope_head_dim,
+                    w.config.kv_lora_rank, 64, "k_b");
+  dsa.dsa.v_b = Ref(GgmlType::kF32, w.config.kv_lora_rank, w.config.v_head_dim,
+                    64, "v_b");
+  dsa.dsa.out = Ref(GgmlType::kQ8_0, query, hidden, 1, "wo");
+  dsa.indexer.q_b = Ref(GgmlType::kF32, w.config.q_lora_rank,
+                        w.config.IndexerQueryDim(), 1, "idx_q");
+  dsa.indexer.k =
+      Ref(GgmlType::kF32, hidden, w.config.indexer_head_dim, 1, "idx_k");
+  dsa.indexer.k_norm =
+      Ref(GgmlType::kF32, w.config.indexer_head_dim, 1, 1, "idx_k_norm");
+  dsa.indexer.k_norm_bias =
+      Ref(GgmlType::kF32, w.config.indexer_head_dim, 1, 1, "idx_k_norm_b");
+  dsa.indexer.proj =
+      Ref(GgmlType::kF32, hidden, w.config.indexer_heads, 1, "idx_proj");
+  dsa.indexer.comp_gate =
+      Ref(GgmlType::kF32, hidden, w.config.indexer_head_dim, 1, "idx_gate");
+  dsa.indexer.comp_ape = Ref(GgmlType::kF32, w.config.indexer_head_dim,
+                             w.config.indexer_kpool, 1, "idx_ape");
+  dsa.router = Ref(GgmlType::kF32, hidden, experts, 1, "router");
+  dsa.router_bias = Ref(GgmlType::kF32, experts, 1, 1, "router_bias");
+  dsa.gate_exps = Ref(GgmlType::kQ4_K, hidden, expert_ff, experts, "gate_exps");
+  dsa.up_exps = Ref(GgmlType::kQ4_K, hidden, expert_ff, experts, "up_exps");
+  dsa.down_exps = Ref(GgmlType::kQ4_K, expert_ff, hidden, experts, "down_exps");
+  dsa.gate_shexp = Ref(GgmlType::kQ8_0, hidden, expert_ff, 1, "gate_shexp");
+  dsa.up_shexp = Ref(GgmlType::kQ8_0, hidden, expert_ff, 1, "up_shexp");
+  dsa.down_shexp = Ref(GgmlType::kQ8_0, expert_ff, hidden, 1, "down_shexp");
+  return w;
+}
+
+}  // namespace
+
+int main() {
+  std::string error;
+  auto weights = TwoLayerWeights();
+
+  const auto single = PlanTpLedger(weights, 1, &error);
+  Require(single.has_value(), error.c_str());
+  Require(single->PerRankBytes(1) == single->FullArBytes(),
+          "one rank holds every AR byte");
+  Require(single->excluded_bytes == 0, "no nextn in this fixture");
+
+  const auto split = PlanTpLedger(weights, 2, &error);
+  Require(split.has_value(), error.c_str());
+  Require(split->PerRankBytes(2) ==
+              split->replicated_bytes +
+                  (split->row_split_bytes + split->col_split_bytes +
+                   split->head_split_bytes) /
+                      2,
+          "per-rank bytes are replicated plus half of every split");
+
+  // Byte math on one Q4_K expert family: 2048-wide gate/up rows and a
+  // 2048 -> 4096 down, 288 experts, halved for two ranks.
+  const std::size_t q4_row_4096 = 4096 / 256 * 144;
+  const std::size_t q4_row_2048 = 2048 / 256 * 144;
+  const std::size_t exps_full =
+      (2 * q4_row_4096 * 2048 + q4_row_2048 * 4096) * 288;
+  Require(weights.layers[1].gate_exps.SizeBytes() +
+                  weights.layers[1].up_exps.SizeBytes() +
+                  weights.layers[1].down_exps.SizeBytes() ==
+              exps_full,
+          "Q4_K expert family bytes");
+  Require(split->col_split_bytes >= q4_row_2048 / 2 * 2 * 4096 * 288 / 288,
+          "down columns halve on super-block boundaries");
+
+  // A Q4_K down whose share would cut a 256-value super-block: 384 / 2 =
+  // 192 columns per rank is not a whole number of super-blocks.
+  auto bad = TwoLayerWeights();
+  bad.config.expert_ffn = 384;
+  bad.layers[1].gate_exps = Ref(GgmlType::kQ4_K, 4096, 384, 288, "gate_exps");
+  bad.layers[1].up_exps = Ref(GgmlType::kQ4_K, 4096, 384, 288, "up_exps");
+  bad.layers[1].down_exps = Ref(GgmlType::kQ4_K, 384, 4096, 288, "down_exps");
+  Require(!PlanTpLedger(bad, 2, &error).has_value(),
+          "a split that cuts a quantization block is rejected");
+
+  // An odd head count cannot halve.
+  auto odd = TwoLayerWeights();
+  odd.config.head_count = 63;
+  Require(!PlanTpLedger(odd, 2, &error).has_value(),
+          "an odd head count is rejected");
+
+  // The nextn block is excluded wholesale.
+  auto with_nextn = TwoLayerWeights();
+  with_nextn.config.nextn_layers = 1;
+  glm::NextnWeights nextn;
+  nextn.eh_proj = Ref(GgmlType::kQ8_0, 2 * with_nextn.config.hidden_size,
+                      with_nextn.config.hidden_size, 1, "eh_proj");
+  nextn.enorm =
+      Ref(GgmlType::kF32, with_nextn.config.hidden_size, 1, 1, "enorm");
+  nextn.hnorm = nextn.enorm;
+  nextn.shared_head_norm = nextn.enorm;
+  nextn.block = with_nextn.layers[1];  // a DSA layer
+  with_nextn.nextn = nextn;
+  const auto ledger = PlanTpLedger(with_nextn, 2, &error);
+  Require(ledger.has_value(), error.c_str());
+  Require(ledger->excluded_bytes > nextn.eh_proj.SizeBytes(),
+          "the whole nextn block lands in the excluded bucket");
+  Require(ledger->FullArBytes() == split->FullArBytes(),
+          "AR bytes ignore the nextn block");
+
+  Require(!PlanTpLedger(weights, 3, &error).has_value(),
+          "world size above two is rejected");
+
+  std::puts("PASS: glm5_next TP plan ledger and split boundaries");
+  return 0;
+}
