+namespace gufo::models::glm5_next::rocm {
+
+/// Tokenwise executor over a resident slice. One executor owns the weights,
+/// the working buffers and the launch stream; any number of sessions share
+/// it, each holding its own recurrent and cache state.
+///
+/// Under a TP partition the attention and FFN sub-block outputs are this
+/// rank's partials; `Options::all_reduce` sums them across ranks on the
+/// stream before every mHC combine (two exchanges per layer). Everything
+/// else — mHC, norms, latent production, the indexer, routing decisions —
+/// runs replicated on identical inputs, so the ranks stay in lockstep
+/// without further communication.
+class Executor {
+public:
+  /// Sums `rows * hidden` floats across ranks, in place, completing on
+  /// `stream`. Null for single-rank execution.
+  using AllReduce =
+      std::function<bool(float*, std::uint32_t, hipStream_t, std::string*)>;
+
+  struct Options {
+    AllReduce all_reduce;
+    /// Prefill chunk width (clamped to kMaxBatch); 0 = kMaxBatch.
+    std::uint32_t prefill_chunk{0};
+    /// Diagnostic observer of every sub-block's summed output, in forward
+    /// order (layer, sub-block 0=attention 1=ffn). `first_token` is the
+    /// session position of the first row and `rows` the token count (1 on
+    /// the tokenwise path); the device pointer is pending on the stream.
+    /// Null in production; probes hash per block to find the first
+    /// diverging operator between ranks.
+    std::function<void(std::uint32_t, int, std::uint32_t, std::uint32_t,
+                       const float*, hipStream_t)>
+        block_observer;
+  };
+
+  ~Executor();
+  Executor(const Executor&) = delete;
+  Executor& operator=(const Executor&) = delete;
+
+  [[nodiscard]] static std::unique_ptr<Executor> Create(
+      std::unique_ptr<DeviceSlice> slice, Options options,
+      std::string* error_msg = nullptr);
+
+  /// One conversation: KDA recurrent state and conv history, DSA latent and
+  /// pooled-key caches with the pooling frontier, and the position.
+  class Session {
+  public:
+    ~Session();
+    Session(const Session&) = delete;
+    Session& operator=(const Session&) = delete;
+
+    [[nodiscard]] std::uint32_t position() const noexcept { return position_; }
+    /// Token capacity this session was created for.
+    [[nodiscard]] std::uint32_t capacity() const noexcept { return capacity_; }
+    /// Drops every token; the next Step starts at position 0.
+    void Reset();
+
+    /// Device bytes of every persistent region this session owns.
+    [[nodiscard]] std::size_t state_bytes() const noexcept;
+
+  private:
+    friend class Executor;
+    Session() = default;
+
+    struct Kda {
+      float* history{nullptr};  // [(kernel-1)][3 * inner]
+      float* state{nullptr};    // [heads][dim][dim]
+    };
+    struct Dsa {
+      float* latents{nullptr};         // [capacity][kv_lora]
+      float* pooled{nullptr};          // [capacity/kpool + 1][idim]
+      float* scores{nullptr};          // [capacity/kpool + 1] scratch
+      float* frontier_keys{nullptr};   // [kpool][idim]
+      float* frontier_gates{nullptr};  // [kpool][idim]
+    };
+
+    std::uint32_t position_{0};
+    std::uint32_t capacity_{0};
+    std::uint32_t kda_cursor_{0};  // per-Step walk cursor
+    std::uint32_t dsa_cursor_{0};
+    hipStream_t stream_{nullptr};  // owning executor's stream (state ops)
+    std::vector<Kda> kda_;
+    std::vector<Dsa> dsa_;
+    std::vector<void*> allocations_;
+    std::vector<std::size_t> allocation_bytes_;
+  };
+
+  [[nodiscard]] std::unique_ptr<Session> CreateSession(
+      std::uint32_t capacity, std::string* error_msg = nullptr) const;
+
+  /// FNV-1a hash of every persistent session region — KDA recurrent state
+  /// and conv history, DSA latents, pooled keys and frontiers — in a
+  /// stable order, so a chunked run can be compared byte-for-byte against
+  /// a tokenwise one. Diagnostic use (the qualification tests).
+  [[nodiscard]] bool HashState(const Session& session, std::uint64_t* hash,
+                               std::string* error_msg = nullptr) const;
+
+  /// Appends one token at the session's position and, with `logits` non-null,
+  /// copies the vocabulary distribution of that position into it after the
+  /// stream drains.
+  [[nodiscard]] bool Step(Session& session, std::int32_t token, float* logits,
+                          std::string* error_msg) const;
+
+  /// Appends up to `kMaxBatch` tokens with the batched (prefill) kernels.
+  /// Byte-identical to the tokenwise path by construction; the exchanges
+  /// carry one partial row per token per sub-block. `logits` (may be null)
+  /// receives the LAST position's distribution.
+  [[nodiscard]] bool StepBatch(Session& session,
+                               std::span<const std::int32_t> tokens,
+                               float* logits, std::string* error_msg) const;
+
+  /// Appends `tokens` in batched chunks of kMaxBatch; `logits` (may be
+  /// null) receives the final position's distribution.
+  [[nodiscard]] bool Prefill(Session& session,
+                             std::span<const std::int32_t> tokens,
+                             float* logits, std::string* error_msg) const;
+
+  /// Widest batched (prefill) chunk. The batched scratch working set is
+  /// allocated once at this width, and the all-reduce payload of the widest
+  /// sub-block partial is kMaxBatch * hidden * sizeof(float) bytes, so every
+  /// transport's receive window must cover it (kWindowBytes in tbstream.cpp
+  /// and verbs.cpp).
+  static constexpr std::uint32_t kMaxBatch = 4096;
+
+  /// Device bytes of the executor's shared working set (tokenwise and
+  /// batched scratch), allocated once in Create.
+  [[nodiscard]] std::size_t scratch_bytes() const noexcept;
+
+  [[nodiscard]] const Config& config() const noexcept {
+    return slice_->config();
+  }
+  [[nodiscard]] const distributed::TpPartition& partition() const noexcept {
+    return slice_->partition();
+  }
+  [[nodiscard]] const DeviceSlice& slice() const noexcept { return *slice_; }
+  [[nodiscard]] hipStream_t stream() const noexcept { return stream_; }
+
+private:
+  Executor() = default;
+
+  bool AttentionBlock(Session& session, std::uint32_t layer,
+                      std::string* error_msg) const;
+  bool FfnBlock(Session& session, std::uint32_t layer,
+                std::string* error_msg) const;
+  bool SumPartial(std::uint32_t layer, int sub, std::uint32_t first_token,
+                  std::string* error_msg) const;
+  bool AttentionBlockBatch(Session& session, std::uint32_t layer,
+                           std::uint32_t n, std::string* error_msg) const;
+  bool FfnBlockBatch(Session& session, std::uint32_t layer, std::uint32_t n,
+                     std::string* error_msg) const;
+  bool SumPartialBatch(std::uint32_t layer, int sub, std::uint32_t first_token,
+                       std::uint32_t n, std::string* error_msg) const;
+
+  std::unique_ptr<DeviceSlice> slice_;
+  Options options_;
+  hipStream_t stream_{nullptr};
+
+  // Working buffers, one token wide; names follow reference.cpp.
