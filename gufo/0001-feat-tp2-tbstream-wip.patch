+  auto* streams = make(n * hidden);
+  auto* residual = make(n * hidden);
+  auto* flat = make(n * hidden);
+  auto* mixes = make(mix_dim);
+  auto* hc_pre = make(n);
+  auto* hc_post = make(n);
+  auto* hc_comb = make(n * n);
+  auto* collapsed = make(hidden);
+  auto* block_x = make(hidden);
+  auto* block_out = make(hidden);
+  auto* normed = make(hidden);
+  auto* logits = make(c.vocab_size);
+  // KDA working set (shared across layers) and per-layer persistent state.
+  auto* qkv = make(3 * inner);
+  auto* conv_out = make(3 * inner);
