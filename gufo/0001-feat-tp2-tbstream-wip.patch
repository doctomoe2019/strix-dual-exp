+    gufo::server::ChatRequest chat;
+    Expect(
+        gufo::server::ParseOpenAiResponseControls(
+            gufo::json::parse(
+                R"({"tools":[{"type":"function","function":null,"name":"f"}]})"),
+            &chat)
+            .has_value(),
