+  const std::size_t pairs = count / 2;
+  for (std::size_t i = first; i < pairs; i += stride) {
+    const float2 v =
+        reinterpret_cast<const float2*>(partial)[i];
+    reinterpret_cast<__half2*>(send)[i] = __float22half2_rn(v);
