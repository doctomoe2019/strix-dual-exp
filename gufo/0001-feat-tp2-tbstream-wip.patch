+++ b/src/models/glm5_next/engine.hpp
@@ -0,0 +1,148 @@
+#ifndef GUFO_MODELS_GLM5_NEXT_ENGINE_HPP_
+#define GUFO_MODELS_GLM5_NEXT_ENGINE_HPP_
+
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <span>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "src/models/glm5_next/config.hpp"
+
+struct ihipStream_t;
+
+namespace gufo::models::glm5_next {
+
+class Session;
+
+/// Loads and serves one GLM-5.3-Flash artifact: the resident weights, the
+/// shared executor working set and the tokenizer, plus any number of
+/// sessions with private recurrent/cache state. The caller serializes
+/// model and session calls (the serving scheduler owns dispatch).
+struct ModelOptions {
+  /// Runtime context ceiling. The long-context ladder qualifies this
+  /// separately from the artifact's native context.
+  std::uint32_t max_context{4096};
+  /// Batched prefill chunk width (clamped to the executor bound; 0 keeps
+  /// the executor default).
+  std::uint32_t prefill_chunk{512};
+  std::uint32_t tp_rank{0};
+  std::uint32_t tp_world_size{1};
+  /// Sums attention/FFN partials across ranks on the executor stream,
+  /// completing there. Null keeps this rank's partials (single-rank
+  /// qualification runs).
+  using AllReduce =
+      std::function<bool(float*, std::uint32_t, ihipStream_t*, std::string*)>;
+  AllReduce all_reduce;
+};
+
+class Model final : public std::enable_shared_from_this<Model> {
+public:
+  /// Runtime capacity ceiling (the planned 256K qualification ladder top).
+  static constexpr std::uint32_t kMaxServingContext = 262144;
+
+  ~Model();
+  Model(const Model&) = delete;
+  Model& operator=(const Model&) = delete;
+  Model(Model&&) = delete;
+  Model& operator=(Model&&) = delete;
+
+  [[nodiscard]] static std::shared_ptr<Model> Load(
+      const std::string& model_path, ModelOptions options,
+      std::string* error_msg = nullptr);
+
+  /// One conversation, resident for `capacity` tokens (at most
+  /// max_context). Sessions share the executor's working set; their
+  /// private state is theirs alone.
+  [[nodiscard]] std::unique_ptr<Session> CreateSession(
+      std::uint32_t capacity, std::string* error_msg = nullptr) const;
+
+  [[nodiscard]] std::vector<std::int32_t> Tokenize(std::string_view text) const;
+  [[nodiscard]] std::string Decode(std::span<const std::int32_t> tokens) const;
+  [[nodiscard]] std::string TokenText(std::int32_t token) const;
+  /// The GGUF's eos/eom/eot stop ids (154820, 154827, 154829).
+  [[nodiscard]] bool IsStopToken(std::int32_t token) const noexcept;
+  [[nodiscard]] std::int32_t EosToken() const noexcept;
+  [[nodiscard]] std::uint32_t VocabSize() const noexcept;
+  [[nodiscard]] std::uint32_t MaxContext() const noexcept {
+    return options_.max_context;
+  }
+  [[nodiscard]] std::uint32_t TpRank() const noexcept {
+    return options_.tp_rank;
+  }
+  [[nodiscard]] std::uint32_t TpWorldSize() const noexcept {
+    return options_.tp_world_size;
+  }
+  /// False for rank-partial diagnostics; TP2 serving requires a reducer.
+  [[nodiscard]] bool HasAllReduce() const noexcept;
+  /// Effective batched prefill chunk width.
+  [[nodiscard]] std::uint32_t PrefillChunk() const noexcept;
+  /// Device bytes of the resident weights.
+  [[nodiscard]] std::size_t ResidentBytes() const noexcept;
+  /// Device bytes of the executor's shared working set.
+  [[nodiscard]] std::size_t ScratchBytes() const noexcept;
+  /// Device bytes one session of `capacity` tokens allocates.
+  [[nodiscard]] std::size_t SessionBytes(std::uint32_t capacity) const noexcept;
+  [[nodiscard]] const Config& config() const noexcept;
+
+private:
+  friend class Session;
+
+  Model() = default;
+
+  struct Impl;
+  std::unique_ptr<Impl> impl_;
+  ModelOptions options_;
+};
+
+/// One conversation over the loaded model: batched prefill and tokenwise
+/// evaluation over the compact latent/indexer caches, KDA state and the
+/// pooling frontier, plus the executed token history.
+class Session final {
+public:
+  ~Session();
+  Session(const Session&) = delete;
+  Session& operator=(const Session&) = delete;
+  Session(Session&&) = delete;
+  Session& operator=(Session&&) = delete;
+
+  /// Makes the session state equal to `prompt`: an exact extension of the
+  /// executed history prefills only the new tokens; anything that
+  /// truncates or diverges from it resets and replays in full. The last
+  /// position's logits stay available after a non-empty sync.
+  [[nodiscard]] bool Sync(std::span<const std::int32_t> prompt,
+                          std::string* error_msg = nullptr);
+  /// Appends one token (decode step) and refreshes the logits.
+  [[nodiscard]] bool Evaluate(std::int32_t token,
+                              std::string* error_msg = nullptr);
+  /// The last computed position's distribution; empty before the first
+  /// non-empty Sync or Evaluate, or after a failed call.
+  [[nodiscard]] std::span<const float> Logits() const noexcept;
+  [[nodiscard]] std::uint32_t Position() const noexcept;
+  [[nodiscard]] std::uint32_t Capacity() const noexcept;
+  [[nodiscard]] std::span<const std::int32_t> Tokens() const noexcept;
+  /// Drops every token and returns to a fresh, valid, empty session.
+  void Reset() noexcept;
+  /// False after a failed Sync or Evaluate; Reset restores usability.
+  [[nodiscard]] bool valid() const noexcept;
+  /// Device bytes of this session's persistent regions.
+  [[nodiscard]] std::size_t StateBytes() const noexcept;
+  /// FNV-1a over every persistent region in stable order — the
+  /// qualification diagnostics' state fingerprint.
+  [[nodiscard]] bool StateHash(std::uint64_t* hash,
+                               std::string* error_msg = nullptr) const;
+
+private:
+  friend class Model;
+  struct Impl;
+  explicit Session(std::unique_ptr<Impl> impl);
+
+  std::unique_ptr<Impl> impl_;
+};
+
+}  // namespace gufo::models::glm5_next
+
+#endif  // GUFO_MODELS_GLM5_NEXT_ENGINE_HPP_
diff --git a/src/models/glm5_next/kernels/rocm/device_model.cpp b/src/models/glm5_next/kernels/rocm/device_model.cpp
new file mode 100644
index 0000000..efcdf62
--- /dev/null
+++ b/src/models/glm5_next/kernels/rocm/device_model.cpp
@@ -0,0 +1,453 @@
+#include "src/models/glm5_next/kernels/rocm/device_model.hpp"
+
+#include <hip/hip_runtime.h>
+
+#include <algorithm>
+#include <limits>
+#include <string>
+#include <unordered_map>
+#include <unordered_set>
+#include <utility>
+#include <vector>
+
+#include "src/core/hip/weight_upload.hpp"
+#include "src/core/quant/ggml_dequant.hpp"
+
+namespace gufo::models::glm5_next::rocm {
+namespace {
+
+/// The quantized GEMM tier reads whole k-iterations; every upload carries
+/// this zeroed tail so row over-reads stay inside the allocation (the
+/// padding meets zeroed activation and contributes nothing).
+constexpr std::size_t kTailMargin = 4096;
+
+bool SupportedType(core::GgmlType type) {
+  return type == core::GgmlType::kF32 || type == core::GgmlType::kQ8_0 ||
+         type == core::GgmlType::kQ4_K;
+}
+
+std::size_t SpanBytes(core::GgmlType type, std::size_t elements) {
+  switch (type) {
+    case core::GgmlType::kF32:
+    case core::GgmlType::kI32:
+      return elements * 4;
+    case core::GgmlType::kF16:
+    case core::GgmlType::kBF16:
+      return elements * 2;
+    default:
+      return gufo::quant::QuantizedRowBytes(type, elements);
+  }
+}
+
+/// Allocates `bytes + kTailMargin` and zeroes the tail; `ptr` stays null on
+/// failure.
+bool AllocTail(std::vector<void*>& allocations, std::size_t bytes, void** ptr,
+               const TensorRef& t, std::size_t* weight_bytes,
+               std::string* error) {
+  if (bytes > std::numeric_limits<std::size_t>::max() - kTailMargin) {
+    if (error != nullptr) {
+      *error = "slice tensor size overflows: " + std::string(t.name);
+    }
+    return false;
+  }
+  if (hipMalloc(ptr, bytes + kTailMargin) != hipSuccess) {
+    if (error != nullptr) {
+      *error = "hipMalloc failed for " + std::string(t.name) + " (" +
+               std::to_string(bytes) + " bytes)";
+    }
+    return false;
+  }
+  allocations.push_back(*ptr);
+  *weight_bytes += bytes + kTailMargin;
+  (void)hipMemsetAsync(static_cast<std::uint8_t*>(*ptr) + bytes, 0, kTailMargin,
+                       nullptr);
+  return true;
+}
+
+/// Uploads one planned tensor according to its span. Split geometry is
+/// validated by the planner; here it is only executed.
+struct Uploader {
+  hip::WeightUpload& stager;
+  std::vector<void*>& allocations;
+  std::size_t& weight_bytes;
+  std::size_t& encoded_bytes;
+  std::size_t& tensor_count;
+  std::string* error;
+  bool ok{true};
+
+  void Fail(const std::string& message) {
+    if (ok && error != nullptr) {
+      *error = message;
+    }
+    ok = false;
+  }
+
+  void Count(std::size_t local_bytes) {
+    encoded_bytes += local_bytes;
+    ++tensor_count;
+  }
+
+  DeviceTensor UploadSpan(const TensorRef& t,
+                          const distributed::TensorSpan& span) {
+    DeviceTensor d;
+    if (t.empty() || !ok) {
+      return d;
+    }
+    if (!SupportedType(t.type)) {
+      Fail("unsupported tensor format in slice: " + std::string(t.name));
+      return d;
+    }
+    if (t.cols > std::numeric_limits<std::uint32_t>::max() ||
+        t.rows > std::numeric_limits<std::uint32_t>::max() ||
+        t.experts > std::numeric_limits<std::uint32_t>::max()) {
+      Fail("slice tensor geometry is invalid: " + std::string(t.name));
+      return d;
+    }
+    const std::size_t row_bytes = t.RowBytes();
+    void* ptr = nullptr;
+    switch (span.kind) {
+      case distributed::TensorSpanKind::kFull: {
+        const std::size_t size = t.SizeBytes();
+        if (!AllocTail(allocations, size, &ptr, t, &weight_bytes, error)) {
+          Fail(*error);
+          return d;
+        }
+        if (!stager.Copy(t.shard, t.file_offset, size, ptr, error)) {
+          Fail("upload failed for " + std::string(t.name));
+          return d;
+        }
+        d.type = t.type;
+        d.cols = static_cast<std::uint32_t>(t.cols);
+        d.rows = static_cast<std::uint32_t>(t.rows);
+        d.experts = static_cast<std::uint32_t>(t.experts);
+        Count(size);
+        break;
+      }
+      case distributed::TensorSpanKind::kRows: {
+        const std::size_t count = static_cast<std::size_t>(span.count);
+        const std::size_t size = count * row_bytes * t.experts;
+        if (!AllocTail(allocations, size, &ptr, t, &weight_bytes, error)) {
+          Fail(*error);
+          return d;
+        }
+        if (span.per_expert) {
+          for (std::uint64_t e = 0; e < t.experts; ++e) {
+            if (!stager.Copy(
+                    t.shard,
+                    t.file_offset + (e * t.rows + span.begin) * row_bytes,
+                    count * row_bytes,
+                    static_cast<std::uint8_t*>(ptr) + e * count * row_bytes,
+                    error)) {
+              Fail("upload failed for " + std::string(t.name));
+              return d;
+            }
+          }
+        } else if (!stager.Copy(t.shard, t.file_offset + span.begin * row_bytes,
+                                size, ptr, error)) {
+          Fail("upload failed for " + std::string(t.name));
+          return d;
+        }
+        d.type = t.type;
+        d.cols = static_cast<std::uint32_t>(t.cols);
+        d.rows = static_cast<std::uint32_t>(count);
+        d.experts = static_cast<std::uint32_t>(t.experts);
+        Count(size);
+        break;
+      }
+      case distributed::TensorSpanKind::kElements: {
+        const std::size_t skip =
+            SpanBytes(t.type, static_cast<std::size_t>(span.begin));
+        const std::size_t size =
+            SpanBytes(t.type, static_cast<std::size_t>(span.count));
+        if (!AllocTail(allocations, size, &ptr, t, &weight_bytes, error)) {
+          Fail(*error);
+          return d;
+        }
+        if (!stager.Copy(t.shard, t.file_offset + skip, size, ptr, error)) {
+          Fail("upload failed for " + std::string(t.name));
+          return d;
+        }
+        d.type = t.type;
+        d.cols = static_cast<std::uint32_t>(span.count);
+        d.rows = 1;
+        Count(size);
+        break;
+      }
+      case distributed::TensorSpanKind::kStack: {
+        const std::size_t matrix = row_bytes * t.rows;
+        const std::size_t size = matrix * static_cast<std::size_t>(span.count);
+        if (!AllocTail(allocations, size, &ptr, t, &weight_bytes, error)) {
+          Fail(*error);
+          return d;
+        }
+        if (!stager.Copy(t.shard, t.file_offset + span.begin * matrix, size,
+                         ptr, error)) {
+          Fail("upload failed for " + std::string(t.name));
+          return d;
+        }
+        d.type = t.type;
+        d.cols = static_cast<std::uint32_t>(t.cols);
+        d.rows = static_cast<std::uint32_t>(t.rows);
+        d.experts = static_cast<std::uint32_t>(span.count);
+        Count(size);
+        break;
+      }
+      case distributed::TensorSpanKind::kColumns: {
+        const std::size_t span_off =
+            SpanBytes(t.type, static_cast<std::size_t>(span.begin));
+        const std::size_t span_bytes =
+            SpanBytes(t.type, static_cast<std::size_t>(span.count));
+        const std::size_t size = span_bytes * t.rows * t.experts;
+        if (!AllocTail(allocations, size, &ptr, t, &weight_bytes, error)) {
+          Fail(*error);
+          return d;
+        }
+        if (span.per_expert) {
+          const std::size_t expert_bytes = row_bytes * t.rows;
+          for (std::uint64_t e = 0; e < t.experts; ++e) {
+            if (!stager.CopyStrided(
+                    t.shard, t.file_offset + e * expert_bytes, row_bytes,
+                    span_off, span_bytes, t.rows,
+                    static_cast<std::uint8_t*>(ptr) + e * span_bytes * t.rows,
+                    error)) {
+              Fail("upload failed for " + std::string(t.name));
+              return d;
+            }
+          }
+        } else if (!stager.CopyStrided(t.shard, t.file_offset, row_bytes,
+                                       span_off, span_bytes, t.rows * t.experts,
+                                       ptr, error)) {
+          Fail("upload failed for " + std::string(t.name));
+          return d;
+        }
+        d.type = t.type;
+        d.cols = static_cast<std::uint32_t>(span.count);
+        d.rows = static_cast<std::uint32_t>(t.rows);
+        d.experts = static_cast<std::uint32_t>(t.experts);
+        Count(size);
+        break;
+      }
+    }
+    d.data = ptr;
+    return d;
+  }
+};
+
+}  // namespace
+
+DeviceSlice::~DeviceSlice() {
+  for (void* ptr : allocations_) {
+    (void)hipFree(ptr);
+  }
+}
+
+std::unique_ptr<DeviceSlice> DeviceSlice::Upload(
+    const ModelWeights& weights, const core::GgufReader& reader,
+    std::uint32_t layer_count, const distributed::TpPartition* partition,
+    std::string* error_msg) {
+  const Config& c = weights.config;
+  if (layer_count > c.num_layers) {
+    if (error_msg != nullptr) {
+      *error_msg = "slice requests more layers than the trunk has";
+    }
+    return nullptr;
+  }
+  auto plan_partition = distributed::TpPartition::Create(
+      c, partition != nullptr ? partition->rank : 0,
+      partition != nullptr ? partition->world_size : 1, error_msg);
+  if (!plan_partition) {
+    return nullptr;
+  }
+  if (partition != nullptr && *partition != *plan_partition) {
+    if (error_msg != nullptr) {
+      *error_msg = "slice partition does not match the model";
+    }
+    return nullptr;
+  }
+  auto planned =
+      distributed::PlanModelTensors(weights, *plan_partition, error_msg);
+  if (!planned) {
+    return nullptr;
+  }
+  // Only the first `layer_count` layers (plus the global tensors) belong to
+  // the slice; the walk keeps their original relative order.
+  std::unordered_set<const TensorRef*> wanted;
+  wanted.reserve(64 + layer_count * 32);
+  wanted.insert(&weights.token_embd);
+  wanted.insert(&weights.output);
+  wanted.insert(&weights.output_norm);
+  for (std::uint32_t l = 0; l < layer_count; ++l) {
+    const LayerWeights& w = weights.layers[l];
+    auto add = [&wanted](const TensorRef& t) {
+      if (!t.empty()) {
+        wanted.insert(&t);
+      }
+    };
+    auto add_hc = [&add](const HcWeights& hc) {
+      add(hc.fn);
+      add(hc.base);
+      add(hc.scale);
+    };
+    add(w.attn_norm);
+    add(w.ffn_norm);
+    add_hc(w.hc_attn);
+    add_hc(w.hc_ffn);
+    if (w.linear) {
+      for (const TensorRef* t :
+           {&w.kda.q, &w.kda.k, &w.kda.v, &w.kda.out, &w.kda.conv_q,
+            &w.kda.conv_k, &w.kda.conv_v, &w.kda.f_a, &w.kda.f_b, &w.kda.g_a,
+            &w.kda.g_b, &w.kda.beta, &w.kda.a, &w.kda.dt_bias, &w.kda.o_norm}) {
+        add(*t);
+      }
+    } else {
+      for (const TensorRef* t :
+           {&w.dsa.q_a, &w.dsa.q_a_norm, &w.dsa.q_b, &w.dsa.kv_a,
+            &w.dsa.kv_a_norm, &w.dsa.k_b, &w.dsa.v_b, &w.dsa.out,
+            &w.indexer.q_b, &w.indexer.k, &w.indexer.k_norm,
+            &w.indexer.k_norm_bias, &w.indexer.proj, &w.indexer.comp_gate,
+            &w.indexer.comp_ape}) {
+        add(*t);
+      }
+    }
+    if (w.dense_ffn) {
+      add(w.ffn_gate);
+      add(w.ffn_up);
+      add(w.ffn_down);
+    } else {
+      add(w.router);
+      add(w.router_bias);
+      add(w.gate_exps);
+      add(w.up_exps);
+      add(w.down_exps);
+      add(w.gate_shexp);
+      add(w.up_shexp);
+      add(w.down_shexp);
+    }
+  }
+
+  auto stager = hip::WeightUpload::Create(reader.GetMappedRegions(), error_msg);
+  if (stager == nullptr) {
+    return nullptr;
+  }
+  auto slice = std::unique_ptr<DeviceSlice>(new DeviceSlice());
+  slice->config_ = c;
+  slice->partition_ = *plan_partition;
+  slice->layer_count_ = layer_count;
+  slice->layers_.resize(layer_count);
+  // Span lookup keyed by tensor address; every consumed tensor is erased
+  // so a final emptiness check proves full coverage.
+  std::unordered_map<const TensorRef*, distributed::TensorSpan> spans;
+  for (const auto& entry : *planned) {
+    if (wanted.count(entry.tensor) != 0) {
+      spans.emplace(entry.tensor, entry.span);
+    }
+  }
+
+  const auto take = [&](const TensorRef& t) -> distributed::TensorSpan {
+    const auto it = spans.find(&t);
+    if (it == spans.end()) {
+      if (error_msg != nullptr) {
+        *error_msg = "slice plan is missing " + std::string(t.name);
+      }
+      return distributed::TensorSpan{};
+    }
+    distributed::TensorSpan span = it->second;
+    spans.erase(it);
+    return span;
+  };
+  Uploader up{*stager,
+              slice->allocations_,
+              slice->weight_bytes_,
+              slice->encoded_bytes_,
+              slice->tensor_count_,
+              error_msg,
+              true};
+
+  slice->token_embd_ =
+      up.UploadSpan(weights.token_embd, take(weights.token_embd));
+  slice->output_ = up.UploadSpan(weights.output, take(weights.output));
+  slice->output_norm_ =
+      up.UploadSpan(weights.output_norm, take(weights.output_norm));
+  for (std::uint32_t l = 0; l < layer_count && up.ok; ++l) {
+    const LayerWeights& w = weights.layers[l];
+    DeviceLayer& d = slice->layers_[l];
+    d.linear = w.linear;
+    d.dense_ffn = w.dense_ffn;
+    d.attn_norm = up.UploadSpan(w.attn_norm, take(w.attn_norm));
+    d.ffn_norm = up.UploadSpan(w.ffn_norm, take(w.ffn_norm));
+    const auto upload_hc = [&](const HcWeights& hw, DeviceHc* dh) {
+      dh->fn = up.UploadSpan(hw.fn, take(hw.fn));
+      dh->base = up.UploadSpan(hw.base, take(hw.base));
+      dh->scale = up.UploadSpan(hw.scale, take(hw.scale));
+    };
+    upload_hc(w.hc_attn, &d.hc_attn);
+    upload_hc(w.hc_ffn, &d.hc_ffn);
+    const auto upload_kda = [&](const KdaWeights& kw, DeviceKda* dk) {
+      dk->q = up.UploadSpan(kw.q, take(kw.q));
+      dk->k = up.UploadSpan(kw.k, take(kw.k));
+      dk->v = up.UploadSpan(kw.v, take(kw.v));
+      dk->out = up.UploadSpan(kw.out, take(kw.out));
+      dk->conv_q = up.UploadSpan(kw.conv_q, take(kw.conv_q));
+      dk->conv_k = up.UploadSpan(kw.conv_k, take(kw.conv_k));
+      dk->conv_v = up.UploadSpan(kw.conv_v, take(kw.conv_v));
+      dk->f_a = up.UploadSpan(kw.f_a, take(kw.f_a));
+      dk->f_b = up.UploadSpan(kw.f_b, take(kw.f_b));
+      dk->g_a = up.UploadSpan(kw.g_a, take(kw.g_a));
+      dk->g_b = up.UploadSpan(kw.g_b, take(kw.g_b));
+      dk->beta = up.UploadSpan(kw.beta, take(kw.beta));
+      dk->a = up.UploadSpan(kw.a, take(kw.a));
+      dk->dt_bias = up.UploadSpan(kw.dt_bias, take(kw.dt_bias));
+      dk->o_norm = up.UploadSpan(kw.o_norm, take(kw.o_norm));
+    };
+    const auto upload_dsa = [&](const DsaWeights& dw, DeviceDsa* dd) {
+      dd->q_a = up.UploadSpan(dw.q_a, take(dw.q_a));
+      dd->q_a_norm = up.UploadSpan(dw.q_a_norm, take(dw.q_a_norm));
+      dd->q_b = up.UploadSpan(dw.q_b, take(dw.q_b));
+      dd->kv_a = up.UploadSpan(dw.kv_a, take(dw.kv_a));
+      dd->kv_a_norm = up.UploadSpan(dw.kv_a_norm, take(dw.kv_a_norm));
+      dd->k_b = up.UploadSpan(dw.k_b, take(dw.k_b));
+      dd->v_b = up.UploadSpan(dw.v_b, take(dw.v_b));
+      dd->out = up.UploadSpan(dw.out, take(dw.out));
+    };
+    const auto upload_indexer = [&](const IndexerWeights& iw,
+                                    DeviceIndexer* di) {
+      di->q_b = up.UploadSpan(iw.q_b, take(iw.q_b));
+      di->k = up.UploadSpan(iw.k, take(iw.k));
+      di->k_norm = up.UploadSpan(iw.k_norm, take(iw.k_norm));
+      di->k_norm_bias = up.UploadSpan(iw.k_norm_bias, take(iw.k_norm_bias));
+      di->proj = up.UploadSpan(iw.proj, take(iw.proj));
+      di->comp_gate = up.UploadSpan(iw.comp_gate, take(iw.comp_gate));
+      di->comp_ape = up.UploadSpan(iw.comp_ape, take(iw.comp_ape));
+    };
+    if (w.linear) {
+      upload_kda(w.kda, &d.kda);
+    } else {
+      upload_dsa(w.dsa, &d.dsa);
+      upload_indexer(w.indexer, &d.indexer);
+    }
+    if (w.dense_ffn) {
+      d.ffn_gate = up.UploadSpan(w.ffn_gate, take(w.ffn_gate));
+      d.ffn_up = up.UploadSpan(w.ffn_up, take(w.ffn_up));
+      d.ffn_down = up.UploadSpan(w.ffn_down, take(w.ffn_down));
+    } else {
+      d.router = up.UploadSpan(w.router, take(w.router));
+      d.router_bias = up.UploadSpan(w.router_bias, take(w.router_bias));
+      d.gate_exps = up.UploadSpan(w.gate_exps, take(w.gate_exps));
+      d.up_exps = up.UploadSpan(w.up_exps, take(w.up_exps));
+      d.down_exps = up.UploadSpan(w.down_exps, take(w.down_exps));
+      d.gate_shexp = up.UploadSpan(w.gate_shexp, take(w.gate_shexp));
+      d.up_shexp = up.UploadSpan(w.up_shexp, take(w.up_shexp));
+      d.down_shexp = up.UploadSpan(w.down_shexp, take(w.down_shexp));
+    }
+  }
+  if (!up.ok || !spans.empty() || !stager->Finish(error_msg)) {
+    if (up.ok && error_msg != nullptr && !spans.empty()) {
+      *error_msg = "slice upload left " + std::to_string(spans.size()) +
+                   " planned tensors unassigned";
+    }
+    return nullptr;
+  }
+  return slice;
+}
+
+}  // namespace gufo::models::glm5_next::rocm
diff --git a/src/models/glm5_next/kernels/rocm/device_model.hpp b/src/models/glm5_next/kernels/rocm/device_model.hpp
new file mode 100644
index 0000000..3013a2e
--- /dev/null
+++ b/src/models/glm5_next/kernels/rocm/device_model.hpp
@@ -0,0 +1,137 @@
+#ifndef GUFO_MODELS_GLM5_NEXT_KERNELS_ROCM_DEVICE_MODEL_HPP_
+#define GUFO_MODELS_GLM5_NEXT_KERNELS_ROCM_DEVICE_MODEL_HPP_
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "src/core/gguf_reader.hpp"
+#include "src/models/glm5_next/distributed/tp_partition.hpp"
+#include "src/models/glm5_next/weights.hpp"
+
+namespace gufo::models::glm5_next::rocm {
+
+/// One weight resident in device memory, still in its GGUF encoding.
+struct DeviceTensor {
+  void* data{nullptr};
+  core::GgmlType type{core::GgmlType::kF32};
+  std::uint32_t cols{0};
+  std::uint32_t rows{0};
+  std::uint32_t experts{1};
+
+  [[nodiscard]] bool empty() const noexcept { return data == nullptr; }
+  [[nodiscard]] const float* f32() const noexcept {
+    return static_cast<const float*>(data);
+  }
+};
+
+struct DeviceHc {
+  DeviceTensor fn;
+  DeviceTensor base;
+  DeviceTensor scale;
+};
+
+/// KDA tensors of one layer.
+struct DeviceKda {
+  DeviceTensor q, k, v, out;
+  DeviceTensor conv_q, conv_k, conv_v;
+  DeviceTensor f_a, f_b, g_a, g_b;
+  DeviceTensor beta, a, dt_bias, o_norm;
+};
+
+/// Nope-only MLA tensors of one DSA layer.
+struct DeviceDsa {
+  DeviceTensor q_a, q_a_norm, q_b;
+  DeviceTensor kv_a, kv_a_norm;
+  DeviceTensor k_b;  // [qk_nope, kv_lora] x heads, F32
+  DeviceTensor v_b;  // [kv_lora, v_head] x heads, F32
+  DeviceTensor out;
+};
+
+/// Indexer tensors of one DSA layer (replicated under TP).
+struct DeviceIndexer {
+  DeviceTensor q_b, k, k_norm, k_norm_bias, proj;
+  DeviceTensor comp_gate, comp_ape;
+};
+
+struct DeviceLayer {
+  bool linear{false};
+  bool dense_ffn{false};
+  DeviceTensor attn_norm, ffn_norm;
+  DeviceHc hc_attn, hc_ffn;
+  DeviceKda kda;
+  DeviceDsa dsa;
+  DeviceIndexer indexer;
+  DeviceTensor ffn_gate, ffn_up, ffn_down;  // dense layers
+  DeviceTensor router, router_bias;
+  DeviceTensor gate_exps, up_exps, down_exps;
+  DeviceTensor gate_shexp, up_shexp, down_shexp;
+};
+
+/// The trunk slice: the first `layer_count` trunk layers plus the embedding
+/// table, output norm and vocabulary head, resident on one device in the
+/// artifact's own encodings (F32/Q8_0/Q4_K). With a partition (P3) every
+/// split tensor holds only this rank's share, in the artifact's encoding,
+/// with the local geometry in `cols`/`rows`/`experts`; without one the
+/// whole tensors upload exactly as in P2.
+class DeviceSlice {
+public:
+  ~DeviceSlice();
+  DeviceSlice(const DeviceSlice&) = delete;
+  DeviceSlice& operator=(const DeviceSlice&) = delete;
+
+  /// Streams the slice from the same open files used to bind its
+  /// metadata. `layer_count` = 0 uploads only the embedding and head.
+  /// `partition` = null uploads whole tensors (world size 1).
+  [[nodiscard]] static std::unique_ptr<DeviceSlice> Upload(
+      const ModelWeights& weights, const core::GgufReader& reader,
+      std::uint32_t layer_count,
+      const distributed::TpPartition* partition = nullptr,
+      std::string* error_msg = nullptr);
+
+  [[nodiscard]] std::uint32_t layer_count() const noexcept {
+    return layer_count_;
+  }
+  /// The rank geometry the weights were uploaded for (world size 1 when
+  /// no partition was given).
+  [[nodiscard]] const distributed::TpPartition& partition() const noexcept {
+    return partition_;
+  }
+  const DeviceTensor& token_embd() const noexcept { return token_embd_; }
+  const DeviceTensor& output() const noexcept { return output_; }
+  const DeviceTensor& output_norm() const noexcept { return output_norm_; }
+  const std::vector<DeviceLayer>& layers() const noexcept { return layers_; }
+  const Config& config() const noexcept { return config_; }
+  /// Device bytes held by weights (excluding tail margins).
+  [[nodiscard]] std::size_t resident_bytes() const noexcept {
+    return weight_bytes_;
+  }
+  /// Encoded tensor bytes the slice covers (the ledger cross-check).
+  [[nodiscard]] std::size_t encoded_bytes() const noexcept {
+    return encoded_bytes_;
+  }
+  [[nodiscard]] std::size_t tensor_count() const noexcept {
+    return tensor_count_;
+  }
+
+private:
+  DeviceSlice() = default;
+
+  Config config_{};
+  distributed::TpPartition partition_{};
+  DeviceTensor token_embd_;
+  DeviceTensor output_;
+  DeviceTensor output_norm_;
+  std::vector<DeviceLayer> layers_;
+  std::vector<void*> allocations_;
+  std::size_t weight_bytes_{0};
+  std::size_t encoded_bytes_{0};
+  std::size_t tensor_count_{0};
+  std::uint32_t layer_count_{0};
+};
+
+}  // namespace gufo::models::glm5_next::rocm
+
+#endif  // GUFO_MODELS_GLM5_NEXT_KERNELS_ROCM_DEVICE_MODEL_HPP_
diff --git a/src/models/glm5_next/kernels/rocm/executor.cpp b/src/models/glm5_next/kernels/rocm/executor.cpp
new file mode 100644
index 0000000..c5e829f
--- /dev/null
+++ b/src/models/glm5_next/kernels/rocm/executor.cpp
@@ -0,0 +1,1145 @@
+#include "src/models/glm5_next/kernels/rocm/executor.hpp"
+
+#include <hip/hip_runtime.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstdlib>
+#include <numeric>
+#include <utility>
+#include <vector>
+
+#include "src/core/quant/ggml_dequant.hpp"
+#include "src/models/glm5_next/kernels/rocm/kernels.hpp"
+#include "src/models/glm5_next/kernels/rocm/kernels_batch.hpp"
+#include "src/models/qwen/hip/ops/gemm.hpp"
+
+namespace gufo::models::glm5_next::rocm {
+namespace {
+
+bool Check(hipError_t error, const char* what, std::string* error_msg) {
+  if (error != hipSuccess) {
+    if (error_msg != nullptr) {
+      *error_msg = std::string(what) + ": " + hipGetErrorString(error);
+    }
+    return false;
+  }
+  return true;
+}
+
+void SetError(std::string* error_msg, std::string message) {
+  if (error_msg != nullptr) {
+    *error_msg = std::move(message);
+  }
+}
+
+}  // namespace
+
+Executor::~Executor() {
+  for (void* ptr : allocations_) {
+    (void)hipFree(ptr);
+  }
+  if (stream_ != nullptr) {
+    (void)hipStreamDestroy(stream_);
+  }
+}
+
+Executor::Session::~Session() {
+  for (void* ptr : allocations_) {
+    (void)hipFree(ptr);
+  }
+}
+
+void Executor::Session::Reset() {
+  position_ = 0;
+  kda_cursor_ = 0;
+  dsa_cursor_ = 0;
+  for (std::size_t i = 0; i < allocations_.size(); ++i) {
+    (void)hipMemsetAsync(allocations_[i], 0, allocation_bytes_[i], stream_);
+  }
+  (void)hipStreamSynchronize(stream_);
+}
+
+std::unique_ptr<Executor> Executor::Create(std::unique_ptr<DeviceSlice> slice,
+                                           Options options,
+                                           std::string* error_msg) {
+  if (slice == nullptr) {
+    SetError(error_msg, "executor needs a resident slice");
+    return nullptr;
+  }
+  auto executor = std::unique_ptr<Executor>(new Executor());
+  executor->slice_ = std::move(slice);
+  executor->options_ = std::move(options);
+  if (!Check(hipStreamCreateWithFlags(&executor->stream_, hipStreamNonBlocking),
+             "stream create", error_msg)) {
+    return nullptr;
+  }
+  const Config& c = executor->slice_->config();
+  const distributed::TpPartition& p = executor->slice_->partition();
+  const std::uint32_t heads = p.head_count;
+  const std::uint32_t inner = heads * c.kda_head_dim;
+  const std::uint32_t query = heads * c.qk_nope_head_dim;
+  if (c.expert_count > kRouterExpertLimit) {
+    SetError(error_msg, "expert count exceeds the router selection kernel");
+    return nullptr;
+  }
+  for (const DeviceLayer& layer : executor->slice_->layers()) {
+    if (layer.gate_exps.rows == 0) {
+      continue;  // dense FFN (no routed experts)
+    }
+    // The batch scratch budgets expert intermediate rows from the
+    // partition; the resident slice must agree. KDA attention layers
+    // carry MoE FFNs too, so this checks every routed layer.
+    if (layer.gate_exps.rows != p.expert_ff_count ||
+        layer.up_exps.rows != p.expert_ff_count) {
+      SetError(error_msg,
+               "expert intermediate width deviates from the partition");
+      return nullptr;
+    }
+  }
+  const std::size_t max_ffn = std::max<std::size_t>(
+      {p.dense_ff_count, p.shared_ff_count, p.expert_ff_count});
+
+  Scratch& s = executor->s_;
+  bool ok = true;
+  const auto alloc = [&](std::size_t floats, float** slot) {
+    if (!ok) {
+      return;
+    }
+    void* ptr = nullptr;
+    if (hipMalloc(&ptr, floats * sizeof(float)) != hipSuccess) {
+      ok = false;
+      return;
+    }
+    executor->allocations_.push_back(ptr);
+    executor->allocation_bytes_.push_back(floats * sizeof(float));
+    *slot = static_cast<float*>(ptr);
+  };
+  const std::uint32_t n = c.hc_count;
+  const std::uint32_t hidden = c.hidden_size;
+  const std::size_t max_sel = c.indexer_top_k + c.indexer_kpool;
+  alloc(static_cast<std::size_t>(n) * hidden, &s.streams);
+  alloc(static_cast<std::size_t>(n) * hidden, &s.residual);
+  alloc(static_cast<std::size_t>(n) * hidden, &s.flat);
+  alloc(c.HcMixDim(), &s.mixes);
+  alloc(n, &s.hc_pre);
+  alloc(n, &s.hc_post);
+  alloc(static_cast<std::size_t>(n) * n, &s.hc_comb);
+  alloc(hidden, &s.collapsed);
+  alloc(hidden, &s.block_x);
+  alloc(hidden, &s.block_out);
+  alloc(hidden, &s.normed);
+  alloc(c.vocab_size, &s.logits);
+  alloc(3 * static_cast<std::size_t>(inner), &s.qkv);
+  alloc(3 * static_cast<std::size_t>(inner), &s.conv_out);
+  alloc(inner, &s.raw);
+  alloc(c.kda_head_dim, &s.f_a_out);
+  alloc(c.kda_head_dim, &s.g_a_out);
+  alloc(heads, &s.beta_row);
+  alloc(inner, &s.gate);
+  alloc(heads, &s.beta);
+  alloc(inner, &s.qn);
+  alloc(inner, &s.kn);
+  alloc(inner, &s.core);
+  alloc(inner, &s.core_normed);
+  alloc(inner, &s.gated);
+  alloc(c.kv_lora_rank, &s.latent_raw);
+  alloc(c.kv_lora_rank, &s.latent_normed);
+  alloc(c.q_lora_rank, &s.q_resid_raw);
+  alloc(c.q_lora_rank, &s.q_resid);
+  alloc(c.indexer_head_dim, &s.idx_k_raw);
+  alloc(c.indexer_head_dim, &s.idx_g_raw);
+  alloc(c.IndexerQueryDim(), &s.iq);
+  alloc(c.indexer_heads, &s.head_weights);
+  alloc(c.indexer_heads, &s.head_weights_raw);
+  alloc(query, &s.q_full);
+  alloc(static_cast<std::size_t>(heads) * c.kv_lora_rank, &s.q_abs);
+  alloc(query, &s.attn_out_buf);
+  alloc(static_cast<std::size_t>(heads) * max_sel, &s.attn_probs);
+  alloc(static_cast<std::size_t>(heads) * c.kv_lora_rank, &s.attn_weighted);
+  alloc(max_ffn, &s.ffn_gate_out);
+  alloc(max_ffn, &s.ffn_up_out);
+  alloc(max_ffn, &s.ffn_act);
+  alloc(hidden, &s.ffn_partial);
+  // Batched (prefill) scratch, fixed at kMaxBatch tokens.
+  BatchScratch& b = executor->b_;
+  const std::size_t max_batch = kMaxBatch;
+  const std::size_t sel_stride = c.indexer_top_k + c.indexer_kpool;
+  // Indexed pool rows the batched selector can rank in tiles: covers the
+  // full 256K ladder (262144/4 + 1), one float per (token, pool).
+  const std::size_t max_pools = 1024 * 64;
+  executor->max_pools_batch_ = max_pools;
+  const auto alloc_b = [&](std::size_t floats, float** slot) {
+    if (!ok) {
+      return;
+    }
+    void* ptr = nullptr;
+    if (hipMalloc(&ptr, floats * sizeof(float)) != hipSuccess) {
+      ok = false;
+      return;
+    }
+    executor->allocations_.push_back(ptr);
+    executor->allocation_bytes_.push_back(floats * sizeof(float));
+    *slot = static_cast<float*>(ptr);
+  };
+  {
+    void* raw = nullptr;
+    ok = ok && hipMalloc(&raw, max_batch * sizeof(std::int32_t)) == hipSuccess;
+    if (ok) {
+      executor->allocations_.push_back(raw);
+      executor->allocation_bytes_.push_back(max_batch * sizeof(std::int32_t));
+      b.tokens = static_cast<std::int32_t*>(raw);
+    }
+  }
+  alloc_b(max_batch * static_cast<std::size_t>(n) * hidden, &b.streams);
+  alloc_b(max_batch * static_cast<std::size_t>(n) * hidden, &b.residual);
+  alloc_b(max_batch * static_cast<std::size_t>(n) * hidden, &b.flat);
+  alloc_b(max_batch * c.HcMixDim(), &b.mixes);
+  alloc_b(max_batch * n, &b.hc_pre);
+  alloc_b(max_batch * n, &b.hc_post);
+  alloc_b(max_batch * static_cast<std::size_t>(n) * n, &b.hc_comb);
+  alloc_b(max_batch * hidden, &b.collapsed);
+  alloc_b(max_batch * hidden, &b.block_x);
+  alloc_b(max_batch * hidden, &b.block_out);
+  alloc_b(max_batch * hidden, &b.normed);
+  alloc_b(max_batch * 3 * static_cast<std::size_t>(inner), &b.qkv);
+  alloc_b(max_batch * 3 * static_cast<std::size_t>(inner), &b.conv_out);
+  alloc_b(max_batch * inner, &b.raw);
+  alloc_b(max_batch * c.kda_head_dim, &b.f_a_out);
+  alloc_b(max_batch * c.kda_head_dim, &b.g_a_out);
+  alloc_b(max_batch * heads, &b.beta_row);
+  alloc_b(max_batch * inner, &b.gate);
+  alloc_b(max_batch * heads, &b.beta);
+  alloc_b(max_batch * inner, &b.qn);
+  alloc_b(max_batch * inner, &b.kn);
+  alloc_b(max_batch * inner, &b.core);
+  alloc_b(max_batch * inner, &b.core_normed);
+  alloc_b(max_batch * inner, &b.gated);
+  alloc_b(max_batch * c.kv_lora_rank, &b.latent_raw);
+  alloc_b(max_batch * c.kv_lora_rank, &b.latent_normed);
+  alloc_b(max_batch * c.q_lora_rank, &b.q_resid_raw);
+  alloc_b(max_batch * c.q_lora_rank, &b.q_resid);
+  alloc_b(max_batch * c.indexer_head_dim, &b.idx_k_raw);
+  alloc_b(max_batch * c.indexer_head_dim, &b.idx_g_raw);
+  alloc_b((3 + max_batch) * c.indexer_head_dim, &b.rows_keys);
+  alloc_b((3 + max_batch) * c.indexer_head_dim, &b.rows_gates);
+  alloc_b(max_batch * c.IndexerQueryDim(), &b.iq);
+  alloc_b(max_batch * c.indexer_heads, &b.head_weights);
+  alloc_b(max_batch * c.indexer_heads, &b.head_weights_raw);
+  alloc_b(max_batch * query, &b.q_full);
+  alloc_b(max_batch * static_cast<std::size_t>(heads) * c.kv_lora_rank,
+          &b.q_abs);
+  alloc_b(max_batch * query, &b.attn_out);
+  alloc_b(max_batch * static_cast<std::size_t>(heads) * sel_stride,
+          &b.attn_probs);
+  alloc_b(max_batch * static_cast<std::size_t>(heads) * c.kv_lora_rank,
+          &b.attn_weighted);
+  alloc_b(max_batch * max_pools, &b.scores);
+  alloc_b(max_batch * max_ffn, &b.gate_out);
+  alloc_b(max_batch * max_ffn, &b.up_out);
+  alloc_b(max_batch * max_ffn, &b.act);
+  alloc_b(max_batch * c.experts_used * p.expert_ff_count, &b.expert_gate);
+  alloc_b(max_batch * c.experts_used * p.expert_ff_count, &b.expert_up);
+  alloc_b(max_batch * c.experts_used * p.expert_ff_count, &b.expert_act);
+  alloc_b(max_batch * c.experts_used * hidden, &b.expert_down);
+  alloc_b(max_batch * c.expert_count, &b.router);
+  alloc_b(max_batch * c.experts_used, &b.expert_w);
+  if (ok) {
+    void* raw = nullptr;
+    if (hipMalloc(&raw, max_batch * sel_stride * sizeof(std::int32_t)) ==
+        hipSuccess) {
+      executor->allocations_.push_back(raw);
+      executor->allocation_bytes_.push_back(max_batch * sel_stride *
+                                            sizeof(std::int32_t));
+      b.sel = static_cast<std::int32_t*>(raw);
+    } else {
+      ok = false;
+    }
+  }
+  if (ok) {
+    void* raw = nullptr;
+    if (hipMalloc(&raw, max_batch * sizeof(std::uint32_t)) == hipSuccess) {
+      executor->allocations_.push_back(raw);
+      executor->allocation_bytes_.push_back(max_batch * sizeof(std::uint32_t));
+      b.counts = static_cast<std::uint32_t*>(raw);
+    } else {
+      ok = false;
+    }
+  }
+  if (ok) {
+    void* raw = nullptr;
+    if (hipMalloc(&raw, max_batch * c.experts_used * sizeof(std::int32_t)) ==
+        hipSuccess) {
+      executor->allocations_.push_back(raw);
+      executor->allocation_bytes_.push_back(max_batch * c.experts_used *
+                                            sizeof(std::int32_t));
+      b.ids = static_cast<std::int32_t*>(raw);
+    } else {
+      ok = false;
+    }
+  }
+  {
+    void* raw = nullptr;
+    const std::size_t bin_words = 2 * c.expert_count + 2;
+    if (ok &&
+        hipMalloc(&raw, bin_words * sizeof(std::uint32_t)) == hipSuccess) {
+      executor->allocations_.push_back(raw);
+      executor->allocation_bytes_.push_back(bin_words * sizeof(std::uint32_t));
+      b.expert_bins = static_cast<std::uint32_t*>(raw);
+    } else {
+      ok = false;
+    }
+  }
+  {
+    void* raw = nullptr;
+    const std::size_t words = max_batch * c.experts_used;
+    if (ok &&
+        hipMalloc(&raw, 2 * words * sizeof(std::uint32_t)) == hipSuccess) {
+      executor->allocations_.push_back(raw);
+      executor->allocation_bytes_.push_back(2 * words * sizeof(std::uint32_t));
+      b.expert_ranks = static_cast<std::uint32_t*>(raw);
+      b.expert_pairs = b.expert_ranks + words;
+    } else {
+      ok = false;
+    }
+  }
+  if (!ok) {
+    SetError(error_msg, "executor batch scratch allocation failed");
+    return nullptr;
+  }
+  return executor;
+}
+
+std::unique_ptr<Executor::Session> Executor::CreateSession(
+    std::uint32_t capacity, std::string* error_msg) const {
+  if (capacity == 0) {
+    SetError(error_msg, "session capacity must be nonzero");
+    return nullptr;
+  }
+  auto session = std::unique_ptr<Session>(new Session());
+  session->capacity_ = capacity;
+  session->stream_ = stream_;
+  const Config& c = config();
+  const distributed::TpPartition& p = slice_->partition();
+  const std::uint32_t heads = p.head_count;
+  const std::uint32_t inner = heads * c.kda_head_dim;
+  const std::size_t pools =
+      static_cast<std::size_t>(capacity) / c.indexer_kpool + 1;
+  bool ok = true;
+  const auto alloc = [&](std::size_t bytes) -> void* {
+    if (!ok) {
+      return nullptr;
+    }
+    void* ptr = nullptr;
+    if (hipMalloc(&ptr, bytes) != hipSuccess) {
+      ok = false;
+      return nullptr;
+    }
+    session->allocations_.push_back(ptr);
+    session->allocation_bytes_.push_back(bytes);
+    // Zero on the executor stream so the region is clean before the first
+    // Step touches it (a non-blocking stream does not order against the
+    // default stream).
+    (void)hipMemsetAsync(ptr, 0, bytes, stream_);
+    return ptr;
+  };
+  for (const DeviceLayer& layer : slice_->layers()) {
+    if (!ok) {
+      break;
+    }
+    if (layer.linear) {
+      Session::Kda kda;
+      kda.history = static_cast<float*>(
+          alloc((c.kda_conv_kernel - 1) * 3 * static_cast<std::size_t>(inner) *
+                sizeof(float)));
+      kda.state = static_cast<float*>(alloc(static_cast<std::size_t>(heads) *
+                                            c.kda_head_dim * c.kda_head_dim *
+                                            sizeof(float)));
+      session->kda_.push_back(kda);
+    } else {
+      Session::Dsa dsa;
+      dsa.latents = static_cast<float*>(alloc(
+          static_cast<std::size_t>(capacity) * c.kv_lora_rank * sizeof(float)));
+      dsa.pooled = static_cast<float*>(
+          alloc(pools * c.indexer_head_dim * sizeof(float)));
+      dsa.scores = static_cast<float*>(alloc(pools * sizeof(float)));
+      dsa.frontier_keys = static_cast<float*>(
+          alloc(c.indexer_kpool * c.indexer_head_dim * sizeof(float)));
+      dsa.frontier_gates = static_cast<float*>(
+          alloc(c.indexer_kpool * c.indexer_head_dim * sizeof(float)));
+      session->dsa_.push_back(dsa);
+    }
+  }
+  if (!ok) {
+    SetError(error_msg, "session allocation failed");
+    return nullptr;
+  }
+  if (!Check(hipStreamSynchronize(stream_), "session zeroing", error_msg)) {
+    return nullptr;
+  }
+  return session;
+}
+
+bool Executor::HashState(const Session& session, std::uint64_t* hash,
+                         std::string* error_msg) const {
+  std::uint64_t h = 1469598103934665603ULL;
+  for (std::size_t i = 0; i < session.allocations_.size(); ++i) {
+    const std::size_t bytes = session.allocation_bytes_[i];
+    std::vector<std::uint8_t> host(bytes);
+    // Stream-ordered copy: pending executor-stream kernels finish before
+    // the state is read.
+    if (!Check(hipMemcpyAsync(host.data(), session.allocations_[i], bytes,
+                              hipMemcpyDeviceToHost, stream_),
+               "state hash copy", error_msg) ||
+        !Check(hipStreamSynchronize(stream_), "state hash drain", error_msg)) {
+      return false;
+    }
+    for (std::uint8_t v : host) {
+      h ^= v;
+      h *= 1099511628211ULL;
+    }
+  }
+  *hash = h;
+  return true;
+}
+
+std::size_t Executor::Session::state_bytes() const noexcept {
+  std::size_t bytes = 0;
+  for (std::size_t size : allocation_bytes_) {
+    bytes += size;
+  }
+  return bytes;
+}
+
+std::size_t Executor::scratch_bytes() const noexcept {
+  std::size_t bytes = 0;
+  for (std::size_t size : allocation_bytes_) {
+    bytes += size;
+  }
+  return bytes;
+}
+
+bool Executor::SumPartial(std::uint32_t layer, int sub,
+                          std::uint32_t first_token,
+                          std::string* error_msg) const {
+  // Tokenwise: one row of hidden floats per exchange.
+  if (options_.all_reduce &&
+      !options_.all_reduce(s_.block_out, 1, stream_, error_msg)) {
+    return false;
+  }
+  if (options_.block_observer) {
+    options_.block_observer(layer, sub, first_token, 1, s_.block_out, stream_);
+  }
+  return true;
+}
+
+bool Executor::AttentionBlock(Session& session, std::uint32_t layer,
+                              std::string* error_msg) const {
+  const Config& c = config();
+  const DeviceLayer& dl = slice_->layers()[layer];
+  const distributed::TpPartition& p = slice_->partition();
+  const std::uint32_t heads = p.head_count;
+  const std::uint32_t dim = c.kda_head_dim;
+  const std::uint32_t inner = heads * dim;
+  const auto q8 = gufo::core::GgmlType::kQ8_0;
+  const Scratch& s = s_;
+
+  if (dl.linear) {
+    const DeviceKda& kd = dl.kda;
+    Session::Kda& state = session.kda_[session.kda_cursor_];
+    ++session.kda_cursor_;
+    rocm::BatchQ8KBlockGEMV(kd.q.data, rocm::WeightTypeOf(kd.q.type), s.block_x,
+                            s.qkv, 1, kd.q.rows, kd.q.cols, stream_);
+    rocm::BatchQ8KBlockGEMV(kd.k.data, rocm::WeightTypeOf(kd.k.type), s.block_x,
+                            s.qkv + inner, 1, kd.k.rows, kd.k.cols, stream_);
+    rocm::BatchQ8KBlockGEMV(kd.v.data, rocm::WeightTypeOf(kd.v.type), s.block_x,
+                            s.qkv + 2 * static_cast<std::size_t>(inner), 1,
+                            kd.v.rows, kd.v.cols, stream_);
+    rocm::KdaConv(s.qkv, kd.conv_q.f32(), kd.conv_k.f32(), kd.conv_v.f32(),
+                  state.history, s.conv_out, inner, c.kda_conv_kernel, stream_);
+    rocm::F32Gemm(kd.f_a.f32(), s.block_x, s.f_a_out, kd.f_a.rows,
+                  c.hidden_size, stream_);
+    rocm::F32Gemm(kd.f_b.f32(), s.f_a_out, s.raw, kd.f_b.rows, kd.f_b.cols,
+                  stream_);
+    rocm::F32Gemm(kd.beta.f32(), s.block_x, s.beta_row, kd.beta.rows,
+                  c.hidden_size, stream_);
+    rocm::KdaGates(s.raw, kd.a.f32(), kd.dt_bias.f32(), s.beta_row,
+                   c.kda_gate_lower_bound, s.gate, s.beta, inner, dim, stream_);
+    rocm::KdaPrepare(s.conv_out, s.qn, s.kn, heads, dim, 1e-6F, stream_);
+    rocm::KdaRecurrence(s.qn, s.kn, s.gate, s.beta, s.conv_out, state.state,
+                        s.core, heads, dim, stream_);
+    rocm::RmsNormRows(s.core, kd.o_norm.f32(), s.core_normed, heads, inner,
+                      heads, c.rms_eps, stream_);
+    rocm::F32Gemm(kd.g_a.f32(), s.block_x, s.g_a_out, kd.g_a.rows,
+                  c.hidden_size, stream_);
+    rocm::F32Gemm(kd.g_b.f32(), s.g_a_out, s.raw, kd.g_b.rows, kd.g_b.cols,
+                  stream_);
+    rocm::SigmoidMul(s.core_normed, s.raw, s.gated, inner, stream_);
+    rocm::BatchQ8KBlockGEMV(kd.out.data, rocm::WeightTypeOf(kd.out.type),
+                            s.gated, s.block_out, 1, kd.out.rows, kd.out.cols,
+                            stream_);
+    return SumPartial(layer, 0, session.position_, error_msg);
+  }
+
+  const DeviceDsa& m = dl.dsa;
+  const DeviceIndexer& idx = dl.indexer;
+  Session::Dsa& cache = session.dsa_[session.dsa_cursor_];
+  ++session.dsa_cursor_;
+  const std::uint32_t pos = session.position_;
+  const std::uint32_t tokens_seen = pos + 1;
+  const std::uint32_t kpool = c.indexer_kpool;
+  const std::uint32_t idim = c.indexer_head_dim;
+  const std::uint32_t pools = tokens_seen / kpool;
+  const std::uint32_t tail = tokens_seen % kpool;
+
+  // Latent production and caching (replicated).
+  rocm::F32Gemm(m.kv_a.f32(), s.block_x, s.latent_raw, m.kv_a.rows,
+                c.hidden_size, stream_);
+  rocm::RmsNormRows(s.latent_raw, m.kv_a_norm.f32(), s.latent_normed, 1,
+                    c.kv_lora_rank, 1, c.rms_eps, stream_);
+  rocm::AppendRows(s.latent_normed, cache.latents, c.kv_lora_rank, pos, 1,
+                   stream_);
+  rocm::BatchQ8KBlockGEMV(m.q_a.data, rocm::WeightTypeOf(m.q_a.type), s.block_x,
+                          s.q_resid_raw, 1, m.q_a.rows, m.q_a.cols, stream_);
+  rocm::RmsNormRows(s.q_resid_raw, m.q_a_norm.f32(), s.q_resid, 1,
+                    c.q_lora_rank, 1, c.rms_eps, stream_);
+
+  // Indexer append on the rotating frontier; a completed pool folds into
+  // the compact pooled-key cache at once.
+  rocm::F32Gemm(idx.k.f32(), s.block_x, s.idx_k_raw, idx.k.rows, c.hidden_size,
+                stream_);
+  rocm::F32Gemm(idx.comp_gate.f32(), s.block_x, s.idx_g_raw, idx.comp_gate.rows,
+                c.hidden_size, stream_);
+  rocm::IndexerAppend(s.idx_k_raw, s.idx_g_raw, idx.k_norm.f32(),
+                      idx.k_norm_bias.f32(), cache.frontier_keys,
+                      cache.frontier_gates, pos % kpool, idim, c.layer_norm_eps,
+                      stream_);
+  if (tail == 0) {
+    rocm::IndexerPool(cache.frontier_keys, cache.frontier_gates,
+                      idx.comp_ape.f32(),
+                      cache.pooled + static_cast<std::size_t>(pools - 1) * idim,
+                      0, kpool, idim, stream_);
+    // The pool is complete: the frontier holds no live rows from here on,
+    // matching the batched path's writeback.
+    if (!Check(hipMemsetAsync(cache.frontier_keys, 0,
+                              kpool * idim * sizeof(float), stream_),
+               "frontier clear", error_msg) ||
+        !Check(hipMemsetAsync(cache.frontier_gates, 0,
+                              kpool * idim * sizeof(float), stream_),
+               "frontier clear", error_msg)) {
+      return false;
+    }
+  }
+  rocm::F32Gemm(idx.q_b.f32(), s.q_resid, s.iq, idx.q_b.rows, idx.q_b.cols,
+                stream_);
+  rocm::F32Gemm(idx.proj.f32(), s.block_x, s.head_weights_raw, idx.proj.rows,
+                c.hidden_size, stream_);
+  rocm::ScaleRows(
+      s.head_weights_raw, s.head_weights,
+      static_cast<float>(1.0 / std::sqrt(static_cast<double>(c.indexer_heads))),
+      c.indexer_heads, stream_);
+
+  // Exact selection through the tiled batch selector, one query row: the
+  // same kernel the batched path runs, so tokenwise and chunked
+  // selections agree by construction at any pool count the scratch
+  // holds. The count stays deterministic on the host.
+  const std::uint32_t select_pools = std::min(c.indexer_top_k / kpool, pools);
+  const std::size_t count =
+      static_cast<std::size_t>(select_pools) * kpool + tail;
+  if (pools > 0) {
+    rocm::BatchIndexerScores(
+        s.iq, cache.pooled, s.head_weights, b_.scores, max_pools_batch_, 1,
+        pools, kpool, pos, c.indexer_heads, idim,
+        static_cast<float>(1.0 / std::sqrt(static_cast<double>(idim))),
+        stream_);
+    // The session scratch keeps the final query's scores so session
+    // bytes match across the two paths.
+    if (!Check(hipMemcpyAsync(cache.scores, b_.scores,
+                              static_cast<std::size_t>(pools) * sizeof(float),
+                              hipMemcpyDeviceToDevice, stream_),
+               "scores mirror", error_msg)) {
+      return false;
+    }
+  }
+  if (!rocm::BatchSelectPools(
+          b_.scores, max_pools_batch_, 1, pools, select_pools, kpool, pos,
+          c.indexer_top_k + c.indexer_kpool, b_.sel, b_.counts, stream_)) {
+    SetError(error_msg, "tokenwise selection rejected the pool configuration");
+    return false;
+  }
+
+  // Absorbed sparse MLA over this rank's heads; the output projection
+  // reduces over the local query columns. The tokenwise path runs the
+  // batched kernels one token wide, so chunked-vs-tokenwise equality holds
+  // by construction.
+  rocm::BatchQ8KBlockGEMV(m.q_b.data, rocm::WeightTypeOf(m.q_b.type), s.q_resid,
+                          s.q_full, 1, m.q_b.rows, m.q_b.cols, stream_);
+  rocm::BatchMlaAbsorb(m.k_b.f32(), s.q_full, s.q_abs, 1, heads, c.kv_lora_rank,
+                       c.qk_nope_head_dim, stream_);
+  rocm::BatchMlaAttention(
+      s.q_abs, cache.latents, b_.sel, b_.counts,
+      c.indexer_top_k + c.indexer_kpool, m.v_b.f32(), s.attn_out_buf,
+      s.attn_probs, s.attn_weighted, 1, heads, c.kv_lora_rank,
+      c.qk_nope_head_dim, c.v_head_dim,
+      static_cast<float>(1.0 /
+                         std::sqrt(static_cast<double>(c.qk_nope_head_dim))),
+      stream_);
+  rocm::BatchQ8KBlockGEMV(m.out.data, rocm::WeightTypeOf(m.out.type),
+                          s.attn_out_buf, s.block_out, 1, m.out.rows,
+                          m.out.cols, stream_);
+  return SumPartial(layer, 0, session.position_, error_msg);
+}
+
+bool Executor::FfnBlock(Session& session, std::uint32_t layer,
+                        std::string* error_msg) const {
+  const Config& c = config();
+  const DeviceLayer& dl = slice_->layers()[layer];
+  const Scratch& s = s_;
+  if (dl.dense_ffn) {
+    rocm::BatchQ8KBlockGEMV(
+        dl.ffn_gate.data, rocm::WeightTypeOf(dl.ffn_gate.type), s.block_x,
+        s.ffn_gate_out, 1, dl.ffn_gate.rows, dl.ffn_gate.cols, stream_);
+    rocm::BatchQ8KBlockGEMV(dl.ffn_up.data, rocm::WeightTypeOf(dl.ffn_up.type),
+                            s.block_x, s.ffn_up_out, 1, dl.ffn_up.rows,
+                            dl.ffn_up.cols, stream_);
+    rocm::ClampedSwiglu(s.ffn_gate_out, s.ffn_up_out, s.ffn_act,
+                        dl.ffn_gate.rows, c.swiglu_limit, stream_);
+    rocm::BatchQ8KBlockGEMV(
+        dl.ffn_down.data, rocm::WeightTypeOf(dl.ffn_down.type), s.ffn_act,
+        s.block_out, 1, dl.ffn_down.rows, dl.ffn_down.cols, stream_);
+    return SumPartial(layer, 1, session.position_, error_msg);
+  }
+
+  // Routed MoE: the batched implementation, one token wide. Device
+  // routing, the same expert kernels and the same accumulation order as
+  // prefill, so the tokenwise and chunked paths agree byte-for-byte by
+  // construction.
+  if (!Check(hipMemcpyAsync(
+                 b_.block_x, s_.block_x,
+                 static_cast<std::size_t>(c.hidden_size) * sizeof(float),
+                 hipMemcpyDeviceToDevice, stream_),
+             "ffn handoff", error_msg)) {
+    return false;
+  }
+  if (!FfnBlockBatch(session, layer, 1, error_msg)) {
+    return false;
+  }
+  return Check(
+      hipMemcpyAsync(s_.block_out, b_.block_out,
+                     static_cast<std::size_t>(c.hidden_size) * sizeof(float),
+                     hipMemcpyDeviceToDevice, stream_),
+      "ffn return", error_msg);
+}
+
+bool Executor::Step(Session& session, std::int32_t token, float* logits,
+                    std::string* error_msg) const {
+  if (session.position_ >= session.capacity_) {
+    SetError(error_msg, "session position exceeds its capacity");
+    return false;
+  }
+  session.kda_cursor_ = 0;
+  session.dsa_cursor_ = 0;
+  const Config& c = config();
+  const Scratch& s = s_;
+  const std::uint32_t n = c.hc_count;
+  const std::uint32_t hidden = c.hidden_size;
+  const auto q8 = gufo::core::GgmlType::kQ8_0;
+
+  rocm::EmbedTokenStreams(slice_->token_embd().data,
+                          rocm::WeightTypeOf(slice_->token_embd().type), token,
+                          s.streams, hidden, n, stream_);
+  for (std::uint32_t layer = 0; layer < slice_->layer_count(); ++layer) {
+    const DeviceLayer& dl = slice_->layers()[layer];
+    for (int sub = 0; sub < 2; ++sub) {
+      const DeviceHc& hc = sub == 0 ? dl.hc_attn : dl.hc_ffn;
+      const DeviceTensor& norm = sub == 0 ? dl.attn_norm : dl.ffn_norm;
+      if (!Check(hipMemcpyAsync(
+                     s.residual, s.streams,
+                     static_cast<std::size_t>(n) * hidden * sizeof(float),
+                     hipMemcpyDeviceToDevice, stream_),
+                 "residual copy", error_msg)) {
+        return false;
+      }
+      rocm::RmsNormRows(s.streams, nullptr, s.flat, 1, n * hidden, 1, c.rms_eps,
+                        stream_);
+      rocm::F32Gemm(static_cast<const float*>(hc.fn.data), s.flat, s.mixes,
+                    c.HcMixDim(), n * hidden, stream_);
+      rocm::HcSinkhorn(s.mixes, static_cast<const float*>(hc.scale.data),
+                       static_cast<const float*>(hc.base.data), s.hc_pre,
+                       s.hc_post, s.hc_comb, n, c.hc_sinkhorn_iters, c.hc_eps,
+                       stream_);
+      rocm::HcCollapse(s.hc_pre, s.streams, s.collapsed, hidden, n, stream_);
+      rocm::RmsNormRows(s.collapsed, norm.f32(), s.block_x, 1, hidden, 1,
+                        c.rms_eps, stream_);
+      const bool ok = sub == 0 ? AttentionBlock(session, layer, error_msg)
+                               : FfnBlock(session, layer, error_msg);
+      if (!ok) {
+        return false;
+      }
+      rocm::HcCombine(s.hc_post, s.hc_comb, s.residual, s.block_out, s.streams,
+                      hidden, n, stream_);
+    }
+  }
+  rocm::MeanStreams(s.streams, s.collapsed, hidden, n, stream_);
+  rocm::RmsNormRows(s.collapsed, slice_->output_norm().f32(), s.normed, 1,
+                    hidden, 1, c.rms_eps, stream_);
+  gufo::hip::LaunchQ8KBlockGEMV(slice_->output().data, q8, s.normed, s.logits,
+                                slice_->output().rows, slice_->output().cols,
+                                stream_);
+  ++session.position_;
+  if (logits == nullptr) {
+    return true;
+  }
+  if (!Check(hipStreamSynchronize(stream_), "step drain", error_msg)) {
+    return false;
+  }
+  return Check(hipMemcpy(logits, s.logits,
+                         static_cast<std::size_t>(c.vocab_size) * sizeof(float),
+                         hipMemcpyDeviceToHost),
+               "logits copy", error_msg);
+}
+
+bool Executor::Prefill(Session& session, std::span<const std::int32_t> tokens,
+                       float* logits, std::string* error_msg) const {
+  const std::uint32_t chunk =
+      options_.prefill_chunk != 0 && options_.prefill_chunk <= kMaxBatch
+          ? options_.prefill_chunk
+          : kMaxBatch;
+  std::size_t done = 0;
+  while (done < tokens.size()) {
+    const std::size_t n = std::min<std::size_t>(chunk, tokens.size() - done);
+    if (!StepBatch(session, tokens.subspan(done, n),
+                   done + n == tokens.size() ? logits : nullptr, error_msg)) {
+      return false;
+    }
+    done += n;
+  }
+  return true;
+}
+
+bool Executor::SumPartialBatch(std::uint32_t layer, int sub,
+                               std::uint32_t first_token, std::uint32_t n,
+                               std::string* error_msg) const {
+  if (options_.all_reduce &&
+      !options_.all_reduce(b_.block_out, n, stream_, error_msg)) {
+    return false;
+  }
+  if (options_.block_observer) {
+    options_.block_observer(layer, sub, first_token, n, b_.block_out, stream_);
+  }
+  return true;
+}
+
+bool Executor::AttentionBlockBatch(Session& session, std::uint32_t layer,
+                                   std::uint32_t n,
+                                   std::string* error_msg) const {
+  const Config& c = config();
+  const DeviceLayer& dl = slice_->layers()[layer];
+  const distributed::TpPartition& p = slice_->partition();
+  const std::uint32_t heads = p.head_count;
+  const std::uint32_t dim = c.kda_head_dim;
+  const std::uint32_t inner = heads * dim;
+  const auto q8 = gufo::core::GgmlType::kQ8_0;
+  const BatchScratch& b = b_;
+
+  if (dl.linear) {
+    const DeviceKda& kd = dl.kda;
+    Session::Kda& state = session.kda_[session.kda_cursor_];
+    ++session.kda_cursor_;
+    // The q|k|v groups share one [n][3 * inner] buffer; the stride keeps
+    // every group's rows on the concatenated layout.
+    const std::size_t qkv_stride = 3 * static_cast<std::size_t>(inner);
+    rocm::BatchQ8KBlockGEMV(kd.q.data, rocm::WeightTypeOf(kd.q.type), b.block_x,
+                            b.qkv, n, kd.q.rows, kd.q.cols, stream_,
+                            qkv_stride);
+    rocm::BatchQ8KBlockGEMV(kd.k.data, rocm::WeightTypeOf(kd.k.type), b.block_x,
+                            b.qkv + inner, n, kd.k.rows, kd.k.cols, stream_,
+                            qkv_stride);
+    rocm::BatchQ8KBlockGEMV(kd.v.data, rocm::WeightTypeOf(kd.v.type), b.block_x,
+                            b.qkv + 2 * inner, n, kd.v.rows, kd.v.cols, stream_,
+                            qkv_stride);
+    rocm::BatchKdaConv(b.qkv, kd.conv_q.f32(), kd.conv_k.f32(), kd.conv_v.f32(),
+                       state.history, b.conv_out, n, inner, c.kda_conv_kernel,
+                       stream_);
+    rocm::BatchF32Gemm(kd.f_a.f32(), b.block_x, b.f_a_out, n, kd.f_a.rows,
+                       c.hidden_size, stream_);
+    rocm::BatchF32Gemm(kd.f_b.f32(), b.f_a_out, b.raw, n, kd.f_b.rows,
+                       kd.f_b.cols, stream_);
+    rocm::BatchF32Gemm(kd.beta.f32(), b.block_x, b.beta_row, n, kd.beta.rows,
+                       c.hidden_size, stream_);
+    rocm::BatchKdaGates(b.raw, kd.a.f32(), kd.dt_bias.f32(), b.beta_row,
+                        c.kda_gate_lower_bound, b.gate, b.beta, n, inner, dim,
+                        heads, stream_);
+    rocm::BatchKdaPrepare(b.conv_out, b.qn, b.kn, n, heads, dim, 1e-6F,
+                          stream_);
+    rocm::BatchKdaRecurrence(b.qn, b.kn, b.gate, b.beta, b.conv_out,
+                             state.state, b.core, n, heads, dim, stream_);
+    rocm::RmsNormRows(b.core, kd.o_norm.f32(), b.core_normed,
+                      static_cast<std::uint32_t>(n) * heads, inner, heads,
+                      c.rms_eps, stream_);
+    rocm::BatchF32Gemm(kd.g_a.f32(), b.block_x, b.g_a_out, n, kd.g_a.rows,
+                       c.hidden_size, stream_);
+    rocm::BatchF32Gemm(kd.g_b.f32(), b.g_a_out, b.raw, n, kd.g_b.rows,
+                       kd.g_b.cols, stream_);
+    rocm::SigmoidMul(b.core_normed, b.raw, b.gated,
+                     static_cast<std::size_t>(n) * inner, stream_);
+    rocm::BatchQ8KBlockGEMV(kd.out.data, rocm::WeightTypeOf(kd.out.type),
+                            b.gated, b.block_out, n, kd.out.rows, kd.out.cols,
+                            stream_);
+    return SumPartialBatch(layer, 0, session.position_, n, error_msg);
+  }
+
+  const DeviceDsa& m = dl.dsa;
+  const DeviceIndexer& idx = dl.indexer;
+  Session::Dsa& cache = session.dsa_[session.dsa_cursor_];
+  ++session.dsa_cursor_;
+  const std::uint32_t start = session.position_;
+  const std::uint32_t seen_base = start;
+  const std::uint32_t kpool = c.indexer_kpool;
+  const std::uint32_t idim = c.indexer_head_dim;
+  const std::uint32_t pools_before = start / kpool;
+  const std::uint32_t pools_after = (start + n) / kpool;
+
+  rocm::BatchF32Gemm(m.kv_a.f32(), b.block_x, b.latent_raw, n, m.kv_a.rows,
+                     c.hidden_size, stream_);
+  rocm::RmsNormRows(b.latent_raw, m.kv_a_norm.f32(), b.latent_normed, n,
+                    c.kv_lora_rank, 1, c.rms_eps, stream_);
+  rocm::BatchAppendRows(b.latent_normed, cache.latents, c.kv_lora_rank, start,
+                        n, stream_);
+  rocm::BatchQ8KBlockGEMV(m.q_a.data, rocm::WeightTypeOf(m.q_a.type), b.block_x,
+                          b.q_resid_raw, n, m.q_a.rows, m.q_a.cols, stream_);
+  rocm::RmsNormRows(b.q_resid_raw, m.q_a_norm.f32(), b.q_resid, n,
+                    c.q_lora_rank, 1, c.rms_eps, stream_);
+  rocm::BatchF32Gemm(idx.k.f32(), b.block_x, b.idx_k_raw, n, idx.k.rows,
+                     c.hidden_size, stream_);
+  rocm::BatchF32Gemm(idx.comp_gate.f32(), b.block_x, b.idx_g_raw, n,
+                     idx.comp_gate.rows, c.hidden_size, stream_);
+  // The pool rows live in [frontier | chunk]; a straddling pool reads the
+  // frontier prefix, later pools the chunk rows.
+  // The live frontier rows are the current incomplete pool's (start % kpool
+  // of them); row indices in [frontier | chunk] run 3 + p - start.
+  const std::uint32_t copied = start % kpool;
+  const std::size_t row_base =
+      static_cast<std::size_t>(static_cast<std::int64_t>(start) - 3);
+  if (copied != 0) {
+    if (!Check(hipMemcpyAsync(
+                   b.rows_keys + (3 - copied) * idim, cache.frontier_keys,
+                   static_cast<std::size_t>(copied) * idim * sizeof(float),
+                   hipMemcpyDeviceToDevice, stream_),
+               "frontier copy", error_msg) ||
+        !Check(hipMemcpyAsync(
+                   b.rows_gates + (3 - copied) * idim, cache.frontier_gates,
+                   static_cast<std::size_t>(copied) * idim * sizeof(float),
+                   hipMemcpyDeviceToDevice, stream_),
+               "frontier copy", error_msg)) {
+      return false;
+    }
+  }
+  rocm::BatchIndexerAppend(b.idx_k_raw, b.idx_g_raw, idx.k_norm.f32(),
+                           idx.k_norm_bias.f32(), b.rows_keys + 3 * idim,
+                           b.rows_gates + 3 * idim, n, idim, c.layer_norm_eps,
+                           stream_);
+  rocm::BatchIndexerPool(b.rows_keys, b.rows_gates, idx.comp_ape.f32(),
+                         cache.pooled, pools_before, pools_after - pools_before,
+                         row_base, kpool, idim, stream_);
+  // The frontier keeps the final incomplete pool's rows at slots
+  // [0, live); dead slots are zeroed like the tokenwise pool restart.
+  const std::uint32_t live = (start + n) % kpool;
+  if (live != 0) {
+    if (!Check(hipMemcpyAsync(
+                   cache.frontier_keys,
+                   b.rows_keys + static_cast<std::size_t>(3 + n - live) * idim,
+                   static_cast<std::size_t>(live) * idim * sizeof(float),
+                   hipMemcpyDeviceToDevice, stream_),
+               "frontier writeback", error_msg) ||
+        !Check(hipMemcpyAsync(
+                   cache.frontier_gates,
+                   b.rows_gates + static_cast<std::size_t>(3 + n - live) * idim,
+                   static_cast<std::size_t>(live) * idim * sizeof(float),
+                   hipMemcpyDeviceToDevice, stream_),
+               "frontier writeback", error_msg)) {
+      return false;
+    }
+  }
+  if (live < kpool) {
+    if (!Check(
+            hipMemsetAsync(
+                cache.frontier_keys + static_cast<std::size_t>(live) * idim, 0,
+                static_cast<std::size_t>(kpool - live) * idim * sizeof(float),
+                stream_),
+            "frontier clear", error_msg) ||
+        !Check(
+            hipMemsetAsync(
+                cache.frontier_gates + static_cast<std::size_t>(live) * idim, 0,
+                static_cast<std::size_t>(kpool - live) * idim * sizeof(float),
+                stream_),
+            "frontier clear", error_msg)) {
+      return false;
+    }
+  }
+  rocm::BatchF32Gemm(idx.q_b.f32(), b.q_resid, b.iq, n, idx.q_b.rows,
+                     idx.q_b.cols, stream_);
+  rocm::BatchF32Gemm(idx.proj.f32(), b.block_x, b.head_weights_raw, n,
+                     idx.proj.rows, c.hidden_size, stream_);
+  rocm::ScaleRows(
+      b.head_weights_raw, b.head_weights,
+      static_cast<float>(1.0 / std::sqrt(static_cast<double>(c.indexer_heads))),
+      static_cast<std::size_t>(n) * c.indexer_heads, stream_);
+  const std::uint32_t pools = pools_after;
+  if (pools > 0) {
+    rocm::BatchIndexerScores(
+        b.iq, cache.pooled, b.head_weights, b.scores, max_pools_batch_, n,
+        pools, kpool, seen_base, c.indexer_heads, idim,
+        static_cast<float>(1.0 / std::sqrt(static_cast<double>(idim))),
+        stream_);
+    // The tokenwise path leaves the final query's scores in the session
+    // scratch; mirror that so session bytes match across the two paths.
+    if (!Check(hipMemcpyAsync(cache.scores,
+                              b.scores + static_cast<std::size_t>(n - 1) *
+                                             max_pools_batch_,
+                              static_cast<std::size_t>(pools) * sizeof(float),
+                              hipMemcpyDeviceToDevice, stream_),
+               "scores mirror", error_msg)) {
+      return false;
+    }
+    const std::uint32_t select_pools = std::min(c.indexer_top_k / kpool, pools);
+    if (!rocm::BatchSelectPools(b.scores, max_pools_batch_, n, pools,
+                                select_pools, kpool, seen_base,
+                                c.indexer_top_k + c.indexer_kpool, b.sel,
+                                b.counts, stream_)) {
+      SetError(error_msg, "batch selection rejected the pool configuration");
+      return false;
+    }
+  } else {
+    // Fresh session: no completed pools exist, the queries select from the
+    // incomplete tail only; the kernel handles zero pools without scores.
+    if (!rocm::BatchSelectPools(b.scores, max_pools_batch_, n, 0, 0, kpool,
+                                seen_base, c.indexer_top_k + c.indexer_kpool,
+                                b.sel, b.counts, stream_)) {
+      SetError(error_msg, "fresh-session selection failed the kernel bounds");
+      return false;
+    }
+  }
+  rocm::BatchQ8KBlockGEMV(m.q_b.data, rocm::WeightTypeOf(m.q_b.type), b.q_resid,
+                          b.q_full, n, m.q_b.rows, m.q_b.cols, stream_);
+  rocm::BatchMlaAbsorb(m.k_b.f32(), b.q_full, b.q_abs, n, heads, c.kv_lora_rank,
+                       c.qk_nope_head_dim, stream_);
+  rocm::BatchMlaAttention(
+      b.q_abs, cache.latents, b.sel, b.counts,
+      c.indexer_top_k + c.indexer_kpool, m.v_b.f32(), b.attn_out, b.attn_probs,
+      b.attn_weighted, n, heads, c.kv_lora_rank, c.qk_nope_head_dim,
+      c.v_head_dim,
+      static_cast<float>(1.0 /
+                         std::sqrt(static_cast<double>(c.qk_nope_head_dim))),
+      stream_);
+  rocm::BatchQ8KBlockGEMV(m.out.data, rocm::WeightTypeOf(m.out.type),
+                          b.attn_out, b.block_out, n, m.out.rows, m.out.cols,
+                          stream_);
+  return SumPartialBatch(layer, 0, start, n, error_msg);
+}
+
+bool Executor::FfnBlockBatch(Session& session, std::uint32_t layer,
+                             std::uint32_t n, std::string* error_msg) const {
+  const Config& c = config();
+  const DeviceLayer& dl = slice_->layers()[layer];
+  const auto q8 = gufo::core::GgmlType::kQ8_0;
+  const BatchScratch& b = b_;
+  if (dl.dense_ffn) {
+    rocm::BatchQ8KBlockGEMV(
+        dl.ffn_gate.data, rocm::WeightTypeOf(dl.ffn_gate.type), b.block_x,
+        b.gate_out, n, dl.ffn_gate.rows, dl.ffn_gate.cols, stream_);
+    rocm::BatchQ8KBlockGEMV(dl.ffn_up.data, rocm::WeightTypeOf(dl.ffn_up.type),
+                            b.block_x, b.up_out, n, dl.ffn_up.rows,
+                            dl.ffn_up.cols, stream_);
+    rocm::ClampedSwiglu(b.gate_out, b.up_out, b.act,
+                        static_cast<std::size_t>(n) * dl.ffn_gate.rows,
+                        c.swiglu_limit, stream_);
+    rocm::BatchQ8KBlockGEMV(
+        dl.ffn_down.data, rocm::WeightTypeOf(dl.ffn_down.type), b.act,
+        b.block_out, n, dl.ffn_down.rows, dl.ffn_down.cols, stream_);
+    return SumPartialBatch(layer, 1, session.position_, n, error_msg);
+  }
+
+  // Device-side routing: the router GEMM feeds the selection kernel
+  // directly — sigmoid probabilities, noaux_tc selection with ties to the
+  // lower expert id and the normalized top-k weights, with no host
+  // readback. The router runs replicated on identical inputs, so both
+  // ranks choose identical experts without an exchange.
+  rocm::BatchF32Gemm(dl.router.f32(), b.block_x, b.router, n, dl.router.rows,
+                     c.hidden_size, stream_);
+  rocm::BatchRouterSelect(b.router, dl.router_bias.f32(), b.ids, b.expert_w, n,
+                          c.expert_count, c.experts_used, c.routed_scaling,
+                          stream_);
+  if (!Check(hipMemsetAsync(
+                 b.block_out, 0,
+                 static_cast<std::size_t>(n) * c.hidden_size * sizeof(float),
+                 stream_),
+             "zero moe accumulator", error_msg)) {
+    return false;
+  }
+  const std::size_t gate_stride =
+      static_cast<std::size_t>(dl.gate_exps.rows) *
+      gufo::quant::QuantizedRowBytes(dl.gate_exps.type, dl.gate_exps.cols);
+  const std::size_t down_stride =
+      static_cast<std::size_t>(dl.down_exps.rows) *
+      gufo::quant::QuantizedRowBytes(dl.down_exps.type, dl.down_exps.cols);
+  const auto gate_type = rocm::WeightTypeOf(dl.gate_exps.type);
+  const bool grouped =
+      rocm::BatchExpertQ8KGrouped(
+          dl.gate_exps.data, gate_type, b.ids, b.expert_bins, b.expert_ranks,
+          b.expert_pairs, b.block_x, b.expert_gate, n, c.experts_used,
+          gate_stride, dl.gate_exps.rows, dl.gate_exps.cols, c.hidden_size,
+          c.expert_count, stream_) &&
+      rocm::BatchExpertQ8KGrouped(
+          dl.up_exps.data, rocm::WeightTypeOf(dl.up_exps.type), b.ids,
+          b.expert_bins, b.expert_ranks, b.expert_pairs, b.block_x, b.expert_up,
+          n, c.experts_used, gate_stride, dl.up_exps.rows, dl.up_exps.cols,
+          c.hidden_size, c.expert_count, stream_);
+  if (!grouped) {
+    rocm::BatchExpertQ8KBlockGEMV(dl.gate_exps.data, gate_type, b.ids,
+                                  b.block_x, b.expert_gate, n, c.experts_used,
+                                  gate_stride, dl.gate_exps.rows,
+                                  dl.gate_exps.cols, stream_);
+    rocm::BatchExpertQ8KBlockGEMV(
+        dl.up_exps.data, rocm::WeightTypeOf(dl.up_exps.type), b.ids, b.block_x,
+        b.expert_up, n, c.experts_used, gate_stride, dl.up_exps.rows,
+        dl.up_exps.cols, stream_);
+  }
+  // The routed pairs need experts_used intermediate rows per token — a
+  // dedicated buffer, not b.act (sized for one FFN row per token).
+  rocm::ClampedSwiglu(
+      b.expert_gate, b.expert_up, b.expert_act,
+      static_cast<std::size_t>(n) * c.experts_used * dl.gate_exps.rows,
+      c.swiglu_limit, stream_);
+  const auto down_type = rocm::WeightTypeOf(dl.down_exps.type);
+  if (!rocm::BatchExpertQ8KGrouped(
+          dl.down_exps.data, down_type, b.ids, b.expert_bins, b.expert_ranks,
+          b.expert_pairs, b.expert_act, b.expert_down, n, c.experts_used,
+          down_stride, dl.down_exps.rows, dl.down_exps.cols, 1, c.expert_count,
+          stream_)) {
+    rocm::BatchExpertQ8KBlockGEMVPairDense(
+        dl.down_exps.data, down_type, b.ids, b.expert_act, b.expert_down, n,
+        c.experts_used, down_stride, dl.down_exps.rows, dl.down_exps.cols,
+        stream_);
+  }
+  for (std::uint32_t k = 0; k < c.experts_used; ++k) {
+    rocm::ScaleAddRowsWeighted(
+        b.block_out,
+        b.expert_down + static_cast<std::size_t>(k) * c.hidden_size,
+        b.expert_w + static_cast<std::size_t>(k) * n, n, c.hidden_size,
+        static_cast<std::size_t>(c.experts_used) * c.hidden_size, stream_);
+  }
+  const std::uint32_t shared_ff = slice_->partition().shared_ff_count;
+  rocm::BatchQ8KBlockGEMV(
+      dl.gate_shexp.data, rocm::WeightTypeOf(dl.gate_shexp.type), b.block_x,
+      b.gate_out, n, dl.gate_shexp.rows, dl.gate_shexp.cols, stream_);
+  rocm::BatchQ8KBlockGEMV(
+      dl.up_shexp.data, rocm::WeightTypeOf(dl.up_shexp.type), b.block_x,
+      b.up_out, n, dl.up_shexp.rows, dl.up_shexp.cols, stream_);
+  rocm::ClampedSwiglu(b.gate_out, b.up_out, b.act,
+                      static_cast<std::size_t>(n) * shared_ff, c.swiglu_limit,
+                      stream_);
+  // The shared down lands in the consumed expert_up buffer: expert_down
+  // is [token][slot][hidden] and a [t][hidden] write would alias routed
+  // pairs.
+  rocm::BatchQ8KBlockGEMV(
+      dl.down_shexp.data, rocm::WeightTypeOf(dl.down_shexp.type), b.act,
+      b.expert_up, n, dl.down_shexp.rows, dl.down_shexp.cols, stream_);
+  rocm::ScaleAddInto(b.block_out, b.expert_up, 1.0F,
+                     static_cast<std::size_t>(n) * c.hidden_size, stream_);
+  return SumPartialBatch(layer, 1, session.position_, n, error_msg);
+}
+
+bool Executor::StepBatch(Session& session, std::span<const std::int32_t> tokens,
+                         float* logits, std::string* error_msg) const {
+  if (tokens.empty() || tokens.size() > kMaxBatch) {
+    SetError(error_msg, "batch width is outside [1, kMaxBatch]");
+    return false;
+  }
+  if (session.position_ + tokens.size() > session.capacity_) {
+    SetError(error_msg, "batch would exceed the session capacity");
+    return false;
+  }
+  const std::uint32_t n = static_cast<std::uint32_t>(tokens.size());
+  session.kda_cursor_ = 0;
+  session.dsa_cursor_ = 0;
+  const Config& c = config();
+  // The batched indexer scores and selection kernels are bounded; reject
+  // an unsupported context up front, before any device state is touched.
+  const std::uint32_t pools_after = (session.position_ + n) / c.indexer_kpool;
+  if (pools_after > max_pools_batch_) {
+    SetError(error_msg, "session pool count exceeds the batch selection bound");
+    return false;
+  }
+  const BatchScratch& b = b_;
+  const std::uint32_t streams_n = c.hc_count;
+  const std::uint32_t hidden = c.hidden_size;
+  const auto q8 = gufo::core::GgmlType::kQ8_0;
+
+  if (!Check(hipMemcpyAsync(b.tokens, tokens.data(),
+                            tokens.size() * sizeof(std::int32_t),
+                            hipMemcpyHostToDevice, stream_),
+             "tokens upload", error_msg)) {
+    return false;
+  }
+  if (!rocm::BatchEmbedTokenStreams(
+          slice_->token_embd().data,
+          rocm::WeightTypeOf(slice_->token_embd().type), b.tokens, b.streams,
+          hidden, streams_n, n, stream_, error_msg)) {
+    return false;
+  }
+  for (std::uint32_t layer = 0; layer < slice_->layer_count(); ++layer) {
+    const DeviceLayer& dl = slice_->layers()[layer];
+    for (int sub = 0; sub < 2; ++sub) {
+      const DeviceHc& hc = sub == 0 ? dl.hc_attn : dl.hc_ffn;
+      const DeviceTensor& norm = sub == 0 ? dl.attn_norm : dl.ffn_norm;
+      if (!Check(hipMemcpyAsync(b.residual, b.streams,
+                                static_cast<std::size_t>(n) * streams_n *
+                                    hidden * sizeof(float),
+                                hipMemcpyDeviceToDevice, stream_),
+                 "residual copy", error_msg)) {
+        return false;
+      }
+      rocm::RmsNormRows(b.streams, nullptr, b.flat, n, streams_n * hidden, 1,
+                        c.rms_eps, stream_);
+      rocm::BatchF32Gemm(static_cast<const float*>(hc.fn.data), b.flat, b.mixes,
+                         n, c.HcMixDim(), streams_n * hidden, stream_);
+      rocm::BatchHcSinkhorn(b.mixes, static_cast<const float*>(hc.scale.data),
+                            static_cast<const float*>(hc.base.data), b.hc_pre,
+                            b.hc_post, b.hc_comb, streams_n, n,
+                            c.hc_sinkhorn_iters, c.hc_eps, stream_);
+      rocm::BatchHcCollapse(b.hc_pre, b.streams, b.collapsed, hidden, streams_n,
+                            n, stream_);
+      rocm::RmsNormRows(b.collapsed, norm.f32(), b.block_x, n, hidden, 1,
+                        c.rms_eps, stream_);
+      const bool ok = sub == 0
+                          ? AttentionBlockBatch(session, layer, n, error_msg)
+                          : FfnBlockBatch(session, layer, n, error_msg);
+      if (!ok) {
+        return false;
+      }
+      rocm::BatchHcCombine(b.hc_post, b.hc_comb, b.residual, b.block_out,
+                           b.streams, hidden, streams_n, n, stream_);
+    }
+  }
+  rocm::BatchMeanStreams(b.streams, b.collapsed, hidden, streams_n, n, stream_);
+  rocm::RmsNormRows(b.collapsed, slice_->output_norm().f32(), b.normed, n,
+                    hidden, 1, c.rms_eps, stream_);
+  gufo::hip::LaunchQ8KBlockGEMV(
+      slice_->output().data, q8,
+      b.normed + static_cast<std::size_t>(n - 1) * hidden, s_.logits,
+      slice_->output().rows, slice_->output().cols, stream_);
+  session.position_ += n;
+  if (logits == nullptr) {
+    return true;
+  }
+  if (!Check(hipStreamSynchronize(stream_), "batch drain", error_msg)) {
+    return false;
+  }
+  return Check(hipMemcpy(logits, s_.logits,
+                         static_cast<std::size_t>(c.vocab_size) * sizeof(float),
+                         hipMemcpyDeviceToHost),
+               "logits copy", error_msg);
+}
