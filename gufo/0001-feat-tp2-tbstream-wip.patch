+void EmbedTokenStreams(const void* table, WeightType type, std::int32_t token,
+                       float* streams, std::uint32_t hidden,
+                       std::uint32_t n_streams, hipStream_t stream) {
+  const unsigned grid = (hidden / 4 + kBlockThreads - 1) / kBlockThreads;
+  if (type == WeightType::kQ8_0) {
+    EmbedQ8Kernel<<<grid, kBlockThreads, 0, stream>>>(
+        static_cast<const Q8_0Block*>(table), token, streams, hidden,
+        n_streams);
+  } else {
+    EmbedF32Kernel<<<grid, kBlockThreads, 0, stream>>>(
+        static_cast<const float*>(table), token, streams, hidden, n_streams);
+  }
+}
+
+void RmsNormRows(const float* x, const float* gamma, float* out,
+                 std::uint32_t rows, std::uint32_t dim, std::uint32_t groups,
+                 float eps, hipStream_t stream) {
+  RmsNormKernel<<<rows, kBlockThreads, 0, stream>>>(x, gamma, out, rows, dim,
+                                                    groups, eps);
+}
