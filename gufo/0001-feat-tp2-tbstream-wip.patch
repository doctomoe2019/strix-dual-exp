new file mode 100644
index 0000000..822c0ec
--- /dev/null
+++ b/tools/bench/expert_ws_bench.hip
@@ -0,0 +1,1342 @@
+// Expert grouped-GEMM weight-stationary prototype (goal 2026-10-10
+// glm-prefill-250-vllm, phase 2).
+//
+// Reproduces BatchExpertGroupedKernel's shapes and routing, then sweeps two
+// restructured families against it on real Q4_K geometry:
+//
+//   V0  — verbatim copy of the landed kernel (kExpertTokens=16, kExpertK=512,
+//         kExpertWarps=16, kExpertRows=2): pair-tile outer, K inner, so each
+//         16-pair tile re-streams the expert's weights.
+//   A-* — bucket-resident accumulators: sums[Rows][B] live in registers across
+//         the whole K stream, weights decoded once per (row, K-tile) into
+//         registers, the bucket walked in StageB-wide LDS chunks inside the
+//         K-tile. One butterfly per (row, pair) at the end — per-(row, pair)
+//         lane partials and their visit order are exactly V0's, so A is
+//         bit-identical to V0 by construction (checked).
+//   Y-* — slab block: one block owns SlabRows rows of the expert, stages each
+//         x chunk once per K-tile and reuses it for every row group of the
+//         slab, flushing per-tile butterflies into y with a read-modify-write
+//         accumulate (y pre-zeroed). x traffic drops to (m/SlabRows)
+//         re-stages and weights to ceil(bucket/StageB) passes; the per-tile
+//         butterfly regrouping is chunked-vs-tokenwise identical by
+//         construction (checked n=N vs n=1 x N) but NOT bit-identical to V0.
+//
+// Usage: expert_ws_bench [iters] — prints per-(routing, width, shape, variant)
+// ms/call, bit-equality checks for A vs V0, and self-consistency for Y.
+
+#define ENGINE_ENABLE_HIP 1
+
+#include <hip/hip_runtime.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+#include "src/core/gguf_reader.hpp"
+#include "src/models/qwen/hip/quant_ops.hpp"
+
+namespace {
+
+using gufo::hip::QuantSub16;
+
+constexpr std::uint32_t kExperts = 288;
+constexpr std::uint32_t kSlots = 8;
+
+// ---------------------------------------------------------------------------
+// Routing layout helpers — verbatim from kernels_batch.hip.cpp.
+__global__ void ExpertZeroKernel(std::uint32_t* bins, std::uint32_t experts) {
+  for (std::uint32_t i = threadIdx.x; i < 2 * experts + 2; i += blockDim.x) {
+    bins[i] = 0;
+  }
+}
+
+__global__ void ExpertHistogramKernel(const std::int32_t* ids,
+                                      std::uint32_t* bins, std::uint32_t* ranks,
+                                      std::uint32_t count) {
+  const std::uint32_t i = blockIdx.x * blockDim.x + threadIdx.x;
+  if (i >= count) {
+    return;
+  }
+  const auto e = static_cast<std::uint32_t>(ids[i]);
+  ranks[i] = atomicAdd(&bins[e], 1u);
+}
+
+__global__ void ExpertPrefixKernel(std::uint32_t* bins, std::uint32_t experts) {
+  if (threadIdx.x == 0) {
+    std::uint32_t acc = 0;
+    for (std::uint32_t e = 0; e < experts; ++e) {
+      const std::uint32_t c = bins[e];
+      bins[e] = acc;
+      acc += c;
+    }
+    bins[experts] = acc;
+  }
+}
+
+__global__ void ExpertScatterKernel(const std::int32_t* ids,
+                                    const std::uint32_t* bins,
+                                    const std::uint32_t* ranks,
+                                    std::uint32_t* pairs, std::uint32_t count) {
+  const std::uint32_t i = blockIdx.x * blockDim.x + threadIdx.x;
+  if (i >= count) {
+    return;
+  }
+  pairs[bins[static_cast<std::uint32_t>(ids[i])] + ranks[i]] = i;
+}
+
+/// Tokenwise variant: one token's kSlots pairs carry GLOBAL pair indices
+/// (base + slot) so the grouped kernel's x-row derivation and y indexing see
+/// the same layout as an N-token chunked launch.
+__global__ void ExpertScatterTokenKernel(const std::int32_t* ids,
+                                         const std::uint32_t* bins,
+                                         const std::uint32_t* ranks,
+                                         std::uint32_t* pairs,
+                                         std::uint32_t token_base) {
+  const std::uint32_t i = threadIdx.x;
+  pairs[bins[static_cast<std::uint32_t>(ids[i])] + ranks[i]] =
+      token_base + i;
+}
+
+// ---------------------------------------------------------------------------
+// V0 — verbatim BatchExpertGroupedKernel (Q4_K/sub16 + Q8_0 paths).
+
+constexpr std::uint32_t kExpertTokens = 16;
+constexpr std::uint32_t kExpertK = 512;
+constexpr std::uint32_t kExpertWarps = 16;
+constexpr std::uint32_t kExpertRows = 2;
+
+__global__ __launch_bounds__(kExpertWarps * 32) void V0Kernel(
+    const void* w, std::uint32_t type, const std::uint32_t* bins,
+    const std::uint32_t* pairs, const float* x, float* y, std::uint32_t slots,
+    std::size_t expert_stride, std::uint32_t m, std::uint32_t k,
+    std::size_t x_stride) {
+  constexpr std::uint32_t kBlockStrideLocal = 34;
+  constexpr std::uint32_t kBlocksPerTile = kExpertK / 32;
+  __shared__ float staged[kExpertTokens][kBlockStrideLocal * kBlocksPerTile];
+  __shared__ std::size_t xrow[kExpertTokens];
+  const std::uint32_t e = blockIdx.y;
+  const std::uint32_t begin = bins[e];
+  const std::uint32_t end = bins[e + 1];
+  if (begin >= end) {
+    return;
+  }
+  const std::uint32_t lane = threadIdx.x & 31u;
+  const std::uint32_t warp = threadIdx.x >> 5u;
+  const std::uint32_t row0 = blockIdx.x * (kExpertWarps * kExpertRows) + warp;
+  const auto ggml_type = static_cast<gufo::core::GgmlType>(type);
+  const std::size_t qk = gufo::hip::QuantBlockQK(ggml_type);
+  const std::size_t block_bytes = gufo::hip::QuantBlockBytes(ggml_type);
+  const char* w_base =
+      static_cast<const char*>(w) + static_cast<std::size_t>(e) * expert_stride;
+  const std::size_t row_bytes_stride = k / qk * block_bytes;
+  const bool vec_ok = (k % 4 == 0) && (x_stride == 1 || x_stride % 4 == 0);
+  float sums[kExpertRows][kExpertTokens];
+  for (std::uint32_t base_pair = begin; base_pair < end;
+       base_pair += kExpertTokens) {
+    const std::uint32_t pcount = min(kExpertTokens, end - base_pair);
+    if (threadIdx.x < kExpertTokens) {
+      xrow[threadIdx.x] =
+          threadIdx.x < pcount
+              ? (x_stride == 1 ? static_cast<std::size_t>(
+                                     pairs[base_pair + threadIdx.x]) *
+                                     k
+                               : static_cast<std::size_t>(
+                                     pairs[base_pair + threadIdx.x] / slots) *
+                                     x_stride)
+              : 0;
+    }
+#pragma unroll
+    for (std::uint32_t r = 0; r < kExpertRows; ++r) {
+#pragma unroll
+      for (std::uint32_t t = 0; t < kExpertTokens; ++t) {
+        sums[r][t] = 0.0F;
+      }
+    }
+    __syncthreads();
+    for (std::uint32_t base = 0; base < k; base += kExpertK) {
+      const std::uint32_t tile = min(kExpertK, k - base);
+      if (vec_ok) {
+        for (std::uint32_t quad = threadIdx.x;
+             quad < kExpertTokens * kBlocksPerTile * 8;
+             quad += kExpertWarps * 32) {
+          const std::uint32_t t = quad / (kBlocksPerTile * 8);
+          const std::uint32_t e32 = (quad % (kBlocksPerTile * 8)) * 4;
+          float4 value = {0.0F, 0.0F, 0.0F, 0.0F};
+          if (t < pcount && e32 + 4 <= tile) {
+            value = *reinterpret_cast<const float4*>(x + xrow[t] + base + e32);
+          } else if (t < pcount && e32 < tile) {
+            value.x = e32 + 0 < tile ? x[xrow[t] + base + e32 + 0] : 0.0F;
+            value.y = e32 + 1 < tile ? x[xrow[t] + base + e32 + 1] : 0.0F;
+            value.z = e32 + 2 < tile ? x[xrow[t] + base + e32 + 2] : 0.0F;
+            value.w = e32 + 3 < tile ? x[xrow[t] + base + e32 + 3] : 0.0F;
+          }
+          float2* dst = reinterpret_cast<float2*>(
+              staged[t] + (e32 / 32) * kBlockStrideLocal + (e32 % 32));
+          dst[0] = make_float2(value.x, value.y);
+          dst[1] = make_float2(value.z, value.w);
+        }
+      } else {
+        for (std::uint32_t flat = threadIdx.x;
+             flat < kExpertTokens * kBlocksPerTile * 32;
+             flat += kExpertWarps * 32) {
+          const std::uint32_t t = flat / (kBlocksPerTile * 32);
+          const std::uint32_t e32 = flat % (kBlocksPerTile * 32);
+          float value = 0.0F;
+          if (t < pcount && e32 < tile) {
+            value = x[xrow[t] + base + e32];
+          }
+          staged[t][(e32 / 32) * kBlockStrideLocal + (e32 % 32)] = value;
+        }
+      }
+      __syncthreads();
+#pragma unroll
+      for (std::uint32_t r = 0; r < kExpertRows; ++r) {
+        const std::uint32_t row = row0 + r * kExpertWarps;
+        if (row >= m) {
+          continue;
+        }
+        const char* row_bytes = w_base + row * row_bytes_stride;
+        if (ggml_type == gufo::core::GgmlType::kQ8_0) {
+          const auto* row_blocks =
+              reinterpret_cast<const gufo::hip::Q8_0Block*>(row_bytes);
+          const std::uint32_t b = base / 32 + lane;
+          if (b < (base + tile) / 32) {
+            const float d_w = __half2float(row_blocks[b].d);
+            const std::int8_t* wq = row_blocks[b].qs;
+            float wqf[32];
+#pragma unroll
+            for (int j = 0; j < 32; ++j) {
+              wqf[j] = static_cast<float>(wq[j]);
+            }
+#pragma unroll
+            for (std::uint32_t t = 0; t < kExpertTokens; ++t) {
+              if (t >= pcount) {
+                continue;
+              }
+              const float2* xv = reinterpret_cast<const float2*>(
+                  staged[t] + lane * kBlockStrideLocal);
+              float dot = 0.0F;
+#pragma unroll
+              for (int p = 0; p < 16; ++p) {
+                const float2 pair = xv[p];
+                dot += wqf[2 * p] * pair.x;
+                dot += wqf[2 * p + 1] * pair.y;
+              }
+              sums[r][t] += d_w * dot;
+            }
+          }
+        } else {
+          const std::uint32_t sub_base = base / 16;
+          for (std::uint32_t sb = sub_base + lane;
+               sb < sub_base + kBlocksPerTile * 2 && sb * 16 < base + tile;
+               sb += 32) {
+            gufo::hip::QuantSub16 sub;
+            gufo::hip::DecodeQuantSub16(ggml_type, row_bytes, sb, sub);
+            const std::uint32_t run = sb * 16 - base;
+            const std::uint32_t pad =
+                (run >> 5) * kBlockStrideLocal + (run & 31);
+            float qf[16];
+#pragma unroll
+            for (int j = 0; j < 16; ++j) {
+              qf[j] = static_cast<float>(sub.q[j]);
+            }
+#pragma unroll
+            for (std::uint32_t t = 0; t < kExpertTokens; ++t) {
+              if (t >= pcount) {
+                continue;
+              }
+              const float2* xv =
+                  reinterpret_cast<const float2*>(staged[t] + pad);
+              float dot = 0.0F;
+              float xsum = 0.0F;
+#pragma unroll
+              for (int p = 0; p < 8; ++p) {
+                const float2 pair = xv[p];
+                dot += qf[2 * p] * pair.x;
+                dot += qf[2 * p + 1] * pair.y;
+                xsum += pair.x;
+                xsum += pair.y;
+              }
+              sums[r][t] += (sub.scale * dot) - (sub.offset * xsum);
+            }
+          }
+        }
+      }
+      __syncthreads();
+    }
+#pragma unroll
+    for (std::uint32_t r = 0; r < kExpertRows; ++r) {
+      const std::uint32_t row = row0 + r * kExpertWarps;
+      if (row >= m) {
+        continue;
+      }
+#pragma unroll
+      for (std::uint32_t t = 0; t < kExpertTokens; ++t) {
+        if (t >= pcount) {
+          continue;
+        }
+        float sum = sums[r][t];
+        for (int off = 16; off > 0; off >>= 1) {
+          sum += __shfl_xor(sum, off);
+        }
+        if (lane == 0) {
+          y[static_cast<std::size_t>(pairs[base_pair + t]) * m + row] = sum;
+        }
+      }
+    }
+  }
+}
+
+// ---------------------------------------------------------------------------
+// A-family (v3) — compile-time-specialized (Sub16-only instantiation drops
+// the Q8_0 branch and its wqf[32] registers; the Vec instantiation drops the
+// scalar staging path), bucket-resident sums[Rows][B] with static indices,
+// weights re-decoded per chunk from L1. Bit-identical to V0 per (row, pair).
+
+template <std::uint32_t B, std::uint32_t StageB, std::uint32_t Warps,
+          std::uint32_t Rows, bool kSub16, bool kVec>
+__global__ __launch_bounds__(Warps * 32) void AKKernel(
+    const void* w, std::uint32_t type, const std::uint32_t* bins,
+    const std::uint32_t* pairs, const float* x, float* y, std::uint32_t slots,
+    std::size_t expert_stride, std::uint32_t m, std::uint32_t k,
+    std::size_t x_stride) {
+  constexpr std::uint32_t kKTile = 512;
+  constexpr std::uint32_t kBlockStrideLocal = 34;
+  constexpr std::uint32_t kBlocksPerTile = kKTile / 32;
+  constexpr std::uint32_t kChunks = B / StageB;
+  static_assert(B % StageB == 0, "bucket must tile into staging chunks");
+  __shared__ float staged[StageB][kBlockStrideLocal * kBlocksPerTile];
+  __shared__ std::size_t xrow[StageB];
+  const std::uint32_t e = blockIdx.y;
+  const std::uint32_t begin = bins[e];
+  const std::uint32_t end = bins[e + 1];
+  if (begin >= end) {
+    return;
+  }
+  const std::uint32_t lane = threadIdx.x & 31u;
+  const std::uint32_t warp = threadIdx.x >> 5u;
+  const std::uint32_t row0 = blockIdx.x * (Warps * Rows) + warp;
+  const auto ggml_type = static_cast<gufo::core::GgmlType>(type);
+  const std::size_t qk = gufo::hip::QuantBlockQK(ggml_type);
+  const std::size_t block_bytes = gufo::hip::QuantBlockBytes(ggml_type);
+  const char* w_base =
+      static_cast<const char*>(w) + static_cast<std::size_t>(e) * expert_stride;
+  const std::size_t row_bytes_stride = k / qk * block_bytes;
+  float sums[Rows][B];
+  for (std::uint32_t base_pair = begin; base_pair < end; base_pair += B) {
+    const std::uint32_t pcount = min(B, end - base_pair);
+#pragma unroll
+    for (std::uint32_t r = 0; r < Rows; ++r) {
+#pragma unroll
+      for (std::uint32_t t = 0; t < B; ++t) {
+        sums[r][t] = 0.0F;
+      }
+    }
+    __syncthreads();
+    for (std::uint32_t base = 0; base < k; base += kKTile) {
+      const std::uint32_t tile = min(kKTile, k - base);
+#pragma unroll
+      for (std::uint32_t ci = 0; ci < kChunks; ++ci) {
+        const std::uint32_t cbase = ci * StageB;
+        if (cbase >= pcount) {
+          break;
+        }
+        const std::uint32_t scount = min(StageB, pcount - cbase);
+        if (threadIdx.x < StageB) {
+          xrow[threadIdx.x] =
+              threadIdx.x < scount
+                  ? (x_stride == 1
+                         ? static_cast<std::size_t>(
+                               pairs[base_pair + cbase + threadIdx.x]) * k
+                         : static_cast<std::size_t>(
+                               pairs[base_pair + cbase + threadIdx.x] / slots) *
+                               x_stride)
+                  : 0;
+        }
+        __syncthreads();
+        if (kVec) {
+          for (std::uint32_t quad = threadIdx.x;
+               quad < StageB * kBlocksPerTile * 8; quad += Warps * 32) {
+            const std::uint32_t t = quad / (kBlocksPerTile * 8);
+            const std::uint32_t e32 = (quad % (kBlocksPerTile * 8)) * 4;
+            float4 value = {0.0F, 0.0F, 0.0F, 0.0F};
+            if (t < scount && e32 + 4 <= tile) {
+              value =
+                  *reinterpret_cast<const float4*>(x + xrow[t] + base + e32);
+            } else if (t < scount && e32 < tile) {
+              value.x = e32 + 0 < tile ? x[xrow[t] + base + e32 + 0] : 0.0F;
+              value.y = e32 + 1 < tile ? x[xrow[t] + base + e32 + 1] : 0.0F;
+              value.z = e32 + 2 < tile ? x[xrow[t] + base + e32 + 2] : 0.0F;
+              value.w = e32 + 3 < tile ? x[xrow[t] + base + e32 + 3] : 0.0F;
+            }
+            float2* dst = reinterpret_cast<float2*>(
+                staged[t] + (e32 / 32) * kBlockStrideLocal + (e32 % 32));
+            dst[0] = make_float2(value.x, value.y);
+            dst[1] = make_float2(value.z, value.w);
+          }
+        } else {
+          for (std::uint32_t flat = threadIdx.x;
+               flat < StageB * kBlocksPerTile * 32; flat += Warps * 32) {
+            const std::uint32_t t = flat / (kBlocksPerTile * 32);
+            const std::uint32_t e32 = flat % (kBlocksPerTile * 32);
+            float value = 0.0F;
+            if (t < scount && e32 < tile) {
+              value = x[xrow[t] + base + e32];
+            }
+            staged[t][(e32 / 32) * kBlockStrideLocal + (e32 % 32)] = value;
+          }
+        }
+        __syncthreads();
+#pragma unroll
+        for (std::uint32_t r = 0; r < Rows; ++r) {
+          const std::uint32_t row = row0 + r * Warps;
+          if (row >= m) {
+            continue;
+          }
+          const char* row_bytes = w_base + row * row_bytes_stride;
+          if (kSub16) {
+            for (std::uint32_t sb = base / 16 + lane;
+                 sb < base / 16 + kBlocksPerTile * 2 && sb * 16 < base + tile;
+                 sb += 32) {
+              gufo::hip::QuantSub16 sub;
+              gufo::hip::DecodeQuantSub16(ggml_type, row_bytes, sb, sub);
+              const std::uint32_t run = sb * 16 - base;
+              const std::uint32_t pad =
+                  (run >> 5) * kBlockStrideLocal + (run & 31);
+              float qf[16];
+#pragma unroll
+              for (int j = 0; j < 16; ++j) {
+                qf[j] = static_cast<float>(sub.q[j]);
+              }
+#pragma unroll
+              for (std::uint32_t t = 0; t < StageB; ++t) {
+                if (t >= scount) {
+                  continue;
+                }
+                const float2* xv =
+                    reinterpret_cast<const float2*>(staged[t] + pad);
+                float dot = 0.0F;
+                float xsum = 0.0F;
+#pragma unroll
+                for (int p = 0; p < 8; ++p) {
+                  const float2 pair = xv[p];
+                  dot += qf[2 * p] * pair.x;
+                  dot += qf[2 * p + 1] * pair.y;
+                  xsum += pair.x;
+                  xsum += pair.y;
+                }
+                sums[r][cbase + t] += (sub.scale * dot) - (sub.offset * xsum);
+              }
+            }
+          } else {
+            const auto* row_blocks =
+                reinterpret_cast<const gufo::hip::Q8_0Block*>(row_bytes);
+            const std::uint32_t b = base / 32 + lane;
+            if (b < (base + tile) / 32) {
+              const float d_w = __half2float(row_blocks[b].d);
+              const std::int8_t* wq = row_blocks[b].qs;
+              float wqf[32];
+#pragma unroll
+              for (int j = 0; j < 32; ++j) {
+                wqf[j] = static_cast<float>(wq[j]);
+              }
+#pragma unroll
+              for (std::uint32_t t = 0; t < StageB; ++t) {
+                if (t >= scount) {
+                  continue;
+                }
+                const float2* xv = reinterpret_cast<const float2*>(
+                    staged[t] + lane * kBlockStrideLocal);
+                float dot = 0.0F;
+#pragma unroll
+                for (int p = 0; p < 16; ++p) {
+                  const float2 pair = xv[p];
+                  dot += wqf[2 * p] * pair.x;
+                  dot += wqf[2 * p + 1] * pair.y;
+                }
+                sums[r][cbase + t] += d_w * dot;
+              }
+            }
+          }
+        }
+        __syncthreads();
+      }
+    }
+#pragma unroll
+    for (std::uint32_t r = 0; r < Rows; ++r) {
+      const std::uint32_t row = row0 + r * Warps;
+      if (row >= m) {
+        continue;
+      }
+#pragma unroll
+      for (std::uint32_t t = 0; t < B; ++t) {
+        if (t >= pcount) {
+          continue;
+        }
+        float sum = sums[r][t];
+        for (int off = 16; off > 0; off >>= 1) {
+          sum += __shfl_xor(sum, off);
+        }
+        if (lane == 0) {
+          y[static_cast<std::size_t>(pairs[base_pair + t]) * m + row] = sum;
+        }
+      }
+    }
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Y-family — slab block: SlabRows rows of one expert per block. Each K-tile
+// stages every StageB-wide x chunk once and reuses it for all row groups of
+// the slab; per-tile butterflies accumulate into y (read-modify-write, y is
+// pre-zeroed). x restage factor m/SlabRows, weight passes ceil(bucket/StageB).
+
+template <std::uint32_t StageB, std::uint32_t Warps, std::uint32_t Rows,
+          std::uint32_t SlabRows>
+__global__ __launch_bounds__(Warps * 32) void YSlabKernel(
+    const void* w, std::uint32_t type, const std::uint32_t* bins,
+    const std::uint32_t* pairs, const float* x, float* y, std::uint32_t slots,
+    std::size_t expert_stride, std::uint32_t m, std::uint32_t k,
+    std::size_t x_stride) {
+  constexpr std::uint32_t kKTile = 512;
+  constexpr std::uint32_t kBlockStrideLocal = 34;
+  constexpr std::uint32_t kBlocksPerTile = kKTile / 32;
+  constexpr std::uint32_t kGroups = SlabRows / (Warps * Rows);
+  __shared__ float staged[StageB][kBlockStrideLocal * kBlocksPerTile];
+  __shared__ std::size_t xrow[StageB];
+  const std::uint32_t e = blockIdx.y;
+  const std::uint32_t begin = bins[e];
+  const std::uint32_t end = bins[e + 1];
+  if (begin >= end) {
+    return;
+  }
+  const std::uint32_t lane = threadIdx.x & 31u;
+  const std::uint32_t warp = threadIdx.x >> 5u;
+  const auto ggml_type = static_cast<gufo::core::GgmlType>(type);
+  const std::size_t qk = gufo::hip::QuantBlockQK(ggml_type);
+  const std::size_t block_bytes = gufo::hip::QuantBlockBytes(ggml_type);
+  const char* w_base =
+      static_cast<const char*>(w) + static_cast<std::size_t>(e) * expert_stride;
+  const std::size_t row_bytes_stride = k / qk * block_bytes;
+  const bool vec_ok = (k % 4 == 0) && (x_stride == 1 || x_stride % 4 == 0);
+  const std::uint32_t total = end - begin;
+  for (std::uint32_t base = 0; base < k; base += kKTile) {
+    const std::uint32_t tile = min(kKTile, k - base);
+    for (std::uint32_t chunk = 0; chunk < total; chunk += StageB) {
+      const std::uint32_t scount = min(StageB, total - chunk);
+      if (threadIdx.x < StageB) {
+        xrow[threadIdx.x] =
+            threadIdx.x < scount
+                ? (x_stride == 1
+                       ? static_cast<std::size_t>(
+                             pairs[begin + chunk + threadIdx.x]) *
+                             k
+                       : static_cast<std::size_t>(
+                             pairs[begin + chunk + threadIdx.x] / slots) *
+                             x_stride)
+                : 0;
+      }
+      __syncthreads();
+      if (vec_ok) {
+        for (std::uint32_t quad = threadIdx.x;
+             quad < StageB * kBlocksPerTile * 8; quad += Warps * 32) {
+          const std::uint32_t t = quad / (kBlocksPerTile * 8);
+          const std::uint32_t e32 = (quad % (kBlocksPerTile * 8)) * 4;
+          float4 value = {0.0F, 0.0F, 0.0F, 0.0F};
+          if (t < scount && e32 + 4 <= tile) {
+            value = *reinterpret_cast<const float4*>(x + xrow[t] + base + e32);
+          } else if (t < scount && e32 < tile) {
+            value.x = e32 + 0 < tile ? x[xrow[t] + base + e32 + 0] : 0.0F;
+            value.y = e32 + 1 < tile ? x[xrow[t] + base + e32 + 1] : 0.0F;
+            value.z = e32 + 2 < tile ? x[xrow[t] + base + e32 + 2] : 0.0F;
+            value.w = e32 + 3 < tile ? x[xrow[t] + base + e32 + 3] : 0.0F;
+          }
+          float2* dst = reinterpret_cast<float2*>(
+              staged[t] + (e32 / 32) * kBlockStrideLocal + (e32 % 32));
+          dst[0] = make_float2(value.x, value.y);
+          dst[1] = make_float2(value.z, value.w);
+        }
+      } else {
+        for (std::uint32_t flat = threadIdx.x;
+             flat < StageB * kBlocksPerTile * 32; flat += Warps * 32) {
+          const std::uint32_t t = flat / (kBlocksPerTile * 32);
+          const std::uint32_t e32 = flat % (kBlocksPerTile * 32);
+          float value = 0.0F;
+          if (t < scount && e32 < tile) {
+            value = x[xrow[t] + base + e32];
+          }
+          staged[t][(e32 / 32) * kBlockStrideLocal + (e32 % 32)] = value;
+        }
+      }
+      __syncthreads();
+      for (std::uint32_t g = 0; g < kGroups; ++g) {
+        const std::uint32_t row0 =
+            blockIdx.x * SlabRows + g * (Warps * Rows) + warp;
+        float sums[Rows][StageB];
+#pragma unroll
+        for (std::uint32_t r = 0; r < Rows; ++r) {
+#pragma unroll
+          for (std::uint32_t t = 0; t < StageB; ++t) {
+            sums[r][t] = 0.0F;
+          }
+        }
+#pragma unroll
+        for (std::uint32_t r = 0; r < Rows; ++r) {
+          const std::uint32_t row = row0 + r * Warps;
+          if (row >= m) {
+            continue;
+          }
+          const char* row_bytes = w_base + row * row_bytes_stride;
+          if (ggml_type == gufo::core::GgmlType::kQ8_0) {
+            const auto* row_blocks =
+                reinterpret_cast<const gufo::hip::Q8_0Block*>(row_bytes);
+            const std::uint32_t b = base / 32 + lane;
+            if (b < (base + tile) / 32) {
+              const float d_w = __half2float(row_blocks[b].d);
+              const std::int8_t* wq = row_blocks[b].qs;
+              float wqf[32];
+#pragma unroll
+              for (int j = 0; j < 32; ++j) {
+                wqf[j] = static_cast<float>(wq[j]);
+              }
+              const std::uint32_t run = lane * 32;
+              const std::uint32_t pad =
+                  (run >> 5) * kBlockStrideLocal + (run & 31);
+#pragma unroll
+              for (std::uint32_t t = 0; t < StageB; ++t) {
+                if (t >= scount) {
+                  continue;
+                }
+                const float2* xv =
+                    reinterpret_cast<const float2*>(staged[t] + pad);
+                float dot = 0.0F;
+#pragma unroll
+                for (int p = 0; p < 16; ++p) {
+                  const float2 pair = xv[p];
+                  dot += wqf[2 * p] * pair.x;
+                  dot += wqf[2 * p + 1] * pair.y;
+                }
+                sums[r][t] += d_w * dot;
+              }
+            }
+          } else {
+            for (std::uint32_t sb = base / 16 + lane;
+                 sb < base / 16 + kBlocksPerTile * 2 && sb * 16 < base + tile;
+                 sb += 32) {
+              gufo::hip::QuantSub16 sub;
+              gufo::hip::DecodeQuantSub16(ggml_type, row_bytes, sb, sub);
+              const std::uint32_t run = sb * 16 - base;
+              const std::uint32_t pad =
+                  (run >> 5) * kBlockStrideLocal + (run & 31);
+              float qf[16];
+#pragma unroll
+              for (int j = 0; j < 16; ++j) {
+                qf[j] = static_cast<float>(sub.q[j]);
+              }
+#pragma unroll
+              for (std::uint32_t t = 0; t < StageB; ++t) {
+                if (t >= scount) {
+                  continue;
+                }
+                const float2* xv =
+                    reinterpret_cast<const float2*>(staged[t] + pad);
+                float dot = 0.0F;
+                float xsum = 0.0F;
+#pragma unroll
+                for (int p = 0; p < 8; ++p) {
+                  const float2 pair = xv[p];
+                  dot += qf[2 * p] * pair.x;
+                  dot += qf[2 * p + 1] * pair.y;
+                  xsum += pair.x;
+                  xsum += pair.y;
+                }
+                sums[r][t] += (sub.scale * dot) - (sub.offset * xsum);
+              }
+            }
+          }
+        }
+#pragma unroll
+        for (std::uint32_t r = 0; r < Rows; ++r) {
+          const std::uint32_t row = row0 + r * Warps;
+          if (row >= m) {
+            continue;
+          }
+#pragma unroll
+          for (std::uint32_t t = 0; t < StageB; ++t) {
+            if (t >= scount) {
+              continue;
+            }
+            float sum = sums[r][t];
+            for (int off = 16; off > 0; off >>= 1) {
+              sum += __shfl_xor(sum, off);
+            }
+            if (lane == 0) {
+              float* slot =
+                  y + static_cast<std::size_t>(pairs[begin + chunk + t]) * m +
+                  row;
+              *slot += sum;
+            }
+          }
+        }
+      }
+      __syncthreads();
+    }
+  }
+}
