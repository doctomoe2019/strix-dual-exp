@@ -0,0 +1,87 @@
+# Small header-contract checks first; full-model qualification and probes
+# are built explicitly so routine iterations stay focused.
+add_custom_target(glm5_next_tests)
+
+function(add_glm5_next_test name labels)
+  set(target glm5_next_${name}_test)
+  add_executable(${target} ${name}_test.cpp)
+  target_link_libraries(${target} PRIVATE gufo_glm5_next)
+  add_test(NAME glm5_next.${name} COMMAND ${target})
+  set_tests_properties(glm5_next.${name} PROPERTIES
+    LABELS "glm5_next;${labels}")
+  add_dependencies(glm5_next_tests ${target})
+endfunction()
+
+add_glm5_next_test(config "cpu")
+add_glm5_next_test(tp_plan "cpu")
+add_glm5_next_test(tp_partition "cpu")
+add_glm5_next_test(reference "cpu")
+add_glm5_next_test(tokenizer "cpu")
+add_glm5_next_test(chat_template "cpu")
+
+# Opens a real GLM-5.3-Flash GGUF, binds every tensor and prints the TP=1
+# and TP=2 ledgers. Runs on demand against the pinned artifact.
+add_executable(glm5_next_inventory_probe EXCLUDE_FROM_ALL inventory_probe.cpp)
+target_link_libraries(glm5_next_inventory_probe PRIVATE gufo_glm5_next)
+
+# Encodes the official tokenizer.json goldens through the artifact's
+# vocabulary (all tokenizer metadata lives in shard one).
+add_executable(glm5_next_tokenizer_probe EXCLUDE_FROM_ALL tokenizer_probe.cpp)
+target_link_libraries(glm5_next_tokenizer_probe PRIVATE gufo_glm5_next)
+
+# Scalar-reference logits over the real artifact; the P2 slice oracle.
+add_executable(glm5_next_reference_probe EXCLUDE_FROM_ALL reference_probe.cpp)
+target_link_libraries(glm5_next_reference_probe PRIVATE gufo_glm5_next)
+set_source_files_properties(reference_probe.cpp PROPERTIES COMPILE_OPTIONS
+  "-O2")
+
+if (ENGINE_ENABLE_HIP)
+  # P2.1: uploads the real-weight slice and cross-checks the ledger.
+  add_executable(glm5_next_slice_probe EXCLUDE_FROM_ALL slice_probe.cpp)
+  target_link_libraries(glm5_next_slice_probe PRIVATE gufo_glm5_next)
+
+  # P2.2: embedding -> mHC -> norm -> combine chain + vocabulary head over
+  # the real slice, against the CPU oracle's deep fixtures.
+  add_executable(glm5_next_mhc_ops_test EXCLUDE_FROM_ALL mhc_ops_test.cpp)
+  target_link_libraries(glm5_next_mhc_ops_test PRIVATE gufo_glm5_next)
+
+  # P2.3: the real KDA attention path integrated into the chain.
+  add_executable(glm5_next_kda_ops_test EXCLUDE_FROM_ALL kda_ops_test.cpp)
+  target_link_libraries(glm5_next_kda_ops_test PRIVATE gufo_glm5_next)
+
+  # P2.4/P2.5: the real DSA indexer + latent MLA path and the real
+  # dense/MoE FFN — together the full four-layer slice executor.
+  add_executable(glm5_next_dsa_ops_test EXCLUDE_FROM_ALL dsa_ops_test.cpp)
+  target_link_libraries(glm5_next_dsa_ops_test PRIVATE gufo_glm5_next)
+
+  # P3.2: TP partition load with per-tensor byte verification.
