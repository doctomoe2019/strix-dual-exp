+bool ReferenceModel::DsaStep(std::uint32_t layer, const float* x,
+float* out, std::string* error) {
+  (void)error;
+  const Config& c = *config_;
+  const DsaWeights& m = weights_->layers[layer].dsa;
+  const IndexerWeights& idx = weights_->layers[layer].indexer;
+  DsaState& state = dsa_[layer];
+  const std::uint32_t heads = c.head_count;
+  const std::uint32_t query_dim = c.MlaQueryDim();
+  const std::uint32_t idim = c.indexer_head_dim;
+  const std::uint32_t kpool = c.indexer_kpool;
+  const std::uint32_t tokens = position_ + 1;
+
+  // Query residual and the normalized latent, which is the whole MLA
+  // per-token cache: k_b/v_b live in the absorbed layout, so scores run
+  // as absorbed dots against the latent and v_b expands the
+  // probability-weighted latent after attention.
+  std::vector<float> q_resid(c.q_lora_rank);
+  for (std::uint32_t r = 0; r < c.q_lora_rank; ++r) {
+    q_resid[r] = DotTensorRow(m.q_a, r, 0, {x, c.hidden_size});
+  }
+  std::vector<float> q_norm(c.q_lora_rank);
+  DequantTensorRow(m.q_a_norm, 0, 0, q_norm.data());
+  RmsNormInto(q_resid, q_norm, c.rms_eps, q_resid);
+  std::vector<float> latent(c.kv_lora_rank);
+  for (std::uint32_t r = 0; r < c.kv_lora_rank; ++r) {
+    latent[r] = DotTensorRow(m.kv_a, r, 0, {x, c.hidden_size});
+  }
+  std::vector<float> kv_norm(c.kv_lora_rank);
+  DequantTensorRow(m.kv_a_norm, 0, 0, kv_norm.data());
+  RmsNormInto(latent, kv_norm, c.rms_eps, latent);
+  state.latents.insert(state.latents.end(), latent.begin(), latent.end());
+
+  // Indexer per-token cache: LayerNormed key and compression gate.
+  {
+    std::vector<float> key(idim);
+    for (std::uint32_t d = 0; d < idim; ++d) {
+      key[d] = DotTensorRow(idx.k, d, 0, {x, c.hidden_size});
+    }
+    double mean = 0.0;
+    for (float v : key) {
+      mean += v;
+    }
+    mean /= idim;
+    double var = 0.0;
+    for (float v : key) {
+      var += static_cast<double>(v - mean) * (v - mean);
+    }
+    const float inv = static_cast<float>(
+    1.0F / std::sqrt(var / idim + c.layer_norm_eps));
+    std::vector<float> ln_w(idim);
+    std::vector<float> ln_b(idim);
+    DequantTensorRow(idx.k_norm, 0, 0, ln_w.data());
+    DequantTensorRow(idx.k_norm_bias, 0, 0, ln_b.data());
+    for (std::uint32_t d = 0; d < idim; ++d) {
+      state.index_keys.push_back(ln_w[d] * (key[d] * inv) + ln_b[d]);
+    }
+    for (std::uint32_t d = 0; d < idim; ++d) {
+      state.index_gates.push_back(
+      DotTensorRow(idx.comp_gate, d, 0, {x, c.hidden_size}));
+    }
+  }
+
+  // Complete one pool when this token closes it.
+  if (tokens % kpool == 0) {
+    const std::uint32_t pool = tokens / kpool - 1;
+    std::vector<float> ape(kpool * idim);
+    for (std::uint32_t j = 0; j < kpool; ++j) {
+      DequantTensorRow(idx.comp_ape, j, 0, ape.data() + j * idim);
+    }
+    std::vector<float> pooled(idim, 0.0F);
+    std::vector<float> logits(kpool);
+    for (std::uint32_t d = 0; d < idim; ++d) {
+      float max_value = -std::numeric_limits<float>::infinity();
+      for (std::uint32_t j = 0; j < kpool; ++j) {
+        logits[j] = state.index_gates[(pool * kpool + j) * idim + d] +
+        ape[j * idim + d];
+        max_value = std::max(max_value, logits[j]);
+      }
+      double denom = 0.0;
+      for (std::uint32_t j = 0; j < kpool; ++j) {
+        denom += std::exp(static_cast<double>(logits[j] - max_value));
+      }
+      for (std::uint32_t j = 0; j < kpool; ++j) {
+        const float prob = static_cast<float>(
+        std::exp(static_cast<double>(logits[j] - max_value)) / denom);
+        pooled[d] +=
+        prob * state.index_keys[(pool * kpool + j) * idim + d];
+      }
+    }
+    state.pooled.insert(state.pooled.end(), pooled.begin(), pooled.end());
+    state.complete_pools = tokens / kpool;
+  }
+
+  // Score complete pools; keep the best top_k / kpool plus the incomplete
+  // tail (up to kpool - 1 tokens, always selected).
+  const std::uint32_t n_pools = state.complete_pools;
+  const std::uint32_t select_pools =
+  std::min<std::uint32_t>(c.indexer_top_k / kpool, n_pools);
+  std::vector<std::int32_t> selected;
+  selected.reserve(select_pools * kpool + (kpool - 1));
+  if (n_pools > 0) {
+    std::vector<float> iq(c.IndexerQueryDim());
+    for (std::uint32_t r = 0; r < c.IndexerQueryDim(); ++r) {
+      iq[r] =
+      DotTensorRow(idx.q_b, r, 0, {q_resid.data(), c.q_lora_rank});
+    }
+    std::vector<float> head_weights(c.indexer_heads);
+    for (std::uint32_t h = 0; h < c.indexer_heads; ++h) {
+      head_weights[h] = DotTensorRow(idx.proj, h, 0, {x, c.hidden_size}) /
+      std::sqrt(static_cast<float>(c.indexer_heads));
+    }
+    const float scale = 1.0F / std::sqrt(static_cast<float>(idim));
+    std::vector<float> index_scores(n_pools);
+    for (std::uint32_t p = 0; p < n_pools; ++p) {
+      double total = 0.0;
+      for (std::uint32_t h = 0; h < c.indexer_heads; ++h) {
+        double dot = 0.0;
+        for (std::uint32_t d = 0; d < idim; ++d) {
+          dot += static_cast<double>(iq[h * idim + d]) *
+          state.pooled[p * idim + d];
+        }
+        total += static_cast<double>(head_weights[h]) *
+        std::max(0.0F, static_cast<float>(dot) * scale);
+      }
+      index_scores[p] = static_cast<float>(total);
+    }
+    std::vector<std::uint32_t> order(n_pools);
+    std::iota(order.begin(), order.end(), 0U);
+    std::stable_sort(order.begin(), order.end(),
+    [&](std::uint32_t a, std::uint32_t b) {
+      return index_scores[a] > index_scores[b];
+    );
+    for (std::uint32_t i = 0; i < select_pools; ++i) {
+      for (std::uint32_t j = 0; j < kpool; ++j) {
+        selected.push_back(
+        static_cast<std::int32_t>(order[i] * kpool + j));
+      }
+    }
+  }
+  const std::uint32_t tail_count = tokens % kpool;
+  for (std::uint32_t j = 0; j < tail_count; ++j) {
+    selected.push_back(
+    static_cast<std::int32_t>(tokens - tail_count + j));
+  }
+  std::sort(selected.begin(), selected.end());
+  state.last_selection = selected;
+
+  // Attention over the selection with the absorbed query: q_abs[h][r] is
+  // k_b's row r of head h dotted with the query, and the score against a
+  // cached latent is their dot, scaled 1/sqrt(qk_nope). After softmax,
+  // v_b expands the probability-weighted latent.
+  const float attn_scale =
+  1.0F / std::sqrt(static_cast<float>(c.qk_nope_head_dim));
+  std::vector<float> q(query_dim);
+  for (std::uint32_t r = 0; r < query_dim; ++r) {
+    q[r] = DotTensorRow(m.q_b, r, 0, {q_resid.data(), c.q_lora_rank});
+  }
+  std::vector<float> q_abs(c.kv_lora_rank);
+  std::vector<float> attn_out(query_dim, 0.0F);
+  std::vector<float> scores(selected.size());
+  std::vector<float> weighted(c.kv_lora_rank);
+  for (std::uint32_t h = 0; h < heads; ++h) {
+    for (std::uint32_t r = 0; r < c.kv_lora_rank; ++r) {
+      q_abs[r] = DotTensorRow(
+      m.k_b, r, h,
+      {q.data() + h * c.qk_nope_head_dim, c.qk_nope_head_dim});
+    }
+    float max_value = -std::numeric_limits<float>::infinity();
+    for (std::size_t i = 0; i < selected.size(); ++i) {
+      const auto at = static_cast<std::size_t>(selected[i]);
+      double dot = 0.0;
+      for (std::uint32_t r = 0; r < c.kv_lora_rank; ++r) {
+        dot += static_cast<double>(q_abs[r]) *
+        state.latents[at * c.kv_lora_rank + r];
+      }
+      scores[i] = static_cast<float>(dot) * attn_scale;
+      max_value = std::max(max_value, scores[i]);
+    }
+    double denom = 0.0;
+    for (float s : scores) {
+      denom += std::exp(static_cast<double>(s - max_value));
+    }
+    for (std::uint32_t r = 0; r < c.kv_lora_rank; ++r) {
+      weighted[r] = 0.0F;
+    }
+    for (std::size_t i = 0; i < selected.size(); ++i) {
+      const auto at = static_cast<std::size_t>(selected[i]);
+      const float prob = static_cast<float>(
+      std::exp(static_cast<double>(scores[i] - max_value)) / denom);
+      for (std::uint32_t r = 0; r < c.kv_lora_rank; ++r) {
+        weighted[r] += prob * state.latents[at * c.kv_lora_rank + r];
+      }
+    }
+    // v_b is the plain post-attention projection from latent space:
+    // out[j] = dot(v_b row j of head h, weighted latent).
+    for (std::uint32_t j = 0; j < c.v_head_dim; ++j) {
+      attn_out[h * c.v_head_dim + j] =
+      DotTensorRow(m.v_b, j, h, {weighted.data(), c.kv_lora_rank});
+    }
+  }
+  for (std::uint32_t d = 0; d < c.hidden_size; ++d) {
+    out[d] = DotTensorRow(m.out, d, 0, {attn_out.data(), query_dim});
+  }
+  return true;
+}
+
+bool ReferenceModel::FfnStep(std::uint32_t layer, const float* x,
+float* out, std::string* error) {
+  (void)error;
+  const Config& c = *config_;
+  const LayerWeights& w = weights_->layers[layer];
+  const float limit = c.swiglu_limit;
+
+  // Clamped SwiGLU activations of one gate/up pair into mlp_act_.
+  const auto activations = [&](const TensorRef& gate, const TensorRef& up,
+  std::uint32_t intermediate,
+  std::uint64_t expert) {
+    for (std::uint32_t j = 0; j < intermediate; ++j) {
+      const float g = DotTensorRow(gate, j, expert, {x, c.hidden_size});
+      const float u = DotTensorRow(up, j, expert, {x, c.hidden_size});
+      mlp_act_[j] =
+      Silu(std::min(g, limit)) * std::clamp(u, -limit, limit);
+    }
+  ;
+  const auto down_into = [&](const TensorRef& down,
+  std::uint32_t intermediate,
+  std::uint64_t expert, float weight,
+  std::vector<float>& acc) {
+    for (std::uint32_t d = 0; d < c.hidden_size; ++d) {
+      acc[d] += weight * DotTensorRow(down, d, expert,
+      {mlp_act_.data(), intermediate});
+    }
+  ;
+
+  if (w.dense_ffn) {
+    activations(w.ffn_gate, w.ffn_up, c.dense_ffn, 0);
+    for (std::uint32_t d = 0; d < c.hidden_size; ++d) {
+      out[d] =
+      DotTensorRow(w.ffn_down, d, 0, {mlp_act_.data(), c.dense_ffn});
+    }
+    return true;
+  }
+
+  // Sigmoid routing with the noaux_tc bias on selection only.
+  std::vector<float> router(c.expert_count);
+  for (std::uint32_t e = 0; e < c.expert_count; ++e) {
+    router[e] = Sigmoid(DotTensorRow(w.router, e, 0, {x, c.hidden_size}));
+  }
+  std::vector<float> bias(c.expert_count);
+  DequantTensorRow(w.router_bias, 0, 0, bias.data());
+  std::vector<std::uint32_t> order(c.expert_count);
+  std::iota(order.begin(), order.end(), 0U);
+  std::stable_sort(order.begin(), order.end(),
+  [&](std::uint32_t a, std::uint32_t b) {
+    return router[a] + bias[a] > router[b] + bias[b];
+  );
+  double weight_sum = 0.0;
+  for (std::uint32_t k = 0; k < c.experts_used; ++k) {
+    weight_sum += router[order[k]];
+  }
+  std::vector<float> routed(c.hidden_size, 0.0F);
+  for (std::uint32_t k = 0; k < c.experts_used; ++k) {
+    const std::uint32_t e = order[k];
+    const float weight = static_cast<float>(
+    router[e] / (weight_sum + 1e-20) * c.routed_scaling);
+    activations(w.gate_exps, w.up_exps, c.expert_ffn, e);
+    down_into(w.down_exps, c.expert_ffn, e, weight, routed);
+  }
+  const std::uint32_t shared_ff = c.expert_ffn * c.shared_experts;
+  activations(w.gate_shexp, w.up_shexp, shared_ff, 0);
+  down_into(w.down_shexp, shared_ff, 0, 1.0F, routed);
+  std::copy(routed.begin(), routed.end(), out);
+  return true;
+}
+
+bool ReferenceModel::Step(std::int32_t token, std::span<float> logits,
+std::string* error) {
+  const Config& c = *config_;
+  if (logits.size() != c.vocab_size) {
+    if (error != nullptr) {
+      *error = "logits span must cover the vocabulary";
+    }
+    return false;
+  }
+  if (token < 0 || static_cast<std::uint32_t>(token) >= c.vocab_size) {
+    if (error != nullptr) {
+      *error = "token id out of range";
+    }
+    return false;
+  }
+  if (position_ >= c.context_length) {
+    if (error != nullptr) {
+      *error = "context length exceeded";
+    }
+    return false;
+  }
+  const std::uint32_t hidden = c.hidden_size;
+  const std::uint32_t n = c.hc_count;
+  if (tracing_) {
+    trace_.emplace_back(c.num_layers,
+    std::vector<BlockTrace>(2, BlockTrace{}));
+  }
+  DequantTensorRow(weights_->token_embd,
+  static_cast<std::uint64_t>(token), 0,
+  collapsed_.data());
+  for (std::uint32_t i = 0; i < n; ++i) {
+    std::copy(collapsed_.begin(), collapsed_.begin() + hidden,
+    streams_.begin() + i * hidden);
+  }
+  for (std::uint32_t layer = 0; layer < c.num_layers; ++layer) {
+    const LayerWeights& w = weights_->layers[layer];
+    for (int sub = 0; sub < 2; ++sub) {
+      const HcWeights& hc = sub == 0 ? w.hc_attn : w.hc_ffn;
+      const TensorRef& norm = sub == 0 ? w.attn_norm : w.ffn_norm;
+      std::copy(streams_.begin(), streams_.end(), residual_.begin());
+      HyperMix(hc, streams_, hc_post_, hc_comb_, collapsed_);
+      DequantTensorRow(norm, 0, 0, normed_.data());
+      RmsNormInto(collapsed_, normed_, c.rms_eps, block_x_);
+      const bool ok =
+      sub == 0
+      ? (w.linear ? KdaStep(layer, block_x_.data(),
+      block_out_.data(), error)
+      : DsaStep(layer, block_x_.data(),
+      block_out_.data(), error))
+      : FfnStep(layer, block_x_.data(), block_out_.data(), error);
+      if (!ok) {
+        return false;
+      }
+      if (tracing_) {
+        BlockTrace& captured = trace_[position_][layer][sub];
+        captured.input.assign(block_x_.begin(), block_x_.end());
+        captured.output.assign(block_out_.begin(), block_out_.end());
+      }
+      for (std::uint32_t d = 0; d < hidden; ++d) {
+        for (std::uint32_t i = 0; i < n; ++i) {
+          double mix = 0.0;
+          for (std::uint32_t m = 0; m < n; ++m) {
+            mix += static_cast<double>(hc_comb_[m * n + i]) *
+            residual_[m * hidden + d];
+          }
+          streams_[i * hidden + d] = static_cast<float>(
+          static_cast<double>(hc_post_[i]) * block_out_[d] + mix);
+        }
+      }
+    }
+  }
+  // Unweighted mean over the streams, final norm, vocabulary projection.
+  for (std::uint32_t d = 0; d < hidden; ++d) {
+    double mean = 0.0;
+    for (std::uint32_t i = 0; i < n; ++i) {
+      mean += streams_[i * hidden + d];
+    }
+    collapsed_[d] = static_cast<float>(mean / n);
+  }
+  DequantTensorRow(weights_->output_norm, 0, 0, normed_.data());
+  RmsNormInto(collapsed_, normed_, c.rms_eps, collapsed_);
+  for (std::uint32_t v = 0; v < c.vocab_size; ++v) {
+    logits[v] =
+    DotTensorRow(weights_->output, v, 0, {collapsed_.data(), hidden});
+  }
+  ++position_;
+  return true;
+}
+
+bool ReferenceModel::Prefill(std::span<const std::int32_t> tokens,
+std::span<float> logits,
+std::string * error) {
+  if (tokens.empty()) {
+    if (error != nullptr) {
+      *error = "prefill requires at least one token";
+    }
+    return false;
+  }
+  for (const std::int32_t token : tokens) {
+    if (!Step(token, logits, error)) {
+      return false;
+    }
+  }
+  return true;
+}
+}
+
+std::vector<std::int32_t> ReferenceModel::LastSelection(
+std::uint32_t layer) const {
+if (layer >= dsa_.size()) {
+  return {};
+}
+return dsa_[layer].last_selection;
+}
