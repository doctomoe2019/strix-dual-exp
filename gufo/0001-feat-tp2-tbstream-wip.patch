+namespace gufo::models::glm5_next::rocm {
+namespace {
+
+/// The quantized GEMM tier reads whole k-iterations; every upload carries
+/// this zeroed tail so row over-reads stay inside the allocation (the
+/// padding meets zeroed activation and contributes nothing).
+constexpr std::size_t kTailMargin = 4096;
+
+bool SupportedType(core::GgmlType type) {
+  return type == core::GgmlType::kF32 || type == core::GgmlType::kQ8_0 ||
+         type == core::GgmlType::kQ4_K;
+}
+
+std::size_t SpanBytes(core::GgmlType type, std::size_t elements) {
+  switch (type) {
+    case core::GgmlType::kF32:
+    case core::GgmlType::kI32:
+      return elements * 4;
+    case core::GgmlType::kF16:
+    case core::GgmlType::kBF16:
+      return elements * 2;
+    default:
+      return gufo::quant::QuantizedRowBytes(type, elements);
+  }
+}
+
+/// Allocates `bytes + kTailMargin` and zeroes the tail; `ptr` stays null on
+/// failure.
+bool AllocTail(std::vector<void*>& allocations, std::size_t bytes, void** ptr,
+               const TensorRef& t, std::size_t* weight_bytes,
+               std::string* error) {
+  if (bytes > std::numeric_limits<std::size_t>::max() - kTailMargin) {
+    if (error != nullptr) {
+      *error = "slice tensor size overflows: " + std::string(t.name);
+    }
+    return false;
+  }
+  if (hipMalloc(ptr, bytes + kTailMargin) != hipSuccess) {
+    if (error != nullptr) {
+      *error = "hipMalloc failed for " + std::string(t.name) + " (" +
+               std::to_string(bytes) + " bytes)";
+    }
+    return false;
+  }
+  allocations.push_back(*ptr);
+  *weight_bytes += bytes + kTailMargin;
+  (void)hipMemsetAsync(static_cast<std::uint8_t*>(*ptr) + bytes, 0, kTailMargin,
+                       nullptr);
+  return true;
+}
+
+/// Uploads one planned tensor according to its span. Split geometry is
+/// validated by the planner; here it is only executed.
+struct Uploader {
+  hip::WeightUpload& stager;
+  std::vector<void*>& allocations;
+  std::size_t& weight_bytes;
+  std::size_t& encoded_bytes;
+  std::size_t& tensor_count;
+  std::string* error;
+  bool ok{true};
+
+  void Fail(const std::string& message) {
+    if (ok && error != nullptr) {
+      *error = message;
+    }
+    ok = false;
+  }
+
+  void Count(std::size_t local_bytes) {
+    encoded_bytes += local_bytes;
+    ++tensor_count;
+  }
+
+  DeviceTensor UploadSpan(const TensorRef& t,
+                          const distributed::TensorSpan& span) {
+    DeviceTensor d;
+    if (t.empty() || !ok) {
+      return d;
+    }
+    if (!SupportedType(t.type)) {
+      Fail("unsupported tensor format in slice: " + std::string(t.name));
+      return d;
+    }
+    if (t.cols > std::numeric_limits<std::uint32_t>::max() ||
+        t.rows > std::numeric_limits<std::uint32_t>::max() ||
+        t.experts > std::numeric_limits<std::uint32_t>::max()) {
+      Fail("slice tensor geometry is invalid: " + std::string(t.name));
+      return d;
+    }
+    const std::size_t row_bytes = t.RowBytes();
+    void* ptr = nullptr;
+    switch (span.kind) {
+      case distributed::TensorSpanKind::kFull: {
+        const std::size_t size = t.SizeBytes();
+        if (!AllocTail(allocations, size, &ptr, t, &weight_bytes, error)) {
+          Fail(*error);
+          return d;
+        }
+        if (!stager.Copy(t.shard, t.file_offset, size, ptr, error)) {
+          Fail("upload failed for " + std::string(t.name));
+          return d;
+        }
+        d.type = t.type;
+        d.cols = static_cast<std::uint32_t>(t.cols);
+        d.rows = static_cast<std::uint32_t>(t.rows);
+        d.experts = static_cast<std::uint32_t>(t.experts);
+        Count(size);
+        break;
+      }
+      case distributed::TensorSpanKind::kRows: {
+        const std::size_t count = static_cast<std::size_t>(span.count);
+        const std::size_t size = count * row_bytes * t.experts;
+        if (!AllocTail(allocations, size, &ptr, t, &weight_bytes, error)) {
+          Fail(*error);
+          return d;
+        }
+        if (span.per_expert) {
+          for (std::uint64_t e = 0; e < t.experts; ++e) {
+            if (!stager.Copy(
+                    t.shard,
+                    t.file_offset + (e * t.rows + span.begin) * row_bytes,
+                    count * row_bytes,
+                    static_cast<std::uint8_t*>(ptr) + e * count * row_bytes,
+                    error)) {
+              Fail("upload failed for " + std::string(t.name));
+              return d;
+            }
+          }
+        } else if (!stager.Copy(t.shard, t.file_offset + span.begin * row_bytes,
+                                size, ptr, error)) {
+          Fail("upload failed for " + std::string(t.name));
+          return d;
+        }
+        d.type = t.type;
+        d.cols = static_cast<std::uint32_t>(t.cols);
+        d.rows = static_cast<std::uint32_t>(count);
+        d.experts = static_cast<std::uint32_t>(t.experts);
+        Count(size);
+        break;
+      }
+      case distributed::TensorSpanKind::kElements: {
+        const std::size_t skip =
+            SpanBytes(t.type, static_cast<std::size_t>(span.begin));
+        const std::size_t size =
+            SpanBytes(t.type, static_cast<std::size_t>(span.count));
+        if (!AllocTail(allocations, size, &ptr, t, &weight_bytes, error)) {
+          Fail(*error);
+          return d;
+        }
+        if (!stager.Copy(t.shard, t.file_offset + skip, size, ptr, error)) {
+          Fail("upload failed for " + std::string(t.name));
+          return d;
+        }
+        d.type = t.type;
+        d.cols = static_cast<std::uint32_t>(span.count);
+        d.rows = 1;
+        Count(size);
+        break;
+      }
+      case distributed::TensorSpanKind::kStack: {
+        const std::size_t matrix = row_bytes * t.rows;
+        const std::size_t size = matrix * static_cast<std::size_t>(span.count);
+        if (!AllocTail(allocations, size, &ptr, t, &weight_bytes, error)) {
+          Fail(*error);
+          return d;
+        }
+        if (!stager.Copy(t.shard, t.file_offset + span.begin * matrix, size,
+                         ptr, error)) {
+          Fail("upload failed for " + std::string(t.name));
+          return d;
+        }
+        d.type = t.type;
+        d.cols = static_cast<std::uint32_t>(t.cols);
+        d.rows = static_cast<std::uint32_t>(t.rows);
+        d.experts = static_cast<std::uint32_t>(span.count);
+        Count(size);
+        break;
+      }
+      case distributed::TensorSpanKind::kColumns: {
+        const std::size_t span_off =
+            SpanBytes(t.type, static_cast<std::size_t>(span.begin));
+        const std::size_t span_bytes =
+            SpanBytes(t.type, static_cast<std::size_t>(span.count));
+        const std::size_t size = span_bytes * t.rows * t.experts;
+        if (!AllocTail(allocations, size, &ptr, t, &weight_bytes, error)) {
+          Fail(*error);
+          return d;
+        }
+        if (span.per_expert) {
+          const std::size_t expert_bytes = row_bytes * t.rows;
+          for (std::uint64_t e = 0; e < t.experts; ++e) {
+            if (!stager.CopyStrided(
+                    t.shard, t.file_offset + e * expert_bytes, row_bytes,
+                    span_off, span_bytes, t.rows,
+                    static_cast<std::uint8_t*>(ptr) + e * span_bytes * t.rows,
+                    error)) {
+              Fail("upload failed for " + std::string(t.name));
+              return d;
+            }
+          }
+        } else if (!stager.CopyStrided(t.shard, t.file_offset, row_bytes,
+                                       span_off, span_bytes, t.rows * t.experts,
+                                       ptr, error)) {
+          Fail("upload failed for " + std::string(t.name));
+          return d;
+        }
+        d.type = t.type;
+        d.cols = static_cast<std::uint32_t>(span.count);
+        d.rows = static_cast<std::uint32_t>(t.rows);
+        d.experts = static_cast<std::uint32_t>(t.experts);
+        Count(size);
+        break;
+      }
+    }
+    d.data = ptr;
+    return d;
+  }
+};
+
+}  // namespace
+
+DeviceSlice::~DeviceSlice() {
+  for (void* ptr : allocations_) {
+    (void)hipFree(ptr);
+  }
+}
+
+std::unique_ptr<DeviceSlice> DeviceSlice::Upload(
+    const ModelWeights& weights, const core::GgufReader& reader,
+    std::uint32_t layer_count, const distributed::TpPartition* partition,
+    std::string* error_msg) {
+  const Config& c = weights.config;
+  if (layer_count > c.num_layers) {
+    if (error_msg != nullptr) {
+      *error_msg = "slice requests more layers than the trunk has";
+    }
+    return nullptr;
+  }
+  auto plan_partition = distributed::TpPartition::Create(
+      c, partition != nullptr ? partition->rank : 0,
+      partition != nullptr ? partition->world_size : 1, error_msg);
+  if (!plan_partition) {
+    return nullptr;
+  }
+  if (partition != nullptr && *partition != *plan_partition) {
+    if (error_msg != nullptr) {
+      *error_msg = "slice partition does not match the model";
+    }
+    return nullptr;
+  }
+  auto planned =
+      distributed::PlanModelTensors(weights, *plan_partition, error_msg);
+  if (!planned) {
+    return nullptr;
+  }
+  // Only the first `layer_count` layers (plus the global tensors) belong to
+  // the slice; the walk keeps their original relative order.
+  std::unordered_set<const TensorRef*> wanted;
+  wanted.reserve(64 + layer_count * 32);
+  wanted.insert(&weights.token_embd);
+  wanted.insert(&weights.output);
+  wanted.insert(&weights.output_norm);
+  for (std::uint32_t l = 0; l < layer_count; ++l) {
+    const LayerWeights& w = weights.layers[l];
+    auto add = [&wanted](const TensorRef& t) {
+      if (!t.empty()) {
+        wanted.insert(&t);
+      }
+    };
+    auto add_hc = [&add](const HcWeights& hc) {
+      add(hc.fn);
+      add(hc.base);
+      add(hc.scale);
+    };
+    add(w.attn_norm);
+    add(w.ffn_norm);
+    add_hc(w.hc_attn);
+    add_hc(w.hc_ffn);
+    if (w.linear) {
+      for (const TensorRef* t :
+           {&w.kda.q, &w.kda.k, &w.kda.v, &w.kda.out, &w.kda.conv_q,
+            &w.kda.conv_k, &w.kda.conv_v, &w.kda.f_a, &w.kda.f_b, &w.kda.g_a,
+            &w.kda.g_b, &w.kda.beta, &w.kda.a, &w.kda.dt_bias, &w.kda.o_norm}) {
+        add(*t);
+      }
+    } else {
+      for (const TensorRef* t :
+           {&w.dsa.q_a, &w.dsa.q_a_norm, &w.dsa.q_b, &w.dsa.kv_a,
+            &w.dsa.kv_a_norm, &w.dsa.k_b, &w.dsa.v_b, &w.dsa.out,
+            &w.indexer.q_b, &w.indexer.k, &w.indexer.k_norm,
+            &w.indexer.k_norm_bias, &w.indexer.proj, &w.indexer.comp_gate,
+            &w.indexer.comp_ape}) {
+        add(*t);
+      }
+    }
+    if (w.dense_ffn) {
+      add(w.ffn_gate);
+      add(w.ffn_up);
+      add(w.ffn_down);
+    } else {
+      add(w.router);
+      add(w.router_bias);
+      add(w.gate_exps);
+      add(w.up_exps);
+      add(w.down_exps);
+      add(w.gate_shexp);
+      add(w.up_shexp);
+      add(w.down_shexp);
+    }
+  }
+
+  auto stager = hip::WeightUpload::Create(reader.GetMappedRegions(), error_msg);
+  if (stager == nullptr) {
+    return nullptr;
+  }
+  auto slice = std::unique_ptr<DeviceSlice>(new DeviceSlice());
+  slice->config_ = c;
+  slice->partition_ = *plan_partition;
+  slice->layer_count_ = layer_count;
+  slice->layers_.resize(layer_count);
+  // Span lookup keyed by tensor address; every consumed tensor is erased
+  // so a final emptiness check proves full coverage.
+  std::unordered_map<const TensorRef*, distributed::TensorSpan> spans;
+  for (const auto& entry : *planned) {
+    if (wanted.count(entry.tensor) != 0) {
+      spans.emplace(entry.tensor, entry.span);
+    }
+  }
+
+  const auto take = [&](const TensorRef& t) -> distributed::TensorSpan {
+    const auto it = spans.find(&t);
+    if (it == spans.end()) {
+      if (error_msg != nullptr) {
+        *error_msg = "slice plan is missing " + std::string(t.name);
+      }
+      return distributed::TensorSpan{};
+    }
+    distributed::TensorSpan span = it->second;
+    spans.erase(it);
+    return span;
+  };
+  Uploader up{*stager,
+              slice->allocations_,
+              slice->weight_bytes_,
+              slice->encoded_bytes_,
+              slice->tensor_count_,
+              error_msg,
+              true};
+
+  slice->token_embd_ =
+      up.UploadSpan(weights.token_embd, take(weights.token_embd));
+  slice->output_ = up.UploadSpan(weights.output, take(weights.output));
+  slice->output_norm_ =
+      up.UploadSpan(weights.output_norm, take(weights.output_norm));
+  for (std::uint32_t l = 0; l < layer_count && up.ok; ++l) {
+    const LayerWeights& w = weights.layers[l];
+    DeviceLayer& d = slice->layers_[l];
+    d.linear = w.linear;
+    d.dense_ffn = w.dense_ffn;
+    d.attn_norm = up.UploadSpan(w.attn_norm, take(w.attn_norm));
+    d.ffn_norm = up.UploadSpan(w.ffn_norm, take(w.ffn_norm));
+    const auto upload_hc = [&](const HcWeights& hw, DeviceHc* dh) {
+      dh->fn = up.UploadSpan(hw.fn, take(hw.fn));
+      dh->base = up.UploadSpan(hw.base, take(hw.base));
+      dh->scale = up.UploadSpan(hw.scale, take(hw.scale));
+    };
+    upload_hc(w.hc_attn, &d.hc_attn);
+    upload_hc(w.hc_ffn, &d.hc_ffn);
+    const auto upload_kda = [&](const KdaWeights& kw, DeviceKda* dk) {
+      dk->q = up.UploadSpan(kw.q, take(kw.q));
+      dk->k = up.UploadSpan(kw.k, take(kw.k));
+      dk->v = up.UploadSpan(kw.v, take(kw.v));
+      dk->out = up.UploadSpan(kw.out, take(kw.out));
+      dk->conv_q = up.UploadSpan(kw.conv_q, take(kw.conv_q));
+      dk->conv_k = up.UploadSpan(kw.conv_k, take(kw.conv_k));
+      dk->conv_v = up.UploadSpan(kw.conv_v, take(kw.conv_v));
+      dk->f_a = up.UploadSpan(kw.f_a, take(kw.f_a));
+      dk->f_b = up.UploadSpan(kw.f_b, take(kw.f_b));
+      dk->g_a = up.UploadSpan(kw.g_a, take(kw.g_a));
+      dk->g_b = up.UploadSpan(kw.g_b, take(kw.g_b));
+      dk->beta = up.UploadSpan(kw.beta, take(kw.beta));
+      dk->a = up.UploadSpan(kw.a, take(kw.a));
+      dk->dt_bias = up.UploadSpan(kw.dt_bias, take(kw.dt_bias));
+      dk->o_norm = up.UploadSpan(kw.o_norm, take(kw.o_norm));
+    };
+    const auto upload_dsa = [&](const DsaWeights& dw, DeviceDsa* dd) {
+      dd->q_a = up.UploadSpan(dw.q_a, take(dw.q_a));
+      dd->q_a_norm = up.UploadSpan(dw.q_a_norm, take(dw.q_a_norm));
+      dd->q_b = up.UploadSpan(dw.q_b, take(dw.q_b));
+      dd->kv_a = up.UploadSpan(dw.kv_a, take(dw.kv_a));
+      dd->kv_a_norm = up.UploadSpan(dw.kv_a_norm, take(dw.kv_a_norm));
+      dd->k_b = up.UploadSpan(dw.k_b, take(dw.k_b));
+      dd->v_b = up.UploadSpan(dw.v_b, take(dw.v_b));
+      dd->out = up.UploadSpan(dw.out, take(dw.out));
+    };
+    const auto upload_indexer = [&](const IndexerWeights& iw,
+                                    DeviceIndexer* di) {
+      di->q_b = up.UploadSpan(iw.q_b, take(iw.q_b));
+      di->k = up.UploadSpan(iw.k, take(iw.k));
+      di->k_norm = up.UploadSpan(iw.k_norm, take(iw.k_norm));
+      di->k_norm_bias = up.UploadSpan(iw.k_norm_bias, take(iw.k_norm_bias));
+      di->proj = up.UploadSpan(iw.proj, take(iw.proj));
+      di->comp_gate = up.UploadSpan(iw.comp_gate, take(iw.comp_gate));
+      di->comp_ape = up.UploadSpan(iw.comp_ape, take(iw.comp_ape));
+    };
+    if (w.linear) {
+      upload_kda(w.kda, &d.kda);
+    } else {
+      upload_dsa(w.dsa, &d.dsa);
+      upload_indexer(w.indexer, &d.indexer);
+    }
+    if (w.dense_ffn) {
+      d.ffn_gate = up.UploadSpan(w.ffn_gate, take(w.ffn_gate));
+      d.ffn_up = up.UploadSpan(w.ffn_up, take(w.ffn_up));
+      d.ffn_down = up.UploadSpan(w.ffn_down, take(w.ffn_down));
+    } else {
+      d.router = up.UploadSpan(w.router, take(w.router));
+      d.router_bias = up.UploadSpan(w.router_bias, take(w.router_bias));
+      d.gate_exps = up.UploadSpan(w.gate_exps, take(w.gate_exps));
+      d.up_exps = up.UploadSpan(w.up_exps, take(w.up_exps));
+      d.down_exps = up.UploadSpan(w.down_exps, take(w.down_exps));
+      d.gate_shexp = up.UploadSpan(w.gate_shexp, take(w.gate_shexp));
+      d.up_shexp = up.UploadSpan(w.up_shexp, take(w.up_shexp));
+      d.down_shexp = up.UploadSpan(w.down_shexp, take(w.down_shexp));
+    }
+  }
+  if (!up.ok || !spans.empty() || !stager->Finish(error_msg)) {
+    if (up.ok && error_msg != nullptr && !spans.empty()) {
+      *error_msg = "slice upload left " + std::to_string(spans.size()) +
+                   " planned tensors unassigned";
+    }
+    return nullptr;
+  }
+  return slice;
+}
+
+}  // namespace gufo::models::glm5_next::rocm
