+std::unique_ptr<Executor::Session> Executor::CreateSession(
+    std::uint32_t capacity, std::string* error_msg) const {
+  if (capacity == 0) {
+    SetError(error_msg, "session capacity must be nonzero");
+    return nullptr;
+  }
+  auto session = std::unique_ptr<Session>(new Session());
+  session->capacity_ = capacity;
+  session->stream_ = stream_;
+  const Config& c = config();
+  const distributed::TpPartition& p = slice_->partition();
+  const std::uint32_t heads = p.head_count;
+  const std::uint32_t inner = heads * c.kda_head_dim;
+  const std::size_t pools =
+      static_cast<std::size_t>(capacity) / c.indexer_kpool + 1;
+  bool ok = true;
+  const auto alloc = [&](std::size_t bytes) -> void* {
+    if (!ok) {
+      return nullptr;
+    }
+    void* ptr = nullptr;
+    if (hipMalloc(&ptr, bytes) != hipSuccess) {
+      ok = false;
+      return nullptr;
+    }
+    session->allocations_.push_back(ptr);
+    session->allocation_bytes_.push_back(bytes);
+    // Zero on the executor stream so the region is clean before the first
+    // Step touches it (a non-blocking stream does not order against the
+    // default stream).
+    (void)hipMemsetAsync(ptr, 0, bytes, stream_);
+    return ptr;
+  };
+  for (const DeviceLayer& layer : slice_->layers()) {
+    if (!ok) {
+      break;
+    }
+    if (layer.linear) {
+      Session::Kda kda;
+      kda.history = static_cast<float*>(
+          alloc((c.kda_conv_kernel - 1) * 3 * static_cast<std::size_t>(inner) *
+                sizeof(float)));
+      kda.state = static_cast<float*>(alloc(static_cast<std::size_t>(heads) *
+                                            c.kda_head_dim * c.kda_head_dim *
+                                            sizeof(float)));
+      session->kda_.push_back(kda);
+    } else {
+      Session::Dsa dsa;
+      dsa.latents = static_cast<float*>(alloc(
+          static_cast<std::size_t>(capacity) * c.kv_lora_rank * sizeof(float)));
+      dsa.pooled = static_cast<float*>(
+          alloc(pools * c.indexer_head_dim * sizeof(float)));
+      dsa.scores = static_cast<float*>(alloc(pools * sizeof(float)));
+      dsa.frontier_keys = static_cast<float*>(
+          alloc(c.indexer_kpool * c.indexer_head_dim * sizeof(float)));
+      dsa.frontier_gates = static_cast<float*>(
+          alloc(c.indexer_kpool * c.indexer_head_dim * sizeof(float)));
+      session->dsa_.push_back(dsa);
+    }
+  }
+  if (!ok) {
+    SetError(error_msg, "session allocation failed");
+    return nullptr;
+  }
+  if (!Check(hipStreamSynchronize(stream_), "session zeroing", error_msg)) {
+    return nullptr;
+  }
+  return session;
+}
+
+bool Executor::HashState(const Session& session, std::uint64_t* hash,
+                         std::string* error_msg) const {
+  std::uint64_t h = 1469598103934665603ULL;
+  for (std::size_t i = 0; i < session.allocations_.size(); ++i) {
+    const std::size_t bytes = session.allocation_bytes_[i];
+    std::vector<std::uint8_t> host(bytes);
+    // Stream-ordered copy: pending executor-stream kernels finish before
+    // the state is read.
+    if (!Check(hipMemcpyAsync(host.data(), session.allocations_[i], bytes,
+                              hipMemcpyDeviceToHost, stream_),
+               "state hash copy", error_msg) ||
+        !Check(hipStreamSynchronize(stream_), "state hash drain", error_msg)) {
+      return false;
+    }
+    for (std::uint8_t v : host) {
+      h ^= v;
+      h *= 1099511628211ULL;
+    }
+  }
+  *hash = h;
+  return true;
+}
+
+std::size_t Executor::Session::state_bytes() const noexcept {
+  std::size_t bytes = 0;
+  for (std::size_t size : allocation_bytes_) {
+    bytes += size;
+  }
+  return bytes;
+}
+
+std::size_t Executor::scratch_bytes() const noexcept {
+  std::size_t bytes = 0;
+  for (std::size_t size : allocation_bytes_) {
+    bytes += size;
+  }
+  return bytes;
+}
+
+bool Executor::SumPartial(std::uint32_t layer, int sub,
+                          std::uint32_t first_token,
+                          std::string* error_msg) const {
+  // Tokenwise: one row of hidden floats per exchange.
+  if (options_.all_reduce &&
+      !options_.all_reduce(s_.block_out, 1, stream_, error_msg)) {
+    return false;
+  }
+  if (options_.block_observer) {
+    options_.block_observer(layer, sub, first_token, 1, s_.block_out, stream_);
+  }
+  return true;
+}
+
+bool Executor::AttentionBlock(Session& session, std::uint32_t layer,
+                              std::string* error_msg) const {
+  const Config& c = config();
+  const DeviceLayer& dl = slice_->layers()[layer];
+  const distributed::TpPartition& p = slice_->partition();
+  const std::uint32_t heads = p.head_count;
+  const std::uint32_t dim = c.kda_head_dim;
+  const std::uint32_t inner = heads * dim;
+  const auto q8 = gufo::core::GgmlType::kQ8_0;
+  const Scratch& s = s_;
+
+  if (dl.linear) {
+    const DeviceKda& kd = dl.kda;
+    Session::Kda& state = session.kda_[session.kda_cursor_];
+    ++session.kda_cursor_;
+    rocm::BatchQ8KBlockGEMV(kd.q.data, rocm::WeightTypeOf(kd.q.type), s.block_x,
+                            s.qkv, 1, kd.q.rows, kd.q.cols, stream_);
+    rocm::BatchQ8KBlockGEMV(kd.k.data, rocm::WeightTypeOf(kd.k.type), s.block_x,
+                            s.qkv + inner, 1, kd.k.rows, kd.k.cols, stream_);
+    rocm::BatchQ8KBlockGEMV(kd.v.data, rocm::WeightTypeOf(kd.v.type), s.block_x,
+                            s.qkv + 2 * static_cast<std::size_t>(inner), 1,
+                            kd.v.rows, kd.v.cols, stream_);
+    rocm::KdaConv(s.qkv, kd.conv_q.f32(), kd.conv_k.f32(), kd.conv_v.f32(),
+                  state.history, s.conv_out, inner, c.kda_conv_kernel, stream_);
+    rocm::F32Gemm(kd.f_a.f32(), s.block_x, s.f_a_out, kd.f_a.rows,
+                  c.hidden_size, stream_);
+    rocm::F32Gemm(kd.f_b.f32(), s.f_a_out, s.raw, kd.f_b.rows, kd.f_b.cols,
+                  stream_);
+    rocm::F32Gemm(kd.beta.f32(), s.block_x, s.beta_row, kd.beta.rows,
+                  c.hidden_size, stream_);
+    rocm::KdaGates(s.raw, kd.a.f32(), kd.dt_bias.f32(), s.beta_row,
+                   c.kda_gate_lower_bound, s.gate, s.beta, inner, dim, stream_);
+    rocm::KdaPrepare(s.conv_out, s.qn, s.kn, heads, dim, 1e-6F, stream_);
+    rocm::KdaRecurrence(s.qn, s.kn, s.gate, s.beta, s.conv_out, state.state,
+                        s.core, heads, dim, stream_);
+    rocm::RmsNormRows(s.core, kd.o_norm.f32(), s.core_normed, heads, inner,
+                      heads, c.rms_eps, stream_);
+    rocm::F32Gemm(kd.g_a.f32(), s.block_x, s.g_a_out, kd.g_a.rows,
+                  c.hidden_size, stream_);
+    rocm::F32Gemm(kd.g_b.f32(), s.g_a_out, s.raw, kd.g_b.rows, kd.g_b.cols,
+                  stream_);
+    rocm::SigmoidMul(s.core_normed, s.raw, s.gated, inner, stream_);
+    rocm::BatchQ8KBlockGEMV(kd.out.data, rocm::WeightTypeOf(kd.out.type),
+                            s.gated, s.block_out, 1, kd.out.rows, kd.out.cols,
+                            stream_);
+    return SumPartial(layer, 0, session.position_, error_msg);
+  }
+
+  const DeviceDsa& m = dl.dsa;
+  const DeviceIndexer& idx = dl.indexer;
+  Session::Dsa& cache = session.dsa_[session.dsa_cursor_];
+  ++session.dsa_cursor_;
+  const std::uint32_t pos = session.position_;
+  const std::uint32_t tokens_seen = pos + 1;
+  const std::uint32_t kpool = c.indexer_kpool;
+  const std::uint32_t idim = c.indexer_head_dim;
+  const std::uint32_t pools = tokens_seen / kpool;
+  const std::uint32_t tail = tokens_seen % kpool;
+
+  // Latent production and caching (replicated).
+  rocm::F32Gemm(m.kv_a.f32(), s.block_x, s.latent_raw, m.kv_a.rows,
+                c.hidden_size, stream_);
+  rocm::RmsNormRows(s.latent_raw, m.kv_a_norm.f32(), s.latent_normed, 1,
+                    c.kv_lora_rank, 1, c.rms_eps, stream_);
+  rocm::AppendRows(s.latent_normed, cache.latents, c.kv_lora_rank, pos, 1,
+                   stream_);
+  rocm::BatchQ8KBlockGEMV(m.q_a.data, rocm::WeightTypeOf(m.q_a.type), s.block_x,
+                          s.q_resid_raw, 1, m.q_a.rows, m.q_a.cols, stream_);
+  rocm::RmsNormRows(s.q_resid_raw, m.q_a_norm.f32(), s.q_resid, 1,
+                    c.q_lora_rank, 1, c.rms_eps, stream_);
+
+  // Indexer append on the rotating frontier; a completed pool folds into
+  // the compact pooled-key cache at once.
+  rocm::F32Gemm(idx.k.f32(), s.block_x, s.idx_k_raw, idx.k.rows, c.hidden_size,
+                stream_);
+  rocm::F32Gemm(idx.comp_gate.f32(), s.block_x, s.idx_g_raw, idx.comp_gate.rows,
+                c.hidden_size, stream_);
+  rocm::IndexerAppend(s.idx_k_raw, s.idx_g_raw, idx.k_norm.f32(),
+                      idx.k_norm_bias.f32(), cache.frontier_keys,
+                      cache.frontier_gates, pos % kpool, idim, c.layer_norm_eps,
+                      stream_);
+  if (tail == 0) {
+    rocm::IndexerPool(cache.frontier_keys, cache.frontier_gates,
+                      idx.comp_ape.f32(),
+                      cache.pooled + static_cast<std::size_t>(pools - 1) * idim,
+                      0, kpool, idim, stream_);
+    // The pool is complete: the frontier holds no live rows from here on,
+    // matching the batched path's writeback.
+    if (!Check(hipMemsetAsync(cache.frontier_keys, 0,
+                              kpool * idim * sizeof(float), stream_),
+               "frontier clear", error_msg) ||
+        !Check(hipMemsetAsync(cache.frontier_gates, 0,
+                              kpool * idim * sizeof(float), stream_),
+               "frontier clear", error_msg)) {
+      return false;
+    }
+  }
+  rocm::F32Gemm(idx.q_b.f32(), s.q_resid, s.iq, idx.q_b.rows, idx.q_b.cols,
+                stream_);
+  rocm::F32Gemm(idx.proj.f32(), s.block_x, s.head_weights_raw, idx.proj.rows,
+                c.hidden_size, stream_);
+  rocm::ScaleRows(
+      s.head_weights_raw, s.head_weights,
+      static_cast<float>(1.0 / std::sqrt(static_cast<double>(c.indexer_heads))),
+      c.indexer_heads, stream_);
+
+  // Exact selection through the tiled batch selector, one query row: the
+  // same kernel the batched path runs, so tokenwise and chunked
+  // selections agree by construction at any pool count the scratch
+  // holds. The count stays deterministic on the host.
+  const std::uint32_t select_pools = std::min(c.indexer_top_k / kpool, pools);
+  const std::size_t count =
+      static_cast<std::size_t>(select_pools) * kpool + tail;
+  if (pools > 0) {
+    rocm::BatchIndexerScores(
+        s.iq, cache.pooled, s.head_weights, b_.scores, max_pools_batch_, 1,
+        pools, kpool, pos, c.indexer_heads, idim,
+        static_cast<float>(1.0 / std::sqrt(static_cast<double>(idim))),
+        stream_);
+    // The session scratch keeps the final query's scores so session
+    // bytes match across the two paths.
+    if (!Check(hipMemcpyAsync(cache.scores, b_.scores,
+                              static_cast<std::size_t>(pools) * sizeof(float),
+                              hipMemcpyDeviceToDevice, stream_),
+               "scores mirror", error_msg)) {
+      return false;
+    }
+  }
+  if (!rocm::BatchSelectPools(
+          b_.scores, max_pools_batch_, 1, pools, select_pools, kpool, pos,
+          c.indexer_top_k + c.indexer_kpool, b_.sel, b_.counts, stream_)) {
+    SetError(error_msg, "tokenwise selection rejected the pool configuration");
+    return false;
+  }
+
+  // Absorbed sparse MLA over this rank's heads; the output projection
+  // reduces over the local query columns. The tokenwise path runs the
+  // batched kernels one token wide, so chunked-vs-tokenwise equality holds
+  // by construction.
+  rocm::BatchQ8KBlockGEMV(m.q_b.data, rocm::WeightTypeOf(m.q_b.type), s.q_resid,
+                          s.q_full, 1, m.q_b.rows, m.q_b.cols, stream_);
+  rocm::BatchMlaAbsorb(m.k_b.f32(), s.q_full, s.q_abs, 1, heads, c.kv_lora_rank,
+                       c.qk_nope_head_dim, stream_);
+  rocm::BatchMlaAttention(
+      s.q_abs, cache.latents, b_.sel, b_.counts,
+      c.indexer_top_k + c.indexer_kpool, m.v_b.f32(), s.attn_out_buf,
+      s.attn_probs, s.attn_weighted, 1, heads, c.kv_lora_rank,
+      c.qk_nope_head_dim, c.v_head_dim,
+      static_cast<float>(1.0 /
+                         std::sqrt(static_cast<double>(c.qk_nope_head_dim))),
+      stream_);
+  rocm::BatchQ8KBlockGEMV(m.out.data, rocm::WeightTypeOf(m.out.type),
+                          s.attn_out_buf, s.block_out, 1, m.out.rows,
+                          m.out.cols, stream_);
+  return SumPartial(layer, 0, session.position_, error_msg);
+}
+
+bool Executor::FfnBlock(Session& session, std::uint32_t layer,
+                        std::string* error_msg) const {
+  const Config& c = config();
+  const DeviceLayer& dl = slice_->layers()[layer];
+  const Scratch& s = s_;
+  if (dl.dense_ffn) {
+    rocm::BatchQ8KBlockGEMV(
+        dl.ffn_gate.data, rocm::WeightTypeOf(dl.ffn_gate.type), s.block_x,
+        s.ffn_gate_out, 1, dl.ffn_gate.rows, dl.ffn_gate.cols, stream_);
+    rocm::BatchQ8KBlockGEMV(dl.ffn_up.data, rocm::WeightTypeOf(dl.ffn_up.type),
+                            s.block_x, s.ffn_up_out, 1, dl.ffn_up.rows,
+                            dl.ffn_up.cols, stream_);
+    rocm::ClampedSwiglu(s.ffn_gate_out, s.ffn_up_out, s.ffn_act,
+                        dl.ffn_gate.rows, c.swiglu_limit, stream_);
+    rocm::BatchQ8KBlockGEMV(
+        dl.ffn_down.data, rocm::WeightTypeOf(dl.ffn_down.type), s.ffn_act,
+        s.block_out, 1, dl.ffn_down.rows, dl.ffn_down.cols, stream_);
+    return SumPartial(layer, 1, session.position_, error_msg);
+  }
+
+  // Routed MoE: the batched implementation, one token wide. Device
+  // routing, the same expert kernels and the same accumulation order as
+  // prefill, so the tokenwise and chunked paths agree byte-for-byte by
+  // construction.
+  if (!Check(hipMemcpyAsync(
+                 b_.block_x, s_.block_x,
+                 static_cast<std::size_t>(c.hidden_size) * sizeof(float),
+                 hipMemcpyDeviceToDevice, stream_),
+             "ffn handoff", error_msg)) {
+    return false;
+  }
+  if (!FfnBlockBatch(session, layer, 1, error_msg)) {
+    return false;
+  }
+  return Check(
+      hipMemcpyAsync(s_.block_out, b_.block_out,
+                     static_cast<std::size_t>(c.hidden_size) * sizeof(float),
+                     hipMemcpyDeviceToDevice, stream_),
+      "ffn return", error_msg);
+}
+
+bool Executor::Step(Session& session, std::int32_t token, float* logits,
+                    std::string* error_msg) const {
+  if (session.position_ >= session.capacity_) {
+    SetError(error_msg, "session position exceeds its capacity");
+    return false;
+  }
+  session.kda_cursor_ = 0;
+  session.dsa_cursor_ = 0;
+  const Config& c = config();
+  const Scratch& s = s_;
+  const std::uint32_t n = c.hc_count;
+  const std::uint32_t hidden = c.hidden_size;
+  const auto q8 = gufo::core::GgmlType::kQ8_0;
+
+  rocm::EmbedTokenStreams(slice_->token_embd().data,
+                          rocm::WeightTypeOf(slice_->token_embd().type), token,
+                          s.streams, hidden, n, stream_);
+  for (std::uint32_t layer = 0; layer < slice_->layer_count(); ++layer) {
+    const DeviceLayer& dl = slice_->layers()[layer];
+    for (int sub = 0; sub < 2; ++sub) {
+      const DeviceHc& hc = sub == 0 ? dl.hc_attn : dl.hc_ffn;
+      const DeviceTensor& norm = sub == 0 ? dl.attn_norm : dl.ffn_norm;
+      if (!Check(hipMemcpyAsync(
+                     s.residual, s.streams,
+                     static_cast<std::size_t>(n) * hidden * sizeof(float),
+                     hipMemcpyDeviceToDevice, stream_),
+                 "residual copy", error_msg)) {
+        return false;
+      }
+      rocm::RmsNormRows(s.streams, nullptr, s.flat, 1, n * hidden, 1, c.rms_eps,
+                        stream_);
+      rocm::F32Gemm(static_cast<const float*>(hc.fn.data), s.flat, s.mixes,
+                    c.HcMixDim(), n * hidden, stream_);
+      rocm::HcSinkhorn(s.mixes, static_cast<const float*>(hc.scale.data),
+                       static_cast<const float*>(hc.base.data), s.hc_pre,
+                       s.hc_post, s.hc_comb, n, c.hc_sinkhorn_iters, c.hc_eps,
+                       stream_);
+      rocm::HcCollapse(s.hc_pre, s.streams, s.collapsed, hidden, n, stream_);
+      rocm::RmsNormRows(s.collapsed, norm.f32(), s.block_x, 1, hidden, 1,
+                        c.rms_eps, stream_);
+      const bool ok = sub == 0 ? AttentionBlock(session, layer, error_msg)
+                               : FfnBlock(session, layer, error_msg);
+      if (!ok) {
+        return false;
+      }
+      rocm::HcCombine(s.hc_post, s.hc_comb, s.residual, s.block_out, s.streams,
+                      hidden, n, stream_);
+    }
+  }
+  rocm::MeanStreams(s.streams, s.collapsed, hidden, n, stream_);
+  rocm::RmsNormRows(s.collapsed, slice_->output_norm().f32(), s.normed, 1,
+                    hidden, 1, c.rms_eps, stream_);
+  gufo::hip::LaunchQ8KBlockGEMV(slice_->output().data, q8, s.normed, s.logits,
+                                slice_->output().rows, slice_->output().cols,
+                                stream_);
+  ++session.position_;
+  if (logits == nullptr) {
+    return true;
+  }
+  if (!Check(hipStreamSynchronize(stream_), "step drain", error_msg)) {
+    return false;
+  }
+  return Check(hipMemcpy(logits, s.logits,
+                         static_cast<std::size_t>(c.vocab_size) * sizeof(float),
+                         hipMemcpyDeviceToHost),
+               "logits copy", error_msg);
+}
+
+bool Executor::Prefill(Session& session, std::span<const std::int32_t> tokens,
+                       float* logits, std::string* error_msg) const {
+  const std::uint32_t chunk =
+      options_.prefill_chunk != 0 && options_.prefill_chunk <= kMaxBatch
+          ? options_.prefill_chunk
+          : kMaxBatch;
+  std::size_t done = 0;
+  while (done < tokens.size()) {
+    const std::size_t n = std::min<std::size_t>(chunk, tokens.size() - done);
+    if (!StepBatch(session, tokens.subspan(done, n),
+                   done + n == tokens.size() ? logits : nullptr, error_msg)) {
+      return false;
+    }
+    done += n;
+  }
+  return true;
+}
+
+bool Executor::SumPartialBatch(std::uint32_t layer, int sub,
+                               std::uint32_t first_token, std::uint32_t n,
+                               std::string* error_msg) const {
+  if (options_.all_reduce &&
+      !options_.all_reduce(b_.block_out, n, stream_, error_msg)) {
+    return false;
+  }
+  if (options_.block_observer) {
+    options_.block_observer(layer, sub, first_token, n, b_.block_out, stream_);
+  }
+  return true;
+}
+
+bool Executor::AttentionBlockBatch(Session& session, std::uint32_t layer,
+                                   std::uint32_t n,
+                                   std::string* error_msg) const {
+  const Config& c = config();
+  const DeviceLayer& dl = slice_->layers()[layer];
+  const distributed::TpPartition& p = slice_->partition();
+  const std::uint32_t heads = p.head_count;
+  const std::uint32_t dim = c.kda_head_dim;
+  const std::uint32_t inner = heads * dim;
+  const auto q8 = gufo::core::GgmlType::kQ8_0;
+  const BatchScratch& b = b_;
+
+  if (dl.linear) {
+    const DeviceKda& kd = dl.kda;
+    Session::Kda& state = session.kda_[session.kda_cursor_];
+    ++session.kda_cursor_;
+    // The q|k|v groups share one [n][3 * inner] buffer; the stride keeps
+    // every group's rows on the concatenated layout.
+    const std::size_t qkv_stride = 3 * static_cast<std::size_t>(inner);
+    rocm::BatchQ8KBlockGEMV(kd.q.data, rocm::WeightTypeOf(kd.q.type), b.block_x,
+                            b.qkv, n, kd.q.rows, kd.q.cols, stream_,
+                            qkv_stride);
+    rocm::BatchQ8KBlockGEMV(kd.k.data, rocm::WeightTypeOf(kd.k.type), b.block_x,
+                            b.qkv + inner, n, kd.k.rows, kd.k.cols, stream_,
+                            qkv_stride);
+    rocm::BatchQ8KBlockGEMV(kd.v.data, rocm::WeightTypeOf(kd.v.type), b.block_x,
+                            b.qkv + 2 * inner, n, kd.v.rows, kd.v.cols, stream_,
+                            qkv_stride);
+    rocm::BatchKdaConv(b.qkv, kd.conv_q.f32(), kd.conv_k.f32(), kd.conv_v.f32(),
+                       state.history, b.conv_out, n, inner, c.kda_conv_kernel,
+                       stream_);
+    rocm::BatchF32Gemm(kd.f_a.f32(), b.block_x, b.f_a_out, n, kd.f_a.rows,
+                       c.hidden_size, stream_);
+    rocm::BatchF32Gemm(kd.f_b.f32(), b.f_a_out, b.raw, n, kd.f_b.rows,
+                       kd.f_b.cols, stream_);
+    rocm::BatchF32Gemm(kd.beta.f32(), b.block_x, b.beta_row, n, kd.beta.rows,
+                       c.hidden_size, stream_);
+    rocm::BatchKdaGates(b.raw, kd.a.f32(), kd.dt_bias.f32(), b.beta_row,
+                        c.kda_gate_lower_bound, b.gate, b.beta, n, inner, dim,
+                        heads, stream_);
+    rocm::BatchKdaPrepare(b.conv_out, b.qn, b.kn, n, heads, dim, 1e-6F,
+                          stream_);
+    rocm::BatchKdaRecurrence(b.qn, b.kn, b.gate, b.beta, b.conv_out,
+                             state.state, b.core, n, heads, dim, stream_);
+    rocm::RmsNormRows(b.core, kd.o_norm.f32(), b.core_normed,
+                      static_cast<std::uint32_t>(n) * heads, inner, heads,
+                      c.rms_eps, stream_);
+    rocm::BatchF32Gemm(kd.g_a.f32(), b.block_x, b.g_a_out, n, kd.g_a.rows,
+                       c.hidden_size, stream_);
+    rocm::BatchF32Gemm(kd.g_b.f32(), b.g_a_out, b.raw, n, kd.g_b.rows,
+                       kd.g_b.cols, stream_);
+    rocm::SigmoidMul(b.core_normed, b.raw, b.gated,
+                     static_cast<std::size_t>(n) * inner, stream_);
+    rocm::BatchQ8KBlockGEMV(kd.out.data, rocm::WeightTypeOf(kd.out.type),
+                            b.gated, b.block_out, n, kd.out.rows, kd.out.cols,
+                            stream_);
+    return SumPartialBatch(layer, 0, session.position_, n, error_msg);
+  }
+
+  const DeviceDsa& m = dl.dsa;
+  const DeviceIndexer& idx = dl.indexer;
+  Session::Dsa& cache = session.dsa_[session.dsa_cursor_];
+  ++session.dsa_cursor_;
+  const std::uint32_t start = session.position_;
+  const std::uint32_t seen_base = start;
+  const std::uint32_t kpool = c.indexer_kpool;
+  const std::uint32_t idim = c.indexer_head_dim;
+  const std::uint32_t pools_before = start / kpool;
+  const std::uint32_t pools_after = (start + n) / kpool;
+
+  rocm::BatchF32Gemm(m.kv_a.f32(), b.block_x, b.latent_raw, n, m.kv_a.rows,
+                     c.hidden_size, stream_);
+  rocm::RmsNormRows(b.latent_raw, m.kv_a_norm.f32(), b.latent_normed, n,
+                    c.kv_lora_rank, 1, c.rms_eps, stream_);
+  rocm::BatchAppendRows(b.latent_normed, cache.latents, c.kv_lora_rank, start,
+                        n, stream_);
+  rocm::BatchQ8KBlockGEMV(m.q_a.data, rocm::WeightTypeOf(m.q_a.type), b.block_x,
+                          b.q_resid_raw, n, m.q_a.rows, m.q_a.cols, stream_);
+  rocm::RmsNormRows(b.q_resid_raw, m.q_a_norm.f32(), b.q_resid, n,
+                    c.q_lora_rank, 1, c.rms_eps, stream_);
+  rocm::BatchF32Gemm(idx.k.f32(), b.block_x, b.idx_k_raw, n, idx.k.rows,
+                     c.hidden_size, stream_);
+  rocm::BatchF32Gemm(idx.comp_gate.f32(), b.block_x, b.idx_g_raw, n,
+                     idx.comp_gate.rows, c.hidden_size, stream_);
+  // The pool rows live in [frontier | chunk]; a straddling pool reads the
+  // frontier prefix, later pools the chunk rows.
+  // The live frontier rows are the current incomplete pool's (start % kpool
+  // of them); row indices in [frontier | chunk] run 3 + p - start.
+  const std::uint32_t copied = start % kpool;
+  const std::size_t row_base =
+      static_cast<std::size_t>(static_cast<std::int64_t>(start) - 3);
+  if (copied != 0) {
+    if (!Check(hipMemcpyAsync(
+                   b.rows_keys + (3 - copied) * idim, cache.frontier_keys,
+                   static_cast<std::size_t>(copied) * idim * sizeof(float),
+                   hipMemcpyDeviceToDevice, stream_),
+               "frontier copy", error_msg) ||
+        !Check(hipMemcpyAsync(
+                   b.rows_gates + (3 - copied) * idim, cache.frontier_gates,
+                   static_cast<std::size_t>(copied) * idim * sizeof(float),
+                   hipMemcpyDeviceToDevice, stream_),
+               "frontier copy", error_msg)) {
+      return false;
+    }
+  }
+  rocm::BatchIndexerAppend(b.idx_k_raw, b.idx_g_raw, idx.k_norm.f32(),
+                           idx.k_norm_bias.f32(), b.rows_keys + 3 * idim,
+                           b.rows_gates + 3 * idim, n, idim, c.layer_norm_eps,
+                           stream_);
+  rocm::BatchIndexerPool(b.rows_keys, b.rows_gates, idx.comp_ape.f32(),
+                         cache.pooled, pools_before, pools_after - pools_before,
+                         row_base, kpool, idim, stream_);
+  // The frontier keeps the final incomplete pool's rows at slots
+  // [0, live); dead slots are zeroed like the tokenwise pool restart.
+  const std::uint32_t live = (start + n) % kpool;
+  if (live != 0) {
+    if (!Check(hipMemcpyAsync(
+                   cache.frontier_keys,
+                   b.rows_keys + static_cast<std::size_t>(3 + n - live) * idim,
+                   static_cast<std::size_t>(live) * idim * sizeof(float),
+                   hipMemcpyDeviceToDevice, stream_),
+               "frontier writeback", error_msg) ||
+        !Check(hipMemcpyAsync(
+                   cache.frontier_gates,
+                   b.rows_gates + static_cast<std::size_t>(3 + n - live) * idim,
+                   static_cast<std::size_t>(live) * idim * sizeof(float),
+                   hipMemcpyDeviceToDevice, stream_),
+               "frontier writeback", error_msg)) {
+      return false;
+    }
+  }
+  if (live < kpool) {
+    if (!Check(
+            hipMemsetAsync(
+                cache.frontier_keys + static_cast<std::size_t>(live) * idim, 0,
+                static_cast<std::size_t>(kpool - live) * idim * sizeof(float),
+                stream_),
+            "frontier clear", error_msg) ||
+        !Check(
+            hipMemsetAsync(
+                cache.frontier_gates + static_cast<std::size_t>(live) * idim, 0,
+                static_cast<std::size_t>(kpool - live) * idim * sizeof(float),
+                stream_),
+            "frontier clear", error_msg)) {
+      return false;
+    }
+  }
+  rocm::BatchF32Gemm(idx.q_b.f32(), b.q_resid, b.iq, n, idx.q_b.rows,
+                     idx.q_b.cols, stream_);
+  rocm::BatchF32Gemm(idx.proj.f32(), b.block_x, b.head_weights_raw, n,
+                     idx.proj.rows, c.hidden_size, stream_);
+  rocm::ScaleRows(
+      b.head_weights_raw, b.head_weights,
+      static_cast<float>(1.0 / std::sqrt(static_cast<double>(c.indexer_heads))),
+      static_cast<std::size_t>(n) * c.indexer_heads, stream_);
+  const std::uint32_t pools = pools_after;
+  if (pools > 0) {
+    rocm::BatchIndexerScores(
+        b.iq, cache.pooled, b.head_weights, b.scores, max_pools_batch_, n,
+        pools, kpool, seen_base, c.indexer_heads, idim,
+        static_cast<float>(1.0 / std::sqrt(static_cast<double>(idim))),
+        stream_);
+    // The tokenwise path leaves the final query's scores in the session
+    // scratch; mirror that so session bytes match across the two paths.
+    if (!Check(hipMemcpyAsync(cache.scores,
+                              b.scores + static_cast<std::size_t>(n - 1) *
+                                             max_pools_batch_,
+                              static_cast<std::size_t>(pools) * sizeof(float),
+                              hipMemcpyDeviceToDevice, stream_),
+               "scores mirror", error_msg)) {
+      return false;
+    }
+    const std::uint32_t select_pools = std::min(c.indexer_top_k / kpool, pools);
+    if (!rocm::BatchSelectPools(b.scores, max_pools_batch_, n, pools,
+                                select_pools, kpool, seen_base,
+                                c.indexer_top_k + c.indexer_kpool, b.sel,
+                                b.counts, stream_)) {
+      SetError(error_msg, "batch selection rejected the pool configuration");
+      return false;
+    }
+  } else {
+    // Fresh session: no completed pools exist, the queries select from the
+    // incomplete tail only; the kernel handles zero pools without scores.
+    if (!rocm::BatchSelectPools(b.scores, max_pools_batch_, n, 0, 0, kpool,
+                                seen_base, c.indexer_top_k + c.indexer_kpool,
+                                b.sel, b.counts, stream_)) {
+      SetError(error_msg, "fresh-session selection failed the kernel bounds");
+      return false;
+    }
+  }
+  rocm::BatchQ8KBlockGEMV(m.q_b.data, rocm::WeightTypeOf(m.q_b.type), b.q_resid,
+                          b.q_full, n, m.q_b.rows, m.q_b.cols, stream_);
+  rocm::BatchMlaAbsorb(m.k_b.f32(), b.q_full, b.q_abs, n, heads, c.kv_lora_rank,
+                       c.qk_nope_head_dim, stream_);
+  rocm::BatchMlaAttention(
+      b.q_abs, cache.latents, b.sel, b.counts,
+      c.indexer_top_k + c.indexer_kpool, m.v_b.f32(), b.attn_out, b.attn_probs,
+      b.attn_weighted, n, heads, c.kv_lora_rank, c.qk_nope_head_dim,
+      c.v_head_dim,
+      static_cast<float>(1.0 /
+                         std::sqrt(static_cast<double>(c.qk_nope_head_dim))),
+      stream_);
+  rocm::BatchQ8KBlockGEMV(m.out.data, rocm::WeightTypeOf(m.out.type),
+                          b.attn_out, b.block_out, n, m.out.rows, m.out.cols,
+                          stream_);
+  return SumPartialBatch(layer, 0, start, n, error_msg);
+}
+
+bool Executor::FfnBlockBatch(Session& session, std::uint32_t layer,
+                             std::uint32_t n, std::string* error_msg) const {
+  const Config& c = config();
+  const DeviceLayer& dl = slice_->layers()[layer];
+  const auto q8 = gufo::core::GgmlType::kQ8_0;
+  const BatchScratch& b = b_;
+  if (dl.dense_ffn) {
+    rocm::BatchQ8KBlockGEMV(
+        dl.ffn_gate.data, rocm::WeightTypeOf(dl.ffn_gate.type), b.block_x,
+        b.gate_out, n, dl.ffn_gate.rows, dl.ffn_gate.cols, stream_);
+    rocm::BatchQ8KBlockGEMV(dl.ffn_up.data, rocm::WeightTypeOf(dl.ffn_up.type),
+                            b.block_x, b.up_out, n, dl.ffn_up.rows,
+                            dl.ffn_up.cols, stream_);
+    rocm::ClampedSwiglu(b.gate_out, b.up_out, b.act,
+                        static_cast<std::size_t>(n) * dl.ffn_gate.rows,
+                        c.swiglu_limit, stream_);
+    rocm::BatchQ8KBlockGEMV(
+        dl.ffn_down.data, rocm::WeightTypeOf(dl.ffn_down.type), b.act,
+        b.block_out, n, dl.ffn_down.rows, dl.ffn_down.cols, stream_);
+    return SumPartialBatch(layer, 1, session.position_, n, error_msg);
+  }
+
+  // Device-side routing: the router GEMM feeds the selection kernel
+  // directly — sigmoid probabilities, noaux_tc selection with ties to the
+  // lower expert id and the normalized top-k weights, with no host
+  // readback. The router runs replicated on identical inputs, so both
+  // ranks choose identical experts without an exchange.
+  rocm::BatchF32Gemm(dl.router.f32(), b.block_x, b.router, n, dl.router.rows,
+                     c.hidden_size, stream_);
+  rocm::BatchRouterSelect(b.router, dl.router_bias.f32(), b.ids, b.expert_w, n,
+                          c.expert_count, c.experts_used, c.routed_scaling,
+                          stream_);
+  if (!Check(hipMemsetAsync(
+                 b.block_out, 0,
+                 static_cast<std::size_t>(n) * c.hidden_size * sizeof(float),
+                 stream_),
+             "zero moe accumulator", error_msg)) {
+    return false;
+  }
+  const std::size_t gate_stride =
+      static_cast<std::size_t>(dl.gate_exps.rows) *
+      gufo::quant::QuantizedRowBytes(dl.gate_exps.type, dl.gate_exps.cols);
+  const std::size_t down_stride =
+      static_cast<std::size_t>(dl.down_exps.rows) *
+      gufo::quant::QuantizedRowBytes(dl.down_exps.type, dl.down_exps.cols);
+  const auto gate_type = rocm::WeightTypeOf(dl.gate_exps.type);
+  const bool grouped =
+      rocm::BatchExpertQ8KGrouped(
+          dl.gate_exps.data, gate_type, b.ids, b.expert_bins, b.expert_ranks,
+          b.expert_pairs, b.block_x, b.expert_gate, n, c.experts_used,
+          gate_stride, dl.gate_exps.rows, dl.gate_exps.cols, c.hidden_size,
+          c.expert_count, stream_) &&
+      rocm::BatchExpertQ8KGrouped(
+          dl.up_exps.data, rocm::WeightTypeOf(dl.up_exps.type), b.ids,
+          b.expert_bins, b.expert_ranks, b.expert_pairs, b.block_x, b.expert_up,
+          n, c.experts_used, gate_stride, dl.up_exps.rows, dl.up_exps.cols,
+          c.hidden_size, c.expert_count, stream_);
+  if (!grouped) {
+    rocm::BatchExpertQ8KBlockGEMV(dl.gate_exps.data, gate_type, b.ids,
+                                  b.block_x, b.expert_gate, n, c.experts_used,
+                                  gate_stride, dl.gate_exps.rows,
+                                  dl.gate_exps.cols, stream_);
+    rocm::BatchExpertQ8KBlockGEMV(
+        dl.up_exps.data, rocm::WeightTypeOf(dl.up_exps.type), b.ids, b.block_x,
+        b.expert_up, n, c.experts_used, gate_stride, dl.up_exps.rows,
+        dl.up_exps.cols, stream_);
+  }
+  // The routed pairs need experts_used intermediate rows per token — a
+  // dedicated buffer, not b.act (sized for one FFN row per token).
+  rocm::ClampedSwiglu(
+      b.expert_gate, b.expert_up, b.expert_act,
+      static_cast<std::size_t>(n) * c.experts_used * dl.gate_exps.rows,
+      c.swiglu_limit, stream_);
+  const auto down_type = rocm::WeightTypeOf(dl.down_exps.type);
+  if (!rocm::BatchExpertQ8KGrouped(
+          dl.down_exps.data, down_type, b.ids, b.expert_bins, b.expert_ranks,
+          b.expert_pairs, b.expert_act, b.expert_down, n, c.experts_used,
+          down_stride, dl.down_exps.rows, dl.down_exps.cols, 1, c.expert_count,
+          stream_)) {
+    rocm::BatchExpertQ8KBlockGEMVPairDense(
+        dl.down_exps.data, down_type, b.ids, b.expert_act, b.expert_down, n,
+        c.experts_used, down_stride, dl.down_exps.rows, dl.down_exps.cols,
+        stream_);
+  }
+  for (std::uint32_t k = 0; k < c.experts_used; ++k) {
+    rocm::ScaleAddRowsWeighted(
+        b.block_out,
+        b.expert_down + static_cast<std::size_t>(k) * c.hidden_size,
+        b.expert_w + static_cast<std::size_t>(k) * n, n, c.hidden_size,
+        static_cast<std::size_t>(c.experts_used) * c.hidden_size, stream_);
+  }
+  const std::uint32_t shared_ff = slice_->partition().shared_ff_count;
+  rocm::BatchQ8KBlockGEMV(
+      dl.gate_shexp.data, rocm::WeightTypeOf(dl.gate_shexp.type), b.block_x,
+      b.gate_out, n, dl.gate_shexp.rows, dl.gate_shexp.cols, stream_);
+  rocm::BatchQ8KBlockGEMV(
+      dl.up_shexp.data, rocm::WeightTypeOf(dl.up_shexp.type), b.block_x,
+      b.up_out, n, dl.up_shexp.rows, dl.up_shexp.cols, stream_);
+  rocm::ClampedSwiglu(b.gate_out, b.up_out, b.act,
+                      static_cast<std::size_t>(n) * shared_ff, c.swiglu_limit,
+                      stream_);
+  // The shared down lands in the consumed expert_up buffer: expert_down
+  // is [token][slot][hidden] and a [t][hidden] write would alias routed
+  // pairs.
+  rocm::BatchQ8KBlockGEMV(
+      dl.down_shexp.data, rocm::WeightTypeOf(dl.down_shexp.type), b.act,
+      b.expert_up, n, dl.down_shexp.rows, dl.down_shexp.cols, stream_);
+  rocm::ScaleAddInto(b.block_out, b.expert_up, 1.0F,
+                     static_cast<std::size_t>(n) * c.hidden_size, stream_);
+  return SumPartialBatch(layer, 1, session.position_, n, error_msg);
+}
+
+bool Executor::StepBatch(Session& session, std::span<const std::int32_t> tokens,
+                         float* logits, std::string* error_msg) const {
+  if (tokens.empty() || tokens.size() > kMaxBatch) {
+    SetError(error_msg, "batch width is outside [1, kMaxBatch]");
+    return false;
+  }
+  if (session.position_ + tokens.size() > session.capacity_) {
+    SetError(error_msg, "batch would exceed the session capacity");
+    return false;
+  }
+  const std::uint32_t n = static_cast<std::uint32_t>(tokens.size());
+  session.kda_cursor_ = 0;
+  session.dsa_cursor_ = 0;
+  const Config& c = config();
+  // The batched indexer scores and selection kernels are bounded; reject
+  // an unsupported context up front, before any device state is touched.
+  const std::uint32_t pools_after = (session.position_ + n) / c.indexer_kpool;
+  if (pools_after > max_pools_batch_) {
+    SetError(error_msg, "session pool count exceeds the batch selection bound");
+    return false;
+  }
+  const BatchScratch& b = b_;
+  const std::uint32_t streams_n = c.hc_count;
+  const std::uint32_t hidden = c.hidden_size;
+  const auto q8 = gufo::core::GgmlType::kQ8_0;
+
+  if (!Check(hipMemcpyAsync(b.tokens, tokens.data(),
+                            tokens.size() * sizeof(std::int32_t),
+                            hipMemcpyHostToDevice, stream_),
+             "tokens upload", error_msg)) {
+    return false;
+  }
+  if (!rocm::BatchEmbedTokenStreams(
+          slice_->token_embd().data,
+          rocm::WeightTypeOf(slice_->token_embd().type), b.tokens, b.streams,
+          hidden, streams_n, n, stream_, error_msg)) {
+    return false;
+  }
+  for (std::uint32_t layer = 0; layer < slice_->layer_count(); ++layer) {
+    const DeviceLayer& dl = slice_->layers()[layer];
+    for (int sub = 0; sub < 2; ++sub) {
+      const DeviceHc& hc = sub == 0 ? dl.hc_attn : dl.hc_ffn;
+      const DeviceTensor& norm = sub == 0 ? dl.attn_norm : dl.ffn_norm;
+      if (!Check(hipMemcpyAsync(b.residual, b.streams,
+                                static_cast<std::size_t>(n) * streams_n *
+                                    hidden * sizeof(float),
+                                hipMemcpyDeviceToDevice, stream_),
+                 "residual copy", error_msg)) {
+        return false;
+      }
+      rocm::RmsNormRows(b.streams, nullptr, b.flat, n, streams_n * hidden, 1,
+                        c.rms_eps, stream_);
+      rocm::BatchF32Gemm(static_cast<const float*>(hc.fn.data), b.flat, b.mixes,
+                         n, c.HcMixDim(), streams_n * hidden, stream_);
+      rocm::BatchHcSinkhorn(b.mixes, static_cast<const float*>(hc.scale.data),
+                            static_cast<const float*>(hc.base.data), b.hc_pre,
+                            b.hc_post, b.hc_comb, streams_n, n,
+                            c.hc_sinkhorn_iters, c.hc_eps, stream_);
+      rocm::BatchHcCollapse(b.hc_pre, b.streams, b.collapsed, hidden, streams_n,
+                            n, stream_);
+      rocm::RmsNormRows(b.collapsed, norm.f32(), b.block_x, n, hidden, 1,
+                        c.rms_eps, stream_);
+      const bool ok = sub == 0
+                          ? AttentionBlockBatch(session, layer, n, error_msg)
+                          : FfnBlockBatch(session, layer, n, error_msg);
+      if (!ok) {
+        return false;
+      }
+      rocm::BatchHcCombine(b.hc_post, b.hc_comb, b.residual, b.block_out,
+                           b.streams, hidden, streams_n, n, stream_);
+    }
+  }
+  rocm::BatchMeanStreams(b.streams, b.collapsed, hidden, streams_n, n, stream_);
+  rocm::RmsNormRows(b.collapsed, slice_->output_norm().f32(), b.normed, n,
+                    hidden, 1, c.rms_eps, stream_);
+  gufo::hip::LaunchQ8KBlockGEMV(
+      slice_->output().data, q8,
+      b.normed + static_cast<std::size_t>(n - 1) * hidden, s_.logits,
+      slice_->output().rows, slice_->output().cols, stream_);
+  session.position_ += n;
+  if (logits == nullptr) {
+    return true;
+  }
+  if (!Check(hipStreamSynchronize(stream_), "batch drain", error_msg)) {
+    return false;
+  }
+  return Check(hipMemcpy(logits, s_.logits,
+                         static_cast<std::size_t>(c.vocab_size) * sizeof(float),
+                         hipMemcpyDeviceToHost),
+               "logits copy", error_msg);
+}
