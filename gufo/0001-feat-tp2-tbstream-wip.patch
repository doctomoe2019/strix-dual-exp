+namespace glm = gufo::models::glm5_next;
+
+namespace {
+
+void Require(bool condition, const char* message) {
+  if (!condition)
+    throw std::runtime_error(message);
+}
+
+using Value =
+    std::variant<std::uint32_t, float, double, bool, std::string,
+                 std::vector<std::uint64_t>, std::vector<std::int64_t>,
+                 std::vector<double>, std::vector<std::uint8_t>>;
+using Metadata = std::map<std::string, Value>;
+
+// Minimal metadata-only GGUF, as the qwen38 config test builds one.
+std::optional<glm::Config> Parse(const Metadata& fields) {
+  std::vector<std::uint8_t> bytes;
+  const auto pod = [&]<class T>(T value) {
+    const auto begin = bytes.size();
+    bytes.resize(begin + sizeof(value));
+    std::memcpy(bytes.data() + begin, &value, sizeof(value));
+  };
+  const auto text = [&](const std::string& value) {
+    pod(std::uint64_t{value.size()});
+    bytes.insert(bytes.end(), value.begin(), value.end());
+  };
+  pod(std::uint32_t{0x46554747});
+  pod(std::uint32_t{3});
+  pod(std::uint64_t{0});
+  pod(std::uint64_t{fields.size()});
+  for (const auto& [key, value] : fields) {
+    text(key);
+    std::visit(
+        [&](const auto& item) {
+          using T = std::decay_t<decltype(item)>;
+          if constexpr (std::is_same_v<T, std::uint32_t>) {
+            pod(std::uint32_t{4});
+            pod(item);
+          } else if constexpr (std::is_same_v<T, float>) {
+            pod(std::uint32_t{6});
+            pod(item);
+          } else if constexpr (std::is_same_v<T, double>) {
+            pod(std::uint32_t{12});
+            pod(item);
+          } else if constexpr (std::is_same_v<T, bool>) {
+            pod(std::uint32_t{7});
+            pod(std::uint8_t{item ? 1 : 0});
+          } else if constexpr (std::is_same_v<T, std::string>) {
+            pod(std::uint32_t{8});
+            text(item);
+          } else if constexpr (std::is_same_v<T, std::vector<std::uint8_t>>) {
+            pod(std::uint32_t{9});
+            pod(std::uint32_t{7});
+            pod(std::uint64_t{item.size()});
+            for (const auto entry : item)
+              pod(static_cast<std::uint8_t>(entry ? 1 : 0));
+          } else {
+            pod(std::uint32_t{9});
+            using E = typename T::value_type;
+            pod(std::uint32_t{std::is_same_v<E, std::uint64_t>  ? 10U
+                              : std::is_same_v<E, std::int64_t> ? 11U
+                                                                : 12U});
+            pod(std::uint64_t{item.size()});
+            for (const auto entry : item)
+              pod(entry);
+          }
+        },
+        value);
+  }
+  bytes.resize((bytes.size() + 31) / 32 * 32);
+  std::string error;
+  const auto reader =
+      gufo::core::GgufReader::OpenMemory(bytes.data(), bytes.size(), &error);
+  assert(reader && error.empty());
+  const auto result = glm::Config::FromGguf(*reader, &error);
+  assert(result.has_value() == error.empty());
+  return result;
+}
+
+Metadata ValidMetadata() {
+  Metadata fields{{"general.architecture", std::string{"glm5-next"}}};
+  for (const auto& [key, value] :
+       std::initializer_list<std::pair<const char*, std::uint32_t>>{
+           {"block_count", 46},
+           {"nextn_predict_layers", 1},
+           {"embedding_length", 4096},
+           {"vocab_size", 154880},
+           {"context_length", 1048576},
+           {"attention.head_count", 64},
+           {"attention.key_length", 512},
+           {"attention.key_length_mla", 256},
+           {"attention.value_length", 512},
+           {"attention.value_length_mla", 256},
+           {"attention.kv_lora_rank", 512},
+           {"attention.q_lora_rank", 1536},
+           {"rope.dimension_count", 0},
+           {"kda.head_dim", 128},
+           {"ssm.conv_kernel", 4},
+           {"attention.indexer.head_count", 32},
+           {"attention.indexer.key_length", 128},
+           {"attention.indexer.top_k", 2048},
+           {"attention.indexer.kpool", 4},
+           {"hyper_connection.count", 4},
+           {"hyper_connection.sinkhorn_iterations", 20},
+           {"leading_dense_block_count", 3},
+           {"feed_forward_length", 12288},
+           {"expert_count", 288},
+           {"expert_used_count", 8},
+           {"expert_shared_count", 1},
+           {"expert_feed_forward_length", 2048},
+           {"expert_gating_func", 2}}) {
+    fields[std::string{"glm5-next."} + key] = value;
+  }
+  fields["tokenizer.ggml.eos_token_id"] = std::uint32_t{154820};
+  fields["tokenizer.ggml.eom_token_id"] = std::uint32_t{154829};
+  fields["tokenizer.ggml.eot_token_id"] = std::uint32_t{154827};
+  fields["glm5-next.attention.layer_norm_rms_epsilon"] = 1e-5F;
+  fields["glm5-next.attention.layer_norm_epsilon"] = 1e-6F;
+  fields["glm5-next.hyper_connection.epsilon"] = 1e-6F;
+  fields["glm5-next.kda.gate_lower_bound"] = -5.0F;
+  fields["glm5-next.expert_weights_scale"] = 2.5F;
+  fields["glm5-next.attention.indexer.kpool_select_tail"] = true;
+  fields["glm5-next.expert_weights_norm"] = true;
+  // DSA (sparse MLA) layers: 3, 7, ..., 43 and the nextn block 45.
+  std::vector<std::uint64_t> kv_heads(46, 0);
+  for (std::uint32_t i = 3; i < 45; i += 4)
+    kv_heads[i] = 1;
+  kv_heads[45] = 1;
+  fields["glm5-next.attention.head_count_kv"] = kv_heads;
+  fields["glm5-next.attention.indexer.types"] =
+      std::vector<std::uint64_t>(45, 1);
+  fields["glm5-next.swiglu_clamp_exp"] = std::vector<double>(46, 10.0);
+  fields["glm5-next.swiglu_clamp_shexp"] = std::vector<double>(46, 10.0);
+  return fields;
+}
+
+void CheckValidMetadata() {
+  const auto config = Parse(ValidMetadata());
+  Require(config.has_value(), "valid metadata rejected");
+  Require(config->num_layers == 45 && config->nextn_layers == 1,
+          "trunk/nextn split is wrong");
+  Require(config->DsaLayerCount() == 11 && config->KdaLayerCount() == 34,
+          "layer kinds are wrong");
+  Require(config->IsDsaLayer(3) && config->IsDsaLayer(43) &&
+              !config->IsDsaLayer(2) && !config->IsDsaLayer(44),
+          "DSA layer positions are wrong");
+  Require(config->IsDenseFfnLayer(2) && !config->IsDenseFfnLayer(3),
+          "dense lead is wrong");
+  Require(config->KdaInnerDim() == 8192, "KDA inner dim");
+  Require(config->MlaQueryDim() == 16384, "MLA query dim");
+  Require(config->HcDim() == 16384 && config->HcMixDim() == 24, "mHC dims");
+  Require(config->IndexerQueryDim() == 4096, "indexer query dim");
+  Require(config->eos_token_ids.size() == 3,
+          "three distinct stop ids expected");
+  Require(config->routed_scaling == 2.5F && config->swiglu_limit == 10.0F,
+          "MoE constants");
+}
