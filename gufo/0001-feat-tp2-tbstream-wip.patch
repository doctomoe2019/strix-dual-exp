+        std::map<std::tuple<std::uint32_t, int, std::uint32_t>, std::uint64_t>
+            taken;
+        taken.swap(block_map);
+        side->blocks = std::move(taken);
+      };
+      auto pick = [&]() {
+        return static_cast<std::int32_t>(
+            std::max_element(logits.begin(), logits.end()) - logits.begin());
+      };
