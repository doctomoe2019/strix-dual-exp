+constexpr std::uint32_t kBlockThreads = 256;
+constexpr std::uint32_t kGemmWaves = 4;
+constexpr std::uint32_t kSelectMaxPools = 1024;
+/// Shared-memory expert tables of the router selection kernel. Must
+/// match the public kRouterExpertLimit in kernels_batch.hpp.
+constexpr std::uint32_t kMaxRouterExperts = 512;
+
+__device__ __forceinline__ float SigmoidF(float x) {
+  return 1.0F / (1.0F + expf(-x));
+}
+
+/// Serial partial-sum reduction, byte-identical to the tokenwise path's
+/// BlockSumDouble: a tree reduction rounds differently and would make the
+/// batched results diverge at rounding boundaries.
+__device__ __forceinline__ double BlockSum(double value, double* shared) {
+  const std::uint32_t tid = threadIdx.x;
+  shared[tid] = value;
+  __syncthreads();
+  if (tid == 0) {
+    double sum = 0.0;
+    for (std::uint32_t t = 0; t < blockDim.x; ++t) {
+      sum += shared[t];
+    }
+    shared[0] = sum;
+  }
+  __syncthreads();
+  return shared[0];
+}
+
+/// Ordered float key, as in the tokenwise selection kernel.
+__device__ __forceinline__ std::uint64_t PoolKey(float score,
+                                                 std::uint32_t pool) {
+  std::uint32_t bits = __float_as_uint(score);
+  if ((bits & 0x7fffffffu) == 0u) {
+    bits = 0u;
+  }
+  const std::uint32_t ordered =
+      (bits & 0x80000000u) ? ~bits : (bits ^ 0x80000000u);
+  return (static_cast<std::uint64_t>(ordered) << 32) |
+         static_cast<std::uint64_t>(0xffffffffu - pool);
+}
+
+/// Ordered float key over (probs + bias), ties resolved to the lower
+/// expert id — the host stable sort's ordering, packed for a single
+/// unsigned comparison.
+__device__ __forceinline__ std::uint64_t RouterKey(float score,
+                                                   std::uint32_t expert) {
+  std::uint32_t bits = __float_as_uint(score);
+  if ((bits & 0x7fffffffu) == 0u) {
+    bits = 0u;
+  }
+  const std::uint32_t ordered =
+      (bits & 0x80000000u) ? ~bits : (bits ^ 0x80000000u);
+  return (static_cast<std::uint64_t>(ordered) << 32) |
+         static_cast<std::uint64_t>(0xffffffffu - expert);
+}
+
+/// One block per token: sigmoid probabilities (the sigmoid itself in
+/// double), noaux_tc selection by probs + bias with ties to the lower
+/// expert id, then the normalized top-k routing weights in selection
+/// order — the host routing path's arithmetic without the readback.
+/// ids are [tokens][experts_used]; weights are slot-major
+/// [experts_used][tokens] for the weighted accumulate.
+__global__ void BatchRouterSelectKernel(const float* logits, const float* bias,
+                                        std::int32_t* ids, float* weights,
+                                        std::uint32_t tokens,
+                                        std::uint32_t expert_count,
+                                        std::uint32_t experts_used,
+                                        float routed_scaling) {
+  __shared__ float prob[kMaxRouterExperts];
+  __shared__ std::uint64_t key[kMaxRouterExperts];
+  __shared__ bool used[kMaxRouterExperts];
+  __shared__ std::uint64_t reduce[kBlockThreads];
+  const std::uint32_t t = blockIdx.x;
+  const std::uint32_t tid = threadIdx.x;
+  const float* row = logits + static_cast<std::size_t>(t) * expert_count;
+  for (std::uint32_t e = tid; e < expert_count; e += kBlockThreads) {
+    const double p = 1.0 / (1.0 + exp(-static_cast<double>(row[e])));
+    const float pf = static_cast<float>(p);
+    prob[e] = pf;
+    key[e] = RouterKey(pf + bias[e], e);
+    used[e] = false;
+  }
+  __syncthreads();
+  for (std::uint32_t k = 0; k < experts_used; ++k) {
+    // Iterative argmax over the packed keys equals the stable sort's
+    // descending order with ties to the lower id. The block maximum runs
+    // as a shared-memory tree so no warp shuffle touches the 64-bit keys.
+    std::uint64_t best = 0;
+    for (std::uint32_t e = tid; e < expert_count; e += kBlockThreads) {
+      if (!used[e] && key[e] > best) {
+        best = key[e];
+      }
+    }
+    reduce[tid] = best;
+    __syncthreads();
+    for (std::uint32_t stride = kBlockThreads / 2; stride > 0; stride >>= 1) {
+      if (tid < stride) {
+        if (reduce[tid + stride] > reduce[tid]) {
+          reduce[tid] = reduce[tid + stride];
+        }
+      }
+      __syncthreads();
+    }
+    if (tid == 0) {
+      const std::uint32_t e =
+          0xffffffffu - static_cast<std::uint32_t>(reduce[0]);
+      ids[static_cast<std::size_t>(t) * experts_used + k] =
+          static_cast<std::int32_t>(e);
+      used[e] = true;
+    }
+    __syncthreads();
+  }
+  if (tid == 0) {
+    double weight_sum = 0.0;
+    for (std::uint32_t k = 0; k < experts_used; ++k) {
+      weight_sum += prob[static_cast<std::uint32_t>(
+          ids[static_cast<std::size_t>(t) * experts_used + k])];
+    }
+    for (std::uint32_t k = 0; k < experts_used; ++k) {
+      const float p = prob[static_cast<std::uint32_t>(
+          ids[static_cast<std::size_t>(t) * experts_used + k])];
+      weights[static_cast<std::size_t>(k) * tokens + t] =
+          static_cast<float>(p / (weight_sum + 1e-20) * routed_scaling);
+    }
+  }
+}
+
+__global__ void BatchEmbedKernel(const void* table, std::uint32_t type,
+                                 const std::int32_t* tokens, float* streams,
+                                 std::uint32_t hidden,
+                                 std::uint32_t n_streams) {
+  const std::uint32_t t = blockIdx.y;
+  const std::uint32_t i = blockIdx.x * blockDim.x + threadIdx.x;
+  if (i >= hidden / 4) {
+    return;
+  }
+  const std::int32_t token = tokens[t];
+  float4 value;
+  if (type == 0U) {  // kF32
+    value = *reinterpret_cast<const float4*>(
+        static_cast<const float*>(table) +
+        static_cast<std::uint64_t>(token) * hidden + i * 4);
+  } else {
+    // Q8_0: one 34-byte block per 32 values, 4 values per lane. The
+    // quantized payloads are signed int8.
+    const auto* q8 = static_cast<const std::uint8_t*>(table);
+    const std::uint32_t block = (i * 4) / 32;
+    const std::uint32_t lane = (i * 4) % 32;
+    const std::uint32_t row_blocks = hidden / 32;
+    const std::uint8_t* b =
+        q8 + (static_cast<std::uint64_t>(token) * row_blocks + block) * 34U;
+    const std::uint16_t raw = *reinterpret_cast<const std::uint16_t*>(b);
+    const float d = __half2float(__ushort_as_half(raw));
+    const auto* qs = reinterpret_cast<const std::int8_t*>(b + 2);
+    value.x = d * static_cast<float>(qs[lane]);
+    value.y = d * static_cast<float>(qs[lane + 1]);
+    value.z = d * static_cast<float>(qs[lane + 2]);
+    value.w = d * static_cast<float>(qs[lane + 3]);
+  }
+  for (std::uint32_t s = 0; s < n_streams; ++s) {
+    *reinterpret_cast<float4*>(
+        streams + (static_cast<std::size_t>(t) * n_streams + s) * hidden +
+        i * 4) = value;
+  }
+}
+
+template<std::uint32_t WavesPerBlock>
+__global__ void BatchQ8KKernel(const void* w, std::uint32_t type,
+                               const float* x, float* y, std::uint32_t m,
+                               std::uint32_t k, std::size_t y_stride) {
+  const std::uint32_t t = blockIdx.y;
+  const std::uint32_t lane = threadIdx.x & 31u;
+  const std::uint32_t warp = threadIdx.x >> 5u;
+  const std::uint32_t row = blockIdx.x * WavesPerBlock + warp;
+  if (row >= m) {
+    return;
+  }
+  const auto ggml_type = static_cast<gufo::core::GgmlType>(type);
+  const float sumf = gufo::hip::QuantWarpBlockDot(
+      ggml_type, w, row, x + static_cast<std::size_t>(t) * k, k, lane, 0, 1);
+  if (lane == 0) {
+    y[static_cast<std::size_t>(t) * y_stride + row] = sumf;
+  }
+}
+
+template<std::uint32_t WavesPerBlock>
+__global__ void BatchExpertQ8KKernel(const void* w, std::uint32_t type,
+                                     const std::int32_t* ids, const float* x,
+                                     float* y, std::uint32_t slots,
+                                     std::size_t expert_stride, std::uint32_t m,
+                                     std::uint32_t k, std::size_t x_stride) {
+  const std::uint32_t pair = blockIdx.y;
+  const std::uint32_t t = pair / slots;
+  const std::uint32_t slot = pair % slots;
+  const std::uint32_t lane = threadIdx.x & 31u;
+  const std::uint32_t warp = threadIdx.x >> 5u;
+  const std::uint32_t row = blockIdx.x * WavesPerBlock + warp;
+  if (row >= m) {
+    return;
+  }
+  const auto* base = static_cast<const std::uint8_t*>(w) +
+                     static_cast<std::size_t>(
+                         ids[static_cast<std::size_t>(t) * slots + slot]) *
+                         expert_stride;
+  // Gate/up read the token's shared activation row; the down projection
+  // reads each pair's own SwiGLU row (x is dense per pair).
+  const std::size_t x_row = x_stride == 1
+                                ? static_cast<std::size_t>(pair) * k
+                                : static_cast<std::size_t>(t) * x_stride;
+  const auto ggml_type = static_cast<gufo::core::GgmlType>(type);
+  const float sumf = gufo::hip::QuantWarpBlockDot(ggml_type, base, row,
+                                                  x + x_row, k, lane, 0, 1);
+  if (lane == 0) {
+    y[(static_cast<std::size_t>(pair)) * m + row] = sumf;
+  }
+}
+
+__global__ void BatchF32GemmKernel(const float* w, const float* x, float* y,
+                                   std::uint32_t m, std::uint32_t k) {
+  __shared__ double shared[kBlockThreads];
+  const std::uint32_t row = blockIdx.x;
+  const std::uint32_t t = blockIdx.y;
+  if (row >= m) {
+    return;
+  }
+  const float* src = w + static_cast<std::size_t>(row) * k;
+  const float* vec = x + static_cast<std::size_t>(t) * k;
+  double sum = 0.0;
+  for (std::uint32_t i = threadIdx.x; i < k; i += blockDim.x) {
+    sum += static_cast<double>(src[i]) * vec[i];
+  }
+  y[static_cast<std::size_t>(t) * m + row] =
+      static_cast<float>(BlockSum(sum, shared));
+}
+
+/// Dense projection tile shapes, tuned per weight family (quantized vs F32)
+/// and independently of the expert tile above. The terms each shape knob
+/// controls, per chunk of n tokens:
+///   - weight DRAM ~ (n / tokens) x table bytes: a tokens-wide tile re-reads
+///     every weight row once per tile, so token scaling divides it;
+///   - x staging L2 ~ (m / (warps * rows)) x n x k x 4: every block restages
+///     the tile's activations from global, so wider blocks divide it;
+///   - LDS staging = tokens x (K / 32 blocks of stride 33) floats (quant) or
+///     tokens x K floats (F32), i.e. tokens x K x ~4 B per block.
+/// The tile shape is a property of the kernel, not of the invocation: the
+/// tokenwise path (n = 1) launches the identical shape, so chunked-vs-
+/// tokenwise equality holds for any constants and the CPU-oracle RMS cap
+/// covers the reduction regrouping a re-shape causes.
+constexpr std::uint32_t kQuantTokens = 16;
+constexpr std::uint32_t kQuantK = 512;
+constexpr std::uint32_t kQuantWarps = 32;
+/// Output rows each warp accumulates per staged tile (row stride kQuantWarps),
+/// the x-staging amortization the expert kernel uses.
+constexpr std::uint32_t kQuantRows = 2;
+
+/// F32 dense-projection tile shapes, weight-stationary: one staged x tile
+/// feeds warps * rows output rows and covers `tokens` tokens per weight
+/// pass, so the table re-read is ceil(n / tokens) per chunk and the x
+/// restaging is (m / (warps * rows)) x n x k x 4.
+///
+/// The accumulation is FLOAT in both shapes — the one contract relaxation
+/// this goal pre-approved, adopted with the measured evidence chain in
+/// notes/f32-ws-250.md: the family was FP64-pipe-bound (461 GFLOP/s f64
+/// FMA ceiling measured on-chip vs 8385 fp32; weight-stationary DOUBLE
+/// variants with 2-4x lower traffic measured within noise of the landed
+/// double kernel, so traffic was not binding), and the float prototype
+/// measured 9.8x on the real shape set. Both shapes switched together, so
+/// the tokenwise path (n = 1) launches the same kernels and
+/// chunked-vs-tokenwise byte identity holds by construction; the
+/// CPU-oracle caps re-ran on the switch (worst logits rel_rms
+/// 7.484e-07 -> 7.481e-07, cap 2e-4 unchanged; notes/f32-ws-250.md has
+/// the chain).
+/// Per-(row, token) statement order,
+/// lane run assignment and the single butterfly are the landed kernel's.
+constexpr std::uint32_t kF32K = 512;
+constexpr std::uint32_t kF32PrefillTokens = 32;
+constexpr std::uint32_t kF32PrefillWarps = 32;
+constexpr std::uint32_t kF32PrefillRows = 2;
+constexpr std::uint32_t kF32DecodeTokens = 8;
+constexpr std::uint32_t kF32DecodeWarps = 16;
+constexpr std::uint32_t kF32DecodeRows = 1;
+/// Batch width at which the F32 tile dispatches the prefill shape (32
+/// tokens x 64 rows, 64 KiB LDS exactly) instead of the decode shape
+/// (8 tokens x 16 rows, 16 KiB). Both shapes carry identical per-(row,
+/// token) statement order — the token tile width is a property of the
+/// kernel, not of the invocation — so the boundary cannot change any
+/// output byte; it only picks the faster shape per regime (the decode
+/// shape wins through n <= 96 on every real shape, the prefill shape
+/// from n >= 128 on the big movers).
+constexpr std::uint32_t kF32PrefillBatch = 128;
+
+/// Multi-query tiling for the absorbed sparse-MLA kernels. One attention
+/// block covers kMlaHeads query heads of a kMlaTileTokens-wide token tile:
+/// every latent cache row gathered for a token (score dots and the weighted
+/// gather, the dominant L2 stream) is loaded once and shared by all heads of
+/// the tile, and the v_b panel rows of the epilogue are shared by the token
+/// tile. The attention tile launches as two kernels — score+softmax, then
+/// gather+epilogue — that communicate only through the probs/weighted
+/// global stripes (the fused kernel's 112-VGPR register set capped residency
+/// at one 512-thread block per CU; the split halves let two reside). The
+/// softmax evaluates the exponential terms cooperatively into shared memory
+/// and walks the reference's serial double sum in selection order over
+/// them, so every probability is bit-identical to the fused form. The
+/// absorb kernel tiles kMlaAbsorbTokens tokens per block so the k_b panel
+/// is read once per tile. Per-element accumulation orders are unchanged —
+/// lane partials walk the reduction dimension in the same ascending order,
+/// the gather keeps its four interleaved accumulators and final combine,
+/// and the epilogues keep the warp butterflies — so the tokenwise path
+/// (n = 1) and the chunked path stay byte-identical by construction. The
+/// launcher falls back to the legacy kernels for any geometry the tiled
+/// forms do not cover.
+constexpr std::uint32_t kMlaHeads = 8;
+constexpr std::uint32_t kMlaTileTokens = 4;
+constexpr std::uint32_t kMlaAbsorbTokens = 8;
+/// Lane-strided register staging the tiled kernels rely on: kv_lora and
+/// qk_nope must be whole multiples of 32 lanes within these caps.
+constexpr std::uint32_t kMlaLoraLanes = 16;  // kv_lora <= 512
+constexpr std::uint32_t kMlaNopeLanes = 8;   // qk_nope <= 256
+constexpr std::uint32_t kMlaMaxWarps = 16;   // blockDim 512
+
+/// Expert grouped-GEMM tile shape, tuned independently of the dense
+/// projection tile above. At 512-token chunks the buckets average
+/// ~14 pairs per expert (512 tokens x 8 active experts / 288 experts), so
+/// a 16-pair tile reads and decodes each expert weight row ~once per
+/// chunk instead of once per 4-pair tile. The padded staging is
+/// kExpertTokens x (kExpertK / 32 blocks of stride 34) floats — 34.0 KiB
+/// at 16x512, one block per 64 KiB LDS unit.
+constexpr std::uint32_t kExpertTokens = 16;
+constexpr std::uint32_t kExpertK = 512;
+constexpr std::uint32_t kExpertWarps = 16;
+/// Output rows each warp accumulates per staging pass. One staged
+/// activation tile feeds kExpertWarps * kExpertRows output rows, so the
+/// pair tile's x rows are fetched from global once per
+/// m / (kExpertWarps * kExpertRows) row groups (32 rows at 16x2) instead
+/// of once per kExpertWarps rows — the dominant traffic term once the
+/// weight re-reads are gone.
+constexpr std::uint32_t kExpertRows = 2;
+
+/// Batch width at which the grouped expert GEMM dispatches the
+/// weight-stationary prefill shape below instead of the decode shape. Below
+/// it the mean bucket is under ~2 pairs (tokens * 8 / 288 experts), the
+/// occupancy-limited small-M regime; above it staging traffic dominates.
+/// Both shapes are bit-identical twins of the generic kernel, so the
+/// dispatch boundary cannot change any output.
+constexpr std::uint32_t kExpertPrefillBatch = 64;
+
+/// Weight-stationary grouped-GEMM shapes (BatchExpertGroupedWsKernel). The
+/// bucket-resident accumulators carry the whole B-pair bucket across the K
+/// stream, so each expert's weight rows are read (and decoded) once per
+/// ceil(bucket / B) passes instead of once per 16-pair tile: at 1024-wide
+/// chunks (mean bucket ~28.4) the prefill shape reads the expert table
+/// ~1.15x per chunk vs the generic tile's ~2x. The decode shape trades the
+/// bucket width for a 8-pair staging tile (17.0 KiB LDS, 3 blocks per
+/// 64 KiB unit) whose extra residency hides the tiny-bucket latency: n=1
+/// launches measure 25-40% faster than the generic kernel while staying
+/// bit-identical. Shape sweep and measurements: notes/experts-ws-250.md.
+constexpr std::uint32_t kExpertWsPrefillBucket = 32;
+constexpr std::uint32_t kExpertWsPrefillStage = 16;
+constexpr std::uint32_t kExpertWsPrefillWarps = 32;
+constexpr std::uint32_t kExpertWsPrefillRows = 1;
+constexpr std::uint32_t kExpertWsDecodeBucket = 16;
+constexpr std::uint32_t kExpertWsDecodeStage = 8;
+constexpr std::uint32_t kExpertWsDecodeWarps = 16;
+constexpr std::uint32_t kExpertWsDecodeRows = 2;
+
+/// Stages staged[Tokens][K] from x[t][base + e]. Rows past the live token
+/// count are never written: the consumers' token loops are unconditional
+/// (see below) but their dead slots only ever feed the epilogue's guarded
+/// stores, so garbage there is never observed. The K tail of live rows is
+/// zero-filled.
+template<std::uint32_t Tokens, std::uint32_t K, std::uint32_t Warps>
+__device__ __forceinline__ void StageActivations(
+    float (&staged)[Tokens][K], const float* x, std::uint32_t k,
+    std::uint32_t base, std::uint32_t tile, std::uint32_t token_base,
+    std::uint32_t tokens, std::uint32_t tid) {
+  for (std::uint32_t flat = tid; flat < Tokens * K; flat += Warps * 32) {
+    const std::uint32_t t = flat / K;
+    if (t >= tokens) {
+      continue;
+    }
+    const std::uint32_t e = flat % K;
+    staged[t][e] =
+        e < tile ? x[static_cast<std::size_t>(token_base + t) * k + base + e]
+                 : 0.0F;
+  }
+}
+
+/// The same staging into a per-32-element-block padded layout (row width
+/// `stride` * (K / 32)); element e lands at (e / 32) * stride + (e % 32).
+/// Runs of 16 or 32 aligned elements never straddle a block, so consumers
+/// index one run with a single base. Live rows only, K tail zero-filled
+/// (see StageActivations).
+template<std::uint32_t Tokens, std::uint32_t K, std::uint32_t Warps>
+__device__ __forceinline__ void StageActivationsPadded(
+    float* staged, std::uint32_t stride, const float* x, std::uint32_t k,
+    std::uint32_t base, std::uint32_t tile, std::uint32_t token_base,
+    std::uint32_t tokens, std::uint32_t tid) {
+  constexpr std::uint32_t kBlocks = K / 32;
+  if (k % 4 == 0) {
+    // float4 global reads, a quarter of the load instructions.
+#pragma unroll 1
+    for (std::uint32_t quad = tid; quad < Tokens * kBlocks * 8;
+         quad += Warps * 32) {
+      const std::uint32_t t = quad / (kBlocks * 8);
+      if (t >= tokens) {
+        continue;
+      }
+      const std::uint32_t e32 = (quad % (kBlocks * 8)) * 4;
+      float4 value = {0.0F, 0.0F, 0.0F, 0.0F};
+      if (e32 + 4 <= tile) {
+        value = *reinterpret_cast<const float4*>(
+            x + static_cast<std::size_t>(token_base + t) * k + base + e32);
+      } else if (e32 < tile) {
+        const float* src =
+            x + static_cast<std::size_t>(token_base + t) * k + base + e32;
+        value.x = e32 + 0 < tile ? src[0] : 0.0F;
+        value.y = e32 + 1 < tile ? src[1] : 0.0F;
+        value.z = e32 + 2 < tile ? src[2] : 0.0F;
+        value.w = e32 + 3 < tile ? src[3] : 0.0F;
+      }
+      float* dst =
+          staged + t * stride * kBlocks + (e32 / 32) * stride + (e32 % 32);
+      dst[0] = value.x;
+      dst[1] = value.y;
+      dst[2] = value.z;
+      dst[3] = value.w;
+    }
+    return;
+  }
+  for (std::uint32_t flat = tid; flat < Tokens * kBlocks * 32;
+       flat += Warps * 32) {
+    const std::uint32_t t = flat / (kBlocks * 32);
+    if (t >= tokens) {
+      continue;
+    }
+    const std::uint32_t e = flat % (kBlocks * 32);
+    staged[t * stride * kBlocks + (e / 32) * stride + (e % 32)] =
+        e < tile ? x[static_cast<std::size_t>(token_base + t) * k + base + e]
+                 : 0.0F;
+  }
+}
+
+/// F32 projection with the weight row read once per token tile: one warp
+/// per (row) group of Rows rows, Tokens tokens per pass, activations
+/// staged in LDS, per-token float accumulation with a lane butterfly (the
+/// tokenwise and batched paths share these kernels, so chunk equality is
+/// by construction; see the tile-shape constants above for the
+/// accumulation-width decision and its evidence).
+template<std::uint32_t Tokens, std::uint32_t Warps, std::uint32_t Rows>
+__global__ __launch_bounds__(Warps * 32) void BatchF32WsKernel(
+    const float* w, const float* x, float* y, std::uint32_t m, std::uint32_t k,
+    std::uint32_t n) {
+  __shared__ float staged[Tokens][kF32K];
+  const std::uint32_t lane = threadIdx.x & 31u;
+  const std::uint32_t warp = threadIdx.x >> 5u;
+  const std::uint32_t row0 = blockIdx.x * (Warps * Rows) + warp;
+  const std::uint32_t token_base = blockIdx.y * Tokens;
+  const std::uint32_t tokens = min(Tokens, n - token_base);
+  // See BatchQuantTiledKernel: no early return past m — staging and the
+  // barriers are block-collective.
+  float sums[Rows][Tokens];
+#pragma unroll
+  for (std::uint32_t r = 0; r < Rows; ++r) {
+#pragma unroll
+    for (std::uint32_t t = 0; t < Tokens; ++t) {
+      sums[r][t] = 0.0F;
+    }
+  }
+  for (std::uint32_t base = 0; base < k; base += kF32K) {
+    const std::uint32_t tile = min(kF32K, k - base);
+    StageActivations<Tokens, kF32K, Warps>(staged, x, k, base, tile, token_base,
+                                           tokens, threadIdx.x);
+    __syncthreads();
+#pragma unroll
+    for (std::uint32_t r = 0; r < Rows; ++r) {
+      const std::uint32_t row = row0 + r * Warps;
+      if (row >= m) {
+        break;
+      }
+      const float* src = w + static_cast<std::size_t>(row) * k;
+      for (std::uint32_t e = lane; e < tile; e += 32) {
+        const float weight = src[base + e];
+#pragma unroll
+        for (std::uint32_t t = 0; t < Tokens; ++t) {
+          if (t < tokens) {
+            sums[r][t] += weight * staged[t][e];
+          }
+        }
+      }
+    }
+    __syncthreads();
+  }
+#pragma unroll
+  for (std::uint32_t r = 0; r < Rows; ++r) {
+    const std::uint32_t row = row0 + r * Warps;
+    if (row >= m) {
+      break;
+    }
+#pragma unroll
+    for (std::uint32_t t = 0; t < Tokens; ++t) {
+      if (t >= tokens) {
+        continue;
+      }
+      float sum = sums[r][t];
+      for (int off = 16; off > 0; off >>= 1) {
+        sum += __shfl_xor(sum, off);
+      }
+      if (lane == 0) {
+        y[static_cast<std::size_t>(token_base + t) * m + row] = sum;
+      }
+    }
+  }
+}
+
+/// Expert assignment grouping: device histogram, prefix offsets and a
+/// stable scatter of (token, slot) pairs into expert buckets. Bucket order
+/// follows pair index, so per-pair outputs are order-independent and the
+/// grouped GEMM stays deterministic.
+__global__ void ExpertZeroKernel(std::uint32_t* bins, std::uint32_t experts) {
+  for (std::uint32_t i = threadIdx.x; i < 2 * experts + 2; i += blockDim.x) {
+    bins[i] = 0;
+  }
+}
+
+__global__ void ExpertHistogramKernel(const std::int32_t* ids,
+                                      std::uint32_t* bins, std::uint32_t* ranks,
+                                      std::uint32_t count) {
+  const std::uint32_t i = blockIdx.x * blockDim.x + threadIdx.x;
+  if (i >= count) {
+    return;
+  }
+  const auto e = static_cast<std::uint32_t>(ids[i]);
+  ranks[i] = atomicAdd(&bins[e], 1u);
+}
+
+__global__ void ExpertPrefixKernel(std::uint32_t* bins, std::uint32_t experts) {
+  if (threadIdx.x == 0) {
+    std::uint32_t acc = 0;
+    for (std::uint32_t e = 0; e < experts; ++e) {
+      const std::uint32_t c = bins[e];
+      bins[e] = acc;
+      acc += c;
+    }
+    bins[experts] = acc;
+  }
+}
+
+__global__ void ExpertScatterKernel(const std::int32_t* ids,
+                                    const std::uint32_t* bins,
+                                    const std::uint32_t* ranks,
+                                    std::uint32_t* pairs, std::uint32_t count) {
+  const std::uint32_t i = blockIdx.x * blockDim.x + threadIdx.x;
+  if (i >= count) {
+    return;
+  }
+  pairs[bins[static_cast<std::uint32_t>(ids[i])] + ranks[i]] = i;
+}
+
+/// Grouped expert projection: every (token, slot) pair of one expert
+/// shares the expert's weight rows, so each row is read and decoded once
+/// per kExpertTokens pairs instead of once per pair. Per pair, each lane
+/// accumulates a serial float partial over the sub-blocks (or 32-blocks
+/// for Q8_0) it owns with one butterfly per row — the tokenwise path runs
+/// the same kernel one pair wide, preserving chunk equality: the tile
+/// shape (kExpertTokens, kExpertK) is a property of the kernel, not of
+/// the invocation, so the per-element K accumulation order is identical
+/// for tokens=1 and tokens=N by construction. The kExpertK regrouping
+/// against the dense-projection tile is covered by the CPU-oracle
+/// projection contract (rel RMS <= 5e-5).
+__global__ __launch_bounds__(kExpertWarps * 32) void BatchExpertGroupedKernel(
+    const void* w, std::uint32_t type, const std::uint32_t* bins,
+    const std::uint32_t* pairs, const float* x, float* y, std::uint32_t slots,
+    std::size_t expert_stride, std::uint32_t m, std::uint32_t k,
+    std::size_t x_stride) {
+  // Stride-34 block layout: blocks stay 8-byte aligned for the float2
+  // staging reads while the +2 float rotation keeps a warp's per-lane
+  // runs in distinct banks ((2*block + j) mod 32 across lanes).
+  constexpr std::uint32_t kBlockStrideLocal = 34;
+  constexpr std::uint32_t kBlocksPerTile = kExpertK / 32;
+  __shared__ float staged[kExpertTokens][kBlockStrideLocal * kBlocksPerTile];
+  // Activation row base of each pair slot, derived once per pair tile so
+  // the staging loop never re-reads `pairs` or re-divides by `slots` per
+  // staged element.
+  __shared__ std::size_t xrow[kExpertTokens];
+  const std::uint32_t e = blockIdx.y;
+  const std::uint32_t begin = bins[e];
+  const std::uint32_t end = bins[e + 1];
+  if (begin >= end) {
+    return;
+  }
+  const std::uint32_t lane = threadIdx.x & 31u;
+  const std::uint32_t warp = threadIdx.x >> 5u;
+  // One staging pass feeds kExpertWarps * kExpertRows output rows, so the
+  // expert's activation tile is read from global once per
+  // m / (kExpertWarps * kExpertRows) row groups instead of once per
+  // kExpertWarps rows.
+  const std::uint32_t row0 = blockIdx.x * (kExpertWarps * kExpertRows) + warp;
+  const auto ggml_type = static_cast<gufo::core::GgmlType>(type);
+  const std::size_t qk = gufo::hip::QuantBlockQK(ggml_type);
+  const std::size_t block_bytes = gufo::hip::QuantBlockBytes(ggml_type);
+  const char* w_base =
+      static_cast<const char*>(w) + static_cast<std::size_t>(e) * expert_stride;
+  const std::size_t row_bytes_stride = k / qk * block_bytes;
+  // x rows are 16-byte aligned (and the K tail never splits a float4)
+  // whenever k and the row stride are multiples of 4.
+  const bool vec_ok = (k % 4 == 0) && (x_stride == 1 || x_stride % 4 == 0);
+  float sums[kExpertRows][kExpertTokens];
+  for (std::uint32_t base_pair = begin; base_pair < end;
+       base_pair += kExpertTokens) {
+    const std::uint32_t pcount = min(kExpertTokens, end - base_pair);
+    if (threadIdx.x < kExpertTokens) {
+      xrow[threadIdx.x] =
+          threadIdx.x < pcount
+              ? (x_stride == 1 ? static_cast<std::size_t>(
+                                     pairs[base_pair + threadIdx.x]) *
+                                     k
+                               : static_cast<std::size_t>(
+                                     pairs[base_pair + threadIdx.x] / slots) *
+                                     x_stride)
+              : 0;
+    }
+#pragma unroll
+    for (std::uint32_t r = 0; r < kExpertRows; ++r) {
+#pragma unroll
+      for (std::uint32_t t = 0; t < kExpertTokens; ++t) {
+        sums[r][t] = 0.0F;
+      }
+    }
+    __syncthreads();
+    for (std::uint32_t base = 0; base < k; base += kExpertK) {
+      const std::uint32_t tile = min(kExpertK, k - base);
+      // Staging reads x in float4 and writes the padded layout in float2:
+      // same values, same addresses, a quarter of the memory instructions.
+      // The vector path needs 16-byte-aligned rows (k and the row stride
+      // multiples of 4); the scalar fallback keeps odd geometry correct.
+      if (vec_ok) {
+        for (std::uint32_t quad = threadIdx.x;
+             quad < kExpertTokens * kBlocksPerTile * 8;
+             quad += kExpertWarps * 32) {
+          const std::uint32_t t = quad / (kBlocksPerTile * 8);
+          const std::uint32_t e32 = (quad % (kBlocksPerTile * 8)) * 4;
+          float4 value = {0.0F, 0.0F, 0.0F, 0.0F};
+          if (t < pcount && e32 + 4 <= tile) {
+            value = *reinterpret_cast<const float4*>(x + xrow[t] + base + e32);
+          } else if (t < pcount && e32 < tile) {
+            value.x = e32 + 0 < tile ? x[xrow[t] + base + e32 + 0] : 0.0F;
+            value.y = e32 + 1 < tile ? x[xrow[t] + base + e32 + 1] : 0.0F;
+            value.z = e32 + 2 < tile ? x[xrow[t] + base + e32 + 2] : 0.0F;
+            value.w = e32 + 3 < tile ? x[xrow[t] + base + e32 + 3] : 0.0F;
+          }
+          float2* dst = reinterpret_cast<float2*>(
+              staged[t] + (e32 / 32) * kBlockStrideLocal + (e32 % 32));
+          dst[0] = make_float2(value.x, value.y);
+          dst[1] = make_float2(value.z, value.w);
+        }
+      } else {
+        for (std::uint32_t flat = threadIdx.x;
+             flat < kExpertTokens * kBlocksPerTile * 32;
+             flat += kExpertWarps * 32) {
+          const std::uint32_t t = flat / (kBlocksPerTile * 32);
+          const std::uint32_t e32 = flat % (kBlocksPerTile * 32);
+          float value = 0.0F;
+          if (t < pcount && e32 < tile) {
+            value = x[xrow[t] + base + e32];
+          }
+          staged[t][(e32 / 32) * kBlockStrideLocal + (e32 % 32)] = value;
+        }
+      }
+      __syncthreads();
+#pragma unroll
+      for (std::uint32_t r = 0; r < kExpertRows; ++r) {
+        const std::uint32_t row = row0 + r * kExpertWarps;
+        if (row >= m) {
+          continue;
+        }
+        const char* row_bytes = w_base + row * row_bytes_stride;
+        if (ggml_type == gufo::core::GgmlType::kQ8_0) {
+          const auto* row_blocks =
+              reinterpret_cast<const gufo::hip::Q8_0Block*>(row_bytes);
+          const std::uint32_t b = base / 32 + lane;
+          if (b < (base + tile) / 32) {
+            const float d_w = __half2float(row_blocks[b].d);
+            const std::int8_t* wq = row_blocks[b].qs;
+            // The int8->float conversion happens once per block, not once
+            // per (block, token); the float2 reads halve the LDS issue
+            // count. The per-token dot still accumulates j in order, so
+            // every output element sees the same rounding as before.
+            float wqf[32];
+#pragma unroll
+            for (int j = 0; j < 32; ++j) {
+              wqf[j] = static_cast<float>(wq[j]);
+            }
+#pragma unroll
+            for (std::uint32_t t = 0; t < kExpertTokens; ++t) {
+              if (t >= pcount) {
+                continue;
+              }
+              const float2* xv = reinterpret_cast<const float2*>(
+                  staged[t] + lane * kBlockStrideLocal);
+              float dot = 0.0F;
+#pragma unroll
+              for (int p = 0; p < 16; ++p) {
+                const float2 pair = xv[p];
+                dot += wqf[2 * p] * pair.x;
+                dot += wqf[2 * p + 1] * pair.y;
+              }
+              sums[r][t] += d_w * dot;
+            }
+          }
+        } else {
+          const std::uint32_t sub_base = base / 16;
+          for (std::uint32_t sb = sub_base + lane;
+               sb < sub_base + kBlocksPerTile * 2 && sb * 16 < base + tile;
+               sb += 32) {
+            gufo::hip::QuantSub16 sub;
+            gufo::hip::DecodeQuantSub16(ggml_type, row_bytes, sb, sub);
+            const std::uint32_t run = sb * 16 - base;
+            const std::uint32_t pad =
+                (run >> 5) * kBlockStrideLocal + (run & 31);
+            // Same conversion hoist and float2 reads as the Q8_0 path;
+            // dot and xsum still accumulate j ascending per token.
+            float qf[16];
+#pragma unroll
+            for (int j = 0; j < 16; ++j) {
+              qf[j] = static_cast<float>(sub.q[j]);
+            }
+#pragma unroll
+            for (std::uint32_t t = 0; t < kExpertTokens; ++t) {
+              if (t >= pcount) {
+                continue;
+              }
+              const float2* xv =
+                  reinterpret_cast<const float2*>(staged[t] + pad);
+              float dot = 0.0F;
+              float xsum = 0.0F;
+#pragma unroll
+              for (int p = 0; p < 8; ++p) {
+                const float2 pair = xv[p];
+                dot += qf[2 * p] * pair.x;
+                dot += qf[2 * p + 1] * pair.y;
+                xsum += pair.x;
+                xsum += pair.y;
+              }
+              sums[r][t] += (sub.scale * dot) - (sub.offset * xsum);
+            }
+          }
+        }
+      }
+      __syncthreads();
+    }
+#pragma unroll
+    for (std::uint32_t r = 0; r < kExpertRows; ++r) {
+      const std::uint32_t row = row0 + r * kExpertWarps;
+      if (row >= m) {
+        continue;
+      }
+#pragma unroll
+      for (std::uint32_t t = 0; t < kExpertTokens; ++t) {
+        if (t >= pcount) {
+          continue;
+        }
+        float sum = sums[r][t];
+        for (int off = 16; off > 0; off >>= 1) {
+          sum += __shfl_xor(sum, off);
+        }
+        if (lane == 0) {
+          y[static_cast<std::size_t>(pairs[base_pair + t]) * m + row] = sum;
+        }
+      }
+    }
+  }
+}
+
+/// Weight-stationary grouped expert projection: same routing layout, same
+/// per-(row, pair) arithmetic and the same single per-(row, pair) butterfly
+/// as BatchExpertGroupedKernel — every output element sees the identical
+/// rounding, so the two kernels are bit-identical twins (verified
+/// max|diff| = 0 at every production shape and chunk width, and
+/// chunked-vs-tokenwise identical at n in {1..1024}: notes/experts-ws-250.md).
+/// What changes is the loop nesting: sums[Rows][Bucket] accumulators live in
+/// registers across the whole K stream, so one decoded weight sub-block (the
+/// lane's, re-read from L1) feeds every StageB-wide staging chunk of the
+/// bucket inside the K-tile, and each expert's weights stream once per
+/// ceil(bucket / Bucket) passes. Sub16 formats only, vector staging only
+/// (k a multiple of 4 and x rows 16-byte aligned); anything else dispatches
+/// the generic kernel above.
+template<std::uint32_t Bucket, std::uint32_t StageB, std::uint32_t Warps,
+         std::uint32_t Rows>
+__global__ __launch_bounds__(Warps * 32) void BatchExpertGroupedWsKernel(
+    const void* w, std::uint32_t type, const std::uint32_t* bins,
+    const std::uint32_t* pairs, const float* x, float* y, std::uint32_t slots,
+    std::size_t expert_stride, std::uint32_t m, std::uint32_t k,
+    std::size_t x_stride) {
+  constexpr std::uint32_t kKTile = 512;
+  constexpr std::uint32_t kBlockStrideLocal = 34;
+  constexpr std::uint32_t kBlocksPerTile = kKTile / 32;
+  constexpr std::uint32_t kChunks = Bucket / StageB;
+  static_assert(Bucket % StageB == 0, "bucket must tile into staging chunks");
+  __shared__ float staged[StageB][kBlockStrideLocal * kBlocksPerTile];
+  __shared__ std::size_t xrow[StageB];
+  const std::uint32_t e = blockIdx.y;
+  const std::uint32_t begin = bins[e];
+  const std::uint32_t end = bins[e + 1];
+  if (begin >= end) {
+    return;
+  }
+  const std::uint32_t lane = threadIdx.x & 31u;
+  const std::uint32_t warp = threadIdx.x >> 5u;
+  const std::uint32_t row0 = blockIdx.x * (Warps * Rows) + warp;
+  const auto ggml_type = static_cast<gufo::core::GgmlType>(type);
+  const std::size_t qk = gufo::hip::QuantBlockQK(ggml_type);
+  const std::size_t block_bytes = gufo::hip::QuantBlockBytes(ggml_type);
+  const char* w_base =
+      static_cast<const char*>(w) + static_cast<std::size_t>(e) * expert_stride;
+  const std::size_t row_bytes_stride = k / qk * block_bytes;
+  float sums[Rows][Bucket];
+  for (std::uint32_t base_pair = begin; base_pair < end; base_pair += Bucket) {
+    const std::uint32_t pcount = min(Bucket, end - base_pair);
+#pragma unroll
+    for (std::uint32_t r = 0; r < Rows; ++r) {
+#pragma unroll
+      for (std::uint32_t t = 0; t < Bucket; ++t) {
+        sums[r][t] = 0.0F;
+      }
+    }
+    __syncthreads();
+    for (std::uint32_t base = 0; base < k; base += kKTile) {
+      const std::uint32_t tile = min(kKTile, k - base);
+      // The chunk loop is unrolled so every sums[] index stays
+      // compile-time; the break is block-uniform (pcount is).
+#pragma unroll
+      for (std::uint32_t ci = 0; ci < kChunks; ++ci) {
+        const std::uint32_t cbase = ci * StageB;
+        if (cbase >= pcount) {
+          break;
+        }
+        const std::uint32_t scount = min(StageB, pcount - cbase);
+        if (threadIdx.x < StageB) {
+          xrow[threadIdx.x] =
+              threadIdx.x < scount
+                  ? (x_stride == 1
+                         ? static_cast<std::size_t>(
+                               pairs[base_pair + cbase + threadIdx.x]) *
+                               k
+                         : static_cast<std::size_t>(
+                               pairs[base_pair + cbase + threadIdx.x] / slots) *
+                               x_stride)
+                  : 0;
+        }
+        __syncthreads();
+        for (std::uint32_t quad = threadIdx.x;
+             quad < StageB * kBlocksPerTile * 8; quad += Warps * 32) {
+          const std::uint32_t t = quad / (kBlocksPerTile * 8);
+          const std::uint32_t e32 = (quad % (kBlocksPerTile * 8)) * 4;
+          float4 value = {0.0F, 0.0F, 0.0F, 0.0F};
+          if (t < scount && e32 + 4 <= tile) {
+            value = *reinterpret_cast<const float4*>(x + xrow[t] + base + e32);
+          } else if (t < scount && e32 < tile) {
+            value.x = e32 + 0 < tile ? x[xrow[t] + base + e32 + 0] : 0.0F;
+            value.y = e32 + 1 < tile ? x[xrow[t] + base + e32 + 1] : 0.0F;
+            value.z = e32 + 2 < tile ? x[xrow[t] + base + e32 + 2] : 0.0F;
+            value.w = e32 + 3 < tile ? x[xrow[t] + base + e32 + 3] : 0.0F;
+          }
+          float2* dst = reinterpret_cast<float2*>(
+              staged[t] + (e32 / 32) * kBlockStrideLocal + (e32 % 32));
+          dst[0] = make_float2(value.x, value.y);
+          dst[1] = make_float2(value.z, value.w);
+        }
+        __syncthreads();
+#pragma unroll
+        for (std::uint32_t r = 0; r < Rows; ++r) {
+          const std::uint32_t row = row0 + r * Warps;
+          if (row >= m) {
+            continue;
+          }
+          const char* row_bytes = w_base + row * row_bytes_stride;
+          // Same per-lane sub-block walk as the generic kernel: one
+          // sub-block per lane per 512-wide tile (more only on the K tail).
+          for (std::uint32_t sb = base / 16 + lane;
+               sb < base / 16 + kBlocksPerTile * 2 && sb * 16 < base + tile;
+               sb += 32) {
+            gufo::hip::QuantSub16 sub;
+            gufo::hip::DecodeQuantSub16(ggml_type, row_bytes, sb, sub);
+            const std::uint32_t run = sb * 16 - base;
+            const std::uint32_t pad =
+                (run >> 5) * kBlockStrideLocal + (run & 31);
+            float qf[16];
+#pragma unroll
+            for (int j = 0; j < 16; ++j) {
+              qf[j] = static_cast<float>(sub.q[j]);
+            }
+#pragma unroll
+            for (std::uint32_t t = 0; t < StageB; ++t) {
+              if (t >= scount) {
+                continue;
+              }
+              const float2* xv =
+                  reinterpret_cast<const float2*>(staged[t] + pad);
+              float dot = 0.0F;
+              float xsum = 0.0F;
+#pragma unroll
+              for (int p = 0; p < 8; ++p) {
+                const float2 pair = xv[p];
+                dot += qf[2 * p] * pair.x;
+                dot += qf[2 * p + 1] * pair.y;
+                xsum += pair.x;
+                xsum += pair.y;
+              }
+              sums[r][cbase + t] += (sub.scale * dot) - (sub.offset * xsum);
+            }
+          }
+        }
+        __syncthreads();
+      }
+    }
+#pragma unroll
+    for (std::uint32_t r = 0; r < Rows; ++r) {
+      const std::uint32_t row = row0 + r * Warps;
+      if (row >= m) {
+        continue;
+      }
+#pragma unroll
+      for (std::uint32_t t = 0; t < Bucket; ++t) {
+        if (t >= pcount) {
+          continue;
+        }
+        float sum = sums[r][t];
+        for (int off = 16; off > 0; off >>= 1) {
+          sum += __shfl_xor(sum, off);
+        }
+        if (lane == 0) {
+          y[static_cast<std::size_t>(pairs[base_pair + t]) * m + row] = sum;
+        }
+      }
+    }
+  }
+}
+
+/// One tile's weight-stream compute: each of the block's warps walks its
+/// kQuantRows rows, every lane accumulating serial float partials over the
+/// 16-element runs it owns (the run grid is kQuantK / 16 wide, so any K
+/// tile that is a multiple of 512 keeps all 32 lanes busy). int8 -> float
+/// conversion is hoisted out of the per-token loop.
+template<std::uint32_t Tokens, std::uint32_t K, std::uint32_t Warps,
+         std::uint32_t Rows>
+__device__ __forceinline__ void ConsumeQuantTile(
+    float (&staged)[Tokens][33 * (K / 32)], const void* w,
+    gufo::core::GgmlType ggml_type, std::size_t row_bytes_stride,
+    std::uint32_t m, std::uint32_t base, std::uint32_t tile,
+    std::uint32_t tokens, std::uint32_t row0, std::uint32_t lane,
+    float (&sums)[Rows][Tokens]) {
+  constexpr std::uint32_t kBlockStride = 33;
+  const std::uint32_t sub_base = base / 16;
+  const std::uint32_t subs_per_tile = (K / 32) * 2;
+#pragma unroll
+  for (std::uint32_t r = 0; r < Rows; ++r) {
+    const std::uint32_t row = row0 + r * Warps;
+    if (row >= m) {
+      break;
+    }
+    const char* row_bytes = static_cast<const char*>(w) +
+                            static_cast<std::size_t>(row) * row_bytes_stride;
+    if (ggml_type == gufo::core::GgmlType::kQ8_0) {
+      const auto* row_blocks =
+          reinterpret_cast<const gufo::hip::Q8_0Block*>(row_bytes);
+      for (std::uint32_t sb = sub_base + lane;
+           sb < sub_base + subs_per_tile && sb * 16 < base + tile; sb += 32) {
+        const gufo::hip::Q8_0Block& blk = row_blocks[sb >> 1];
+        const float d_w = __half2float(blk.d);
+        const std::uint32_t run = sb * 16 - base;
+        const std::uint32_t pad = (run >> 5) * kBlockStride + (run & 31);
+        float wqf[16];
+#pragma unroll
+        for (int j = 0; j < 16; ++j) {
+          wqf[j] = static_cast<float>(blk.qs[(sb & 1) * 16 + j]);
+        }
+        // Runtime token bound: one unpredicated slot body, so the
+        // arithmetic cannot depend on the tile's fill (a fully unrolled,
+        // guarded loop let clang 21 mispredicate the last slot
+        // differently at n=1 and n=512 — notes/tiles-250.md). Dead rows
+        // are never staged, so `t < tokens` also skips their LDS reads.
+        // Guard wraps each slot's body (the BatchF32WsKernel form)
+        // rather than a `t >= tokens` continue: the continue form let
+        // clang 21 mispredicate the last unrolled slot differently at
+        // n=1 and n=512 (notes/tiles-250.md).
+#pragma unroll
+        for (std::uint32_t t = 0; t < Tokens; ++t) {
+          if (t < tokens) {
+            const float* xv = staged[t] + pad;
+            float dot = 0.0F;
+#pragma unroll
+            for (int j = 0; j < 16; ++j) {
+              dot += wqf[j] * xv[j];
+            }
+            sums[r][t] += d_w * dot;
+          }
+        }
+      }
+    } else {
+      for (std::uint32_t sb = sub_base + lane;
+           sb < sub_base + subs_per_tile && sb * 16 < base + tile; sb += 32) {
+        gufo::hip::QuantSub16 sub;
+        gufo::hip::DecodeQuantSub16(ggml_type, row_bytes, sb, sub);
+        const std::uint32_t run = sb * 16 - base;
+        const std::uint32_t pad = (run >> 5) * kBlockStride + (run & 31);
+        float qf[16];
+#pragma unroll
+        for (int j = 0; j < 16; ++j) {
+          qf[j] = static_cast<float>(sub.q[j]);
+        }
+#pragma unroll
+        for (std::uint32_t t = 0; t < Tokens; ++t) {
+          if (t < tokens) {
+            float dot = 0.0F;
+            float xsum = 0.0F;
+            const float* xv = staged[t] + pad;
+#pragma unroll
+            for (int j = 0; j < 16; ++j) {
+              const float value = xv[j];
+              dot += qf[j] * value;
+              xsum += value;
+            }
+            sums[r][t] += (sub.scale * dot) - (sub.offset * xsum);
+          }
+        }
+      }
+    }
+  }
+}
+
+/// Epilogue: one butterfly per (row, token) and the y writes.
+template<std::uint32_t Tokens, std::uint32_t Warps, std::uint32_t Rows>
+__device__ __forceinline__ void FinishQuantTile(
+    std::uint32_t m, std::uint32_t token_base, std::uint32_t tokens,
+    std::uint32_t row0, std::uint32_t lane, float (&sums)[Rows][Tokens],
+    float* y, std::size_t y_stride) {
+#pragma unroll
+  for (std::uint32_t r = 0; r < Rows; ++r) {
+    const std::uint32_t row = row0 + r * Warps;
+    if (row >= m) {
+      break;
+    }
+#pragma unroll
+    for (std::uint32_t t = 0; t < Tokens; ++t) {
+      if (t >= tokens) {
+        continue;
+      }
+      float sum = sums[r][t];
+      for (int off = 16; off > 0; off >>= 1) {
+        sum += __shfl_xor(sum, off);
+      }
+      if (lane == 0) {
+        y[static_cast<std::size_t>(token_base + t) * y_stride + row] = sum;
+      }
+    }
+  }
+}
+
+/// Quantized projection with the weight row read (and Q4_K-style sub-block
+/// decoded) once per token tile. One warp per output row (kQuantRows rows
+/// per warp), each lane accumulating a serial float partial over the
+/// 16-element runs it owns — the run grid is K/16 wide, so every K tile
+/// that is a multiple of 512 keeps all 32 lanes busy — with one butterfly
+/// per row at the end. The same kernel serves the tokenwise path, so
+/// chunked-vs-tokenwise equality holds at any tile width, and the CPU-oracle
+/// projection contract (rel RMS <= 5e-5) covers the reduction regrouping.
+__global__ __launch_bounds__(kQuantWarps * 32) void BatchQuantTiledKernel(
+    const void* w, std::uint32_t type, const float* x, float* y,
+    std::uint32_t m, std::uint32_t k, std::uint32_t n, std::size_t y_stride) {
+  // Stride-33 block layout: lane L reading element j of its own run hits
+  // bank (33*L + j) % 32 = (L + j) % 32 — conflict-free across the warp.
+  constexpr std::uint32_t kBlockStride = 33;
+  constexpr std::uint32_t kBlocksPerTile = kQuantK / 32;
+  __shared__ float staged[kQuantTokens][kBlockStride * kBlocksPerTile];
+  const std::uint32_t lane = threadIdx.x & 31u;
+  const std::uint32_t warp = threadIdx.x >> 5u;
+  const std::uint32_t row0 = blockIdx.x * (kQuantWarps * kQuantRows) + warp;
+  const std::uint32_t token_base = blockIdx.y * kQuantTokens;
+  const std::uint32_t tokens = min(kQuantTokens, n - token_base);
+  const auto ggml_type = static_cast<gufo::core::GgmlType>(type);
+  const std::size_t qk = gufo::hip::QuantBlockQK(ggml_type);
+  const std::size_t block_bytes = gufo::hip::QuantBlockBytes(ggml_type);
+  const std::size_t row_bytes_stride = k / qk * block_bytes;
+  float sums[kQuantRows][kQuantTokens];
+#pragma unroll
+  for (std::uint32_t r = 0; r < kQuantRows; ++r) {
+#pragma unroll
+    for (std::uint32_t t = 0; t < kQuantTokens; ++t) {
+      sums[r][t] = 0.0F;
+    }
+  }
+  for (std::uint32_t base = 0; base < k; base += kQuantK) {
+    const std::uint32_t tile = min(kQuantK, k - base);
+    StageActivationsPadded<kQuantTokens, kQuantK, kQuantWarps>(
+        &staged[0][0], kBlockStride, x, k, base, tile, token_base, tokens,
+        threadIdx.x);
+    __syncthreads();
+    ConsumeQuantTile<kQuantTokens, kQuantK, kQuantWarps, kQuantRows>(
+        staged, w, ggml_type, row_bytes_stride, m, base, tile, tokens, row0,
+        lane, sums);
+    __syncthreads();
+  }
+  FinishQuantTile<kQuantTokens, kQuantWarps, kQuantRows>(
+      m, token_base, tokens, row0, lane, sums, y, y_stride);
+}
+
+__global__ void BatchHcSinkhornKernel(const float* mixes, const float* scale,
+                                      const float* base, float* pre,
+                                      float* post, float* comb, std::uint32_t n,
+                                      std::uint32_t sinkhorn_iters, float eps) {
+  if (threadIdx.x != 0) {
+    return;
+  }
+  const std::size_t t = blockIdx.x;
+  const float* mx = mixes + t * (2 * static_cast<std::size_t>(n) + n * n);
+  float* c = comb + t * static_cast<std::size_t>(n) * n;
+  for (std::uint32_t i = 0; i < n; ++i) {
+    pre[t * n + i] = SigmoidF(mx[i] * scale[0] + base[i]) + eps;
+    post[t * n + i] = 2.0F * SigmoidF(mx[n + i] * scale[1] + base[n + i]);
+  }
+  for (std::uint32_t r = 0; r < n; ++r) {
+    float max_value = -__int_as_float(0x7F800000);
+    for (std::uint32_t col = 0; col < n; ++col) {
+      const float logit =
+          mx[2 * n + r * n + col] * scale[2] + base[2 * n + r * n + col];
+      c[r * n + col] = logit;
+      max_value = max_value > logit ? max_value : logit;
+    }
+    double denom = 0.0;
+    for (std::uint32_t col = 0; col < n; ++col) {
+      denom += exp(static_cast<double>(c[r * n + col] - max_value));
+    }
+    for (std::uint32_t col = 0; col < n; ++col) {
+      c[r * n + col] =
+          static_cast<float>(
+              exp(static_cast<double>(c[r * n + col] - max_value)) / denom) +
+          eps;
+    }
+  }
+  const auto col_norm = [&]() {
+    for (std::uint32_t col = 0; col < n; ++col) {
+      double denom = 0.0;
+      for (std::uint32_t r = 0; r < n; ++r) {
+        denom += c[r * n + col];
+      }
+      const float scale_v =
+          static_cast<float>(1.0 / (denom + static_cast<double>(eps)));
+      for (std::uint32_t r = 0; r < n; ++r) {
+        c[r * n + col] *= scale_v;
+      }
+    }
+  };
+  const auto row_norm = [&]() {
+    for (std::uint32_t r = 0; r < n; ++r) {
+      double denom = 0.0;
+      for (std::uint32_t col = 0; col < n; ++col) {
+        denom += c[r * n + col];
+      }
+      const float scale_v =
+          static_cast<float>(1.0 / (denom + static_cast<double>(eps)));
+      for (std::uint32_t col = 0; col < n; ++col) {
+        c[r * n + col] *= scale_v;
+      }
+    }
+  };
+  col_norm();
+  for (std::uint32_t it = 1; it < sinkhorn_iters; ++it) {
+    row_norm();
+    col_norm();
+  }
+}
+
+__global__ void BatchHcCollapseKernel(const float* pre, const float* streams,
+                                      float* collapsed, std::uint32_t hidden,
+                                      std::uint32_t n) {
+  const std::uint32_t t = blockIdx.y;
+  const std::uint32_t d = blockIdx.x * blockDim.x + threadIdx.x;
+  if (d >= hidden) {
+    return;
+  }
+  const float* row_streams = streams + static_cast<std::size_t>(t) * n * hidden;
+  double value = 0.0;
+  for (std::uint32_t i = 0; i < n; ++i) {
+    value += static_cast<double>(pre[t * n + i]) *
+             row_streams[static_cast<std::size_t>(i) * hidden + d];
+  }
+  collapsed[static_cast<std::size_t>(t) * hidden + d] =
+      static_cast<float>(value);
+}
+
+__global__ void BatchHcCombineKernel(const float* post, const float* comb,
+                                     const float* residual,
+                                     const float* block_out, float* streams,
+                                     std::uint32_t hidden, std::uint32_t n) {
+  const std::uint32_t t = blockIdx.z;
+  const std::uint32_t i = blockIdx.y;
+  const std::uint32_t d = blockIdx.x * blockDim.x + threadIdx.x;
+  if (d >= hidden) {
+    return;
+  }
+  const float* row_residual =
+      residual + static_cast<std::size_t>(t) * n * hidden;
+  const float* row_out = block_out + static_cast<std::size_t>(t) * hidden;
+  const float* row_comb = comb + static_cast<std::size_t>(t) * n * n;
+  double mix = 0.0;
+  for (std::uint32_t m = 0; m < n; ++m) {
+    mix += static_cast<double>(row_comb[m * n + i]) *
+           row_residual[static_cast<std::size_t>(m) * hidden + d];
+  }
+  streams[(static_cast<std::size_t>(t) * n + i) * hidden + d] =
+      static_cast<float>(static_cast<double>(post[t * n + i]) * row_out[d] +
+                         mix);
+}
+
+__global__ void BatchMeanStreamsKernel(const float* streams, float* out,
+                                       std::uint32_t hidden, std::uint32_t n) {
+  const std::uint32_t t = blockIdx.y;
+  const std::uint32_t d = blockIdx.x * blockDim.x + threadIdx.x;
+  if (d >= hidden) {
+    return;
+  }
+  const float* row_streams = streams + static_cast<std::size_t>(t) * n * hidden;
+  double mean = 0.0;
+  for (std::uint32_t i = 0; i < n; ++i) {
+    mean += row_streams[static_cast<std::size_t>(i) * hidden + d];
+  }
+  out[static_cast<std::size_t>(t) * hidden + d] = static_cast<float>(mean / n);
+}
+
+__global__ void BatchKdaConvKernel(const float* qkv, const float* taps_q,
+                                   const float* taps_k, const float* taps_v,
+                                   float* history, float* conv_out,
+                                   std::uint32_t tokens, std::uint32_t inner,
+                                   std::uint32_t kernel) {
+  const std::uint32_t ch = blockIdx.x * blockDim.x + threadIdx.x;
+  const std::uint32_t channels = 3 * inner;
+  if (ch >= channels) {
+    return;
+  }
+  const float* taps = ch < inner ? taps_q : (ch < 2 * inner ? taps_k : taps_v);
+  const float* row = taps + static_cast<std::size_t>(ch % inner) * kernel;
+  // The rolling window of the (kernel-1) history rows, register-held.
+  float window[8];
+  for (std::uint32_t t = 0; t + 1 < kernel; ++t) {
+    window[t] = history[t * channels + ch];
+  }
+  for (std::uint32_t t = 0; t < tokens; ++t) {
+    const float fresh = qkv[static_cast<std::size_t>(t) * channels + ch];
+    double acc = 0.0;
+    for (std::uint32_t j = 0; j + 1 < kernel; ++j) {
+      acc += static_cast<double>(row[j]) * window[j];
+    }
+    acc += static_cast<double>(row[kernel - 1]) * fresh;
+    const float x = static_cast<float>(acc);
+    conv_out[static_cast<std::size_t>(t) * channels + ch] =
+        x / (1.0F + expf(-x));
+    for (std::uint32_t j = 0; j + 2 < kernel; ++j) {
+      window[j] = window[j + 1];
+    }
+    window[kernel - 2] = fresh;
+  }
+  for (std::uint32_t t = 0; t + 1 < kernel; ++t) {
+    history[t * channels + ch] = window[t];
+  }
+}
+
+__global__ void BatchKdaPrepareKernel(const float* conv_out, float* qn,
+                                      float* kn, std::uint32_t tokens,
+                                      std::uint32_t heads, std::uint32_t dim,
+                                      float l2_eps) {
+  const std::uint32_t i = blockIdx.x * blockDim.x + threadIdx.x;
+  if (i >= tokens * heads) {
+    return;
+  }
+  const std::uint32_t t = i / heads;
+  const std::uint32_t h = i % heads;
+  const std::uint32_t inner = heads * dim;
+  const float* row = conv_out + static_cast<std::size_t>(t) * 3 * inner;
+  const float q_scale = 1.0F / sqrtf(static_cast<float>(dim));
+  float q_sq = 0.0F;
+  float k_sq = 0.0F;
+  for (std::uint32_t d = 0; d < dim; ++d) {
+    const float q = row[h * dim + d];
+    const float k = row[inner + h * dim + d];
+    q_sq += q * q;
+    k_sq += k * k;
+  }
+  const float q_inv = 1.0F / sqrtf(q_sq + l2_eps) * q_scale;
+  const float k_inv = 1.0F / sqrtf(k_sq + l2_eps);
+  float* qn_row = qn + static_cast<std::size_t>(t) * inner;
+  float* kn_row = kn + static_cast<std::size_t>(t) * inner;
+  for (std::uint32_t d = 0; d < dim; ++d) {
+    qn_row[h * dim + d] = row[h * dim + d] * q_inv;
+    kn_row[h * dim + d] = row[inner + h * dim + d] * k_inv;
+  }
+}
+
+__global__ void BatchKdaGatesKernel(const float* raw, const float* a,
+                                    const float* dt, const float* beta_row,
+                                    float bound, float* gate, float* beta,
+                                    std::uint32_t tokens, std::uint32_t inner,
+                                    std::uint32_t dim, std::uint32_t heads) {
+  const std::uint32_t j = blockIdx.x * blockDim.x + threadIdx.x;
+  if (j >= tokens * inner) {
+    return;
+  }
+  const std::uint32_t t = j / inner;
+  const std::uint32_t c = j % inner;
+  const float decay_rate = -a[c / dim];
+  gate[j] =
+      bound * SigmoidF(decay_rate *
+                       (raw[static_cast<std::size_t>(t) * inner + c] + dt[c]));
+  if (c < heads) {
+    beta[static_cast<std::size_t>(t) * heads + c] =
+        SigmoidF(beta_row[static_cast<std::size_t>(t) * heads + c]);
+  }
+}
+
+__global__ void BatchKdaRecurrenceKernel(const float* qn, const float* kn,
+                                         const float* gate, const float* beta,
+                                         const float* conv_out, float* state,
+                                         float* core, std::uint32_t tokens,
+                                         std::uint32_t heads,
+                                         std::uint32_t dim) {
+  const std::uint32_t h = blockIdx.x;
+  const std::uint32_t v = threadIdx.x;
+  if (h >= heads || v >= dim) {
+    return;
+  }
+  const std::uint32_t inner = heads * dim;
+  float* s = state + static_cast<std::size_t>(h) * dim * dim;
+  for (std::uint32_t t = 0; t < tokens; ++t) {
+    const float* qn_row = qn + static_cast<std::size_t>(t) * inner;
+    const float* kn_row = kn + static_cast<std::size_t>(t) * inner;
+    const float* gate_row = gate + static_cast<std::size_t>(t) * inner;
+    const float* conv_row = conv_out + static_cast<std::size_t>(t) * 3 * inner;
+    float kv = 0.0F;
+    for (std::uint32_t d = 0; d < dim; ++d) {
+      const float decay = expf(gate_row[h * dim + d]);
+      float& cell = s[static_cast<std::size_t>(d) * dim + v];
+      cell *= decay;
+      kv += cell * kn_row[h * dim + d];
+    }
+    const float b = beta[t * heads + h];
+    const float delta = (conv_row[2 * inner + h * dim + v] - kv) * b;
+    float acc = 0.0F;
+    for (std::uint32_t d = 0; d < dim; ++d) {
+      float& cell = s[static_cast<std::size_t>(d) * dim + v];
+      cell += kn_row[h * dim + d] * delta;
+      acc += cell * qn_row[h * dim + d];
+    }
+    core[static_cast<std::size_t>(t) * inner + h * dim + v] = acc;
+  }
+}
+
+/// Register-column fast path for the model's kda.head_dim (128). The
+/// arithmetic per (token, d) — the statements, their order and the serial
+/// per-thread accumulation over d — is exactly the generic kernel's above,
+/// so the two produce bit-identical core rows and state for any token
+/// count. What changes is residency: each thread keeps its state column in
+/// registers across the whole token loop (the generic kernel round-trips
+/// every cell through global memory twice per token) and the three
+/// block-uniform per-token rows (decay, kn, qn) are staged once per block
+/// instead of per thread — the generic kernel recomputes dim expf() values
+/// per thread per token, dim x threads redundantly.
+template<std::uint32_t kDim>
+__global__ __launch_bounds__(kDim, 1) void BatchKdaRecurrenceRegKernel(
+    const float* qn, const float* kn, const float* gate, const float* beta,
+    const float* conv_out, float* state, float* core, std::uint32_t tokens,
+    std::uint32_t heads) {
+  static_assert(kDim == 128, "the register column is sized for the model");
+  const std::uint32_t h = blockIdx.x;
+  const std::uint32_t v = threadIdx.x;
+  const std::uint32_t inner = heads * kDim;
+  __shared__ float decay_row[kDim];
+  __shared__ float kn_row[kDim];
+  __shared__ float qn_row[kDim];
+  float* s = state + static_cast<std::size_t>(h) * kDim * kDim;
+  float column[kDim];
+#pragma unroll
+  for (std::uint32_t d = 0; d < kDim; ++d) {
+    column[d] = s[static_cast<std::size_t>(d) * kDim + v];
+  }
+  for (std::uint32_t t = 0; t < tokens; ++t) {
+    __syncthreads();  // the previous token's row readers must drain first
+    decay_row[v] = expf(gate[static_cast<std::size_t>(t) * inner +
+                             static_cast<std::size_t>(h) * kDim + v]);
+    kn_row[v] = kn[static_cast<std::size_t>(t) * inner +
+                   static_cast<std::size_t>(h) * kDim + v];
+    qn_row[v] = qn[static_cast<std::size_t>(t) * inner +
+                   static_cast<std::size_t>(h) * kDim + v];
+    __syncthreads();
+    float kv = 0.0F;
+#pragma unroll
+    for (std::uint32_t d = 0; d < kDim; ++d) {
+      column[d] *= decay_row[d];
+      kv += column[d] * kn_row[d];
+    }
+    const float b = beta[t * heads + h];
+    const float delta =
+        (conv_out[static_cast<std::size_t>(t) * 3 * inner + 2 * inner +
+                  static_cast<std::size_t>(h) * kDim + v] -
+         kv) *
+        b;
+    float acc = 0.0F;
+#pragma unroll
+    for (std::uint32_t d = 0; d < kDim; ++d) {
+      column[d] += kn_row[d] * delta;
+      acc += column[d] * qn_row[d];
+    }
+    core[static_cast<std::size_t>(t) * inner +
+         static_cast<std::size_t>(h) * kDim + v] = acc;
+  }
+#pragma unroll
+  for (std::uint32_t d = 0; d < kDim; ++d) {
+    s[static_cast<std::size_t>(d) * kDim + v] = column[d];
+  }
+}
+
+__global__ void BatchIndexerAppendKernel(const float* keys_raw,
+                                         const float* gates_raw,
+                                         const float* k_norm_w,
+                                         const float* k_norm_b, float* keys,
+                                         float* gates, std::uint32_t idim,
+                                         float eps) {
+  __shared__ double shared[kBlockThreads];
+  const std::uint32_t t = blockIdx.x;
+  if (threadIdx.x == 0 && blockIdx.x == 0) {
+    (void)shared;
+  }
+  const float* key_raw = keys_raw + static_cast<std::size_t>(t) * idim;
+  const float* gate_raw = gates_raw + static_cast<std::size_t>(t) * idim;
+  double total = 0.0;
+  for (std::uint32_t i = threadIdx.x; i < idim; i += blockDim.x) {
+    total += key_raw[i];
+  }
+  const double mean = BlockSum(total, shared) / idim;
+  double squares = 0.0;
+  for (std::uint32_t i = threadIdx.x; i < idim; i += blockDim.x) {
+    const double centered = static_cast<double>(key_raw[i]) - mean;
+    squares += centered * centered;
+  }
+  const float inv =
+      static_cast<float>(1.0 / std::sqrt(BlockSum(squares, shared) / idim +
+                                         static_cast<double>(eps)));
+  for (std::uint32_t i = threadIdx.x; i < idim; i += blockDim.x) {
+    const float centered =
+        static_cast<float>(static_cast<double>(key_raw[i]) - mean);
+    keys[static_cast<std::size_t>(t) * idim + i] =
+        k_norm_w[i] * (centered * inv) + k_norm_b[i];
+    gates[static_cast<std::size_t>(t) * idim + i] = gate_raw[i];
+  }
+}
+
+__global__ void BatchIndexerPoolKernel(
+    const float* rows, const float* row_gates, const float* ape, float* pooled,
+    std::uint32_t first_pool, std::uint32_t pools, std::size_t row_base,
+    std::uint32_t kpool, std::uint32_t idim) {
+  const std::uint32_t pool = first_pool + blockIdx.y;
+  if (blockIdx.y >= pools) {
+    return;
+  }
+  const std::uint32_t d = blockIdx.x * blockDim.x + threadIdx.x;
+  if (d >= idim) {
+    return;
+  }
+  float logits[8];
+  const std::size_t base = static_cast<std::size_t>(pool) * kpool - row_base;
+  float max_value = -__int_as_float(0x7F800000);
+  for (std::uint32_t j = 0; j < kpool; ++j) {
+    logits[j] = row_gates[(base + j) * idim + d] + ape[j * idim + d];
+    max_value = max_value > logits[j] ? max_value : logits[j];
+  }
+  double denom = 0.0;
+  for (std::uint32_t j = 0; j < kpool; ++j) {
+    denom += exp(static_cast<double>(logits[j] - max_value));
+  }
+  float sum = 0.0F;
+  for (std::uint32_t j = 0; j < kpool; ++j) {
+    const float prob = static_cast<float>(
+        exp(static_cast<double>(logits[j] - max_value)) / denom);
+    sum += prob * rows[(base + j) * idim + d];
+  }
+  pooled[static_cast<std::size_t>(pool) * idim + d] = sum;
+}
+
+__global__ void BatchIndexerScoresKernel(
+    const float* iq, const float* pooled, const float* weights, float* scores,
+    std::uint32_t pitch, std::uint32_t pools, std::uint32_t kpool,
+    std::uint32_t seen_base, std::uint32_t heads, std::uint32_t idim,
+    float scale) {
+  const std::uint32_t t = blockIdx.z;
+  const std::uint32_t p = blockIdx.y * blockDim.x + threadIdx.x;
+  // A mid-chunk query only scores the pools complete at its position.
+  const std::uint32_t pools_t = (seen_base + t + 1) / kpool;
+  if (p >= pools || p >= pools_t) {
+    return;
+  }
+  const float* q_row = iq + static_cast<std::size_t>(t) * heads * idim;
+  double total = 0.0;
+  for (std::uint32_t h = 0; h < heads; ++h) {
+    double dot = 0.0;
+    const float* q = q_row + static_cast<std::size_t>(h) * idim;
+    const float* k = pooled + static_cast<std::size_t>(p) * idim;
+    for (std::uint32_t d = 0; d < idim; ++d) {
+      dot += static_cast<double>(q[d]) * k[d];
+    }
+    const float activated = static_cast<float>(dot) * scale;
+    total +=
+        static_cast<double>(weights[static_cast<std::size_t>(t) * heads + h]) *
+        (activated > 0.0F ? activated : 0.0F);
+  }
+  scores[static_cast<std::size_t>(t) * pitch + p] = static_cast<float>(total);
+}
+
+/// One full bitonic pass over `kSelectMaxPools` entries, descending; all
+/// threads follow the same trip counts so barriers stay legal.
+__device__ __forceinline__ void BitonicSortDesc(std::uint64_t* keys) {
+  for (std::uint32_t k = 2; k <= kSelectMaxPools; k <<= 1) {
+    for (std::uint32_t j = k >> 1; j > 0; j >>= 1) {
+      for (std::uint32_t i = threadIdx.x; i < kSelectMaxPools;
+           i += blockDim.x) {
+        const std::uint32_t other = i ^ j;
+        if (other > i && other < kSelectMaxPools) {
+          const bool descending = (i & k) == 0;
+          const bool swap =
+              descending ? keys[other] > keys[i] : keys[i] > keys[other];
+          if (swap) {
+            const std::uint64_t value = keys[i];
+            keys[i] = keys[other];
+            keys[other] = value;
+          }
+        }
+      }
+      __syncthreads();
+    }
+  }
+}
+
+__global__ void BatchSelectPoolsKernel(
+    const float* scores, std::uint32_t pitch, std::uint32_t pools,
+    std::uint32_t select_pools, std::uint32_t kpool, std::uint32_t seen_base,
+    std::int32_t* selections, std::uint32_t* counts, std::uint32_t sel_stride) {
+  __shared__ std::uint64_t keys[kSelectMaxPools];
+  __shared__ std::uint64_t comb[kSelectMaxPools];
+  __shared__ std::uint64_t best[kSelectMaxPools / 2];
+  __shared__ std::int32_t tokens[kSelectMaxPools / 2 * 4 + 3];
+  const std::uint32_t t = blockIdx.x;
+  const std::uint32_t tid = threadIdx.x;
+  const std::uint32_t tokens_seen = seen_base + t + 1;
+  const std::uint32_t pools_t = std::min(pools, tokens_seen / kpool);
+  // An early query selects from its own (smaller) pool set, like the
+  // tokenwise path's min(); padding keys must never enter the expansion.
+  const std::uint32_t select_pools_t = std::min(select_pools, pools_t);
+  // Running top-set width over the tiled score row; padded keys sort
+  // below every real candidate.
+  const std::uint32_t keep = std::min(select_pools, kSelectMaxPools / 2);
+  const std::uint64_t pad = PoolKey(-__int_as_float(0x7F800000), 0xffffffffu);
+  const std::size_t row = static_cast<std::size_t>(t) * pitch;
+  for (std::uint32_t i = tid; i < keep; i += blockDim.x) {
+    best[i] = pad;
+  }
+  __syncthreads();
+  // Tile the score row: each tile contributes its top `keep` into the
+  // running best, so the cut needs pools/1024 passes over at most 1024
+  // shared keys per pass.
+  for (std::uint32_t base = 0; base < pools_t; base += kSelectMaxPools) {
+    const std::uint32_t count = std::min(kSelectMaxPools, pools_t - base);
+    for (std::uint32_t i = tid; i < kSelectMaxPools; i += blockDim.x) {
+      keys[i] = i < count ? PoolKey(scores[row + base + i], base + i) : pad;
+    }
+    __syncthreads();
+    BitonicSortDesc(keys);
+    // [running best desc | tile top ascending | pad] is bitonic with the
+    // first half above; the same sort network folds it into the new best.
+    for (std::uint32_t i = tid; i < 2 * keep; i += blockDim.x) {
+      comb[i] = i < keep ? best[i] : keys[2 * keep - 1 - i];
+    }
+    __syncthreads();
+    for (std::uint32_t i = 2 * keep + tid; i < kSelectMaxPools;
+         i += blockDim.x) {
+      comb[i] = pad;
+    }
+    __syncthreads();
+    BitonicSortDesc(comb);
+    for (std::uint32_t i = tid; i < keep; i += blockDim.x) {
+      best[i] = comb[i];
+    }
+    __syncthreads();
+  }
+  const std::uint32_t tail = tokens_seen % kpool;
+  const std::uint32_t total = select_pools_t * kpool + tail;
+  for (std::uint32_t i = tid; i < total; i += blockDim.x) {
+    std::int32_t value;
+    if (i < select_pools_t * kpool) {
+      const std::uint32_t rank = i / kpool;
+      const std::uint32_t member = i % kpool;
+      const std::uint32_t pool =
+          0xffffffffu - static_cast<std::uint32_t>(best[rank] & 0xffffffffu);
+      value = static_cast<std::int32_t>(pool * kpool + member);
+    } else {
+      value = static_cast<std::int32_t>(tokens_seen - tail +
+                                        (i - select_pools_t * kpool));
+    }
+    tokens[i] = value;
+  }
+  __syncthreads();
+  std::uint32_t span = 1;
+  while (span < total) {
+    span <<= 1;
+  }
+  for (std::uint32_t i = tid; i < kSelectMaxPools / 2 * 4 + 3;
+       i += blockDim.x) {
+    if (i >= total) {
+      tokens[i] = 0x7fffffff;
+    }
+  }
+  __syncthreads();
+  for (std::uint32_t k = 2; k <= span; k <<= 1) {
+    for (std::uint32_t j = k >> 1; j > 0; j >>= 1) {
+      for (std::uint32_t i = tid; i < span; i += blockDim.x) {
+        const std::uint32_t other = i ^ j;
+        if (other > i && other < kSelectMaxPools / 2 * 4 + 3) {
+          const bool ascending = (i & k) == 0;
+          const bool swap =
+              ascending ? tokens[other] < tokens[i] : tokens[i] < tokens[other];
+          if (swap) {
+            const std::int32_t value = tokens[i];
+            tokens[i] = tokens[other];
+            tokens[other] = value;
+          }
+        }
+      }
+      __syncthreads();
+    }
+  }
+  if (tid == 0) {
+    counts[t] = total;
+  }
+  std::int32_t* out = selections + static_cast<std::size_t>(t) * sel_stride;
+  for (std::uint32_t i = tid; i < total; i += blockDim.x) {
+    out[i] = tokens[i];
+  }
+}
+
+__global__ void BatchMlaAbsorbKernel(const float* k_b, const float* q,
+                                     float* q_abs, std::uint32_t heads,
+                                     std::uint32_t kv_lora,
+                                     std::uint32_t qk_nope) {
+  const std::uint32_t t = blockIdx.y;
+  const std::uint32_t h = blockIdx.x;
+  const std::uint32_t lane = threadIdx.x & 31u;
+  const std::uint32_t warp = threadIdx.x >> 5u;
+  if (h >= heads) {
+    return;
+  }
+  const float* head_w = k_b + static_cast<std::size_t>(h) * kv_lora * qk_nope;
+  const float* query = q + (static_cast<std::size_t>(t) * heads + h) * qk_nope;
+  // One warp per output row: lanes walk the reduction dimension together,
+  // so the k_b and query reads coalesce instead of one row per thread.
+  for (std::uint32_t r = warp; r < kv_lora; r += blockDim.x / 32u) {
+    const float* row = head_w + static_cast<std::size_t>(r) * qk_nope;
+    float sum = 0.0F;
+    for (std::uint32_t c = lane; c < qk_nope; c += 32u) {
+      sum += row[c] * query[c];
+    }
+    for (int off = 16; off > 0; off >>= 1) {
+      sum += __shfl_xor(sum, off);
+    }
+    if (lane == 0) {
+      q_abs[(static_cast<std::size_t>(t) * heads + h) * kv_lora + r] = sum;
+    }
+  }
+}
+
+__global__ void BatchMlaAttentionKernel(
+    const float* q_abs, const float* latents, const std::int32_t* selections,
+    const std::uint32_t* counts, std::uint32_t sel_stride, const float* v_b,
+    float* attn_out, float* probs, float* weighted, std::uint32_t heads,
+    std::uint32_t kv_lora, std::uint32_t qk_nope, std::uint32_t v_head,
+    float scale) {
+  extern __shared__ float shared[];
+  const std::uint32_t t = blockIdx.y;
+  const std::uint32_t h = blockIdx.x;
+  if (h >= heads) {
+    return;
+  }
+  const std::uint32_t lane = threadIdx.x & 31u;
+  const std::uint32_t warp = threadIdx.x >> 5u;
+  const std::uint32_t warps = blockDim.x / 32u;
+  const std::uint32_t count = counts[t];
+  float* sh_scores = shared;
+  float* sh_max = shared + count;
+  const float* qa = q_abs + (static_cast<std::size_t>(t) * heads + h) * kv_lora;
+  const std::int32_t* sel =
+      selections + static_cast<std::size_t>(t) * sel_stride;
+  float* head_probs =
+      probs + (static_cast<std::size_t>(t) * heads + h) * sel_stride;
+  float* head_weighted =
+      weighted + (static_cast<std::size_t>(t) * heads + h) * kv_lora;
+  // Scores: one warp per selected latent, lanes over the lora dimension —
+  // the latent and query rows are read coalesced.
+  for (std::uint32_t i = warp; i < count; i += warps) {
+    const auto at = static_cast<std::uint32_t>(sel[i]);
+    const float* latent = latents + static_cast<std::size_t>(at) * kv_lora;
+    float dot = 0.0F;
+    for (std::uint32_t r = lane; r < kv_lora; r += 32u) {
+      dot += qa[r] * latent[r];
+    }
+    for (int off = 16; off > 0; off >>= 1) {
+      dot += __shfl_xor(dot, off);
+    }
+    if (lane == 0) {
+      sh_scores[i] = dot * scale;
+    }
+  }
+  __syncthreads();
+  __shared__ double denom_shared;
+  if (threadIdx.x == 0) {
+    float max_value = -__int_as_float(0x7F800000);
+    for (std::uint32_t i = 0; i < count; ++i) {
+      max_value = max_value > sh_scores[i] ? max_value : sh_scores[i];
+    }
+    sh_max[0] = max_value;
+    double denom = 0.0;
+    for (std::uint32_t i = 0; i < count; ++i) {
+      denom += exp(static_cast<double>(sh_scores[i] - max_value));
+    }
+    denom_shared = denom;
+  }
+  __syncthreads();
+  // Exponentials in parallel (float); the denominator above already holds
+  // the reference's serial double sum in selection order.
+  for (std::uint32_t i = threadIdx.x; i < count; i += blockDim.x) {
+    head_probs[i] = static_cast<float>(
+        exp(static_cast<double>(sh_scores[i] - sh_max[0])) / denom_shared);
+  }
+  __syncthreads();
+  {
+    // Four interleaved accumulators per lora dimension: the dependent FMA
+    // chain per accumulator shrinks fourfold while the coalesced latent
+    // reads and the block's shared footprint stay unchanged.
+    for (std::uint32_t r2 = threadIdx.x; r2 < kv_lora; r2 += blockDim.x) {
+      float acc0 = 0.0F;
+      float acc1 = 0.0F;
+      float acc2 = 0.0F;
+      float acc3 = 0.0F;
+      std::uint32_t i = 0;
+      for (; i + 3 < count; i += 4) {
+        const auto at0 = static_cast<std::uint32_t>(sel[i]);
+        const auto at1 = static_cast<std::uint32_t>(sel[i + 1]);
+        const auto at2 = static_cast<std::uint32_t>(sel[i + 2]);
+        const auto at3 = static_cast<std::uint32_t>(sel[i + 3]);
+        acc0 += head_probs[i] *
+                latents[static_cast<std::size_t>(at0) * kv_lora + r2];
+        acc1 += head_probs[i + 1] *
+                latents[static_cast<std::size_t>(at1) * kv_lora + r2];
+        acc2 += head_probs[i + 2] *
+                latents[static_cast<std::size_t>(at2) * kv_lora + r2];
+        acc3 += head_probs[i + 3] *
+                latents[static_cast<std::size_t>(at3) * kv_lora + r2];
+      }
+      for (; i < count; ++i) {
+        const auto at = static_cast<std::uint32_t>(sel[i]);
+        acc0 += head_probs[i] *
+                latents[static_cast<std::size_t>(at) * kv_lora + r2];
+      }
+      head_weighted[r2] = ((acc0 + acc1) + (acc2 + acc3));
+    }
+  }
+  __syncthreads();
+  const float* head_v = v_b + static_cast<std::size_t>(h) * v_head * kv_lora;
+  float* out = attn_out + (static_cast<std::size_t>(t) * heads + h) * v_head;
+  for (std::uint32_t j = warp; j < v_head; j += warps) {
+    const float* row = head_v + static_cast<std::size_t>(j) * kv_lora;
+    float sum = 0.0F;
+    for (std::uint32_t r = lane; r < kv_lora; r += 32u) {
+      sum += row[r] * head_weighted[r];
+    }
+    for (int off = 16; off > 0; off >>= 1) {
+      sum += __shfl_xor(sum, off);
+    }
+    if (lane == 0) {
+      out[j] = sum;
+    }
+  }
+}
+
+/// Token-tiled absorbed query projection: one block covers kMlaAbsorbTokens
+/// tokens of one head, staging each k_b row in registers once and feeding
+/// every token of the tile from it. Per (token, row) the lane partials and
+/// the butterfly match the legacy kernel element for element.
+__global__ void BatchMlaAbsorbTiledKernel(const float* k_b, const float* q,
+                                          float* q_abs, std::uint32_t tokens,
+                                          std::uint32_t heads,
+                                          std::uint32_t kv_lora,
+                                          std::uint32_t qk_nope,
+                                          std::uint32_t tile_tokens) {
+  const std::uint32_t h = blockIdx.x;
+  const std::uint32_t t_base = blockIdx.y * tile_tokens;
+  const std::uint32_t lane = threadIdx.x & 31u;
+  const std::uint32_t warp = threadIdx.x >> 5u;
+  const float* head_w = k_b + static_cast<std::size_t>(h) * kv_lora * qk_nope;
+  // One warp per output row, lanes over the nope dimension; the staged row
+  // registers serve the whole token tile.
+  for (std::uint32_t r = warp; r < kv_lora; r += blockDim.x / 32u) {
+    const float* row = head_w + static_cast<std::size_t>(r) * qk_nope;
+    float rowv[kMlaNopeLanes];
+#pragma unroll
+    for (std::uint32_t k = 0; k < kMlaNopeLanes; ++k) {
+      rowv[k] = row[lane + k * 32u];
+    }
+    for (std::uint32_t ts = 0; ts < tile_tokens && t_base + ts < tokens; ++ts) {
+      const float* query =
+          q + (static_cast<std::size_t>(t_base + ts) * heads + h) * qk_nope;
+      float sum = 0.0F;
+#pragma unroll
+      for (std::uint32_t k = 0; k < kMlaNopeLanes; ++k) {
+        sum += rowv[k] * query[lane + k * 32u];
+      }
+      for (int off = 16; off > 0; off >>= 1) {
+        sum += __shfl_xor(sum, off);
+      }
+      if (lane == 0) {
+        q_abs[(static_cast<std::size_t>(t_base + ts) * heads + h) * kv_lora +
+              r] = sum;
+      }
+    }
+  }
+}
+
+/// Split-launch form of the tiled absorbed sparse-MLA attention. The fused
+/// kernel held the score/softmax and gather/epilogue register sets together
+/// (112 VGPRs at 512 threads - one resident block per CU) while the phases
+/// only communicate through the probs/weighted global stripes, so the tile
+/// now launches as two kernels: the score half computes the probabilities
+/// (and leaves them in the probs stripe exactly as before), the gather half
+/// reads them back for the weighted gather and v_b epilogue. Every load,
+/// store, reduction order and expression per (token, head) is the fused
+/// kernel's verbatim, so the outputs match bit for bit while each half's
+/// smaller live register set doubles the achievable block residency.
+///
+/// The softmax keeps the reference numerics - parallel max (exact for finite
+/// scores) and the serial double denominator in selection order per head -
+/// but the exponential terms are now computed cooperatively into shared
+/// memory once and then (a) summed serially in selection order by the
+/// head's thread and (b) reused for the probability writes. The summed
+/// terms and the addition order are unchanged, so the denominator and every
+/// probability are bit-identical to the fused kernel; only the scheduling
+/// of the same exp(double) evaluations moves (they run 512-wide instead of
+/// serially on the denominator thread, and the second evaluation the fused
+/// kernel's parallel pass performed disappears).
+template<int H>
+__global__ void BatchMlaScoreTiledKernel(
+    const float* q_abs, const float* latents, const std::int32_t* selections,
+    const std::uint32_t* counts, std::uint32_t sel_stride, float* probs,
+    std::uint32_t tokens, std::uint32_t heads, std::uint32_t kv_lora,
+    std::uint32_t tile_tokens, float scale) {
+  extern __shared__ double sh_exp[];  // sel_stride doubles, then H doubles
+  double* sh_denom = sh_exp + sel_stride;
+  __shared__ float sh_max[H];
+  __shared__ float sh_wmax[kMlaMaxWarps][H];
+  const std::uint32_t h0 = blockIdx.x * H;
+  const std::uint32_t t_base = blockIdx.y * tile_tokens;
+  const std::uint32_t lane = threadIdx.x & 31u;
+  const std::uint32_t warp = threadIdx.x >> 5u;
+  const std::uint32_t warps = blockDim.x / 32u;
+  for (std::uint32_t ts = 0; ts < tile_tokens && t_base + ts < tokens; ++ts) {
+    const std::uint32_t t = t_base + ts;
+    const std::uint32_t count = counts[t];
+    const std::int32_t* sel =
+        selections + static_cast<std::size_t>(t) * sel_stride;
+    float* scr_base =
+        probs + (static_cast<std::size_t>(t) * heads + h0) * sel_stride;
+    const float* qa_base =
+        q_abs + (static_cast<std::size_t>(t) * heads + h0) * kv_lora;
+    // Scores: one warp per selected latent, lanes over the lora dimension.
+    // The latent row registers feed every head of the tile, and each warp
+    // tracks its running max (exact for the finite scores this family
+    // produces) so the legacy kernel's serial max pass disappears.
+    float wmax[H];
+#pragma unroll
+    for (int h = 0; h < H; ++h) {
+      wmax[h] = -__int_as_float(0x7F800000);
+    }
+    for (std::uint32_t i = warp; i < count; i += warps) {
+      const float* latent =
+          latents + static_cast<std::size_t>(sel[i]) * kv_lora;
+      float row[kMlaLoraLanes];
+#pragma unroll
+      for (std::uint32_t k = 0; k < kMlaLoraLanes; ++k) {
+        row[k] = latent[lane + k * 32u];
+      }
+#pragma unroll
+      for (int h = 0; h < H; ++h) {
+        const float* qa = qa_base + static_cast<std::size_t>(h) * kv_lora;
+        float dot = 0.0F;
+#pragma unroll
+        for (std::uint32_t k = 0; k < kMlaLoraLanes; ++k) {
+          dot += qa[lane + k * 32u] * row[k];
+        }
+        for (int off = 16; off > 0; off >>= 1) {
+          dot += __shfl_xor(dot, off);
+        }
+        if (lane == 0) {
+          const float s = dot * scale;
+          scr_base[static_cast<std::size_t>(h) * sel_stride + i] = s;
+          wmax[h] = wmax[h] > s ? wmax[h] : s;
+        }
+      }
+    }
+    if (lane == 0) {
+#pragma unroll
+      for (int h = 0; h < H; ++h) {
+        sh_wmax[warp][h] = wmax[h];
+      }
+    }
+    __syncthreads();
+    if (threadIdx.x < H) {
+      const int h = threadIdx.x;
+      float m = -__int_as_float(0x7F800000);
+      for (std::uint32_t w = 0; w < warps; ++w) {
+        m = m > sh_wmax[w][h] ? m : sh_wmax[w][h];
+      }
+      sh_max[h] = m;
+    }
+    __syncthreads();
+    // Softmax: the head's exponential terms are evaluated cooperatively
+    // into shared memory, the denominator thread then walks the reference's
+    // serial double sum in selection order over those exact values, and the
+    // probability pass divides the same shared terms by it - the fused
+    // kernel evaluated every exponential twice (serially in the chain and
+    // again for the parallel write); the values here are identical.
+#pragma unroll 1
+    for (int h = 0; h < H; ++h) {
+      float* scr = scr_base + static_cast<std::size_t>(h) * sel_stride;
+      const float mx = sh_max[h];
+      for (std::uint32_t i = threadIdx.x; i < count; i += blockDim.x) {
+        sh_exp[i] = exp(static_cast<double>(scr[i] - mx));
+      }
+      __syncthreads();
+      if (threadIdx.x == h) {
+        double denom = 0.0;
+#pragma unroll 4
+        for (std::uint32_t i = 0; i < count; ++i) {
+          denom += sh_exp[i];
+        }
+        sh_denom[h] = denom;
+      }
+      __syncthreads();
+      const double denom = sh_denom[h];
+      for (std::uint32_t i = threadIdx.x; i < count; i += blockDim.x) {
+        scr[i] = static_cast<float>(sh_exp[i] / denom);
+      }
+      __syncthreads();
+    }
+  }
+}
+
+/// Gather half of the split: the weighted gather (four interleaved
+/// accumulators per head and lora element over the probabilities the score
+/// kernel left in the probs stripe) and the v_b epilogue (each panel row
+/// staged once and dotted against every token of the tile) - the fused
+/// kernel's loops verbatim.
+template<int H>
+__global__ void BatchMlaGatherTiledKernel(
+    const float* latents, const std::int32_t* selections,
+    const std::uint32_t* counts, std::uint32_t sel_stride, const float* v_b,
+    const float* probs, float* attn_out, float* weighted, std::uint32_t tokens,
+    std::uint32_t heads, std::uint32_t kv_lora, std::uint32_t v_head,
+    std::uint32_t tile_tokens) {
+  const std::uint32_t h0 = blockIdx.x * H;
+  const std::uint32_t t_base = blockIdx.y * tile_tokens;
+  const std::uint32_t lane = threadIdx.x & 31u;
+  const std::uint32_t warp = threadIdx.x >> 5u;
+  const std::uint32_t warps = blockDim.x / 32u;
+  for (std::uint32_t ts = 0; ts < tile_tokens && t_base + ts < tokens; ++ts) {
+    const std::uint32_t t = t_base + ts;
+    const std::uint32_t count = counts[t];
+    const std::int32_t* sel =
+        selections + static_cast<std::size_t>(t) * sel_stride;
+    const float* scr_base =
+        probs + (static_cast<std::size_t>(t) * heads + h0) * sel_stride;
+    const std::uint32_t r2 = threadIdx.x;
+    float acc[H][4];
+#pragma unroll
+    for (int h = 0; h < H; ++h) {
+      acc[h][0] = 0.0F;
+      acc[h][1] = 0.0F;
+      acc[h][2] = 0.0F;
+      acc[h][3] = 0.0F;
+    }
+    std::uint32_t i = 0;
+    for (; i + 3 < count; i += 4) {
+      const float row0 =
+          latents[static_cast<std::size_t>(sel[i]) * kv_lora + r2];
+      const float row1 =
+          latents[static_cast<std::size_t>(sel[i + 1]) * kv_lora + r2];
+      const float row2 =
+          latents[static_cast<std::size_t>(sel[i + 2]) * kv_lora + r2];
+      const float row3 =
+          latents[static_cast<std::size_t>(sel[i + 3]) * kv_lora + r2];
+#pragma unroll
+      for (int h = 0; h < H; ++h) {
+        const float* scrp = scr_base + static_cast<std::size_t>(h) * sel_stride;
+        acc[h][0] += scrp[i] * row0;
+        acc[h][1] += scrp[i + 1] * row1;
+        acc[h][2] += scrp[i + 2] * row2;
+        acc[h][3] += scrp[i + 3] * row3;
+      }
+    }
+    for (; i < count; ++i) {
+      const float row0 =
+          latents[static_cast<std::size_t>(sel[i]) * kv_lora + r2];
+#pragma unroll
+      for (int h = 0; h < H; ++h) {
+        const float* scrp = scr_base + static_cast<std::size_t>(h) * sel_stride;
+        acc[h][0] += scrp[i] * row0;
+      }
+    }
+#pragma unroll
+    for (int h = 0; h < H; ++h) {
+      weighted[(static_cast<std::size_t>(t) * heads + h0 + h) * kv_lora + r2] =
+          ((acc[h][0] + acc[h][1]) + (acc[h][2] + acc[h][3]));
+    }
+    __syncthreads();
+  }
+  // v_b epilogue: each panel row is staged once and dotted against every
+  // token of the tile, matching the legacy kernel's per-token warp
+  // butterfly element for element.
+  for (int h = 0; h < H; ++h) {
+    const float* head_v =
+        v_b + static_cast<std::size_t>(h0 + h) * v_head * kv_lora;
+    float* out_base =
+        attn_out + (static_cast<std::size_t>(t_base) * heads + h0 + h) * v_head;
+    const float* hw_base =
+        weighted +
+        (static_cast<std::size_t>(t_base) * heads + h0 + h) * kv_lora;
+    for (std::uint32_t j = warp; j < v_head; j += warps) {
+      const float* row = head_v + static_cast<std::size_t>(j) * kv_lora;
+      float rowv[kMlaLoraLanes];
+#pragma unroll
+      for (std::uint32_t k = 0; k < kMlaLoraLanes; ++k) {
+        rowv[k] = row[lane + k * 32u];
+      }
+      for (std::uint32_t ts = 0; ts < tile_tokens && t_base + ts < tokens;
+           ++ts) {
+        const float* hw =
+            hw_base + static_cast<std::size_t>(ts) * heads * kv_lora;
+        float sum = 0.0F;
+#pragma unroll
+        for (std::uint32_t k = 0; k < kMlaLoraLanes; ++k) {
+          sum += rowv[k] * hw[lane + k * 32u];
+        }
+        for (int off = 16; off > 0; off >>= 1) {
+          sum += __shfl_xor(sum, off);
+        }
+        if (lane == 0) {
+          out_base[static_cast<std::size_t>(ts) * heads * v_head + j] = sum;
+        }
+      }
+    }
+  }
+}
+
+/// acc[t][c] += weights[t] * x[t][c]: the tokenwise ScaleAddInto op with a
+/// per-row weight (the routed expert weights).
+__global__ void ScaleAddRowsWeightedKernel(float* acc, const float* x,
+                                           const float* weights,
+                                           std::uint32_t hidden,
+                                           std::size_t x_stride,
+                                           std::size_t count) {
+  const std::size_t i =
+      static_cast<std::size_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+  if (i < count) {
+    const std::uint32_t t = static_cast<std::uint32_t>(i / hidden);
+    acc[i] +=
+        weights[t] * x[static_cast<std::size_t>(t) * x_stride + i % hidden];
+  }
+}
+
+__global__ void BatchAppendRowsKernel(const float* src, float* dst,
+                                      std::uint32_t row, std::uint32_t offset,
+                                      std::uint32_t tokens) {
+  const std::size_t i =
+      static_cast<std::size_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+  const std::size_t total = static_cast<std::size_t>(tokens) * row;
+  if (i < total) {
+    const std::size_t t = i / row;
+    const std::uint32_t c = static_cast<std::uint32_t>(i % row);
+    dst[(static_cast<std::size_t>(offset) + t) * row + c] = src[i];
+  }
+}
+
+unsigned GridBlocks(std::size_t elements) {
+  return static_cast<unsigned>((elements + kBlockThreads - 1) / kBlockThreads);
+}
+
+}  // namespace
+
+bool BatchEmbedTokenStreams(const void* table, WeightType type,
+                            const std::int32_t* tokens, float* streams,
+                            std::uint32_t hidden, std::uint32_t n_streams,
+                            std::uint32_t tokens_count, hipStream_t stream,
+                            std::string* error_msg) {
+  const auto fail = [&](const char* what) {
+    if (error_msg != nullptr) {
+      *error_msg = what;
+    }
+    return false;
+  };
+  if (type != WeightType::kF32 && type != WeightType::kQ8_0) {
+    return fail("embedding table uses an unsupported encoding");
+  }
+  if (hidden % 4 != 0 || (type == WeightType::kQ8_0 && hidden % 32 != 0)) {
+    return fail("embedding width does not divide the batch kernel geometry");
+  }
+  const dim3 grid(GridBlocks(hidden / 4), tokens_count);
+  BatchEmbedKernel<<<grid, kBlockThreads, 0, stream>>>(
+      table, static_cast<std::uint32_t>(type), tokens, streams, hidden,
+      n_streams);
+  return hipGetLastError() == hipSuccess
+             ? true
+             : fail("batch embedding launch failed");
+}
+
+void BatchRouterSelect(const float* logits, const float* bias,
+                       std::int32_t* ids, float* weights, std::uint32_t tokens,
+                       std::uint32_t expert_count, std::uint32_t experts_used,
+                       float routed_scaling, hipStream_t stream) {
+  BatchRouterSelectKernel<<<tokens, kBlockThreads, 0, stream>>>(
+      logits, bias, ids, weights, tokens, expert_count, experts_used,
+      routed_scaling);
+}
+
+/// Host-side mirror of IsSub16DecodedQuant's format set for launcher
+/// dispatch (the device helper is __device__-only).
+bool IsSub16Host(core::GgmlType t) noexcept {
+  return t == core::GgmlType::kQ4_K || t == core::GgmlType::kQ5_K ||
+         t == core::GgmlType::kQ6_K || t == core::GgmlType::kQ3_K ||
+         t == core::GgmlType::kIQ4_NL || t == core::GgmlType::kIQ4_XS ||
+         t == core::GgmlType::kIQ3_S;
+}
+
+void BatchQ8KBlockGEMV(const void* w, WeightType type, const float* x, float* y,
+                       std::uint32_t tokens, std::uint32_t m, std::uint32_t k,
+                       hipStream_t stream, std::size_t y_stride) {
+  const auto ggml_type =
+      static_cast<gufo::core::GgmlType>(static_cast<std::uint32_t>(type));
+  if (ggml_type == gufo::core::GgmlType::kQ8_0 || IsSub16Host(ggml_type)) {
+    const std::uint32_t rows_per_block = kQuantWarps * kQuantRows;
+    if (m % rows_per_block != 0) {
+      // The tiled kernel's staging/barrier collective requires blocks of
+      // whole row groups; exotic row counts fall back to the wave GEMV.
+      const dim3 grid((m + kGemmWaves - 1) / kGemmWaves, tokens);
+      BatchQ8KKernel<kGemmWaves><<<grid, kGemmWaves * 32, 0, stream>>>(
+          w, static_cast<std::uint32_t>(type), x, y, m, k,
+          y_stride != 0 ? y_stride : m);
+      return;
+    }
+    const dim3 grid(m / rows_per_block,
+                    (tokens + kQuantTokens - 1) / kQuantTokens);
+    BatchQuantTiledKernel<<<grid, kQuantWarps * 32, 0, stream>>>(
+        w, static_cast<std::uint32_t>(type), x, y, m, k, tokens,
+        y_stride != 0 ? y_stride : m);
+    return;
+  }
+  const dim3 grid((m + kGemmWaves - 1) / kGemmWaves, tokens);
+  BatchQ8KKernel<kGemmWaves><<<grid, kGemmWaves * 32, 0, stream>>>(
+      w, static_cast<std::uint32_t>(type), x, y, m, k,
+      y_stride != 0 ? y_stride : m);
+}
+
+void BatchExpertQ8KBlockGEMV(const void* w, WeightType type,
+                             const std::int32_t* ids, const float* x, float* y,
+                             std::uint32_t tokens, std::uint32_t slots,
+                             std::size_t expert_stride, std::uint32_t m,
+                             std::uint32_t k, hipStream_t stream) {
+  const dim3 grid((m + kGemmWaves - 1) / kGemmWaves, tokens * slots);
+  BatchExpertQ8KKernel<kGemmWaves><<<grid, kGemmWaves * 32, 0, stream>>>(
+      w, static_cast<std::uint32_t>(type), ids, x, y, slots, expert_stride, m,
+      k, static_cast<std::size_t>(k));
+}
+
+bool BatchExpertQ8KGrouped(const void* w, WeightType type,
+                           const std::int32_t* ids, std::uint32_t* bins,
+                           std::uint32_t* ranks, std::uint32_t* pairs,
+                           const float* x, float* y, std::uint32_t tokens,
+                           std::uint32_t slots, std::size_t expert_stride,
+                           std::uint32_t m, std::uint32_t k,
+                           std::size_t x_stride, std::uint32_t experts,
+                           hipStream_t stream) {
+  const auto ggml_type =
+      static_cast<gufo::core::GgmlType>(static_cast<std::uint32_t>(type));
+  if (ggml_type != gufo::core::GgmlType::kQ8_0 && !IsSub16Host(ggml_type)) {
+    return false;
+  }
+  const std::uint32_t count = tokens * slots;
+  ExpertZeroKernel<<<1, kBlockThreads, 0, stream>>>(bins, experts);
+  ExpertHistogramKernel<<<(count + kBlockThreads - 1) / kBlockThreads,
+                          kBlockThreads, 0, stream>>>(ids, bins, ranks, count);
+  ExpertPrefixKernel<<<1, 1, 0, stream>>>(bins, experts);
+  ExpertScatterKernel<<<(count + kBlockThreads - 1) / kBlockThreads,
+                        kBlockThreads, 0, stream>>>(ids, bins, ranks, pairs,
+                                                    count);
+  const std::uint32_t rows_per_block = kExpertWarps * kExpertRows;
+  const dim3 grid((m + rows_per_block - 1) / rows_per_block, experts);
+  // Weight-stationary fast path for the shapes it covers (sub-16 formats
+  // with vector-alignable rows); one canonical kernel per regime, all
+  // bit-identical twins of the generic kernel below. The prefill shape
+  // carries a 32-pair bucket so the expert table streams ~once per
+  // 1024-wide chunk; the decode shape keeps the small staging tile whose
+  // LDS residency hides the tiny-bucket latency (25-40% at n=1).
+  if (IsSub16Host(ggml_type) && k % 4 == 0 &&
+      (x_stride == 1 || x_stride % 4 == 0)) {
+    if (tokens >= kExpertPrefillBatch) {
+      BatchExpertGroupedWsKernel<kExpertWsPrefillBucket, kExpertWsPrefillStage,
+                                 kExpertWsPrefillWarps, kExpertWsPrefillRows>
+          <<<grid, kExpertWsPrefillWarps * 32, 0, stream>>>(
+              w, static_cast<std::uint32_t>(type), bins, pairs, x, y, slots,
+              expert_stride, m, k, x_stride);
+    } else {
+      BatchExpertGroupedWsKernel<kExpertWsDecodeBucket, kExpertWsDecodeStage,
+                                 kExpertWsDecodeWarps, kExpertWsDecodeRows>
+          <<<grid, kExpertWsDecodeWarps * 32, 0, stream>>>(
+              w, static_cast<std::uint32_t>(type), bins, pairs, x, y, slots,
+              expert_stride, m, k, x_stride);
+    }
+    return true;
+  }
+  BatchExpertGroupedKernel<<<grid, kExpertWarps * 32, 0, stream>>>(
+      w, static_cast<std::uint32_t>(type), bins, pairs, x, y, slots,
+      expert_stride, m, k, x_stride);
+  return true;
+}
+
+void BatchExpertQ8KBlockGEMVPairDense(const void* w, WeightType type,
+                                      const std::int32_t* ids, const float* x,
+                                      float* y, std::uint32_t tokens,
+                                      std::uint32_t slots,
+                                      std::size_t expert_stride,
+                                      std::uint32_t m, std::uint32_t k,
+                                      hipStream_t stream) {
+  const dim3 grid((m + kGemmWaves - 1) / kGemmWaves, tokens * slots);
+  BatchExpertQ8KKernel<kGemmWaves><<<grid, kGemmWaves * 32, 0, stream>>>(
+      w, static_cast<std::uint32_t>(type), ids, x, y, slots, expert_stride, m,
+      k, 1);
+}
+
+void BatchF32Gemm(const float* w, const float* x, float* y,
+                  std::uint32_t tokens, std::uint32_t m, std::uint32_t k,
+                  hipStream_t stream) {
+  // One canonical shape per regime, both float twins with identical
+  // per-(row, token) statement order (see kF32PrefillBatch): prefill
+  // batches stream the table once per 32 tokens with a 64-row x audience;
+  // decode-width batches keep the small staging tile whose residency hides
+  // the tiny-batch latency.
+  if (tokens >= kF32PrefillBatch) {
+    constexpr std::uint32_t rows_per_block = kF32PrefillWarps * kF32PrefillRows;
+    const dim3 grid((m + rows_per_block - 1) / rows_per_block,
+                    (tokens + kF32PrefillTokens - 1) / kF32PrefillTokens);
+    BatchF32WsKernel<kF32PrefillTokens, kF32PrefillWarps, kF32PrefillRows>
+        <<<grid, kF32PrefillWarps * 32, 0, stream>>>(w, x, y, m, k, tokens);
+    return;
+  }
+  constexpr std::uint32_t rows_per_block = kF32DecodeWarps * kF32DecodeRows;
+  const dim3 grid((m + rows_per_block - 1) / rows_per_block,
+                  (tokens + kF32DecodeTokens - 1) / kF32DecodeTokens);
+  BatchF32WsKernel<kF32DecodeTokens, kF32DecodeWarps, kF32DecodeRows>
+      <<<grid, kF32DecodeWarps * 32, 0, stream>>>(w, x, y, m, k, tokens);
+}
+
+void BatchHcSinkhorn(const float* mixes, const float* scale, const float* base,
+                     float* pre, float* post, float* comb, std::uint32_t n,
+                     std::uint32_t tokens, std::uint32_t sinkhorn_iters,
+                     float eps, hipStream_t stream) {
+  BatchHcSinkhornKernel<<<tokens, 1, 0, stream>>>(mixes, scale, base, pre, post,
+                                                  comb, n, sinkhorn_iters, eps);
+}
+
+void BatchHcCollapse(const float* pre, const float* streams, float* collapsed,
+                     std::uint32_t hidden, std::uint32_t n,
+                     std::uint32_t tokens, hipStream_t stream) {
+  const dim3 grid(GridBlocks(hidden), tokens);
+  BatchHcCollapseKernel<<<grid, kBlockThreads, 0, stream>>>(
+      pre, streams, collapsed, hidden, n);
+}
+
+void BatchHcCombine(const float* post, const float* comb, const float* residual,
+                    const float* block_out, float* streams,
+                    std::uint32_t hidden, std::uint32_t n, std::uint32_t tokens,
