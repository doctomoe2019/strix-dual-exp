+bool Rejects(const gufo::json::Value& schema, bool strict,
+             bool open_objects = false) {
+  try {
+    (void)JsonConstraint::Compile(schema, strict, open_objects);
+  } catch (const std::invalid_argument&) {
+    return true;
+  }
+  return false;
+}
