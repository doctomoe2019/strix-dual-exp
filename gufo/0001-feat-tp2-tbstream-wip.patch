+bool BatchEmbedTokenStreams(const void* table, WeightType type,
+                            const std::int32_t* tokens, float* streams,
+                            std::uint32_t hidden, std::uint32_t n_streams,
+                            std::uint32_t tokens_count, hipStream_t stream,
+                            std::string* error_msg) {
+  const auto fail = [&](const char* what) {
+    if (error_msg != nullptr) {
+      *error_msg = what;
+    }
+    return false;
+  };
+  if (type != WeightType::kF32 && type != WeightType::kQ8_0) {
+    return fail("embedding table uses an unsupported encoding");
+  }
+  if (hidden % 4 != 0 || (type == WeightType::kQ8_0 && hidden % 32 != 0)) {
+    return fail("embedding width does not divide the batch kernel geometry");
+  }
+  const dim3 grid(GridBlocks(hidden / 4), tokens_count);
+  BatchEmbedKernel<<<grid, kBlockThreads, 0, stream>>>(
+      table, static_cast<std::uint32_t>(type), tokens, streams, hidden,
+      n_streams);
+  return hipGetLastError() == hipSuccess
+             ? true
+             : fail("batch embedding launch failed");
+}
