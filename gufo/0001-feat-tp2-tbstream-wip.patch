+void BatchF32Gemm(const float* w, const float* x, float* y,
+                  std::uint32_t tokens, std::uint32_t m, std::uint32_t k,
+                  hipStream_t stream) {
+  // One canonical shape per regime, both float twins with identical
+  // per-(row, token) statement order (see kF32PrefillBatch): prefill
+  // batches stream the table once per 32 tokens with a 64-row x audience;
+  // decode-width batches keep the small staging tile whose residency hides
+  // the tiny-batch latency.
+  if (tokens >= kF32PrefillBatch) {
+    constexpr std::uint32_t rows_per_block = kF32PrefillWarps * kF32PrefillRows;
+    const dim3 grid((m + rows_per_block - 1) / rows_per_block,
+                    (tokens + kF32PrefillTokens - 1) / kF32PrefillTokens);
+    BatchF32WsKernel<kF32PrefillTokens, kF32PrefillWarps, kF32PrefillRows>
+        <<<grid, kF32PrefillWarps * 32, 0, stream>>>(w, x, y, m, k, tokens);
+    return;
+  }
+  constexpr std::uint32_t rows_per_block = kF32DecodeWarps * kF32DecodeRows;
+  const dim3 grid((m + rows_per_block - 1) / rows_per_block,
+                  (tokens + kF32DecodeTokens - 1) / kF32DecodeTokens);
+  BatchF32WsKernel<kF32DecodeTokens, kF32DecodeWarps, kF32DecodeRows>
+      <<<grid, kF32DecodeWarps * 32, 0, stream>>>(w, x, y, m, k, tokens);
+}
