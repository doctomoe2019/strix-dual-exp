+#ifndef GUFO_MODELS_QWEN38_FLASH_NEXT_KERNELS_ROCM_TBSTREAM_HPP_
+#define GUFO_MODELS_QWEN38_FLASH_NEXT_KERNELS_ROCM_TBSTREAM_HPP_
+
