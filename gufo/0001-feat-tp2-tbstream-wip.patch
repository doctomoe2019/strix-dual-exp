+// Single-host prefill timing probe: the same Session::Sync prefill path the
+// two-host batched probe drives, without a transport, scheduler or HTTP.
+//
+// qwen38_flash_next_prefill_probe --model FIRST_SHARD.gguf \
+//   --prompt-tokens N [--context N] [--repeat R] [--mtp-model MTP.gguf]
+//   [--warmup-tokens N]
+//
+// `--prompt-tokens` synthesizes the same deterministic low-band token walk as
+// the batched probe's `--prompt-tokens-0` (member 0), so a single-host run and
+// a two-host run prefill the same ids through the same session code. One
+// warmup prefill (default 4096 tokens, the chunk width) grows the GEMM tier's
+// arena before the timed repeats; every repeat prefills a fresh session, so
+// no repeat reuses another's prefix. With `--mtp-model` the session runs in
+// speculative mode and the prefill pays the draft block's catch-up, matching
+// the serving configuration.
+//
+// EXIT REASONS
+//   0  every repeat prefilled successfully
+//   1  model, session or prefill failure
+//   2  argument failure
+#include <algorithm>
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <limits>
+#include <memory>
+#include <span>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "src/core/session_mode.hpp"
+#include "src/models/qwen38_flash_next/engine.hpp"
+
+namespace q = gufo::models::qwen38_flash_next;
+
+namespace {
+
+/// The batched probe's synthetic-walk constants (member 0), so both probes
+/// prefill byte-identical token sequences from the same count.
+constexpr std::int32_t kSyntheticFirstToken = 1;
+constexpr std::size_t kSyntheticStride = 5;
+constexpr std::size_t kSyntheticSpan = 512;
+
+const std::chrono::steady_clock::time_point kProbeStart =
+    std::chrono::steady_clock::now();
+
+void Say(const std::string& line) {
+  const auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+                      std::chrono::steady_clock::now() - kProbeStart)
+                      .count();
+  std::printf("[prefill-probe t=%lldms] %s\n", static_cast<long long>(ms),
+              line.c_str());
+  std::fflush(stdout);
+}
+
+void Warn(const std::string& line) {
+  std::fprintf(stderr, "[prefill-probe] %s\n", line.c_str());
+  std::fflush(stderr);
+}
+
+/// Exactly `count` ids walked from kSyntheticFirstToken with
+/// kSyntheticStride across the first kSyntheticSpan ids of the vocabulary,
+/// stepping over stop ids: the batched probe's member-0 prompt.
+std::vector<std::int32_t> SyntheticPrompt(const q::Model& model,
+                                          std::size_t count) {
+  const std::size_t vocab = model.VocabSize();
+  if (vocab <= static_cast<std::size_t>(kSyntheticFirstToken)) {
+    return {};
+  }
+  const std::size_t span = std::min(kSyntheticSpan, vocab - 1);
+  std::vector<std::int32_t> tokens;
+  tokens.reserve(count);
+  for (std::size_t index = 0; index < count; ++index) {
+    std::size_t id = kSyntheticFirstToken + (index * kSyntheticStride) % span;
+    while (id + 1 < vocab && model.IsStopToken(static_cast<std::int32_t>(id))) {
+      ++id;
+    }
+    tokens.push_back(static_cast<std::int32_t>(id));
+  }
+  return tokens;
+}
+
+bool ParseSize(std::string_view text, std::size_t* value) {
+  if (text.empty()) {
+    return false;
+  }
+  std::size_t parsed = 0;
+  for (const char c : text) {
+    if (c < '0' || c > '9' ||
+        parsed > std::numeric_limits<std::size_t>::max() / 10) {
+      return false;
+    }
+    parsed = parsed * 10 + static_cast<std::size_t>(c - '0');
+  }
+  *value = parsed;
+  return true;
+}
+
+void Usage() {
+  std::puts(R"(Single-host prefill timing probe for Flash-Next.
+
+Usage:
+  qwen38_flash_next_prefill_probe --model FIRST_SHARD.gguf --prompt-tokens N
+                                  [--context N] [--repeat R]
+                                  [--mtp-model MTP.gguf] [--warmup-tokens N]
+
+Prefills the same synthetic token walk the two-host batched probe uses for
+member 0, through the same Session::Sync path, once per --repeat after one
+warmup prefill. Prints per-repeat prefill_ms and tokens/s.
+
+Options:
+  --model PATH         First GGUF shard, required; with --mtp-model the trunk
+                       of the pair, as serving loads it
+  --prompt-tokens N    Synthesize the prompt as exactly N token ids (required)
+  --context N          Session context (default 65536)
+  --repeat R           Timed fresh-session prefills (default 3)
+  --warmup-tokens N    Untimed warmup prompt length, 0 disables (default 4096)
+  --mtp-model PATH     MTP sidecar; the session runs speculative and prefill
+                       pays the draft block's catch-up
+
+Exit reasons:
+  0 the repeats prefilled successfully   1 failure   2 arguments)");
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+  std::string model_path;
+  std::string mtp_path;
+  std::size_t prompt_tokens = 0;
+  std::size_t context = 65536;
+  std::size_t repeat = 3;
+  std::size_t warmup_tokens = 4096;
+
+  for (int i = 1; i < argc; ++i) {
+    const std::string arg = argv[i];
+    const auto next = [&]() -> std::string {
+      return i + 1 < argc ? argv[++i] : std::string();
+    };
+    if (arg == "--help" || arg == "-h") {
+      Usage();
+      return 0;
+    } else if (arg == "--model") {
+      model_path = next();
+    } else if (arg == "--mtp-model") {
+      mtp_path = next();
+    } else if (arg == "--prompt-tokens") {
+      if (!ParseSize(next(), &prompt_tokens)) {
+        Warn("--prompt-tokens requires an unsigned token count");
+        return 2;
+      }
+    } else if (arg == "--context") {
+      if (!ParseSize(next(), &context) || context == 0) {
+        Warn("--context requires a nonzero unsigned integer");
+        return 2;
+      }
+    } else if (arg == "--repeat") {
+      if (!ParseSize(next(), &repeat) || repeat == 0) {
+        Warn("--repeat requires a nonzero unsigned integer");
+        return 2;
+      }
+    } else if (arg == "--warmup-tokens") {
+      if (!ParseSize(next(), &warmup_tokens)) {
+        Warn("--warmup-tokens requires an unsigned integer");
+        return 2;
+      }
+    } else {
+      Warn("unknown argument: " + arg);
+      return 2;
+    }
+  }
+
+  if (model_path.empty() || prompt_tokens == 0) {
+    Warn("--model and --prompt-tokens are required; see --help");
+    return 2;
+  }
+  if (prompt_tokens >= context) {
+    Warn("--prompt-tokens " + std::to_string(prompt_tokens) +
+         " must leave room inside --context " + std::to_string(context));
+    return 2;
+  }
+
+  q::ModelOptions options{
+      .max_context = static_cast<std::uint32_t>(context),
+      .mtp_model_path = mtp_path,
+      .max_draft_tokens = q::kMaxMtpDraftTokens,
+      .vision_model_path = "",
+      .decode_concurrency = 1,
+      .tp_rank = 0,
+      .tp_world_size = 1,
+      .hip_device = 0,
+      .communicator = nullptr,
+  };
+  std::string error;
+  auto model = q::Model::Load(model_path, options, &error);
+  if (!model) {
+    Warn("model load failed: " + error);
+    return 1;
+  }
+  if (!mtp_path.empty() && !model->HasMtp()) {
+    Warn("the model reports no MTP sidecar despite --mtp-model");
+    return 1;
+  }
+  const gufo::core::SessionMode mode =
+      mtp_path.empty() ? gufo::core::SessionMode::kAutoregressive
+                       : gufo::core::SessionMode::kSpeculative;
+  Say(std::string("model loaded, mtp=") + (mtp_path.empty() ? "off" : "on") +
+      ", prefill_capacity=" + std::to_string(model->PrefillCapacity()) +
+      " context=" + std::to_string(context));
+
+  if (warmup_tokens != 0 && warmup_tokens < context) {
+    auto session =
+        model->CreateSession(mode, static_cast<std::uint32_t>(context), &error);
+    if (!session ||
+        !session->Sync(SyntheticPrompt(*model, warmup_tokens), &error)) {
+      Warn("warmup prefill failed: " + error);
+      return 1;
+    }
+    Say("warmup complete: " + std::to_string(warmup_tokens) + " tokens");
+  }
+
+  const std::vector<std::int32_t> prompt =
+      SyntheticPrompt(*model, prompt_tokens);
+  if (prompt.size() != prompt_tokens) {
+    Warn("synthetic prompt came out empty; the vocabulary is unusable");
+    return 1;
+  }
+  for (std::size_t r = 0; r < repeat; ++r) {
+    auto session =
+        model->CreateSession(mode, static_cast<std::uint32_t>(context), &error);
+    if (!session) {
+      Warn("session creation failed: " + error);
+      return 1;
+    }
+    const auto start = std::chrono::steady_clock::now();
+    if (!session->Sync(prompt, &error)) {
+      Warn("repeat " + std::to_string(r) + " prefill failed: " + error);
+      return 1;
+    }
+    const double ms = std::chrono::duration<double, std::milli>(
+                          std::chrono::steady_clock::now() - start)
+                          .count();
+    char timing[160];
+    std::snprintf(timing, sizeof(timing),
+                  "repeat=%zu tokens=%zu prefill_ms=%.1f tokens_per_s=%.1f", r,
+                  prompt_tokens, ms,
+                  ms <= 0.0 ? 0.0 : prompt_tokens * 1000.0 / ms);
+    Say(timing);
+  }
+  return 0;
+}
