+
+    // Chunked-vs-tokenwise equality for the finalists: one launch of N
+    // tokens vs N sequential single-token launches (routing recomputed per
+    // token; each token's y slice zeroed before its launch). This is the
+    // executor's exec-513-style contract, at the kernel level.
+    {
+      for (const std::uint32_t tks : {96u, 128u, 384u, 513u, 1024u}) {
+      std::printf("\n-- chunked vs tokenwise equality (N=%u) --\n", tks);
+      std::vector<std::int32_t> ids(
+          ids2048.begin(),
+          ids2048.begin() + static_cast<std::ptrdiff_t>(tks) * kSlots);
+      HIPCK(hipMemcpyAsync(d_ids_full, ids.data(), ids.size() * 4,
+                           hipMemcpyHostToDevice, stream));
+      RunRouting(d_ids_full, d_bins, d_ranks, d_pairs, tks, stream);
+      struct Finalist {
+        const char* name;
+        KId kid;
+        std::uint32_t threads;
+        std::uint32_t grid_div;
+      } finalists[] = {
+          {"V0", KId::kV0, 512, 32},
+          {"S32-W32R1", KId::kS32_32_1, 1024, 32},
+          {"S16-W16R2", KId::kS16_16_2, 512, 32},
+          {"S16S4-W16R2", KId::kS16_4_16_2, 512, 32},
+      };
+      for (const Shape& s : shapes) {
+        const void* wt = (s.k == 1024) ? static_cast<const void*>(w_down)
+                                       : static_cast<const void*>(w_gate);
+        const std::size_t stride = (s.k == 1024) ? down_stride : gate_stride;
+        const float* xv = s.x_stride == 1 ? x_dense : x_shared;
+        const std::size_t ycount =
+            static_cast<std::size_t>(tks) * kSlots * s.m;
+        std::vector<float> ref_chunked;
+        std::vector<float> ref_tokenwise;
+        for (const Finalist& f : finalists) {
+          // Full-N routing BEFORE the chunked launch: the tokenwise loop of
+          // the previous finalist leaves single-token state in d_bins/d_pairs.
+          HIPCK(hipMemcpyAsync(d_ids_full, ids.data(), ids.size() * 4,
+                               hipMemcpyHostToDevice, stream));
+          RunRouting(d_ids_full, d_bins, d_ranks, d_pairs, tks, stream);
+          HIPCK(hipMemsetAsync(y, 0, ycount * 4, stream));
+          launch(f.kid, f.threads, dim3(s.m / f.grid_div, kExperts), wt, type,
+                 d_bins, d_pairs, xv, y, kSlots, stride, s.m, s.k, s.x_stride);
+          std::vector<float> chunked(ycount);
+          HIPCK(hipStreamSynchronize(stream));
+          HIPCK(hipMemcpy(chunked.data(), y, ycount * 4, hipMemcpyDeviceToHost));
+          HIPCK(hipMemsetAsync(y, 0, ycount * 4, stream));
+          for (std::uint32_t t = 0; t < tks; ++t) {
+            HIPCK(hipMemcpyAsync(
+                d_ids_full,
+                ids.data() + static_cast<std::ptrdiff_t>(t) * kSlots,
+                kSlots * 4, hipMemcpyHostToDevice, stream));
+            RunRoutingToken(d_ids_full, d_bins, d_ranks, d_pairs, t, stream);
+            launch(f.kid, f.threads, dim3(s.m / f.grid_div, kExperts), wt,
+                   type, d_bins, d_pairs, xv, y, kSlots, stride, s.m, s.k,
+                   s.x_stride);
+          }
+          std::vector<float> tokenwise(ycount);
+          HIPCK(hipStreamSynchronize(stream));
+          HIPCK(hipMemcpy(tokenwise.data(), y, ycount * 4,
+                          hipMemcpyDeviceToHost));
+          const int bad = CountDiff(chunked.data(), tokenwise.data(), ycount);
+          const int refc =
+              ref_chunked.empty()
+                  ? -1
+                  : CountDiff(chunked.data(), ref_chunked.data(), ycount);
+          const int reft =
+              ref_tokenwise.empty()
+                  ? -1
+                  : CountDiff(tokenwise.data(), ref_tokenwise.data(), ycount);
+          if (ref_chunked.empty()) {
+            ref_chunked = chunked;
+            ref_tokenwise = tokenwise;
+          }
+          std::printf(
+              "  %-20s %-12s N=%u self=%s (%d) vsref chunked=%d tokenwise=%d\n",
+              s.name, f.name, tks, bad ? "MISMATCH" : "identical", bad, refc,
+              reft);
+        }
+      }
+      }
+    }
+
+    HIPCK(hipFree(d_ids_full));
+    HIPCK(hipFree(d_ids1));
+    HIPCK(hipFree(d_bins));
+    HIPCK(hipFree(d_ranks));
+    HIPCK(hipFree(d_pairs));
+    HIPCK(hipFree(x_shared));
+    HIPCK(hipFree(x_dense));
+    HIPCK(hipFree(y));
+    HIPCK(hipFree(y_ref));
+  }
+  return 0;
+}
diff --git a/tools/bench/f32_ws_bench.hip b/tools/bench/f32_ws_bench.hip
new file mode 100644
index 00000000..1b1118b7
--- /dev/null
+++ b/tools/bench/f32_ws_bench.hip
@@ -0,0 +1,772 @@
+// F32 dense-projection weight-stationary prototype (goal
+// 2026-10-10 glm-prefill-250-vllm, phase 4).
+//
+// Reproduces BatchF32TiledKernel's real GLM-5.3-Flash per-rank shapes, then
+// sweeps restructured token-tile widths and accumulation widths against the
+// landed kernel:
+//
+//   V0    — verbatim copy of the landed kernel (kF32Tokens=8, kF32K=512,
+//           kF32Warps=16, kF32Rows=1): x staged in LDS per K-tile, per-token
+//           DOUBLE accumulation, so each 8-token tile re-streams the whole
+//           F32 table (128x per 1024-token chunk — 122 GB against a 0.96 GB
+//           table) and every FMA runs on the slow FP64 pipe.
+//   D-*   — weight-stationary double variants: wider token tiles (T=16/32,
+//           LDS [T][512] fits 64 KiB exactly at T=32 — the F32 staging needs
+//           no stride-33 padding, bank(e) = e % 32) and wider row blocks,
+//           cutting the weight re-read 2-4x while keeping V0's exact
+//           per-(row, token) arithmetic: lane run assignment, ascending
+//           visit order, statement sequence, single butterfly, double
+//           accumulation. Bit-identical to V0 by construction (checked,
+//           including the executor's chunked-vs-tokenwise pattern
+//           A(n=N) == V0(n=1 x N)). These isolate the traffic term: if they
+//           do not speed up, the family is not traffic-bound.
+//   F-*   — the same tile restructures with FLOAT accumulation (the
+//           pre-approved numerics relaxation): identical statement order in
+//           fp32. Deterministic and slot-independent, so the chunked and
+//           tokenwise twins stay byte-identical to each other by
+//           construction (checked); NOT bit-equal to V0 (expected — the
+//           max|diff|/rel RMS vs V0 is reported as the numerics evidence).
+//   GF16  — global-x control (no LDS) for the float family.
+//   PEAK  — v_fma_f64 / v_fma_f32 throughput microbenchmarks: the FP64
+//           pipe ceiling the double family measures against.
+//
+// Usage: f32_ws_bench [iters] [shape-idx] [tokens] [variant-filter]
+
+#define ENGINE_ENABLE_HIP 1
+
+#include <hip/hip_runtime.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+namespace {
+
+// ---------------------------------------------------------------------------
+// V0 — verbatim BatchF32TiledKernel (incl. the plain StageActivations, which
+// the F32 tile uses, inlined into the bench's namespace).
+
+constexpr std::uint32_t kF32Tokens = 8;
+constexpr std::uint32_t kF32K = 512;
+constexpr std::uint32_t kF32Warps = 16;
+constexpr std::uint32_t kF32Rows = 1;
+
+template <std::uint32_t Tokens, std::uint32_t K, std::uint32_t Warps>
+__device__ __forceinline__ void StageActivationsPlain(
+    float (&staged)[Tokens][K], const float* x, std::uint32_t k,
+    std::uint32_t base, std::uint32_t tile, std::uint32_t token_base,
+    std::uint32_t tokens, std::uint32_t tid) {
+  for (std::uint32_t flat = tid; flat < Tokens * K; flat += Warps * 32) {
+    const std::uint32_t t = flat / K;
+    if (t >= tokens) {
+      continue;
+    }
+    const std::uint32_t e = flat % K;
+    staged[t][e] =
+        e < tile ? x[static_cast<std::size_t>(token_base + t) * k + base + e]
+                 : 0.0F;
+  }
+}
+
+__global__ __launch_bounds__(kF32Warps * 32) void V0Kernel(
+    const float* w, const float* x, float* y, std::uint32_t m,
+    std::uint32_t k, std::uint32_t n) {
+  __shared__ float staged[kF32Tokens][kF32K];
+  const std::uint32_t lane = threadIdx.x & 31u;
+  const std::uint32_t warp = threadIdx.x >> 5u;
+  const std::uint32_t row0 = blockIdx.x * (kF32Warps * kF32Rows) + warp;
+  const std::uint32_t token_base = blockIdx.y * kF32Tokens;
+  const std::uint32_t tokens = min(kF32Tokens, n - token_base);
+  double sums[kF32Rows][kF32Tokens];
+#pragma unroll
+  for (std::uint32_t r = 0; r < kF32Rows; ++r) {
+#pragma unroll
+    for (std::uint32_t t = 0; t < kF32Tokens; ++t) {
+      sums[r][t] = 0.0;
+    }
+  }
+  for (std::uint32_t base = 0; base < k; base += kF32K) {
+    const std::uint32_t tile = min(kF32K, k - base);
+    StageActivationsPlain<kF32Tokens, kF32K, kF32Warps>(
+        staged, x, k, base, tile, token_base, tokens, threadIdx.x);
+    __syncthreads();
+#pragma unroll
+    for (std::uint32_t r = 0; r < kF32Rows; ++r) {
+      const std::uint32_t row = row0 + r * kF32Warps;
+      if (row >= m) {
+        break;
+      }
+      const float* src = w + static_cast<std::size_t>(row) * k;
+      for (std::uint32_t e = lane; e < tile; e += 32) {
+        const double weight = src[base + e];
+#pragma unroll
+        for (std::uint32_t t = 0; t < kF32Tokens; ++t) {
+          if (t < tokens) {
+            sums[r][t] += weight * static_cast<double>(staged[t][e]);
+          }
+        }
+      }
+    }
+    __syncthreads();
+  }
+#pragma unroll
+  for (std::uint32_t r = 0; r < kF32Rows; ++r) {
+    const std::uint32_t row = row0 + r * kF32Warps;
+    if (row >= m) {
+      break;
+    }
+#pragma unroll
+    for (std::uint32_t t = 0; t < kF32Tokens; ++t) {
+      if (t >= tokens) {
+        continue;
+      }
+      double sum = sums[r][t];
+      for (int off = 16; off > 0; off >>= 1) {
+        sum += __shfl_xor(sum, off);
+      }
+      if (lane == 0) {
+        y[static_cast<std::size_t>(token_base + t) * m + row] =
+            static_cast<float>(sum);
+      }
+    }
+  }
+}
+
+// ---------------------------------------------------------------------------
+// WS family — weight-stationary token/row tiles with a template accumulation
+// width. Structure is V0's: LDS-staged x per K-tile, one weight-element load
+// per (row, lane-run element) reused across the tile's tokens, guarded
+// per-token accumulation into sums[Rows][Tokens], single butterfly epilogue.
+// Lane run assignment (e = lane, lane+32, ...), ascending K visit order, the
+// per-(row, token) statement sequence and the butterfly are exactly V0's, so
+// the double instantiations are bit-identical to V0 and every instantiation
+// is byte-identical to its own n=1 twin regardless of T/W/R.
+
+template <std::uint32_t Tokens, std::uint32_t K, std::uint32_t Warps,
+          std::uint32_t Rows, bool kDouble, bool kVecStage, bool kGlobalX>
+__global__ __launch_bounds__(Warps * 32) void WsKernel(
+    const float* w, const float* x, float* y, std::uint32_t m,
+    std::uint32_t k, std::uint32_t n) {
+  using Acc = std::conditional_t<kDouble, double, float>;
+  __shared__ float staged[Tokens][K];
+  const std::uint32_t lane = threadIdx.x & 31u;
+  const std::uint32_t warp = threadIdx.x >> 5u;
+  const std::uint32_t row0 = blockIdx.x * (Warps * Rows) + warp;
+  const std::uint32_t token_base = blockIdx.y * Tokens;
+  const std::uint32_t tokens = min(Tokens, n - token_base);
+  Acc sums[Rows][Tokens];
+#pragma unroll
+  for (std::uint32_t r = 0; r < Rows; ++r) {
+#pragma unroll
+    for (std::uint32_t t = 0; t < Tokens; ++t) {
+      sums[r][t] = static_cast<Acc>(0);
+    }
+  }
+  for (std::uint32_t base = 0; base < k; base += K) {
+    const std::uint32_t tile = min(K, k - base);
+    if (!kGlobalX) {
+      if (kVecStage && k % 4 == 0) {
+        // float4 staging: a quarter of the load/store instructions, same
+        // values (rows past the live token count are never written — the
+        // consumers guard every dead slot, see StageActivationsPlain).
+#pragma unroll 1
+        for (std::uint32_t quad = threadIdx.x; quad < Tokens * (K / 4);
+             quad += Warps * 32) {
+          const std::uint32_t t = quad / (K / 4);
+          if (t >= tokens) {
+            continue;
+          }
+          const std::uint32_t e32 = (quad % (K / 4)) * 4;
+          float4 value = {0.0F, 0.0F, 0.0F, 0.0F};
+          if (e32 + 4 <= tile) {
+            value = *reinterpret_cast<const float4*>(
+                x + static_cast<std::size_t>(token_base + t) * k + base + e32);
+          } else if (e32 < tile) {
+            const float* src =
+                x + static_cast<std::size_t>(token_base + t) * k + base + e32;
+            value.x = e32 + 0 < tile ? src[0] : 0.0F;
+            value.y = e32 + 1 < tile ? src[1] : 0.0F;
+            value.z = e32 + 2 < tile ? src[2] : 0.0F;
+            value.w = e32 + 3 < tile ? src[3] : 0.0F;
+          }
+          float* dst = &staged[t][e32];
+          dst[0] = value.x;
+          dst[1] = value.y;
+          dst[2] = value.z;
+          dst[3] = value.w;
+        }
+      } else {
+        StageActivationsPlain<Tokens, K, Warps>(staged, x, k, base, tile,
+                                                token_base, tokens,
+                                                threadIdx.x);
+      }
+      __syncthreads();
+    }
+#pragma unroll
+    for (std::uint32_t r = 0; r < Rows; ++r) {
+      const std::uint32_t row = row0 + r * Warps;
+      if (row >= m) {
+        break;
+      }
+      const float* src = w + static_cast<std::size_t>(row) * k;
+      for (std::uint32_t e = lane; e < tile; e += 32) {
+        const Acc weight = static_cast<Acc>(src[base + e]);
+#pragma unroll
+        for (std::uint32_t t = 0; t < Tokens; ++t) {
+          if (t < tokens) {
+            const Acc value =
+                kGlobalX
+                    ? static_cast<Acc>(
+                          x[static_cast<std::size_t>(token_base + t) * k +
+                            base + e])
+                    : static_cast<Acc>(staged[t][e]);
+            sums[r][t] += weight * value;
+          }
+        }
+      }
+    }
+    if (!kGlobalX) {
+      __syncthreads();
+    }
+  }
+#pragma unroll
+  for (std::uint32_t r = 0; r < Rows; ++r) {
+    const std::uint32_t row = row0 + r * Warps;
+    if (row >= m) {
+      break;
+    }
+#pragma unroll
+    for (std::uint32_t t = 0; t < Tokens; ++t) {
+      if (t >= tokens) {
+        continue;
+      }
+      Acc sum = sums[r][t];
+      for (int off = 16; off > 0; off >>= 1) {
+        sum += __shfl_xor(sum, off);
+      }
+      if (lane == 0) {
+        y[static_cast<std::size_t>(token_base + t) * m + row] =
+            static_cast<float>(sum);
+      }
+    }
+  }
+}
+
+// ---------------------------------------------------------------------------
+// FMA throughput peaks: kAcc independent fully-pipelined accumulator chains
+// of loop-invariant operands, so the only work is the FMA issue rate itself.
+// The per-thread result is stored globally so every chain stays live.
+
+template <int kAcc, bool kDouble>
+__global__ __launch_bounds__(256) void FmaPeakKernel(float seed, float* out,
+                                                     std::uint32_t iters) {
+  using Acc = std::conditional_t<kDouble, double, float>;
+  Acc a[kAcc];
+  Acc b[kAcc];
+  Acc c[kAcc];
+#pragma unroll
+  for (int i = 0; i < kAcc; ++i) {
+    const float fi = seed + i * 1e-3F;
+    a[i] = static_cast<Acc>(fi);
+    b[i] = static_cast<Acc>(1.0F + fi * 1e-6F);
+    c[i] = static_cast<Acc>(fi);
+  }
+  for (std::uint32_t it = 0; it < iters; ++it) {
+#pragma unroll
+    for (int i = 0; i < kAcc; ++i) {
+      c[i] += a[i] * b[i];
+    }
+  }
+  Acc total = static_cast<Acc>(0);
+#pragma unroll
+  for (int i = 0; i < kAcc; ++i) {
+    total += c[i];
+  }
+  out[blockIdx.x * blockDim.x + threadIdx.x] = static_cast<float>(total);
+}
+
+// ---------------------------------------------------------------------------
+// Host harness.
+
+#define HIPCK(call)                                                 \
+  do {                                                              \
+    hipError_t err__ = (call);                                      \
+    if (err__ != hipSuccess) {                                      \
+      std::fprintf(stderr, "HIP error %s at %s:%d\n",               \
+                   hipGetErrorString(err__), __FILE__, __LINE__);  \
+      std::exit(1);                                                 \
+    }                                                               \
+  } while (0)
+
+// Real per-rank GLM-5.3-Flash F32 GEMM shapes (TP2: these tables are
+// replicated, not split). calls = launches per 1024-token chunk
+// (34 KDA + 11 DSA layers, 42 routed-MoE routers, 45 hc.fn).
+struct Shape {
+  const char* name;
+  std::uint32_t m;
+  std::uint32_t k;
+  std::uint32_t calls;
+};
+
+const std::vector<Shape>& Shapes() {
+  static const std::vector<Shape> s = {
+      {"ssm.a 128x4096", 128, 4096, 90},   // f_a/g_a (x34) + idx.k/comp_gate (x11)
+      {"ssm.b 8192x128", 8192, 128, 68},   // f_b/g_b (x34)
+      {"beta 64x4096", 64, 4096, 34},
+      {"kv_a 512x4096", 512, 4096, 11},
+      {"idx.q_b 4096x1536", 4096, 1536, 11},
+      {"router 288x4096", 288, 4096, 42},
+      {"idx.proj 32x4096", 32, 4096, 11},
+      {"hc.fn 24x16384", 24, 16384, 45},
+  };
+  return s;
+}
+
+enum class KId : std::uint32_t {
+  kV0,
+  kD16,
+  kD16R2,
+  kD32,
+  kD32R2,
+  kF8,
+  kF16R1,
+  kF16,
+  kF32R1,
+  kF32R2,
+  kF32R2W32,
+  kF32R2v,
+  kF64K256,
+  kGF16,
+};
+
+struct Variant {
+  const char* name;
+  KId kid;
+  std::uint32_t threads;
+  std::uint32_t rpb;    // rows per block (Warps * Rows)
+  std::uint32_t tokens; // token tile width T
+  bool is_float;
+};
+
+const std::vector<Variant>& Variants() {
+  static const std::vector<Variant> v = {
+      {"V0", KId::kV0, 512, 16, 8, false},
+      {"D16", KId::kD16, 512, 16, 16, false},
+      {"D16R2", KId::kD16R2, 1024, 64, 16, false},
+      {"D32", KId::kD32, 512, 16, 32, false},
+      {"D32R2", KId::kD32R2, 512, 32, 32, false},
+      {"F8", KId::kF8, 512, 16, 8, true},
+      {"F16R1", KId::kF16R1, 512, 16, 16, true},
+      {"F16", KId::kF16, 1024, 64, 16, true},
+      {"F32R1", KId::kF32R1, 1024, 32, 32, true},
+      {"F32R2", KId::kF32R2, 512, 32, 32, true},
+      {"F32R2W32", KId::kF32R2W32, 1024, 64, 32, true},
+      {"F32R2v", KId::kF32R2v, 512, 32, 32, true},
+      {"F64K256", KId::kF64K256, 1024, 32, 64, true},
+      {"GF16", KId::kGF16, 1024, 64, 16, true},
+  };
+  return v;
+}
+
+void Launch(KId kid, dim3 grid, std::uint32_t threads, const float* w,
+            const float* x, float* y, std::uint32_t m, std::uint32_t k,
+            std::uint32_t n, hipStream_t stream) {
+  switch (kid) {
+    case KId::kV0:
+      V0Kernel<<<grid, threads, 0, stream>>>(w, x, y, m, k, n);
+      break;
+    case KId::kD16:
+      WsKernel<16, 512, 16, 1, true, false, false>
+          <<<grid, threads, 0, stream>>>(w, x, y, m, k, n);
+      break;
+    case KId::kD16R2:
+      WsKernel<16, 512, 32, 2, true, false, false>
+          <<<grid, threads, 0, stream>>>(w, x, y, m, k, n);
+      break;
+    case KId::kD32:
+      WsKernel<32, 512, 16, 1, true, false, false>
+          <<<grid, threads, 0, stream>>>(w, x, y, m, k, n);
+      break;
+    case KId::kD32R2:
+      WsKernel<32, 512, 16, 2, true, false, false>
+          <<<grid, threads, 0, stream>>>(w, x, y, m, k, n);
+      break;
+    case KId::kF8:
+      WsKernel<8, 512, 16, 1, false, false, false>
+          <<<grid, threads, 0, stream>>>(w, x, y, m, k, n);
+      break;
+    case KId::kF16R1:
+      WsKernel<16, 512, 16, 1, false, false, false>
+          <<<grid, threads, 0, stream>>>(w, x, y, m, k, n);
+      break;
+    case KId::kF16:
+      WsKernel<16, 512, 32, 2, false, false, false>
+          <<<grid, threads, 0, stream>>>(w, x, y, m, k, n);
+      break;
+    case KId::kF32R1:
+      WsKernel<32, 512, 32, 1, false, false, false>
+          <<<grid, threads, 0, stream>>>(w, x, y, m, k, n);
+      break;
+    case KId::kF32R2:
+      WsKernel<32, 512, 16, 2, false, false, false>
+          <<<grid, threads, 0, stream>>>(w, x, y, m, k, n);
+      break;
+    case KId::kF32R2W32:
+      WsKernel<32, 512, 32, 2, false, false, false>
+          <<<grid, threads, 0, stream>>>(w, x, y, m, k, n);
+      break;
+    case KId::kF32R2v:
+      WsKernel<32, 512, 16, 2, false, true, false>
+          <<<grid, threads, 0, stream>>>(w, x, y, m, k, n);
+      break;
+    case KId::kF64K256:
+      WsKernel<64, 256, 32, 1, false, false, false>
+          <<<grid, threads, 0, stream>>>(w, x, y, m, k, n);
+      break;
+    case KId::kGF16:
+      WsKernel<16, 512, 32, 2, false, false, true>
+          <<<grid, threads, 0, stream>>>(w, x, y, m, k, n);
+      break;
+  }
+}
+
+template <typename T>
+T* Device(const std::vector<T>& host) {
+  T* ptr = nullptr;
+  HIPCK(hipMalloc(&ptr, host.size() * sizeof(T)));
+  HIPCK(hipMemcpy(ptr, host.data(), host.size() * sizeof(T),
+                  hipMemcpyHostToDevice));
+  return ptr;
+}
+
+std::vector<float> MakeWeights(std::uint32_t m, std::uint32_t k) {
+  std::vector<float> w(static_cast<std::size_t>(m) * k);
+  std::uint64_t rng = 0x9e3779b97f4a7c15ULL;
+  const auto next = [&]() {
+    rng ^= rng << 13;
+    rng ^= rng >> 7;
+    rng ^= rng << 17;
+    return static_cast<std::int32_t>(rng >> 40);
+  };
+  for (auto& v : w) {
+    v = static_cast<float>(next()) / 536870912.0F;  // [-1, 1)
+  }
+  return w;
+}
+
+int CountDiff(const float* a, const float* b, std::size_t n) {
+  int bad = 0;
+  for (std::size_t i = 0; i < n; ++i) {
+    if (std::memcmp(&a[i], &b[i], 4) != 0) {
+      if (bad < 3) {
+        std::printf("    diff at %zu: %a vs %a\n", i, a[i], b[i]);
+      }
+      ++bad;
+    }
+  }
+  return bad;
+}
+
+void DiffStats(const float* a, const float* b, std::size_t n, double* max_abs,
+               double* rel_rms) {
+  double maxd = 0.0;
+  double sum_sq = 0.0;
+  double sum_ref = 0.0;
+  for (std::size_t i = 0; i < n; ++i) {
+    const double d = static_cast<double>(a[i]) - static_cast<double>(b[i]);
+    const double ad = std::fabs(d);
+    if (ad > maxd) {
+      maxd = ad;
+    }
+    sum_sq += d * d;
+    sum_ref += static_cast<double>(b[i]) * static_cast<double>(b[i]);
+  }
+  *max_abs = maxd;
+  *rel_rms = std::sqrt(sum_sq / std::max<double>(sum_ref, 1e-30));
+}
+
+std::uint32_t g_iters = 5;
+
+double TimeMs(const Variant& v, dim3 grid, const float* w, const float* x,
+              float* y, std::uint32_t m, std::uint32_t k, std::uint32_t n,
+              hipStream_t stream) {
+  hipEvent_t start, stop;
+  HIPCK(hipEventCreate(&start));
+  HIPCK(hipEventCreate(&stop));
+  for (int i = 0; i < 2; ++i) {
+    Launch(v.kid, grid, v.threads, w, x, y, m, k, n, stream);
+  }
+  HIPCK(hipEventRecord(start, stream));
+  for (std::uint32_t i = 0; i < g_iters; ++i) {
+    Launch(v.kid, grid, v.threads, w, x, y, m, k, n, stream);
+  }
+  HIPCK(hipEventRecord(stop, stream));
+  HIPCK(hipEventSynchronize(stop));
+  float ms = 0.0F;
+  HIPCK(hipEventElapsedTime(&ms, start, stop));
+  HIPCK(hipEventDestroy(start));
+  HIPCK(hipEventDestroy(stop));
+  return ms / g_iters;
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+  setvbuf(stdout, nullptr, _IONBF, 0);
+  if (argc > 1) {
+    g_iters = static_cast<std::uint32_t>(std::atoi(argv[1]));
+  }
+  const int shape_filter = argc > 2 ? std::atoi(argv[2]) : -1;
+  const std::uint32_t n_filter =
+      argc > 3 ? static_cast<std::uint32_t>(std::atoi(argv[3])) : 0;
+  const char* vfilter = argc > 4 ? argv[4] : nullptr;
+  hipStream_t stream;
+  HIPCK(hipStreamCreate(&stream));
+
+  // ---- FMA peaks ----------------------------------------------------------
+  {
+    constexpr std::uint32_t kBlocks = 640;
+    constexpr std::uint32_t kThreads = 256;
+    constexpr std::uint32_t kIters = 20000;
+    constexpr int kAcc = 8;
+    float* out = nullptr;
+    HIPCK(hipMalloc(&out, static_cast<std::size_t>(kBlocks) * kThreads * 4));
+    const double flops =
+        static_cast<double>(kBlocks) * kThreads * kAcc * kIters * 2;
+    for (int d = 0; d < 2; ++d) {
+      hipEvent_t start, stop;
+      HIPCK(hipEventCreate(&start));
+      HIPCK(hipEventCreate(&stop));
+      for (int i = 0; i < 3; ++i) {
+        if (d == 0) {
+          FmaPeakKernel<kAcc, true><<<kBlocks, kThreads, 0, stream>>>(
+              0.123F, out, kIters);
+        } else {
+          FmaPeakKernel<kAcc, false><<<kBlocks, kThreads, 0, stream>>>(
+              0.123F, out, kIters);
+        }
+      }
+      HIPCK(hipEventRecord(start, stream));
+      for (int i = 0; i < 3; ++i) {
+        if (d == 0) {
+          FmaPeakKernel<kAcc, true><<<kBlocks, kThreads, 0, stream>>>(
+              0.123F, out, kIters);
+        } else {
+          FmaPeakKernel<kAcc, false><<<kBlocks, kThreads, 0, stream>>>(
+              0.123F, out, kIters);
+        }
+      }
+      HIPCK(hipEventRecord(stop, stream));
+      HIPCK(hipEventSynchronize(stop));
+      float ms = 0.0F;
+      HIPCK(hipEventElapsedTime(&ms, start, stop));
+      HIPCK(hipEventDestroy(start));
+      HIPCK(hipEventDestroy(stop));
+      std::printf("PEAK %s fma (chains of 8): %.1f GFLOP/s\n", d ? "f32" : "f64",
+                  flops * 3 / (ms / 1e3) / 1e9);
+    }
+    std::vector<float> peak_out(kBlocks * kThreads);
+    HIPCK(hipMemcpy(peak_out.data(), out, peak_out.size() * 4,
+                    hipMemcpyDeviceToHost));
+    for (float f : peak_out) {
+      if (!std::isfinite(f)) {
+        std::printf("PEAK OUTPUT NOT FINITE\n");
+        break;
+      }
+    }
+    HIPCK(hipFree(out));
+  }
+
+  constexpr std::uint32_t kMaxM = 8192;
+  constexpr std::uint32_t kMaxK = 16384;
+  constexpr std::uint32_t kMaxN = 2048;
+
+  std::vector<float> xh(static_cast<std::size_t>(kMaxN) * kMaxK);
+  {
+    std::uint64_t rng = 7;
+    for (auto& v : xh) {
+      rng ^= rng << 13;
+      rng ^= rng >> 7;
+      rng ^= rng << 17;
+      v = static_cast<float>(static_cast<std::int32_t>(rng >> 40)) /
+          536870912.0F;
+    }
+  }
+  float* x = Device(xh);
+  float* y = nullptr;
+  float* y_ref = nullptr;
+  HIPCK(hipMalloc(&y, static_cast<std::size_t>(kMaxN) * kMaxM * sizeof(float)));
+  HIPCK(hipMalloc(&y_ref,
+                  static_cast<std::size_t>(kMaxN) * kMaxM * sizeof(float)));
+
+  std::vector<double> family(Variants().size(), 0.0);
+  double calls_total = 0.0;
+
+  for (std::size_t si = 0; si < Shapes().size(); ++si) {
+    if (shape_filter >= 0 && static_cast<int>(si) != shape_filter) {
+      continue;
+    }
+    const Shape& s = Shapes()[si];
+    auto wh = MakeWeights(s.m, s.k);
+    const float* w = Device(wh);
+    std::printf("\n== %s, calls/chunk=%u ==\n", s.name, s.calls);
+
+    for (std::uint32_t n : {96u, 128u, 192u, 256u, 513u, 1024u, 2048u}) {
+      if (n_filter != 0 && n != n_filter) {
+        continue;
+      }
+      const std::size_t ycount = static_cast<std::size_t>(n) * s.m;
+      HIPCK(hipMemset(y_ref, 0xCD, ycount * 4));
+      Launch(KId::kV0, dim3((s.m + 15) / 16, (n + 7) / 8), 512, w, x, y_ref,
+             s.m, s.k, n, stream);
+      HIPCK(hipStreamSynchronize(stream));
+      std::printf("-- tokens %u --\n", n);
+      std::vector<float> hr(ycount);
+      HIPCK(hipMemcpy(hr.data(), y_ref, ycount * 4, hipMemcpyDeviceToHost));
+      std::vector<double> times;
+      std::vector<const char*> flags;
+      for (const Variant& v : Variants()) {
+        if (vfilter != nullptr && std::strstr(v.name, vfilter) == nullptr) {
+          times.push_back(-1.0);
+          flags.push_back("skip");
+          continue;
+        }
+        const dim3 grid((s.m + v.rpb - 1) / v.rpb,
+                        (n + v.tokens - 1) / v.tokens);
+        HIPCK(hipMemset(y, 0xCD, ycount * 4));
+        Launch(v.kid, grid, v.threads, w, x, y, s.m, s.k, n, stream);
+        HIPCK(hipStreamSynchronize(stream));
+        std::vector<float> hy(ycount);
+        HIPCK(hipMemcpy(hy.data(), y, ycount * 4, hipMemcpyDeviceToHost));
+        if (!v.is_float) {
+          flags.push_back(v.kid == KId::kV0
+                              ? ""
+                              : (CountDiff(hy.data(), hr.data(), ycount)
+                                     ? "(!DIFF)"
+                                     : "(ok)"));
+        } else {
+          double max_abs = 0.0;
+          double rel_rms = 0.0;
+          DiffStats(hy.data(), hr.data(), ycount, &max_abs, &rel_rms);
+          char buf[64];
+          std::snprintf(buf, sizeof(buf), "(f:%.1e/%.1e)", max_abs, rel_rms);
+          flags.push_back(strdup(buf));
+        }
+        times.push_back(TimeMs(v, grid, w, x, y, s.m, s.k, n, stream));
+        if (n == 1024) {
+          family[&v - Variants().data()] += times.back() * s.calls;
+        }
+      }
+      for (std::size_t i = 0; i < Variants().size(); ++i) {
+        if (times[i] < 0.0) {
+          continue;
+        }
+        std::printf("  %s=%.2f%s", Variants()[i].name, times[i], flags[i]);
+      }
+      std::printf("\n");
+    }
+    calls_total += s.calls;
+
+    // Executor twin pattern: variant(n=N) == same variant(n=1 x N) — the
+    // chunked-vs-tokenwise byte-equality contract, per accumulation family.
+    for (std::uint32_t n : {513u, 1024u}) {
+      for (const Variant& v : Variants()) {
+        if (vfilter != nullptr && std::strstr(v.name, vfilter) == nullptr) {
+          continue;
+        }
+        const std::size_t ycount = static_cast<std::size_t>(n) * s.m;
+        HIPCK(hipMemset(y_ref, 0xCD, ycount * 4));
+        for (std::uint32_t t = 0; t < n; ++t) {
+          Launch(v.kid, dim3((s.m + v.rpb - 1) / v.rpb, 1), v.threads, w,
+                 x + static_cast<std::size_t>(t) * s.k,
+                 y_ref + static_cast<std::size_t>(t) * s.m, s.m, s.k, 1,
+                 stream);
+        }
+        HIPCK(hipStreamSynchronize(stream));
+        std::vector<float> hr(ycount);
+        HIPCK(hipMemcpy(hr.data(), y_ref, ycount * 4, hipMemcpyDeviceToHost));
+        HIPCK(hipMemset(y, 0xCD, ycount * 4));
+        Launch(v.kid,
+               dim3((s.m + v.rpb - 1) / v.rpb, (n + v.tokens - 1) / v.tokens),
+               v.threads, w, x, y, s.m, s.k, n, stream);
+        HIPCK(hipStreamSynchronize(stream));
+        std::vector<float> hy(ycount);
+        HIPCK(hipMemcpy(hy.data(), y, ycount * 4, hipMemcpyDeviceToHost));
+        std::printf("  twin n=%u %s: %s\n", n, v.name,
+                    CountDiff(hy.data(), hr.data(), ycount) ? "(!DIFF)" : "(ok)");
+      }
+    }
+
+    // Cross-template dispatch twin: any D shape(n=N) == V0(n=1 x N) and any
+    // F shape(n=N) == F8(n=1 x N) — a size-based dispatch over template
+    // shapes keeps the byte-equality contract.
+    for (std::uint32_t n : {1024u}) {
+      const std::size_t ycount = static_cast<std::size_t>(n) * s.m;
+      for (int is_float = 0; is_float < 2; ++is_float) {
+        const Variant& ref = is_float ? Variants()[5] : Variants()[0];
+        HIPCK(hipMemset(y_ref, 0xCD, ycount * 4));
+        for (std::uint32_t t = 0; t < n; ++t) {
+          Launch(ref.kid, dim3((s.m + ref.rpb - 1) / ref.rpb, 1), ref.threads,
+                 w, x + static_cast<std::size_t>(t) * s.k,
+                 y_ref + static_cast<std::size_t>(t) * s.m, s.m, s.k, 1,
+                 stream);
+        }
+        HIPCK(hipStreamSynchronize(stream));
+        std::vector<float> hr(ycount);
+        HIPCK(hipMemcpy(hr.data(), y_ref, ycount * 4, hipMemcpyDeviceToHost));
+        for (const Variant& v : Variants()) {
+          if (v.is_float != (is_float != 0) ||
+              (vfilter != nullptr &&
+               std::strstr(v.name, vfilter) == nullptr)) {
+            continue;
+          }
+          HIPCK(hipMemset(y, 0xCD, ycount * 4));
+          Launch(v.kid,
+                 dim3((s.m + v.rpb - 1) / v.rpb, (n + v.tokens - 1) / v.tokens),
+                 v.threads, w, x, y, s.m, s.k, n, stream);
+          HIPCK(hipStreamSynchronize(stream));
+          std::vector<float> hy(ycount);
+          HIPCK(hipMemcpy(hy.data(), y, ycount * 4, hipMemcpyDeviceToHost));
+          std::printf("  xdispatch n=%u %s vs %s: %s\n", n, v.name, ref.name,
+                      CountDiff(hy.data(), hr.data(), ycount) ? "(!DIFF)"
+                                                              : "(ok)");
+        }
+      }
+    }
+
+    // Small-n dispatch crossover on this shape.
+    std::printf("-- small-n (ms/launch) --\n");
+    for (std::uint32_t n : {1u, 8u, 16u, 32u, 64u}) {
+      std::printf("  n=%-3u", n);
+      for (const Variant& v : Variants()) {
+        if (vfilter != nullptr && std::strstr(v.name, vfilter) == nullptr) {
+          continue;
+        }
+        const dim3 grid((s.m + v.rpb - 1) / v.rpb,
+                        (n + v.tokens - 1) / v.tokens);
+        std::printf(" %s=%.3f", v.name,
+                    TimeMs(v, grid, w, x, y, s.m, s.k, n, stream));
+      }
+      std::printf("\n");
+    }
+
+    HIPCK(hipFree(const_cast<float*>(w)));
+  }
+
+  std::printf("\n-- family model: sum over shapes of ms/call x calls, n=1024 "
+              "(%.0f calls/chunk, x2 chunks = 2048 tokens) --\n",
+              calls_total);
+  for (std::size_t i = 0; i < Variants().size(); ++i) {
+    if (family[i] > 0.0) {
+      std::printf("  %-10s %8.1f ms/chunk  -> %8.1f ms/2048 tokens (%.2fx "
+                  "vs V0)\n",
+                  Variants()[i].name, family[i], family[i] * 2,
+                  family[0] / family[i]);
+    }
+  }
+  return 0;
+}
diff --git a/tools/bench/host_commit_stall.hip b/tools/bench/host_commit_stall.hip
new file mode 100644
index 00000000..fb6eb54a
--- /dev/null
+++ b/tools/bench/host_commit_stall.hip
@@ -0,0 +1,148 @@
+// Does committing pinned host memory stall concurrent GPU work on gfx1151?
+// A "decode" thread launches short kernels and synchronizes in a loop while a
+// second thread commits segments as CommittedBackingPool grows (hipHostMalloc
+// coherent + memset), then frees them. Reports commit cost and step times.
+//
+//   nix develop -c tools/bench/build.sh host_commit_stall && /tmp/host_commit_stall
+#include <hip/hip_runtime.h>
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstring>
+#include <thread>
+#include <vector>
+
+#define CHECK(x)                                                          \
+  do {                                                                    \
+    hipError_t e = (x);                                                   \
+    if (e != hipSuccess) {                                                \
+      std::fprintf(stderr, "%s:%d %s\n", __FILE__, __LINE__,              \
+                   hipGetErrorString(e));                                 \
+      std::exit(1);                                                       \
+    }                                                                     \
+  } while (0)
+
+using Clock = std::chrono::steady_clock;
+static double Ms(Clock::time_point a, Clock::time_point b) {
+  return std::chrono::duration<double, std::milli>(b - a).count();
+}
+
+__global__ void Spin(float* out, int iterations) {
+  float x = threadIdx.x;
+  for (int i = 0; i < iterations; ++i)
+    x = x * 1.000001f + 0.5f;
+  out[blockIdx.x * blockDim.x + threadIdx.x] = x;
+}
+
+struct Sample {
+  Clock::time_point start, end;
+};
+
+int main(int argc, char** argv) {
+  const int iterations = argc > 1 ? std::atoi(argv[1]) : 200000;
+  float* out{};
+  CHECK(hipMalloc(&out, 256 * 256 * sizeof(float)));
+  hipStream_t stream;
+  CHECK(hipStreamCreateWithFlags(&stream, hipStreamNonBlocking));
+  // Warm up and report the kernel time.
+  for (int i = 0; i < 20; ++i)
+    Spin<<<256, 256, 0, stream>>>(out, iterations);
+  CHECK(hipStreamSynchronize(stream));
+
+  for (const std::size_t segment :
+       {std::size_t{64} << 20, std::size_t{256} << 20, std::size_t{1} << 30}) {
+    std::atomic<bool> stop{false};
+    std::vector<Sample> samples;
+    samples.reserve(200000);
+    std::thread decode([&] {
+      while (!stop.load()) {
+        const auto start = Clock::now();
+        // A decode step is many launches; four per sample keeps the lock
+        // contention visible.
+        for (int k = 0; k < 4; ++k)
+          Spin<<<256, 256, 0, stream>>>(out, iterations / 4);
+        CHECK(hipStreamSynchronize(stream));
+        samples.push_back({start, Clock::now()});
+      }
+    });
+    std::this_thread::sleep_for(std::chrono::milliseconds(300));
+    struct Event {
+      Clock::time_point start, allocated, touched, freed_start, freed;
+    };
+    std::vector<Event> events;
+    for (int round = 0; round < 8; ++round) {
+      Event e{};
+      void* data{};
+      e.start = Clock::now();
+      CHECK(hipHostMalloc(&data, segment, hipHostMallocCoherent));
+      e.allocated = Clock::now();
+      std::memset(data, 0, segment);
+      e.touched = Clock::now();
+      std::this_thread::sleep_for(std::chrono::milliseconds(150));
+      e.freed_start = Clock::now();
+      CHECK(hipHostFree(data));
+      e.freed = Clock::now();
+      events.push_back(e);
+      std::this_thread::sleep_for(std::chrono::milliseconds(150));
+    }
+    stop = true;
+    decode.join();
+    // Baseline: samples that overlap no allocation/free window.
+    auto overlaps = [&](const Sample& s, Clock::time_point a,
+                        Clock::time_point b) {
+      return s.start < b && s.end > a;
+    };
+    std::vector<double> quiet, during_alloc, during_touch, during_free;
+    for (const auto& s : samples) {
+      const double d = Ms(s.start, s.end);
+      bool any = false;
+      for (const auto& e : events) {
+        if (overlaps(s, e.start, e.allocated)) {
+          during_alloc.push_back(d);
+          any = true;
+        } else if (overlaps(s, e.allocated, e.touched)) {
+          during_touch.push_back(d);
+          any = true;
+        } else if (overlaps(s, e.freed_start, e.freed)) {
+          during_free.push_back(d);
+          any = true;
+        }
+      }
+      if (!any)
+        quiet.push_back(d);
+    }
+    auto stats = [](std::vector<double> v) {
+      if (v.empty())
+        return std::string("n=0");
+      std::sort(v.begin(), v.end());
+      char text[128];
+      std::snprintf(text, sizeof(text), "n=%zu p50=%.2f p99=%.2f max=%.2f",
+                    v.size(), v[v.size() / 2], v[v.size() * 99 / 100],
+                    v.back());
+      return std::string(text);
+    };
+    double alloc = 0, touch = 0, release = 0, alloc_max = 0, touch_max = 0;
+    for (const auto& e : events) {
+      alloc += Ms(e.start, e.allocated);
+      touch += Ms(e.allocated, e.touched);
+      release += Ms(e.freed_start, e.freed);
+      alloc_max = std::max(alloc_max, Ms(e.start, e.allocated));
+      touch_max = std::max(touch_max, Ms(e.allocated, e.touched));
+    }
+    const double n = events.size();
+    std::printf(
+        "segment=%zu MiB  hipHostMalloc mean=%.2f max=%.2f ms  memset "
+        "mean=%.2f max=%.2f ms  hipHostFree mean=%.2f ms\n",
+        segment >> 20, alloc / n, alloc_max, touch / n, touch_max,
+        release / n);
+    std::printf("  decode step quiet:        %s\n", stats(quiet).c_str());
+    std::printf("  decode step during alloc: %s\n",
+                stats(during_alloc).c_str());
+    std::printf("  decode step during memset:%s\n",
+                stats(during_touch).c_str());
+    std::printf("  decode step during free:  %s\n", stats(during_free).c_str());
+  }
+  return 0;
+}
diff --git a/tools/bench/quant_ws_bench.hip b/tools/bench/quant_ws_bench.hip
new file mode 100644
index 00000000..6013cfc2
--- /dev/null
+++ b/tools/bench/quant_ws_bench.hip
@@ -0,0 +1,1167 @@
+// Q8_0/sub16 dense-projection weight-stationary prototype (goal
+// 2026-10-10 glm-prefill-250-vllm, phase 3).
+//
+// Reproduces BatchQuantTiledKernel's shapes, then sweeps restructured
+// token-tile widths against it on real Q8_0/Q4_K geometry:
+//
+//   V0  — verbatim copy of the landed kernel (kQuantTokens=16, kQuantK=512,
+//         kQuantWarps=32, kQuantRows=2): x staged in padded LDS per K-tile,
+//         so each 16-token tile re-streams the whole weight table (64x per
+//         1024-token chunk — 262 GB against a 4.09 GB table).
+//   W-* — weight-stationary wide tiles: NO LDS. The 16-token LDS cap is what
+//         pins the tile width (T32 would need 66 KiB), so x is streamed
+//         straight from global — the block's row-warps re-read the same
+//         2 KiB x window through L2 (x L2 traffic ~ (m/rpb) x T x k, a
+//         quarter of the weight bytes it displaces at the swept shapes) —
+//         while sums[Rows][Tokens] register accumulators cover a T-wide
+//         token tile in ONE pass over the weights. Lane/run assignment,
+//         per-lane serial visit order, per-token statement sequence and the
+//         single end butterfly are exactly V0's, so every W variant is
+//         bit-identical to V0 by construction (checked, including the
+//         executor's chunked-vs-tokenwise pattern A(n=N) == V0(n=1 x N)).
+//
+// Usage: quant_ws_bench [iters] — prints per-(shape, width, variant) ms/call,
+// bit-equality flags, and the small-n dispatch crossover.
+
+#define ENGINE_ENABLE_HIP 1
+
+#include <hip/hip_runtime.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+#include "src/models/qwen/hip/quant_ops.hpp"
+
+namespace {
+
+// ---------------------------------------------------------------------------
+// V0 — verbatim BatchQuantTiledKernel (incl. StageActivationsPadded and the
+// consume/finish helpers, inlined to the bench's namespace).
+
+constexpr std::uint32_t kQuantTokens = 16;
+constexpr std::uint32_t kQuantK = 512;
+constexpr std::uint32_t kQuantWarps = 32;
+constexpr std::uint32_t kQuantRows = 2;
+
+template <std::uint32_t Tokens, std::uint32_t K, std::uint32_t Warps>
+__device__ __forceinline__ void StageActivationsPadded(
+    float* staged, std::uint32_t stride, const float* x, std::uint32_t k,
+    std::uint32_t base, std::uint32_t tile, std::uint32_t token_base,
+    std::uint32_t tokens, std::uint32_t tid) {
+  constexpr std::uint32_t kBlocks = K / 32;
+  if (k % 4 == 0) {
+#pragma unroll 1
+    for (std::uint32_t quad = tid; quad < Tokens * kBlocks * 8;
+         quad += Warps * 32) {
+      const std::uint32_t t = quad / (kBlocks * 8);
+      if (t >= tokens) {
+        continue;
+      }
+      const std::uint32_t e32 = (quad % (kBlocks * 8)) * 4;
+      float4 value = {0.0F, 0.0F, 0.0F, 0.0F};
+      if (e32 + 4 <= tile) {
+        value = *reinterpret_cast<const float4*>(
+            x + static_cast<std::size_t>(token_base + t) * k + base + e32);
+      } else if (e32 < tile) {
+        const float* src =
+            x + static_cast<std::size_t>(token_base + t) * k + base + e32;
+        value.x = e32 + 0 < tile ? src[0] : 0.0F;
+        value.y = e32 + 1 < tile ? src[1] : 0.0F;
+        value.z = e32 + 2 < tile ? src[2] : 0.0F;
+        value.w = e32 + 3 < tile ? src[3] : 0.0F;
+      }
+      float* dst =
+          staged + t * stride * kBlocks + (e32 / 32) * stride + (e32 % 32);
+      dst[0] = value.x;
+      dst[1] = value.y;
+      dst[2] = value.z;
+      dst[3] = value.w;
+    }
+    return;
+  }
+  for (std::uint32_t flat = tid; flat < Tokens * kBlocks * 32;
+       flat += Warps * 32) {
+    const std::uint32_t t = flat / (kBlocks * 32);
+    if (t >= tokens) {
+      continue;
+    }
+    const std::uint32_t e = flat % (kBlocks * 32);
+    staged[t * stride * kBlocks + (e / 32) * stride + (e % 32)] =
+        e < tile ? x[static_cast<std::size_t>(token_base + t) * k + base + e]
+                 : 0.0F;
+  }
+}
+
+__global__ __launch_bounds__(kQuantWarps * 32) void V0Kernel(
+    const void* w, std::uint32_t type, const float* x, float* y,
+    std::uint32_t m, std::uint32_t k, std::uint32_t n, std::size_t y_stride) {
+  constexpr std::uint32_t kBlockStride = 33;
+  constexpr std::uint32_t kBlocksPerTile = kQuantK / 32;
+  __shared__ float staged[kQuantTokens][kBlockStride * kBlocksPerTile];
+  const std::uint32_t lane = threadIdx.x & 31u;
+  const std::uint32_t warp = threadIdx.x >> 5u;
+  const std::uint32_t row0 = blockIdx.x * (kQuantWarps * kQuantRows) + warp;
+  const std::uint32_t token_base = blockIdx.y * kQuantTokens;
+  const std::uint32_t tokens = min(kQuantTokens, n - token_base);
+  const auto ggml_type = static_cast<gufo::core::GgmlType>(type);
+  const std::size_t qk = gufo::hip::QuantBlockQK(ggml_type);
+  const std::size_t block_bytes = gufo::hip::QuantBlockBytes(ggml_type);
+  const std::size_t row_bytes_stride = k / qk * block_bytes;
+  float sums[kQuantRows][kQuantTokens];
+#pragma unroll
+  for (std::uint32_t r = 0; r < kQuantRows; ++r) {
+#pragma unroll
+    for (std::uint32_t t = 0; t < kQuantTokens; ++t) {
+      sums[r][t] = 0.0F;
+    }
+  }
+  for (std::uint32_t base = 0; base < k; base += kQuantK) {
+    const std::uint32_t tile = min(kQuantK, k - base);
+    StageActivationsPadded<kQuantTokens, kQuantK, kQuantWarps>(
+        &staged[0][0], kBlockStride, x, k, base, tile, token_base, tokens,
+        threadIdx.x);
+    __syncthreads();
+    const std::uint32_t sub_base = base / 16;
+    const std::uint32_t subs_per_tile = (kQuantK / 32) * 2;
+#pragma unroll
+    for (std::uint32_t r = 0; r < kQuantRows; ++r) {
+      const std::uint32_t row = row0 + r * kQuantWarps;
+      if (row >= m) {
+        break;
+      }
+      const char* row_bytes = static_cast<const char*>(w) +
+                              static_cast<std::size_t>(row) * row_bytes_stride;
+      if (ggml_type == gufo::core::GgmlType::kQ8_0) {
+        const auto* row_blocks =
+            reinterpret_cast<const gufo::hip::Q8_0Block*>(row_bytes);
+        for (std::uint32_t sb = sub_base + lane;
+             sb < sub_base + subs_per_tile && sb * 16 < base + tile;
+             sb += 32) {
+          const gufo::hip::Q8_0Block& blk = row_blocks[sb >> 1];
+          const float d_w = __half2float(blk.d);
+          const std::uint32_t run = sb * 16 - base;
+          const std::uint32_t pad = (run >> 5) * kBlockStride + (run & 31);
+          float wqf[16];
+#pragma unroll
+          for (int j = 0; j < 16; ++j) {
+            wqf[j] = static_cast<float>(blk.qs[(sb & 1) * 16 + j]);
+          }
+#pragma unroll
+          for (std::uint32_t t = 0; t < kQuantTokens; ++t) {
+            if (t < tokens) {
+              const float* xv = staged[t] + pad;
+              float dot = 0.0F;
+#pragma unroll
+              for (int j = 0; j < 16; ++j) {
+                dot += wqf[j] * xv[j];
+              }
+              sums[r][t] += d_w * dot;
+            }
+          }
+        }
+      } else {
+        for (std::uint32_t sb = sub_base + lane;
+             sb < sub_base + subs_per_tile && sb * 16 < base + tile;
+             sb += 32) {
+          gufo::hip::QuantSub16 sub;
+          gufo::hip::DecodeQuantSub16(ggml_type, row_bytes, sb, sub);
+          const std::uint32_t run = sb * 16 - base;
+          const std::uint32_t pad = (run >> 5) * kBlockStride + (run & 31);
+          float qf[16];
+#pragma unroll
+          for (int j = 0; j < 16; ++j) {
+            qf[j] = static_cast<float>(sub.q[j]);
+          }
+#pragma unroll
+          for (std::uint32_t t = 0; t < kQuantTokens; ++t) {
+            if (t < tokens) {
+              float dot = 0.0F;
+              float xsum = 0.0F;
+              const float* xv = staged[t] + pad;
+#pragma unroll
+              for (int j = 0; j < 16; ++j) {
+                const float value = xv[j];
+                dot += qf[j] * value;
+                xsum += value;
+              }
+              sums[r][t] += (sub.scale * dot) - (sub.offset * xsum);
+            }
+          }
+        }
+      }
+    }
+    __syncthreads();
+  }
+#pragma unroll
+  for (std::uint32_t r = 0; r < kQuantRows; ++r) {
+    const std::uint32_t row = row0 + r * kQuantWarps;
+    if (row >= m) {
+      break;
+    }
+#pragma unroll
+    for (std::uint32_t t = 0; t < kQuantTokens; ++t) {
+      if (t >= tokens) {
+        continue;
+      }
+      float sum = sums[r][t];
+      for (int off = 16; off > 0; off >>= 1) {
+        sum += __shfl_xor(sum, off);
+      }
+      if (lane == 0) {
+        y[static_cast<std::size_t>(token_base + t) * y_stride + row] = sum;
+      }
+    }
+  }
+}
+
+// ---------------------------------------------------------------------------
+// W-family — weight-stationary wide token tiles. x streams from global
+// (float4 when k % 4 == 0; the Q8_0/sub16 run grids keep every 16-element
+// run inside one K-tile, so the vector loads never straddle the tail),
+// weights stream once per T-wide tile; per-(row, token) arithmetic, lane
+// run assignment, ascending visit order and the single butterfly are V0's.
+
+template <std::uint32_t Tokens, std::uint32_t Warps, std::uint32_t Rows,
+          bool kVec>
+__global__ __launch_bounds__(Warps * 32) void WsKernel(
+    const void* w, std::uint32_t type, const float* x, float* y,
+    std::uint32_t m, std::uint32_t k, std::uint32_t n, std::size_t y_stride) {
+  constexpr std::uint32_t kKTile = 512;
+  constexpr std::uint32_t kSubsPerTile = (kKTile / 32) * 2;
+  const std::uint32_t lane = threadIdx.x & 31u;
+  const std::uint32_t warp = threadIdx.x >> 5u;
+  const std::uint32_t row0 = blockIdx.x * (Warps * Rows) + warp;
+  const std::uint32_t token_base = blockIdx.y * Tokens;
+  const std::uint32_t tokens = min(Tokens, n - token_base);
+  const auto ggml_type = static_cast<gufo::core::GgmlType>(type);
+  const std::size_t qk = gufo::hip::QuantBlockQK(ggml_type);
+  const std::size_t block_bytes = gufo::hip::QuantBlockBytes(ggml_type);
+  const std::size_t row_bytes_stride = k / qk * block_bytes;
+  const bool vec_ok = kVec && k % 4 == 0;
+  float sums[Rows][Tokens];
+#pragma unroll
+  for (std::uint32_t r = 0; r < Rows; ++r) {
+#pragma unroll
+    for (std::uint32_t t = 0; t < Tokens; ++t) {
+      sums[r][t] = 0.0F;
+    }
+  }
+  for (std::uint32_t base = 0; base < k; base += kKTile) {
+    const std::uint32_t tile = min(kKTile, k - base);
+    const std::uint32_t sub_base = base / 16;
+#pragma unroll
+    for (std::uint32_t r = 0; r < Rows; ++r) {
+      const std::uint32_t row = row0 + r * Warps;
+      if (row >= m) {
+        break;
+      }
+      const char* row_bytes = static_cast<const char*>(w) +
+                              static_cast<std::size_t>(row) * row_bytes_stride;
+      if (ggml_type == gufo::core::GgmlType::kQ8_0) {
+        const auto* row_blocks =
+            reinterpret_cast<const gufo::hip::Q8_0Block*>(row_bytes);
+        for (std::uint32_t sb = sub_base + lane;
+             sb < sub_base + kSubsPerTile && sb * 16 < base + tile;
+             sb += 32) {
+          const gufo::hip::Q8_0Block& blk = row_blocks[sb >> 1];
+          const float d_w = __half2float(blk.d);
+          float wqf[16];
+#pragma unroll
+          for (int j = 0; j < 16; ++j) {
+            wqf[j] = static_cast<float>(blk.qs[(sb & 1) * 16 + j]);
+          }
+          const std::uint32_t xoff = sb * 16;
+#pragma unroll
+          for (std::uint32_t t = 0; t < Tokens; ++t) {
+            if (t < tokens) {
+              const float* src =
+                  x + static_cast<std::size_t>(token_base + t) * k + xoff;
+              float dot = 0.0F;
+              if (vec_ok) {
+                const float4* xv = reinterpret_cast<const float4*>(src);
+#pragma unroll
+                for (int q = 0; q < 4; ++q) {
+                  const float4 value = xv[q];
+                  dot += wqf[4 * q + 0] * value.x;
+                  dot += wqf[4 * q + 1] * value.y;
+                  dot += wqf[4 * q + 2] * value.z;
+                  dot += wqf[4 * q + 3] * value.w;
+                }
+              } else {
+#pragma unroll
+                for (int j = 0; j < 16; ++j) {
+                  dot += wqf[j] * src[j];
+                }
+              }
+              sums[r][t] += d_w * dot;
+            }
+          }
+        }
+      } else {
+        for (std::uint32_t sb = sub_base + lane;
+             sb < sub_base + kSubsPerTile && sb * 16 < base + tile;
+             sb += 32) {
+          gufo::hip::QuantSub16 sub;
+          gufo::hip::DecodeQuantSub16(ggml_type, row_bytes, sb, sub);
+          float qf[16];
+#pragma unroll
+          for (int j = 0; j < 16; ++j) {
+            qf[j] = static_cast<float>(sub.q[j]);
+          }
+          const std::uint32_t xoff = sb * 16;
+#pragma unroll
+          for (std::uint32_t t = 0; t < Tokens; ++t) {
+            if (t < tokens) {
+              float dot = 0.0F;
+              float xsum = 0.0F;
+              const float* src =
+                  x + static_cast<std::size_t>(token_base + t) * k + xoff;
+#pragma unroll
+              for (int j = 0; j < 16; ++j) {
+                const float value = src[j];
+                dot += qf[j] * value;
+                xsum += value;
+              }
+              sums[r][t] += (sub.scale * dot) - (sub.offset * xsum);
+            }
+          }
+        }
+      }
+    }
+  }
+#pragma unroll
+  for (std::uint32_t r = 0; r < Rows; ++r) {
+    const std::uint32_t row = row0 + r * Warps;
+    if (row >= m) {
+      break;
+    }
+#pragma unroll
+    for (std::uint32_t t = 0; t < Tokens; ++t) {
+      if (t >= tokens) {
+        continue;
+      }
+      float sum = sums[r][t];
+      for (int off = 16; off > 0; off >>= 1) {
+        sum += __shfl_xor(sum, off);
+      }
+      if (lane == 0) {
+        y[static_cast<std::size_t>(token_base + t) * y_stride + row] = sum;
+      }
+    }
+  }
+}
+
+
+// ---------------------------------------------------------------------------
+// L-family — LDS group staging with T-wide register accumulators. The block
+// owns a T-token tile (T > 16) and re-stages x in G-token LDS groups inside
+// every K-tile: weights are decoded once per (row, K-tile, group) and the
+// sums[Rows][Tokens] accumulators live in registers across the whole K
+// stream, so the weight table streams once per T tokens instead of once per
+// 16. Per-(row, token) arithmetic — lane run assignment, ascending visit
+// order, per-token statement sequence, single butterfly — is exactly V0's;
+// the group split only interleaves tokens, never reordering any token's own
+// contributions. Bit-identical to V0 by construction (checked, incl. the
+// V0(n=1) x N twin).
+
+template <std::uint32_t Tokens, std::uint32_t Group, std::uint32_t Warps,
+          std::uint32_t Rows>
+__global__ __launch_bounds__(Warps * 32) void LsKernel(
+    const void* w, std::uint32_t type, const float* x, float* y,
+    std::uint32_t m, std::uint32_t k, std::uint32_t n, std::size_t y_stride) {
+  constexpr std::uint32_t kKTile = 512;
+  constexpr std::uint32_t kBlockStride = 33;
+  constexpr std::uint32_t kBlocksPerTile = kKTile / 32;
+  constexpr std::uint32_t kSubsPerTile = (kKTile / 32) * 2;
+  constexpr std::uint32_t kGroups = Tokens / Group;
+  static_assert(Tokens % Group == 0, "token tile must tile into groups");
+  __shared__ float staged[Group][kBlockStride * kBlocksPerTile];
+  const std::uint32_t lane = threadIdx.x & 31u;
+  const std::uint32_t warp = threadIdx.x >> 5u;
+  const std::uint32_t row0 = blockIdx.x * (Warps * Rows) + warp;
+  const std::uint32_t token_base = blockIdx.y * Tokens;
+  const auto ggml_type = static_cast<gufo::core::GgmlType>(type);
+  const std::size_t qk = gufo::hip::QuantBlockQK(ggml_type);
+  const std::size_t block_bytes = gufo::hip::QuantBlockBytes(ggml_type);
+  const std::size_t row_bytes_stride = k / qk * block_bytes;
+  float sums[Rows][Tokens];
+#pragma unroll
+  for (std::uint32_t r = 0; r < Rows; ++r) {
+#pragma unroll
+    for (std::uint32_t t = 0; t < Tokens; ++t) {
+      sums[r][t] = 0.0F;
+    }
+  }
+  for (std::uint32_t base = 0; base < k; base += kKTile) {
+    const std::uint32_t tile = min(kKTile, k - base);
+    const std::uint32_t sub_base = base / 16;
+#pragma unroll
+    for (std::uint32_t g = 0; g < kGroups; ++g) {
+      const std::uint32_t gbase = token_base + g * Group;
+      const std::uint32_t gcount =
+          gbase + Group <= n ? Group : (n > gbase ? n - gbase : 0u);
+      StageActivationsPadded<Group, kKTile, Warps>(
+          &staged[0][0], kBlockStride, x, k, base, tile, gbase, gcount,
+          threadIdx.x);
+      __syncthreads();
+#pragma unroll
+      for (std::uint32_t r = 0; r < Rows; ++r) {
+        const std::uint32_t row = row0 + r * Warps;
+        if (row >= m) {
+          break;
+        }
+        const char* row_bytes =
+            static_cast<const char*>(w) +
+            static_cast<std::size_t>(row) * row_bytes_stride;
+        if (ggml_type == gufo::core::GgmlType::kQ8_0) {
+          const auto* row_blocks =
+              reinterpret_cast<const gufo::hip::Q8_0Block*>(row_bytes);
+          for (std::uint32_t sb = sub_base + lane;
+               sb < sub_base + kSubsPerTile && sb * 16 < base + tile;
+               sb += 32) {
+            const gufo::hip::Q8_0Block& blk = row_blocks[sb >> 1];
+            const float d_w = __half2float(blk.d);
+            const std::uint32_t run = sb * 16 - base;
+            const std::uint32_t pad =
+                (run >> 5) * kBlockStride + (run & 31);
+            float wqf[16];
+#pragma unroll
+            for (int j = 0; j < 16; ++j) {
+              wqf[j] = static_cast<float>(blk.qs[(sb & 1) * 16 + j]);
+            }
+#pragma unroll
+            for (std::uint32_t tt = 0; tt < Group; ++tt) {
+              if (tt < gcount) {
+                const float* xv = staged[tt] + pad;
+                float dot = 0.0F;
+#pragma unroll
+                for (int j = 0; j < 16; ++j) {
+                  dot += wqf[j] * xv[j];
+                }
+                sums[r][g * Group + tt] += d_w * dot;
+              }
+            }
+          }
+        } else {
+          for (std::uint32_t sb = sub_base + lane;
+               sb < sub_base + kSubsPerTile && sb * 16 < base + tile;
+               sb += 32) {
+            gufo::hip::QuantSub16 sub;
+            gufo::hip::DecodeQuantSub16(ggml_type, row_bytes, sb, sub);
+            const std::uint32_t run = sb * 16 - base;
+            const std::uint32_t pad =
+                (run >> 5) * kBlockStride + (run & 31);
+            float qf[16];
+#pragma unroll
+            for (int j = 0; j < 16; ++j) {
+              qf[j] = static_cast<float>(sub.q[j]);
+            }
+#pragma unroll
+            for (std::uint32_t tt = 0; tt < Group; ++tt) {
+              if (tt < gcount) {
+                float dot = 0.0F;
+                float xsum = 0.0F;
+                const float* xv = staged[tt] + pad;
+#pragma unroll
+                for (int j = 0; j < 16; ++j) {
+                  const float value = xv[j];
+                  dot += qf[j] * value;
+                  xsum += value;
+                }
+                sums[r][g * Group + tt] += (sub.scale * dot) - (sub.offset * xsum);
+              }
+            }
+          }
+        }
+      }
+      __syncthreads();
+    }
+  }
+#pragma unroll
+  for (std::uint32_t r = 0; r < Rows; ++r) {
+    const std::uint32_t row = row0 + r * Warps;
+    if (row >= m) {
+      break;
+    }
+#pragma unroll
+    for (std::uint32_t t = 0; t < Tokens; ++t) {
+      if (t >= n - token_base) {
+        continue;
+      }
+      float sum = sums[r][t];
+      for (int off = 16; off > 0; off >>= 1) {
+        sum += __shfl_xor(sum, off);
+      }
+      if (lane == 0) {
+        y[static_cast<std::size_t>(token_base + t) * y_stride + row] = sum;
+      }
+    }
+  }
+}
+
+
+// ---------------------------------------------------------------------------
+// Z-family — unpadded XOR-swizzled LDS staging. The stride-33 padding costs
+// 3%: [32][512] floats needs 66 KiB padded but EXACTLY 64 KiB (the gfx1151
+// cap) unpadded, so element e of the staged tile is stored at
+// phys(e) = (e & ~31) | ((e & 31) ^ (e >> 5)): the consumer's lane-L read of
+// its 16-element run (elements 16L..16L+15) hits banks
+// ((16*(L&1)+j) ^ (L>>1)) % 32 — 32 distinct banks at every j, conflict-free
+// with no padding, and the float4-grouped staging writes stay conflict-free
+// (each 32-element block's offsets are XOR-permuted within the block).
+// Values and per-(row, token) arithmetic are exactly V0's.
+
+template <std::uint32_t Tokens, std::uint32_t Warps, std::uint32_t Rows>
+__device__ __forceinline__ void StageActivationsSwizzled(
+    float* staged, const float* x, std::uint32_t k, std::uint32_t base,
+    std::uint32_t tile, std::uint32_t token_base, std::uint32_t tokens,
+    std::uint32_t tid) {
+  constexpr std::uint32_t kKTile = 512;
+  if (k % 4 == 0) {
+#pragma unroll 1
+    for (std::uint32_t quad = tid; quad < Tokens * (kKTile / 4);
+         quad += Warps * 32) {
+      const std::uint32_t t = quad / (kKTile / 4);
+      if (t >= tokens) {
+        continue;
+      }
+      const std::uint32_t e32 = (quad % (kKTile / 4)) * 4;
+      float4 value = {0.0F, 0.0F, 0.0F, 0.0F};
+      if (e32 + 4 <= tile) {
+        value = *reinterpret_cast<const float4*>(
+            x + static_cast<std::size_t>(token_base + t) * k + base + e32);
+      } else if (e32 < tile) {
+        const float* src =
+            x + static_cast<std::size_t>(token_base + t) * k + base + e32;
+        value.x = e32 + 0 < tile ? src[0] : 0.0F;
+        value.y = e32 + 1 < tile ? src[1] : 0.0F;
+        value.z = e32 + 2 < tile ? src[2] : 0.0F;
+        value.w = e32 + 3 < tile ? src[3] : 0.0F;
+      }
+      // Element e32+j lands at (e32 & ~31) | (((e32 & 31) + j) ^ (e32 >> 5)).
+      float* dst = staged + t * kKTile + (e32 & ~31u);
+      const std::uint32_t r0 = e32 & 31u;
+      const std::uint32_t q = e32 >> 5;
+      dst[(r0 + 0) ^ q] = value.x;
+      dst[(r0 + 1) ^ q] = value.y;
+      dst[(r0 + 2) ^ q] = value.z;
+      dst[(r0 + 3) ^ q] = value.w;
+    }
+    return;
+  }
+  for (std::uint32_t flat = tid; flat < Tokens * kKTile; flat += Warps * 32) {
+    const std::uint32_t t = flat / kKTile;
+    if (t >= tokens) {
+      continue;
+    }
+    const std::uint32_t e = flat % kKTile;
+    staged[t * kKTile + (e & ~31u) + (((e & 31u) ^ (e >> 5)) & 31u)] =
+        e < tile ? x[static_cast<std::size_t>(token_base + t) * k + base + e]
+                 : 0.0F;
+  }
+}
+
+template <std::uint32_t Tokens, std::uint32_t Warps, std::uint32_t Rows>
+__global__ __launch_bounds__(Warps * 32) void ZsKernel(
+    const void* w, std::uint32_t type, const float* x, float* y,
+    std::uint32_t m, std::uint32_t k, std::uint32_t n, std::size_t y_stride) {
+  constexpr std::uint32_t kKTile = 512;
+  constexpr std::uint32_t kSubsPerTile = (kKTile / 32) * 2;
+  __shared__ float staged[Tokens][kKTile];
+  const std::uint32_t lane = threadIdx.x & 31u;
+  const std::uint32_t warp = threadIdx.x >> 5u;
+  const std::uint32_t row0 = blockIdx.x * (Warps * Rows) + warp;
+  const std::uint32_t token_base = blockIdx.y * Tokens;
+  const std::uint32_t tokens = min(Tokens, n - token_base);
+  const auto ggml_type = static_cast<gufo::core::GgmlType>(type);
+  const std::size_t qk = gufo::hip::QuantBlockQK(ggml_type);
+  const std::size_t block_bytes = gufo::hip::QuantBlockBytes(ggml_type);
+  const std::size_t row_bytes_stride = k / qk * block_bytes;
+  // Run elements 16*lane .. +15 (tile-local): the swizzled column of
+  // element (r0 + j) is (r0 + j) ^ q with r0 = 16*(lane&1), q = lane>>1.
+  const std::uint32_t blk0 = (lane * 16u) & ~31u;
+  const std::uint32_t r0 = lane & 1u ? 16u : 0u;
+  const std::uint32_t q = lane >> 1;
+  float sums[Rows][Tokens];
+#pragma unroll
+  for (std::uint32_t r = 0; r < Rows; ++r) {
+#pragma unroll
+    for (std::uint32_t t = 0; t < Tokens; ++t) {
+      sums[r][t] = 0.0F;
+    }
+  }
+  for (std::uint32_t base = 0; base < k; base += kKTile) {
+    const std::uint32_t tile = min(kKTile, k - base);
+    const std::uint32_t sub_base = base / 16;
+    StageActivationsSwizzled<Tokens, Warps, Rows>(&staged[0][0], x, k, base,
+                                                  tile, token_base, tokens,
+                                                  threadIdx.x);
+    __syncthreads();
+#pragma unroll
+    for (std::uint32_t r = 0; r < Rows; ++r) {
+      const std::uint32_t row = row0 + r * Warps;
+      if (row >= m) {
+        break;
+      }
+      const char* row_bytes = static_cast<const char*>(w) +
+                              static_cast<std::size_t>(row) * row_bytes_stride;
+      if (ggml_type == gufo::core::GgmlType::kQ8_0) {
+        const auto* row_blocks =
+            reinterpret_cast<const gufo::hip::Q8_0Block*>(row_bytes);
+        for (std::uint32_t sb = sub_base + lane;
+             sb < sub_base + kSubsPerTile && sb * 16 < base + tile;
+             sb += 32) {
+          const gufo::hip::Q8_0Block& blk = row_blocks[sb >> 1];
+          const float d_w = __half2float(blk.d);
+          float wqf[16];
+#pragma unroll
+          for (int j = 0; j < 16; ++j) {
+            wqf[j] = static_cast<float>(blk.qs[(sb & 1) * 16 + j]);
+          }
+#pragma unroll
+          for (std::uint32_t t = 0; t < Tokens; ++t) {
+            if (t < tokens) {
+              const float* src = staged[t] + blk0;
+              float dot = 0.0F;
+#pragma unroll
+              for (int j = 0; j < 16; ++j) {
+                dot += wqf[j] * src[(r0 + j) ^ q];
+              }
+              sums[r][t] += d_w * dot;
+            }
+          }
+        }
+      } else {
+        for (std::uint32_t sb = sub_base + lane;
+             sb < sub_base + kSubsPerTile && sb * 16 < base + tile;
+             sb += 32) {
+          gufo::hip::QuantSub16 sub;
+          gufo::hip::DecodeQuantSub16(ggml_type, row_bytes, sb, sub);
+          float qf[16];
+#pragma unroll
+          for (int j = 0; j < 16; ++j) {
+            qf[j] = static_cast<float>(sub.q[j]);
+          }
+#pragma unroll
+          for (std::uint32_t t = 0; t < Tokens; ++t) {
+            if (t < tokens) {
+              float dot = 0.0F;
+              float xsum = 0.0F;
+              const float* src = staged[t] + blk0;
+#pragma unroll
+              for (int j = 0; j < 16; ++j) {
+                const float value = src[(r0 + j) ^ q];
+                dot += qf[j] * value;
+                xsum += value;
+              }
+              sums[r][t] += (sub.scale * dot) - (sub.offset * xsum);
+            }
+          }
+        }
+      }
+    }
+    __syncthreads();
+  }
+#pragma unroll
+  for (std::uint32_t r = 0; r < Rows; ++r) {
+    const std::uint32_t row = row0 + r * Warps;
+    if (row >= m) {
+      break;
+    }
+#pragma unroll
+    for (std::uint32_t t = 0; t < Tokens; ++t) {
+      if (t >= tokens) {
+        continue;
+      }
+      float sum = sums[r][t];
+      for (int off = 16; off > 0; off >>= 1) {
+        sum += __shfl_xor(sum, off);
+      }
+      if (lane == 0) {
+        y[static_cast<std::size_t>(token_base + t) * y_stride + row] = sum;
+      }
+    }
+  }
+}
