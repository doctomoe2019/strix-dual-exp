+constexpr std::uint32_t kTbstreamWireMagic = 0x47555453U;  // "GUTS"
+constexpr std::uint32_t kTbstreamWireVersion = 1;
+constexpr std::uint32_t kCollectiveMagic = 0x47554348U;  // "GUCH"
+constexpr std::uint32_t kCollectiveVersion = 5;
+constexpr std::uint32_t kReadyMagic = 0x47555244U;  // "GURD"
+// The same rotating windows the verbs transport uses: three, because the add
+// reading an overlapped exchange's partial may still be queued when the
+// exchange after the next one lands (see Communicator), and a queued
+// exchange's partial is staged while the previous one is in flight. A frame
+// starts with the writer's header; the partial follows at kDataOffset.
+constexpr std::size_t kWindowBytes = 32U << 20;
+constexpr std::size_t kWindows = 3;
+// Ring-depth-sized syscall granularity for the coalesced transport shape
+// (256 ring slots x 4 KiB). See GUFO_TBSTREAM_COALESCE.
+constexpr std::size_t kCoalesceBytes = 1U << 20;
+constexpr std::size_t kBufferBytes = kWindows * kWindowBytes;
+constexpr std::size_t kDataOffset = 64;
+// Overlapped exchanges started and not yet finished; each has its own
+// readiness event.
+constexpr std::size_t kStartedExchanges = 4;
+// Queued exchanges not yet complete; a forward queues one per layer.
+constexpr std::size_t kQueuedExchanges = 4096;
+// A GPU wait gives up well after the exchange thread's own timeout. The
+// 240 s budget mirrors the verbs transport's slow-peer tolerance: rank
+// skew from back-to-back model loads (observed ~68 s on the tenth
+// restart in a row) must not fail an exchange against a live peer.
+constexpr std::uint64_t kWaitSeconds = 240;
+// Flag words, a cache line apart: written by the GPU, by the host, and by a
+// GPU wait that timed out.
+constexpr std::size_t kReadyOffset = 0;
+constexpr std::size_t kArrivedOffset = 64;
+constexpr std::size_t kTimedOutOffset = 128;
+constexpr std::size_t kFlagBytes = 4096;
+// A slow-but-live peer (model-load skew, throttled storage) is waited
+// for, mirroring the verbs transport's 180 s exchange deadline; a dead
+// peer is detected at once through the bootstrap socket or the stream's
+// EOF/EPIPE, not by this deadline.
+constexpr auto kCollectiveTimeout = std::chrono::seconds(180);
+constexpr auto kReceiveSpinWindow = std::chrono::microseconds(500);
+// An exchange waits for a layer of GPU work, or a peer that is a layer behind:
+// spinning that long keeps the wake-up latency off every decode exchange.
+constexpr auto kExchangeSpinWindow = std::chrono::milliseconds(5);
+// Frames smaller than this stay f32 on the wire: decode-shaped exchanges are
+// latency-bound (bytes do not move the needle) and keep the exact path, so
+// quantization only ever applies to the bandwidth-bound prefill batches.
+constexpr std::size_t kQuantizeMinBytes = 256 * 1024;
