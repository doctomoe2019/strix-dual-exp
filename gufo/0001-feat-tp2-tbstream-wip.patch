+def assert_native(result, label):
+    text = result["text"]
+    leaked = [tag for tag in ("<tool_call>", "</tool_call>", "<function=", "<parameter",
+                              "<invoke", '{"name"', "<｜DSML｜") if tag in text]
+    assert not leaked, (label, "framing leaked into content", leaked, result)
+
