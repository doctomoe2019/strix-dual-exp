+        FakeBackend backend;
+        backend.tool_format = gufo::sampling::JsonConstraint::ToolFormat::kQwen;
+        backend.pieces = {std::string("<tool_call>\n<function=record>\n"
+                                      "<parameter=v>\n") +
+                          item.raw +
+                          "\n</parameter>\n</function>\n</tool_call>"};
+        const auto response =
