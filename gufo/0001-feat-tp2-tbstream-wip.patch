+bool TpResponseBroker::WaitForAdmission(std::uint64_t sequence,
+                                        std::string* error) {
+  // Rebuilding a constraint and initializing the sampler are bounded work;
+  // a verdict that never arrives within this window means the peer or the
+  // channel is in trouble, and the request must not schedule model work.
+  constexpr auto kAdmissionTimeout = std::chrono::seconds(30);
+  std::unique_lock<std::mutex> lock(impl_->mutex);
+  const auto found = impl_->pending.find(sequence);
+  if (found == impl_->pending.end()) {
+    SetError(error, "TP admission sequence is not registered");
+    return false;
+  }
+  if (!impl_->condition.wait_until(
+          lock, std::chrono::steady_clock::now() + kAdmissionTimeout, [&] {
+            return found->second->admitted || found->second->ready ||
+                   impl_->stopping || impl_->poisoned;
+          })) {
+    SetError(error, "TP admission verdict timed out for request " +
+                        std::to_string(sequence));
+    return false;
+  }
+  if (impl_->stopping || impl_->poisoned) {
+    SetError(error, impl_->failure);
+    return false;
+  }
+  if (found->second->ready) {
+    SetError(error, "TP final response arrived before an admission verdict");
+    return false;
+  }
+  SetError(error, found->second->admission_error);
+  return found->second->admission_error.empty();
+}
