index 00000000..2a020f7b
--- /dev/null
+++ b/src/models/glm5_next/distributed/tp_partition.cpp
@@ -0,0 +1,339 @@
+#include "src/models/glm5_next/distributed/tp_partition.hpp"
+
+#include <numeric>
+#include <string>
+#include <utility>
+
+#include "src/core/quant/ggml_dequant.hpp"
+
+namespace gufo::models::glm5_next::distributed {
+namespace {
+
+void SetError(std::string* error, std::string message) {
+  if (error != nullptr) {
+    *error = std::move(message);
+  }
+}
+
+/// Bytes of `elements` consecutive values of one row, or zero when the count
+/// is not a whole number of quantization blocks.
+std::size_t SpanBytes(core::GgmlType type, std::size_t elements) {
+  switch (type) {
+    case core::GgmlType::kF32:
+    case core::GgmlType::kI32:
+      return elements * 4;
+    case core::GgmlType::kF16:
+    case core::GgmlType::kBF16:
+      return elements * 2;
+    default:
+      return gufo::quant::QuantizedRowBytes(type, elements);
+  }
+}
+
+/// A column or element span must land on whole quantization blocks; a span
+/// that starts at zero always does (the tensor itself is valid), so only the
+/// count and a nonzero begin need checking.
+bool WholeBlocks(core::GgmlType type, std::uint64_t count,
+                 std::uint64_t begin) {
+  if (count == 0) {
+    return false;
+  }
+  if (begin != 0 && SpanBytes(type, static_cast<std::size_t>(begin)) == 0) {
+    return false;
+  }
+  return SpanBytes(type, static_cast<std::size_t>(count)) != 0;
+}
+
+struct Spanner {
+  const TpPartition& partition;
+  std::string* error;
+  bool ok{true};
+  /// World size one: every span is the whole tensor, however the walk
+  /// classifies it, so the single-rank loader uploads exactly like P2.
+  bool whole{false};
+
+  void Fail(const std::string& message) {
+    if (ok) {
+      SetError(error, message);
+    }
+    ok = false;
+  }
+
+  /// Whole tensor, replicated.
+  TensorSpan Full(const TensorRef& t) {
+    TensorSpan span;
+    span.kind = TensorSpanKind::kFull;
+    span.count = t.rows * t.experts;
+    span.local_bytes = t.SizeBytes();
+    return span;
+  }
+
+  /// Contiguous rows [begin, begin + count) of the tensor as one matrix.
+  TensorSpan Rows(const TensorRef& t, std::uint64_t begin,
+                  std::uint64_t count) {
+    if (whole) {
+      return Full(t);
+    }
+    TensorSpan span;
+    span.kind = TensorSpanKind::kRows;
+    span.begin = begin;
+    span.count = count;
+    if (begin + count > t.rows) {
+      Fail("row span is outside " + std::string(t.name));
+      return span;
+    }
+    span.local_bytes =
+        static_cast<std::size_t>(count) * t.RowBytes() * t.experts;
+    return span;
+  }
+
+  /// Rows [begin, begin + count) inside every stacked expert matrix.
+  TensorSpan ExpertRows(const TensorRef& t, std::uint64_t begin,
+                        std::uint64_t count) {
+    TensorSpan span = Rows(t, begin, count);
+    span.per_expert = true;
+    return span;
+  }
+
+  /// Columns [begin, begin + count) of every row, on whole quantization
+  /// blocks; `per_expert` additionally repeats inside every stacked matrix.
+  TensorSpan Columns(const TensorRef& t, std::uint64_t begin,
+                     std::uint64_t count, bool per_expert) {
+    if (whole) {
+      return Full(t);
+    }
+    TensorSpan span;
+    span.kind = TensorSpanKind::kColumns;
+    span.per_expert = per_expert;
+    span.begin = begin;
+    span.count = count;
+    if (begin + count > t.cols || !WholeBlocks(t.type, count, begin)) {
+      Fail("column span of " + std::string(t.name) +
+           " is outside the tensor or cuts a quantization block");
+      return span;
+    }
+    const std::size_t share_bytes =
+        SpanBytes(t.type, static_cast<std::size_t>(count));
+    span.local_bytes = share_bytes * t.rows * t.experts;
+    return span;
+  }
+
+  /// Elements [begin, begin + count) of a vector.
+  TensorSpan Elements(const TensorRef& t, std::uint64_t begin,
+                      std::uint64_t count) {
+    if (whole) {
+      return Full(t);
+    }
+    TensorSpan span;
+    span.kind = TensorSpanKind::kElements;
+    span.begin = begin;
+    span.count = count;
+    if (t.rows != 1 || t.experts != 1 || begin + count > t.cols ||
+        !WholeBlocks(t.type, count, begin)) {
+      Fail("element span of " + std::string(t.name) +
+           " is outside the vector or cuts a quantization block");
+      return span;
+    }
+    span.local_bytes = SpanBytes(t.type, static_cast<std::size_t>(count));
+    return span;
+  }
+
+  /// Whole stacked matrices [begin, begin + count) along ne[2].
+  TensorSpan Stack(const TensorRef& t, std::uint64_t begin,
+                   std::uint64_t count) {
+    if (whole) {
+      return Full(t);
+    }
+    TensorSpan span;
+    span.kind = TensorSpanKind::kStack;
+    span.begin = begin;
+    span.count = count;
+    if (begin + count > t.experts) {
+      Fail("stack span is outside " + std::string(t.name));
+      return span;
+    }
+    span.local_bytes = t.RowBytes() * t.rows * count;
+    return span;
+  }
+
+  void Add(std::vector<PlannedTensor>* plan, const TensorRef& t,
+           TensorSpan span) {
+    if (ok && !t.empty()) {
+      plan->push_back({&t, span});
+    }
+  }
+};
+
+void PlanLayer(Spanner& s, const LayerWeights& l, const Config& c,
+               std::vector<PlannedTensor>* plan) {
+  const TpPartition& p = s.partition;
+  const std::uint32_t ch_begin = p.KdaChannelBegin();
+  const std::uint32_t ch_count = p.KdaChannelCount();
+  const std::uint64_t qk = c.qk_nope_head_dim;
+  s.Add(plan, l.attn_norm, s.Full(l.attn_norm));
+  s.Add(plan, l.ffn_norm, s.Full(l.ffn_norm));
+  s.Add(plan, l.hc_attn.fn, s.Full(l.hc_attn.fn));
+  s.Add(plan, l.hc_attn.base, s.Full(l.hc_attn.base));
+  s.Add(plan, l.hc_attn.scale, s.Full(l.hc_attn.scale));
+  s.Add(plan, l.hc_ffn.fn, s.Full(l.hc_ffn.fn));
+  s.Add(plan, l.hc_ffn.base, s.Full(l.hc_ffn.base));
+  s.Add(plan, l.hc_ffn.scale, s.Full(l.hc_ffn.scale));
+  if (l.linear) {
+    // Head-major channel rows: q/k/v output rows, the convolutions' channel
+    // rows and the f_b/dt gate channels all follow the head split; the out
+    // projection reduces over this rank's channels.
+    s.Add(plan, l.kda.q, s.Rows(l.kda.q, ch_begin, ch_count));
+    s.Add(plan, l.kda.k, s.Rows(l.kda.k, ch_begin, ch_count));
+    s.Add(plan, l.kda.v, s.Rows(l.kda.v, ch_begin, ch_count));
+    s.Add(plan, l.kda.out, s.Columns(l.kda.out, ch_begin, ch_count, false));
+    s.Add(plan, l.kda.conv_q, s.Rows(l.kda.conv_q, ch_begin, ch_count));
+    s.Add(plan, l.kda.conv_k, s.Rows(l.kda.conv_k, ch_begin, ch_count));
+    s.Add(plan, l.kda.conv_v, s.Rows(l.kda.conv_v, ch_begin, ch_count));
+    s.Add(plan, l.kda.f_a, s.Full(l.kda.f_a));
+    s.Add(plan, l.kda.f_b, s.Rows(l.kda.f_b, ch_begin, ch_count));
+    s.Add(plan, l.kda.g_a, s.Full(l.kda.g_a));
+    s.Add(plan, l.kda.g_b, s.Rows(l.kda.g_b, ch_begin, ch_count));
+    s.Add(plan, l.kda.beta, s.Rows(l.kda.beta, p.head_begin, p.head_count));
+    s.Add(plan, l.kda.a, s.Elements(l.kda.a, p.head_begin, p.head_count));
+    s.Add(plan, l.kda.dt_bias, s.Elements(l.kda.dt_bias, ch_begin, ch_count));
+    s.Add(plan, l.kda.o_norm, s.Full(l.kda.o_norm));
+  } else {
+    s.Add(plan, l.dsa.q_a, s.Full(l.dsa.q_a));
+    s.Add(plan, l.dsa.q_a_norm, s.Full(l.dsa.q_a_norm));
+    s.Add(plan, l.dsa.q_b,
+          s.Rows(l.dsa.q_b, p.head_begin * qk, p.head_count * qk));
+    s.Add(plan, l.dsa.kv_a, s.Full(l.dsa.kv_a));
+    s.Add(plan, l.dsa.kv_a_norm, s.Full(l.dsa.kv_a_norm));
+    s.Add(plan, l.dsa.k_b, s.Stack(l.dsa.k_b, p.head_begin, p.head_count));
+    s.Add(plan, l.dsa.v_b, s.Stack(l.dsa.v_b, p.head_begin, p.head_count));
+    s.Add(plan, l.dsa.out,
+          s.Columns(l.dsa.out, p.head_begin * qk, p.head_count * qk, false));
+    s.Add(plan, l.indexer.q_b, s.Full(l.indexer.q_b));
+    s.Add(plan, l.indexer.k, s.Full(l.indexer.k));
+    s.Add(plan, l.indexer.k_norm, s.Full(l.indexer.k_norm));
+    s.Add(plan, l.indexer.k_norm_bias, s.Full(l.indexer.k_norm_bias));
+    s.Add(plan, l.indexer.proj, s.Full(l.indexer.proj));
+    s.Add(plan, l.indexer.comp_gate, s.Full(l.indexer.comp_gate));
+    s.Add(plan, l.indexer.comp_ape, s.Full(l.indexer.comp_ape));
+  }
+  if (l.dense_ffn) {
+    s.Add(plan, l.ffn_gate,
+          s.Rows(l.ffn_gate, p.dense_ff_begin, p.dense_ff_count));
+    s.Add(plan, l.ffn_up, s.Rows(l.ffn_up, p.dense_ff_begin, p.dense_ff_count));
+    s.Add(plan, l.ffn_down,
+          s.Columns(l.ffn_down, p.dense_ff_begin, p.dense_ff_count, false));
+    return;
+  }
+  s.Add(plan, l.router, s.Full(l.router));
+  s.Add(plan, l.router_bias, s.Full(l.router_bias));
+  s.Add(plan, l.gate_exps,
+        s.ExpertRows(l.gate_exps, p.expert_ff_begin, p.expert_ff_count));
+  s.Add(plan, l.up_exps,
+        s.ExpertRows(l.up_exps, p.expert_ff_begin, p.expert_ff_count));
+  s.Add(plan, l.down_exps,
+        s.Columns(l.down_exps, p.expert_ff_begin, p.expert_ff_count, true));
+  s.Add(plan, l.gate_shexp,
+        s.Rows(l.gate_shexp, p.shared_ff_begin, p.shared_ff_count));
+  s.Add(plan, l.up_shexp,
+        s.Rows(l.up_shexp, p.shared_ff_begin, p.shared_ff_count));
+  s.Add(plan, l.down_shexp,
+        s.Columns(l.down_shexp, p.shared_ff_begin, p.shared_ff_count, false));
+}
+
+}  // namespace
+
+bool TpPartition::Valid() const noexcept {
+  if (world_size == 0 || rank >= world_size || heads == 0 ||
+      kda_head_dim == 0 || dense_ffn == 0 || shared_ffn == 0 ||
+      expert_ffn == 0) {
+    return false;
+  }
+  if (heads % world_size != 0 || dense_ffn % world_size != 0 ||
+      shared_ffn % world_size != 0 || expert_ffn % world_size != 0) {
+    return false;
+  }
+  return head_count == heads / world_size && head_begin == head_count * rank &&
+         dense_ff_count == dense_ffn / world_size &&
+         dense_ff_begin == dense_ff_count * rank &&
+         shared_ff_count == shared_ffn / world_size &&
+         shared_ff_begin == shared_ff_count * rank &&
+         expert_ff_count == expert_ffn / world_size &&
+         expert_ff_begin == expert_ff_count * rank;
+}
+
+std::optional<TpPartition> TpPartition::Create(const Config& config,
+                                               std::uint32_t rank,
+                                               std::uint32_t world_size,
+                                               std::string* error_msg) {
+  if (error_msg != nullptr) {
+    error_msg->clear();
+  }
+  if (world_size != 1 && world_size != 2) {
+    SetError(error_msg, "GLM TP partition supports world size 1 or 2");
+    return std::nullopt;
+  }
+  if (config.head_count == 0 || config.head_count % world_size != 0 ||
+      config.dense_ffn % world_size != 0 ||
+      config.expert_ffn % world_size != 0 ||
+      config.shared_experts * config.expert_ffn % world_size != 0) {
+    SetError(error_msg, "GLM TP partition needs even head and width splits");
+    return std::nullopt;
+  }
+  TpPartition p;
+  p.rank = rank;
+  p.world_size = world_size;
+  p.heads = config.head_count;
+  p.kda_head_dim = config.kda_head_dim;
+  p.dense_ffn = config.dense_ffn;
+  p.shared_ffn = config.expert_ffn * config.shared_experts;
+  p.expert_ffn = config.expert_ffn;
+  const auto half = [&](std::uint32_t full, std::uint32_t* begin,
+                        std::uint32_t* count) {
+    *count = full / world_size;
+    *begin = *count * rank;
+  };
+  half(config.head_count, &p.head_begin, &p.head_count);
+  half(config.dense_ffn, &p.dense_ff_begin, &p.dense_ff_count);
+  half(p.shared_ffn, &p.shared_ff_begin, &p.shared_ff_count);
+  half(config.expert_ffn, &p.expert_ff_begin, &p.expert_ff_count);
+  if (!p.Valid()) {
+    SetError(error_msg, "GLM TP partition geometry is inconsistent");
+    return std::nullopt;
+  }
+  return p;
+}
+
+std::optional<std::vector<PlannedTensor>> PlanModelTensors(
+    const ModelWeights& weights, const TpPartition& partition,
+    std::string* error) {
+  if (error != nullptr) {
+    error->clear();
+  }
+  if (!partition.Valid()) {
+    SetError(error, "TP tensor plan needs a valid partition");
+    return std::nullopt;
+  }
+  const Config& c = weights.config;
+  if (partition.heads != c.head_count ||
+      partition.kda_head_dim != c.kda_head_dim ||
+      partition.dense_ffn != c.dense_ffn ||
+      partition.expert_ffn != c.expert_ffn) {
+    SetError(error, "TP tensor plan geometry does not match the model");
+    return std::nullopt;
+  }
+  std::vector<PlannedTensor> plan;
+  plan.reserve(16 + weights.layers.size() * 32);
+  Spanner s{partition, error, true, !partition.distributed()};
+  s.Add(&plan, weights.token_embd, s.Full(weights.token_embd));
+  s.Add(&plan, weights.output, s.Full(weights.output));
+  s.Add(&plan, weights.output_norm, s.Full(weights.output_norm));
+  for (const auto& l : weights.layers) {
+    PlanLayer(s, l, c, &plan);
+    if (!s.ok) {
+      return std::nullopt;
+    }
+  }
+  return plan;
+}
+
+}  // namespace gufo::models::glm5_next::distributed
