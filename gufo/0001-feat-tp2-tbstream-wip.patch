+void CheckRange(Rows first, Rows end, std::size_t bytes) {
+  if (first > end ||
+      end > std::numeric_limits<std::size_t>::max() / sizeof(Token) ||
+      (end - first) * sizeof(Token) != bytes)
+    throw std::invalid_argument("invalid row range or buffer size");
