+std::string SystemError(const char* operation) {
+  return std::string(operation) + ": " + std::strerror(errno);
+}
+
+/// A blocking-exchange failure the reader thread reports to waiters without
+/// taking the communicator lock: the reason is a static string, so a waiter
+/// holding the lock in the synchronous exchange path can still name it.
+enum class ReaderFailure : std::uintptr_t {
+  kPeerLost = 1,
+  kStreamRead = 2,
+  kStreamClosed = 3,
+  kHeader = 4,
+  kTimeout = 5,
+};
+
+const char* ReaderFailureText(void* failure) {
+  switch (
+      static_cast<ReaderFailure>(reinterpret_cast<std::uintptr_t>(failure))) {
+    case ReaderFailure::kPeerLost:
+      return "tbstream peer closed the bootstrap connection";
+    case ReaderFailure::kStreamRead:
+      return "tbstream device read failed";
+    case ReaderFailure::kStreamClosed:
+      return "tbstream device returned end of stream";
+    case ReaderFailure::kHeader:
+      return "tbstream collective identity or size mismatch";
+    case ReaderFailure::kTimeout:
+      return "tbstream timed out waiting for the peer's frame";
+  }
+  return "tbstream reader failed";
+}
+
+class Socket {
+public:
+  Socket() = default;
+  explicit Socket(int fd) : fd_(fd) {}
+  Socket(const Socket&) = delete;
+  Socket& operator=(const Socket&) = delete;
+  Socket(Socket&& other) noexcept : fd_(std::exchange(other.fd_, -1)) {}
+  Socket& operator=(Socket&& other) noexcept {
+    if (this != &other) {
+      Close();
+      fd_ = std::exchange(other.fd_, -1);
+    }
+    return *this;
+  }
+  ~Socket() { Close(); }
+
+  [[nodiscard]] bool valid() const noexcept { return fd_ >= 0; }
+  [[nodiscard]] int fd() const noexcept { return fd_; }
+
+  void Close() noexcept {
+    if (fd_ >= 0) {
+      ::close(fd_);
+      fd_ = -1;
+    }
+  }
+
+  [[nodiscard]] static Socket Listen(const std::string& host,
+                                     std::uint16_t port, std::string* error) {
+    struct addrinfo hints{};
+    hints.ai_family = AF_INET;
+    hints.ai_socktype = SOCK_STREAM;
+    hints.ai_flags = AI_PASSIVE;
+    const std::string service = std::to_string(port);
+    struct addrinfo* addresses = nullptr;
+    const int result = ::getaddrinfo(host.empty() ? nullptr : host.c_str(),
+                                     service.c_str(), &hints, &addresses);
+    if (result != 0) {
+      SetError(error,
+               "bootstrap getaddrinfo: " + std::string(::gai_strerror(result)));
+      return {};
+    }
+    int fd = -1;
+    for (auto* address = addresses; address != nullptr;
+         address = address->ai_next) {
+      fd = ::socket(address->ai_family, address->ai_socktype,
+                    address->ai_protocol);
+      if (fd < 0) {
+        continue;
+      }
+      int reuse = 1;
+      (void)::setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &reuse, sizeof(reuse));
+      if (::bind(fd, address->ai_addr, address->ai_addrlen) == 0 &&
+          ::listen(fd, 1) == 0) {
+        break;
+      }
+      ::close(fd);
+      fd = -1;
+    }
+    ::freeaddrinfo(addresses);
+    if (fd < 0) {
+      SetError(error, SystemError("bootstrap listen"));
+      return {};
+    }
+    SetTimeouts(fd);
+    pollfd poll_fd{.fd = fd, .events = POLLIN, .revents = 0};
+    const int poll_result = ::poll(&poll_fd, 1, 30000);
+    if (poll_result <= 0) {
+      SetError(error, poll_result == 0 ? "bootstrap accept timed out"
+                                       : SystemError("bootstrap poll"));
+      ::close(fd);
+      return {};
+    }
+    int peer = -1;
+    do {
+      peer = ::accept(fd, nullptr, nullptr);
+    } while (peer < 0 && errno == EINTR);
+    if (peer < 0) {
+      SetError(error, SystemError("bootstrap accept"));
+      ::close(fd);
+      return {};
+    }
+    Socket listener(fd);
+    SetTimeouts(peer);
+    return Socket(peer);
+  }
+
+  [[nodiscard]] static Socket Connect(const std::string& host,
+                                      std::uint16_t port, std::string* error) {
+    if (host.empty()) {
+      SetError(error, "rank one requires a bootstrap host");
+      return {};
+    }
+    const auto deadline = std::chrono::steady_clock::now() + kCollectiveTimeout;
+    for (;;) {
+      struct addrinfo hints{};
+      hints.ai_family = AF_INET;
+      hints.ai_socktype = SOCK_STREAM;
+      const std::string service = std::to_string(port);
+      struct addrinfo* addresses = nullptr;
+      const int result =
+          ::getaddrinfo(host.c_str(), service.c_str(), &hints, &addresses);
+      if (result != 0) {
+        SetError(error, "bootstrap getaddrinfo: " +
+                            std::string(::gai_strerror(result)));
+        return {};
+      }
+      int fd = -1;
+      for (auto* address = addresses; address != nullptr;
+           address = address->ai_next) {
+        fd = ::socket(address->ai_family, address->ai_socktype,
+                      address->ai_protocol);
+        if (fd < 0) {
+          continue;
+        }
+        const int flags = ::fcntl(fd, F_GETFL, 0);
+        if (flags < 0 || ::fcntl(fd, F_SETFL, flags | O_NONBLOCK) != 0) {
+          ::close(fd);
+          fd = -1;
+          continue;
+        }
+        bool connected =
+            ::connect(fd, address->ai_addr, address->ai_addrlen) == 0;
+        if (!connected && errno == EINPROGRESS) {
+          pollfd poll_fd{.fd = fd, .events = POLLOUT, .revents = 0};
+          const int poll_result = ::poll(&poll_fd, 1, 1000);
+          int socket_error = 0;
+          socklen_t error_size = sizeof(socket_error);
+          connected = poll_result > 0 &&
+                      ::getsockopt(fd, SOL_SOCKET, SO_ERROR, &socket_error,
+                                   &error_size) == 0 &&
+                      socket_error == 0;
+        }
+        if (connected) {
+          if (::fcntl(fd, F_SETFL, flags) != 0) {
+            ::close(fd);
+            fd = -1;
+            continue;
+          }
+          break;
+        }
+        ::close(fd);
+        fd = -1;
+      }
+      ::freeaddrinfo(addresses);
+      if (fd >= 0) {
+        SetTimeouts(fd);
+        return Socket(fd);
+      }
+      if (std::chrono::steady_clock::now() >= deadline) {
+        SetError(error, SystemError("bootstrap connect"));
+        return {};
+      }
+      std::this_thread::sleep_for(std::chrono::milliseconds(100));
+    }
+  }
+
+  [[nodiscard]] bool SendAll(const void* data, std::size_t bytes,
+                             std::string* error) const {
+    const auto* cursor = static_cast<const std::uint8_t*>(data);
+    std::size_t sent = 0;
+    while (sent < bytes) {
+      const ssize_t n = ::send(fd_, cursor + sent, bytes - sent, MSG_NOSIGNAL);
+      if (n < 0 && errno == EINTR) {
+        continue;
+      }
+      if (n <= 0) {
+        SetError(error, SystemError("bootstrap send"));
+        return false;
+      }
+      sent += static_cast<std::size_t>(n);
+    }
+    return true;
+  }
+
+  [[nodiscard]] bool RecvAll(void* data, std::size_t bytes,
+                             std::string* error) const {
+    auto* cursor = static_cast<std::uint8_t*>(data);
+    std::size_t received = 0;
+    // A collective peer usually answers within a few hundred microseconds.
+    // Polling that long avoids the scheduler wake-up a blocking receive pays
+    // on every exchange; a slower peer falls back to the blocking receive.
+    const auto spin_deadline =
+        std::chrono::steady_clock::now() + kReceiveSpinWindow;
+    while (received < bytes) {
+      const bool spinning = std::chrono::steady_clock::now() < spin_deadline;
+      const ssize_t n = ::recv(fd_, cursor + received, bytes - received,
+                               spinning ? MSG_DONTWAIT : 0);
+      if (n < 0 && spinning && (errno == EAGAIN || errno == EWOULDBLOCK)) {
+        continue;
+      }
+      if (n < 0 && errno == EINTR) {
+        continue;
+      }
+      if (n <= 0) {
+        SetError(error, SystemError("bootstrap receive"));
+        return false;
+      }
+      received += static_cast<std::size_t>(n);
+    }
+    return true;
+  }
+
+private:
+  static void SetTimeouts(int fd) noexcept {
+    struct timeval timeout{};
+    timeout.tv_sec = 30;
+    timeout.tv_usec = 0;
+    (void)::setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout));
+    (void)::setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &timeout, sizeof(timeout));
+    const int no_delay = 1;
+    (void)::setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, &no_delay,
+                       sizeof(no_delay));
+  }
+
+  int fd_{-1};
+};
+
+struct Wire {
+  std::uint32_t magic{kTbstreamWireMagic};
+  std::uint32_t version{kTbstreamWireVersion};
+  std::uint32_t rank{0};
+  std::uint32_t world_size{0};
+  std::uint64_t window_bytes{0};
+  std::uint64_t windows{0};
+  std::uint64_t data_offset{0};
+  /// TbstreamWire value both ranks agreed on (env must match).
+  std::uint8_t wire{static_cast<std::uint8_t>(TbstreamWire::kF32)};
+};
+
+struct CollectiveHeader {
+  std::uint32_t magic{kCollectiveMagic};
+  std::uint32_t version{kCollectiveVersion};
+  std::uint64_t scope_id{0};
+  std::uint64_t operation_id{0};
+  std::uint64_t bytes{0};
+};
+
+static_assert(sizeof(CollectiveHeader) <= kDataOffset);
+
+class Tbstream final : public Communicator {
+public:
+  explicit Tbstream(const TbstreamConfig& config) : config_(config) {}
+  ~Tbstream() override { Cleanup(); }
+
+  Tbstream(const Tbstream&) = delete;
+  Tbstream& operator=(const Tbstream&) = delete;
+
+  [[nodiscard]] bool Initialize(std::string* error) {
+    if (config_.world_size != 2 || config_.rank > 1 ||
+        config_.bootstrap_port == 0 || config_.device_path.empty() ||
+        config_.device_index >
+            static_cast<std::uint32_t>(std::numeric_limits<int>::max())) {
+      SetError(error,
+               "tbstream communicator requires two ranks, a bootstrap port "
+               "and a stream device");
+      return false;
+    }
+    if (hipSetDevice(static_cast<int>(config_.device_index)) != hipSuccess) {
+      SetError(error, "hipSetDevice for tbstream communicator failed");
+      return false;
+    }
+    // A nonblocking device keeps every write under a deadline: a frame whose
+    // peer vanished mid-cable must fail within the collective timeout, not
+    // block in write(2) forever.
+    // Optional wire quantization: GUFO_TBSTREAM_WIRE selects the payload
+    // representation for large frames — f32 (default, exact), f16 (2x fewer
+    // link bytes) or q8 (per-32-element blocks with fp16 scales, ~3.76x
+    // fewer). Frames below kQuantizeMinBytes always stay f32. Both ranks
+    // must export the same value; the handshake below rejects a mismatch.
+    if (const char* wire_env = ::getenv("GUFO_TBSTREAM_WIRE")) {
+      const std::string_view choice(wire_env);
+      if (choice == "f16") {
+        wire_ = TbstreamWire::kF16;
+      } else if (choice == "q8") {
+        wire_ = TbstreamWire::kQ8;
+      } else if (choice != "f32") {
+        SetError(error, "GUFO_TBSTREAM_WIRE must be f32, f16 or q8");
+        return false;
+      }
+    }
+    // Wedge mitigation: GUFO_TBSTREAM_COALESCE=1 switches the reader to
+    // ring-depth-sized read() requests, parsing frames from a flat
+    // buffer. Sustained small write()/read() syscall pairs at high rate
+    // wedge the Barlow Ridge retimers; the write side is coalesced in
+    // the driver (tb_stream.tx_coalesce), this covers the read side.
+    // See strix-dual-exp docs/wedge-investigation.md.
+    if (const char* coal_env = ::getenv("GUFO_TBSTREAM_COALESCE")) {
+      coalesce_ = *coal_env == '1';
+    }
+    fd_ = ::open(config_.device_path.c_str(), O_RDWR | O_NONBLOCK | O_CLOEXEC);
+    if (fd_ < 0) {
+      SetError(error, "open " + config_.device_path + ": " +
+                          std::string(std::strerror(errno)) +
+                          " (is the USB4STREAM stream configured? see "
+                          "docs/models/qwen3.8-flash-next/TP2.md)");
+      return false;
+    }
+    // The reader's own descriptor stays blocking: this driver's nonblocking
+    // read path reports no data (and its poll mask stays quiet) for frames
+    // that arrive while no reader is parked in read(2), so a deadline-driven
+    // poll loop would starve. A blocking read returns the moment the frame
+    // arrives; waiters carry the collective timeout instead.
+    read_fd_ = ::open(config_.device_path.c_str(), O_RDWR | O_CLOEXEC);
+    if (read_fd_ < 0) {
+      SetError(error, "open " + config_.device_path +
+                          " for reading: " + std::string(std::strerror(errno)));
+      return false;
+    }
+    struct stat device_stat{};
+    if (::fstat(fd_, &device_stat) != 0 || !S_ISCHR(device_stat.st_mode)) {
+      SetError(error, config_.device_path + " is not a character device");
+      return false;
+    }
+    // The peer's frame is copied by this process into the receive windows and
+    // the GPU adds it straight from there, so both buffers are host memory
+    // the device maps, coherent like the flags: the reader thread stores the
+    // peer's partial and the GPU reads it without an invalidation, as the
+    // verbs transport reads the NIC's DMA through its registered mapping.
+    if (hipHostMalloc(&send_buffer_, kBufferBytes,
+                      hipHostMallocMapped | hipHostMallocCoherent) !=
+            hipSuccess ||
+        hipHostMalloc(&recv_buffer_, kBufferBytes,
+                      hipHostMallocMapped | hipHostMallocCoherent) !=
+            hipSuccess) {
+      SetError(error, "tbstream exchange window allocation failed");
+      return false;
+    }
+    if (hipHostGetDevicePointer(&send_device_, send_buffer_, 0) != hipSuccess ||
+        send_device_ == nullptr ||
+        hipHostGetDevicePointer(&recv_device_, recv_buffer_, 0) != hipSuccess ||
+        recv_device_ == nullptr) {
+      SetError(error, "exchange windows have no device mapping");
+      return false;
+    }
+    if (hipHostMalloc(&flags_, kFlagBytes,
+                      hipHostMallocMapped | hipHostMallocCoherent) !=
+            hipSuccess ||
+        hipHostGetDevicePointer(&flags_device_, flags_, 0) != hipSuccess ||
+        hipMalloc(&arrivals_, sizeof(std::uint32_t)) != hipSuccess ||
+        hipMemset(arrivals_, 0, sizeof(std::uint32_t)) != hipSuccess) {
+      SetError(error, "exchange flag allocation failed");
+      return false;
+    }
+    std::memset(flags_, 0, kFlagBytes);
+    int clock_khz = 0;
+    if (hipDeviceGetAttribute(&clock_khz, hipDeviceAttributeWallClockRate,
+                              static_cast<int>(config_.device_index)) !=
+            hipSuccess ||
+        clock_khz <= 0) {
+      SetError(error, "device wall clock rate is unknown");
+      return false;
+    }
+    wait_ticks_ = static_cast<std::uint64_t>(clock_khz) * 1000 * kWaitSeconds;
+
+    const Wire local{
+        .rank = config_.rank,
+        .world_size = config_.world_size,
+        .window_bytes = kWindowBytes,
+        .windows = kWindows,
+        .data_offset = kDataOffset,
+        .wire = static_cast<std::uint8_t>(wire_),
+    };
+    Socket control = config_.rank == 0
+                         ? Socket::Listen(config_.bootstrap_host,
+                                          config_.bootstrap_port, error)
+                         : Socket::Connect(config_.bootstrap_host,
+                                           config_.bootstrap_port, error);
+    if (!control.valid()) {
+      return false;
+    }
+    if (!control.SendAll(&local, sizeof(local), error)) {
+      return false;
+    }
+    Wire remote{};
+    if (!control.RecvAll(&remote, sizeof(remote), error)) {
+      return false;
+    }
+    if (remote.magic != kTbstreamWireMagic ||
+        remote.version != kTbstreamWireVersion ||
+        remote.world_size != config_.world_size ||
+        remote.rank != 1U - config_.rank ||
+        remote.window_bytes != kWindowBytes || remote.windows != kWindows ||
+        remote.data_offset != kDataOffset ||
+        remote.wire != static_cast<std::uint8_t>(wire_)) {
+      SetError(error,
+               "tbstream bootstrap metadata is invalid (check that both "
+               "ranks use the same --tp-transport and the same "
+               "GUFO_TBSTREAM_WIRE)");
+      return false;
+    }
+    try {
+      const int rc =
+          ::pthread_create(&reader_tid_, nullptr, ReadTrampoline, this);
+      if (rc != 0) {
+        throw std::system_error(rc, std::generic_category());
+      }
+      reader_tid_valid_ = true;
+      reader_started_ = true;
+    } catch (const std::system_error&) {
+      SetError(error, "tbstream reader thread creation failed");
+      return false;
+    }
+    const std::uint32_t ready = kReadyMagic;
+    std::uint32_t peer_ready = 0;
+    if (!control.SendAll(&ready, sizeof(ready), error) ||
+        !control.RecvAll(&peer_ready, sizeof(peer_ready), error) ||
+        peer_ready != kReadyMagic) {
+      SetError(error, "tbstream readiness exchange failed");
+      return false;
+    }
+    control_ = std::make_unique<Socket>(std::move(control));
+    return true;
+  }
+
+  [[nodiscard]] std::uint32_t rank() const noexcept override {
+    return config_.rank;
+  }
+  [[nodiscard]] std::uint32_t world_size() const noexcept override {
+    return config_.world_size;
+  }
+  [[nodiscard]] int device_index() const noexcept override {
+    return static_cast<int>(config_.device_index);
+  }
+
+  [[nodiscard]] bool BeginOperation(std::uint64_t scope_id,
+                                    std::string* error) override {
+    std::lock_guard lock(mutex_);
+    if (fd_ < 0 || control_ == nullptr) {
+      SetError(error, "tbstream communicator is not initialized");
+      return false;
+    }
+    if (poisoned_) {
+      PoisonedError(error);
+      return false;
+    }
+    if (bound_scope_.has_value()) {
+      Poison(error, "another tbstream operation scope is already bound");
+      return false;
+    }
+    bound_scope_ = scope_id;
+    return true;
+  }
+
+  [[nodiscard]] bool EndOperation(std::uint64_t scope_id,
+                                  std::string* error) override {
+    std::lock_guard lock(mutex_);
+    if (poisoned_) {
+      PoisonedError(error);
+      return false;
+    }
+    if (!bound_scope_.has_value()) {
+      SetError(error, "tbstream operation scope is not bound");
+      return false;
+    }
+    if (*bound_scope_ != scope_id) {
+      Poison(error, "tbstream operation scope end mismatch: bound=" +
+                        std::to_string(*bound_scope_) +
+                        " requested=" + std::to_string(scope_id));
+      return false;
+    }
+    if (started_ != 0 || queued_ != 0) {
+      Poison(error, "tbstream operation scope ended with exchanges in flight");
+      return false;
+    }
+    bound_scope_.reset();
+    return true;
+  }
+
+  [[nodiscard]] const float* ExchangePartial(const float* data,
+                                             std::size_t bytes,
+                                             TbstreamWire* wire,
+                                             hipStream_t stream,
+                                             std::string* error) override {
+    std::lock_guard lock(mutex_);
+    if (!CheckExchange(data, bytes, error)) {
+      return nullptr;
+    }
+    if (started_ != 0 || queued_ != 0) {
+      Poison(error, "tbstream exchange started with overlapped ones in flight");
+      return nullptr;
+    }
+    const TbstreamWire exchange_wire = WireFor(bytes);
+    // Synchronizing retires this rank's adds of earlier exchanges, whose
+    // windows the peer's next frames reuse.
+    if (bytes != 0 &&
+        (hipStreamSynchronize(stream) != hipSuccess ||
+         !StageIntoWindow(SendWindow(next_operation_), data, bytes,
+                          exchange_wire, next_operation_, stream) ||
+         hipStreamSynchronize(stream) != hipSuccess)) {
+      Poison(error, "HIP device-to-host all-reduce staging failed");
+      return nullptr;
+    }
+    const std::uint64_t operation_id = next_operation_;
+    Expect({.scope_id = *bound_scope_,
+            .operation_id = operation_id,
+            .bytes = TbstreamWireBytes(bytes, exchange_wire),
+            .queued = false});
+    std::string transfer_error;
+    if (!WriteFrame(*bound_scope_, operation_id,
+                    TbstreamWireBytes(bytes, exchange_wire), &transfer_error)) {
+      Poison(error, std::move(transfer_error));
+      return nullptr;
+    }
+    if (!WaitArrival(operation_id, &transfer_error)) {
+      Poison(error, std::move(transfer_error));
+      return nullptr;
+    }
+    ++next_operation_;
+    if (wire != nullptr) {
+      *wire = exchange_wire;
+    }
+    return RecvWindow(operation_id);
+  }
+
+  [[nodiscard]] bool StartPartial(const float* data, std::size_t bytes,
+                                  hipStream_t stream,
+                                  std::string* error) override {
+    std::lock_guard lock(mutex_);
+    if (!CheckExchange(data, bytes, error)) {
+      return false;
+    }
+    if (started_ == kStartedExchanges) {
+      Poison(error, "too many overlapped tbstream exchanges in flight");
+      return false;
+    }
+    if (std::string worker_error; !StartWorker(&worker_error)) {
+      Poison(error, std::move(worker_error));
+      return false;
+    }
+    // At most kStartedExchanges are in flight, so the exchange that last used
+    // this event has finished and the worker no longer waits on it.
+    const std::uint64_t operation_id = next_operation_;
+    hipEvent_t ready = ready_events_[operation_id % kStartedExchanges];
+    if (hipEventRecord(ready, stream) != hipSuccess) {
+      Poison(error, "overlapped exchange event record failed");
+      return false;
+    }
+    const TbstreamWire exchange_wire = WireFor(bytes);
+    Expect({.scope_id = *bound_scope_,
+            .operation_id = operation_id,
+            .bytes = TbstreamWireBytes(bytes, exchange_wire),
+            .queued = false});
+    {
+      std::lock_guard jobs(jobs_mutex_);
+      jobs_.push_back({.ready = ready,
+                       .data = data,
+                       .bytes = TbstreamWireBytes(bytes, exchange_wire),
+                       .fp32_bytes = bytes,
+                       .scope_id = *bound_scope_,
+                       .operation_id = operation_id,
+                       .wire = exchange_wire});
+    }
+    ++next_operation_;
+    ++started_;
+    jobs_ready_.notify_one();
+    return true;
+  }
+
+  [[nodiscard]] const float* FinishPartial(std::size_t bytes,
+                                           TbstreamWire* wire,
+                                           std::string* error) override {
+    {
+      std::lock_guard lock(mutex_);
+      if (started_ == 0) {
+        Poison(error, "no overlapped tbstream exchange is in flight");
+        return nullptr;
+      }
+    }
+    Finished finished;
+    {
+      std::unique_lock jobs(jobs_mutex_);
+      finished_ready_.wait(jobs, [this] { return !finished_.empty(); });
+      finished = std::move(finished_.front());
+      finished_.pop_front();
+    }
+    std::lock_guard lock(mutex_);
+    --started_;
+    // `bytes` is the f32 payload size the caller staged; the frame carried
+    // its wire representation.
+    if (finished.peer != nullptr &&
+        finished.bytes != TbstreamWireBytes(bytes, finished.wire)) {
+      finished.peer = nullptr;
+      finished.error = "overlapped tbstream exchange size mismatch";
+    }
+    if (finished.peer == nullptr) {
+      Poison(error, finished.error);
+      return nullptr;
+    }
+    if (wire != nullptr) {
+      *wire = finished.wire;
+    }
+    return finished.peer;
+  }
+
+  [[nodiscard]] bool QueuePartial(std::size_t bytes, QueuedPartial* partial,
+                                  std::string* error) override {
+    std::lock_guard lock(mutex_);
+    if (!CheckExchange(static_cast<const float*>(send_device_), bytes, error)) {
+      return false;
+    }
+    if (started_ != 0 || queued_ == kQueuedExchanges) {
+      Poison(error, "tbstream exchange queued with too many in flight");
+      return false;
+    }
+    if (std::string worker_error; !StartWorker(&worker_error)) {
+      Poison(error, std::move(worker_error));
+      return false;
+    }
+    const std::uint64_t operation_id = next_operation_;
+    const std::size_t window = (operation_id % kWindows) * kWindowBytes;
+    auto* flags = static_cast<std::uint8_t*>(flags_device_);
+    const TbstreamWire exchange_wire = WireFor(bytes);
+    *partial = {
+        .send = reinterpret_cast<float*>(
+            static_cast<std::uint8_t*>(send_device_) + window + kDataOffset),
+        .peer = reinterpret_cast<const float*>(
+            static_cast<std::uint8_t*>(recv_device_) + window + kDataOffset),
+        .ready = reinterpret_cast<std::uint64_t*>(flags + kReadyOffset),
+        .arrived =
+            reinterpret_cast<const std::uint64_t*>(flags + kArrivedOffset),
+        // Flags start at zero, so exchange k publishes k + 1.
+        .value = operation_id + 1,
+        .arrivals = static_cast<std::uint32_t*>(arrivals_),
+        .timed_out = reinterpret_cast<std::uint32_t*>(flags + kTimedOutOffset),
+        .wait_ticks = wait_ticks_,
+        .wire = exchange_wire,
+    };
+    Expect({.scope_id = *bound_scope_,
+            .operation_id = operation_id,
+            .bytes = TbstreamWireBytes(bytes, exchange_wire),
+            .queued = true});
+    {
+      std::lock_guard jobs(jobs_mutex_);
+      jobs_.push_back({.bytes = TbstreamWireBytes(bytes, exchange_wire),
+                       .fp32_bytes = bytes,
+                       .scope_id = *bound_scope_,
+                       .operation_id = operation_id,
+                       .queued = true,
+                       .wire = exchange_wire});
+    }
+    ++next_operation_;
+    ++queued_;
+    jobs_ready_.notify_one();
+    return true;
+  }
+
+  [[nodiscard]] bool CheckQueued(std::string* error) override {
+    std::lock_guard lock(mutex_);
+    if (!poisoned_ &&
+        Flag<std::uint32_t>(kTimedOutOffset).load(std::memory_order_acquire) !=
+            0) {
+      poisoned_ = true;
+      if (first_error_.empty()) {
+        first_error_ = "a GPU wait for a queued tbstream exchange timed out";
+      }
+    }
+    if (poisoned_) {
+      PoisonedError(error);
+      return false;
+    }
+    return true;
+  }
+
+private:
+  struct Job {
+    hipEvent_t ready{nullptr};
+    const float* data{nullptr};
+    /// Wire bytes: what WriteFrame sends and ReadFrame expects.
+    std::size_t bytes{0};
+    /// The f32 payload bytes the staging step reads.
+    std::size_t fp32_bytes{0};
+    std::uint64_t scope_id{0};
+    std::uint64_t operation_id{0};
+    /// A QueuePartial exchange: the GPU stages it and waits for it.
+    bool queued{false};
+    /// Wire representation of this exchange's payload.
+    TbstreamWire wire{TbstreamWire::kF32};
+  };
+  struct Finished {
+    const float* peer{nullptr};
+    std::size_t bytes{0};
+    TbstreamWire wire{TbstreamWire::kF32};
+    std::string error;
+  };
+  /// The reader thread's view of one exchange: where its frame must land and
+  /// how its arrival is published.
+  struct Expected {
+    std::uint64_t scope_id{0};
+    std::uint64_t operation_id{0};
+    std::size_t bytes{0};
+    bool queued{false};
+  };
+
+  /// Poisons the communicator under `mutex_`, keeping the first failure so
+  /// later calls report why the sequence cannot continue. The callers of this
+  /// rule-violation poison hold `mutex_` from their validation, and the
+  /// synchronous exchange holds it across its wait, so no waiter exists that
+  /// this path would need to release; the reader thread releases its own
+  /// waiters through the failure hint.
+  void Poison(std::string* error, std::string message) {
+    poisoned_ = true;
+    if (first_error_.empty()) {
+      first_error_ = message;
+    }
+    SetError(error, std::move(message));
+  }
+
+  /// Reports a call on the poisoned communicator, under `mutex_`.
+  void PoisonedError(std::string* error) const {
+    std::string message = "tbstream communicator is poisoned";
+    if (!first_error_.empty()) {
+      message += ": " + first_error_;
+    } else {
+      message +=
+          ReaderFailureText(failure_hint_.load(std::memory_order_acquire));
+    }
+    SetError(error, std::move(message));
+  }
+
+  /// Validates an exchange of `bytes` at `data` under `mutex_`, poisoning the
+  /// communicator when the sequence cannot continue.
+  [[nodiscard]] bool CheckExchange(const float* data, std::size_t bytes,
+                                   std::string* error) {
+    if (fd_ < 0) {
+      SetError(error, "tbstream communicator is not initialized");
+      return false;
+    }
+    if (control_ == nullptr) {
+      SetError(error, "tbstream control channel is not initialized");
+      return false;
+    }
+    if (poisoned_) {
+      PoisonedError(error);
+      return false;
+    }
+    if (!bound_scope_.has_value()) {
+      Poison(error, "tbstream collective has no bound operation scope");
+      return false;
+    }
+    if (bytes % sizeof(float) != 0 || (bytes != 0 && data == nullptr)) {
+      Poison(error, "all-reduce buffer is invalid");
+      return false;
+    }
+    if (next_operation_ == std::numeric_limits<std::uint64_t>::max()) {
+      Poison(error, "tbstream collective operation sequence exhausted");
+      return false;
+    }
+    if (bytes > kWindowBytes - kDataOffset) {
+      Poison(error, "all-reduce payload exceeds the receive window");
+      return false;
+    }
+    return true;
+  }
+
+  [[nodiscard]] std::uint8_t* SendWindow(std::uint64_t operation_id) const {
+    return static_cast<std::uint8_t*>(send_buffer_) +
+           (operation_id % kWindows) * kWindowBytes;
+  }
+
+  [[nodiscard]] const float* RecvWindow(std::uint64_t operation_id) const {
+    return reinterpret_cast<const float*>(
+        static_cast<std::uint8_t*>(recv_device_) +
+        (operation_id % kWindows) * kWindowBytes + kDataOffset);
+  }
+
+  template<typename T>
+  [[nodiscard]] std::atomic_ref<T> Flag(std::size_t offset) const {
+    return std::atomic_ref<T>(
+        *reinterpret_cast<T*>(static_cast<std::uint8_t*>(flags_) + offset));
+  }
+
+  /// Registers the frame of `expected` with the reader thread, which places
+  /// the peer's frame of the same exchange into the receive window and
+  /// publishes its arrival. The byte stream is ordered, so the reader's
+  /// frames come in operation order however far the peer runs ahead.
+  void Expect(Expected expected) {
+    {
+      std::lock_guard expected_lock(expected_mutex_);
+      expected_.push_back(expected);
+    }
+    expected_cv_.notify_one();
+  }
+
+  /// Writes the header and the partial staged in the send window of
+  /// `operation_id` to the stream device. The peer's reader thread is always
+  /// draining its end, so a frame larger than the device's rings still moves
+  /// even while the peer is writing its own frame of the same exchange. The
+  /// write waits under the collective timeout and watches the bootstrap
+  /// socket, so a lost peer or a stop fails the write instead of blocking
+  /// for the timeout.
+  [[nodiscard]] bool WriteFrame(std::uint64_t scope_id,
+                                std::uint64_t operation_id, std::size_t bytes,
+                                std::string* error) {
+    const CollectiveHeader outgoing{
+        .scope_id = scope_id,
+        .operation_id = operation_id,
+        .bytes = bytes,
+    };
+    std::uint8_t* send = SendWindow(operation_id);
+    std::memcpy(send, &outgoing, sizeof(outgoing));
+    const std::size_t frame_bytes = kDataOffset + bytes;
+    const auto deadline = std::chrono::steady_clock::now() + kCollectiveTimeout;
+    // A full ring eases as soon as the peer's reader drains it, which an
+    // exchange peer does within microseconds: retrying the write captures
+    // that space at once, while sleeping in poll(2) pays the interrupt
+    // pacing. Spin the exchange window first, mirroring the reader.
+    const auto spin_deadline =
+        std::chrono::steady_clock::now() + kExchangeSpinWindow;
+    std::size_t written = 0;
+    while (written < frame_bytes) {
+      if (stopping_.load(std::memory_order_relaxed)) {
+        SetError(error, "tbstream communicator stopped");
+        return false;
+      }
+      const ssize_t n = ::write(fd_, send + written, frame_bytes - written);
+      if (n > 0) {
+        written += static_cast<std::size_t>(n);
+        wrote_bytes_ += static_cast<std::uint64_t>(n);
+        continue;
+      }
+      if (n < 0 && errno == EINTR) {
+        continue;
+      }
+      if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) {
+        if (std::chrono::steady_clock::now() < spin_deadline) {
+          CpuRelax();
+          continue;
+        }
+        std::array<pollfd, 2> fds{
+            pollfd{.fd = fd_, .events = POLLOUT, .revents = 0},
+            pollfd{.fd = control_ != nullptr ? control_->fd() : -1,
+                   .events = POLLIN,
+                   .revents = 0}};
+        const int poll_result = ::poll(fds.data(), fds.size(), 1000);
+        if (poll_result < 0 && errno != EINTR) {
+          SetError(error, SystemError("tbstream write poll"));
+          return false;
+        }
+        if (fds[1].revents != 0) {
+          SetError(error, "tbstream peer closed the bootstrap connection");
+          return false;
+        }
+        // busy_poll streams always report POLLERR from poll(2) (there
+        // are no interrupt wakeups), so poll returns immediately: yield
+        // instead of spinning the core while the peer's ring drains.
+        if (fds[0].revents & POLLERR) {
+          ::usleep(100);
+        }
+        if (std::chrono::steady_clock::now() >= deadline) {
+          SetError(error, "tbstream write timed out");
+          return false;
+        }
+        continue;
+      }
+      SetError(error, SystemError("tbstream write"));
+      return false;
+    }
+    return true;
+  }
+
+  /// Waits until the reader has placed the peer's frame of `operation_id` in
+  /// the receive window: spins briefly, then sleeps on its notification.
+  /// Failures are checked first, so a released wait never reads a window the
+  /// reader did not fill.
+  [[nodiscard]] bool WaitArrival(std::uint64_t operation_id,
+                                 std::string* error) {
+    const std::uint64_t target = operation_id + 1;
+    const auto start = std::chrono::steady_clock::now();
+    const auto spin_deadline = start + kExchangeSpinWindow;
+    const auto deadline = start + kCollectiveTimeout;
+    const auto ready = [&] {
+      return failure_hint_.load(std::memory_order_acquire) != nullptr ||
+             stopping_.load(std::memory_order_relaxed) ||
+             arrival_op_.load(std::memory_order_acquire) >= target;
+    };
+    while (!ready()) {
+      const auto now = std::chrono::steady_clock::now();
+      if (now >= deadline) {
+        SetError(error, "tbstream all-reduce timed out");
+        return false;
+      }
+      if (now >= spin_deadline) {
+        std::unique_lock arrival(arrival_mutex_);
+        arrival_cv_.wait_until(arrival, deadline, ready);
+        continue;
+      }
+      CpuRelax();
+    }
+    if (void* hint = failure_hint_.load(std::memory_order_acquire);
+        hint != nullptr) {
+      SetError(error, ReaderFailureText(hint));
+      return false;
+    }
+    if (stopping_.load(std::memory_order_relaxed)) {
+      SetError(error, "tbstream communicator stopped");
+      return false;
+    }
+    return true;
+  }
+
+  /// Starts the thread that writes overlapped exchanges, under `mutex_`.
+  [[nodiscard]] bool StartWorker(std::string* error) {
+    if (worker_.joinable()) {
+      return true;
+    }
+    if (copy_stream_ == nullptr &&
+        hipStreamCreateWithFlags(&copy_stream_, hipStreamNonBlocking) !=
+            hipSuccess) {
+      copy_stream_ = nullptr;
+      SetError(error, "overlapped exchange stream creation failed");
+      return false;
+    }
+    for (hipEvent_t& event : ready_events_) {
+      if (event == nullptr &&
+          hipEventCreateWithFlags(&event, hipEventDisableTiming) !=
+              hipSuccess) {
+        event = nullptr;
+        SetError(error, "overlapped exchange event creation failed");
+        return false;
+      }
+    }
+    try {
+      worker_ = std::thread([this] {
+        PinToCpuFromTop(2);
+        Work();
+      });
+    } catch (const std::system_error&) {
+      SetError(error, "overlapped exchange thread creation failed");
+      return false;
+    }
+    return true;
+  }
+
+  /// Stages `fp32_bytes` of device `data` into the payload area of a host
+  /// `window` in `wire`'s representation, queued on `stream`; the sync that
+  /// follows makes the payload visible. The quantizing kernels publish the
+  /// exchange's `value` in the ready flag, which only rises, matching the
+  /// queued path's protocol. Returns false only for a rejected f32 copy.
+  [[nodiscard]] bool StageIntoWindow(void* window, const float* data,
+                                     std::size_t fp32_bytes, TbstreamWire wire,
+                                     std::uint64_t operation_id,
+                                     hipStream_t stream) {
+    auto* payload = static_cast<std::uint8_t*>(window) + kDataOffset;
+    const std::size_t count = fp32_bytes / sizeof(float);
+    auto* const arrivals = static_cast<std::uint32_t*>(arrivals_);
+    auto* const ready = reinterpret_cast<std::uint64_t*>(
+        static_cast<std::uint8_t*>(flags_device_) + kReadyOffset);
+    switch (wire) {
+      case TbstreamWire::kF32:
+        return hipMemcpyAsync(payload, data, fp32_bytes, hipMemcpyDeviceToHost,
+                              stream) == hipSuccess;
+      case TbstreamWire::kF16:
+        StagePartialF16(data, reinterpret_cast<__half*>(payload), count,
+                        arrivals, ready, operation_id + 1, stream);
+        return true;
+      case TbstreamWire::kQ8:
+        StagePartialQ8(data, reinterpret_cast<__half*>(payload),
+                       reinterpret_cast<std::int8_t*>(
+                           payload + TbstreamQ8DataOffset(fp32_bytes)),
+                       count, arrivals, ready, operation_id + 1, stream);
+        return true;
+    }
+    return false;
+  }
+
+  /// Wire representation for an f32 payload of `fp32_bytes`: the configured
+  /// quantization applies only to bandwidth-bound frames; small exchanges
+  /// keep the exact f32 path.
+  [[nodiscard]] TbstreamWire WireFor(std::size_t fp32_bytes) const noexcept {
+    return fp32_bytes >= kQuantizeMinBytes ? wire_ : TbstreamWire::kF32;
+  }
+
+  /// Runs exchanges in order. A started exchange's staging copy runs on a
+  /// stream of its own, which waits for the partial without waiting for the
+  /// work queued behind it; a queued exchange's GPU stages it and publishes
+  /// it, and learns of its arrival through the arrived flag the reader
+  /// raises.
+  void Work() {
+    const bool device =
+        hipSetDevice(static_cast<int>(config_.device_index)) == hipSuccess;
+    for (;;) {
+      Job job;
+      {
+        std::unique_lock jobs(jobs_mutex_);
+        jobs_ready_.wait(jobs, [this] {
+          return stopping_.load(std::memory_order_relaxed) || !jobs_.empty();
+        });
+        if (stopping_.load(std::memory_order_relaxed)) {
+          return;
+        }
+        job = jobs_.front();
+        jobs_.pop_front();
+      }
+      Finished finished{.bytes = job.bytes, .wire = job.wire};
+      std::string poisoned;
+      {
+        std::lock_guard lock(mutex_);
+        if (poisoned_) {
+          PoisonedError(&poisoned);
+        }
+      }
+      if (!poisoned.empty()) {
+        finished.error = std::move(poisoned);
+      } else if (job.queued) {
+        // The GPU publishes the staged partial through the ready flag; the
+        // reader thread finishes the exchange when the peer's frame arrives
+        // and raises the arrived flag, so the worker only writes its end.
+        // (The driver's TX coalescing stages sub-ring-depth writes and
+        // flushes them the moment this stream reads — the peer wait.)
+        std::string queued_error;
+        if (!WaitReady(job.operation_id + 1, &queued_error)) {
+          queued_error =
+              "queued exchange failed waiting for the GPU: " + queued_error;
+        } else if (!WriteFrame(job.scope_id, job.operation_id, job.bytes,
+                               &queued_error)) {
+          queued_error = "queued exchange write failed: " + queued_error;
+        }
+        if (!queued_error.empty()) {
+          // A failure releases every GPU wait still queued on the stream:
+          // it runs to its end and the caller learns of the failure from
+          // CheckQueued. The flag only rises, so the reader's later
+          // arrivals cannot drag it back down.
+          Flag<std::uint64_t>(kArrivedOffset)
+              .store(std::numeric_limits<std::uint64_t>::max(),
+                     std::memory_order_release);
+          std::lock_guard lock(mutex_);
+          poisoned_ = true;
+          if (first_error_.empty()) {
+            first_error_ = queued_error;
+          }
+        }
+      } else if (!device ||
+                 hipStreamWaitEvent(copy_stream_, job.ready, 0) != hipSuccess ||
+                 (job.bytes != 0 &&
+                  !StageIntoWindow(SendWindow(job.operation_id), job.data,
+                                   job.fp32_bytes, job.wire, job.operation_id,
+                                   copy_stream_)) ||
+                 hipStreamSynchronize(copy_stream_) != hipSuccess) {
+        finished.error = "HIP device-to-host overlapped staging failed";
+      } else if (!WriteFrame(job.scope_id, job.operation_id, job.bytes,
+                             &finished.error)) {
+        finished.error = "overlapped exchange write failed: " + finished.error;
+      } else if (!WaitArrival(job.operation_id, &finished.error)) {
+        finished.error =
+            "overlapped exchange arrival failed: " + finished.error;
+      } else {
+        finished.peer = RecvWindow(job.operation_id);
+      }
+      const bool failed = finished.peer == nullptr && !job.queued;
+      if (failed) {
+        std::lock_guard lock(mutex_);
+        poisoned_ = true;
+        if (first_error_.empty()) {
+          first_error_ = finished.error;
+        }
+      }
+      if (job.queued) {
+        continue;
+      }
+      {
+        std::lock_guard jobs(jobs_mutex_);
+        finished_.push_back(std::move(finished));
+      }
+      finished_ready_.notify_all();
+    }
+  }
+
+  /// Waits until the GPU has published the partial of queued exchange
+  /// `value - 1`: spins briefly, then polls.
+  [[nodiscard]] bool WaitReady(std::uint64_t value, std::string* error) {
+    const auto start = std::chrono::steady_clock::now();
+    const auto spin_deadline = start + kExchangeSpinWindow;
+    const auto deadline = start + kCollectiveTimeout;
+    while (Flag<std::uint64_t>(kReadyOffset).load(std::memory_order_acquire) <
+           value) {
+      if (stopping_.load(std::memory_order_relaxed)) {
+        SetError(error, "tbstream communicator stopped");
+        return false;
+      }
+      const auto now = std::chrono::steady_clock::now();
+      if (now >= deadline) {
+        SetError(error, "tbstream exchange timed out waiting for the GPU");
+        return false;
+      }
+      if (now >= spin_deadline) {
+        std::this_thread::sleep_for(std::chrono::microseconds(20));
+      } else {
+        CpuRelax();
+      }
+    }
+    return true;
+  }
+
+  /// The reader thread: owns every read of the stream device. Frames come in
+  /// operation order, so each lands in its rotating receive window, is
+  /// checked against the exchange this rank queued for the same operation,
+  /// and its arrival is published to the waiter or, for a queued exchange,
+  /// to the GPU's arrived flag. The bootstrap socket is polled alongside the
+  /// device: it carries nothing after setup, so readable means the peer
+  /// closed or reset it.
+  /// Reader-thread entry: pins and runs Read(). Managed as a raw
+  /// pthread (see StopReader for why not std::thread).
+  static void* ReadTrampoline(void* self) {
+    PinToCpuFromTop(1);
+    static_cast<Tbstream*>(self)->Read();
+    return nullptr;
+  }
+
+  void Read() {
+    for (;;) {
+      Expected expected;
+      {
+        std::unique_lock expected_lock(expected_mutex_);
+        expected_cv_.wait(expected_lock, [this] {
+          return stopping_.load(std::memory_order_relaxed) ||
+                 !expected_.empty();
+        });
+        if (stopping_.load(std::memory_order_relaxed)) {
+          return;
+        }
+        expected = expected_.front();
+        expected_.pop_front();
+      }
+      if (!ReadFrame(expected)) {
+        return;
+      }
+      PublishArrival(expected);
+    }
+  }
+
+  /// Reads one framed exchange into its receive window on the blocking read
+  /// descriptor. Returns false once the communicator cannot continue, after
+  /// releasing every waiter; a stop leaves the thread parked in read(2)
+  /// until the process exits.
+  [[nodiscard]] bool ReadFrame(const Expected& expected) {
+    std::uint8_t* window = static_cast<std::uint8_t*>(recv_buffer_) +
+                           (expected.operation_id % kWindows) * kWindowBytes;
+    const std::size_t frame_bytes = kDataOffset + expected.bytes;
+    if (coalesce_) {
+      return ReadFrameBuffered(expected, window, frame_bytes);
+    }
+    std::size_t received = 0;
+    void* failure = nullptr;
+    // A blocking read with no poll and no timeout: this driver reports
+    // arriving frames through the blocking read path only, so the reader
+    // parks in read(2) and returns as soon as the frame's bytes are there.
+    // An empty ring reads as zero bytes; the peer's frame of a decode
+    // exchange lands within the exchange spin window, so the reader spins
+    // that long before sleeping and keeps the arrival off the sleep
+    // granularity. A peer that never sends leaves it retrying; the waiters'
+    // collective timeout fails the exchange and poisons the communicator,
+    // and a stop leaves the thread parked until the process exits (it is
+    // detached and its descriptor is never closed).
+    const auto spin_deadline =
+        std::chrono::steady_clock::now() + kExchangeSpinWindow;
+    // A stream that reports EOF (the peer's CLOSE was consumed) stays at
+    // zero forever: fail the exchange promptly instead of spinning until
+    // the waiters' collective timeout. Repeated zero reads past the spin
+    // window mean exactly that on a healthy stream.
+    const auto eof_deadline =
+        std::chrono::steady_clock::now() + std::chrono::seconds(2);
+    while (received < frame_bytes) {
+      if (stopping_.load(std::memory_order_relaxed)) {
+        return false;
+      }
+      const ssize_t n =
+          ::read(read_fd_, window + received, frame_bytes - received);
+      if (n > 0) {
+        received += static_cast<std::size_t>(n);
+        continue;
+      }
+      if (n < 0 && errno == EINTR) {
+        continue;
+      }
+      if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) {
+        continue;
+      }
+      if (n == 0) {
+        if (std::chrono::steady_clock::now() < spin_deadline) {
+          CpuRelax();
+        } else if (std::chrono::steady_clock::now() < eof_deadline) {
+          ::usleep(100);
+        } else {
+          failure = reinterpret_cast<void*>(
+              static_cast<std::uintptr_t>(ReaderFailure::kStreamClosed));
+          break;
+        }
+        continue;
+      }
+      failure = reinterpret_cast<void*>(
+          static_cast<std::uintptr_t>(ReaderFailure::kStreamRead));
+      break;
+    }
+    CollectiveHeader incoming{};
+    if (failure == nullptr) {
+      std::memcpy(&incoming, window, sizeof(incoming));
+      if (incoming.magic != kCollectiveMagic ||
+          incoming.version != kCollectiveVersion ||
+          incoming.scope_id != expected.scope_id ||
+          incoming.operation_id != expected.operation_id ||
+          incoming.bytes != expected.bytes) {
+        std::fprintf(stderr,
+                     "tbstream collective mismatch: expected scope %llu "
+                     "operation %llu bytes %llu, received scope %llu "
+                     "operation %llu bytes %llu\n",
+                     static_cast<unsigned long long>(expected.scope_id),
+                     static_cast<unsigned long long>(expected.operation_id),
+                     static_cast<unsigned long long>(expected.bytes),
+                     static_cast<unsigned long long>(incoming.scope_id),
+                     static_cast<unsigned long long>(incoming.operation_id),
+                     static_cast<unsigned long long>(incoming.bytes));
+        failure = reinterpret_cast<void*>(
+            static_cast<std::uintptr_t>(ReaderFailure::kHeader));
+      }
+    }
+    if (failure == nullptr) {
+      return true;
+    }
+    Fail(failure);
+    return false;
+  }
+
+  /// Coalesced-reader path: pulls with read() requests of at least
+  /// ring depth (1 MiB, or the whole frame when larger), parsing frames
+  /// from a flat buffer copied into each receive window. The
+  /// blocking-read parking semantics are unchanged — the request size
+  /// is what keeps the driver's receive path in its bulk shape.
+  [[nodiscard]] bool ReadFrameBuffered(const Expected& expected,
+                                       std::uint8_t* window,
+                                       std::size_t frame_bytes) {
+    void* failure = nullptr;
+    const auto spin_deadline =
+        std::chrono::steady_clock::now() + kExchangeSpinWindow;
+    // See ReadFrame: sustained zero reads mean the peer's CLOSE was
+    // consumed — fail promptly instead of spinning to the timeout.
+    const auto eof_deadline =
+        std::chrono::steady_clock::now() + std::chrono::seconds(2);
+    const std::size_t want_cap =
+        std::max<std::size_t>(kCoalesceBytes * 2, frame_bytes + kCoalesceBytes);
+    if (rx_cap_ < want_cap) {
+      // Grow, CARRYING the unconsumed remainder: unread buffered bytes
+      // belong to the byte stream and must survive the reallocation.
+      std::unique_ptr<std::uint8_t[]> grown =
+          std::make_unique<std::uint8_t[]>(want_cap);
+      const std::size_t unread = rx_have_ - rx_parsed_;
+      if (unread > 0) {
+        std::memmove(grown.get(), rx_buf_.get() + rx_parsed_, unread);
+      }
+      rx_buf_ = std::move(grown);
+      rx_cap_ = want_cap;
+      rx_have_ = unread;
+      rx_parsed_ = 0;
+    }
+    while (rx_have_ - rx_parsed_ < frame_bytes) {
+      if (rx_parsed_ > 0) {
+        std::memmove(rx_buf_.get(), rx_buf_.get() + rx_parsed_,
+                     rx_have_ - rx_parsed_);
+        rx_have_ -= rx_parsed_;
+        rx_parsed_ = 0;
+      }
+      const ssize_t n =
+          ::read(read_fd_, rx_buf_.get() + rx_have_, rx_cap_ - rx_have_);
+      if (n > 0) {
+        rx_have_ += static_cast<std::size_t>(n);
+        continue;
+      }
+      if (n < 0 && errno == EINTR) {
+        continue;
+      }
+      if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) {
+        continue;
+      }
+      if (n == 0) {
+        if (std::chrono::steady_clock::now() < spin_deadline) {
+          CpuRelax();
+        } else if (std::chrono::steady_clock::now() < eof_deadline) {
+          ::usleep(100);
+        } else {
+          failure = reinterpret_cast<void*>(
+              static_cast<std::uintptr_t>(ReaderFailure::kStreamClosed));
+          break;
+        }
+        continue;
+      }
+      failure = reinterpret_cast<void*>(
+          static_cast<std::uintptr_t>(ReaderFailure::kStreamRead));
+      break;
+    }
+    CollectiveHeader incoming{};
+    if (failure == nullptr) {
+      std::memcpy(window, rx_buf_.get() + rx_parsed_, frame_bytes);
+      rx_parsed_ += frame_bytes;
+      if (rx_parsed_ == rx_have_) {
+        rx_have_ = 0;
+        rx_parsed_ = 0;
+      }
+      std::memcpy(&incoming, window, sizeof(incoming));
+      if (incoming.magic != kCollectiveMagic ||
+          incoming.version != kCollectiveVersion ||
+          incoming.scope_id != expected.scope_id ||
+          incoming.operation_id != expected.operation_id ||
+          incoming.bytes != expected.bytes) {
+        std::fprintf(stderr,
+                     "tbstream collective mismatch: expected scope %llu "
+                     "operation %llu bytes %llu, received scope %llu "
+                     "operation %llu bytes %llu\n",
+                     static_cast<unsigned long long>(expected.scope_id),
+                     static_cast<unsigned long long>(expected.operation_id),
+                     static_cast<unsigned long long>(expected.bytes),
+                     static_cast<unsigned long long>(incoming.scope_id),
+                     static_cast<unsigned long long>(incoming.operation_id),
+                     static_cast<unsigned long long>(incoming.bytes));
+        failure = reinterpret_cast<void*>(
+            static_cast<std::uintptr_t>(ReaderFailure::kHeader));
+      }
+    }
+    if (failure == nullptr) {
+      return true;
+    }
+    Fail(failure);
+    return false;
+  }
+
+  /// Publishes the arrival of a fully received frame: counts a queued
+  /// exchange out before the GPU learns of the arrival, so a scope that ends
+  /// once the stream has drained finds nothing in flight, then raises the
+  /// GPU's arrived flag for the queued exchange and wakes host waiters.
+  void PublishArrival(const Expected& expected) {
+    if (expected.queued) {
+      {
+        std::lock_guard lock(mutex_);
+        --queued_;
+      }
+      RaiseArrivedFlag(expected.operation_id + 1);
+    }
+    std::uint64_t current = arrival_op_.load(std::memory_order_relaxed);
+    while (current < expected.operation_id + 1 &&
+           !arrival_op_.compare_exchange_weak(
+               current, expected.operation_id + 1, std::memory_order_release,
+               std::memory_order_relaxed)) {
+    }
+    arrival_cv_.notify_all();
+  }
+
+  /// Raises the GPU's arrived flag without ever lowering it: the terminal
+  /// value a failed or stopped exchange stores must outlive every later
+  /// arrival the reader still publishes.
+  void RaiseArrivedFlag(std::uint64_t value) noexcept {
+    auto flag = Flag<std::uint64_t>(kArrivedOffset);
+    std::uint64_t current = flag.load(std::memory_order_relaxed);
+    while (current < value && !flag.compare_exchange_weak(
+                                  current, value, std::memory_order_release,
+                                  std::memory_order_relaxed)) {
+    }
+  }
+
+  /// Releases every waiter with `failure` as the reason and records the
+  /// first error. The hint and the arrival counter are stored before the
+  /// lock, so a synchronous exchange that holds the lock while waiting still
+  /// wakes and fails at once.
+  void Fail(void* failure) {
+    failure_hint_.store(failure, std::memory_order_release);
+    arrival_op_.store(std::numeric_limits<std::uint64_t>::max(),
+                      std::memory_order_release);
+    {
+      // Nothing will answer a GPU wait still queued on a stream.
+      Flag<std::uint64_t>(kArrivedOffset)
+          .store(std::numeric_limits<std::uint64_t>::max(),
+                 std::memory_order_release);
+    }
+    arrival_cv_.notify_all();
+    {
+      std::lock_guard lock(mutex_);
+      poisoned_ = true;
+      if (first_error_.empty()) {
+        first_error_ = ReaderFailureText(failure);
+      }
+    }
+  }
+
+  void StopWorker() noexcept {
+    {
+      std::lock_guard jobs(jobs_mutex_);
+      stopping_.store(true, std::memory_order_relaxed);
+    }
+    jobs_ready_.notify_all();
+    // A worker in WaitArrival sleeps on this condition variable until its
+    // deadline; the stop must wake it at once.
+    arrival_cv_.notify_all();
+    if (worker_.joinable()) {
+      worker_.join();
+    }
+    if (flags_ != nullptr) {
+      // Nothing will answer a wait still queued on a stream.
+      Flag<std::uint64_t>(kArrivedOffset)
+          .store(std::numeric_limits<std::uint64_t>::max(),
+                 std::memory_order_release);
+    }
+    for (hipEvent_t& event : ready_events_) {
+      if (event != nullptr) {
+        (void)hipEventDestroy(event);
+        event = nullptr;
+      }
+    }
+    if (copy_stream_ != nullptr) {
+      (void)hipStreamDestroy(copy_stream_);
+      copy_stream_ = nullptr;
+    }
+  }
+
+  void StopReader() noexcept {
+    {
+      std::lock_guard expected(expected_mutex_);
+      stopping_.store(true, std::memory_order_relaxed);
+    }
+    expected_cv_.notify_all();
+    arrival_cv_.notify_all();
+    if (!reader_tid_valid_) {
+      return;
+    }
+    // A quiescent reader parks on expected_cv_ and exits here, so its
+    // descriptor can be closed in-process once it is joined. One blocked in
+    // read(2) on a frame a dead peer never sends cannot be interrupted (the
+    // driver has no cancel path), so after a bounded join it is detached
+    // (raw pthread_detach — std::thread::detach() after a successful raw
+    // join calls pthread_detach on the reaped thread and THROWS ESRCH,
+    // which in a noexcept path became std::terminate/SIGABRT after every
+    // fully-successful run) and the descriptor is left to process exit.
+    struct timespec deadline{};
+    clock_gettime(CLOCK_REALTIME, &deadline);
+    deadline.tv_sec += 2;
+    reader_joined_ =
+        ::pthread_timedjoin_np(reader_tid_, nullptr, &deadline) == 0;
+    if (!reader_joined_) {
+      (void)::pthread_detach(reader_tid_);
+    }
+    reader_tid_valid_ = false;
+  }
+
+  void Cleanup() noexcept {
+    // The worker writes and the reader reads the stream device until they
+    // stop.
+    StopWorker();
+    StopReader();
+    control_.reset();
+    if (fd_ >= 0) {
+      ::close(fd_);
+      fd_ = -1;
+    }
+    if (read_fd_ >= 0 && (reader_joined_ || !reader_started_)) {
+      // The reader is gone (quiescent shutdown or it never started), so the
+      // second close releases the device here — orderly, in-process, after
+      // the quiesce above. Otherwise the descriptor stays open for the
+      // parked reader and process exit releases it, as before.
+      ::close(read_fd_);
+      read_fd_ = -1;
+    }
+    if (arrivals_ != nullptr) {
+      (void)hipFree(arrivals_);
+      arrivals_ = nullptr;
+    }
+    // A reader parked in read(2) that could not be joined may still wake
+    // (late peer data) and write into these buffers: leaking them to
+    // process exit is the safe lifetime; read_fd_ stays open for it too.
+    const bool reader_may_live = reader_started_ && !reader_joined_;
+    if (flags_ != nullptr && !reader_may_live) {
+      (void)hipHostFree(flags_);
+      flags_ = nullptr;
+    }
+    flags_device_ = nullptr;
+    if (send_buffer_ != nullptr) {
+      (void)hipHostFree(send_buffer_);
+      send_buffer_ = nullptr;
+    }
+    if (recv_buffer_ != nullptr && !reader_may_live) {
+      (void)hipHostFree(recv_buffer_);
+      recv_buffer_ = nullptr;
+    }
+    send_device_ = nullptr;
+    recv_device_ = nullptr;
+  }
+
+  TbstreamConfig config_;
+  int fd_{-1};
+  // The reader's blocking descriptor; never closed (see StopReader).
+  int read_fd_{-1};
+  // TX pacing (see Initialize): microseconds per MiB inside a frame write.
+  std::uint64_t wrote_bytes_{0};
+  // Wire representation for large frames (see Initialize's env parse).
+  TbstreamWire wire_{TbstreamWire::kF32};
+  void* send_buffer_{nullptr};
+  void* recv_buffer_{nullptr};
+  bool coalesce_{false};
+  std::unique_ptr<std::uint8_t[]> rx_buf_;
+  std::size_t rx_cap_{0};
+  std::size_t rx_have_{0};
+  std::size_t rx_parsed_{0};
+  void* send_device_{nullptr};
+  void* recv_device_{nullptr};
+  // Queued exchanges' flags (kReadyOffset...) in host memory the GPU maps,
+  // and the stage kernel's block counter.
+  void* flags_{nullptr};
+  void* flags_device_{nullptr};
+  void* arrivals_{nullptr};
+  std::uint64_t wait_ticks_{0};
+  std::unique_ptr<Socket> control_;
+  std::optional<std::uint64_t> bound_scope_;
+  // Monotonic for the communicator lifetime; scope_id supplies request
+  // identity.
+  std::uint64_t next_operation_{0};
+  bool poisoned_{false};
+  // The first failure that poisoned the communicator.
+  std::string first_error_;
+  // The reader's failure, published without the communicator lock so a
+  // holder of the lock waiting for an exchange wakes and names it.
+  std::atomic<void*> failure_hint_{nullptr};
+  // The last exchange whose peer frame has fully arrived, plus one; max()
+  // when the reader failed. Readers publish, waiters only read.
+  std::atomic<std::uint64_t> arrival_op_{0};
+  // Started exchanges not yet finished, and queued exchanges not yet
+  // complete.
+  std::size_t started_{0};
+  std::size_t queued_{0};
+  mutable std::mutex mutex_;
+  // The overlapped exchanges: the worker takes jobs in order and hands back
+  // their results in the same order. Lock order: mutex_ before jobs_mutex_
+  // and expected_mutex_.
+  std::thread worker_;
+  pthread_t reader_tid_{0};
+  bool reader_tid_valid_{false};
+  // Reader lifecycle for teardown: whether the reader thread was ever
+  // started, and whether StopReader() joined it (a quiescent reader parks on
+  // expected_cv_ and joins; one blocked in read(2) cannot be interrupted).
+  bool reader_started_{false};
+  bool reader_joined_{false};
+  hipStream_t copy_stream_{nullptr};
+  std::array<hipEvent_t, kStartedExchanges> ready_events_{};
+  std::deque<Job> jobs_;
+  std::deque<Finished> finished_;
+  std::deque<Expected> expected_;
+  std::atomic<bool> stopping_{false};
+  std::mutex jobs_mutex_;
+  std::condition_variable jobs_ready_;
+  std::condition_variable finished_ready_;
+  std::mutex expected_mutex_;
+  std::condition_variable expected_cv_;
+  std::mutex arrival_mutex_;
+  std::condition_variable arrival_cv_;
+};
+
+}  // namespace
+
+std::shared_ptr<Communicator> CreateTbstreamCommunicator(
+    const TbstreamConfig& config, std::string* error_msg) {
+  auto communicator = std::make_shared<Tbstream>(config);
+  if (!communicator->Initialize(error_msg)) {
+    return nullptr;
+  }
+  return communicator;
+}
+
+}  // namespace gufo::models::qwen38_flash_next::rocm
