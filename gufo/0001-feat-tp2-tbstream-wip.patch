+bool Check(hipError_t error, const char* what, std::string* error_msg) {
+  if (error != hipSuccess) {
+    if (error_msg != nullptr) {
+      *error_msg = std::string(what) + ": " + hipGetErrorString(error);
+    }
+    return false;
+  }
+  return true;
