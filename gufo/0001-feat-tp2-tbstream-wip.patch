+__global__ void RmsNormKernel(const float* x, const float* gamma, float* out,
+                              std::uint32_t rows, std::uint32_t dim,
+                              std::uint32_t groups, float eps) {
+  __shared__ double shared[kBlockThreads];
+  const std::uint32_t row = blockIdx.x;
+  if (row >= rows) {
+    return;
+  }
+  const std::uint32_t width = dim / groups;
+  const float* src = x + static_cast<std::size_t>(row) * width;
+  float* dst = out + static_cast<std::size_t>(row) * width;
+  // One gamma row of `width` is shared by every group (the KDA o-norm).
+  const float* g = gamma;
+  double sum = 0.0;
+  for (std::uint32_t i = threadIdx.x; i < width; i += blockDim.x) {
+    sum += static_cast<double>(src[i]) * src[i];
+  }
+  const float inv = static_cast<float>(
+      1.0 / std::sqrt(BlockSumDouble(sum, shared) / static_cast<double>(width) +
+                      static_cast<double>(eps)));
+  for (std::uint32_t i = threadIdx.x; i < width; i += blockDim.x) {
+    dst[i] = g != nullptr ? g[i] * (src[i] * inv) : src[i] * inv;
+  }
+}
+
+__global__ void LayerNormKernel(const float* x, const float* weight,
+                                const float* bias, float* out,
+                                std::uint32_t rows, std::uint32_t dim,
+                                float eps) {
+  __shared__ double shared[kBlockThreads];
+  const std::uint32_t row = blockIdx.x;
+  if (row >= rows) {
+    return;
+  }
+  const float* src = x + static_cast<std::size_t>(row) * dim;
+  float* dst = out + static_cast<std::size_t>(row) * dim;
+  double total = 0.0;
+  for (std::uint32_t i = threadIdx.x; i < dim; i += blockDim.x) {
+    total += src[i];
+  }
+  const double mean = BlockSumDouble(total, shared) / dim;
+  double squares = 0.0;
+  for (std::uint32_t i = threadIdx.x; i < dim; i += blockDim.x) {
+    const double centered = static_cast<double>(src[i]) - mean;
+    squares += centered * centered;
+  }
+  const float inv =
+      static_cast<float>(1.0 / std::sqrt(BlockSumDouble(squares, shared) / dim +
+                                         static_cast<double>(eps)));
+  for (std::uint32_t i = threadIdx.x; i < dim; i += blockDim.x) {
+    const float centered =
+        static_cast<float>(static_cast<double>(src[i]) - mean);
+    dst[i] = weight[i] * (centered * inv) + bias[i];
+  }
+}
+
+__global__ void F32GemmKernel(const float* w, const float* x, float* out,
+                              std::uint32_t m, std::uint32_t k) {
+  __shared__ double shared[kBlockThreads];
+  const std::uint32_t row = blockIdx.x;
+  if (row >= m) {
+    return;
+  }
+  const float* src = w + static_cast<std::size_t>(row) * k;
+  double sum = 0.0;
+  for (std::uint32_t i = threadIdx.x; i < k; i += blockDim.x) {
+    sum += static_cast<double>(src[i]) * x[i];
+  }
+  out[row] = static_cast<float>(BlockSumDouble(sum, shared));
+}
+
+/// The reference's float sigmoid (std::exp float overload semantics).
+__device__ __forceinline__ float SigmoidF(float x) {
+  return 1.0F / (1.0F + expf(-x));
+}
+
+__global__ void HcSinkhornKernel(const float* mixes, const float* scale,
+                                 const float* base, float* pre, float* post,
+                                 float* comb, std::uint32_t n,
+                                 std::uint32_t sinkhorn_iters, float eps) {
+  if (threadIdx.x != 0) {
+    return;
+  }
+  float c[16];
+  for (std::uint32_t i = 0; i < n; ++i) {
+    pre[i] = SigmoidF(mixes[i] * scale[0] + base[i]) + eps;
+    post[i] = 2.0F * SigmoidF(mixes[n + i] * scale[1] + base[n + i]);
+  }
+  for (std::uint32_t r = 0; r < n; ++r) {
+    float max_value = -__int_as_float(0x7F800000);  // -inf
+    for (std::uint32_t col = 0; col < n; ++col) {
+      const float logit =
+          mixes[2 * n + r * n + col] * scale[2] + base[2 * n + r * n + col];
+      c[r * n + col] = logit;
+      max_value = max_value > logit ? max_value : logit;
+    }
+    double denom = 0.0;
+    for (std::uint32_t col = 0; col < n; ++col) {
+      denom += exp(static_cast<double>(c[r * n + col] - max_value));
+    }
+    for (std::uint32_t col = 0; col < n; ++col) {
+      c[r * n + col] =
+          static_cast<float>(
+              exp(static_cast<double>(c[r * n + col] - max_value)) / denom) +
+          eps;
+    }
+  }
+  const auto col_norm = [&]() {
+    for (std::uint32_t col = 0; col < n; ++col) {
+      double denom = 0.0;
+      for (std::uint32_t r = 0; r < n; ++r) {
+        denom += c[r * n + col];
+      }
+      const float scale_v =
+          static_cast<float>(1.0 / (denom + static_cast<double>(eps)));
+      for (std::uint32_t r = 0; r < n; ++r) {
+        c[r * n + col] *= scale_v;
+      }
+    }
+  };
+  const auto row_norm = [&]() {
+    for (std::uint32_t r = 0; r < n; ++r) {
+      double denom = 0.0;
+      for (std::uint32_t col = 0; col < n; ++col) {
+        denom += c[r * n + col];
+      }
+      const float scale_v =
+          static_cast<float>(1.0 / (denom + static_cast<double>(eps)));
+      for (std::uint32_t col = 0; col < n; ++col) {
+        c[r * n + col] *= scale_v;
+      }
+    }
+  };
+  col_norm();
+  for (std::uint32_t it = 1; it < sinkhorn_iters; ++it) {
+    row_norm();
+    col_norm();
+  }
+  for (std::uint32_t i = 0; i < n * n; ++i) {
+    comb[i] = c[i];
+  }
+}
+
+__global__ void HcCollapseKernel(const float* pre, const float* streams,
+                                 float* collapsed, std::uint32_t hidden,
+                                 std::uint32_t n) {
+  const std::uint32_t d = blockIdx.x * blockDim.x + threadIdx.x;
+  if (d >= hidden) {
+    return;
+  }
+  double value = 0.0;
+  for (std::uint32_t i = 0; i < n; ++i) {
+    value += static_cast<double>(pre[i]) *
+             streams[static_cast<std::size_t>(i) * hidden + d];
+  }
+  collapsed[d] = static_cast<float>(value);
+}
+
+__global__ void HcCombineKernel(const float* post, const float* comb,
+                                const float* residual, const float* block_out,
+                                float* streams, std::uint32_t hidden,
+                                std::uint32_t n) {
+  const std::uint32_t i = blockIdx.y;
+  const std::uint32_t d = blockIdx.x * blockDim.x + threadIdx.x;
+  if (d >= hidden) {
+    return;
+  }
+  double mix = 0.0;
+  for (std::uint32_t m = 0; m < n; ++m) {
+    mix += static_cast<double>(comb[m * n + i]) *
+           residual[static_cast<std::size_t>(m) * hidden + d];
+  }
+  streams[static_cast<std::size_t>(i) * hidden + d] =
+      static_cast<float>(static_cast<double>(post[i]) * block_out[d] + mix);
+}
+
+__global__ void MeanStreamsKernel(const float* streams, float* out,
+                                  std::uint32_t hidden, std::uint32_t n) {
+  const std::uint32_t d = blockIdx.x * blockDim.x + threadIdx.x;
+  if (d >= hidden) {
+    return;
+  }
+  double mean = 0.0;
+  for (std::uint32_t i = 0; i < n; ++i) {
+    mean += streams[static_cast<std::size_t>(i) * hidden + d];
+  }
+  out[d] = static_cast<float>(mean / n);
+}
+
+__global__ void KdaConvKernel(const float* qkv, const float* taps_q,
+                              const float* taps_k, const float* taps_v,
+                              float* history, float* conv_out,
+                              std::uint32_t inner, std::uint32_t kernel) {
+  const std::uint32_t ch = blockIdx.x * blockDim.x + threadIdx.x;
+  const std::uint32_t channels = 3 * inner;
+  if (ch >= channels) {
+    return;
+  }
+  const float* taps = ch < inner ? taps_q : (ch < 2 * inner ? taps_k : taps_v);
+  const float* row = taps + static_cast<std::size_t>(ch % inner) * kernel;
+  double acc = 0.0;
+  for (std::uint32_t t = 0; t < kernel; ++t) {
+    const float input = t + 1 < kernel ? history[t * channels + ch] : qkv[ch];
+    acc += static_cast<double>(row[t]) * input;
+  }
+  const float x = static_cast<float>(acc);
+  conv_out[ch] = x / (1.0F + expf(-x));
+  // Roll: new history row j is row (j+1) of [history ; qkv], so the
+  // fresh input lands on the last of the (kernel-1) rows.
+  for (std::uint32_t t = 0; t + 2 < kernel; ++t) {
+    history[t * channels + ch] = history[(t + 1) * channels + ch];
+  }
+  history[(kernel - 2) * channels + ch] = qkv[ch];
+}
+
+/// One thread per head, sequential over dim: mirrors the reference's
+/// float accumulation order exactly.
+__global__ void KdaPrepareKernel(const float* conv_out, float* qn, float* kn,
+                                 std::uint32_t heads, std::uint32_t dim,
+                                 std::uint32_t inner, float l2_eps) {
+  const std::uint32_t h = blockIdx.x * blockDim.x + threadIdx.x;
+  if (h >= heads) {
+    return;
+  }
+  const float q_scale = 1.0F / sqrtf(static_cast<float>(dim));
+  float q_sq = 0.0F;
+  float k_sq = 0.0F;
+  for (std::uint32_t d = 0; d < dim; ++d) {
+    const float q = conv_out[h * dim + d];
+    const float k = conv_out[inner + h * dim + d];
+    q_sq += q * q;
+    k_sq += k * k;
+  }
+  const float q_inv = 1.0F / sqrtf(q_sq + l2_eps) * q_scale;
+  const float k_inv = 1.0F / sqrtf(k_sq + l2_eps);
+  for (std::uint32_t d = 0; d < dim; ++d) {
+    qn[h * dim + d] = conv_out[h * dim + d] * q_inv;
+    kn[h * dim + d] = conv_out[inner + h * dim + d] * k_inv;
+  }
+}
+
+__global__ void KdaGatesKernel(const float* raw, const float* a,
+                               const float* dt, const float* beta_row,
+                               float bound, float* gate, float* beta,
+                               std::uint32_t inner, std::uint32_t dim,
+                               std::uint32_t heads) {
+  const std::uint32_t j = blockIdx.x * blockDim.x + threadIdx.x;
+  if (j < inner) {
+    const float decay_rate = -a[j / dim];
+    gate[j] = bound * SigmoidF(decay_rate * (raw[j] + dt[j]));
+  }
+  if (j < heads) {
+    beta[j] = SigmoidF(beta_row[j]);
+  }
+}
+
+/// One block of `dim` threads per head; each thread owns one value
+/// column and walks the key rows in the reference's order.
+__global__ void KdaRecurrenceKernel(const float* qn, const float* kn,
+                                    const float* gate, const float* beta,
+                                    const float* conv_out, float* state,
+                                    float* core, std::uint32_t heads,
+                                    std::uint32_t dim) {
+  const std::uint32_t h = blockIdx.x;
+  const std::uint32_t v = threadIdx.x;
+  if (h >= heads || v >= dim) {
+    return;
+  }
+  const std::uint32_t inner = heads * dim;
+  float* s = state + static_cast<std::size_t>(h) * dim * dim;
+  float kv = 0.0F;
+  for (std::uint32_t d = 0; d < dim; ++d) {
+    const float decay = expf(gate[h * dim + d]);
+    float& cell = s[static_cast<std::size_t>(d) * dim + v];
+    cell *= decay;
+    kv += cell * kn[h * dim + d];
+  }
+  const float b = beta[h];
+  const float delta = (conv_out[2 * inner + h * dim + v] - kv) * b;
+  float acc = 0.0F;
+  for (std::uint32_t d = 0; d < dim; ++d) {
+    float& cell = s[static_cast<std::size_t>(d) * dim + v];
+    cell += kn[h * dim + d] * delta;
+    acc += cell * qn[h * dim + d];
+  }
+  core[h * dim + v] = acc;
+}
+
+/// Register-column fast path (kda.head_dim 128). The statements, their
+/// order and the serial per-thread accumulation over d are exactly the
+/// generic kernel's above — bit-identical core row and state — but the
+/// state column stays in registers and the block-uniform rows (decay,
+/// kn, qn) are staged once per block instead of per thread. Statement
+/// shapes match BatchKdaRecurrenceRegKernel in kernels_batch.hip.cpp, so
+/// the tokenwise and chunked paths agree byte-for-byte by construction.
+__global__ __launch_bounds__(128, 1) void KdaRecurrenceRegKernel(
+    const float* qn, const float* kn, const float* gate, const float* beta,
+    const float* conv_out, float* state, float* core, std::uint32_t heads) {
+  constexpr std::uint32_t kDim = 128;
+  const std::uint32_t h = blockIdx.x;
+  const std::uint32_t v = threadIdx.x;
+  const std::uint32_t inner = heads * kDim;
+  __shared__ float decay_row[kDim];
+  __shared__ float kn_row[kDim];
+  __shared__ float qn_row[kDim];
+  float* s = state + static_cast<std::size_t>(h) * kDim * kDim;
+  float column[kDim];
+#pragma unroll
+  for (std::uint32_t d = 0; d < kDim; ++d) {
+    column[d] = s[static_cast<std::size_t>(d) * kDim + v];
+  }
+  __syncthreads();
+  decay_row[v] = expf(gate[static_cast<std::size_t>(h) * kDim + v]);
+  kn_row[v] = kn[static_cast<std::size_t>(h) * kDim + v];
+  qn_row[v] = qn[static_cast<std::size_t>(h) * kDim + v];
+  __syncthreads();
+  float kv = 0.0F;
+#pragma unroll
+  for (std::uint32_t d = 0; d < kDim; ++d) {
+    column[d] *= decay_row[d];
+    kv += column[d] * kn_row[d];
+  }
+  const float b = beta[h];
+  const float delta = (conv_out[2 * inner + h * kDim + v] - kv) * b;
+  float acc = 0.0F;
+#pragma unroll
+  for (std::uint32_t d = 0; d < kDim; ++d) {
+    column[d] += kn_row[d] * delta;
+    acc += column[d] * qn_row[d];
+  }
+  core[static_cast<std::size_t>(h) * kDim + v] = acc;
+#pragma unroll
+  for (std::uint32_t d = 0; d < kDim; ++d) {
+    s[static_cast<std::size_t>(d) * kDim + v] = column[d];
+  }
+}
+
+__global__ void SigmoidMulKernel(const float* x, const float* g, float* out,
+                                 std::size_t count) {
+  const std::size_t i =
+      static_cast<std::size_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+  if (i < count) {
+    out[i] = x[i] * SigmoidF(g[i]);
+  }
+}
+
+__global__ void SiluRowsKernel(const float* x, float* out, std::size_t count) {
+  const std::size_t i =
+      static_cast<std::size_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+  if (i < count) {
+    out[i] = x[i] / (1.0F + expf(-x[i]));
+  }
+}
+
+__global__ void IndexerAppendKernel(const float* key_raw, const float* gate_raw,
+                                    const float* k_norm_w,
+                                    const float* k_norm_b, float* keys,
+                                    float* gates, std::uint32_t pos,
+                                    std::uint32_t idim, float eps) {
+  __shared__ double shared[kBlockThreads];
+  if (blockIdx.x > 0) {
+    return;
+  }
+  double total = 0.0;
+  for (std::uint32_t i = threadIdx.x; i < idim; i += blockDim.x) {
+    total += key_raw[i];
+  }
+  const double mean = BlockSumDouble(total, shared) / idim;
+  double squares = 0.0;
+  for (std::uint32_t i = threadIdx.x; i < idim; i += blockDim.x) {
+    const double centered = static_cast<double>(key_raw[i]) - mean;
+    squares += centered * centered;
+  }
+  const float inv = static_cast<float>(
+      1.0 / std::sqrt(BlockSumDouble(squares, shared) / idim +
+                      static_cast<double>(eps)));
+  for (std::uint32_t i = threadIdx.x; i < idim; i += blockDim.x) {
+    const float centered =
+        static_cast<float>(static_cast<double>(key_raw[i]) - mean);
+    keys[static_cast<std::size_t>(pos) * idim + i] =
+        k_norm_w[i] * (centered * inv) + k_norm_b[i];
+    gates[static_cast<std::size_t>(pos) * idim + i] = gate_raw[i];
+  }
+}
+
+__global__ void IndexerPoolKernel(const float* keys, const float* gates,
+                                  const float* ape, float* pooled,
+                                  std::uint32_t pool, std::uint32_t kpool,
+                                  std::uint32_t idim) {
+  const std::uint32_t d = blockIdx.x * blockDim.x + threadIdx.x;
+  if (d >= idim) {
+    return;
+  }
+  float logits[8];
+  const std::uint32_t base = pool * kpool;
+  float max_value = -__int_as_float(0x7F800000);
+  for (std::uint32_t j = 0; j < kpool; ++j) {
+    logits[j] = gates[static_cast<std::size_t>(base + j) * idim + d] +
+                ape[j * idim + d];
+    max_value = max_value > logits[j] ? max_value : logits[j];
+  }
+  double denom = 0.0;
+  for (std::uint32_t j = 0; j < kpool; ++j) {
+    denom += exp(static_cast<double>(logits[j] - max_value));
+  }
+  float sum = 0.0F;
+  for (std::uint32_t j = 0; j < kpool; ++j) {
+    const float prob = static_cast<float>(
+        exp(static_cast<double>(logits[j] - max_value)) / denom);
+    sum += prob * keys[static_cast<std::size_t>(base + j) * idim + d];
+  }
+  pooled[static_cast<std::size_t>(pool) * idim + d] = sum;
+}
+
+__global__ void IndexerScoresKernel(const float* iq, const float* pooled,
+                                    const float* weights, float* scores,
+                                    std::uint32_t pools, std::uint32_t heads,
+                                    std::uint32_t idim, float scale) {
+  const std::uint32_t p = blockIdx.x * blockDim.x + threadIdx.x;
+  if (p >= pools) {
+    return;
+  }
+  double total = 0.0;
+  for (std::uint32_t h = 0; h < heads; ++h) {
+    double dot = 0.0;
+    const float* q = iq + static_cast<std::size_t>(h) * idim;
+    const float* k = pooled + static_cast<std::size_t>(p) * idim;
+    for (std::uint32_t d = 0; d < idim; ++d) {
+      dot += static_cast<double>(q[d]) * k[d];
+    }
+    const float activated = static_cast<float>(dot) * scale;
+    total +=
+        static_cast<double>(weights[h]) * (activated > 0.0F ? activated : 0.0F);
+  }
+  scores[p] = static_cast<float>(total);
+}
+
+__global__ void AppendRowsKernel(const float* src, float* dst,
+                                 std::uint32_t row, std::uint32_t offset,
+                                 std::uint32_t count) {
+  const std::uint32_t i = blockIdx.x * blockDim.x + threadIdx.x;
+  if (i < row * count) {
+    const std::uint32_t src_row = i / row;
+    const std::uint32_t col = i % row;
+    dst[static_cast<std::size_t>(offset + src_row) * row + col] = src[i];
+  }
+}
+
+__global__ void ScaleRowsKernel(const float* x, float* out, float factor,
+                                std::size_t count) {
+  const std::size_t i =
+      static_cast<std::size_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+  if (i < count) {
+    out[i] = x[i] * factor;
+  }
+}
+
+__global__ void ClampedSwigluKernel(const float* g, const float* u, float* out,
+                                    std::size_t count, float limit) {
+  const std::size_t i =
+      static_cast<std::size_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+  if (i < count) {
+    const float gate = g[i] < limit ? g[i] : limit;
+    const float up = u[i] > limit ? limit : (u[i] < -limit ? -limit : u[i]);
+    out[i] = (gate / (1.0F + expf(-gate))) * up;
+  }
+}
+
+__global__ void ScaleAddIntoKernel(float* acc, const float* x, float weight,
+                                   std::size_t count) {
+  const std::size_t i =
+      static_cast<std::size_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+  if (i < count) {
+    acc[i] += weight * x[i];
+  }
+}
+
+}  // namespace
+
+void EmbedTokenStreams(const void* table, WeightType type, std::int32_t token,
+                       float* streams, std::uint32_t hidden,
+                       std::uint32_t n_streams, hipStream_t stream) {
+  const unsigned grid = (hidden / 4 + kBlockThreads - 1) / kBlockThreads;
+  if (type == WeightType::kQ8_0) {
+    EmbedQ8Kernel<<<grid, kBlockThreads, 0, stream>>>(
+        static_cast<const Q8_0Block*>(table), token, streams, hidden,
+        n_streams);
+  } else {
+    EmbedF32Kernel<<<grid, kBlockThreads, 0, stream>>>(
+        static_cast<const float*>(table), token, streams, hidden, n_streams);
+  }
+}
+
+void RmsNormRows(const float* x, const float* gamma, float* out,
+                 std::uint32_t rows, std::uint32_t dim, std::uint32_t groups,
+                 float eps, hipStream_t stream) {
+  RmsNormKernel<<<rows, kBlockThreads, 0, stream>>>(x, gamma, out, rows, dim,
+                                                    groups, eps);
+}
+
+void LayerNormRows(const float* x, const float* weight, const float* bias,
+                   float* out, std::uint32_t rows, std::uint32_t dim, float eps,
+                   hipStream_t stream) {
+  LayerNormKernel<<<rows, kBlockThreads, 0, stream>>>(x, weight, bias, out,
+                                                      rows, dim, eps);
+}
+
+void F32Gemm(const float* w, const float* x, float* out, std::uint32_t m,
+             std::uint32_t k, hipStream_t stream) {
+  // Tokenwise and batched share the tiled kernel (one token wide here), so
+  // chunked-vs-tokenwise equality holds by construction.
+  BatchF32Gemm(w, x, out, 1, m, k, stream);
+}
+
+void HcSinkhorn(const float* mixes, const float* scale, const float* base,
+                float* pre, float* post, float* comb, std::uint32_t n,
+                std::uint32_t sinkhorn_iters, float eps, hipStream_t stream) {
+  HcSinkhornKernel<<<1, kBlockThreads, 0, stream>>>(
+      mixes, scale, base, pre, post, comb, n, sinkhorn_iters, eps);
+}
+
+void HcCollapse(const float* pre, const float* streams, float* collapsed,
+                std::uint32_t hidden, std::uint32_t n, hipStream_t stream) {
+  const unsigned grid = (hidden + kBlockThreads - 1) / kBlockThreads;
+  HcCollapseKernel<<<grid, kBlockThreads, 0, stream>>>(pre, streams, collapsed,
+                                                       hidden, n);
+}
+
+void HcCombine(const float* post, const float* comb, const float* residual,
+               const float* block_out, float* streams, std::uint32_t hidden,
+               std::uint32_t n, hipStream_t stream) {
+  const unsigned grid = (hidden + kBlockThreads - 1) / kBlockThreads;
+  HcCombineKernel<<<dim3(grid, n), kBlockThreads, 0, stream>>>(
+      post, comb, residual, block_out, streams, hidden, n);
+}
+
+void MeanStreams(const float* streams, float* out, std::uint32_t hidden,
+                 std::uint32_t n, hipStream_t stream) {
+  const unsigned grid = (hidden + kBlockThreads - 1) / kBlockThreads;
+  MeanStreamsKernel<<<grid, kBlockThreads, 0, stream>>>(streams, out, hidden,
+                                                        n);
+}
+
+void KdaConv(const float* qkv, const float* taps_q, const float* taps_k,
+             const float* taps_v, float* history, float* conv_out,
+             std::uint32_t inner, std::uint32_t kernel, hipStream_t stream) {
+  const unsigned grid = (3 * inner + kBlockThreads - 1) / kBlockThreads;
+  KdaConvKernel<<<grid, kBlockThreads, 0, stream>>>(
+      qkv, taps_q, taps_k, taps_v, history, conv_out, inner, kernel);
+}
+
+void KdaPrepare(const float* conv_out, float* qn, float* kn,
+                std::uint32_t heads, std::uint32_t dim, float l2_eps,
+                hipStream_t stream) {
+  const unsigned grid = (heads + kBlockThreads - 1) / kBlockThreads;
+  KdaPrepareKernel<<<grid, kBlockThreads, 0, stream>>>(
+      conv_out, qn, kn, heads, dim, heads * dim, l2_eps);
+}
+
+void KdaGates(const float* raw, const float* a, const float* dt,
+              const float* beta_row, float bound, float* gate, float* beta,
+              std::uint32_t inner, std::uint32_t dim, hipStream_t stream) {
+  const std::uint32_t heads = inner / dim;
+  const unsigned grid =
+      (std::max(inner, heads) + kBlockThreads - 1) / kBlockThreads;
+  KdaGatesKernel<<<grid, kBlockThreads, 0, stream>>>(
+      raw, a, dt, beta_row, bound, gate, beta, inner, dim, heads);
+}
+
+void KdaRecurrence(const float* qn, const float* kn, const float* gate,
+                   const float* beta, const float* conv_out, float* state,
+                   float* core, std::uint32_t heads, std::uint32_t dim,
+                   hipStream_t stream) {
+  // The register-column fast path is the bit-identical twin of the generic
+  // kernel; only the model's kda.head_dim is compiled that way.
+  if (dim == 128) {
+    KdaRecurrenceRegKernel<<<heads, 128, 0, stream>>>(
+        qn, kn, gate, beta, conv_out, state, core, heads);
+    return;
+  }
+  KdaRecurrenceKernel<<<heads, dim, 0, stream>>>(qn, kn, gate, beta, conv_out,
+                                                 state, core, heads, dim);
+}
+
+void SigmoidMul(const float* x, const float* g, float* out, std::size_t count,
+                hipStream_t stream) {
+  const unsigned grid =
+      static_cast<unsigned>((count + kBlockThreads - 1) / kBlockThreads);
+  SigmoidMulKernel<<<grid, kBlockThreads, 0, stream>>>(x, g, out, count);
+}
+
+void SiluRows(const float* x, float* out, std::size_t count,
+              hipStream_t stream) {
+  const unsigned grid =
+      static_cast<unsigned>((count + kBlockThreads - 1) / kBlockThreads);
+  SiluRowsKernel<<<grid, kBlockThreads, 0, stream>>>(x, out, count);
+}
+
+void IndexerAppend(const float* key_raw, const float* gate_raw,
+                   const float* k_norm_w, const float* k_norm_b, float* keys,
+                   float* gates, std::uint32_t pos, std::uint32_t idim,
+                   float eps, hipStream_t stream) {
+  IndexerAppendKernel<<<1, kBlockThreads, 0, stream>>>(
+      key_raw, gate_raw, k_norm_w, k_norm_b, keys, gates, pos, idim, eps);
+}
+
+void IndexerPool(const float* keys, const float* gates, const float* ape,
+                 float* pooled, std::uint32_t pool, std::uint32_t kpool,
+                 std::uint32_t idim, hipStream_t stream) {
+  const unsigned grid = (idim + kBlockThreads - 1) / kBlockThreads;
+  IndexerPoolKernel<<<grid, kBlockThreads, 0, stream>>>(
+      keys, gates, ape, pooled, pool, kpool, idim);
+}
+
+void IndexerScores(const float* iq, const float* pooled, const float* weights,
+                   float* scores, std::uint32_t pools, std::uint32_t heads,
+                   std::uint32_t idim, float scale, hipStream_t stream) {
+  const unsigned grid = (pools + kBlockThreads - 1) / kBlockThreads;
+  IndexerScoresKernel<<<grid, kBlockThreads, 0, stream>>>(
+      iq, pooled, weights, scores, pools, heads, idim, scale);
+}
+
+void AppendRows(const float* src, float* dst, std::uint32_t row,
+                std::uint32_t offset, std::uint32_t count, hipStream_t stream) {
+  const unsigned grid = (row + kBlockThreads - 1) / kBlockThreads;
+  AppendRowsKernel<<<grid, kBlockThreads, 0, stream>>>(src, dst, row, offset,
+                                                       count);
+}
+
+void ScaleRows(const float* x, float* out, float factor, std::size_t count,
+               hipStream_t stream) {
+  const unsigned grid =
+      static_cast<unsigned>((count + kBlockThreads - 1) / kBlockThreads);
+  ScaleRowsKernel<<<grid, kBlockThreads, 0, stream>>>(x, out, factor, count);
+}
+
+void ClampedSwiglu(const float* g, const float* u, float* out,
+                   std::size_t count, float limit, hipStream_t stream) {
+  const unsigned grid =
+      static_cast<unsigned>((count + kBlockThreads - 1) / kBlockThreads);
+  ClampedSwigluKernel<<<grid, kBlockThreads, 0, stream>>>(g, u, out, count,
+                                                          limit);
+}
+
+void ScaleAddInto(float* acc, const float* x, float weight, std::size_t count,
+                  hipStream_t stream) {
+  const unsigned grid =
+      static_cast<unsigned>((count + kBlockThreads - 1) / kBlockThreads);
+  ScaleAddIntoKernel<<<grid, kBlockThreads, 0, stream>>>(acc, x, weight, count);
+}
+
+__global__ void AddIntoKernel(float* acc, const float* peer,
+                              std::size_t count) {
+  const std::size_t i =
+      static_cast<std::size_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+  if (i < count) {
+    acc[i] += peer[i];
+  }
+}
+
+void AddInto(float* acc, const float* peer, std::size_t count,
+             hipStream_t stream) {
+  const unsigned grid =
+      static_cast<unsigned>((count + kBlockThreads - 1) / kBlockThreads);
+  AddIntoKernel<<<grid, kBlockThreads, 0, stream>>>(acc, peer, count);
+}
