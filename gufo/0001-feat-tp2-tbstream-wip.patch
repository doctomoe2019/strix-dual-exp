+      return 2;
+#endif
     }
     operation = std::make_unique<OperationGuard>(communicator, operation_id);
     if (!operation->Begin(&error)) {
@@ -228,7 +273,7 @@ int main(int argc, char** argv) {
   }
 #else
   if (world_size == 2) {
-    Fail("this probe was built without TP2 RDMA support");
+    Fail("this probe was built without TP2 RDMA or tbstream support");
     return 2;
   }
 #endif
