+/// Counts the tokens of an open reasoning span: everything before the first
+/// occurrence of the end-of-reasoning marker, or the whole sequence when the
+/// marker never arrives and the span was never closed.
+inline std::size_t ReasoningTokenCount(
+    std::span<const tokenization::TokenId> tokens,
+    std::span<const tokenization::TokenId> end_marker) {
+  if (end_marker.empty()) {
