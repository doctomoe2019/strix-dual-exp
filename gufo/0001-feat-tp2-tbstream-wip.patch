+GlmTextRunnerState& RequireGlmState(TextRunnerState& state) {
+  auto* glm = dynamic_cast<GlmTextRunnerState*>(&state);
+  if (glm == nullptr) {
+    throw std::logic_error("text runner state is not GLM-5.3-Flash");
+  }
+  return *glm;
