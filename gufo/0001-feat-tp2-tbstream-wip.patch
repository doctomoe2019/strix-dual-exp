diff --git a/src/models/glm5_next/CMakeLists.txt b/src/models/glm5_next/CMakeLists.txt
new file mode 100644
index 0000000..8a13dfb
--- /dev/null
+++ b/src/models/glm5_next/CMakeLists.txt
@@ -0,0 +1,50 @@
+# GLM-5.3-Flash (glm5-next) model package: configuration, tensor binding,
+# the TP=2 resident-byte plan and the scalar CPU reference. Kernels arrive
+# with the first-leg plan's P2 slice.
+add_library(gufo_glm5_next STATIC
+  config.cpp
+  weights.cpp
+  chat_template.cpp
+  reference.cpp
+  distributed/tp_plan.cpp
+  distributed/tp_partition.cpp)
+
+target_include_directories(gufo_glm5_next PUBLIC ${PROJECT_SOURCE_DIR})
+target_link_libraries(gufo_glm5_next PUBLIC gufo_core Threads::Threads)
+
+# The reference decodes every weight on the fly; unoptimized it is unusable
+# even as an oracle, so it keeps -O2 in every configuration.
+set_source_files_properties(reference.cpp PROPERTIES COMPILE_OPTIONS "-O2")
+
+if (ENGINE_ENABLE_HIP)
+  # P2 slice: resident weights first; eager kernels arrive with the
+  # operator phases. Correctness-first: no fast-math, so the kernels keep
+  # the reference's transcendental behavior. The engine (P3.7) wraps the
+  # qualified executor for serving.
+  target_sources(gufo_glm5_next PRIVATE
+    ${CMAKE_CURRENT_SOURCE_DIR}/kernels/rocm/device_model.cpp
+    ${CMAKE_CURRENT_SOURCE_DIR}/kernels/rocm/executor.cpp
+    ${CMAKE_CURRENT_SOURCE_DIR}/kernels/rocm/kernels.hip.cpp
+    ${CMAKE_CURRENT_SOURCE_DIR}/kernels/rocm/kernels_batch.hip.cpp
+    ${CMAKE_CURRENT_SOURCE_DIR}/engine.cpp)
+  set_source_files_properties(
+    ${CMAKE_CURRENT_SOURCE_DIR}/kernels/rocm/kernels.hip.cpp
+    ${CMAKE_CURRENT_SOURCE_DIR}/kernels/rocm/kernels_batch.hip.cpp
+    PROPERTIES LANGUAGE HIP)
+  # Statement-level FP contraction only. The default (fast) lets clang
+  # contract across statements differently per unrolled iteration, so a
+  # token's projection value silently depends on its slot inside the
+  # token tile — the chunked and tokenwise paths then disagree in the
+  # last ulp (the exec byte-equality gates catch it). `-ffp-contract=on`
+  # keeps every iteration of the tiled consumers' unrolled token loops
+  # on one contraction shape, restoring slot-independence; the CPU-oracle
+  # RMS caps cover the (statement-level) rounding this produces.
+  set_source_files_properties(
+    ${CMAKE_CURRENT_SOURCE_DIR}/kernels/rocm/kernels_batch.hip.cpp
+    PROPERTIES LANGUAGE HIP COMPILE_OPTIONS "-ffp-contract=on")
+  target_include_directories(gufo_glm5_next SYSTEM PRIVATE
+    ${ROCPRIM_INCLUDE_DIR})
+  target_compile_options(gufo_glm5_next PRIVATE
+    $<$<COMPILE_LANGUAGE:HIP>:-O3>)
+  target_link_libraries(gufo_glm5_next PUBLIC hip::host)
+endif()
