+#ifndef GUFO_MODELS_GLM5_NEXT_DISTRIBUTED_TP_PLAN_HPP_
+#define GUFO_MODELS_GLM5_NEXT_DISTRIBUTED_TP_PLAN_HPP_
+
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <string>
+
+#include "src/models/glm5_next/weights.hpp"
+
+namespace gufo::models::glm5_next::distributed {
+
+/// Byte ledger of one artifact under tensor parallelism.
+///
+/// Shares follow the plan the engine implements:
+/// - replicated: mHC, indexer, router, norms, latent producers, embedding
+///   and output head — every rank holds the whole tensor;
+/// - row_split: gate/up projections and head-wise output rows (q/k/v of
+///   KDA, q_b and attn_output) — contiguous output-row halves;
+/// - col_split: down projections and the KDA convolutions — reduction
+///   (column) halves, which must fall on quantization-block boundaries;
+/// - head_split: attn_k_b / attn_v_b — whole per-head matrices, half the
+///   heads per rank;
+/// - excluded: the nextn block, which the first-leg AR loader skips.
+struct TpLedger {
+  std::size_t replicated_bytes{0};
+  std::size_t row_split_bytes{0};
+  std::size_t col_split_bytes{0};
+  std::size_t head_split_bytes{0};
+  std::size_t excluded_bytes{0};
+  std::size_t tensor_count{0};
+
+  /// Autoregressive weights (the nextn block excluded).
+  [[nodiscard]] std::size_t FullArBytes() const noexcept {
+    return replicated_bytes + row_split_bytes + col_split_bytes +
+           head_split_bytes;
+  }
+  /// One rank's resident AR weight bytes at `world_size` (1 or 2).
+  [[nodiscard]] std::size_t PerRankBytes(
+      std::uint32_t world_size) const noexcept {
+    const std::size_t split =
+        row_split_bytes + col_split_bytes + head_split_bytes;
+    if (world_size <= 1) {
+      return FullArBytes();
+    }
+    return replicated_bytes + split / 2;
+  }
+};
+
+/// Computes the ledger and validates every split this engine would make:
+///
+/// - world size 1 or 2;
+/// - head counts halve exactly (KDA and DSA heads, k_b/v_b head axis);
+/// - every column split lands on whole quantization blocks of its type
+///   (32-value blocks for Q8_0, 256-value super-blocks for the K formats);
+/// - every row split keeps whole rows (always true for contiguous row
+///   ranges, so only nonzero halves are checked).
+///
+/// This is a source-artifact plan; the device upload remains the
+/// authoritative post-conversion measurement.
+[[nodiscard]] std::optional<TpLedger> PlanTpLedger(const ModelWeights& weights,
+                                                   std::uint32_t world_size,
+                                                   std::string* error);
+
+}  // namespace gufo::models::glm5_next::distributed
+
+#endif  // GUFO_MODELS_GLM5_NEXT_DISTRIBUTED_TP_PLAN_HPP_
