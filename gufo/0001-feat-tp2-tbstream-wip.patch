@@ -0,0 +1,45 @@
+#ifndef GUFO_SERVER_CONSTRAINT_RECIPE_HPP_
+#define GUFO_SERVER_CONSTRAINT_RECIPE_HPP_
+
+#include <string>
+#include <vector>
+
+namespace gufo::server {
+
+/// Serializable description of a request's effective output constraint, so a
+/// TP2 peer can rebuild the same grammar and run constrained multi-token
+/// decode cycles. It carries the effective construction inputs rather than a
+/// compiled program: grammar symbol layouts never cross the wire, because
+/// each rank walks its own grammar state over the same accepted tokens and
+/// only token ids, RNG and verdicts are exchanged.
+struct ConstraintRecipe {
+  struct Tool {
+    std::string name;
+    /// Dumped JSON schema of the tool's parameters.
+    std::string parameters_json;
+    bool strict{false};
+
+    bool operator==(const Tool&) const = default;
+  };
+
+  bool present{false};
+  /// Response-format grammar: 0 none, 1 a plain JSON object, 2 a schema.
+  int response_kind{0};
+  /// Dumped JSON schema; empty unless `response_kind` is 2.
+  std::string response_schema;
+  bool response_strict{false};
+  std::vector<Tool> tools;
+  bool tool_required{false};
+  /// Effective parallel-tool setting, after the response-format rule.
+  bool parallel{false};
+  /// The resolved reasoning-wrapper decision of the admitting rank.
+  bool reasoning{false};
+  /// `JsonConstraint::ToolFormat` the admitting rank composed the tools with.
+  int format{0};
+
+  bool operator==(const ConstraintRecipe&) const = default;
+};
+
+}  // namespace gufo::server
+
+#endif  // GUFO_SERVER_CONSTRAINT_RECIPE_HPP_
