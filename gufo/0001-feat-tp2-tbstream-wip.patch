--- /dev/null
+++ b/src/models/glm5_next/config.cpp
@@ -0,0 +1,296 @@
+#include "src/models/glm5_next/config.hpp"
+
+#include <algorithm>
+#include <cmath>
+#include <set>
+#include <string_view>
+#include <utility>
+#include <variant>
+
+namespace gufo::models::glm5_next {
+namespace {
+
+constexpr std::string_view kArchitecture = "glm5-next";
+
+struct Reader {
+  const core::GgufReader& gguf;
+  std::string* error;
+  bool ok{true};
+
+  void Fail(std::string message) {
+    if (ok && error != nullptr) {
+      *error = std::move(message);
+    }
+    ok = false;
+  }
+
+  std::uint32_t U32(std::string_view key, bool required = true,
+                    std::uint32_t fallback = 0) {
+    const auto value = gguf.GetMetadataUint32(key);
+    if (value.has_value()) {
+      return *value;
+    }
+    if (required || gguf.FindMetadata(key) != nullptr) {
+      Fail("missing or invalid GGUF integer " + std::string(key));
+    }
+    return fallback;
+  }
+
+  float F32(std::string_view key, float fallback) {
+    const auto value = gguf.GetMetadataFloat32(key);
+    if (!value || !std::isfinite(*value))
+      Fail("missing or invalid GGUF float " + std::string(key));
+    return value.value_or(fallback);
+  }
+
+  bool Bool(std::string_view key, bool fallback) {
+    const auto value = gguf.GetMetadataBool(key);
+    if (!value)
+      Fail("missing or invalid GGUF boolean " + std::string(key));
+    return value.value_or(fallback);
+  }
+
+  /// Integer or float arrays of any width, normalized to double.
+  std::vector<double> Array(std::string_view key, bool required = true) {
+    const auto* meta = gguf.FindMetadata(key);
+    std::vector<double> out;
+    if (meta == nullptr) {
+      if (required)
+        Fail("missing GGUF array " + std::string(key));
+      return out;
+    }
+    const auto* u64 = std::get_if<std::vector<std::uint64_t>>(&meta->value);
+    const auto* i64 = std::get_if<std::vector<std::int64_t>>(&meta->value);
+    const auto* f64 = std::get_if<std::vector<double>>(&meta->value);
+    if (u64 != nullptr) {
+      out.insert(out.end(), u64->begin(), u64->end());
+    } else if (i64 != nullptr) {
+      for (auto v : *i64) {
+        if (v < 0) {
+          Fail("negative GGUF array value " + std::string(key));
+          return {};
+        }
+        out.push_back(static_cast<double>(v));
+      }
+    } else if (f64 != nullptr) {
+      out = *f64;
+    } else {
+      Fail("GGUF array must be numeric: " + std::string(key));
+    }
+    return out;
+  }
+
+  /// One value per block, from a per-block array or a scalar key.
+  double PerBlock(std::string_view key, std::uint32_t blocks, double fallback,
+                  bool required) {
+    const auto* meta = gguf.FindMetadata(key);
+    if (meta == nullptr) {
+      if (required)
+        Fail("missing GGUF key " + std::string(key));
+      return fallback;
+    }
+    if (const auto* u = std::get_if<std::uint64_t>(&meta->value)) {
+      return static_cast<double>(*u);
+    }
+    if (const auto* i = std::get_if<std::int64_t>(&meta->value)) {
+      return static_cast<double>(*i);
+    }
+    if (const auto* f = std::get_if<double>(&meta->value)) {
+      return *f;
+    }
+    const auto values = Array(key, true);
+    if (!ok) {
+      return fallback;
+    }
+    if (values.size() == blocks) {
+      const double first = values.front();
+      for (double v : values) {
+        if (v != first || !std::isfinite(v)) {
+          Fail("GGUF array must be uniform and finite: " + std::string(key));
+          return fallback;
+        }
+      }
+      return first;
+    }
+    if (values.size() == 1) {
+      return values.front();
+    }
+    Fail("GGUF array length must match block_count: " + std::string(key));
+    return fallback;
+  }
+};
+
+}  // namespace
+
+std::uint32_t Config::DsaLayerCount() const noexcept {
+  return static_cast<std::uint32_t>(
+      std::count(dsa_layer.begin(), dsa_layer.end(), true));
+}
+
+std::uint32_t Config::KdaLayerCount() const noexcept {
+  return num_layers - DsaLayerCount();
+}
+
+std::optional<Config> Config::FromGguf(const core::GgufReader& gguf,
+                                       std::string* error_msg) {
+  Reader r{gguf, error_msg};
+  if (gguf.GetMetadataString("general.architecture") != kArchitecture) {
+    r.Fail("GGUF architecture is not glm5-next");
+    return std::nullopt;
+  }
+
+  Config c;
+  const std::string_view p = "glm5-next.";
+  auto key = [&](std::string_view suffix) {
+    return std::string(p) + std::string(suffix);
+  };
+
+  const std::uint32_t block_count = r.U32(key("block_count"));
+  c.nextn_layers = r.U32(key("nextn_predict_layers"), false, 0);
+  if (block_count == 0 || c.nextn_layers >= block_count) {
+    r.Fail("glm5-next block_count must exceed nextn_predict_layers");
+    return std::nullopt;
+  }
+  c.num_layers = block_count - c.nextn_layers;
+  c.hidden_size = r.U32(key("embedding_length"));
+  c.vocab_size = r.U32(key("vocab_size"));
+  c.context_length = r.U32(key("context_length"));
+  c.rms_eps = r.F32(key("attention.layer_norm_rms_epsilon"), 1e-5F);
+  c.layer_norm_eps = r.F32(key("attention.layer_norm_epsilon"), 1e-6F);
+
+  // Layer kinds come from the per-block kv-head array: zero on KDA layers,
+  // nonzero on DSA layers. Trunk entries only.
+  const auto kv_heads = r.Array(key("attention.head_count_kv"));
+  if (!r.ok)
+    return std::nullopt;
+  if (kv_heads.size() != block_count) {
+    r.Fail("glm5-next attention.head_count_kv must describe every block");
+    return std::nullopt;
+  }
+  c.dsa_layer.resize(c.num_layers);
+  for (std::uint32_t i = 0; i < c.num_layers; ++i) {
+    c.dsa_layer[i] = kv_heads[i] != 0;
+  }
+
+  c.head_count = r.U32(key("attention.head_count"));
+  c.q_lora_rank = r.U32(key("attention.q_lora_rank"));
+  c.kv_lora_rank = r.U32(key("attention.kv_lora_rank"));
+  c.qk_nope_head_dim = r.U32(key("attention.key_length_mla"));
+  c.v_head_dim = r.U32(key("attention.value_length_mla"));
+  const std::uint32_t key_length = r.U32(key("attention.key_length"));
+  const std::uint32_t value_length = r.U32(key("attention.value_length"));
+  const std::uint32_t rotary = r.U32(key("rope.dimension_count"));
+  if (rotary != 0 || key_length != c.kv_lora_rank ||
+      value_length != c.kv_lora_rank || c.qk_nope_head_dim == 0 ||
+      c.v_head_dim == 0) {
+    r.Fail("glm5-next MLA must be nope-only with matching latent widths");
+    return std::nullopt;
+  }
+
+  c.kda_head_dim = r.U32(key("kda.head_dim"));
+  c.kda_conv_kernel = r.U32(key("ssm.conv_kernel"));
+  c.kda_gate_lower_bound = r.F32(key("kda.gate_lower_bound"), -5.0F);
+
+  c.indexer_heads = r.U32(key("attention.indexer.head_count"));
+  c.indexer_head_dim = r.U32(key("attention.indexer.key_length"));
+  c.indexer_top_k = r.U32(key("attention.indexer.top_k"));
+  c.indexer_kpool = r.U32(key("attention.indexer.kpool"));
+  c.indexer_select_tail =
+      r.Bool(key("attention.indexer.kpool_select_tail"), true);
+  if (c.indexer_kpool <= 1 || c.indexer_top_k % c.indexer_kpool != 0) {
+    r.Fail("glm5-next indexer kpool must divide top_k");
+    return std::nullopt;
+  }
+  // Only full indexers are supported; the array is optional.
+  if (gguf.FindMetadata(key("attention.indexer.types")) != nullptr) {
+    const auto types = r.Array(key("attention.indexer.types"));
+    if (!r.ok)
+      return std::nullopt;
+    if (types.size() != c.num_layers) {
+      r.Fail("glm5-next indexer.types must describe every trunk layer");
+      return std::nullopt;
+    }
+    for (double kind : types) {
+      if (kind == 0) {
+        r.Fail("shared (non-full) indexer layers are not supported");
+        return std::nullopt;
+      }
+    }
+  }
+
+  c.hc_count = r.U32(key("hyper_connection.count"));
+  c.hc_sinkhorn_iters = r.U32(key("hyper_connection.sinkhorn_iterations"));
+  c.hc_eps = r.F32(key("hyper_connection.epsilon"), 1e-6F);
+  if (c.hc_count != 4) {
+    r.Fail("glm5-next hyper_connection.count must be 4");
+    return std::nullopt;
+  }
+
+  c.dense_lead = r.U32(key("leading_dense_block_count"), false, 0);
+  c.dense_ffn = r.U32(key("feed_forward_length"));
+  c.expert_count = r.U32(key("expert_count"));
+  c.experts_used = r.U32(key("expert_used_count"));
+  c.shared_experts = r.U32(key("expert_shared_count"), false, 1);
+  c.expert_ffn = r.U32(key("expert_feed_forward_length"));
+  const std::uint32_t gating = r.U32(key("expert_gating_func"), false, 2);
+  if (gating != 2) {
+    r.Fail("only sigmoid expert gating (noaux_tc) is supported");
+    return std::nullopt;
+  }
+  c.expert_group_count = r.U32(key("expert_group_count"), false, 1);
+  c.expert_group_used_count = r.U32(key("expert_group_used_count"), false, 1);
+  if (c.expert_group_count != 1 || c.expert_group_used_count != 1) {
+    r.Fail("grouped expert routing is not supported (n_group must be 1)");
+    return std::nullopt;
+  }
+  c.routed_scaling = r.F32(key("expert_weights_scale"), 1.0F);
+  const bool weights_norm = r.Bool(key("expert_weights_norm"), true);
+  if (!weights_norm) {
+    r.Fail("normalized top-k routing is required");
+    return std::nullopt;
+  }
+  const double clamp_exp =
+      r.PerBlock(key("swiglu_clamp_exp"), block_count, 0.0, true);
+  if (!r.ok)
+    return std::nullopt;
+  if (gguf.FindMetadata(key("swiglu_clamp_shexp")) != nullptr) {
+    const double clamp_shexp =
+        r.PerBlock(key("swiglu_clamp_shexp"), block_count, clamp_exp, true);
+    if (!r.ok || clamp_shexp != clamp_exp) {
+      r.Fail("shared and routed SwiGLU clamps must agree");
+      return std::nullopt;
+    }
+  }
+  c.swiglu_limit = static_cast<float>(clamp_exp);
+
+  // Structural geometry the kernels and the TP plan rely on.
+  if (c.hidden_size == 0 || c.vocab_size == 0 || c.context_length < 2 ||
+      c.head_count == 0 || c.head_count % 2 != 0 || c.kda_head_dim == 0 ||
+      c.kda_conv_kernel < 2 || c.kda_gate_lower_bound >= 0.0F ||
+      c.indexer_heads == 0 || c.indexer_head_dim == 0 ||
+      c.dense_lead > c.num_layers || c.expert_count == 0 ||
+      c.experts_used == 0 || c.experts_used > c.expert_count ||
+      c.expert_ffn == 0 || c.dense_ffn == 0 || c.KdaInnerDim() == 0 ||
+      c.MlaQueryDim() == 0) {
+    r.Fail("glm5-next structural configuration is invalid");
+    return std::nullopt;
+  }
+
+  std::set<std::uint32_t> eos;
+  for (const std::string_view name :
+       {"eos_token_id", "eom_token_id", "eot_token_id"}) {
+    if (const auto id =
+            gguf.GetMetadataUint32("tokenizer.ggml." + std::string(name));
+        id.has_value()) {
+      eos.insert(*id);
+    }
+  }
+  c.eos_token_ids.assign(eos.begin(), eos.end());
+
+  if (!r.ok) {
+    return std::nullopt;
+  }
+  return c;
+}
+
+}  // namespace gufo::models::glm5_next
