+class GlmTextRunner final : public HipTextModelRunner {
+public:
+  sampling::JsonConstraint::ToolFormat ToolFormat() const override {
+    return sampling::JsonConstraint::ToolFormat::kGlm;
+  }
+
+  GlmTextRunner(std::shared_ptr<models::glm5_next::Model> model,
+                std::string model_id)
+      : model_(std::move(model)),
+        model_id_(std::move(model_id)),
+        max_context_(model_->MaxContext()),
+        prefill_chunk_(model_->PrefillChunk()) {}
+
+  [[nodiscard]] TextRunnerDescriptor Descriptor() const override {
+    return {
+        .model_id = model_id_,
+        .state_abi = std::string(kGlmStateAbi),
+        .max_context = max_context_,
+        .prefill_chunk_tokens = prefill_chunk_,
+        .capabilities =
+            TextRunnerCapabilities{
+                .incremental_prefill = true,
+                .snapshot = false,
+                .fork = false,
+                .final_token_advance_required = true,
+                .incremental_text_is_exact = true,
+                .multi_token_decode = false,
+                .batched_multi_token_decode = false,
+                .batched_multi_token_decode_max_width = 0,
+                .prefix_reuse = true,
+            },
+        .persistence = std::nullopt,
+    };
+  }
+
+  [[nodiscard]] TextRunnerResourceClaim ResourceClaim() const override {
+    std::size_t free_bytes = 0;
+    std::size_t total_bytes = 0;
+    std::optional<std::size_t> capacity;
+    if (hipMemGetInfo(&free_bytes, &total_bytes) == hipSuccess) {
+      capacity = free_bytes;
+    }
+    // Weights and the shared executor working set are resident at model load;
+    // per-request state is the session's compact caches and KDA state.
+    return {
+        .resident_weights_bytes = model_->ResidentBytes(),
+        .state_capacity_bytes = capacity,
+        .per_request_state_bytes = model_->SessionBytes(max_context_),
+        .temporary_scratch_bytes = 0,
+        .retained_snapshot_capacity_bytes = 0,
+        .retained_snapshot_ceiling_bytes = 0,
+        .requires_device_runtime_lock = false,
+    };
+  }
+
+  [[nodiscard]] std::vector<TextExecutionPlan> SupportedPlans() const override {
+    // Autoregressive only: one serial plan.
+    return std::vector<TextExecutionPlan>{
+        {.kind = TextExecutionPlanKind::kSerial, .physical_width = 1}};
+  }
+
+  [[nodiscard]] std::shared_ptr<const sampling::ConstraintVocabulary>
+  BuildConstraintVocabulary() const override {
+    return std::make_shared<const sampling::ConstraintVocabulary>(
+        model_->VocabSize(), [this](std::uint32_t id) {
+          return sampling::ConstraintVocabulary::Piece{
+              model_->TokenText(static_cast<std::int32_t>(id)),
+              model_->IsStopToken(static_cast<std::int32_t>(id))};
+        });
+  }
+
+  [[nodiscard]] std::string ConstraintVocabularyFingerprint() const override {
+    // FNV-1a over exactly what BuildConstraintVocabulary reads: token id,
+    // piece bytes and stop bit, as the Qwen runner fingerprints its own.
+    const auto size = model_->VocabSize();
+    std::uint64_t hash = 1469598103934665603ULL;
+    const auto mix = [&hash](const void* data, std::size_t bytes) {
+      for (const auto byte :
+           std::span(static_cast<const std::uint8_t*>(data), bytes)) {
+        hash ^= byte;
+        hash *= 1099511628211ULL;
+      }
+    };
+    mix(&size, sizeof(size));
+    for (std::uint32_t id = 0; id < size; ++id) {
+      const auto piece = model_->TokenText(static_cast<std::int32_t>(id));
+      mix(&id, sizeof(id));
+      mix(piece.data(), piece.size());
+      const bool stop = model_->IsStopToken(static_cast<std::int32_t>(id));
+      mix(&stop, sizeof(stop));
+    }
+    return std::to_string(hash);
+  }
+
+  [[nodiscard]] std::vector<TextRunnerToken> Tokenize(
+      std::string_view text) const override {
+    const auto ids = model_->Tokenize(text);
+    return std::vector<TextRunnerToken>(ids.begin(), ids.end());
+  }
+
+  [[nodiscard]] std::optional<std::vector<TextRunnerToken>> RenderAndTokenize(
+      const ChatRequest& request) const override {
+    if (request.reasoning.enabled.has_value() && !*request.reasoning.enabled) {
+      throw std::invalid_argument(
+          "GLM-5.3-Flash always reasons; thinking cannot be disabled for it");
+    }
+    std::vector<models::glm5_next::ChatMessage> messages;
+    messages.reserve(request.messages.size());
+    for (const auto& message : request.messages) {
+      models::glm5_next::ChatMessage converted{
+          .role = message.role == tokenization::ChatRole::kDeveloper
+                      ? "system"
+                      : std::string(ChatRoleName(message.role)),
+          .content = message.content + message.framing_suffix,
+          .reasoning_content = message.thought,
+          .tool_calls = {},
+          .tool_call_id = message.tool_call_id,
+      };
+      converted.tool_calls.reserve(message.tool_calls.size());
+      for (const auto& call : message.tool_calls) {
+        models::glm5_next::ChatMessage::ToolCall converted_call{
+            .name = call.name,
+            .arguments = {},
+            .id = call.id,
+        };
+        converted_call.arguments.reserve(call.arguments.size());
+        for (const auto& argument : call.arguments) {
+          converted_call.arguments.push_back({
+              .name = argument.name,
+              .value = argument.value,
+              .is_string = argument.is_string,
+          });
+        }
+        converted.tool_calls.push_back(std::move(converted_call));
+      }
+      messages.push_back(std::move(converted));
+    }
+    std::vector<models::glm5_next::ChatTool> tools;
+    if (request.tool_choice != ChatRequest::ToolChoice::kNone) {
+      tools.reserve(request.tools.size());
+      for (const auto& tool : request.tools) {
+        tools.push_back({
+            .name = tool.name,
+            .description = tool.description,
+            .parameters_json = tool.parameters_json,
+        });
+      }
+    }
+    auto options = models::glm5_next::ResolveChatOptions(request.reasoning);
+    options.add_generation_prompt = true;
+    const auto rendered =
+        models::glm5_next::RenderChat(messages, tools, options);
+    const auto ids = model_->Tokenize(rendered);
+    if (ids.size() > max_context_) {
+      throw std::length_error("GLM-5.3-Flash prompt exceeds the context");
+    }
+    return std::vector<TextRunnerToken>(ids.begin(), ids.end());
+  }
+
+  [[nodiscard]] TextGenerationBackend::InitialOutputState InitialOutputState(
+      const ChatRequest&) const override {
+    // The pinned template always opens the assistant turn with <think>.
+    return TextGenerationBackend::InitialOutputState::kReasoning;
+  }
+
+  [[nodiscard]] std::string Decode(
+      std::span<const TextRunnerToken> tokens) const override {
+    std::vector<std::int32_t> ids;
+    ids.reserve(tokens.size());
+    for (const TextRunnerToken token : tokens) {
+      if (token > static_cast<TextRunnerToken>(
+                      std::numeric_limits<std::int32_t>::max())) {
+        throw std::invalid_argument("GLM token ID exceeds engine range");
+      }
+      ids.push_back(static_cast<std::int32_t>(token));
+    }
+    return model_->Decode(ids);
+  }
+
+  [[nodiscard]] std::unique_ptr<TextRunnerState> CreateState() const override {
+    return std::make_unique<GlmTextRunnerState>(model_, max_context_);
+  }
+
+  [[nodiscard]] TextPrefillStep Prefill(
+      TextRunnerState& state, std::span<const TextRunnerToken> prompt,
+      std::size_t offset, std::size_t max_input_tokens) const override {
+    auto& glm = RequireGlmState(state);
+    if (offset != glm.position()) {
+      throw std::logic_error(
+          "GLM-5.3-Flash prefill offset does not match retained state");
+    }
+    if (offset >= prompt.size()) {
+      throw std::logic_error("GLM-5.3-Flash prefill has no remaining input");
+    }
+    const std::size_t consumed = std::min<std::size_t>(
+        {max_input_tokens, prompt.size() - offset, prefill_chunk_});
+    const std::size_t next_position = offset + consumed;
+    std::vector<std::int32_t> prefix;
+    prefix.reserve(next_position);
+    for (const TextRunnerToken token : prompt.first(next_position)) {
+      if (token >= model_->VocabSize()) {
+        throw std::invalid_argument("GLM token ID exceeds the vocabulary");
+      }
+      prefix.push_back(static_cast<std::int32_t>(token));
+    }
+    std::string error;
+    if (!glm.session().Sync(prefix, &error)) {
+      glm.set_position(0);
+      throw std::runtime_error("GLM-5.3-Flash prefill failed: " + error);
+    }
+    glm.set_position(next_position);
+    return {
+        .consumed_tokens = consumed,
+        .decode_ready = next_position == prompt.size(),
+    };
+  }
+
+  [[nodiscard]] TextDecodeSelection SelectNext(
+      TextRunnerState& state, sampling::SamplerState& sampler) const override {
+    auto& glm = RequireGlmState(state);
+    if (glm.position() >= max_context_) {
+      return {.stop = true, .piece = {}};
+    }
+    const auto logits = glm.session().Logits();
+    if (logits.empty()) {
+      throw std::runtime_error("GLM-5.3-Flash token selection has no logits");
+    }
+    const auto token = static_cast<std::int32_t>(sampler.Sample(logits));
+    if (EndsTurn(glm, *model_, token)) {
+      return {.stop = true, .token = 0, .piece = {}};
+    }
+    return {
+        .stop = false,
+        .token = static_cast<TextRunnerToken>(token),
+        .piece = model_->TokenText(token),
+    };
+  }
+
+  void Advance(TextRunnerState& state, TextRunnerToken token) const override {
+    if (token > static_cast<TextRunnerToken>(
+                    std::numeric_limits<std::int32_t>::max())) {
+      throw std::invalid_argument("GLM token ID exceeds engine range");
+    }
+    auto& glm = RequireGlmState(state);
+    std::string error;
+    if (!glm.session().Evaluate(static_cast<std::int32_t>(token), &error)) {
+      throw std::runtime_error("GLM-5.3-Flash decode failed: " + error);
+    }
+    glm.set_position(glm.position() + 1);
+  }
+
+  [[nodiscard]] std::optional<TextDecodeSelection> PreviewFirstToken(
+      TextRunnerState& state, sampling::SamplerState& sampler) const override {
+    return SelectNext(state, sampler);
+  }
+
+  [[nodiscard]] std::size_t CheckpointPosition(
+      const TextRunnerState& state) const override {
+    return RequireGlmState(state).position();
+  }
+
+  void PreparePrefixReuse(
+      TextRunnerState& state,
+      std::span<const TextRunnerToken> prefix) const override {
+    const auto& glm = RequireGlmState(state);
+    const auto tokens = glm.session().Tokens();
+    if (!glm.session().valid() || tokens.size() != prefix.size() ||
+        glm.position() != prefix.size() ||
+        !std::equal(tokens.begin(), tokens.end(), prefix.begin())) {
+      throw std::logic_error("GLM reused prefix does not match its checkpoint");
+    }
+  }
+
+  [[nodiscard]] bool CanReuse(const TextRunnerState& state) const override {
+    return RequireGlmState(state).session().valid();
+  }
+
+private:
+  std::shared_ptr<models::glm5_next::Model> model_;
+  std::string model_id_;
+  std::uint32_t max_context_;
+  std::uint32_t prefill_chunk_;
 };
