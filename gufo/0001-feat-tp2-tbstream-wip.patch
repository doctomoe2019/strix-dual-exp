+    }
+  }
+  if (model_path.empty() || fixtures_dir.empty()) {
+    std::fprintf(stderr, "--model and --fixtures are required\n");
+    return 2;
+  }
+  std::vector<std::int32_t> tokens;
+  if (random_count > 0) {
+    std::uint64_t state = random_seed;
+    for (std::uint32_t i = 0; i < random_count; ++i) {
+      state = state * 1664525ULL + 1013904223ULL;
+      tokens.push_back(
+          static_cast<std::int32_t>(1000 + (state >> 33) % 99000U));
+    }
+  } else {
+    tokens = ParseTokens(tokens_arg);
+  }
+
+  std::string error;
+  auto reader = gufo::core::GgufReader::OpenFile(model_path, &error);
+  if (!reader) {
+    Fail("open: " + error);
+    return 1;
+  }
+  auto weights = glm::ModelWeights::Bind(*reader, &error);
+  if (!weights) {
+    Fail("bind: " + error);
+    return 1;
+  }
+  const std::uint32_t layers = 4;
+  auto slice =
+      rocm::DeviceSlice::Upload(*weights, *reader, layers, nullptr, &error);
+  if (!slice) {
+    Fail("slice upload: " + error);
+    return 1;
+  }
+  const glm::Config& c = slice->config();
+  const std::uint32_t hidden = c.hidden_size;
+  const std::uint32_t n = c.hc_count;
+  const std::uint32_t mix_dim = c.HcMixDim();
+  const std::uint32_t inner = c.KdaInnerDim();
+  const std::uint32_t dim = c.kda_head_dim;
+  const std::uint32_t kda_layers = [&] {
+    std::uint32_t count = 0;
+    for (const auto& l : slice->layers()) {
+      count += l.linear ? 1U : 0U;
+    }
+    return count;
+  }();
+  const std::string base_name = fixtures_dir + "/" + trace_name + "." + prefix;
+
+  Buffers buffers;
+  const auto make = [&buffers](std::size_t count) {
+    return static_cast<float*>(buffers.Make(count * sizeof(float)));
+  };
+  auto* streams = make(n * hidden);
+  auto* residual = make(n * hidden);
+  auto* flat = make(n * hidden);
+  auto* mixes = make(mix_dim);
+  auto* hc_pre = make(n);
+  auto* hc_post = make(n);
+  auto* hc_comb = make(n * n);
+  auto* collapsed = make(hidden);
+  auto* block_x = make(hidden);
+  auto* block_out = make(hidden);
+  auto* normed = make(hidden);
+  auto* logits = make(c.vocab_size);
+  // KDA working set (shared across layers) and per-layer persistent state.
+  auto* qkv = make(3 * inner);
+  auto* conv_out = make(3 * inner);
+  auto* raw = make(inner);
+  auto* f_a_out = make(dim);
+  auto* g_a_out = make(dim);
+  auto* beta_row = make(c.head_count);
+  auto* gate = make(inner);
+  auto* beta = make(c.head_count);
+  auto* qn = make(inner);
+  auto* kn = make(inner);
+  auto* core = make(inner);
+  auto* core_normed = make(inner);
+  auto* gated = make(inner);
+  std::vector<float*> kda_history(kda_layers);
+  std::vector<float*> kda_state(kda_layers);
+  for (std::uint32_t l = 0; l < kda_layers; ++l) {
