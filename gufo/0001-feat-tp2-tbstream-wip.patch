+      const std::uint32_t s = e / hidden;
+      const float sc = scale[s];
+      const float4 gm = *reinterpret_cast<const float4*>(gamma + e);
+      n = float4{v[c].x * sc * gm.x, v[c].y * sc * gm.y, v[c].z * sc * gm.z,
+                 v[c].w * sc * gm.w};
