+#ifndef GUFO_MODELS_GLM5_NEXT_KERNELS_ROCM_KERNELS_HPP_
+#define GUFO_MODELS_GLM5_NEXT_KERNELS_ROCM_KERNELS_HPP_
+
+#include <hip/hip_runtime.h>
+
+#include <cstddef>
+#include <cstdint>
+
+#include "src/core/gguf_reader.hpp"
+
+/// Model-private HIP launchers for the GLM-5.3-Flash slice. Activations
+/// are row-major float32; every launch is asynchronous on `stream`.
+/// Weights are device pointers in their GGUF encoding.
+///
+/// Correctness-first phase: reductions mirror the scalar reference's
+/// arithmetic (double accumulation where the reference accumulates in
+/// double, the reference's exact iteration and casting order in the
+/// mHC mixer), so operator outputs are byte-close to the CPU oracle
+/// rather than merely within a loose tolerance.
+namespace gufo::models::glm5_next::rocm {
+
+/// GGUF encodings the slice accepts.
+enum class WeightType : std::uint32_t {
+  kF32 = 0,
+  kQ8_0 = 8,
+  kQ4_K = 12,
+};
+
+[[nodiscard]] inline WeightType WeightTypeOf(core::GgmlType type) noexcept {
+  return static_cast<WeightType>(static_cast<std::uint32_t>(type));
+}
+
+/// streams[s][hidden] = dequantized row `token` of the Q8_0/F32 embedding
+/// table, for s in [0, n_streams).
+void EmbedTokenStreams(const void* table, WeightType type, std::int32_t token,
+                       float* streams, std::uint32_t hidden,
+                       std::uint32_t n_streams, hipStream_t stream);
+
+/// out[row][dim] = gamma[dim] * (x[row][dim] * rsqrt(mean(x^2)+eps)) with
+/// the square sum accumulated in double; `groups` independent norms of
+/// dim/groups consecutive elements share one gamma row; gamma may be null.
+void RmsNormRows(const float* x, const float* gamma, float* out,
+                 std::uint32_t rows, std::uint32_t dim, std::uint32_t groups,
+                 float eps, hipStream_t stream);
+
+/// Centered LayerNorm with weight and bias, mean/variance accumulated in
+/// double (the indexer key norm).
+void LayerNormRows(const float* x, const float* weight, const float* bias,
+                   float* out, std::uint32_t rows, std::uint32_t dim, float eps,
+                   hipStream_t stream);
+
+/// out[m] = sum_k W[m][k] * x[k] over F32 weights, accumulated in double
+/// exactly like the reference's typed dot. One block per row.
+void F32Gemm(const float* w, const float* x, float* out, std::uint32_t m,
+             std::uint32_t k, hipStream_t stream);
+
+/// The mHC mixer of one token: consumes the 24 hc_fn outputs (`mixes`)
+/// with `scale`[3] and `base`[24], reproducing the reference's float/double
+/// arithmetic and Sinkhorn iteration order exactly (sigmoid and softmax in
+/// double where the reference casts to double). Writes pre[n], post[n],
+/// comb[n*n]. Single-threaded by construction; the whole state is 44
+/// floats.
+void HcSinkhorn(const float* mixes, const float* scale, const float* base,
+                float* pre, float* post, float* comb, std::uint32_t n,
+                std::uint32_t sinkhorn_iters, float eps, hipStream_t stream);
+
+/// collapsed[d] = sum_i pre[i] * streams[i][d], accumulated in double.
+void HcCollapse(const float* pre, const float* streams, float* collapsed,
+                std::uint32_t hidden, std::uint32_t n, hipStream_t stream);
+
+/// streams[i][d] = post[i]*block_out[d] + sum_m comb[m][i]*residual[m][d],
+/// accumulated in double (the reference's combine step).
+void HcCombine(const float* post, const float* comb, const float* residual,
+               const float* block_out, float* streams, std::uint32_t hidden,
+               std::uint32_t n, hipStream_t stream);
+
+/// out[d] = mean_i streams[i][d] in double (the slice-exit readout).
+void MeanStreams(const float* streams, float* out, std::uint32_t hidden,
+                 std::uint32_t n, hipStream_t stream);
+
+/// KDA: one causal-conv step per channel with SiLU and history roll.
+/// `qkv` is [3*inner] (q|k|v groups), the tap tensors [inner][kernel] F32,
+/// `history` [(kernel-1)][3*inner] rolls in place, `conv_out` receives the
+/// SiLU outputs. Double accumulation matches the reference.
+void KdaConv(const float* qkv, const float* taps_q, const float* taps_k,
+             const float* taps_v, float* history, float* conv_out,
+             std::uint32_t inner, std::uint32_t kernel, hipStream_t stream);
+
+/// KDA: l2-normalized q (scaled 1/sqrt(dim)) and k per head from the conv
+/// outputs, one thread per head in the reference's sequential float order.
+void KdaPrepare(const float* conv_out, float* qn, float* kn,
+                std::uint32_t heads, std::uint32_t dim, float l2_eps,
+                hipStream_t stream);
+
+/// KDA: decay gates gate[j] = bound * sigmoid(-a[j/dim] * (raw[j] +
+/// dt[j])) from the f_b projection output, and beta[h] =
+/// sigmoid(beta_row[h]).
+void KdaGates(const float* raw, const float* a, const float* dt,
+              const float* beta_row, float bound, float* gate, float* beta,
+              std::uint32_t inner, std::uint32_t dim, hipStream_t stream);
+
+/// KDA: one token of the gated delta rule per head. Channel decay is
+/// applied to each state row before the memory read (rounded and stored
+/// like the reference), the delta update uses the fresh v group, and the
+/// output accumulates per value column in float. `state` is
+/// [heads][dim][dim] FP32 and updates in place.
+void KdaRecurrence(const float* qn, const float* kn, const float* gate,
+                   const float* beta, const float* conv_out, float* state,
+                   float* core, std::uint32_t heads, std::uint32_t dim,
+                   hipStream_t stream);
+
+/// out[i] = x[i] * sigmoid(g[i]).
+void SigmoidMul(const float* x, const float* g, float* out, std::size_t count,
+                hipStream_t stream);
+
+/// out[i] = silu(x[i]) — activation helper (float, as the reference).
+void SiluRows(const float* x, float* out, std::size_t count,
+              hipStream_t stream);
+
+/// DSA indexer: appends the LayerNormed key and gate rows of one token to
+/// the per-token caches. `key_raw`/`gate_raw` are the F32 projection
+/// outputs [idim]; the caches are [pos][idim].
+void IndexerAppend(const float* key_raw, const float* gate_raw,
+                   const float* k_norm_w, const float* k_norm_b, float* keys,
+                   float* gates, std::uint32_t pos, std::uint32_t idim,
+                   float eps, hipStream_t stream);
+
+/// DSA indexer: pools the kpool tokens of pool `pool` (the last complete
+/// one) into `pooled` [pool][idim], softmax over gates+ape per dim with
+/// the reference's float/double split.
+void IndexerPool(const float* keys, const float* gates, const float* ape,
+                 float* pooled, std::uint32_t pool, std::uint32_t kpool,
+                 std::uint32_t idim, hipStream_t stream);
+
+/// DSA indexer: scores every complete pool for this query:
+/// score[p] = sum_h w[h] * relu(float(dot(iq[h], pooled[p])) * scale),
+/// dot in double, accumulated in double.
+void IndexerScores(const float* iq, const float* pooled, const float* weights,
+                   float* scores, std::uint32_t pools, std::uint32_t heads,
+                   std::uint32_t idim, float scale, hipStream_t stream);
+
+/// dst[offset + t * row] = src[t * row] for appending rows to caches.
+void AppendRows(const float* src, float* dst, std::uint32_t row,
+                std::uint32_t offset, std::uint32_t count, hipStream_t stream);
+
+/// out[i] = x[i] * factor.
+void ScaleRows(const float* x, float* out, float factor, std::size_t count,
+               hipStream_t stream);
+
+/// Clamped SwiGLU: out[i] = silu(min(g[i], limit)) * clamp(u[i], -limit,
+/// limit), one rounding per operation like the reference.
+void ClampedSwiglu(const float* g, const float* u, float* out,
+                   std::size_t count, float limit, hipStream_t stream);
+
+/// acc[i] += weight * x[i] with the reference's rounding (product first,
+/// then the accumulate).
+void ScaleAddInto(float* acc, const float* x, float weight, std::size_t count,
+                  hipStream_t stream);
+
+/// acc[i] += peer[i] — folds a rank exchange's peer partial into the local
+/// one. Float addition of two operands is commutative, so both ranks hold
+/// byte-identical sums after their own add.
+void AddInto(float* acc, const float* peer, std::size_t count,
+             hipStream_t stream);
+
