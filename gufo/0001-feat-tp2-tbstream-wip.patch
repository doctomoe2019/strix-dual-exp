+#ifndef GUFO_MODELS_GLM5_NEXT_KERNELS_ROCM_KERNELS_BATCH_HPP_
+#define GUFO_MODELS_GLM5_NEXT_KERNELS_ROCM_KERNELS_BATCH_HPP_
+
