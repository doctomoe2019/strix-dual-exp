+// Process-local device headroom limit for snapshot storage tests. Linked only
+// into the model-local snapshot test, not the model or serving library.
+#include <dlfcn.h>
+#include <hip/hip_runtime.h>
+
+#include <atomic>
+#include <cstddef>
+#include <limits>
+
+namespace {
+std::atomic<std::size_t> free_limit{std::numeric_limits<std::size_t>::max()};
+}  // namespace
+
+/// Caps the free device memory HIP reports; the maximum removes the cap.
+void LimitReportedDeviceFree(std::size_t bytes) {
+  free_limit = bytes;
+}
+
+extern "C" hipError_t hipMemGetInfo(std::size_t* free, std::size_t* total) {
+  using Function = hipError_t (*)(std::size_t*, std::size_t*);
+  static const auto next =
+      reinterpret_cast<Function>(::dlsym(RTLD_NEXT, "hipMemGetInfo"));
+  const auto result = next ? next(free, total) : hipErrorUnknown;
+  if (result == hipSuccess && free != nullptr && *free > free_limit)
+    *free = free_limit;
+  return result;
+}
diff --git a/tests/models/qwen38_flash_next/device_model_test.cpp b/tests/models/qwen38_flash_next/device_model_test.cpp
new file mode 100644
index 00000000..f0ece26f
--- /dev/null
+++ b/tests/models/qwen38_flash_next/device_model_test.cpp
@@ -0,0 +1,278 @@
+#include "src/models/qwen38_flash_next/kernels/rocm/device_model.hpp"
+
+#include <hip/hip_runtime.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <numeric>
+#include <optional>
+#include <stdexcept>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "src/models/qwen38_flash_next/draft_vocab.hpp"
+#include "src/models/qwen38_flash_next/kernels/rocm/executor.hpp"
+#include "src/models/qwen38_flash_next/kernels/rocm/mmq/qfn_mmq.h"
+
+namespace q = gufo::models::qwen38_flash_next;
+namespace {
+
+void Require(bool ok, const std::string& message) {
+  if (!ok)
+    throw std::runtime_error(message);
+}
+
+// Upload needs a file-backed reader, but no full model is needed to check
+// output metadata. The empty GGUF header precedes two synthetic Q8_0 tensors.
+struct Fixture {
+  std::string path;
+  static constexpr std::uint32_t kCols = 2560;
+  static constexpr std::uint32_t kRows = 16;
+  static constexpr std::size_t kRowBytes = kCols / 32 * 34;
+  static constexpr std::size_t kTensorBytes = kRows * kRowBytes;
+  static constexpr std::size_t kHeaderBytes = 32;
+
+  Fixture() {
+    std::string name =
+        (std::filesystem::temp_directory_path() / "gufo-device-model-XXXXXX")
+            .string();
+    const int fd = ::mkstemp(name.data());
+    Require(fd >= 0, "create device-model fixture");
+    ::close(fd);
+    path = name;
+    std::vector<std::uint8_t> bytes(kHeaderBytes + 2 * kTensorBytes);
+    const std::uint32_t magic = 0x46554747, version = 3;
+    std::memcpy(bytes.data(), &magic, sizeof(magic));
+    std::memcpy(bytes.data() + sizeof(magic), &version, sizeof(version));
+    for (std::size_t i = kHeaderBytes; i < bytes.size(); ++i)
+      bytes[i] = static_cast<std::uint8_t>(i * 17 + i / kRowBytes);
+    std::ofstream out(path, std::ios::binary);
+    out.write(reinterpret_cast<const char*>(bytes.data()), bytes.size());
+    Require(out.good(), "write device-model fixture");
+  }
+
+  ~Fixture() { std::remove(path.c_str()); }
+};
+
+void CheckOutput(const Fixture& fixture, bool tied, bool empty_output) {
+  std::string error;
+  auto reader = gufo::core::GgufReader::OpenFile(fixture.path, &error);
+  Require(reader != nullptr, error);
+  const auto* data = static_cast<const std::uint8_t*>(reader->GetData());
+  q::ModelWeights weights;
+  weights.token_embd = {.data = data + Fixture::kHeaderBytes,
+                        .type = gufo::core::GgmlType::kQ8_0,
+                        .cols = Fixture::kCols,
+                        .rows = Fixture::kRows,
+                        .file_offset = Fixture::kHeaderBytes,
+                        .name = "token_embd.weight"};
+  weights.output = weights.token_embd;
+  weights.output.name = "output.weight";
+  if (!tied) {
+    weights.output.data = data + Fixture::kHeaderBytes + Fixture::kTensorBytes;
+    weights.output.file_offset += Fixture::kTensorBytes;
+  }
+  if (empty_output)
+    weights.output.cols = 0;
+  auto model =
+      q::rocm::DeviceModel::Upload(weights, *reader, nullptr, nullptr, &error);
+  Require(model != nullptr, error);
+  if (empty_output) {
+    Require(!model->SetDraftVocab(8, {15}, &error) && !error.empty(),
+            "zero-byte output enabled a draft table");
+    return;
+  }
+  // A lost output byte count used to reduce the 1024-row draft allocation
+  // to its 4096-byte padding, while GEMV still read every encoded row.
+  Require(model->output_row_bytes() == Fixture::kRowBytes,
+          "uploaded output lost its encoded row size");
+  Require((model->output().data == model->token_embd().data) == tied,
+          "output weight sharing changed");
+  Require(model->SetDraftVocab(8, {15}, &error), error);
+  Require(model->draft_output().rows == 8 &&
+              model->draft_output().data == model->output().data,
+          "draft prefix no longer aliases the output head");
+  std::vector<std::uint8_t> row(Fixture::kRowBytes);
+  Require(hipMemcpy(row.data(),
+                    static_cast<const std::uint8_t*>(model->output().data) +
+                        15 * model->output_row_bytes(),
+                    row.size(), hipMemcpyDeviceToHost) == hipSuccess,
+          "download final output row");
+  Require(std::memcmp(row.data(),
+                      static_cast<const std::uint8_t*>(weights.output.data) +
+                          15 * Fixture::kRowBytes,
+                      row.size()) == 0,
+          "output row stride does not address the original GGUF bytes");
+}
+
+// Optional model-backed audit: derive the full output logits independently
+// from the captured head input, then check explicit caps and real adaptive
+// tables in scalar, one-item, all-subset and mixed full/subset batch heads.
+void CheckFixedHeads(const std::string& path, const std::string& mtp_path) {
+  std::string error;
+  auto reader = gufo::core::GgufReader::OpenFile(path, &error);
+  auto sidecar = gufo::core::GgufReader::OpenFile(mtp_path, &error);
+  Require(reader && sidecar, error);
+  auto weights = q::ModelWeights::Bind(*reader, &error);
+  Require(weights.has_value(), error);
+  auto mtp = q::MtpWeights::Bind(*sidecar, weights->config, &error);
+  Require(mtp.has_value(), error);
+  auto device = q::rocm::DeviceModel::Upload(*weights, *reader, &*mtp,
+                                             sidecar.get(), &error);
+  Require(device != nullptr, error);
+  Require(device->SetDraftVocab(q::kMtpDraftVocab, {}, &error), error);
+  const auto& c = weights->config;
+  for (const auto limit : {std::optional<std::uint32_t>{},
+                           std::optional<std::uint32_t>{0},
+                           {7},
+                           {257},
+                           {131072}}) {
+    q::rocm::Executor::Options options;
+    options.max_batch = options.max_logit_rows = options.max_speculative = 8;
+    options.mtp_draft_rows = limit;
+    auto exec = q::rocm::Executor::Create(*device, nullptr, options, &error);
+    Require(exec != nullptr, error);
+    std::array<std::unique_ptr<q::rocm::Session>, 3> sessions;
+    std::array<q::MtpCandidateLogits, 3> scalar, batched;
+    std::array<std::vector<std::int32_t>, 3> extra;
+    extra[0].resize(q::kMtpDraftExtraRows);
+    extra[1].resize(7);
+    for (auto& ids : extra)
+      std::iota(ids.begin(), ids.end(), c.vocab_size - ids.size());
+    std::vector<float> hidden(c.HcDim()), head(c.hidden_size);
+    for (std::size_t i = 0; i < hidden.size(); ++i)
+      hidden[i] = std::sin(float(i) * 0.017F);
+    void* d_hidden = nullptr;
+    void* d_head = nullptr;
+    void* d_logits = nullptr;
+    const auto bytes = qfn_mmq_q8_1_bytes(1, c.hidden_size);
+    void* d_quantized = nullptr;
+    struct Release {
+      std::array<void**, 4> pointers;
+      ~Release() {
+        for (auto p : pointers)
+          (void)hipFree(*p);
+      }
+    } release{{&d_hidden, &d_head, &d_logits, &d_quantized}};
+    Require(
+        hipMalloc(&d_hidden, hidden.size() * sizeof(float)) == hipSuccess &&
+            hipMalloc(&d_head, head.size() * sizeof(float)) == hipSuccess &&
+            hipMalloc(&d_logits, c.vocab_size * sizeof(float)) == hipSuccess &&
+            hipMalloc(&d_quantized, bytes) == hipSuccess,
+        "fixed-head oracle allocations");
+    Require(hipMemcpy(d_hidden, hidden.data(), hidden.size() * sizeof(float),
+                      hipMemcpyHostToDevice) == hipSuccess,
+            "fixed-head input");
+    q::MtpTrace trace;
+    trace.head = head;
+    const std::int32_t token = 42;
+    for (std::size_t i = 0; i < sessions.size(); ++i) {
+      sessions[i] = exec->CreateSession(gufo::core::SessionMode::kSpeculative,
+                                        16, &error);
+      Require(sessions[i] != nullptr, error);
+      if (!limit && i < 2) {
+        const auto ids = std::span(extra[i]);
+        Require(
+            exec->AppendDraftRows(*sessions[i], 0, ids.first(3), &error) &&
+                exec->AppendDraftRows(*sessions[i], 3, ids.subspan(3), &error),
+            error);
+        Require(!exec->AppendDraftRows(*sessions[i], q::kMtpDraftExtraRows,
+                                       ids.first(1), &error),
+                "draft table accepted a write past its last row");
+      }
+      Require(exec->MtpForward(*sessions[i], std::span(&token, 1), 0,
+                               {.candidates = &scalar[i],
+                                .trace = &trace,
+                                .draft_subset = i < 2},
+                               &error, static_cast<float*>(d_hidden)),
+              error);
+    }
+    Require(hipMemcpy(d_head, head.data(), head.size() * sizeof(float),
+                      hipMemcpyHostToDevice) == hipSuccess,
+            "fixed-head mix");
+    Require(qfn_mmq_quantize_q8_1(static_cast<float*>(d_head), d_quantized, 1,
+                                  c.hidden_size, exec->stream()) == 0 &&
+                qfn_mmq_q8_0_dense_vec_preq(
+                    device->output().data, nullptr, d_quantized,
+                    static_cast<float*>(d_logits), c.vocab_size, 1,
+                    c.hidden_size, exec->stream()) == 0,
+            "independent full-head projection");
+    Require(hipStreamSynchronize(exec->stream()) == hipSuccess,
+            "full-head oracle synchronization");
+    std::vector<float> logits(c.vocab_size);
+    Require(hipMemcpy(logits.data(), d_logits, logits.size() * sizeof(float),
+                      hipMemcpyDeviceToHost) == hipSuccess,
+            "full-head logits");
+    const auto check = [&](const q::MtpCandidateLogits& actual,
+                           std::size_t item) {
+      const auto rows = !limit && item < 2 ? q::kMtpDraftVocab
+                        : limit.value_or(0) == 0
+                            ? c.vocab_size
+                            : std::min(*limit, c.vocab_size);
+      std::vector<std::uint32_t> ids(rows);
+      std::iota(ids.begin(), ids.end(), 0);
+      if (!limit && item < 2)
+        ids.insert(ids.end(), extra[item].begin(), extra[item].end());
+      const auto count = std::min<std::size_t>(q::kMtpCandidates, ids.size());
+      std::partial_sort(
+          ids.begin(), ids.begin() + count, ids.end(), [&](auto a, auto b) {
+            return logits[a] != logits[b] ? logits[a] > logits[b] : a < b;
+          });
+      Require(actual.size == count, "draft-head candidate count");
+      for (std::size_t i = 0; i < count; ++i)
+        Require(
+            actual.ids[i] == ids[i] && actual.logits[i] == logits[ids[i]],
+            "draft candidates do not match independently selected full logits");
+    };
+    for (std::size_t i = 0; i < scalar.size(); ++i)
+      check(scalar[i], i);
+    std::array<q::rocm::Executor::MtpHeadItem, 3> items;
+    for (std::size_t i = 0; i < items.size(); ++i)
+      items[i] = {sessions[i].get(),
+                  {.candidates = &batched[i], .draft_subset = i < 2}};
+    Require(exec->MtpHeads(std::span(items).first(1), &error), error);
+    check(batched[0], 0);
+    Require(exec->MtpHeads(std::span(items).first(2), &error), error);
+    check(batched[0], 0);
+    check(batched[1], 1);
+    Require(exec->MtpHeads(items, &error), error);
+    for (std::size_t i = 0; i < batched.size(); ++i)
+      check(batched[i], i);
+    std::cout << "draft head policy="
+              << (limit ? std::to_string(*limit) : "adaptive")
+              << " scalar/single/subset/mixed match full-logit oracle\n"
+              << std::flush;
+  }
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+  try {
+    Fixture fixture;
+    CheckOutput(fixture, false, false);
+    CheckOutput(fixture, true, false);
+    CheckOutput(fixture, false, true);
+    if (argc == 5 && std::string_view(argv[1]) == "--model" &&
+        std::string_view(argv[3]) == "--mtp-model")
+      CheckFixedHeads(argv[2], argv[4]);
+    else
+      Require(argc == 1,
+              "usage: device_model_test [--model GGUF --mtp-model GGUF]");
+    std::cout << "output row bytes and draft vocabulary validation passed\n";
+    return 0;
+  } catch (const std::exception& e) {
+    std::cerr << e.what() << '\n';
+    return 1;
+  }
+}
