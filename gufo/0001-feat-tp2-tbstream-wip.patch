+      }
+    }
+    float4 vj[kStreams];
+#pragma unroll
+    for (std::uint32_t s = 0; s < kStreams; ++s) {
+      vj[s] = live ? Load4(s_xn + (static_cast<std::size_t>(s) * hidden) + i)
+                   : float4{0.0F, 0.0F, 0.0F, 0.0F};
+    }
+#pragma unroll
+    for (std::uint32_t o = 0; o < kStreams; ++o) {
+      float dot = 0.0F;
+#pragma unroll
+      for (std::uint32_t s = 0; s < kStreams; ++s) {
+        dot += wq[o][s].x * vj[s].x;
+        dot += wq[o][s].y * vj[s].y;
+        dot += wq[o][s].z * vj[s].z;
+        dot += wq[o][s].w * vj[s].w;
