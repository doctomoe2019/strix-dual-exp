@@ -0,0 +1,189 @@
+#include "src/models/glm5_next/distributed/tp_plan.hpp"
+
+#include <string>
+#include <utility>
+
+#include "src/core/quant/ggml_dequant.hpp"
+
+namespace gufo::models::glm5_next::distributed {
+namespace {
+
+void SetError(std::string* error, std::string message) {
+  if (error != nullptr) {
+    *error = std::move(message);
+  }
+}
+
+/// Bytes of `elements` consecutive values of one row, or zero when the
+/// count is not a whole number of quantization blocks.
+std::size_t SpanBytes(core::GgmlType type, std::size_t elements) {
+  switch (type) {
+    case core::GgmlType::kF32:
+    case core::GgmlType::kI32:
+      return elements * 4;
+    case core::GgmlType::kF16:
+    case core::GgmlType::kBF16:
+      return elements * 2;
+    default:
+      return gufo::quant::QuantizedRowBytes(type, elements);
+  }
+}
+
+struct LedgerBuilder {
+  TpLedger ledger;
+  std::uint32_t world{1};
+  std::string* error;
+  bool ok{true};
+
+  void Fail(const std::string& message) {
+    if (ok) {
+      SetError(error, message);
+    }
+    ok = false;
+  }
+
+  void Add(std::size_t TpLedger::* bucket, const TensorRef& t) {
+    ledger.*bucket += t.SizeBytes();
+    ++ledger.tensor_count;
+  }
+
+  void Replicated(const TensorRef& t) { Add(&TpLedger::replicated_bytes, t); }
+  void Excluded(const TensorRef& t) { Add(&TpLedger::excluded_bytes, t); }
+
+  /// Output rows [begin, begin + rows/world): contiguous file range.
+  void RowSplit(const TensorRef& t) {
+    if (world > 1 && (t.rows == 0 || t.rows % world != 0)) {
+      Fail("row split of " + std::string(t.name) + " is not even");
+      return;
+    }
+    Add(&TpLedger::row_split_bytes, t);
+  }
+
+  /// Reduction columns [0, cols/world): whole quantization blocks only.
+  void ColSplit(const TensorRef& t) {
+    if (world > 1 &&
+        (t.cols == 0 ||
+         SpanBytes(t.type, static_cast<std::size_t>(t.cols) / world) == 0)) {
+      Fail("column split of " + std::string(t.name) +
+           " does not fall on quantization-block boundaries");
+      return;
+    }
+    Add(&TpLedger::col_split_bytes, t);
+  }
+
+  /// Whole per-head matrices on the ne[2] axis.
+  void HeadSplit(const TensorRef& t) {
+    if (world > 1 && (t.experts == 0 || t.experts % world != 0)) {
+      Fail("head split of " + std::string(t.name) + " is not even");
+      return;
+    }
+    Add(&TpLedger::head_split_bytes, t);
+  }
+};
+
+void AddLayer(LedgerBuilder& b, const LayerWeights& l, bool excluded) {
+  const auto add = [&](auto bucket, const TensorRef& t) {
+    if (excluded) {
+      b.Excluded(t);
+    } else {
+      (b.*bucket)(t);
+    }
+  };
+  add(&LedgerBuilder::Replicated, l.attn_norm);
+  add(&LedgerBuilder::Replicated, l.ffn_norm);
+  add(&LedgerBuilder::Replicated, l.hc_attn.fn);
+  add(&LedgerBuilder::Replicated, l.hc_attn.base);
+  add(&LedgerBuilder::Replicated, l.hc_attn.scale);
+  add(&LedgerBuilder::Replicated, l.hc_ffn.fn);
+  add(&LedgerBuilder::Replicated, l.hc_ffn.base);
+  add(&LedgerBuilder::Replicated, l.hc_ffn.scale);
+  if (l.linear) {
+    add(&LedgerBuilder::RowSplit, l.kda.q);
+    add(&LedgerBuilder::RowSplit, l.kda.k);
+    add(&LedgerBuilder::RowSplit, l.kda.v);
+    // wo reduces over the rank's head half; partial outputs exchange.
+    add(&LedgerBuilder::ColSplit, l.kda.out);
+    add(&LedgerBuilder::ColSplit, l.kda.conv_q);
+    add(&LedgerBuilder::ColSplit, l.kda.conv_k);
+    add(&LedgerBuilder::ColSplit, l.kda.conv_v);
+    add(&LedgerBuilder::Replicated, l.kda.f_a);
+    add(&LedgerBuilder::RowSplit, l.kda.f_b);
+    add(&LedgerBuilder::Replicated, l.kda.g_a);
+    add(&LedgerBuilder::RowSplit, l.kda.g_b);
+    add(&LedgerBuilder::RowSplit, l.kda.beta);
+    // Per-head decay scalars: each rank consumes only its heads' values.
+    add(&LedgerBuilder::ColSplit, l.kda.a);
+    add(&LedgerBuilder::ColSplit, l.kda.dt_bias);
+    add(&LedgerBuilder::Replicated, l.kda.o_norm);
+  } else {
+    add(&LedgerBuilder::Replicated, l.dsa.q_a);
+    add(&LedgerBuilder::Replicated, l.dsa.q_a_norm);
+    add(&LedgerBuilder::RowSplit, l.dsa.q_b);
+    add(&LedgerBuilder::Replicated, l.dsa.kv_a);
+    add(&LedgerBuilder::Replicated, l.dsa.kv_a_norm);
+    add(&LedgerBuilder::HeadSplit, l.dsa.k_b);
+    add(&LedgerBuilder::HeadSplit, l.dsa.v_b);
+    // As with KDA wo: the output projection reduces over the rank's heads.
+    add(&LedgerBuilder::ColSplit, l.dsa.out);
+    add(&LedgerBuilder::Replicated, l.indexer.q_b);
+    add(&LedgerBuilder::Replicated, l.indexer.k);
+    add(&LedgerBuilder::Replicated, l.indexer.k_norm);
+    add(&LedgerBuilder::Replicated, l.indexer.k_norm_bias);
+    add(&LedgerBuilder::Replicated, l.indexer.proj);
+    add(&LedgerBuilder::Replicated, l.indexer.comp_gate);
+    add(&LedgerBuilder::Replicated, l.indexer.comp_ape);
+  }
+  if (l.dense_ffn) {
+    add(&LedgerBuilder::RowSplit, l.ffn_gate);
+    add(&LedgerBuilder::RowSplit, l.ffn_up);
+    add(&LedgerBuilder::ColSplit, l.ffn_down);
+    return;
+  }
+  add(&LedgerBuilder::Replicated, l.router);
+  add(&LedgerBuilder::Replicated, l.router_bias);
+  add(&LedgerBuilder::RowSplit, l.gate_exps);
+  add(&LedgerBuilder::RowSplit, l.up_exps);
+  add(&LedgerBuilder::ColSplit, l.down_exps);
+  add(&LedgerBuilder::RowSplit, l.gate_shexp);
+  add(&LedgerBuilder::RowSplit, l.up_shexp);
+  add(&LedgerBuilder::ColSplit, l.down_shexp);
+}
+
+}  // namespace
+
+std::optional<TpLedger> PlanTpLedger(const ModelWeights& weights,
+                                     std::uint32_t world_size,
+                                     std::string* error) {
+  if (world_size != 1 && world_size != 2) {
+    SetError(error, "GLM TP plan supports world size 1 or 2");
+    return std::nullopt;
+  }
+  const Config& c = weights.config;
+  if (c.head_count == 0 || c.head_count % world_size != 0) {
+    SetError(error, "GLM head count does not halve across the ranks");
+    return std::nullopt;
+  }
+  LedgerBuilder b{{}, world_size, error, true};
+  b.Replicated(weights.token_embd);
+  b.Replicated(weights.output);
+  b.Replicated(weights.output_norm);
+  for (const auto& l : weights.layers) {
+    AddLayer(b, l, false);
+    if (!b.ok) {
+      return std::nullopt;
+    }
+  }
+  if (weights.nextn.has_value()) {
+    b.Excluded(weights.nextn->eh_proj);
+    b.Excluded(weights.nextn->enorm);
+    b.Excluded(weights.nextn->hnorm);
+    b.Excluded(weights.nextn->shared_head_norm);
+    AddLayer(b, weights.nextn->block, true);
+    if (!b.ok) {
+      return std::nullopt;
+    }
+  }
+  return b.ledger;
+}
+
+}  // namespace gufo::models::glm5_next::distributed
