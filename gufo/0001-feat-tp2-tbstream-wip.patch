+class GlmTextRunnerState final : public TextRunnerState {
+public:
+  GlmTextRunnerState(std::shared_ptr<const models::glm5_next::Model> model,
+                     std::uint32_t max_context)
+      : model_(std::move(model)) {
+    std::string error;
+    session_ = model_->CreateSession(max_context, &error);
+    if (session_ == nullptr) {
+      throw std::runtime_error("Failed to create GLM-5.3-Flash session: " +
+                               error);
+    }
+  }
+
+  void Invalidate() noexcept override {
+    session_->Reset();
+    position_ = 0;
+  }
+
+  [[nodiscard]] TextRunnerMeasuredResources MeasuredResources()
+      const noexcept override {
+    return {.per_request_state_bytes = session_->StateBytes(),
+            .temporary_scratch_bytes = 0};
+  }
+
+  [[nodiscard]] models::glm5_next::Session& session() const {
+    return *session_;
+  }
+  [[nodiscard]] std::size_t position() const noexcept { return position_; }
+  void set_position(std::size_t position) noexcept { position_ = position; }
+
+private:
+  std::shared_ptr<const models::glm5_next::Model> model_;
+  std::unique_ptr<models::glm5_next::Session> session_;
+  std::size_t position_{0};
+};
+
+GlmTextRunnerState& RequireGlmState(TextRunnerState& state) {
+  auto* glm = dynamic_cast<GlmTextRunnerState*>(&state);
+  if (glm == nullptr) {
+    throw std::logic_error("text runner state is not GLM-5.3-Flash");
+  }
+  return *glm;
+}
+
+const GlmTextRunnerState& RequireGlmState(const TextRunnerState& state) {
+  const auto* glm = dynamic_cast<const GlmTextRunnerState*>(&state);
+  if (glm == nullptr) {
+    throw std::logic_error("text runner state is not GLM-5.3-Flash");
+  }
+  return *glm;
+}
+
+models::glm5_next::ModelOptions::AllReduce MakeGlmAllReduce(
+    const std::shared_ptr<models::qwen38_flash_next::rocm::Communicator>&
+        communicator,
+    std::uint32_t hidden) {
+  return [communicator, hidden](float* data, std::uint32_t rows,
+                                ihipStream_t* stream_ptr,
+                                std::string* error) -> bool {
+    const auto stream = reinterpret_cast<hipStream_t>(stream_ptr);
+    const std::size_t count = static_cast<std::size_t>(rows) * hidden;
+    const std::size_t bytes = count * sizeof(float);
+    auto wire = models::qwen38_flash_next::rocm::TbstreamWire::kF32;
+    const float* peer =
+        communicator->ExchangePartial(data, bytes, &wire, stream, error);
+    if (peer == nullptr) {
+      return false;
+    }
+    if (wire != models::qwen38_flash_next::rocm::TbstreamWire::kF32) {
+      if (error != nullptr) {
+        *error = "GLM-5.3-Flash TP2 requires the f32 tbstream wire";
+      }
+      return false;
+    }
+    models::glm5_next::rocm::AddInto(data, peer, count, stream);
+    return true;
+  };
+}
