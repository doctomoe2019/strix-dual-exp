+#ifndef GUFO_MODELS_GLM5_NEXT_ENGINE_HPP_
+#define GUFO_MODELS_GLM5_NEXT_ENGINE_HPP_
+
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <span>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "src/models/glm5_next/config.hpp"
+
+struct ihipStream_t;
+
+namespace gufo::models::glm5_next {
+
+class Session;
+
+/// Loads and serves one GLM-5.3-Flash artifact: the resident weights, the
+/// shared executor working set and the tokenizer, plus any number of
+/// sessions with private recurrent/cache state. The caller serializes
+/// model and session calls (the serving scheduler owns dispatch).
+struct ModelOptions {
+  /// Runtime context ceiling. The long-context ladder qualifies this
+  /// separately from the artifact's native context.
+  std::uint32_t max_context{4096};
+  /// Batched prefill chunk width (clamped to the executor bound; 0 keeps
+  /// the executor default).
+  std::uint32_t prefill_chunk{512};
+  std::uint32_t tp_rank{0};
+  std::uint32_t tp_world_size{1};
+  /// Sums attention/FFN partials across ranks on the executor stream,
+  /// completing there. Null keeps this rank's partials (single-rank
+  /// qualification runs).
+  using AllReduce =
+      std::function<bool(float*, std::uint32_t, ihipStream_t*, std::string*)>;
+  AllReduce all_reduce;
+};
+
+class Model final : public std::enable_shared_from_this<Model> {
+public:
+  /// Runtime capacity ceiling (the planned 256K qualification ladder top).
+  static constexpr std::uint32_t kMaxServingContext = 262144;
+
+  ~Model();
+  Model(const Model&) = delete;
+  Model& operator=(const Model&) = delete;
+  Model(Model&&) = delete;
+  Model& operator=(Model&&) = delete;
+
+  [[nodiscard]] static std::shared_ptr<Model> Load(
+      const std::string& model_path, ModelOptions options,
+      std::string* error_msg = nullptr);
+
+  /// One conversation, resident for `capacity` tokens (at most
+  /// max_context). Sessions share the executor's working set; their
+  /// private state is theirs alone.
+  [[nodiscard]] std::unique_ptr<Session> CreateSession(
+      std::uint32_t capacity, std::string* error_msg = nullptr) const;
+
+  [[nodiscard]] std::vector<std::int32_t> Tokenize(std::string_view text) const;
+  [[nodiscard]] std::string Decode(std::span<const std::int32_t> tokens) const;
+  [[nodiscard]] std::string TokenText(std::int32_t token) const;
+  /// The GGUF's eos/eom/eot stop ids (154820, 154827, 154829).
+  [[nodiscard]] bool IsStopToken(std::int32_t token) const noexcept;
+  [[nodiscard]] std::int32_t EosToken() const noexcept;
+  [[nodiscard]] std::uint32_t VocabSize() const noexcept;
+  [[nodiscard]] std::uint32_t MaxContext() const noexcept {
+    return options_.max_context;
+  }
+  [[nodiscard]] std::uint32_t TpRank() const noexcept {
+    return options_.tp_rank;
+  }
+  [[nodiscard]] std::uint32_t TpWorldSize() const noexcept {
+    return options_.tp_world_size;
+  }
+  /// False for rank-partial diagnostics; TP2 serving requires a reducer.
+  [[nodiscard]] bool HasAllReduce() const noexcept;
+  /// Effective batched prefill chunk width.
+  [[nodiscard]] std::uint32_t PrefillChunk() const noexcept;
+  /// Device bytes of the resident weights.
+  [[nodiscard]] std::size_t ResidentBytes() const noexcept;
+  /// Device bytes of the executor's shared working set.
+  [[nodiscard]] std::size_t ScratchBytes() const noexcept;
+  /// Device bytes one session of `capacity` tokens allocates.
+  [[nodiscard]] std::size_t SessionBytes(std::uint32_t capacity) const noexcept;
+  [[nodiscard]] const Config& config() const noexcept;
+
+private:
+  friend class Session;
+
+  Model() = default;
+
+  struct Impl;
+  std::unique_ptr<Impl> impl_;
+  ModelOptions options_;
+};
+
+/// One conversation over the loaded model: batched prefill and tokenwise
+/// evaluation over the compact latent/indexer caches, KDA state and the
+/// pooling frontier, plus the executed token history.
+class Session final {
+public:
+  ~Session();
+  Session(const Session&) = delete;
+  Session& operator=(const Session&) = delete;
+  Session(Session&&) = delete;
+  Session& operator=(Session&&) = delete;
+
+  /// Makes the session state equal to `prompt`: an exact extension of the
+  /// executed history prefills only the new tokens; anything that
+  /// truncates or diverges from it resets and replays in full. The last
+  /// position's logits stay available after a non-empty sync.
+  [[nodiscard]] bool Sync(std::span<const std::int32_t> prompt,
+                          std::string* error_msg = nullptr);
+  /// Appends one token (decode step) and refreshes the logits.
+  [[nodiscard]] bool Evaluate(std::int32_t token,
+                              std::string* error_msg = nullptr);
+  /// The last computed position's distribution; empty before the first
+  /// non-empty Sync or Evaluate, or after a failed call.
+  [[nodiscard]] std::span<const float> Logits() const noexcept;
+  [[nodiscard]] std::uint32_t Position() const noexcept;
+  [[nodiscard]] std::uint32_t Capacity() const noexcept;
+  [[nodiscard]] std::span<const std::int32_t> Tokens() const noexcept;
+  /// Drops every token and returns to a fresh, valid, empty session.
+  void Reset() noexcept;
+  /// False after a failed Sync or Evaluate; Reset restores usability.
+  [[nodiscard]] bool valid() const noexcept;
+  /// Device bytes of this session's persistent regions.
+  [[nodiscard]] std::size_t StateBytes() const noexcept;
+  /// FNV-1a over every persistent region in stable order — the
+  /// qualification diagnostics' state fingerprint.
+  [[nodiscard]] bool StateHash(std::uint64_t* hash,
+                               std::string* error_msg = nullptr) const;
+
+private:
+  friend class Model;
+  struct Impl;
+  explicit Session(std::unique_ptr<Impl> impl);
+
+  std::unique_ptr<Impl> impl_;
+};
+
+}  // namespace gufo::models::glm5_next
