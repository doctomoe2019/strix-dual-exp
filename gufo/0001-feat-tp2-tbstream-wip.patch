+#ifndef GUFO_MODELS_GLM5_NEXT_CHAT_TEMPLATE_HPP_
+#define GUFO_MODELS_GLM5_NEXT_CHAT_TEMPLATE_HPP_
+
+#include <optional>
+#include <span>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "src/core/gguf_reader.hpp"
+#include "src/core/reasoning.hpp"
+
+namespace gufo::models::glm5_next {
+
+struct ChatMessage {
+  struct ToolArgument {
+    std::string name;
+    /// Raw string when is_string, otherwise a compact JSON value.
+    std::string value;
+    bool is_string{true};
+  };
+
+  struct ToolCall {
+    std::string name;
+    std::vector<ToolArgument> arguments;
+    std::string id;
+  };
+
+  std::string role;
+  std::string content;
+  std::string reasoning_content;
+  std::vector<ToolCall> tool_calls;
+  /// Role "tool": the call this result answers.
+  std::string tool_call_id;
+};
+
+struct ChatTool {
+  std::string name;
+  std::string description;
+  /// Compact JSON object for the parameters schema, member order kept.
+  std::string parameters_json{"{}"};
+};
+
+struct ChatTemplateOptions {
+  /// Native effort line: "low", "high" or "max". Absent also means max.
+  std::optional<std::string_view> reasoning_effort;
+  /// Drop preserved reasoning from assistant turns before the last user
+  /// message (the template's clear_thinking).
+  bool clear_thinking{false};
+  bool add_generation_prompt{false};
+};
+
+/// Maps the provider-neutral reasoning controls onto the pinned template's
+/// native options. The template always opens reasoning with `<think>`;
+/// an explicit `enabled == false` is rejected by the caller, not narrowed
+/// here. Efforts map minimal/low -> low, medium/high -> high,
+/// xhigh/max -> max.
+[[nodiscard]] ChatTemplateOptions ResolveChatOptions(
+    const gufo::ReasoningOptions& reasoning);
+
+/// Renders the pinned GLM-5.3-Flash conversation format, byte-exact to
+/// the official chat template (goldens in the plan's evidence).
+[[nodiscard]] std::string RenderChat(std::span<const ChatMessage> messages,
+                                     std::span<const ChatTool> tools,
+                                     const ChatTemplateOptions& options = {});
+
+/// Rejects GLM artifacts whose embedded template is not the pinned
+/// revision implemented by this compiled renderer.
+[[nodiscard]] bool ValidateGgufTemplate(const core::GgufReader& reader,
+                                        std::string* error_msg = nullptr);
+
+[[nodiscard]] constexpr std::string_view ChatTemplateId() noexcept {
+  return "glm-5.3-flash-compiled-v1";
+}
+
+[[nodiscard]] constexpr std::string_view ArtifactTemplateSha256() noexcept {
+  return "0c4099f3382d6c92700dfb99725025360966fd73032f0ecf32377c0d9e6309c5";
+}
+
+}  // namespace gufo::models::glm5_next
+
+#endif  // GUFO_MODELS_GLM5_NEXT_CHAT_TEMPLATE_HPP_
