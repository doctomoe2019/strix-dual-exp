+void TestGlmNativeTools() {
+  using Format = JsonConstraint::ToolFormat;
+  const auto arguments = JsonConstraint::ToolParameters(parse(R"({
+        "type":"object","properties":{"value":{"type":"string","const":"42"}},
+        "required":["value"],"additionalProperties":false})"),
+                                                        true, Format::kGlm);
+  const std::string call =
+      "<tool_call>record<arg_key>value</arg_key><arg_value>42</arg_value>"
+      "</tool_call>";
+  for (const bool required : {false, true}) {
+    const auto grammar = JsonConstraint::WithTools(
+        nullptr, {{"record", arguments}}, required, false, Format::kGlm);
+    assert(Accepts(*grammar, " \n" + call));
+    assert(Accepts(*grammar, call));
+    auto invalid = call;
+    invalid.replace(invalid.find("42"), 2, "43");
+    assert(!Accepts(*grammar, " \n" + invalid));
+    // Calls end the output; nothing may follow the closer.
+    assert(!Accepts(*grammar, call + " trailing"));
+    assert(!Accepts(*grammar,
+                    "<tool_call>other<arg_key>value</arg_key><arg_value>42"
+                    "</arg_value></tool_call>"));
+    assert(Accepts(*grammar, "Reasoning only.") == !required);
+    const auto reasoned = JsonConstraint::WithReasoning(grammar);
+    assert(Accepts(*reasoned, "Use it.</think>" + call));
+    // GLM's reasoning boundary is the envelope tag itself.
+    assert(Accepts(*reasoned, "Call now: " + call));
+    // With auto tools, reasoning-only output stays legal, as for Qwen.
+    assert(Accepts(*reasoned, "never closed") == !required);
+  }
+  // Typed (non-string) arguments render as compact JSON values.
+  const auto typed = JsonConstraint::ToolParameters(parse(R"({
+        "type":"object","properties":{"count":{"type":"integer","minimum":1,
+        "maximum":5},"ok":{"type":"boolean"}},
+        "required":["count","ok"],"additionalProperties":false})"),
+                                                    true, Format::kGlm);
+  const auto typed_grammar = JsonConstraint::WithTools(
+      nullptr, {{"measure", typed}}, true, false, Format::kGlm);
+  assert(Accepts(*typed_grammar,
+                 "<tool_call>measure<arg_key>count</arg_key><arg_value>3"
+                 "</arg_value><arg_key>ok</arg_key><arg_value>true</arg_value>"
+                 "</tool_call>"));
+  assert(Accepts(*typed_grammar,
+                 "<tool_call>measure<arg_key>ok</arg_key><arg_value>false"
+                 "</arg_value><arg_key>count</arg_key><arg_value>5"
+                 "</arg_value></tool_call>"));
+  assert(!Accepts(*typed_grammar,
+                  "<tool_call>measure<arg_key>count</arg_key><arg_value>6"
+                  "</arg_value><arg_key>ok</arg_key><arg_value>true</arg_value>"
+                  "</tool_call>"));
+  // A tool with no declared parameters is callable with an empty body.
+  const auto empty = JsonConstraint::WithTools(
+      nullptr,
+      {{"ping", JsonConstraint::ToolParameters(
+                    parse(R"({"type":"object","properties":{},
+                                     "additionalProperties":false})"),
+                    true, Format::kGlm)}},
+      true, false, Format::kGlm);
+  assert(Accepts(*empty, "<tool_call>ping</tool_call>"));
+  // Parallel calls may separate with whitespace, including none.
+  const auto parallel = JsonConstraint::WithTools(
+      nullptr, {{"record", arguments}}, true, true, Format::kGlm);
+  assert(Accepts(*parallel, call + "\n" + call));
+  assert(Accepts(*parallel, call + call));
+  assert(Accepts(*parallel, call + "  " + call));
+  const auto nested = JsonConstraint::ToolParameters(parse(R"({"type":"object",
+    "properties":{"data":{"type":"object","properties":{"tags":{"type":"array",
+      "items":{"type":"string"}}},"required":["tags"],"additionalProperties":false}},
+    "required":["data"],"additionalProperties":false})"),
+                                                     true, Format::kGlm);
+  const auto nested_calls = JsonConstraint::WithTools(
+      nullptr, {{"record", nested}}, true, false, Format::kGlm);
+  assert(Accepts(
+      *nested_calls,
+      R"(<tool_call>record<arg_key>data</arg_key><arg_value>{"tags":["</arg_value>","<think>"]}</arg_value></tool_call>)"));
+  const auto raw = JsonConstraint::ToolParameters(parse(R"({"type":"object",
+    "properties":{"text":{"type":"string"}},"required":["text"],
+    "additionalProperties":false})"),
+                                                  true, Format::kGlm);
+  const auto raw_calls = JsonConstraint::WithTools(nullptr, {{"record", raw}},
+                                                   true, false, Format::kGlm);
+  assert(Accepts(*raw_calls,
+                 "<tool_call>record<arg_key>text</arg_key><arg_value>\n雪 "
+                 "<tool_call>literal"
+                 "</tool_call>\n</arg_value></tool_call>"));
+  const auto wildcard = JsonConstraint::WithTools(
+      nullptr, {{"record", JsonConstraint::OpenToolParameters(Format::kGlm)}},
+      true, false, Format::kGlm);
+  assert(Accepts(*wildcard,
+                 "<tool_call>record<arg_key>name</arg_key><arg_value>literal</"
+                 "arg_value></tool_call>"));
 }
 
