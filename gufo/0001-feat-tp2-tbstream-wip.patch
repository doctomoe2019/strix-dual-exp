+add_executable(glm5_next_reference_probe EXCLUDE_FROM_ALL reference_probe.cpp)
+target_link_libraries(glm5_next_reference_probe PRIVATE gufo_glm5_next)
+set_source_files_properties(reference_probe.cpp PROPERTIES COMPILE_OPTIONS
+  "-O2")
+
+if (ENGINE_ENABLE_HIP)
+  # P2.1: uploads the real-weight slice and cross-checks the ledger.
+  add_executable(glm5_next_slice_probe EXCLUDE_FROM_ALL slice_probe.cpp)
+  target_link_libraries(glm5_next_slice_probe PRIVATE gufo_glm5_next)
