+// Host harness.
+
+#define HIPCK(call)                                                 \
+  do {                                                              \
+    hipError_t err__ = (call);                                      \
+    if (err__ != hipSuccess) {                                      \
+      std::fprintf(stderr, "HIP error %s at %s:%d\n",               \
+                   hipGetErrorString(err__), __FILE__, __LINE__);  \
+      std::exit(1);                                                 \
+    }                                                               \
+  } while (0)
