+              Hash(logits.data(),
+                   static_cast<std::size_t>(c.vocab_size) * sizeof(float)));
+        }
+        if (!executor->HashState(*session, &side->state, &error)) {
+          Fail("compare hash: " + error);
+          return;
+        }
+        capture_blocks = false;
+        attach_blocks(side);
+      };
+      run_side(false, &tw);
+      run_side(true, &bt);
+      const bool same =
+          tw.final_logits == bt.final_logits && tw.picks == bt.picks &&
+          tw.step_hashes == bt.step_hashes && tw.state == bt.state;
+      if (!same) {
+        // Name the first diverging sub-block between the two passes.
+        bool named = false;
+        for (const auto& entry : bt.blocks) {
+          auto it = tw.blocks.find(entry.first);
+          if (it == tw.blocks.end() || it->second == entry.second) {
+            continue;
+          }
+          Say("first diverging block: layer=" +
+              std::to_string(std::get<0>(entry.first)) +
+              " sub=" + std::to_string(std::get<1>(entry.first)) +
+              " token=" + std::to_string(std::get<2>(entry.first)));
+          named = true;
+          break;
+        }
+        if (!named) {
+          Say("first diverging block: none within captured rows");
+        }
+      }
+      Say("compare " + prompt.name + ": tw=" + std::to_string(tw.state) +
+          " batch=" + std::to_string(bt.state) +
+          (same ? " MATCH" : " MISMATCH"));
+      if (!same) {
+        Fail("prefill compare mismatch: " + prompt.name);
+      }
+    }
+    Say("prompt " + prompt.name + " done: worst rel_rms " +
+        std::to_string(worst));
+    if (failures != 0) {
+      break;
+    }
+  }
+
+  (void)communicator->EndOperation(kScope, &error);
+  {
+    const double ms =
+        std::chrono::duration<double, std::milli>(exchange_total).count();
+    std::printf(
+        "[glm-tp exchanges: %llu totalling %.1f ms (%.1f ms each, %.2f GiB)]\n",
+        static_cast<unsigned long long>(exchange_count), ms,
+        exchange_count != 0 ? ms / exchange_count : 0.0,
+        static_cast<double>(exchange_bytes) / (1024.0 * 1024.0 * 1024.0));
+    std::fflush(stdout);
+  }
+  if (failures != 0) {
+    return 1;
+  }
+  Say("PASS: glm5_next tp probe rank " + std::to_string(rank));
+  return 0;
+}
