+  // The keep_f32=false variant must leave the F32 mixed row untouched while
+  // every side output stays exact.
+  std::vector<float> sentinel(mixed_count);
+  for (std::size_t i = 0; i < sentinel.size(); ++i) {
+    sentinel[i] = (i % 3 == 0) ? -3.0e30F : 7.0e29F;
+  }
+  Upload(&d_out, sentinel);
+  if (!q::HcMixF16Gemm(d_up.get(), d_low.get(), d_norm.get(), d_inject_w.get(),
+                       d_out.get(), d_out_half.get(), d_out_q8.get(),
+                       d_out_inject.get(), tokens, kHidden, kRank, nullptr,
+                       /*keep_f32=*/false)) {
+    throw std::runtime_error("HC skip-F32 projection rejected");
+  }
+  {
+    const auto after = Download(&d_out, mixed_count);
+    if (after != sentinel) {
+      throw std::runtime_error("skip-F32 variant wrote the F32 mixed row");
+    }
+  }
+  exact(d_ref_half, d_out_half, "F16 mixed row (F32 skipped)");
+  exact(d_ref_q8, d_out_q8, "Q8 mixed row (F32 skipped)");
+  exact(d_ref_inject, d_out_inject, "inject partials (F32 skipped)");
   std::cerr << "HC projection fusion exact at " << tokens << " tokens\n";
 }
 
+// A combine that emits the next mixer's inject partials must match the
+// unfused sequence — the combine's own outputs unchanged, and the emitted
+// partials byte-identical to HcInjectPartialF16 over the combine's F16 norm
+// — on the plain and peer routes, including the production case where the
+// emitted partials alias the consumed logits.
+void CheckCombineInjectEmission(std::uint32_t tokens) {
+  constexpr float kEps = 1e-6F;
+  constexpr std::size_t kHcDim = kStreams * kHidden;
+  const std::size_t rows = static_cast<std::size_t>(tokens) * kHcDim;
+  const std::size_t mixed = static_cast<std::size_t>(tokens) * kHidden;
+  const std::uint32_t parts = q::HcInjectPartsVec4(kHidden);
+  const std::size_t inject_count =
+      static_cast<std::size_t>(tokens) * kStreams * parts;
+  const std::size_t q8_bytes = q::Q8TiledBytes(tokens, kHcDim);
+  const auto res = MakeValues(rows, 0x0F0F0F0FU, 1.0F);
+  const auto block = MakeValues(mixed, 0x12340001U, 1.0F);
+  const auto peer = MakeValues(mixed, 0x12340002U, 1.0F);
+  const auto gamma = MakeValues(kHcDim, 0x600DCAFEU, 0.5F);
+  const auto inject_w = MakeValues(kStreams * kHcDim, 0xDEADBEEFU, 0.1F);
+  const auto logits = MakeValues(inject_count, 0xFEEDF00DU, 0.1F);
+  for (int variant = 0; variant < 2; ++variant) {
+    const bool peer_route = variant == 1;
+    for (int aliased = 0; aliased < 2; ++aliased) {
+      HipBuffer<float> d_res_a(rows), d_res_b(rows);
+      HipBuffer<float> d_block(mixed), d_peer(mixed), d_summed(mixed);
+      HipBuffer<float> d_gamma(kHcDim), d_weight(kStreams * kHcDim);
+      HipBuffer<float> d_logits(inject_count), d_logits_b(inject_count);
+      HipBuffer<float> d_inject_ref(inject_count), d_inject_fused(inject_count);
+      HipBuffer<__half> d_xn_ref(rows), d_xn_fused(rows);
+      HipBuffer<std::uint8_t> d_q8_ref(q8_bytes), d_q8_fused(q8_bytes);
+      Upload(&d_res_a, res);
+      Upload(&d_res_b, res);
+      Upload(&d_block, block);
+      Upload(&d_peer, peer);
+      Upload(&d_gamma, gamma);
+      Upload(&d_weight, inject_w);
+      Upload(&d_logits, logits);
+      Upload(&d_logits_b, logits);
+      CheckHip(hipMemset(d_q8_ref.get(), 0, q8_bytes), "clear reference Q8");
+      CheckHip(hipMemset(d_q8_fused.get(), 0, q8_bytes), "clear fused Q8");
+      // Reference: the unfused combine, then the separate inject pass over
+      // the F16 norm it wrote.
+      if (!peer_route) {
+        q::HcCombineF16(d_res_a.get(), d_block.get(), d_logits.get(), parts,
+                        d_gamma.get(), d_xn_ref.get(), d_q8_ref.get(), tokens,
+                        kHidden, kStreams, kEps, nullptr);
+      } else if (!q::HcCombinePeerF16(d_res_a.get(), d_block.get(),
+                                      d_peer.get(), d_summed.get(),
+                                      d_logits.get(), parts, d_gamma.get(),
+                                      d_xn_ref.get(), d_q8_ref.get(), tokens,
+                                      kHidden, kStreams, kEps, nullptr)) {
+        throw std::runtime_error("peer combine rejected the geometry");
+      }
+      q::HcInjectPartialF16(d_xn_ref.get(), d_weight.get(), d_inject_ref.get(),
+                            tokens, kHidden, nullptr);
+      // Fused: the emitting combine, with the emitted partials optionally
+      // aliasing the consumed logits buffer (the production layout).
+      float* inject_out = aliased ? d_logits_b.get() : d_inject_fused.get();
+      if (!peer_route) {
+        q::HcCombineF16(d_res_b.get(), d_block.get(), d_logits_b.get(), parts,
+                        d_gamma.get(), d_xn_fused.get(), d_q8_fused.get(),
+                        tokens, kHidden, kStreams, kEps, nullptr,
+                        d_weight.get(), inject_out);
+      } else if (!q::HcCombinePeerF16(
+                     d_res_b.get(), d_block.get(), d_peer.get(), d_summed.get(),
+                     d_logits_b.get(), parts, d_gamma.get(), d_xn_fused.get(),
+                     d_q8_fused.get(), tokens, kHidden, kStreams, kEps, nullptr,
+                     d_weight.get(), inject_out)) {
+        throw std::runtime_error("emitting peer combine rejected the geometry");
+      }
+      CheckHip(hipDeviceSynchronize(), "inject emission synchronization");
+      const auto exact = [&](auto& a, auto& b, const char* what) {
+        std::vector<std::uint8_t> x(a.bytes()), y(b.bytes());
+        CheckHip(hipMemcpy(x.data(), a.get(), x.size(), hipMemcpyDeviceToHost),
+                 "reference download");
+        CheckHip(hipMemcpy(y.data(), b.get(), y.size(), hipMemcpyDeviceToHost),
+                 "fused download");
+        if (x != y) {
+          throw std::runtime_error(std::string("inject emission changed ") +
+                                   what);
+        }
+      };
+      exact(d_res_a, d_res_b, "the residual");
+      exact(d_xn_ref, d_xn_fused, "the F16 norm");
+      exact(d_q8_ref, d_q8_fused, "the tiled Q8 norm");
+      exact(d_inject_ref, aliased ? d_logits_b : d_inject_fused,
+            "the emitted inject partials");
+    }
+  }
+  std::cerr << "HC combine inject emission exact at " << tokens << " tokens\n";
+}
