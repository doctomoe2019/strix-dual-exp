new file mode 100644
index 00000000..887022aa
--- /dev/null
+++ b/tests/functional/glm53_serving_prefill.py
@@ -0,0 +1,212 @@
+#!/usr/bin/env python3
+# Serving-level prefill measurement against a running GLM TP2 pair (goal
+# 2026-10-10-glm-prefill-250 phase 6). Calibrates the ladder.py filler-block
+# token rate with two small sends, then measures cold-prefill throughput for
+# a ~3-4K-token prompt per run. Reports fresh tokens / server prefill_ms and
+# fresh tokens / client-side prefill wall (last prompt_progress event).
+import argparse
+import json
+from pathlib import Path
+import time
+import urllib.error
+import urllib.request
+
+FILLER = [
+    ("The archive maintains a quarterly review of infrastructure spending. "
+     "Each department submits line items that are reconciled against the "
+     "previous quarter, and discrepancies above a threshold are escalated "
+     "to the operations committee for a written explanation."),
+    ("River traffic on the lower delta follows a tidal window: barges queue "
+     "at the lock before dawn, and the harbor authority publishes the "
+     "expected clearance times each evening so that crews can plan their "
+     "shifts around the schedule rather than idling at the moorings."),
+    ("In the greenhouse the irrigation controller logs every cycle. "
+     "Sensors report soil moisture at fixed depth, and the controller "
+     "extends or shortens the next cycle to keep the root zone within "
+     "a narrow band, which measurably reduced water use per tray."),
+]
+
+
+class Measure:
+    def __init__(self, args):
+        self.args = args
+        self.base = f'http://{args.host}:{args.port}'
+        self.rows = []
+
+    def ask(self, name, messages, max_tokens=8, timeout=432000):
+        body = {"model": self.args.model, "temperature": 0, "max_tokens": max_tokens,
+                "reasoning_effort": "low", "stream": True, "return_progress": True,
+                "stream_options": {"include_usage": True}, "messages": messages}
+        request = urllib.request.Request(
+            self.base + "/v1/chat/completions", json.dumps(body).encode(),
+            {"Content-Type": "application/json"})
+        start = time.monotonic()
+        row = {"name": name, "start": start}
+        self.rows.append(row)
+        events, progress_times, first_token = [], [], None
+        with urllib.request.urlopen(request, timeout=timeout) as response:
+            assert response.status == 200
+            for line in response:
+                if not line.startswith(b"data: "):
+                    continue
+                now = time.monotonic()
+                if line.strip() == b"data: [DONE]":
+                    break
+                event = json.loads(line[6:])
+                events.append(event)
+                if "prompt_progress" in event:
+                    progress_times.append((now, event["prompt_progress"]))
+                if first_token is None and any(
+                        choice.get("delta", {}).get("content")
+                        for choice in event.get("choices", [])):
+                    first_token = now
+        row.update(wall_seconds=time.monotonic() - start,
+                   first_token_seconds=(first_token - start) if first_token else None,
+                   last_progress_seconds=(progress_times[-1][0] - start)
+                   if progress_times else None,
+                   last_progress=progress_times[-1][1] if progress_times else None,
+                   usage=events[-1].get("usage") if events else None)
+        usage = row["usage"] or {}
+        row["prompt_tokens"] = usage.get("prompt_tokens")
+        row["cached_tokens"] = (usage.get("prompt_tokens_details", {})
+                                .get("cached_tokens"))
+        row["metrics"] = usage.get("gufo", {})
+        print(f"{name}: prompt={row['prompt_tokens']} "
+              f"cached={row['cached_tokens']} wall={row['wall_seconds']:.1f}s "
+              f"prefill_ms={row['metrics'].get('prefill_ms')} "
+              f"max_chunk={row['metrics'].get('max_prefill_chunk_tokens')}",
+              flush=True)
+        return row
+
+    def filler(self, blocks, offset):
+        return "\n".join(FILLER[(i + offset) % len(FILLER)]
+                         for i in range(blocks))
+
+    def build_prompt(self, blocks, variant):
+        # Distinct first line and filler rotation per variant so every
+        # measured prompt is a cold prefix for the continuation cache.
+        parts = [f"RUN {variant} — QUARTERLY ARCHIVE DOCUMENT — READ CAREFULLY"]
+        parts.append(self.filler(max(1, blocks // 10), variant))
+        parts.append("An early inventory note registers shipment tag "
+                     f"VEK-{400 + variant}Q, bound for the northern depot.")
+        parts.append(self.filler(max(1, blocks // 4), variant + 1))
+        parts.append("A middle-ledger correction cites invoice mark "
+                     f"HRA-{900 + variant} as the freight reference.")
+        parts.append(self.filler(max(1, blocks // 2), variant + 2))
+        parts.append("A closing audit line stamps clearance seal "
+                     f"USD-{300 + variant} on the final page of the quarter.")
+        parts.append("End of document. First, reply with exactly: RECEIVED")
+        return "\n\n".join(parts)
+
+    def calibrate(self):
+        zero = self.ask("calibrate-zero",
+                        [{"role": "user", "content": "Reply: OK"}])
+        assert zero["usage"], zero
+        prev_fresh = None
+        per_block = None
+        for blocks in (40, 80):
+            sent = self.ask(f"calibrate-{blocks}", [{
+                "role": "system",
+                "content": "You are a careful auditor reading an archive document."},
+                {"role": "user", "content": self.build_prompt(blocks, 0)}])
+            fresh = sent["prompt_tokens"] - (sent["cached_tokens"] or 0)
+            if prev_fresh is not None:
+                per_block = (fresh - prev_fresh) / 40.0
+            prev_fresh = fresh
+        assert per_block and per_block > 0, per_block
+        base = prev_fresh - 80 * per_block
+        print(f"calibration: {per_block:.3f} tokens/block, base={base:.1f}",
+              flush=True)
+        return per_block, base
+
+    def run(self):
+        self.output = Path(self.args.output)
+        self.output.mkdir(parents=True, exist_ok=False)
+        per_block, base = self.calibrate()
+        blocks = int((self.args.target - base) / per_block)
+        assert blocks > 50, blocks
+        runs = []
+        for variant in range(1, self.args.runs + 1):
+            document = self.build_prompt(blocks, variant)
+            row = self.ask(f"serving-prefill-{variant}", [
+                {"role": "system",
+                 "content": "You are a careful auditor reading a long archive "
+                            "document."},
+                {"role": "user", "content": document}])
+            fresh = row["prompt_tokens"] - (row["cached_tokens"] or 0)
+            metrics = row["metrics"]
+            assert fresh >= self.args.target - 1024, (fresh, self.args.target)
+            assert (row["cached_tokens"] or 0) < 200, row["cached_tokens"]
+            assert metrics.get("prefill_ms", 0) > 0, metrics
+            # The served width must be exact, not merely bounded: a stale
+            # binary silently clamps --prefill-chunk to its own kMaxBatch
+            # (2048 before the phase-5 wideners), which a <= bound would
+            # hide. Cold chunks split as ceil(fresh/chunk), so the largest
+            # chunk is min(fresh, chunk).
+            expected_chunk = min(fresh, self.args.chunk)
+            served_chunk = metrics.get("max_prefill_chunk_tokens")
+            assert served_chunk == expected_chunk, (
+                "served chunk width is wrong",
+                {"served": served_chunk, "expected": expected_chunk,
+                 "fresh": fresh, "chunk_bound": self.args.chunk,
+                 "hint": "a max of 2048 against a 4096 bound means the "
+                         "serving binary predates the phase-5 kMaxBatch "
+                         "wideners and clamped --prefill-chunk silently"})
+            server = fresh / metrics["prefill_ms"] * 1000.0
+            client = (fresh / row["last_progress_seconds"]
+                      if row["last_progress_seconds"] else None)
+            entry = {"name": row["name"], "fresh_tokens": fresh,
+                     "prompt_tokens": row["prompt_tokens"],
+                     "cached_tokens": row["cached_tokens"],
+                     "prefill_ms": metrics["prefill_ms"],
+                     "prefill_chunks": metrics.get("prefill_chunks"),
+                     "max_prefill_chunk_tokens":
+                         metrics.get("max_prefill_chunk_tokens"),
+                     "client_wall_s": row["wall_seconds"],
+                     "client_prefill_wall_s": row["last_progress_seconds"],
+                     "server_tok_s": round(server, 2),
+                     "client_tok_s": round(client, 2) if client else None}
+            runs.append(entry)
+            print(json.dumps(entry), flush=True)
+        (self.output / "report.json").write_text(json.dumps(
+            {"runs": runs, "per_block": per_block, "base_tokens": base,
+             "target": self.args.target}, indent=2))
+        servers = [run["server_tok_s"] for run in runs]
+        print("serving-level prefill (fresh tokens / prefill_ms): "
+              f"{', '.join(f'{value:.1f}' for value in servers)} tok/s",
+              flush=True)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--host', default='127.0.0.1')
+    parser.add_argument('--port', type=int, default=15015)
+    parser.add_argument('--model', default='glm-5.3-flash')
+    parser.add_argument('--target', type=int, default=3500,
+                        help='fresh prompt tokens per measured run')
+    parser.add_argument('--runs', type=int, default=3)
+    parser.add_argument('--chunk', type=int, default=4096,
+                        help='served prefill chunk width upper bound '
+                             '(pair re-sweep winner)')
+    parser.add_argument('--pair-state', default=None,
+                        help='optional glm53_pair.py state file; its recorded '
+                             '\'chunk\' overrides --chunk so the two harnesses '
+                             'cannot disagree')
+    parser.add_argument('--output', required=True)
+    args = parser.parse_args()
+    if args.pair_state:
+        try:
+            state = json.loads(Path(args.pair_state).read_text())
+            args.chunk = int(state['chunk'])
+        except (OSError, ValueError, KeyError) as error:
+            raise SystemExit(
+                f"--pair-state {args.pair_state}: unusable pair state "
+                f"({error!r}); expected glm53_pair.py's state JSON with a "
+                f"'chunk' key") from error
+        print(f"pair state {args.pair_state}: chunk bound = {args.chunk}",
+              flush=True)
+    Measure(args).run()
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tests/functional/glm53_tp2.py b/tests/functional/glm53_tp2.py
new file mode 100644
index 00000000..15c63a6c
--- /dev/null
+++ b/tests/functional/glm53_tp2.py
@@ -0,0 +1,336 @@
+#!/usr/bin/env python3
+"""Bounded P4 checks against an already-running GLM TP2 pair (one session).
+
+Writes each request, raw buffered/SSE response, timing and verdict before
+moving on. The launcher owns production parking and both rank logs. Long
+context qualification is a separate ladder, not part of this check.
+"""
+
+import argparse
+import http.client
+import json
+from pathlib import Path
+import re
+import socket
+import time
+from urllib.parse import urlsplit
+import urllib.error
+import urllib.request
+
+
+CASES = ("discovery", "text", "responses", "tool-auto", "tool-required",
+         "tool-named", "tool-zero", "tool-nested", "tool-literal",
+         "tool-parallel", "tool-history", "structured", "stops", "limits",
+         "continuation", "invalid", "cancel-prefill", "cancel-decode")
+FRAMING = ("<tool_call>", "</tool_call>", "<arg_key>", "</arg_key>",
+           "<arg_value>", "</arg_value>", "<think>", "</think>")
+
+
+class Checks:
+    def __init__(self, args):
+        self.args = args
+        self.output = args.output
+        self.rows = []
+        self.base = args.url.rstrip("/")
+        self.common = {"model": args.model, "temperature": 0, "seed": 31,
+                       "max_tokens": 256, "reasoning_effort": "low"}
+
+    def ask(self, name, path, body=None, expected_status=200):
+        start = time.monotonic()
+        row = {"name": name, "path": path, "body": body}
+        self.rows.append(row)
+        stem = self.output / f"{len(self.rows):02d}-{name}"
+        stem.with_suffix(".request.json").write_text(json.dumps(body, indent=2))
+        data = json.dumps(body).encode() if body is not None else None
+        request = urllib.request.Request(self.base + path, data,
+                                         {"Content-Type": "application/json"})
+        try:
+            with urllib.request.urlopen(request, timeout=self.args.timeout) as response:
+                raw, status = response.read().decode(), response.status
+                row["request_id"] = response.getheader("X-Request-ID")
+        except urllib.error.HTTPError as error:
+            raw, status = error.read().decode(), error.code
+            row["request_id"] = error.headers.get("X-Request-ID")
+        row.update(status=status, wall_seconds=time.monotonic() - start)
+        stem.with_suffix(".response.txt").write_text(raw)
+        assert status == expected_status, (row, raw)
+        if body and body.get("stream"):
+            events = [json.loads(line[6:]) for line in raw.splitlines()
+                      if line.startswith("data: ") and line != "data: [DONE]"]
+            assert events and not any("error" in event for event in events), events
+            if path == "/v1/responses":
+                completed = [event["response"] for event in events
+                             if event.get("type") == "response.completed"]
+                assert len(completed) == 1, events[-3:]
+                result = completed[0]
+            else:
+                message = {"content": "", "reasoning_content": ""}
+                calls = {}
+                finish, usage = None, None
+                for event in events:
+                    usage = event.get("usage") or usage
+                    for choice in event.get("choices", []):
+                        finish = choice.get("finish_reason") or finish
+                        delta = choice.get("delta", {})
+                        for key in ("content", "reasoning_content"):
+                            message[key] += delta.get(key) or ""
+                        for call in delta.get("tool_calls") or []:
+                            item = calls.setdefault(call["index"], {
+                                "id": "", "type": "function",
+                                "function": {"name": "", "arguments": ""}})
+                            item["id"] = call.get("id") or item["id"]
+                            for key in ("name", "arguments"):
+                                item["function"][key] += call.get("function", {}).get(key) or ""
+                if calls:
+                    message["tool_calls"] = list(calls.values())
+                assert finish and usage, events[-3:]
+                result = {"choices": [{"message": message, "finish_reason": finish}],
+                          "usage": usage}
+        else:
+            result = json.loads(raw)
+        row["result"] = result
+        if status == 200 and body:
+            usage = result.get("usage", {})
+            row["usage"] = usage
+            assert usage.get("draft_tokens", 0) == 0, usage
+            metrics = usage.get("gufo", {})
+            if not metrics:
+                # Responses has a standard usage object and publishes Gufo's
+                # generation timings separately. Queue/TTFT are correlated
+                # with the retained rank-0 completion log by request id.
+                timings = result.get("timings", {})
+                assert "prompt_ms" in timings and "predicted_ms" in timings, result
+                metrics = {"prefill_ms": timings["prompt_ms"],
+                           "decode_ms": timings["predicted_ms"]}
+                assert self.args.server_log, "Responses timings require --server-log"
+                for _ in range(10):
+                    records = [line for line in self.args.server_log.read_text().splitlines()
+                               if f"request={row['request_id']} " in line and "event=completed " in line]
+                    if records:
+                        break
+                    time.sleep(0.05)
+                assert records, row
+                fields = dict(re.findall(r"(?:^|\s)(\w+)=([^\s]+)", records[-1]))
+                metrics.update(queue_ms=float(fields["queue_ms"]),
+                               ttft_ms=float(fields["ttft_ms"]))
+            row["metrics"] = metrics
+            for key in ("prefill_ms", "decode_ms", "queue_ms", "ttft_ms"):
+                assert key in metrics, (key, usage)
+        stem.with_suffix(".result.json").write_text(json.dumps(row, indent=2))
+        print(f"{name}: HTTP {status}, {row['wall_seconds']:.1f}s", flush=True)
+        return result
+
+    def chat(self, name, messages, **options):
+        return self.ask(name, "/v1/chat/completions", {
+            **self.common, "messages": messages, **options})
+
+    @staticmethod
+    def message(result):
+        return result["choices"][0]["message"]
+
+    @staticmethod
+    def clean(message):
+        content = message.get("content") or ""
+        assert not any(tag in content for tag in FRAMING), content
+        return content
+
+    @staticmethod
+    def tool(name, expected):
+        def field(value):
+            # Strict nested objects declare their own closed property sets;
+            # const alone is not the server's strict-schema object contract.
+            if isinstance(value, dict):
+                return {"type": "object", "properties": {
+                    key: field(item) for key, item in value.items()},
+                    "required": list(value), "additionalProperties": False}
+            if isinstance(value, list):
+                return {"type": "array", "const": value,
+                        "items": {"type": "string"}}
+            return {"const": value, "type": "string" if isinstance(value, str) else
+                    "boolean" if isinstance(value, bool) else "integer"}
+        properties = {key: field(value) for key, value in expected.items()}
+        return {"type": "function", "function": {
+            "name": name, "description": "Return the supplied fixture.", "strict": True,
+            "parameters": {"type": "object", "properties": properties,
+                           "required": list(properties), "additionalProperties": False}}}
+
+    def tools(self, name, expected, choice="required", responses=False, stream=False):
+        tool = self.tool("record", expected)
+        instruction = "Call record once with exactly these arguments: " + json.dumps(expected)
+        if responses:
+            definition = tool["function"]
+            result = self.ask(name, "/v1/responses", {
+                "model": self.args.model, "temperature": 0, "max_output_tokens": 256,
+                "reasoning": {"effort": "low"}, "input": instruction,
+                "tools": [{"type": "function", **definition}],
+                "tool_choice": choice, "stream": stream})
+            calls = [item for item in result["output"] if item["type"] == "function_call"]
+            assert len(calls) == 1 and calls[0]["name"] == "record", result
+            arguments = json.loads(calls[0]["arguments"])
+        else:
+            result = self.chat(name, [{"role": "user", "content": instruction}],
+                               tools=[tool], tool_choice=choice, stream=stream,
+                               stream_options={"include_usage": True} if stream else {})
+            message = self.message(result)
+            self.clean(message)
+            assert result["choices"][0]["finish_reason"] == "tool_calls", result
+            calls = message["tool_calls"]
+            assert len(calls) == 1 and calls[0]["function"]["name"] == "record", result
+            arguments = json.loads(calls[0]["function"]["arguments"])
+        assert arguments == expected, (arguments, expected)
+        return result, tool, instruction
+
+    def run(self, case):
+        if case == "discovery":
+            self.ask("ready", "/ready")
+            result = self.ask("models", "/v1/models")
+            assert any(item["id"] == self.args.model for item in result["data"]), result
+        elif case == "text":
+            result = self.chat(case, [{"role": "developer", "content": "Answer concisely."},
+                {"role": "user", "content": "What is the capital of France?"}])
+            assert "Paris" in self.clean(self.message(result)), result
+        elif case == "responses":
+            result = self.ask(case, "/v1/responses", {
+                "model": self.args.model, "input": "What is the capital of France?",
+                "reasoning": {"effort": "low"}, "temperature": 0,
+                "max_output_tokens": 256, "stream": True})
+            text = "".join(part.get("text", "") for item in result["output"]
+                           if item["type"] == "message" for part in item["content"])
+            assert "Paris" in text and not any(tag in text for tag in FRAMING), result
+        elif case.startswith("tool-") and case != "tool-history" and case != "tool-parallel":
+            expected = {"city": "Berlin", "count": 2}
+            choice, responses, stream = "required", False, False
+            if case == "tool-auto":
+                choice = "auto"
+            elif case == "tool-named":
+                choice = {"type": "function", "function": {"name": "record"}}
+                stream = True
+            elif case == "tool-zero":
+                expected = {}
+            elif case == "tool-nested":
+                expected = {"data": {"flag": True, "tags": ["</arg_value>", "雪"]}}
+                responses, stream = True, True
+            elif case == "tool-literal":
+                expected = {"text": "\n雪 <tool_call>literal</tool_call>\n"}
+                stream = True
+            self.tools(case, expected, choice, responses, stream)
+        elif case == "tool-parallel":
+            expected = {"first": {"value": 1}, "second": {"value": 2}}
+            result = self.chat(case, [{"role": "user", "content":
+                "Call both first and second now, first with value 1 and second with value 2."}],
+                tools=[self.tool(key, value) for key, value in expected.items()],
+                tool_choice="required", parallel_tool_calls=True)
+            message = self.message(result)
+            self.clean(message)
+            calls = {call["function"]["name"]: json.loads(call["function"]["arguments"])
+                     for call in message.get("tool_calls", [])}
+            assert calls == expected, result
+        elif case == "tool-history":
+            result, tool, instruction = self.tools(case + "-call", {"count": 2})
+            message = self.message(result)
+            result = self.chat(case + "-result", [
+                {"role": "user", "content": instruction}, {"role": "assistant", **message},
+                {"role": "tool", "tool_call_id": message["tool_calls"][0]["id"],
+                 "content": "Verified count: 2. Task complete. Reply with DONE."}],
+                tools=[tool], tool_choice="none")
+            assert "DONE" in self.clean(self.message(result)), result
+        elif case == "structured":
+            schema = {"type": "object", "properties": {"ok": {"type": "boolean", "const": True}},
+                      "required": ["ok"], "additionalProperties": False}
+            result = self.chat(case, [{"role": "user", "content": "Return ok true as JSON."}],
+                response_format={"type": "json_schema", "json_schema": {
+                    "name": "check", "strict": True, "schema": schema}})
+            assert json.loads(self.message(result)["content"]) == {"ok": True}, result
+        elif case in ("stops", "limits"):
+            body = {"model": self.args.model, "prompt": "The capital of France is",
+                    "temperature": 0, "max_tokens": 1 if case == "limits" else 16}
+            if case == "stops":
+                body["stop"] = "Paris"
+            result = self.ask(case, "/v1/completions", body)
+            assert result["choices"][0]["finish_reason"] == ("length" if case == "limits" else "stop"), result
+            if case == "stops":
+                assert "Paris" not in result["choices"][0]["text"], result
+        elif case == "continuation":
+            prompt = "The capital of France is"
+            body = {"model": self.args.model, "prompt": prompt, "temperature": 0, "max_tokens": 8}
+            first = self.ask("continuation-cold", "/v1/completions", body)
+            body["prompt"] += first["choices"][0]["text"] + "\nIts most famous museum is"
+            warm = self.ask("continuation-warm", "/v1/completions", body)
+            assert "Louvre" in warm["choices"][0]["text"], warm
+            assert warm["usage"]["prompt_tokens_details"]["cached_tokens"] > 0, warm
+        elif case == "invalid":
+            self.ask("context-overflow", "/v1/completions", {
+                "model": self.args.model, "prompt": "word " * 5000, "max_tokens": 1}, 400)
+            self.ask("thinking-off", "/v1/chat/completions", {
+                **self.common, "messages": [{"role": "user", "content": "hi"}],
+                "chat_template_kwargs": {"enable_thinking": False}}, 400)
+            self.ask("ready-after-invalid", "/ready")
+        elif case.startswith("cancel-"):
+            self.cancel(case)
+
+    def cancel(self, name):
+        parsed = urlsplit(self.base)
+        connection = http.client.HTTPConnection(parsed.hostname, parsed.port,
+                                                 timeout=self.args.timeout)
+        body = {"model": self.args.model, "prompt":
+                ("Entry: harmless fixture.\n" * 70 if name == "cancel-prefill" else
+                 "Count from one to one thousand, one number per line."),
+                "temperature": 0, "max_tokens": 512, "stream": True,
+                "return_progress": True}
+        start = time.monotonic()
+        connection.request("POST", "/v1/completions", json.dumps(body),
+                           {"Content-Type": "application/json"})
+        response = connection.getresponse()
+        assert response.status == 200
+        seen = []
+        for line in response:
+            if not line.startswith(b"data: "):
+                continue
+            event = json.loads(line[6:])
+            seen.append(event)
+            if name == "cancel-prefill" and "prompt_progress" in event:
+                time.sleep(0.5)  # allow the first bounded prefill work unit to start
+                break
+            if name == "cancel-decode" and any(choice.get("text") for choice in event.get("choices", [])):
+                break
+        assert seen
+        if connection.sock:
+            connection.sock.shutdown(socket.SHUT_RDWR)
+        response.close()
+        connection.close()
+        self.rows.append({"name": name, "body": body, "events": seen,
+                          "cancel_after_seconds": time.monotonic() - start})
+        recovered = self.ask(name + "-recovery", "/v1/completions", {
+            "model": self.args.model, "prompt": "The capital of France is",
+            "temperature": 0, "max_tokens": 8})
+        assert "Paris" in recovered["choices"][0]["text"], recovered
+        self.ask(name + "-ready", "/ready")
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--url", required=True)
+    parser.add_argument("--model", default="glm-5.3-flash")
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--timeout", type=float, default=600)
+    parser.add_argument("--server-log", type=Path)
+    parser.add_argument("--case", action="append", choices=CASES)
+    args = parser.parse_args()
+    args.output.mkdir(parents=True, exist_ok=False)
+    checks = Checks(args)
+    passed = []
+    error = None
+    try:
+        for case in args.case or CASES:
+            checks.run(case)
+            passed.append(case)
+    except Exception as failure:
+        error = repr(failure)
+        raise
+    finally:
+        (args.output / "report.json").write_text(json.dumps({
+            "passed": passed, "error": error, "requests": checks.rows}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
