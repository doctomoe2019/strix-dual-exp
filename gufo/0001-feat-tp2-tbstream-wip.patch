+constexpr std::uint32_t kQ8QK = 32;
+constexpr std::uint32_t kQ8BlockBytes = 34;
+constexpr std::uint32_t kQ4KQK = 256;
+constexpr std::uint32_t kQ4KBytes = 144;
+
+std::uint32_t g_iters = 5;
+
+enum class KId : std::uint32_t {
+  kV0,
+  kW32_32_2,
+  kW64_32_1,
+  kW64_32_2,
+  kW64_16_2,
+  kW128_32_1,
+  kW128_16_1,
+  kW128_8_1,
+  kW256_32_1,
+  kW32_32_4,
+  kW128_32_1s,
+  kW64_32_1s,
+  kL32_16_32_2,
+  kL64_16_32_1,
+  kL64_16_32_2,
+  kL128_16_32_1,
+  kL128_16_16_1,
+  kL64_16_16_2,
+  kL128_8_32_1,
+  kL256_16_32_1,
+  kZ16_32_2,
+  kZ32_32_2,
+  kZ32_32_1,
+};
