+    }
+    float* x_dense = nullptr;
+    HIPCK(hipMalloc(&x_dense, 2048UL * kSlots * 2048 * sizeof(float)));
+    {
+      std::vector<float> hx(2048UL * kSlots * 2048);
+      std::uint64_t rng = 11;
+      for (auto& v : hx) {
+        rng ^= rng << 13;
+        rng ^= rng >> 7;
+        rng ^= rng << 17;
+        v = static_cast<float>(static_cast<std::int32_t>(rng >> 40)) /
+            2147483648.0F;
+      }
+      HIPCK(hipMemcpy(x_dense, hx.data(), hx.size() * sizeof(float),
