+int main(int argc, char** argv) {
+  setvbuf(stdout, nullptr, _IONBF, 0);
+  if (argc > 1) {
+    g_iters = static_cast<std::uint32_t>(std::atoi(argv[1]));
+  }
+  hipStream_t stream;
+  HIPCK(hipStreamCreate(&stream));
+
+  const std::uint32_t type =
+      static_cast<std::uint32_t>(gufo::core::GgmlType::kQ4_K);
+  const std::size_t row_bytes_4096 = (4096 / kQ4KQK) * kQ4KBytes;
+  const std::size_t row_bytes_2048 = (2048 / kQ4KQK) * kQ4KBytes;
+  const std::size_t row_bytes_1024 = (1024 / kQ4KQK) * kQ4KBytes;
+
+  const std::size_t gate_stride = static_cast<std::size_t>(4096) * row_bytes_4096;
+  auto wg_host = MakeQ4KWeights(kExperts, 4096, 4096);
+  auto w_gate = Device(wg_host);
+  const std::size_t down_stride = static_cast<std::size_t>(4096) * row_bytes_1024;
+  auto w_down = Device(MakeQ4KWeights(kExperts, 4096, 1024));
+
+  struct Routing {
+    const char* name;
+    double zipf;
+  } routings[] = {
+      {"uniform", 0.0},
+      {"skew0.6", 0.6},
+  };
+
+  for (const Routing& rt : routings) {
+    std::vector<double> weight(kExperts, 1.0);
+    if (rt.zipf > 0.0) {
+      std::uint64_t rng = 12345;
+      std::vector<std::uint32_t> perm(kExperts);
+      for (std::uint32_t i = 0; i < kExperts; ++i) {
+        perm[i] = i;
+      }
+      for (std::uint32_t i = kExperts - 1; i > 0; --i) {
+        rng ^= rng << 13;
+        rng ^= rng >> 7;
+        rng ^= rng << 17;
+        const std::uint32_t j = static_cast<std::uint32_t>(rng % (i + 1));
+        std::swap(perm[i], perm[j]);
+      }
+      double sum = 0.0;
+      for (std::uint32_t r = 0; r < kExperts; ++r) {
+        weight[perm[r]] = 1.0 / std::pow(1.0 + r, rt.zipf);
+        sum += weight[perm[r]];
+      }
+      for (auto& wv : weight) {
+        wv /= sum;
+      }
+    }
+    std::vector<std::int32_t> ids2048(2048 * kSlots);
+    {
+      std::uint64_t rng = 0xdeadbeefcafeULL;
+      const auto next64 = [&]() {
+        rng ^= rng << 13;
+        rng ^= rng >> 7;
+        rng ^= rng << 17;
+        return rng;
+      };
+      std::vector<double> cdf(kExperts);
+      double acc = 0.0;
+      for (std::uint32_t e = 0; e < kExperts; ++e) {
+        acc += weight[e];
+        cdf[e] = acc;
+      }
+      const double total = acc;
+      for (auto& c : cdf) {
+        c /= total;
+      }
+      for (std::uint32_t t = 0; t < 2048; ++t) {
+        std::uint32_t picked = 0;
+        while (picked < kSlots) {
+          const double u =
+              static_cast<double>(next64() % 1000000007ULL) / 1000000007.0;
+          const auto it = std::lower_bound(cdf.begin(), cdf.end(), u);
+          const std::uint32_t e =
+              static_cast<std::uint32_t>(it - cdf.begin()) % kExperts;
+          bool dup = false;
+          for (std::uint32_t s = 0; s < picked; ++s) {
+            if (ids2048[static_cast<std::size_t>(t) * kSlots + s] ==
+                static_cast<std::int32_t>(e)) {
+              dup = true;
+            }
+          }
+          if (!dup) {
+            ids2048[static_cast<std::size_t>(t) * kSlots + picked] =
+                static_cast<std::int32_t>(e);
+            ++picked;
+          }
+        }
+      }
+    }
+    std::vector<std::uint32_t> buckets;
+    buckets.assign(kExperts, 0);
+    for (std::uint32_t t = 0; t < 2048; ++t) {
+      for (std::uint32_t s = 0; s < kSlots; ++s) {
+        buckets[static_cast<std::uint32_t>(
+            ids2048[static_cast<std::size_t>(t) * kSlots + s])]++;
+      }
+    }
+    std::vector<std::uint32_t> sorted = buckets;
+    std::sort(sorted.begin(), sorted.end());
+    double reread16 = 0.0;
+    double reread32 = 0.0;
+    for (std::uint32_t b : buckets) {
+      reread16 += (b + 15) / 16;
+      reread32 += (b + 31) / 32;
+    }
+    std::printf(
+        "\n== routing %s: mean bucket %.1f, p50 %u, p90 %u, max %u; "
+        "sum(ceil(b/16)) %.0f, sum(ceil(b/32)) %.0f (of %d pairs) ==\n",
+        rt.name, 2048.0 * kSlots / kExperts, sorted[kExperts / 2],
+        sorted[(kExperts * 9) / 10], sorted[kExperts - 1], reread16, reread32,
+        2048 * kSlots);
+
+    auto d_ids_full = Device(ids2048);
+    std::uint32_t* d_bins = nullptr;
+    std::uint32_t* d_ranks = nullptr;
+    std::uint32_t* d_pairs = nullptr;
+    HIPCK(hipMalloc(&d_bins, (kExperts + 2) * 2 * sizeof(std::uint32_t)));
+    HIPCK(hipMalloc(&d_ranks, 2048 * kSlots * sizeof(std::uint32_t)));
+    HIPCK(hipMalloc(&d_pairs, 2048 * kSlots * sizeof(std::uint32_t)));
+    float* x_shared = nullptr;
+    std::vector<float> xh_shared;
+    HIPCK(hipMalloc(&x_shared, 2048 * 4096 * sizeof(float)));
+    {
+      std::vector<float> hx(2048 * 4096);
+      std::uint64_t rng = 7;
+      for (auto& v : hx) {
+        rng ^= rng << 13;
+        rng ^= rng >> 7;
+        rng ^= rng << 17;
+        v = static_cast<float>(static_cast<std::int32_t>(rng >> 40)) /
