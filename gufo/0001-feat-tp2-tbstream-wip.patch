+      return vocabulary_;
+    }
+    gufo::server::TextGenerationBackend::InitialOutputState InitialOutputState(
+        const ChatRequest&) const override {
+      // GLM's template always opens reasoning.
+      return gufo::server::TextGenerationBackend::InitialOutputState::
+          kReasoning;
+    }
+
+  private:
+    std::shared_ptr<const gufo::sampling::ConstraintVocabulary> vocabulary_;
+  };
+  const GlmRunner runner;
+  ChatRequest request({{ChatRole::kUser, "Call record."}});
+  request.tools = {
+      {.name = "record",
+       .parameters_json =
+           R"({"type":"object","properties":{"path":{"type":"string"},)"
+           R"("count":{"type":"integer","minimum":1,"maximum":4}},)"
+           R"("required":["path","count"],"additionalProperties":false})"}};
+  request.tool_choice = ChatRequest::ToolChoice::kRequired;
+  gufo::sampling::SamplingConfig sampling;
+  std::optional<JsonConstraint::ToolFormat> format;
+  gufo::server::ConstraintRecipe recipe;
+  const auto constrained = gufo::server::ConstrainChatRequest(
+      request, runner, &sampling, &format, &recipe);
+  Expect(constrained && format == JsonConstraint::ToolFormat::kGlm &&
+             sampling.constraint,
+         "a GLM runner composes its native tool grammar");
+  Expect(constrained->messages.front().framing_suffix.empty(),
+         "GLM native tools add no instruction to the prompt");
+  Expect(
+      recipe.present &&
+          recipe.format == static_cast<int>(JsonConstraint::ToolFormat::kGlm) &&
+          recipe.reasoning,
+      "the recipe carries the GLM format and the reasoning wrapper");
+  std::string error;
+  const auto rebuilt =
+      gufo::server::BuildConstraintFromRecipe(recipe, runner, &error);
+  Expect(rebuilt != nullptr && rebuilt->grammar != nullptr,
+         "a TP2 peer rebuilds the GLM grammar from the recipe");
+  const std::string call =
+      "<tool_call>record<arg_key>path</arg_key><arg_value>/tmp</arg_value>"
+      "<arg_key>count</arg_key><arg_value>2</arg_value></tool_call>";
+  auto state = rebuilt->grammar->Start();
+  for (const unsigned char byte : std::string_view("reason</think>")) {
+    state = rebuilt->grammar->Advance(state, byte);
+    Expect(!state.empty(), "rebuilt GLM grammar stays viable in reasoning");
+  }
+  for (const unsigned char byte : call) {
+    state = rebuilt->grammar->Advance(state, byte);
+    Expect(!state.empty(), "rebuilt GLM grammar accepts its native call");
+  }
+  Expect(rebuilt->grammar->Complete(state),
+         "rebuilt GLM grammar completes after the call");
