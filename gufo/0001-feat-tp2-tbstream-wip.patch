+// ---------------------------------------------------------------------------
+// Host harness.
+
+#define HIPCK(call)                                                 \
+  do {                                                              \
+    hipError_t err__ = (call);                                      \
+    if (err__ != hipSuccess) {                                      \
+      std::fprintf(stderr, "HIP error %s at %s:%d\n",               \
+                   hipGetErrorString(err__), __FILE__, __LINE__);  \
+      std::exit(1);                                                 \
+    }                                                               \
+  } while (0)
+
+struct Shape {
+  const char* name;
+  std::uint32_t m;
+  std::uint32_t k;
+  bool q4k;  // exercise the sub16 branch on one shape
+};
+
+constexpr std::uint32_t kQ8QK = 32;
+constexpr std::uint32_t kQ8BlockBytes = 34;
+constexpr std::uint32_t kQ4KQK = 256;
+constexpr std::uint32_t kQ4KBytes = 144;
+
+std::uint32_t g_iters = 5;
+
+enum class KId : std::uint32_t {
+  kV0,
+  kW32_32_2,
+  kW64_32_1,
+  kW64_32_2,
+  kW64_16_2,
+  kW128_32_1,
+  kW128_16_1,
+  kW128_8_1,
+  kW256_32_1,
+  kW32_32_4,
+  kW128_32_1s,
+  kW64_32_1s,
+  kL32_16_32_2,
+  kL64_16_32_1,
+  kL64_16_32_2,
+  kL128_16_32_1,
+  kL128_16_16_1,
+  kL64_16_16_2,
+  kL128_8_32_1,
+  kL256_16_32_1,
+  kZ16_32_2,
+  kZ32_32_2,
+  kZ32_32_1,
+};
+
+struct Variant {
+  const char* name;
+  KId kid;
+  std::uint32_t threads;
+  std::uint32_t grid_div;  // rows per block (Warps * Rows)
+};
+
+const std::vector<Variant>& Variants() {
+  static const std::vector<Variant> v = {
+      {"V0", KId::kV0, 1024, 64},
+      {"W32R2", KId::kW32_32_2, 1024, 64},
+      {"W64R1", KId::kW64_32_1, 1024, 32},
+      {"W64R1s", KId::kW64_32_1s, 1024, 32},
+      {"L32G16", KId::kL32_16_32_2, 1024, 64},
+      {"L64G16R1", KId::kL64_16_32_1, 1024, 32},
+      {"Z16R2", KId::kZ16_32_2, 1024, 64},
+      {"Z32R2", KId::kZ32_32_2, 1024, 64},
+      {"Z32R1", KId::kZ32_32_1, 1024, 32},
+  };
+  return v;
+}
+
+std::uint32_t TokenWidth(KId kid) {
+  switch (kid) {
+    case KId::kV0:
+    case KId::kZ16_32_2:
+      return 16;
+    case KId::kW32_32_2:
+    case KId::kW32_32_4:
+    case KId::kL32_16_32_2:
+    case KId::kZ32_32_2:
+    case KId::kZ32_32_1:
+      return 32;
+    case KId::kW64_32_1:
+    case KId::kW64_32_2:
+    case KId::kW64_16_2:
+    case KId::kW64_32_1s:
+    case KId::kL64_16_32_1:
+    case KId::kL64_16_32_2:
+    case KId::kL64_16_16_2:
+      return 64;
+    case KId::kW128_32_1:
+    case KId::kW128_16_1:
+    case KId::kW128_8_1:
+    case KId::kW128_32_1s:
+    case KId::kL128_16_32_1:
+    case KId::kL128_16_16_1:
+    case KId::kL128_8_32_1:
+      return 128;
+    case KId::kW256_32_1:
+    case KId::kL256_16_32_1:
+      return 256;
+  }
+  return 16;
+}
+
+void Launch(KId kid, std::uint32_t threads, dim3 grid, const void* w,
+            std::uint32_t type, const float* x, float* y, std::uint32_t m,
+            std::uint32_t k, std::uint32_t n, hipStream_t stream) {
+  const std::size_t y_stride = m;
+  switch (kid) {
+    case KId::kV0:
+      V0Kernel<<<grid, threads, 0, stream>>>(w, type, x, y, m, k, n, y_stride);
+      break;
+    case KId::kW32_32_2:
+      WsKernel<32, 32, 2, true><<<grid, threads, 0, stream>>>(
+          w, type, x, y, m, k, n, y_stride);
+      break;
+    case KId::kW64_32_1:
+      WsKernel<64, 32, 1, true><<<grid, threads, 0, stream>>>(
+          w, type, x, y, m, k, n, y_stride);
+      break;
+    case KId::kW64_32_2:
+      WsKernel<64, 32, 2, true><<<grid, threads, 0, stream>>>(
+          w, type, x, y, m, k, n, y_stride);
+      break;
+    case KId::kW64_16_2:
+      WsKernel<64, 16, 2, true><<<grid, threads, 0, stream>>>(
+          w, type, x, y, m, k, n, y_stride);
+      break;
+    case KId::kW128_32_1:
+      WsKernel<128, 32, 1, true><<<grid, threads, 0, stream>>>(
+          w, type, x, y, m, k, n, y_stride);
+      break;
+    case KId::kW128_16_1:
+      WsKernel<128, 16, 1, true><<<grid, threads, 0, stream>>>(
+          w, type, x, y, m, k, n, y_stride);
+      break;
+    case KId::kW128_8_1:
+      WsKernel<128, 8, 1, true><<<grid, threads, 0, stream>>>(
+          w, type, x, y, m, k, n, y_stride);
+      break;
+    case KId::kW256_32_1:
+      WsKernel<256, 32, 1, true><<<grid, threads, 0, stream>>>(
+          w, type, x, y, m, k, n, y_stride);
+      break;
+    case KId::kW32_32_4:
+      WsKernel<32, 32, 4, true><<<grid, threads, 0, stream>>>(
+          w, type, x, y, m, k, n, y_stride);
+      break;
+    case KId::kW128_32_1s:
+      WsKernel<128, 32, 1, false><<<grid, threads, 0, stream>>>(
+          w, type, x, y, m, k, n, y_stride);
+      break;
+    case KId::kW64_32_1s:
+      WsKernel<64, 32, 1, false><<<grid, threads, 0, stream>>>(
+          w, type, x, y, m, k, n, y_stride);
+      break;
+    case KId::kL32_16_32_2:
+      LsKernel<32, 16, 32, 2><<<grid, threads, 0, stream>>>(
+          w, type, x, y, m, k, n, y_stride);
+      break;
+    case KId::kL64_16_32_1:
+      LsKernel<64, 16, 32, 1><<<grid, threads, 0, stream>>>(
+          w, type, x, y, m, k, n, y_stride);
+      break;
+    case KId::kL64_16_32_2:
+      LsKernel<64, 16, 32, 2><<<grid, threads, 0, stream>>>(
+          w, type, x, y, m, k, n, y_stride);
+      break;
+    case KId::kL128_16_32_1:
+      LsKernel<128, 16, 32, 1><<<grid, threads, 0, stream>>>(
+          w, type, x, y, m, k, n, y_stride);
+      break;
+    case KId::kL128_16_16_1:
+      LsKernel<128, 16, 16, 1><<<grid, threads, 0, stream>>>(
+          w, type, x, y, m, k, n, y_stride);
+      break;
+    case KId::kL64_16_16_2:
+      LsKernel<64, 16, 16, 2><<<grid, threads, 0, stream>>>(
+          w, type, x, y, m, k, n, y_stride);
+      break;
+    case KId::kL128_8_32_1:
+      LsKernel<128, 8, 32, 1><<<grid, threads, 0, stream>>>(
+          w, type, x, y, m, k, n, y_stride);
+      break;
+    case KId::kL256_16_32_1:
+      LsKernel<256, 16, 32, 1><<<grid, threads, 0, stream>>>(
+          w, type, x, y, m, k, n, y_stride);
+      break;
+    case KId::kZ16_32_2:
+      ZsKernel<16, 32, 2><<<grid, threads, 0, stream>>>(
+          w, type, x, y, m, k, n, y_stride);
+      break;
+    case KId::kZ32_32_2:
+      ZsKernel<32, 32, 2><<<grid, threads, 0, stream>>>(
+          w, type, x, y, m, k, n, y_stride);
+      break;
+    case KId::kZ32_32_1:
+      ZsKernel<32, 32, 1><<<grid, threads, 0, stream>>>(
+          w, type, x, y, m, k, n, y_stride);
+      break;
+  }
+}
+
+template <typename T>
+T* Device(const std::vector<T>& host) {
+  T* ptr = nullptr;
+  HIPCK(hipMalloc(&ptr, host.size() * sizeof(T)));
+  HIPCK(hipMemcpy(ptr, host.data(), host.size() * sizeof(T),
+                  hipMemcpyHostToDevice));
+  return ptr;
+}
+
+std::vector<std::uint8_t> MakeQ8K0Weights(std::uint32_t m, std::uint32_t k) {
+  const std::size_t row_bytes = (k / kQ8QK) * kQ8BlockBytes;
+  std::vector<std::uint8_t> w(static_cast<std::size_t>(m) * row_bytes);
+  std::uint64_t rng = 0x9e3779b97f4a7c15ULL;
+  const auto next32 = [&]() {
+    rng ^= rng << 13;
+    rng ^= rng >> 7;
+    rng ^= rng << 17;
+    return static_cast<std::uint32_t>(rng >> 32);
+  };
+  for (std::size_t i = 0; i < w.size(); ++i) {
+    w[i] = static_cast<std::uint8_t>(next32());
+  }
+  for (std::size_t r = 0; r < m; ++r) {
+    for (std::size_t b = 0; b < k / kQ8QK; ++b) {
+      std::uint8_t* blk = w.data() + r * row_bytes + b * kQ8BlockBytes;
+      const std::uint16_t d =
+          static_cast<std::uint16_t>(0x3800 + (next32() & 0xff));
+      std::memcpy(blk, &d, 2);
+    }
+  }
+  return w;
+}
+
+std::vector<std::uint8_t> MakeQ4KWeights(std::uint32_t m, std::uint32_t k) {
+  const std::size_t row_bytes = (k / kQ4KQK) * kQ4KBytes;
+  std::vector<std::uint8_t> w(static_cast<std::size_t>(m) * row_bytes);
+  std::uint64_t rng = 0x6a09e667f3bcc909ULL;
+  const auto next32 = [&]() {
+    rng ^= rng << 13;
+    rng ^= rng >> 7;
+    rng ^= rng << 17;
+    return static_cast<std::uint32_t>(rng >> 32);
+  };
+  for (std::size_t i = 0; i < w.size(); ++i) {
+    w[i] = static_cast<std::uint8_t>(next32());
+  }
+  for (std::size_t r = 0; r < m; ++r) {
+    for (std::size_t b = 0; b < k / kQ4KQK; ++b) {
+      std::uint8_t* blk = w.data() + r * row_bytes + b * kQ4KBytes;
+      const std::uint16_t d =
+          static_cast<std::uint16_t>(0x3800 + (next32() & 0xff));
+      const std::uint16_t dmin =
+          static_cast<std::uint16_t>(0x3000 + (next32() & 0x3f));
+      std::memcpy(blk, &d, 2);
+      std::memcpy(blk + 2, &dmin, 2);
+    }
+  }
+  return w;
+}
+
+int CountDiff(const float* a, const float* b, std::size_t n) {
+  int bad = 0;
+  for (std::size_t i = 0; i < n; ++i) {
+    if (std::memcmp(&a[i], &b[i], 4) != 0) {
+      if (bad < 3) {
+        std::printf("    diff at %zu: %a vs %a\n", i, a[i], b[i]);
+      }
+      ++bad;
+    }
+  }
+  return bad;
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+  setvbuf(stdout, nullptr, _IONBF, 0);
+  if (argc > 1) {
+    g_iters = static_cast<std::uint32_t>(std::atoi(argv[1]));
+  }
+  // Optional filters: [iters] [shape-index] [tokens]
+  const int shape_filter = argc > 2 ? std::atoi(argv[2]) : -1;
+  const std::uint32_t n_filter =
+      argc > 3 ? static_cast<std::uint32_t>(std::atoi(argv[3])) : 0;
+  const char* vfilter = argc > 4 ? argv[4] : nullptr;
+  hipStream_t stream;
+  HIPCK(hipStreamCreate(&stream));
+
+  const std::vector<Shape> shapes = {
+      {"kda.q 8192x4096", 8192, 4096, false},
+      {"kda.out 4096x8192", 4096, 8192, false},
+      {"dense.gate 12288x4096", 12288, 4096, false},
+      {"dense.down 4096x12288", 4096, 12288, false},
+      {"dsa.q_b 16384x1536", 16384, 1536, false},
+      {"dsa.out 4096x16384", 4096, 16384, false},
+      {"gate.q4k 12288x4096", 12288, 4096, true},
+  };
+  constexpr std::uint32_t kMaxM = 16384;
+  constexpr std::uint32_t kMaxN = 2048;
+
+  std::vector<float> xh(static_cast<std::size_t>(kMaxN) * 16384);
+  {
+    std::uint64_t rng = 7;
+    for (auto& v : xh) {
+      rng ^= rng << 13;
+      rng ^= rng >> 7;
+      rng ^= rng << 17;
+      v = static_cast<float>(static_cast<std::int32_t>(rng >> 40)) /
+          2147483648.0F;
+    }
+  }
+  float* x = Device(xh);
+  float* y = nullptr;
+  float* y_ref = nullptr;
+  HIPCK(hipMalloc(&y, static_cast<std::size_t>(kMaxN) * kMaxM * sizeof(float)));
+  HIPCK(hipMalloc(&y_ref,
+                  static_cast<std::size_t>(kMaxN) * kMaxM * sizeof(float)));
+
+  const std::uint32_t type_q8 =
+      static_cast<std::uint32_t>(gufo::core::GgmlType::kQ8_0);
+  const std::uint32_t type_q4 =
+      static_cast<std::uint32_t>(gufo::core::GgmlType::kQ4_K);
+
+  for (std::size_t si = 0; si < shapes.size(); ++si) {
+    if (shape_filter >= 0 && static_cast<int>(si) != shape_filter) {
+      continue;
+    }
+    const Shape& s = shapes[si];
+    const std::uint32_t type = s.q4k ? type_q4 : type_q8;
+    auto wh = s.q4k ? MakeQ4KWeights(s.m, s.k) : MakeQ8K0Weights(s.m, s.k);
+    const void* w = Device(wh);
+    std::printf("\n== %s (%s) ==\n", s.name, s.q4k ? "Q4_K" : "Q8_0");
+
+    for (std::uint32_t n : {96u, 513u, 1024u, 2048u}) {
+      if (n_filter != 0 && n != n_filter) {
+        continue;
+      }
+      const std::size_t ycount = static_cast<std::size_t>(n) * s.m;
+      // Reference: V0 at the same width.
+      HIPCK(hipMemset(y_ref, 0xCD, ycount * 4));
+      Launch(KId::kV0, 1024, dim3(s.m / 64, (n + 15) / 16), w, type, x, y_ref,
+             s.m, s.k, n, stream);
+      HIPCK(hipStreamSynchronize(stream));
+      std::printf("-- tokens %u --\n", n);
+      std::vector<float> hr(ycount);
+      HIPCK(hipMemcpy(hr.data(), y_ref, ycount * 4, hipMemcpyDeviceToHost));
+      std::vector<double> times;
+      std::vector<const char*> flags;
+      for (const Variant& v : Variants()) {
+        if (s.m % v.grid_div != 0 ||
+            (vfilter != nullptr &&
+             std::strstr(v.name, vfilter) == nullptr)) {
+          times.push_back(-1.0);
+          flags.push_back("skip");
+          continue;
+        }
+        const std::uint32_t tper = TokenWidth(v.kid);
+        HIPCK(hipMemset(y, 0xCD, ycount * 4));
+        Launch(v.kid, v.threads, dim3(s.m / v.grid_div, (n + tper - 1) / tper),
+               w, type, x, y, s.m, s.k, n, stream);
+        HIPCK(hipStreamSynchronize(stream));
+        const char* flag = "";
+        if (v.kid != KId::kV0) {
+          std::vector<float> hy(ycount);
+          HIPCK(hipMemcpy(hy.data(), y, ycount * 4, hipMemcpyDeviceToHost));
+          flag = CountDiff(hy.data(), hr.data(), ycount) ? "(!DIFF)" : "(ok)";
+        }
+        hipEvent_t start, stop;
+        HIPCK(hipEventCreate(&start));
+        HIPCK(hipEventCreate(&stop));
+        for (int i = 0; i < 2; ++i) {
+          Launch(v.kid, v.threads,
+                 dim3(s.m / v.grid_div, (n + tper - 1) / tper), w, type, x, y,
+                 s.m, s.k, n, stream);
+        }
+        HIPCK(hipEventRecord(start, stream));
+        for (std::uint32_t i = 0; i < g_iters; ++i) {
+          Launch(v.kid, v.threads,
+                 dim3(s.m / v.grid_div, (n + tper - 1) / tper), w, type, x, y,
+                 s.m, s.k, n, stream);
+        }
+        HIPCK(hipEventRecord(stop, stream));
+        HIPCK(hipEventSynchronize(stop));
+        float ms = 0.0F;
+        HIPCK(hipEventElapsedTime(&ms, start, stop));
+        HIPCK(hipEventDestroy(start));
+        HIPCK(hipEventDestroy(stop));
+        times.push_back(ms / g_iters);
+        flags.push_back(flag);
+      }
+      for (std::size_t i = 0; i < Variants().size(); ++i) {
+        if (times[i] < 0.0) {
+          continue;
+        }
+        std::printf("  %s=%.2f%s", Variants()[i].name, times[i], flags[i]);
+      }
+      std::printf("\n");
+    }
+
+    // Executor twin pattern: variant(n=N) must equal V0(n=1) x N (the
+    // chunked-vs-tokenwise byte-equality contract).
+    for (std::uint32_t n : {513u, 1024u}) {
+      const std::size_t ycount = static_cast<std::size_t>(n) * s.m;
+      HIPCK(hipMemset(y_ref, 0xCD, ycount * 4));
+      for (std::uint32_t t = 0; t < n; ++t) {
+        Launch(KId::kV0, 1024, dim3(s.m / 64, 1), w, type,
+               x + static_cast<std::size_t>(t) * s.k,
+               y_ref + static_cast<std::size_t>(t) * s.m, s.m, s.k, 1, stream);
+      }
+      HIPCK(hipStreamSynchronize(stream));
+      std::vector<float> hr(ycount);
+      HIPCK(hipMemcpy(hr.data(), y_ref, ycount * 4, hipMemcpyDeviceToHost));
+      for (const Variant& v : Variants()) {
+        if (v.kid == KId::kV0 || s.m % v.grid_div != 0) {
+          continue;
+        }
+        const std::uint32_t tper = TokenWidth(v.kid);
+        HIPCK(hipMemset(y, 0xCD, ycount * 4));
+        Launch(v.kid, v.threads, dim3(s.m / v.grid_div, (n + tper - 1) / tper),
+               w, type, x, y, s.m, s.k, n, stream);
+        HIPCK(hipStreamSynchronize(stream));
+        std::vector<float> hy(ycount);
+        HIPCK(hipMemcpy(hy.data(), y, ycount * 4, hipMemcpyDeviceToHost));
+        std::printf("  twin n=%u %s: %s\n", n, v.name,
+                    CountDiff(hy.data(), hr.data(), ycount) ? "(!DIFF)" : "(ok)");
+      }
+    }
+
+    // Small-n dispatch crossover on this shape.
+    std::printf("-- small-n (ms/launch) --\n");
+    for (std::uint32_t n : {1u, 8u, 16u, 32u, 64u}) {
+      const std::size_t ycount = static_cast<std::size_t>(n) * s.m;
+      std::printf("  n=%-3u", n);
+      for (const Variant& v : Variants()) {
+        if (s.m % v.grid_div != 0) {
+          continue;
+        }
+        const std::uint32_t tper = TokenWidth(v.kid);
+        hipEvent_t start, stop;
+        HIPCK(hipEventCreate(&start));
+        HIPCK(hipEventCreate(&stop));
+        for (int i = 0; i < 2; ++i) {
+          Launch(v.kid, v.threads,
+                 dim3(s.m / v.grid_div, (n + tper - 1) / tper), w, type, x, y,
+                 s.m, s.k, n, stream);
+        }
+        HIPCK(hipEventRecord(start, stream));
+        for (std::uint32_t i = 0; i < g_iters; ++i) {
+          Launch(v.kid, v.threads,
+                 dim3(s.m / v.grid_div, (n + tper - 1) / tper), w, type, x, y,
+                 s.m, s.k, n, stream);
+        }
+        HIPCK(hipEventRecord(stop, stream));
+        HIPCK(hipEventSynchronize(stop));
+        float ms = 0.0F;
+        HIPCK(hipEventElapsedTime(&ms, start, stop));
+        HIPCK(hipEventDestroy(start));
+        HIPCK(hipEventDestroy(stop));
+        std::printf(" %s=%.3f", v.name, ms / g_iters);
+      }
+      std::printf("\n");
+      (void)ycount;
+    }
+
+    HIPCK(hipFree(const_cast<void*>(w)));
+  }
+  return 0;
+}
