+
+// The API surface trims framing with ASCII whitespace; the scanner keeps the
+// same reading so parser decisions do not depend on Unicode table updates.
+std::string_view TrimAscii(std::string_view value) {
+  while (!value.empty() &&
+         std::isspace(static_cast<unsigned char>(value.front())) != 0)
+    value.remove_prefix(1);
+  while (!value.empty() &&
+         std::isspace(static_cast<unsigned char>(value.back())) != 0)
+    value.remove_suffix(1);
+  return value;
+}
+
+std::optional<std::string> Attribute(std::string_view tag,
+                                     std::string_view name) {
+  const std::string prefix = std::string(name) + "=\"";
+  const std::size_t start = tag.find(prefix);
+  if (start == std::string_view::npos)
+    return std::nullopt;
+  const std::size_t value_start = start + prefix.size();
+  const std::size_t end = tag.find('"', value_start);
+  if (end == std::string_view::npos)
+    return std::nullopt;
+  return std::string(tag.substr(value_start, end - value_start));
+}
+
+// Hold a possible closing delimiter until its next byte disambiguates it.
+std::string_view BeforePartialDelimiter(std::string_view value,
+                                        std::string_view delimiter) {
+  for (auto size = std::min(value.size(), delimiter.size()); size > 0; --size)
+    if (delimiter.starts_with(value.substr(value.size() - size)))
+      return value.substr(0, value.size() - size);
+  return value;
+}
+
+std::optional<json::Value> TryParseJson(std::string_view value) noexcept {
+  try {
+    return json::parse(value);
+  } catch (...) {
+    return std::nullopt;
+  }
+}
+
+}  // namespace
+
+void ScanDeepSeekToolCalls(
+    std::string_view text, std::span<const std::string_view> markers,
+    std::vector<ScannedToolCall>* calls,
+    std::vector<std::pair<std::size_t, std::size_t>>* spans, bool partial) {
+  std::size_t cursor = 0;
+  std::size_t envelope_begin = std::string_view::npos;
+  std::string envelope_end;
+  while (cursor < text.size()) {
+    std::size_t invoke_start = std::string_view::npos;
+    std::size_t syntax = 0;
+    for (std::size_t index = 0; index < DeepSeekToolSyntax::kInvokeOpens.size();
+         ++index) {
+      const std::size_t position =
+          text.find(DeepSeekToolSyntax::kInvokeOpens[index], cursor);
+      if (position < invoke_start) {
+        invoke_start = position;
+        syntax = index;
+      }
+    }
+    if (spans) {
+      // Examine envelope boundaries only outside the parameter/invocation
+      // ranges consumed below: an outer closing tag can be argument data.
+      if (envelope_begin == std::string_view::npos) {
+        std::string_view opening;
+        std::size_t begin = std::string_view::npos;
+        for (const auto marker : markers) {
+          const auto position = text.find(marker, cursor);
+          if (position < begin) {
+            begin = position;
+            opening = marker;
+          }
+        }
+        // Bare invocation examples outside an outer envelope are prose.
+        if (begin == std::string_view::npos)
+          break;
+        envelope_begin = begin;
+        envelope_end =
+            "</" + std::string(opening.substr(opening.find('<') + 1));
+        cursor = begin + opening.size();
+        continue;
+      }
+      if (const auto end = text.find(envelope_end, cursor);
+          end < invoke_start) {
+        cursor = end + envelope_end.size();
+        spans->emplace_back(envelope_begin, cursor);
+        envelope_begin = std::string_view::npos;
+        continue;
+      }
+    }
+    if (invoke_start == std::string_view::npos) {
+      break;
+    }
+    const std::size_t tag_end = text.find('>', invoke_start);
+    if (tag_end == std::string_view::npos) {
+      break;
+    }
+    ScannedToolCall call;
+    const auto name = Attribute(
+        text.substr(invoke_start, tag_end - invoke_start + 1), "name");
+    call.name = name.value_or("");
+
+    bool valid = !call.name.empty();
+    std::size_t protected_end = tag_end + 1;
+    std::size_t parameter_cursor = tag_end + 1;
+    while (parameter_cursor < text.size()) {
+      auto remainder = TrimAscii(text.substr(parameter_cursor));
+      parameter_cursor =
+          static_cast<std::size_t>(remainder.data() - text.data());
+      if (!remainder.starts_with(DeepSeekToolSyntax::kParameterOpens[syntax])) {
+        break;
+      }
+      const std::size_t parameter_start = parameter_cursor;
+      const std::size_t parameter_tag_end = text.find('>', parameter_start);
+      std::size_t parameter_end = text.find(
+          DeepSeekToolSyntax::kParameterCloses[syntax], parameter_tag_end);
+      if (parameter_tag_end == std::string_view::npos ||
+          parameter_end == std::string_view::npos) {
+        if (partial && parameter_tag_end != std::string_view::npos) {
+          const auto tag = text.substr(parameter_start,
+                                       parameter_tag_end - parameter_start + 1);
+          const auto name = Attribute(tag, "name");
+          if (name && !name->empty() &&
+              Attribute(tag, "string").value_or("true") == "true")
+            call.unfinished = ChatMessage::ToolArgument{
+                .name = *name,
+                .value = std::string(BeforePartialDelimiter(
+                    text.substr(parameter_tag_end + 1),
+                    DeepSeekToolSyntax::kParameterCloses[syntax])),
+                .is_string = true};
+        }
+        protected_end = text.size();
+        valid = false;
+        break;
+      }
+      const std::string_view tag =
+          text.substr(parameter_start, parameter_tag_end - parameter_start + 1);
+      const auto parameter_name = Attribute(tag, "name");
+      const auto string_value = Attribute(tag, "string");
+      if (parameter_name && !parameter_name->empty() &&
+          (!string_value || *string_value == "true" ||
+           *string_value == "false")) {
+        const bool is_string = string_value.value_or("true") == "true";
+        // JSON strings may contain DSML delimiters. Find the end of the JSON
+        // value before interpreting the enclosing markup.
+        while (
+            !is_string && parameter_end != std::string_view::npos &&
+            !TryParseJson(TrimAscii(text.substr(
+                parameter_tag_end + 1, parameter_end - parameter_tag_end - 1))))
+          parameter_end = text.find(
+              DeepSeekToolSyntax::kParameterCloses[syntax],
+              parameter_end +
+                  DeepSeekToolSyntax::kParameterCloses[syntax].size());
+        if (parameter_end == std::string_view::npos) {
+          protected_end = text.size();
+          valid = false;
+          break;
+        }
+        const auto raw = text.substr(parameter_tag_end + 1,
+                                     parameter_end - parameter_tag_end - 1);
+        ChatMessage::ToolArgument argument{
+            .name = *parameter_name,
+            .value = std::string(is_string ? raw : TrimAscii(raw)),
+            .is_string = is_string,
+        };
+        // As for Qwen calls: drop an identical repeat and reject a
+        // conflicting one instead of letting the last value win.
+        const auto previous =
+            std::ranges::find(call.arguments, argument.name,
+                              [](const auto& arg) { return arg.name; });
+        if (previous == call.arguments.end()) {
+          call.arguments.push_back(std::move(argument));
+        } else if (previous->value != argument.value ||
+                   previous->is_string != argument.is_string) {
+          valid = false;
+        }
+      } else {
+        valid = false;
+      }
+      parameter_cursor =
+          parameter_end + DeepSeekToolSyntax::kParameterCloses[syntax].size();
+      protected_end = parameter_cursor;
+    }
+    const bool complete =
+        text.substr(parameter_cursor)
+            .starts_with(DeepSeekToolSyntax::kInvokeCloses[syntax]);
+    call.valid = valid;
+    call.complete = complete;
+    if ((valid && complete) || (partial && !call.name.empty())) {
+      calls->push_back(std::move(call));
+      if (!(valid && complete)) {
+        break;
+      }
+    }
+    cursor = complete ? parameter_cursor +
+                            DeepSeekToolSyntax::kInvokeCloses[syntax].size()
+                      : protected_end;
+  }
+}
+
+}  // namespace gufo::models::deepseek_v4_flash
diff --git a/src/models/deepseek_v4_flash/tool_calls.hpp b/src/models/deepseek_v4_flash/tool_calls.hpp
new file mode 100644
index 00000000..4ad5c716
--- /dev/null
+++ b/src/models/deepseek_v4_flash/tool_calls.hpp
@@ -0,0 +1,77 @@
+#ifndef GUFO_MODELS_DEEPSEEK_V4_FLASH_TOOL_CALLS_HPP_
+#define GUFO_MODELS_DEEPSEEK_V4_FLASH_TOOL_CALLS_HPP_
+
+#include <array>
+#include <cstddef>
+#include <optional>
+#include <span>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "src/models/deepseek_v4_flash/chat_template.hpp"
+
+namespace gufo::models::deepseek_v4_flash {
+
+/// The literals that frame a DeepSeek tool invocation. AppendToolCalls renders
+/// with the canonical member of each spelling family, and
+/// ScanDeepSeekToolCalls admits the whole family the checkpoint writes, so the
+/// wire format cannot change in one direction only (#290).
+struct DeepSeekToolSyntax {
+  static constexpr std::string_view kCallsOpen = "<｜DSML｜tool_calls>";
+  /// The template's separator before the block, as in llama.cpp's
+  /// TC_SEPARATOR + FC_START.
+  static constexpr std::string_view kCallsOpenWithSeparator =
+      "\n\n<｜DSML｜tool_calls>";
+  /// The canonical block opener followed by the renderer's first
+  /// invocation header, as admitted by the native constrained grammar.
+  static constexpr std::string_view kNativeCallOpen =
+      "<｜DSML｜tool_calls>\n<｜DSML｜invoke name=\"";
+  static constexpr std::string_view kNativeCallOpenWithSeparator =
+      "\n\n<｜DSML｜tool_calls>\n<｜DSML｜invoke name=\"";
+  static constexpr std::string_view kCallsClose = "</｜DSML｜tool_calls>";
+  static constexpr std::array<std::string_view, 4> kInvokeOpens{
+      "<｜DSML｜invoke", "<DSML｜invoke", "<｜DS｜invoke", "<DS｜invoke"};
+  static constexpr std::array<std::string_view, 4> kInvokeCloses{
+      "</｜DSML｜invoke>", "</DSML｜invoke>", "</｜DS｜invoke>",
+      "</DS｜invoke>"};
+  static constexpr std::array<std::string_view, 4> kParameterOpens{
+      "<｜DSML｜parameter", "<DSML｜parameter", "<｜DS｜parameter",
+      "<DS｜parameter"};
+  static constexpr std::array<std::string_view, 4> kParameterCloses{
+      "</｜DSML｜parameter>", "</DSML｜parameter>", "</｜DS｜parameter>",
+      "</DS｜parameter>"};
+  /// The canonical attribute framing the renderer writes.
+  static constexpr std::string_view kNameAttribute = "name=\"";
+  static constexpr std::string_view kStringAttribute = "string=\"";
+};
+
+/// One invocation exactly as the model wrote it, before the API surface
+/// applies a declared schema.
+struct ScannedToolCall {
+  std::string name;
+  std::vector<ChatMessage::ToolArgument> arguments;
+  /// An unterminated `string="true"` parameter, held back from a possible
+  /// closing delimiter.
+  std::optional<ChatMessage::ToolArgument> unfinished;
+  /// Every scanned parameter and attribute was well formed, and repeated
+  /// parameters did not conflict.
+  bool valid{false};
+  /// The closing invocation tag was consumed.
+  bool complete{false};
+};
+
+/// Scans DeepSeek invocations and their enclosing call blocks. `markers` are
+/// the dialect openers the request grammar admits; `spans` receives the byte
+/// ranges of closed outer blocks. Schema interpretation and OpenAI shaping
+/// stay with the API surface.
+void ScanDeepSeekToolCalls(
+    std::string_view text, std::span<const std::string_view> markers,
+    std::vector<ScannedToolCall>* calls,
+    std::vector<std::pair<std::size_t, std::size_t>>* spans = nullptr,
+    bool partial = false);
+
+}  // namespace gufo::models::deepseek_v4_flash
+
+#endif  // GUFO_MODELS_DEEPSEEK_V4_FLASH_TOOL_CALLS_HPP_
diff --git a/src/models/glm5_next/CMakeLists.txt b/src/models/glm5_next/CMakeLists.txt
new file mode 100644
index 00000000..8a13dfb0
--- /dev/null
+++ b/src/models/glm5_next/CMakeLists.txt
@@ -0,0 +1,50 @@
+# GLM-5.3-Flash (glm5-next) model package: configuration, tensor binding,
+# the TP=2 resident-byte plan and the scalar CPU reference. Kernels arrive
+# with the first-leg plan's P2 slice.
+add_library(gufo_glm5_next STATIC
+  config.cpp
+  weights.cpp
+  chat_template.cpp
+  reference.cpp
+  distributed/tp_plan.cpp
+  distributed/tp_partition.cpp)
+
+target_include_directories(gufo_glm5_next PUBLIC ${PROJECT_SOURCE_DIR})
+target_link_libraries(gufo_glm5_next PUBLIC gufo_core Threads::Threads)
+
+# The reference decodes every weight on the fly; unoptimized it is unusable
+# even as an oracle, so it keeps -O2 in every configuration.
+set_source_files_properties(reference.cpp PROPERTIES COMPILE_OPTIONS "-O2")
+
+if (ENGINE_ENABLE_HIP)
+  # P2 slice: resident weights first; eager kernels arrive with the
+  # operator phases. Correctness-first: no fast-math, so the kernels keep
+  # the reference's transcendental behavior. The engine (P3.7) wraps the
+  # qualified executor for serving.
+  target_sources(gufo_glm5_next PRIVATE
+    ${CMAKE_CURRENT_SOURCE_DIR}/kernels/rocm/device_model.cpp
+    ${CMAKE_CURRENT_SOURCE_DIR}/kernels/rocm/executor.cpp
+    ${CMAKE_CURRENT_SOURCE_DIR}/kernels/rocm/kernels.hip.cpp
+    ${CMAKE_CURRENT_SOURCE_DIR}/kernels/rocm/kernels_batch.hip.cpp
+    ${CMAKE_CURRENT_SOURCE_DIR}/engine.cpp)
+  set_source_files_properties(
+    ${CMAKE_CURRENT_SOURCE_DIR}/kernels/rocm/kernels.hip.cpp
+    ${CMAKE_CURRENT_SOURCE_DIR}/kernels/rocm/kernels_batch.hip.cpp
+    PROPERTIES LANGUAGE HIP)
+  # Statement-level FP contraction only. The default (fast) lets clang
+  # contract across statements differently per unrolled iteration, so a
+  # token's projection value silently depends on its slot inside the
+  # token tile — the chunked and tokenwise paths then disagree in the
+  # last ulp (the exec byte-equality gates catch it). `-ffp-contract=on`
+  # keeps every iteration of the tiled consumers' unrolled token loops
+  # on one contraction shape, restoring slot-independence; the CPU-oracle
+  # RMS caps cover the (statement-level) rounding this produces.
+  set_source_files_properties(
+    ${CMAKE_CURRENT_SOURCE_DIR}/kernels/rocm/kernels_batch.hip.cpp
+    PROPERTIES LANGUAGE HIP COMPILE_OPTIONS "-ffp-contract=on")
+  target_include_directories(gufo_glm5_next SYSTEM PRIVATE
+    ${ROCPRIM_INCLUDE_DIR})
+  target_compile_options(gufo_glm5_next PRIVATE
+    $<$<COMPILE_LANGUAGE:HIP>:-O3>)
+  target_link_libraries(gufo_glm5_next PUBLIC hip::host)
+endif()
diff --git a/src/models/glm5_next/chat_template.cpp b/src/models/glm5_next/chat_template.cpp
new file mode 100644
index 00000000..b6c3b34f
--- /dev/null
+++ b/src/models/glm5_next/chat_template.cpp
@@ -0,0 +1,364 @@
+#include "src/models/glm5_next/chat_template.hpp"
+
+#include <algorithm>
+#include <cctype>
+#include <cstddef>
+#include <cstdint>
+#include <unordered_set>
+#include <utility>
+
+#include "src/core/crypto/sha256.hpp"
+
+namespace gufo::models::glm5_next {
+namespace {
+
+constexpr std::string_view kHeader = "[gMASK]<sop>";
+constexpr std::string_view kSystem = "<|system|>";
+constexpr std::string_view kUser = "<|user|>";
+constexpr std::string_view kAssistant = "<|assistant|>";
+constexpr std::string_view kObservation = "<|observation|>";
+constexpr std::string_view kThink = "<think>";
+constexpr std::string_view kThinkEnd = "</think>";
+
+std::string_view NormalizeEffort(
+    const std::optional<std::string_view>& effort) {
+  if (!effort.has_value()) {
+    return "max";
+  }
+  if (*effort == "low" || *effort == "high" || *effort == "max") {
+    return *effort;
+  }
+  return "max";
+}
+
+void AppendEffortLine(std::string& out,
+                      const std::optional<std::string_view>& effort) {
+  out.append(kSystem);
+  out.append("Reasoning Effort: ");
+  const std::string_view value = NormalizeEffort(effort);
+  out.push_back(static_cast<char>(
+      std::toupper(static_cast<unsigned char>(value.front()))));
+  out.append(value.substr(1));
+}
+
+void AppendJsonString(std::string& out, std::string_view value) {
+  out.push_back('"');
+  for (const unsigned char character : value) {
+    switch (character) {
+      case '"':
+        out.append("\\\"");
+        break;
+      case '\\':
+        out.append("\\\\");
+        break;
+      case '\b':
+        out.append("\\b");
+        break;
+      case '\f':
+        out.append("\\f");
+        break;
+      case '\n':
+        out.append("\\n");
+        break;
+      case '\r':
+        out.append("\\r");
+        break;
+      case '\t':
+        out.append("\\t");
+        break;
+      default:
+        out.push_back(static_cast<char>(character));
+        break;
+    }
+  }
+  out.push_back('"');
+}
+
+/// The template's tool_to_json macro: `{"name": ..., "description": ...,
+/// "parameters": ...}` with ", " separators and compact JSON values.
+void AppendToolJson(std::string& out, const ChatTool& tool) {
+  out.append("{\"name\": ");
+  AppendJsonString(out, tool.name);
+  out.append(", \"description\": ");
+  AppendJsonString(out, tool.description);
+  out.append(", \"parameters\": ");
+  out.append(tool.parameters_json);
+  out.push_back('}');
+}
+
+void AppendToolsBlock(std::string& out, std::span<const ChatTool> tools) {
+  if (tools.empty()) {
+    return;
+  }
+  out.append(kSystem);
+  out.append(
+      "\n# Tools\n\n"
+      "You may call one or more functions to assist with the user query.\n\n"
+      "You are provided with function signatures within <tools></tools> XML "
+      "tags:\n<tools>\n");
+  for (const auto& tool : tools) {
+    out.push_back('\n');
+    AppendToolJson(out, tool);
+    out.append("\n\n");
+  }
+  out.append(
+      "\n</tools>\n\n"
+      "For each function call, output the function name and arguments "
+      "within the following XML format:\n"
+      "<tool_call>{function-name}<arg_key>{arg-key-1}</arg_key>"
+      "<arg_value>{arg-value-1}</arg_value><arg_key>{arg-key-2}</arg_key>"
+      "<arg_value>{arg-value-2}</arg_value>...</tool_call>");
+}
+
+std::string_view Stripped(std::string_view text) {
+  while (!text.empty() &&
+         std::isspace(static_cast<unsigned char>(text.front()))) {
+    text.remove_prefix(1);
+  }
+  while (!text.empty() &&
+         std::isspace(static_cast<unsigned char>(text.back()))) {
+    text.remove_suffix(1);
+  }
+  return text;
+}
+
+/// Reasoning shown for one assistant turn: explicit reasoning_content, or
+/// the <think> span embedded in content (which is then removed).
+void SplitReasoning(const ChatMessage& message, std::string& reasoning,
+                    std::string& content) {
+  content = message.content;
+  if (!message.reasoning_content.empty()) {
+    reasoning = message.reasoning_content;
+    return;
+  }
+  const std::size_t end = content.find(kThinkEnd);
+  if (end == std::string::npos) {
+    reasoning.clear();
+    return;
+  }
+  const std::size_t begin = content.find(kThink);
+  if (begin == std::string::npos || begin > end) {
+    reasoning.clear();
+    return;
+  }
+  reasoning =
+      content.substr(begin + kThink.size(), end - begin - kThink.size());
+  content = content.substr(end + kThinkEnd.size());
+}
+
+struct ToolRun {
+  std::size_t begin{0};
+  std::size_t end{0};  // Exclusive.
+  /// The assistant tool_calls preceding the run, null when absent.
+  const std::vector<ChatMessage::ToolCall>* calls{nullptr};
+  /// True when results may be reordered to match the call ids.
+  bool can_sort{false};
+};
+
+std::string_view ResultId(const ChatMessage& message) {
+  return message.tool_call_id.empty() ? std::string_view{}
+                                      : message.tool_call_id;
+}
+
+bool RunCanSort(std::span<const ChatMessage> messages, const ToolRun& run) {
+  if (run.calls == nullptr || run.calls->empty()) {
+    return false;
+  }
+  std::unordered_set<std::string_view> call_ids;
+  for (const auto& call : *run.calls) {
+    if (call.id.empty() || !call_ids.insert(call.id).second) {
+      return false;
+    }
+  }
+  std::unordered_set<std::string_view> seen;
+  for (std::size_t i = run.begin; i < run.end; ++i) {
+    const std::string_view id = ResultId(messages[i]);
+    if (id.empty() || !seen.insert(id).second ||
+        call_ids.find(id) == call_ids.end()) {
+      return false;
+    }
+  }
+  return true;
+}
+
+void AppendToolResult(std::string& out, const ChatMessage& message,
+                      const ChatTool* referenced) {
+  out.append("<tool_response>");
+  if (referenced != nullptr) {
+    out.append("<tools>\n");
+    AppendToolJson(out, *referenced);
+    out.append("\n</tools>");
+  } else {
+    out.append(message.content);
+  }
+  out.append("</tool_response>");
+}
+
+void AppendObservationRun(std::string& out, std::span<const ChatMessage> all,
+                          std::size_t begin, std::size_t end,
+                          const ToolRun& run, std::string* error) {
+  out.append(kObservation);
+  if (run.can_sort) {
+    for (const auto& call : *run.calls) {
+      for (std::size_t i = begin; i < end; ++i) {
+        if (ResultId(all[i]) == call.id) {
+          AppendToolResult(out, all[i], nullptr);
+        }
+      }
+    }
+    return;
+  }
+  for (std::size_t i = begin; i < end; ++i) {
+    AppendToolResult(out, all[i], nullptr);
+  }
+  (void)error;
+}
+
+}  // namespace
+
+std::string RenderChat(std::span<const ChatMessage> messages,
+                       std::span<const ChatTool> tools,
+                       const ChatTemplateOptions& options) {
+  std::string out;
+  out.reserve(1024);
+  out.append(kHeader);
+  AppendEffortLine(out, options.reasoning_effort);
+  AppendToolsBlock(out, tools);
+
+  // Last user position drives clear_thinking (reasoning before it drops).
+  std::size_t last_user = messages.size();
+  for (std::size_t i = 0; i < messages.size(); ++i) {
+    if (messages[i].role == "user") {
+      last_user = i;
+    }
+  }
+
+  std::size_t i = 0;
+  while (i < messages.size()) {
+    const ChatMessage& message = messages[i];
+    if (message.role == "user") {
+      out.append(kUser);
+      out.append(message.content);
+      ++i;
+      continue;
+    }
+    if (message.role == "system") {
+      out.append(kSystem);
+      out.append(message.content);
+      ++i;
+      continue;
+    }
+    if (message.role == "assistant") {
+      out.append(kAssistant);
+      std::string reasoning;
+      std::string content;
+      SplitReasoning(message, reasoning, content);
+      // Clearing drops reasoning on turns at or before the last user
+      // message; later assistant turns keep it.
+      const bool cleared = options.clear_thinking && i <= last_user;
+      const bool has_reasoning =
+          (!message.reasoning_content.empty() || !reasoning.empty()) &&
+          !cleared;
+      out.append(kThink);
+      if (has_reasoning) {
+        out.append(reasoning);
+      }
+      out.append(kThinkEnd);
+      const std::string_view stripped = Stripped(content);
+      if (!stripped.empty()) {
+        out.append(stripped);
+      }
+      if (!message.tool_calls.empty()) {
+        out.push_back('\n');
+        for (const auto& call : message.tool_calls) {
+          out.append("<tool_call>");
+          out.append(call.name);
+          for (const auto& argument : call.arguments) {
+            out.append("<arg_key>");
+            out.append(argument.name);
+            out.append("</arg_key><arg_value>");
+            if (argument.is_string) {
+              out.append(argument.value);
+            } else {
+              out.append(argument.value);  // Compact JSON, pre-encoded.
+            }
+            out.append("</arg_value>");
+          }
+          out.append("</tool_call>");
+        }
+        out.push_back('\n');
+      }
+      ++i;
+      continue;
+    }
+    if (message.role == "tool") {
+      ToolRun run;
+      run.begin = i;
+      run.end = i;
+      while (run.end < messages.size() && messages[run.end].role == "tool") {
+        ++run.end;
+      }
+      if (run.begin > 0 && messages[run.begin - 1].role == "assistant" &&
+          !messages[run.begin - 1].tool_calls.empty()) {
+        run.calls = &messages[run.begin - 1].tool_calls;
+      }
+      run.can_sort = RunCanSort(messages, run);
+      AppendObservationRun(out, messages, run.begin, run.end, run, nullptr);
+      i = run.end;
+      continue;
+    }
+    ++i;
+  }
+
+  if (options.add_generation_prompt) {
+    out.append(kAssistant);
+    out.append(kThink);
+  }
+  return out;
+}
+
+bool ValidateGgufTemplate(const core::GgufReader& reader,
+                          std::string* error_msg) {
+  const auto value = reader.GetMetadataString("tokenizer.chat_template");
+  if (!value.has_value()) {
+    if (error_msg != nullptr) {
+      *error_msg = "artifact carries no chat template";
+    }
+    return false;
+  }
+  const auto* begin = reinterpret_cast<const std::uint8_t*>(value->data());
+  const std::string sha = crypto::Sha256Hex({begin, value->size()});
+  if (sha != ArtifactTemplateSha256()) {
+    if (error_msg != nullptr) {
+      *error_msg = "unsupported GLM chat template revision: sha256=" + sha;
+    }
+    return false;
+  }
+  return true;
+}
+
+ChatTemplateOptions ResolveChatOptions(
+    const gufo::ReasoningOptions& reasoning) {
+  ChatTemplateOptions options;
+  switch (reasoning.effort.value_or(gufo::ReasoningEffort::kMax)) {
+    case gufo::ReasoningEffort::kMinimal:
+    case gufo::ReasoningEffort::kLow:
+      options.reasoning_effort = "low";
+      break;
+    case gufo::ReasoningEffort::kMedium:
+    case gufo::ReasoningEffort::kHigh:
+      options.reasoning_effort = "high";
+      break;
+    case gufo::ReasoningEffort::kXHigh:
+    case gufo::ReasoningEffort::kMax:
+      options.reasoning_effort = "max";
+      break;
+  }
+  // The template's default keeps prior reasoning; only an explicit discard
+  // clears it from turns before the last user message.
+  options.clear_thinking =
+      reasoning.preserve_thinking.has_value() && !*reasoning.preserve_thinking;
+  return options;
+}
+
+}  // namespace gufo::models::glm5_next
diff --git a/src/models/glm5_next/chat_template.hpp b/src/models/glm5_next/chat_template.hpp
