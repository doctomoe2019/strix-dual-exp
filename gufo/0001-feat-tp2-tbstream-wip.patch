@@ -0,0 +1,480 @@
+// Byte-exact qualification of the compiled GLM chat-template renderer
+// against the official template (goldens rendered by the pinned jinja from
+// the artifact; see the plan evidence). The full corpus lives in
+// evidence/glm53-flash/template-goldens.json; this covers every structural
+// branch: efforts, reasoning handling, tools blocks, call serialization
+// and observation runs with all sorting fallbacks.
+
+#include "src/models/glm5_next/chat_template.hpp"
+
+#include <array>
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <utility>
+
+namespace glm = gufo::models::glm5_next;
+
+namespace {
+
+void Require(bool condition, const char* message) {
+  if (!condition) {
+    std::fprintf(stderr, "FAIL: %s\n", message);
+    std::exit(1);
+  }
+}
+
+void CheckPlainGeneration() {
+  const glm::ChatMessage user{"user", "Hello!", "", {}, ""};
+  const glm::ChatTemplateOptions options{.add_generation_prompt = true};
+
+  const std::string rendered =
+      glm::RenderChat(std::span<const glm::ChatMessage>(&user, 1), {}, options);
+  const std::string expected =
+      R"~([gMASK]<sop><|system|>Reasoning Effort: Max<|user|>Hello!<|assistant|><think>)~";
+  Require(rendered == expected, "PlainGeneration golden mismatch");
+}
+
+void CheckEffortLow() {
+  const glm::ChatMessage user{"user", "1+1", "", {}, ""};
+  const glm::ChatTemplateOptions options{.reasoning_effort = "low",
+                                         .add_generation_prompt = true};
+
+  const std::string rendered =
+      glm::RenderChat(std::span<const glm::ChatMessage>(&user, 1), {}, options);
+  const std::string expected =
+      R"~([gMASK]<sop><|system|>Reasoning Effort: Low<|user|>1+1<|assistant|><think>)~";
+  Require(rendered == expected, "EffortLow golden mismatch");
+}
+
+void CheckReasoningPreserved() {
+  const glm::ChatMessage first{"user", "Solve 2+2", "", {}, ""};
+  const glm::ChatMessage second{
+      "assistant", "4", "two and two make four", {}, ""};
+  const glm::ChatMessage third{"user", "and 3+3?", "", {}, ""};
+  const std::array<glm::ChatMessage, 3> messages{first, second, third};
+  const glm::ChatTemplateOptions options{.add_generation_prompt = true};
+
+  const std::string rendered = glm::RenderChat(messages, {}, options);
+  const std::string expected =
+      R"~([gMASK]<sop><|system|>Reasoning Effort: Max<|user|>Solve 2+2<|assistant|><think>two and two make four</think>4<|user|>and 3+3?<|assistant|><think>)~";
+  Require(rendered == expected, "ReasoningPreserved golden mismatch");
+}
+
+void CheckReasoningCleared() {
+  const glm::ChatMessage first{"user", "Solve 2+2", "", {}, ""};
+  const glm::ChatMessage second{"assistant", "4", "internal thought", {}, ""};
+  const glm::ChatMessage third{"user", "and 3+3?", "", {}, ""};
+  const std::array<glm::ChatMessage, 3> messages{first, second, third};
+  const glm::ChatTemplateOptions options{.clear_thinking = true,
+                                         .add_generation_prompt = true};
+
+  const std::string rendered = glm::RenderChat(messages, {}, options);
+  const std::string expected =
+      R"~([gMASK]<sop><|system|>Reasoning Effort: Max<|user|>Solve 2+2<|assistant|><think></think>4<|user|>and 3+3?<|assistant|><think>)~";
+  Require(rendered == expected, "ReasoningCleared golden mismatch");
+}
+
+void CheckReasoningInlineContent() {
+  const glm::ChatMessage first{"user", "Hi", "", {}, ""};
+  const glm::ChatMessage second{
+      "assistant", "<think>thought</think>answer", "", {}, ""};
+  const std::array<glm::ChatMessage, 2> messages{first, second};
+  const glm::ChatTemplateOptions options{.add_generation_prompt = true};
+
+  const std::string rendered = glm::RenderChat(messages, {}, options);
+  const std::string expected =
+      R"~([gMASK]<sop><|system|>Reasoning Effort: Max<|user|>Hi<|assistant|><think>thought</think>answer<|assistant|><think>)~";
+  Require(rendered == expected, "ReasoningInlineContent golden mismatch");
+}
+
+void CheckToolsGeneration() {
+  const glm::ChatTool weather{
+      "get_weather", "Get current weather for a city",
+      R"({"type":"object","properties":{"city":{"type":"string"},"units":{"type":"string","enum":["c","f"]}},"required":["city"]})"};
+  const glm::ChatTool read_file{
+      "read_file", "Read a file",
+      R"({"type":"object","properties":{"path":{"type":"string"}},"required":["path"]})"};
+  const std::array<glm::ChatTool, 2> tools{weather, read_file};
+
+  const glm::ChatMessage user{"user", "Weather in Berlin?", "", {}, ""};
+  const glm::ChatTemplateOptions options{.add_generation_prompt = true};
+
+  const std::string rendered = glm::RenderChat(
+      std::span<const glm::ChatMessage>(&user, 1), {tools}, options);
+  const std::string expected =
+      R"~([gMASK]<sop><|system|>Reasoning Effort: Max<|system|>
+# Tools
+
+You may call one or more functions to assist with the user query.
+
+You are provided with function signatures within <tools></tools> XML tags:
+<tools>
+
+{"name": "get_weather", "description": "Get current weather for a city", "parameters": {"type":"object","properties":{"city":{"type":"string"},"units":{"type":"string","enum":["c","f"]}},"required":["city"]}}
+
+
+{"name": "read_file", "description": "Read a file", "parameters": {"type":"object","properties":{"path":{"type":"string"}},"required":["path"]}}
+
+
+</tools>
+
+For each function call, output the function name and arguments within the following XML format:
+<tool_call>{function-name}<arg_key>{arg-key-1}</arg_key><arg_value>{arg-value-1}</arg_value><arg_key>{arg-key-2}</arg_key><arg_value>{arg-value-2}</arg_value>...</tool_call><|user|>Weather in Berlin?<|assistant|><think>)~";
+  Require(rendered == expected, "ToolsGeneration golden mismatch");
+}
+
+void CheckToolCallHistory() {
+  const glm::ChatTool weather{
+      "get_weather", "Get current weather for a city",
+      R"({"type":"object","properties":{"city":{"type":"string"},"units":{"type":"string","enum":["c","f"]}},"required":["city"]})"};
+  const glm::ChatTool read_file{
+      "read_file", "Read a file",
+      R"({"type":"object","properties":{"path":{"type":"string"}},"required":["path"]})"};
