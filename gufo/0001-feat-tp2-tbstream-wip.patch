+void RestoreGroupsAdjacentFilesWithinStaging() {
+  Directory dir;
+  ResourceLedger ledger{{1 << 22, 1 << 21, 35, 4096}};
+  DiskStore disk(ledger, dir.path, 1 << 20);
+  StreamedStore streams(ledger, disk, 35, Allocate, Lease);
