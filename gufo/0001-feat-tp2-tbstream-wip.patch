+  # Prefill throughput benchmark for kernel-family attribution and A/B.
+  add_executable(glm5_next_prefill_bench EXCLUDE_FROM_ALL prefill_bench.cpp)
+  target_link_libraries(glm5_next_prefill_bench PRIVATE gufo_glm5_next)
+
+  # Host-vs-device contract for the tiled batch pool selector.
+  add_executable(glm5_next_batch_select_test EXCLUDE_FROM_ALL
+                 batch_select_test.cpp)
+  target_link_libraries(glm5_next_batch_select_test PRIVATE gufo_glm5_next)
