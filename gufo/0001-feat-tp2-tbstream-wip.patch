+// A live-range-bounded score grid must be observationally exact: the score
+// kernel writes only blocks below each row's complete count and the mark
+// kernel never reads further, so bounding the grid to (or past) the last
+// row's complete blocks may not change a single mask word or score bit.
+// A deep capacity grid with a shallow live range is the two-rank eager
+// decode shape (graph replay never runs there).
+struct LaunchResult {
+  std::vector<std::uint32_t> mask;
+  std::vector<float> scores;
+};
+
+bool CheckLiveRange(std::uint32_t n_tokens, std::uint32_t start_pos,
+                    bool zero_queries) {
+  const std::uint32_t max_blocks = 65536;  // a 256K-token capacity grid
+  const std::uint32_t mask_words = max_blocks / 32;
+  const std::size_t q_count =
+      static_cast<std::size_t>(n_tokens) * kHeads * kDim;
+  auto qv = zero_queries ? std::vector<float>(q_count, 0.0F)
+                         : MakeValues(q_count, 0x5A17C0DEU, 1.0F);
+  auto blocks =
+      MakeValues(static_cast<std::size_t>(max_blocks) * kDim, 0x1D5EA11U, 1.0F);
+  std::vector<__half> blocks_half(blocks.size());
+  const auto half = [](float value) { return __float2half_rn(value); };
+  std::transform(blocks.begin(), blocks.end(), blocks_half.begin(), half);
+  const std::uint32_t live = (start_pos + n_tokens) / kRatio;
+
+  const auto launch = [&](std::uint32_t bound) {
+    float* d_q = Upload(qv);
+    __half* d_blocks = Upload(blocks_half);
+    std::uint32_t* d_pos = Upload(std::vector<std::uint32_t>{start_pos});
+    std::uint32_t* d_mask = Upload(std::vector<std::uint32_t>(
+        static_cast<std::size_t>(n_tokens) * mask_words, 0xA5A5A5A5U));
+    float* d_scores = Upload(std::vector<float>(
+        static_cast<std::size_t>(n_tokens) * max_blocks, -1.0F));
+    q::SelectBlocks(d_q, d_blocks, d_mask, d_scores, n_tokens, d_pos, 0, kHeads,
+                    kDim, kRatio, kBudget, mask_words, max_blocks, nullptr,
+                    bound);
+    CheckHip(hipDeviceSynchronize(), "live-range selection");
+    LaunchResult result{
+        Download(d_mask, static_cast<std::size_t>(n_tokens) * mask_words),
+        Download(d_scores, static_cast<std::size_t>(n_tokens) * max_blocks)};
+    for (void* pointer : {static_cast<void*>(d_q), static_cast<void*>(d_blocks),
+                          static_cast<void*>(d_pos), static_cast<void*>(d_mask),
+                          static_cast<void*>(d_scores)}) {
+      CheckHip(hipFree(pointer), "free live-range buffers");
+    }
+    return result;
+  };
+
+  // The executor's bound is the last row's complete-block count; anything
+  // at or above it must reproduce the capacity-grid launch exactly.
+  const LaunchResult reference = launch(0);
+  bool ok = true;
+  for (const std::uint32_t bound : {live, live + 37}) {
+    const LaunchResult bounded = launch(bound);
+    if (bounded.mask != reference.mask) {
+      std::cerr << "live bound " << bound << " changed the mask\n";
+      ok = false;
+    }
+    if (bounded.scores != reference.scores) {
+      std::cerr << "live bound " << bound << " changed a score\n";
+      ok = false;
+    }
+  }
+  std::cout << "live-range bound n=" << n_tokens << " start=" << start_pos
+            << " live=" << live << " zero_queries=" << zero_queries
+            << ": mask and scores exact\n";
+  return ok;
+}
+
