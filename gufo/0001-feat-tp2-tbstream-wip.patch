+void TestReasoningTokenCounting() {
+  using gufo::server::ReasoningTokenCount;
+  using gufo::tokenization::TokenId;
+  const TokenId think{7};
+  const TokenId close{9};
+  const std::vector closed{think, think, close, think, close};
+  Expect(ReasoningTokenCount(closed, {&close, 1}) == 2,
+         "reasoning tokens end before the closing marker");
+  const std::vector open{think, close};
+  Expect(ReasoningTokenCount(open, {&close, 1}) == 1,
+         "an unclosed span counts its whole completion");
+  const std::vector marker{think, close, close};
+  const std::vector split{think, close, think, close, close, think, close};
+  Expect(ReasoningTokenCount(split, marker) == 2,
+         "a multi-piece marker ends at its first occurrence");
+  Expect(ReasoningTokenCount(split, std::span<const TokenId>{}) == 0,
+         "a request without a marker reports no reasoning span");
+  const std::vector<TokenId> none{};
+  Expect(ReasoningTokenCount(none, std::span<const TokenId>{&close, 1}) == 0,
+         "an empty completion reports no reasoning tokens");
+  Expect(ReasoningTokenCount(none, {}) == 0,
+         "an empty completion without a marker reports none");
+}
