+struct Variant {
+  const char* name;
+  KId kid;
+  std::uint32_t threads;
+  std::uint32_t grid_div;  // rows per block (Warps * Rows)
+};
+
+const std::vector<Variant>& Variants() {
+  static const std::vector<Variant> v = {
+      {"V0", KId::kV0, 1024, 64},
+      {"W32R2", KId::kW32_32_2, 1024, 64},
+      {"W64R1", KId::kW64_32_1, 1024, 32},
+      {"W64R1s", KId::kW64_32_1s, 1024, 32},
+      {"L32G16", KId::kL32_16_32_2, 1024, 64},
+      {"L64G16R1", KId::kL64_16_32_1, 1024, 32},
+      {"Z16R2", KId::kZ16_32_2, 1024, 64},
+      {"Z32R2", KId::kZ32_32_2, 1024, 64},
+      {"Z32R1", KId::kZ32_32_1, 1024, 32},
+  };
+  return v;
+}
+
+std::uint32_t TokenWidth(KId kid) {
+  switch (kid) {
+    case KId::kV0:
+    case KId::kZ16_32_2:
+      return 16;
+    case KId::kW32_32_2:
+    case KId::kW32_32_4:
+    case KId::kL32_16_32_2:
+    case KId::kZ32_32_2:
+    case KId::kZ32_32_1:
+      return 32;
+    case KId::kW64_32_1:
+    case KId::kW64_32_2:
+    case KId::kW64_16_2:
+    case KId::kW64_32_1s:
+    case KId::kL64_16_32_1:
+    case KId::kL64_16_32_2:
+    case KId::kL64_16_16_2:
+      return 64;
+    case KId::kW128_32_1:
+    case KId::kW128_16_1:
+    case KId::kW128_8_1:
+    case KId::kW128_32_1s:
+    case KId::kL128_16_32_1:
+    case KId::kL128_16_16_1:
+    case KId::kL128_8_32_1:
+      return 128;
+    case KId::kW256_32_1:
+    case KId::kL256_16_32_1:
+      return 256;
+  }
+  return 16;
+}
+
+void Launch(KId kid, std::uint32_t threads, dim3 grid, const void* w,
+            std::uint32_t type, const float* x, float* y, std::uint32_t m,
+            std::uint32_t k, std::uint32_t n, hipStream_t stream) {
+  const std::size_t y_stride = m;
+  switch (kid) {
+    case KId::kV0:
+      V0Kernel<<<grid, threads, 0, stream>>>(w, type, x, y, m, k, n, y_stride);
+      break;
+    case KId::kW32_32_2:
+      WsKernel<32, 32, 2, true><<<grid, threads, 0, stream>>>(
+          w, type, x, y, m, k, n, y_stride);
+      break;
+    case KId::kW64_32_1:
+      WsKernel<64, 32, 1, true><<<grid, threads, 0, stream>>>(
+          w, type, x, y, m, k, n, y_stride);
+      break;
+    case KId::kW64_32_2:
+      WsKernel<64, 32, 2, true><<<grid, threads, 0, stream>>>(
+          w, type, x, y, m, k, n, y_stride);
+      break;
+    case KId::kW64_16_2:
+      WsKernel<64, 16, 2, true><<<grid, threads, 0, stream>>>(
+          w, type, x, y, m, k, n, y_stride);
+      break;
+    case KId::kW128_32_1:
+      WsKernel<128, 32, 1, true><<<grid, threads, 0, stream>>>(
+          w, type, x, y, m, k, n, y_stride);
+      break;
+    case KId::kW128_16_1:
+      WsKernel<128, 16, 1, true><<<grid, threads, 0, stream>>>(
+          w, type, x, y, m, k, n, y_stride);
+      break;
+    case KId::kW128_8_1:
+      WsKernel<128, 8, 1, true><<<grid, threads, 0, stream>>>(
+          w, type, x, y, m, k, n, y_stride);
+      break;
+    case KId::kW256_32_1:
+      WsKernel<256, 32, 1, true><<<grid, threads, 0, stream>>>(
+          w, type, x, y, m, k, n, y_stride);
+      break;
+    case KId::kW32_32_4:
+      WsKernel<32, 32, 4, true><<<grid, threads, 0, stream>>>(
+          w, type, x, y, m, k, n, y_stride);
+      break;
+    case KId::kW128_32_1s:
+      WsKernel<128, 32, 1, false><<<grid, threads, 0, stream>>>(
+          w, type, x, y, m, k, n, y_stride);
+      break;
+    case KId::kW64_32_1s:
+      WsKernel<64, 32, 1, false><<<grid, threads, 0, stream>>>(
+          w, type, x, y, m, k, n, y_stride);
+      break;
+    case KId::kL32_16_32_2:
+      LsKernel<32, 16, 32, 2><<<grid, threads, 0, stream>>>(
+          w, type, x, y, m, k, n, y_stride);
+      break;
+    case KId::kL64_16_32_1:
+      LsKernel<64, 16, 32, 1><<<grid, threads, 0, stream>>>(
+          w, type, x, y, m, k, n, y_stride);
+      break;
+    case KId::kL64_16_32_2:
+      LsKernel<64, 16, 32, 2><<<grid, threads, 0, stream>>>(
+          w, type, x, y, m, k, n, y_stride);
+      break;
+    case KId::kL128_16_32_1:
+      LsKernel<128, 16, 32, 1><<<grid, threads, 0, stream>>>(
+          w, type, x, y, m, k, n, y_stride);
+      break;
+    case KId::kL128_16_16_1:
+      LsKernel<128, 16, 16, 1><<<grid, threads, 0, stream>>>(
+          w, type, x, y, m, k, n, y_stride);
+      break;
+    case KId::kL64_16_16_2:
+      LsKernel<64, 16, 16, 2><<<grid, threads, 0, stream>>>(
+          w, type, x, y, m, k, n, y_stride);
+      break;
+    case KId::kL128_8_32_1:
+      LsKernel<128, 8, 32, 1><<<grid, threads, 0, stream>>>(
+          w, type, x, y, m, k, n, y_stride);
+      break;
+    case KId::kL256_16_32_1:
+      LsKernel<256, 16, 32, 1><<<grid, threads, 0, stream>>>(
+          w, type, x, y, m, k, n, y_stride);
+      break;
+    case KId::kZ16_32_2:
+      ZsKernel<16, 32, 2><<<grid, threads, 0, stream>>>(
+          w, type, x, y, m, k, n, y_stride);
+      break;
+    case KId::kZ32_32_2:
+      ZsKernel<32, 32, 2><<<grid, threads, 0, stream>>>(
+          w, type, x, y, m, k, n, y_stride);
+      break;
+    case KId::kZ32_32_1:
