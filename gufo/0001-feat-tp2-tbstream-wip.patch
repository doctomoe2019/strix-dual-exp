+  const std::size_t hc_dim = static_cast<std::size_t>(kStreams) * hidden;
+  float w[kStreams];
+#pragma unroll
+  for (std::uint32_t s = 0; s < kStreams; ++s) {
+    float logit = 0.0f;
+    for (std::uint32_t p = 0; p < inject_parts; ++p) {
+      logit +=
+          inject[(static_cast<std::size_t>(t) * kStreams + s) * inject_parts +
+                 p];
+    }
+    w[s] = 2.0f * SigmoidF(logit / static_cast<float>(kStreams));
+  }
+  float* dst = res + static_cast<std::size_t>(t) * hc_dim;
+  const float* src_local = block_local + static_cast<std::size_t>(t) * hidden;
+  const float* src_peer = peer + static_cast<std::size_t>(t) * hidden;
+  const std::uint32_t hidden4 = hidden / 4;
+  for (std::uint32_t k = threadIdx.x; k < hidden4; k += kThreads) {
+    s_row[0][k] = *reinterpret_cast<const float4*>(src_local + k * 4);
+    s_row[1][k] = *reinterpret_cast<const float4*>(src_peer + k * 4);
+  }
+  __syncthreads();
+  const std::uint32_t chunks = static_cast<std::uint32_t>(hc_dim / 4);
+  float4 v[kMaxChunks];
+  float ss[kStreams] = {0.0F, 0.0F, 0.0F, 0.0F};
+#pragma unroll
+  for (std::uint32_t c = 0; c < kMaxChunks; ++c) {
+    const std::uint32_t e = (c * kThreads + threadIdx.x) * 4;
+    v[c] = float4{0.0F, 0.0F, 0.0F, 0.0F};
+    if (e < hc_dim) {
+      const std::uint32_t s = e / hidden;
+      const std::uint32_t i = e - (s * hidden);
+      const float ws = w[s];
+      const float4 r = *reinterpret_cast<const float4*>(dst + e);
+      const float4 l = s_row[0][(c * kThreads + threadIdx.x) % hidden4];
+      const float4 p = s_row[1][(c * kThreads + threadIdx.x) % hidden4];
+      const float4 b = float4{l.x + p.x, l.y + p.y, l.z + p.z, l.w + p.w};
+      if (block_summed != nullptr) {
+        *reinterpret_cast<float4*>(
+            block_summed + static_cast<std::size_t>(t) * hidden + i) = b;
+      }
+      v[c] = float4{r.x + b.x * ws, r.y + b.y * ws, r.z + b.z * ws,
+                    r.w + b.w * ws};
