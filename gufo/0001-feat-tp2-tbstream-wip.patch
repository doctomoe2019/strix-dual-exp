+// Eases a spin loop off the core's shared resources and the SoC power budget,
+// which the GPU draws from too.
+inline void CpuRelax() noexcept {
+#if defined(__x86_64__) || defined(__i386__)
+  __builtin_ia32_pause();
+#endif
+}
+
+/// Pins the calling thread to `cpu` (a negative index counts from the top
+/// of the process's affinity mask), so the reader and the exchange worker
+/// never migrate under load. Failures are ignored: pinning is a latency
+/// refinement, not a correctness requirement.
+void PinToCpuFromTop(int cpu_from_top) {
+  cpu_set_t allowed;
+  CPU_ZERO(&allowed);
+  if (::sched_getaffinity(0, sizeof(allowed), &allowed) != 0) {
+    return;
+  }
+  int chosen = -1;
+  for (int cpu = CPU_SETSIZE - 1; cpu >= 0 && cpu_from_top >= 0; --cpu) {
+    if (CPU_ISSET(cpu, &allowed) && cpu_from_top-- == 0) {
+      chosen = cpu;
+      break;
+    }
+  }
+  if (chosen >= 0) {
+    cpu_set_t pinned;
+    CPU_ZERO(&pinned);
+    CPU_SET(chosen, &pinned);
+    (void)::sched_setaffinity(0, sizeof(pinned), &pinned);
+  }
+}
