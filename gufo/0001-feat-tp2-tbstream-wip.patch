+    const auto complete = (start_pos + t + 1) / kRatio;
+    auto* row = mask.data() + std::size_t{t} * mask_words;
+    if (complete <= kBudget) {
+      std::fill_n(row, mask_words, 0xFFFFFFFFU);
+      continue;
+    }
