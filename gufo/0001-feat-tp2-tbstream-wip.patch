+  const auto simple = server.Send(
+      "POST /echo HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n"
+      "5\r\nhello\r\n0\r\n\r\n");
+  ExpectStatus(simple, 200);
+  assert(BodyOf(simple) == "hello");
+
+  // Multiple chunks, case-insensitive field and coding, extensions, trailers.
+  const std::string a(0x64, 'a');
+  const std::string b(0xff, 'b');
+  const auto mixed =
+      server.Send("POST /echo HTTP/1.1\r\ntRaNsFeR-eNcOdInG: CHUNKED\r\n\r\n" +
+                  std::string("64;ext=1\r\n") + a + "\r\nFF\r\n" + b +
+                  "\r\n4\r\nTail\r\n0\r\nX-Trailer: value\r\n\r\n");
+  ExpectStatus(mixed, 200);
+  assert(BodyOf(mixed) == a + b + "Tail");
+
+  const auto empty = server.Send(
+      "POST /echo HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n");
+  ExpectStatus(empty, 200);
+  assert(BodyOf(empty).empty());
+
+  // The decoded size is bounded exactly like a content-length body.
+  const std::string big(3000, 'x');
+  const auto oversized =
+      server.Send("POST /echo HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n" +
+                  Chunked({big, big, big}));
+  ExpectStatus(oversized, 413);
+
+  // Unsupported codings stay distinguishable from malformed framing.
+  ExpectStatus(server.Send("POST /echo HTTP/1.1\r\nTransfer-Encoding: "
+                           "gzip, chunked\r\n\r\n0\r\n\r\n"),
+               501);
+  ExpectStatus(server.Send("POST /echo HTTP/1.1\r\nTransfer-Encoding: "
+                           "chunked, gzip\r\n\r\n0\r\n\r\n"),
+               400);
+  ExpectStatus(server.Send("POST /echo HTTP/1.1\r\nTransfer-Encoding: "
+                           "chunked;q=1\r\n\r\n0\r\n\r\n"),
+               400);
+  ExpectStatus(server.Send("POST /echo HTTP/1.1\r\nTransfer-Encoding: "
+                           "chunked, chunked\r\n\r\n0\r\n\r\n"),
+               400);
+  ExpectStatus(server.Send("POST /echo HTTP/1.0\r\nTransfer-Encoding: "
+                           "chunked\r\n\r\n0\r\n\r\n"),
+               400);
+
+  for (const std::string& body :
+       {std::string("x\r\nhello\r\n"),            // non-hex chunk size
+        std::string("5 \r\nhello\r\n"),           // junk inside the size line
+        std::string("5\r\nhelloAB"),              // missing chunk-data CRLF
+        std::string("FFFFFFFFFFFFFFFFF\r\n"),     // overflowing numeral
+        std::string("5;x\r\nhello\r\n3\r\n")}) {  // truncated mid-stream
+    ExpectStatus(server.Send("POST /echo HTTP/1.1\r\nTransfer-Encoding: "
+                             "chunked\r\n\r\n" +
+                                 body,
+                             true),
+                 400);
+  }
+  // A trailer section past its bound is malformed, not a hang.
+  std::string flood = "0\r\n";
+  for (int i = 0; i < 600; ++i) {
+    flood += "X-Trailer: 0123456789012345\r\n";
+  }
+  ExpectStatus(server.Send("POST /echo HTTP/1.1\r\nTransfer-Encoding: "
+                           "chunked\r\n\r\n" +
+                           flood),
+               400);
+}
