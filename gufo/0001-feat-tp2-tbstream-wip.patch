+      for (std::uint32_t r = 0; r < kExperts; ++r) {
+        weight[perm[r]] = 1.0 / std::pow(1.0 + r, rt.zipf);
+        sum += weight[perm[r]];
+      }
+      for (auto& wv : weight) {
+        wv /= sum;
+      }
