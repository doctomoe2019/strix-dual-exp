+#ifndef GUFO_MODELS_GLM5_NEXT_KERNELS_ROCM_DEVICE_MODEL_HPP_
+#define GUFO_MODELS_GLM5_NEXT_KERNELS_ROCM_DEVICE_MODEL_HPP_
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "src/core/gguf_reader.hpp"
+#include "src/models/glm5_next/distributed/tp_partition.hpp"
+#include "src/models/glm5_next/weights.hpp"
+
+namespace gufo::models::glm5_next::rocm {
+
+/// One weight resident in device memory, still in its GGUF encoding.
+struct DeviceTensor {
+  void* data{nullptr};
+  core::GgmlType type{core::GgmlType::kF32};
+  std::uint32_t cols{0};
+  std::uint32_t rows{0};
+  std::uint32_t experts{1};
+
+  [[nodiscard]] bool empty() const noexcept { return data == nullptr; }
+  [[nodiscard]] const float* f32() const noexcept {
+    return static_cast<const float*>(data);
+  }
+};
+
+struct DeviceHc {
+  DeviceTensor fn;
+  DeviceTensor base;
+  DeviceTensor scale;
+};
+
+/// KDA tensors of one layer.
+struct DeviceKda {
+  DeviceTensor q, k, v, out;
+  DeviceTensor conv_q, conv_k, conv_v;
+  DeviceTensor f_a, f_b, g_a, g_b;
+  DeviceTensor beta, a, dt_bias, o_norm;
+};
+
+/// Nope-only MLA tensors of one DSA layer.
+struct DeviceDsa {
+  DeviceTensor q_a, q_a_norm, q_b;
+  DeviceTensor kv_a, kv_a_norm;
+  DeviceTensor k_b;  // [qk_nope, kv_lora] x heads, F32
+  DeviceTensor v_b;  // [kv_lora, v_head] x heads, F32
+  DeviceTensor out;
+};
+
+/// Indexer tensors of one DSA layer (replicated under TP).
+struct DeviceIndexer {
+  DeviceTensor q_b, k, k_norm, k_norm_bias, proj;
+  DeviceTensor comp_gate, comp_ape;
+};
+
+struct DeviceLayer {
+  bool linear{false};
+  bool dense_ffn{false};
+  DeviceTensor attn_norm, ffn_norm;
+  DeviceHc hc_attn, hc_ffn;
+  DeviceKda kda;
+  DeviceDsa dsa;
+  DeviceIndexer indexer;
+  DeviceTensor ffn_gate, ffn_up, ffn_down;  // dense layers
+  DeviceTensor router, router_bias;
+  DeviceTensor gate_exps, up_exps, down_exps;
+  DeviceTensor gate_shexp, up_shexp, down_shexp;
+};
+
+/// The trunk slice: the first `layer_count` trunk layers plus the embedding
+/// table, output norm and vocabulary head, resident on one device in the
+/// artifact's own encodings (F32/Q8_0/Q4_K). With a partition (P3) every
+/// split tensor holds only this rank's share, in the artifact's encoding,
+/// with the local geometry in `cols`/`rows`/`experts`; without one the
+/// whole tensors upload exactly as in P2.
+class DeviceSlice {
+public:
+  ~DeviceSlice();
+  DeviceSlice(const DeviceSlice&) = delete;
+  DeviceSlice& operator=(const DeviceSlice&) = delete;
+
+  /// Streams the slice from the same open files used to bind its
+  /// metadata. `layer_count` = 0 uploads only the embedding and head.
+  /// `partition` = null uploads whole tensors (world size 1).
+  [[nodiscard]] static std::unique_ptr<DeviceSlice> Upload(
+      const ModelWeights& weights, const core::GgufReader& reader,
+      std::uint32_t layer_count,
+      const distributed::TpPartition* partition = nullptr,
+      std::string* error_msg = nullptr);
+
+  [[nodiscard]] std::uint32_t layer_count() const noexcept {
+    return layer_count_;
+  }
+  /// The rank geometry the weights were uploaded for (world size 1 when
+  /// no partition was given).
+  [[nodiscard]] const distributed::TpPartition& partition() const noexcept {
+    return partition_;
+  }
+  const DeviceTensor& token_embd() const noexcept { return token_embd_; }
+  const DeviceTensor& output() const noexcept { return output_; }
+  const DeviceTensor& output_norm() const noexcept { return output_norm_; }
+  const std::vector<DeviceLayer>& layers() const noexcept { return layers_; }
+  const Config& config() const noexcept { return config_; }
+  /// Device bytes held by weights (excluding tail margins).
+  [[nodiscard]] std::size_t resident_bytes() const noexcept {
+    return weight_bytes_;
+  }
+  /// Encoded tensor bytes the slice covers (the ledger cross-check).
+  [[nodiscard]] std::size_t encoded_bytes() const noexcept {
+    return encoded_bytes_;
+  }
+  [[nodiscard]] std::size_t tensor_count() const noexcept {
+    return tensor_count_;
+  }
+
+private:
+  DeviceSlice() = default;
+
+  Config config_{};
+  distributed::TpPartition partition_{};
+  DeviceTensor token_embd_;
+  DeviceTensor output_;
+  DeviceTensor output_norm_;
+  std::vector<DeviceLayer> layers_;
+  std::vector<void*> allocations_;
+  std::size_t weight_bytes_{0};
+  std::size_t encoded_bytes_{0};
+  std::size_t tensor_count_{0};
+  std::uint32_t layer_count_{0};
+};
+
