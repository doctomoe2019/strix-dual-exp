+/// q8-on-the-wire staging: one warp owns each 32-element block, computes the
+/// block's fp16 scale from its max magnitude, and writes int8 quotients at
+/// `data` (the payload's scales array precedes it, 16-byte aligned).
+__global__ void StagePartialQ8Kernel(const float* __restrict__ partial,
+                                     __half* __restrict__ scales,
+                                     std::int8_t* __restrict__ data,
+                                     std::size_t count, std::size_t blocks,
+                                     std::uint32_t* arrivals,
+                                     std::uint64_t* ready,
+                                     std::uint64_t value) {
+  const unsigned warps_per_block = blockDim.x >> 5;
+  const unsigned lane = threadIdx.x & 31u;
+  const unsigned warp = threadIdx.x >> 5;
+  const std::size_t warps_total =
+      static_cast<std::size_t>(gridDim.x) * warps_per_block;
+  const std::size_t first_warp =
+      static_cast<std::size_t>(blockIdx.x) * warps_per_block + warp;
+  for (std::size_t b = first_warp; b < blocks; b += warps_total) {
+    const std::size_t base = b * 32;
+    const bool active = base + lane < count;
+    const float v = active ? partial[base + lane] : 0.0f;
+    const float magnitude = __builtin_fabsf(v);
+    float max = magnitude;
+    for (unsigned off = 16; off > 0; off >>= 1) {
+      max = fmaxf(max, __shfl_xor(max, off));
+    }
+    const __half scale = __float2half_rn(max == 0.0f ? 1.0f : max / 127.0f);
+    if (active) {
+      const float q = rintf(v / __half2float(scale));
+      data[base + lane] = static_cast<std::int8_t>(
+          q > 127.0f ? 127.0f : (q < -127.0f ? -127.0f : q));
+    }
+    if (lane == 0) {
+      scales[b] = scale;
+    }
+  }
+  StagePublish(arrivals, ready, value);
+}
