+/// HcCombinePeerVec4Kernel<__half> that also emits the NEXT mixer's inject
+/// partials from the F16 norm row it writes (see HcCombineVec4InjectF16Kernel
+/// for the bit-exact replay contract). The staged norm aliases the local/peer
+/// block-row LDS, which the chunk loop has fully consumed by the time the
+/// norm phase runs; `inject_out` may alias `inject`.
+__global__ void HcCombinePeerVec4InjectF16Kernel(
+    float* res, const float* block_local, const float* peer,
+    float* block_summed, const float* inject, std::uint32_t inject_parts,
+    float* inject_out, const float* inject_w, const float* gamma, __half* xn,
+    void* xn_q8, std::uint32_t hidden, float eps) {
+  constexpr std::uint32_t kStreams = 4;
+  constexpr std::uint32_t kMaxChunks = 10;  // 4 x 2560 / 4 / kThreads
+  // The local and peer block rows staged once: every stream's chunk walk
+  // re-reads the same hidden element four times, and the rows of a launch
+  // far exceed the caches, so the repeated reads go to DRAM. Staged copies
+  // carry the same bytes, so every result stays bit for bit.
+  constexpr std::uint32_t kMaxRow4 = 640;  // 2560 / 4
+  __shared__ float4 s_row[2][kMaxRow4];
+  __shared__ float shared[kStreams][kThreads / 32];
+  const std::uint32_t t = blockIdx.x;
+  const std::size_t hc_dim = static_cast<std::size_t>(kStreams) * hidden;
+  float w[kStreams];
+#pragma unroll
+  for (std::uint32_t s = 0; s < kStreams; ++s) {
+    float logit = 0.0f;
+    for (std::uint32_t p = 0; p < inject_parts; ++p) {
+      logit +=
+          inject[(static_cast<std::size_t>(t) * kStreams + s) * inject_parts +
+                 p];
+    }
+    w[s] = 2.0f * SigmoidF(logit / static_cast<float>(kStreams));
+  }
+  float* dst = res + static_cast<std::size_t>(t) * hc_dim;
+  const float* src_local = block_local + static_cast<std::size_t>(t) * hidden;
+  const float* src_peer = peer + static_cast<std::size_t>(t) * hidden;
+  const std::uint32_t hidden4 = hidden / 4;
+  for (std::uint32_t k = threadIdx.x; k < hidden4; k += kThreads) {
+    s_row[0][k] = *reinterpret_cast<const float4*>(src_local + k * 4);
+    s_row[1][k] = *reinterpret_cast<const float4*>(src_peer + k * 4);
+  }
+  __syncthreads();
+  const std::uint32_t chunks = static_cast<std::uint32_t>(hc_dim / 4);
+  float4 v[kMaxChunks];
+  float ss[kStreams] = {0.0F, 0.0F, 0.0F, 0.0F};
+#pragma unroll
+  for (std::uint32_t c = 0; c < kMaxChunks; ++c) {
+    const std::uint32_t e = (c * kThreads + threadIdx.x) * 4;
+    v[c] = float4{0.0F, 0.0F, 0.0F, 0.0F};
+    if (e < hc_dim) {
+      const std::uint32_t s = e / hidden;
+      const std::uint32_t i = e - (s * hidden);
+      const float ws = w[s];
+      const float4 r = *reinterpret_cast<const float4*>(dst + e);
+      const float4 l = s_row[0][(c * kThreads + threadIdx.x) % hidden4];
+      const float4 p = s_row[1][(c * kThreads + threadIdx.x) % hidden4];
+      const float4 b = float4{l.x + p.x, l.y + p.y, l.z + p.z, l.w + p.w};
+      if (block_summed != nullptr) {
+        *reinterpret_cast<float4*>(
+            block_summed + static_cast<std::size_t>(t) * hidden + i) = b;
+      }
+      v[c] = float4{r.x + b.x * ws, r.y + b.y * ws, r.z + b.z * ws,
+                    r.w + b.w * ws};
+      *reinterpret_cast<float4*>(dst + e) = v[c];
+      const float sq =
+          v[c].x * v[c].x + v[c].y * v[c].y + v[c].z * v[c].z + v[c].w * v[c].w;
+#pragma unroll
+      for (std::uint32_t k = 0; k < kStreams; ++k) {
+        ss[k] += (k == s) ? sq : 0.0F;
+      }
+    }
+  }
