+void CheckMalformedMetadata() {
+  const auto expect_error = [](const char* what, Metadata fields) {
+    std::string error;
+    const auto reader_fields = std::move(fields);
+    (void)reader_fields;
+    // Parse() reports the error through its assert on consistency; run a
+    // direct variant that keeps the message.
+    std::vector<std::uint8_t> bytes;
+    // Reuse Parse by expectation: a rejected config yields nullopt, which
+    // Parse only returns on failure, so require that.
+    const auto result = Parse(std::move(fields));
+    Require(!result.has_value(), what);
+    (void)error;
+  };
+
+  {
+    Metadata fields = ValidMetadata();
+    fields["general.architecture"] = std::string{"qwen4exp"};
+    expect_error("wrong architecture accepted", std::move(fields));
+  }
+  {
+    Metadata fields = ValidMetadata();
+    fields["glm5-next.hyper_connection.count"] = std::uint32_t{5};
+    expect_error("non-4 mHC accepted", std::move(fields));
+  }
+  {
+    Metadata fields = ValidMetadata();
+    fields["glm5-next.rope.dimension_count"] = std::uint32_t{64};
+    expect_error("rotary MLA accepted", std::move(fields));
+  }
+  {
+    Metadata fields = ValidMetadata();
+    auto kv = std::get<std::vector<std::uint64_t>>(
+        fields["glm5-next.attention.head_count_kv"]);
+    kv.resize(45);
+    fields["glm5-next.attention.head_count_kv"] = kv;
+    expect_error("short kv array accepted", std::move(fields));
+  }
+  {
+    Metadata fields = ValidMetadata();
+    fields["glm5-next.attention.indexer.kpool"] = std::uint32_t{5};
+    expect_error("kpool that does not divide top_k accepted",
+                 std::move(fields));
+  }
+  {
+    Metadata fields = ValidMetadata();
+    fields["glm5-next.attention.indexer.types"] =
+        std::vector<std::uint64_t>(45, 0);
+    expect_error("shared indexer layers accepted", std::move(fields));
+  }
+  {
+    Metadata fields = ValidMetadata();
+    fields["glm5-next.expert_gating_func"] = std::uint32_t{0};
+    expect_error("softmax gating accepted", std::move(fields));
+  }
+  {
+    Metadata fields = ValidMetadata();
+    fields["glm5-next.swiglu_clamp_exp"] = std::vector<double>{10.0, 9.0};
+    expect_error("non-uniform clamp accepted", std::move(fields));
+  }
+  {
+    Metadata fields = ValidMetadata();
+    fields.erase("glm5-next.attention.head_count");
+    expect_error("missing head count accepted", std::move(fields));
+  }
+  {
+    Metadata fields = ValidMetadata();
+    fields["glm5-next.attention.key_length"] = std::uint32_t{768};
+    expect_error("mismatched latent widths accepted", std::move(fields));
+  }
+}
+
+void CheckScalarPerBlockFallback() {
+  Metadata fields = ValidMetadata();
+  fields["glm5-next.swiglu_clamp_exp"] = 9.5;  // scalar key, not an array
+  fields.erase("glm5-next.swiglu_clamp_shexp");
+  const auto config = Parse(fields);
+  Require(config.has_value(), "scalar clamp rejected");
+  Require(config->swiglu_limit == 9.5F, "scalar clamp value");
+}
+
+}  // namespace
+
+int main() {
+  try {
+    CheckValidMetadata();
+    CheckMalformedMetadata();
+    CheckScalarPerBlockFallback();
+  } catch (const std::exception& exception) {
+    std::fprintf(stderr, "FAIL: %s\n", exception.what());
+    return 1;
+  }
+  std::puts("PASS: glm5_next config contract");
+  return 0;
+}
