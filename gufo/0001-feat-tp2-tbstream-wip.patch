+      double acc = 0.0;
+      for (std::uint32_t e = 0; e < kExperts; ++e) {
+        acc += weight[e];
+        cdf[e] = acc;
+      }
+      const double total = acc;
+      for (auto& c : cdf) {
+        c /= total;
+      }
