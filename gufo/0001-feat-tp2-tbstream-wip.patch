+std::unique_ptr<Executor> Executor::Create(std::unique_ptr<DeviceSlice> slice,
+                                           Options options,
+                                           std::string* error_msg) {
+  if (slice == nullptr) {
+    SetError(error_msg, "executor needs a resident slice");
+    return nullptr;
+  }
+  auto executor = std::unique_ptr<Executor>(new Executor());
+  executor->slice_ = std::move(slice);
+  executor->options_ = std::move(options);
+  if (!Check(hipStreamCreateWithFlags(&executor->stream_, hipStreamNonBlocking),
+             "stream create", error_msg)) {
+    return nullptr;
+  }
+  const Config& c = executor->slice_->config();
+  const distributed::TpPartition& p = executor->slice_->partition();
+  const std::uint32_t heads = p.head_count;
+  const std::uint32_t inner = heads * c.kda_head_dim;
+  const std::uint32_t query = heads * c.qk_nope_head_dim;
+  if (c.expert_count > kRouterExpertLimit) {
+    SetError(error_msg, "expert count exceeds the router selection kernel");
+    return nullptr;
+  }
+  for (const DeviceLayer& layer : executor->slice_->layers()) {
+    if (layer.gate_exps.rows == 0) {
+      continue;  // dense FFN (no routed experts)
+    }
+    // The batch scratch budgets expert intermediate rows from the
+    // partition; the resident slice must agree. KDA attention layers
+    // carry MoE FFNs too, so this checks every routed layer.
+    if (layer.gate_exps.rows != p.expert_ff_count ||
+        layer.up_exps.rows != p.expert_ff_count) {
+      SetError(error_msg,
+               "expert intermediate width deviates from the partition");
+      return nullptr;
+    }
+  }
+  const std::size_t max_ffn = std::max<std::size_t>(
+      {p.dense_ff_count, p.shared_ff_count, p.expert_ff_count});
+
+  Scratch& s = executor->s_;
+  bool ok = true;
+  const auto alloc = [&](std::size_t floats, float** slot) {
+    if (!ok) {
+      return;
+    }
+    void* ptr = nullptr;
+    if (hipMalloc(&ptr, floats * sizeof(float)) != hipSuccess) {
+      ok = false;
+      return;
+    }
+    executor->allocations_.push_back(ptr);
+    executor->allocation_bytes_.push_back(floats * sizeof(float));
+    *slot = static_cast<float*>(ptr);
+  };
+  const std::uint32_t n = c.hc_count;
+  const std::uint32_t hidden = c.hidden_size;
+  const std::size_t max_sel = c.indexer_top_k + c.indexer_kpool;
+  alloc(static_cast<std::size_t>(n) * hidden, &s.streams);
+  alloc(static_cast<std::size_t>(n) * hidden, &s.residual);
+  alloc(static_cast<std::size_t>(n) * hidden, &s.flat);
+  alloc(c.HcMixDim(), &s.mixes);
+  alloc(n, &s.hc_pre);
+  alloc(n, &s.hc_post);
+  alloc(static_cast<std::size_t>(n) * n, &s.hc_comb);
+  alloc(hidden, &s.collapsed);
+  alloc(hidden, &s.block_x);
+  alloc(hidden, &s.block_out);
+  alloc(hidden, &s.normed);
+  alloc(c.vocab_size, &s.logits);
+  alloc(3 * static_cast<std::size_t>(inner), &s.qkv);
+  alloc(3 * static_cast<std::size_t>(inner), &s.conv_out);
+  alloc(inner, &s.raw);
+  alloc(c.kda_head_dim, &s.f_a_out);
+  alloc(c.kda_head_dim, &s.g_a_out);
+  alloc(heads, &s.beta_row);
+  alloc(inner, &s.gate);
+  alloc(heads, &s.beta);
+  alloc(inner, &s.qn);
+  alloc(inner, &s.kn);
+  alloc(inner, &s.core);
+  alloc(inner, &s.core_normed);
+  alloc(inner, &s.gated);
+  alloc(c.kv_lora_rank, &s.latent_raw);
+  alloc(c.kv_lora_rank, &s.latent_normed);
+  alloc(c.q_lora_rank, &s.q_resid_raw);
+  alloc(c.q_lora_rank, &s.q_resid);
+  alloc(c.indexer_head_dim, &s.idx_k_raw);
+  alloc(c.indexer_head_dim, &s.idx_g_raw);
+  alloc(c.IndexerQueryDim(), &s.iq);
+  alloc(c.indexer_heads, &s.head_weights);
+  alloc(c.indexer_heads, &s.head_weights_raw);
+  alloc(query, &s.q_full);
+  alloc(static_cast<std::size_t>(heads) * c.kv_lora_rank, &s.q_abs);
+  alloc(query, &s.attn_out_buf);
+  alloc(static_cast<std::size_t>(heads) * max_sel, &s.attn_probs);
+  alloc(static_cast<std::size_t>(heads) * c.kv_lora_rank, &s.attn_weighted);
+  alloc(max_ffn, &s.ffn_gate_out);
+  alloc(max_ffn, &s.ffn_up_out);
+  alloc(max_ffn, &s.ffn_act);
+  alloc(hidden, &s.ffn_partial);
+  // Batched (prefill) scratch, fixed at kMaxBatch tokens.
+  BatchScratch& b = executor->b_;
+  const std::size_t max_batch = kMaxBatch;
+  const std::size_t sel_stride = c.indexer_top_k + c.indexer_kpool;
+  // Indexed pool rows the batched selector can rank in tiles: covers the
+  // full 256K ladder (262144/4 + 1), one float per (token, pool).
+  const std::size_t max_pools = 1024 * 64;
+  executor->max_pools_batch_ = max_pools;
+  const auto alloc_b = [&](std::size_t floats, float** slot) {
+    if (!ok) {
+      return;
+    }
+    void* ptr = nullptr;
+    if (hipMalloc(&ptr, floats * sizeof(float)) != hipSuccess) {
+      ok = false;
+      return;
+    }
+    executor->allocations_.push_back(ptr);
+    executor->allocation_bytes_.push_back(floats * sizeof(float));
+    *slot = static_cast<float*>(ptr);
+  };
+  {
+    void* raw = nullptr;
+    ok = ok && hipMalloc(&raw, max_batch * sizeof(std::int32_t)) == hipSuccess;
+    if (ok) {
+      executor->allocations_.push_back(raw);
+      executor->allocation_bytes_.push_back(max_batch * sizeof(std::int32_t));
+      b.tokens = static_cast<std::int32_t*>(raw);
+    }
+  }
+  alloc_b(max_batch * static_cast<std::size_t>(n) * hidden, &b.streams);
+  alloc_b(max_batch * static_cast<std::size_t>(n) * hidden, &b.residual);
+  alloc_b(max_batch * static_cast<std::size_t>(n) * hidden, &b.flat);
+  alloc_b(max_batch * c.HcMixDim(), &b.mixes);
+  alloc_b(max_batch * n, &b.hc_pre);
+  alloc_b(max_batch * n, &b.hc_post);
+  alloc_b(max_batch * static_cast<std::size_t>(n) * n, &b.hc_comb);
+  alloc_b(max_batch * hidden, &b.collapsed);
+  alloc_b(max_batch * hidden, &b.block_x);
+  alloc_b(max_batch * hidden, &b.block_out);
+  alloc_b(max_batch * hidden, &b.normed);
+  alloc_b(max_batch * 3 * static_cast<std::size_t>(inner), &b.qkv);
+  alloc_b(max_batch * 3 * static_cast<std::size_t>(inner), &b.conv_out);
+  alloc_b(max_batch * inner, &b.raw);
+  alloc_b(max_batch * c.kda_head_dim, &b.f_a_out);
+  alloc_b(max_batch * c.kda_head_dim, &b.g_a_out);
+  alloc_b(max_batch * heads, &b.beta_row);
+  alloc_b(max_batch * inner, &b.gate);
+  alloc_b(max_batch * heads, &b.beta);
+  alloc_b(max_batch * inner, &b.qn);
+  alloc_b(max_batch * inner, &b.kn);
+  alloc_b(max_batch * inner, &b.core);
+  alloc_b(max_batch * inner, &b.core_normed);
+  alloc_b(max_batch * inner, &b.gated);
+  alloc_b(max_batch * c.kv_lora_rank, &b.latent_raw);
+  alloc_b(max_batch * c.kv_lora_rank, &b.latent_normed);
+  alloc_b(max_batch * c.q_lora_rank, &b.q_resid_raw);
+  alloc_b(max_batch * c.q_lora_rank, &b.q_resid);
+  alloc_b(max_batch * c.indexer_head_dim, &b.idx_k_raw);
+  alloc_b(max_batch * c.indexer_head_dim, &b.idx_g_raw);
+  alloc_b((3 + max_batch) * c.indexer_head_dim, &b.rows_keys);
+  alloc_b((3 + max_batch) * c.indexer_head_dim, &b.rows_gates);
+  alloc_b(max_batch * c.IndexerQueryDim(), &b.iq);
+  alloc_b(max_batch * c.indexer_heads, &b.head_weights);
+  alloc_b(max_batch * c.indexer_heads, &b.head_weights_raw);
+  alloc_b(max_batch * query, &b.q_full);
+  alloc_b(max_batch * static_cast<std::size_t>(heads) * c.kv_lora_rank,
+          &b.q_abs);
+  alloc_b(max_batch * query, &b.attn_out);
+  alloc_b(max_batch * static_cast<std::size_t>(heads) * sel_stride,
+          &b.attn_probs);
+  alloc_b(max_batch * static_cast<std::size_t>(heads) * c.kv_lora_rank,
+          &b.attn_weighted);
+  alloc_b(max_batch * max_pools, &b.scores);
+  alloc_b(max_batch * max_ffn, &b.gate_out);
+  alloc_b(max_batch * max_ffn, &b.up_out);
+  alloc_b(max_batch * max_ffn, &b.act);
+  alloc_b(max_batch * c.experts_used * p.expert_ff_count, &b.expert_gate);
+  alloc_b(max_batch * c.experts_used * p.expert_ff_count, &b.expert_up);
+  alloc_b(max_batch * c.experts_used * p.expert_ff_count, &b.expert_act);
+  alloc_b(max_batch * c.experts_used * hidden, &b.expert_down);
+  alloc_b(max_batch * c.expert_count, &b.router);
+  alloc_b(max_batch * c.experts_used, &b.expert_w);
+  if (ok) {
+    void* raw = nullptr;
+    if (hipMalloc(&raw, max_batch * sel_stride * sizeof(std::int32_t)) ==
+        hipSuccess) {
+      executor->allocations_.push_back(raw);
+      executor->allocation_bytes_.push_back(max_batch * sel_stride *
+                                            sizeof(std::int32_t));
+      b.sel = static_cast<std::int32_t*>(raw);
+    } else {
+      ok = false;
+    }
+  }
+  if (ok) {
+    void* raw = nullptr;
+    if (hipMalloc(&raw, max_batch * sizeof(std::uint32_t)) == hipSuccess) {
+      executor->allocations_.push_back(raw);
+      executor->allocation_bytes_.push_back(max_batch * sizeof(std::uint32_t));
+      b.counts = static_cast<std::uint32_t*>(raw);
+    } else {
+      ok = false;
+    }
+  }
+  if (ok) {
+    void* raw = nullptr;
+    if (hipMalloc(&raw, max_batch * c.experts_used * sizeof(std::int32_t)) ==
+        hipSuccess) {
+      executor->allocations_.push_back(raw);
+      executor->allocation_bytes_.push_back(max_batch * c.experts_used *
+                                            sizeof(std::int32_t));
+      b.ids = static_cast<std::int32_t*>(raw);
+    } else {
+      ok = false;
+    }
+  }
+  {
+    void* raw = nullptr;
+    const std::size_t bin_words = 2 * c.expert_count + 2;
+    if (ok &&
+        hipMalloc(&raw, bin_words * sizeof(std::uint32_t)) == hipSuccess) {
+      executor->allocations_.push_back(raw);
+      executor->allocation_bytes_.push_back(bin_words * sizeof(std::uint32_t));
+      b.expert_bins = static_cast<std::uint32_t*>(raw);
+    } else {
+      ok = false;
+    }
+  }
+  {
+    void* raw = nullptr;
+    const std::size_t words = max_batch * c.experts_used;
+    if (ok &&
+        hipMalloc(&raw, 2 * words * sizeof(std::uint32_t)) == hipSuccess) {
+      executor->allocations_.push_back(raw);
+      executor->allocation_bytes_.push_back(2 * words * sizeof(std::uint32_t));
+      b.expert_ranks = static_cast<std::uint32_t*>(raw);
+      b.expert_pairs = b.expert_ranks + words;
+    } else {
+      ok = false;
+    }
+  }
+  if (!ok) {
+    SetError(error_msg, "executor batch scratch allocation failed");
+    return nullptr;
+  }
+  return executor;
+}
