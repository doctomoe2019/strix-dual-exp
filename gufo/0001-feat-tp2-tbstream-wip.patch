new file mode 100644
index 00000000..d8450ea6
--- /dev/null
+++ b/tests/functional/glm53_pair.py
@@ -0,0 +1,126 @@
+# GLM-5.3-Flash TP2 pair harness (goal 2026-10-10-glm-prefill-250 phase 6).
+# Copied from /root/strix-dual-exp/evidence/glm53-flash/p5/pair.py and
+# parameterized: the packaged nix candidate, the pair re-sweep chunk width
+# (4096, the weights-stationary winner) and a worktree-local evidence root.
+# Logs and process identities stay under the root; the original evidence
+# file is left untouched.
+import os
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import shlex
+import signal
+import subprocess
+import time
+import urllib.request
+
+# Packaged tp2-tbstream candidate built from the phase-6 tree at b0b439a
+# (kMaxBatch 4096 + 128 MiB windows; the phase-5 tree plus harness/docs).
+# Must be shipped to the peer before use; both ranks launch this exact path
+# (see tests/functional/README.md).
+DEFAULT_BINARY = ('/nix/store/6bw5lz985j49vs912da5lpqilz318jj5-'
+                  'gufo-0-unstable-de3a1f8/bin/gufo')
+PEER = os.environ.get('GUFO_PEER', 'peer-host')
+MODEL_A = '/root/models/glm53-flash/GLM-5.3-Flash-Q4_K_XL-00001-of-00005.gguf'
+MODEL_B = '/models/glm53-flash/GLM-5.3-Flash-Q4_K_XL-00001-of-00005.gguf'
+PORT = 15015
+
+
+def ssh(args, check=True):
+    return subprocess.run(['ssh', '-o', 'ConnectTimeout=5', PEER] + args,
+                          capture_output=True, text=True, check=check)
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('action', choices=('start', 'status', 'stop'))
+    parser.add_argument('--context', type=int, default=32768)
+    parser.add_argument('--chunk', type=int, default=4096,
+                        help='served prefill chunk width (pair re-sweep winner)')
+    parser.add_argument('--label', required=True)
+    parser.add_argument('--root', type=Path, default=Path('/tmp/opencode/p6'))
+    parser.add_argument('--binary', default=DEFAULT_BINARY)
+    args = parser.parse_args()
+    root = args.root
+    root.mkdir(parents=True, exist_ok=True)
+    state_path = root / f'pair{args.label}.json'
+    if args.action == 'status':
+        state = json.loads(state_path.read_text())
+        subprocess.run(['ps', '-p', str(state['rank0']), '-o', 'pid,stat,rss,etime,args'])
+        ssh([f"ps -p {state['rank1']} -o pid,stat,rss,etime,args"], check=False)
+        try:
+            with urllib.request.urlopen(f'http://127.0.0.1:{PORT}/ready', timeout=2) as response:
+                print('ready', response.status, response.read().decode())
+        except Exception as error:
+            print('not ready:', error)
+        return
+    if args.action == 'start':
+        common = [args.binary, 'serve', 'llm', '--served-model-name', 'glm-5.3-flash',
+                  '--sessions', '1', '--speculative', 'off', '--think', 'on',
+                  '--reasoning-effort', 'low', '--prefill-chunk', str(args.chunk),
+                  '--context', str(args.context),
+                  '--tp-world-size', '2', '--tp-transport', 'tbstream',
+                  '--tp-bootstrap-port', '28515', '--tp-control-port', '28516',
+                  '--tp-control-token', 'glm-p6-local-fixture', '--host', '127.0.0.1',
+                  '--port', str(PORT), '--log-progress', '--log-level=info']
+        local = common + ['--model', MODEL_A, '--tp-rank', '0']
+        remote = common + ['--model', MODEL_B, '--tp-rank', '1',
+                           '--tp-bootstrap-host', os.environ.get('GUFO_BOOTSTRAP_HOST', 'peer-tbnet')]
+        log = root / f'serve{args.label}-r0.log'
+        remote_log = f'/root/glm-p6{args.label}-r1.log'
+        with log.open('wb') as output:
+            process = subprocess.Popen(local, stdin=subprocess.DEVNULL, stdout=output,
+                                       stderr=subprocess.STDOUT, start_new_session=True,
+                                       env={**os.environ, 'GUFO_TBSTREAM_WIRE': 'f32'})
+        code = ('import os,subprocess; '
+                f"output=open({remote_log!r},'wb'); "
+                f'p=subprocess.Popen({remote!r},stdin=subprocess.DEVNULL,stdout=output,'
+                "stderr=subprocess.STDOUT,start_new_session=True,env={**os.environ,'GUFO_TBSTREAM_WIRE':'f32'}); "
+                'print(p.pid)')
+        time.sleep(1)
+        pid1 = int(ssh(['python3 -c ' + shlex.quote(code)]).stdout)
+        # 'chunk' is the REQUESTED width. The serving binary clamps it to
+        # its own Executor::kMaxBatch without warning, so the binary hash is
+        # recorded alongside: the served width is verified exactly by
+        # glm53_serving_prefill.py (max_prefill_chunk_tokens ==
+        # min(fresh, chunk)).
+        digest = hashlib.sha256()
+        with open(args.binary, 'rb') as binary:
+            for block in iter(lambda: binary.read(1 << 20), b''):
+                digest.update(block)
+        state = {'rank0': process.pid, 'rank1': pid1, 'context': args.context,
+                 'chunk': args.chunk, 'binary': args.binary,
+                 'binary_sha256': digest.hexdigest(),
+                 'rank0_command': local, 'rank1_command': remote,
+                 'remote_log': remote_log}
+        state_path.write_text(json.dumps(state, indent=2))
+        print(json.dumps({k: state[k] for k in
+                          ('rank0', 'rank1', 'context', 'chunk',
+                           'binary_sha256')}))
+        return
+    state = json.loads(state_path.read_text())
+    # Stop only once the HTTP scheduler has no active model work.
+    for _ in range(3600):
+        try:
+            with urllib.request.urlopen(f'http://127.0.0.1:{PORT}/slots', timeout=2) as response:
+                slots = json.load(response)
+            if all(not item.get('is_processing', item.get('processing', False)) for item in slots):
+                break
+        except Exception:
+            break
+        time.sleep(1)
+    os.kill(state['rank0'], signal.SIGTERM)
+    for _ in range(180):
+        time.sleep(1)
+        result = ssh([f"ps -p {state['rank1']} -o stat="], check=False)
+        if result.returncode != 0 or result.stdout.strip().startswith('Z'):
+            break
+    subprocess.run(['scp', '-q', PEER + ':' + state['remote_log'],
+                    str(root / f'serve{args.label}-r1.log')], check=True)
+    print('pair stopped; rank-1 log archived')
+
+
+if __name__ == '__main__':
+    main()
