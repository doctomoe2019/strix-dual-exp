+constexpr unsigned kBlockThreads = 256;
+
+struct Q8_0Block {
+  __half d;
+  std::int8_t qs[32];
+};
+static_assert(sizeof(Q8_0Block) == 34, "block_q8_0 must be 34 bytes");
+
+/// Deterministic double reduction: partials to shared memory, thread zero
+/// sums them in ascending thread order. The reference accumulates
+/// sequentially in double; this preserves the value to far below float
+/// rounding, which is what the operator limits require.
+__device__ double BlockSumDouble(double value, double* shared) {
+  const std::uint32_t tid = threadIdx.x;
+  shared[tid] = value;
+  __syncthreads();
+  if (tid == 0) {
+    double sum = 0.0;
+    for (std::uint32_t t = 0; t < blockDim.x; ++t) {
+      sum += shared[t];
+    }
+    shared[0] = sum;
+  }
+  __syncthreads();
+  return shared[0];
+}
+
+__global__ void EmbedQ8Kernel(const Q8_0Block* table, std::int32_t token,
+                              float* streams, std::uint32_t hidden,
+                              std::uint32_t n_streams) {
+  const std::uint32_t i = blockIdx.x * blockDim.x + threadIdx.x;
+  if (i >= hidden / 4) {
+    return;
+  }
+  const std::uint32_t block = (i * 4) / 32;
+  const std::uint32_t lane = (i * 4) % 32;
+  const Q8_0Block& q =
+      table[static_cast<std::uint64_t>(token) * (hidden / 32) + block];
+  const float d = __half2float(q.d);
+  float4 value;
+  value.x = d * static_cast<float>(q.qs[lane]);
+  value.y = d * static_cast<float>(q.qs[lane + 1]);
+  value.z = d * static_cast<float>(q.qs[lane + 2]);
+  value.w = d * static_cast<float>(q.qs[lane + 3]);
+  for (std::uint32_t s = 0; s < n_streams; ++s) {
+    *reinterpret_cast<float4*>(streams + static_cast<std::size_t>(s) * hidden +
+                               i * 4) = value;
+  }
+}
+
+__global__ void EmbedF32Kernel(const float* table, std::int32_t token,
+                               float* streams, std::uint32_t hidden,
+                               std::uint32_t n_streams) {
+  const std::uint32_t i = blockIdx.x * blockDim.x + threadIdx.x;
+  if (i >= hidden / 4) {
+    return;
+  }
+  const float4 value = *reinterpret_cast<const float4*>(
+      table + static_cast<std::uint64_t>(token) * hidden + i * 4);
+  for (std::uint32_t s = 0; s < n_streams; ++s) {
+    *reinterpret_cast<float4*>(streams + static_cast<std::size_t>(s) * hidden +
+                               i * 4) = value;
+  }
+}
