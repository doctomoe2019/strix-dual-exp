+// P3.4: two-rank tokenwise TP over tbstream — the lockstep probe.
+//
+//   rank 0 (host A): glm5_next_tp_probe --model FIRST_SHARD.gguf --tp-rank 0
+//                        [--oracle-dir DIR] [--decode N] [--trace-blocks]
+//   rank 1 (host B): glm5_next_tp_probe --model ... --tp-rank 1
+//                        --tp-bootstrap-host HOST_A
+//
+// Both ranks load the full trunk with their TP partition, meet at a
+// zero-byte exchange, then run the same fixed-token prompts from the CPU
+// oracle corpus (token ids parsed from its position lines, so no tokenizer
+// is involved): Paris (5 tokens + N greedy continuation), a text prompt
+// and a code prompt. Every sub-block partial is summed across ranks before
+// its mHC combine; the block observer hashes each summed output so diffing
+// the two rank logs finds the first diverging operator. With --oracle-dir
+// (normally rank 0, which holds the evidence tree) each token's logits are
+// also compared against the CPU oracle rows: rel RMS and top-1.
+//
+// Rank agreement is judged by diffing the two logs' hash/token lines.
+#include <hip/hip_runtime.h>
+
+#include <algorithm>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <map>
+#include <memory>
+#include <sstream>
+#include <string>
+#include <tuple>
+#include <vector>
+
+#include "src/core/gguf_reader.hpp"
+#include "src/models/glm5_next/distributed/tp_partition.hpp"
+#include "src/models/glm5_next/kernels/rocm/device_model.hpp"
+#include "src/models/glm5_next/kernels/rocm/executor.hpp"
+#include "src/models/glm5_next/kernels/rocm/kernels.hpp"
+#include "src/models/glm5_next/weights.hpp"
+#include "src/models/qwen38_flash_next/kernels/rocm/tbstream.hpp"
+
+namespace glm = gufo::models::glm5_next;
+namespace rocm = glm::rocm;
+namespace qrocm = gufo::models::qwen38_flash_next::rocm;
+
+namespace {
+
+int failures = 0;
+
+void Fail(const std::string& message) {
+  std::fprintf(stderr, "FAIL: %s\n", message.c_str());
+  ++failures;
+}
+
+void Say(const std::string& line) {
+  std::printf("[glm-tp %s]\n", line.c_str());
+  std::fflush(stdout);
+}
+
+/// FNV-1a over raw bytes.
+std::uint64_t Hash(const void* data, std::size_t bytes) {
+  const auto* p = static_cast<const std::uint8_t*>(data);
+  std::uint64_t h = 1469598103934665603ULL;
+  for (std::size_t i = 0; i < bytes; ++i) {
+    h ^= p[i];
+    h *= 1099511628211ULL;
+  }
+  return h;
+}
+
+struct Prompt {
+  std::string name;
+  std::vector<std::int32_t> tokens;
+  std::vector<std::int32_t> generated;  // oracle continuation, if any
+};
+
+/// Parses "pos N token ID ..." lines from a reference-probe log.
+std::vector<std::int32_t> ParsePositionTokens(const std::string& path) {
+  std::vector<std::int32_t> tokens;
+  std::ifstream in(path);
+  std::string line;
+  while (std::getline(in, line)) {
+    if (line.rfind("pos ", 0) != 0) {
+      continue;
+    }
+    std::istringstream fields(line);
+    std::string pos_word;
+    std::uint32_t pos = 0;
+    std::string token_word;
+    std::int32_t id = 0;
+    fields >> pos_word >> pos >> token_word >> id;
+    if (fields) {
+      if (tokens.size() != pos) {
+        return {};
+      }
+      tokens.push_back(id);
+    }
+  }
+  return tokens;
+}
+
+std::vector<float> ReadLogitsRow(std::ifstream& file, std::uint32_t vocab,
+                                 std::size_t row) {
+  std::vector<float> data(vocab);
+  file.seekg(static_cast<std::streamoff>(row) * vocab * sizeof(float));
+  file.read(reinterpret_cast<char*>(data.data()),
+            static_cast<std::streamsize>(vocab) * sizeof(float));
+  if (!file) {
+    data.clear();
+  }
+  return data;
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+  std::string model_path;
+  std::string oracle_dir;
+  std::string bootstrap_host;
+  std::uint32_t rank = 0;
+  std::uint16_t bootstrap_port = 18515;
+  std::string tbstream_dev = "/dev/tbstream0";
+  std::uint32_t decode = 8;
+  std::uint32_t lcg_tokens = 0;
+  // 0 = tokenwise Step for every position; >0 = chunked batched prefill
+  // over each prompt with this executor chunk width (decode continuations
+  // stay tokenwise).
+  std::uint32_t prefill_chunk = 0;
+  // Second pass per prompt: rerun tokenwise and batched from a reset
+  // session and require byte-equal final logits + state hashes.
+  bool prefill_compare = false;
+  bool trace_blocks = true;
+  for (int i = 1; i < argc; ++i) {
+    const std::string arg = argv[i];
+    auto next = [&]() -> std::string {
+      return i + 1 < argc ? argv[++i] : std::string();
+    };
+    if (arg == "--model") {
+      model_path = next();
+    } else if (arg == "--oracle-dir") {
+      oracle_dir = next();
+    } else if (arg == "--tp-rank") {
+      rank = static_cast<std::uint32_t>(std::atoi(next().c_str()));
+    } else if (arg == "--tp-bootstrap-host") {
+      bootstrap_host = next();
+    } else if (arg == "--tp-bootstrap-port") {
+      bootstrap_port = static_cast<std::uint16_t>(std::atoi(next().c_str()));
+    } else if (arg == "--tp-tbstream-dev") {
+      tbstream_dev = next();
+    } else if (arg == "--decode") {
+      decode = static_cast<std::uint32_t>(std::atoi(next().c_str()));
+    } else if (arg == "--prefill") {
+      prefill_chunk = static_cast<std::uint32_t>(std::atoi(next().c_str()));
+    } else if (arg == "--prefill-compare") {
+      prefill_compare = true;
+    } else if (arg == "--lcg-tokens") {
+      lcg_tokens = static_cast<std::uint32_t>(std::atoi(next().c_str()));
+    } else if (arg == "--no-trace-blocks") {
+      trace_blocks = false;
+    } else {
+      std::fprintf(stderr, "unknown argument %s\n", arg.c_str());
+      return 2;
+    }
+  }
+  if (model_path.empty() || rank > 1) {
+    std::fprintf(stderr, "--model and --tp-rank 0|1 are required\n");
+    return 2;
+  }
+
+  std::string error;
+  qrocm::TbstreamConfig config;
+  config.rank = rank;
+  config.world_size = 2;
+  config.bootstrap_host = bootstrap_host;
+  config.bootstrap_port = bootstrap_port;
+  config.device_path = tbstream_dev;
+  auto communicator = qrocm::CreateTbstreamCommunicator(config, &error);
+  if (!communicator) {
+    Fail("transport: " + error);
+    return 1;
+  }
+  Say("transport up: " + communicator->Describe());
+  constexpr std::uint64_t kScope = 0x474C4D54ULL;  // "GLMT"
+  if (!communicator->BeginOperation(kScope, &error)) {
+    Fail("scope: " + error);
+    return 1;
+  }
+
+  auto reader = gufo::core::GgufReader::OpenFile(model_path, &error);
+  if (!reader) {
+    Fail("open: " + error);
+    return 1;
+  }
+  auto weights = glm::ModelWeights::Bind(*reader, &error);
+  if (!weights) {
+    Fail("bind: " + error);
+    return 1;
+  }
+  auto partition =
+      glm::distributed::TpPartition::Create(weights->config, rank, 2, &error);
+  if (!partition) {
+    Fail("partition: " + error);
+    return 1;
+  }
+  std::uint64_t free_before = 0;
+  std::uint64_t total_mem = 0;
+  (void)hipMemGetInfo(&free_before, &total_mem);
+  const auto probe_start = std::chrono::steady_clock::now();
+  const auto load_start = probe_start;
+  auto slice = rocm::DeviceSlice::Upload(
+      *weights, *reader, weights->config.num_layers, &*partition, &error);
+  if (!slice) {
+    Fail("upload: " + error);
+    return 1;
+  }
+  const auto load_ms = std::chrono::duration<double, std::milli>(
+                           std::chrono::steady_clock::now() - load_start)
+                           .count();
+  std::uint64_t free_after = 0;
+  (void)hipMemGetInfo(&free_after, &total_mem);
+  Say("loaded rank " + std::to_string(rank) + ": " +
+      std::to_string(slice->tensor_count()) + " tensors, " +
+      std::to_string(slice->encoded_bytes() >> 20) + " MiB encoded, " +
+      std::to_string(static_cast<long>(load_ms)) + " ms, hip free " +
+      std::to_string(free_after >> 30) + " GiB");
+
+  const std::uint32_t hidden = weights->config.hidden_size;
+  // Coarse exchange-cost census (diagnostic; the wall-clock split of the
+  // lockstep all-reduce: total ExchangePartial time vs peer-add enqueue).
+  std::chrono::steady_clock::duration exchange_total{0};
+  std::uint64_t exchange_count = 0;
+  std::uint64_t exchange_bytes = 0;
+  rocm::Executor::Options options;
+  std::uint64_t block_hash = 0;
+  options.all_reduce = [&](float* data, std::uint32_t rows, hipStream_t stream,
+                           std::string* err) -> bool {
+    const std::size_t bytes =
+        static_cast<std::size_t>(rows) * hidden * sizeof(float);
+    const auto exchange_start = std::chrono::steady_clock::now();
+    qrocm::TbstreamWire wire = qrocm::TbstreamWire::kF32;
+    const float* peer =
+        communicator->ExchangePartial(data, bytes, &wire, stream, err);
+    exchange_total += std::chrono::steady_clock::now() - exchange_start;
+    ++exchange_count;
+    exchange_bytes += bytes;
+    if (peer == nullptr) {
+      return false;
+    }
+    if (wire != qrocm::TbstreamWire::kF32) {
+      if (err != nullptr) {
+        *err = "glm tp probe requires the f32 wire";
+      }
+      return false;
+    }
+    rocm::AddInto(data, peer, bytes / sizeof(float), stream);
+    return true;
+  };
+  std::vector<float> block_row(hidden);
+  // Per (layer, sub-block, first-token) first-row hashes, so a compare
+  // pass can name the first diverging sub-block output.
+  bool capture_blocks = false;
+  std::map<std::tuple<std::uint32_t, int, std::uint32_t>, std::uint64_t>
+      block_map;
+  options.block_observer = [&](std::uint32_t layer, int sub,
+                               std::uint32_t first_token, std::uint32_t rows,
+                               const float* device, hipStream_t stream) {
+    if (!trace_blocks) {
+      return;
+    }
+    (void)rows;
+    if (hipMemcpyAsync(block_row.data(), device,
+                       block_row.size() * sizeof(float), hipMemcpyDeviceToHost,
+                       stream) != hipSuccess ||
+        hipStreamSynchronize(stream) != hipSuccess) {
+      return;
+    }
+    const std::uint64_t row_hash =
+        Hash(block_row.data(), block_row.size() * sizeof(float)) ^
+        (layer * 131 + sub);
+    block_hash = row_hash ^ (block_hash << 1);
+    if (capture_blocks) {
+      block_map[{layer, sub, first_token}] = row_hash;
+    }
+  };
+  options.prefill_chunk = prefill_chunk;
+  auto executor = rocm::Executor::Create(std::move(slice), options, &error);
+  if (!executor) {
+    Fail("executor: " + error);
+    return 1;
+  }
+  // The LCG mode needs room for the prompt plus the decode tail.
+  const std::uint32_t lcg_count = lcg_tokens != 0 ? lcg_tokens : 32;
+  const std::uint32_t capacity =
+      lcg_tokens != 0 ? lcg_count + decode + 1 : 4096;
+  auto session = executor->CreateSession(capacity, &error);
+  if (!session) {
+    Fail("session: " + error);
+    return 1;
+  }
+  const glm::Config& c = executor->config();
+
+  // Load-ready rendezvous: a zero-byte exchange once both ranks resident.
+  {
+    float dummy = 0.0F;
+    qrocm::TbstreamWire wire = qrocm::TbstreamWire::kF32;
+    if (communicator->ExchangePartial(&dummy, 0, &wire, nullptr, &error) ==
+        nullptr) {
+      Fail("rendezvous: " + error);
+      return 1;
+    }
+    Say("rendezvous complete");
+  }
+
+  std::vector<Prompt> prompts;
+  if (!oracle_dir.empty()) {
+    for (const char* name : {"paris", "text", "code"}) {
+      Prompt p;
+      p.name = name;
+      p.tokens = ParsePositionTokens(oracle_dir + "/" + name + ".out");
+      if (p.tokens.empty()) {
+        Fail("no oracle tokens for " + p.name);
+      }
+      prompts.push_back(std::move(p));
+    }
+    Prompt cont;
+    cont.name = "cont-paris";
+    cont.tokens = ParsePositionTokens(oracle_dir + "/paris.out");
+    cont.generated = ParsePositionTokens(oracle_dir + "/cont-paris.out");
+    // The continuation log contains all positions (prompt + generated);
+    // keep only the generated ids.
+    if (cont.generated.size() > cont.tokens.size()) {
+      cont.generated.erase(cont.generated.begin(),
+                           cont.generated.begin() +
+                               static_cast<std::ptrdiff_t>(cont.tokens.size()));
+    }
+    prompts.push_back(std::move(cont));
+  } else {
+    // Deterministic LCG prompts when no oracle dir is given: the ranks
+    // still exercise the full path and agreement. `--lcg-tokens N` makes
+    // the prompt long enough to hit the batched chunk boundaries at full
+    // model depth.
+    Prompt p;
+    p.name = "lcg";
+    const std::uint32_t lcg_count = lcg_tokens != 0 ? lcg_tokens : 32;
+    std::uint64_t state = 7;
+    for (std::uint32_t i = 0; i < lcg_count; ++i) {
+      state = state * 1664525ULL + 1013904223ULL;
+      p.tokens.push_back(
+          static_cast<std::int32_t>(1000 + (state >> 33) % 99000U));
+    }
+    prompts.push_back(std::move(p));
+  }
+  if (failures != 0) {
+    return 1;
+  }
+
+  for (const Prompt& prompt : prompts) {
+    session->Reset();
+    block_hash = 0;
+    Say("prompt " + prompt.name + ": " + std::to_string(prompt.tokens.size()) +
+        " tokens");
+    std::ifstream oracle_rows;
+    if (!oracle_dir.empty()) {
+      oracle_rows.open(oracle_dir + "/" + prompt.name + ".logits.bin",
+                       std::ios::binary);
+      if (prompt.name == "cont-paris" && oracle_rows) {
+        // cont-paris shares paris's prompt rows; its own file holds all.
+      }
+    }
+    double worst = 0.0;
+    std::vector<float> logits(c.vocab_size);
+    std::vector<std::int32_t> chosen;
+    const std::size_t total =
+        prompt.tokens.size() +
+        (prompt.name == "cont-paris" ? prompt.generated.size() : 0);
+    auto verify_row = [&](std::size_t t) {
+      const auto top = static_cast<std::int32_t>(
+          std::max_element(logits.begin(), logits.end()) - logits.begin());
+      const double rms = [&] {
+        if (!oracle_rows) {
+          return -1.0;
+        }
+        const std::vector<float> fix =
+            ReadLogitsRow(oracle_rows, c.vocab_size, t);
+        if (fix.empty()) {
+          return -1.0;
+        }
+        bool finite = true;
+        double se = 0.0;
+        double ss = 0.0;
+        for (std::uint32_t i = 0; i < c.vocab_size; ++i) {
+          if (!std::isfinite(logits[i]) || !std::isfinite(fix[i])) {
+            finite = false;
+            break;
+          }
+          const double d = static_cast<double>(logits[i]) - fix[i];
+          se += d * d;
+          ss += static_cast<double>(fix[i]) * fix[i];
+        }
+        const auto fix_top = static_cast<std::int32_t>(
+            std::max_element(fix.begin(), fix.end()) - fix.begin());
+        if (fix_top != top) {
+          Fail(prompt.name + " t" + std::to_string(t) + " top-1 mismatch: " +
+               std::to_string(top) + " vs " + std::to_string(fix_top));
+        }
+        if (!finite) {
+          Fail(prompt.name + " t" + std::to_string(t) + " non-finite logits");
+        }
+        return ss > 0.0 ? std::sqrt(se / ss) : 0.0;
+      }();
+      worst = std::max(worst, rms < 0.0 ? 0.0 : rms);
+      if (rms > 2e-4) {
+        Fail(prompt.name + " t" + std::to_string(t) + " rel_rms " +
+             std::to_string(rms));
+      }
+      char line[256];
+      std::snprintf(line, sizeof(line),
+                    "t=%03zu ms=%.0f top=%d h=%016llx bh=%016llx rms=%.3e", t,
+                    std::chrono::duration<double, std::milli>(
+                        std::chrono::steady_clock::now() - probe_start)
+                        .count(),
+                    top,
+                    static_cast<unsigned long long>(Hash(
+                        logits.data(), static_cast<std::size_t>(c.vocab_size) *
+                                           sizeof(float))),
+                    static_cast<unsigned long long>(block_hash), rms);
+      Say(line);
+    };
+    std::size_t t = 0;
+    if (prefill_chunk != 0 && !prompt.tokens.empty()) {
+      const auto prefill_start = std::chrono::steady_clock::now();
+      if (!executor->Prefill(*session, prompt.tokens, logits.data(), &error)) {
+        Fail("prefill: " + error);
+      } else {
+        const double prefill_ms =
+            std::chrono::duration<double, std::milli>(
+                std::chrono::steady_clock::now() - prefill_start)
+                .count();
+        Say("prefill " + prompt.name + ": " +
+            std::to_string(prompt.tokens.size()) + " tokens in " +
+            std::to_string(prefill_ms) + " ms");
+        verify_row(prompt.tokens.size() - 1);
+        chosen.push_back(static_cast<std::int32_t>(
+            std::max_element(logits.begin(), logits.end()) - logits.begin()));
+      }
+      t = prompt.tokens.size();
+    }
+    for (; t < total && failures == 0; ++t) {
+      const std::int32_t token =
+          t < prompt.tokens.size() ? prompt.tokens[t] : chosen.back();
+      if (!executor->Step(*session, token, logits.data(), &error)) {
+        Fail("step: " + error);
+        break;
+      }
+      verify_row(t);
+      if (t + 1 >= prompt.tokens.size()) {
+        chosen.push_back(static_cast<std::int32_t>(
+            std::max_element(logits.begin(), logits.end()) - logits.begin()));
+      }
+    }
+    if (!prompt.generated.empty()) {
+      for (std::size_t i = 0; i < prompt.generated.size(); ++i) {
+        if (i >= chosen.size()) {
+          Fail(prompt.name + " continuation ended early");
+          break;
+        }
+        if (chosen[i] != prompt.generated[i]) {
+          Fail(prompt.name + " continuation token " + std::to_string(i) + ": " +
+               std::to_string(chosen[i]) + " vs oracle " +
+               std::to_string(prompt.generated[i]));
+        }
+      }
+    }
+    // Greedy decode tail after the prompt (and any oracle continuation):
+    // exercises decode over the prefill-ed caches and gives per-step logit
+    // hashes the ranks can agree on.
+    for (std::size_t g = 0; g < decode && failures == 0; ++g) {
+      if (chosen.empty()) {
+        break;
+      }
+      if (!executor->Step(*session, chosen.back(), logits.data(), &error)) {
+        Fail("decode step: " + error);
+        break;
+      }
+      verify_row(total + g);
+      chosen.push_back(static_cast<std::int32_t>(
+          std::max_element(logits.begin(), logits.end()) - logits.begin()));
+    }
+    if (prefill_compare && !prompt.tokens.empty() && failures == 0) {
+      struct CompareSide {
+        std::vector<float> final_logits;
+        std::uint64_t state{0};
+        std::vector<std::int32_t> picks;
+        std::vector<std::uint64_t> step_hashes;
+        std::map<std::tuple<std::uint32_t, int, std::uint32_t>, std::uint64_t>
+            blocks;
+      };
+      CompareSide tw;
+      CompareSide bt;
+      auto attach_blocks = [&](CompareSide* side) {
+        std::map<std::tuple<std::uint32_t, int, std::uint32_t>, std::uint64_t>
+            taken;
+        taken.swap(block_map);
+        side->blocks = std::move(taken);
+      };
+      auto pick = [&]() {
+        return static_cast<std::int32_t>(
+            std::max_element(logits.begin(), logits.end()) - logits.begin());
+      };
+      auto step_argmax = [&](std::int32_t token) {
+        if (!executor->Step(*session, token, logits.data(), &error)) {
+          Fail("compare step: " + error);
+          return false;
+        }
+        return true;
+      };
+      const auto run_side = [&](bool batched, CompareSide* side) {
+        session->Reset();
+        capture_blocks = true;
+        std::size_t t2 = 0;
+        if (batched) {
+          if (!executor->Prefill(*session, prompt.tokens, logits.data(),
+                                 &error)) {
+            Fail("compare prefill: " + error);
+            return;
+          }
+          t2 = prompt.tokens.size();
+        } else {
+          for (; t2 < prompt.tokens.size(); ++t2) {
+            if (!step_argmax(prompt.tokens[t2])) {
+              return;
+            }
+          }
+        }
+        side->final_logits = logits;
+        side->picks.push_back(pick());
+        for (std::size_t g = 1; g <= decode; ++g) {
+          if (!step_argmax(side->picks.back())) {
+            return;
+          }
+          side->picks.push_back(pick());
+          side->step_hashes.push_back(
+              Hash(logits.data(),
+                   static_cast<std::size_t>(c.vocab_size) * sizeof(float)));
+        }
+        if (!executor->HashState(*session, &side->state, &error)) {
+          Fail("compare hash: " + error);
+          return;
+        }
+        capture_blocks = false;
+        attach_blocks(side);
+      };
+      run_side(false, &tw);
+      run_side(true, &bt);
+      const bool same =
+          tw.final_logits == bt.final_logits && tw.picks == bt.picks &&
+          tw.step_hashes == bt.step_hashes && tw.state == bt.state;
+      if (!same) {
+        // Name the first diverging sub-block between the two passes.
+        bool named = false;
+        for (const auto& entry : bt.blocks) {
+          auto it = tw.blocks.find(entry.first);
+          if (it == tw.blocks.end() || it->second == entry.second) {
+            continue;
+          }
+          Say("first diverging block: layer=" +
+              std::to_string(std::get<0>(entry.first)) +
+              " sub=" + std::to_string(std::get<1>(entry.first)) +
+              " token=" + std::to_string(std::get<2>(entry.first)));
+          named = true;
+          break;
+        }
+        if (!named) {
+          Say("first diverging block: none within captured rows");
+        }
+      }
+      Say("compare " + prompt.name + ": tw=" + std::to_string(tw.state) +
+          " batch=" + std::to_string(bt.state) +
+          (same ? " MATCH" : " MISMATCH"));
+      if (!same) {
+        Fail("prefill compare mismatch: " + prompt.name);
+      }
+    }
+    Say("prompt " + prompt.name + " done: worst rel_rms " +
+        std::to_string(worst));
+    if (failures != 0) {
+      break;
+    }
+  }
+
+  (void)communicator->EndOperation(kScope, &error);
+  {
+    const double ms =
+        std::chrono::duration<double, std::milli>(exchange_total).count();
+    std::printf(
+        "[glm-tp exchanges: %llu totalling %.1f ms (%.1f ms each, %.2f GiB)]\n",
+        static_cast<unsigned long long>(exchange_count), ms,
+        exchange_count != 0 ? ms / exchange_count : 0.0,
+        static_cast<double>(exchange_bytes) / (1024.0 * 1024.0 * 1024.0));
+    std::fflush(stdout);
+  }
+  if (failures != 0) {
+    return 1;
+  }
+  Say("PASS: glm5_next tp probe rank " + std::to_string(rank));
+  return 0;
+}
