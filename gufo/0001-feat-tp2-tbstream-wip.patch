+    | tee -a "$PRLOG" >&2
+  STATUS=1
+fi
+if [ "$STATUS" -ne 0 ]; then
+  echo "[perf $SUFFIX] completed WITH ERRORS (STATUS=$STATUS); see $WLOG" >&2
+fi
+exit "$STATUS"
