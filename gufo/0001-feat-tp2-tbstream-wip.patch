+  // pass reads the global one — the weights staged into a register array
+  // first, then the four norm vectors, then the same stream-major
+  // accumulation — so every partial sum keeps its operands and reduction
+  // order.
+  const std::uint32_t parts = (hidden + 4 * kThreads - 1) / (4 * kThreads);
+  __syncthreads();
+  for (std::uint32_t part = 0; part < parts; ++part) {
+    const std::uint32_t i = (part * kThreads + threadIdx.x) * 4;
+    const bool live = i < hidden;
+    float4 wq[kStreams][kStreams];
+#pragma unroll
+    for (std::uint32_t o = 0; o < kStreams; ++o) {
+#pragma unroll
