+#ifndef GUFO_MODELS_QWEN38_FLASH_NEXT_KERNELS_ROCM_TBSTREAM_HPP_
+#define GUFO_MODELS_QWEN38_FLASH_NEXT_KERNELS_ROCM_TBSTREAM_HPP_
+
+#include <cstdint>
+#include <memory>
+#include <string>
+
+#include "src/models/qwen38_flash_next/kernels/rocm/communicator.hpp"
+
+namespace gufo::models::qwen38_flash_next::rocm {
+
+struct TbstreamConfig {
+  std::uint32_t rank{0};
+  std::uint32_t world_size{2};
+  /// TCP bootstrap address used by rank 1. Rank 0 binds to all interfaces.
+  /// The socket only pairs the ranks and detects a lost peer.
+  std::string bootstrap_host;
+  std::uint16_t bootstrap_port{18515};
+  std::uint32_t device_index{0};
+  /// Character device of a configured USB4STREAM stream, usually
+  /// /dev/tbstream0. See docs/models/qwen3.8-flash-next/TP2.md.
+  std::string device_path{"/dev/tbstream0"};
+};
+
+/// Creates a two-rank USB4STREAM communicator over a thunderbolt_stream
+/// character device (Linux 7.2 or newer). The device is an ordered byte
+/// stream in both directions, so each exchange is one framed write of a
+/// header and the partial, and a reader thread places the peer's frame of
+/// the same exchange into one of the rotating receive windows and raises
+/// the arrival flag. A lost peer is the bootstrap socket closing, and the
+/// reader owns every read, so a write never waits on this rank reading.
+/// Callers must bind the same control scope before model execution; every
+/// collective carries and validates its operation ordinal.
+[[nodiscard]] std::shared_ptr<Communicator> CreateTbstreamCommunicator(
+    const TbstreamConfig& config, std::string* error_msg);
+
+}  // namespace gufo::models::qwen38_flash_next::rocm
+
+#endif  // GUFO_MODELS_QWEN38_FLASH_NEXT_KERNELS_ROCM_TBSTREAM_HPP_
