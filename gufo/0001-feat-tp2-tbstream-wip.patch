+void MeanStreams(const float* streams, float* out, std::uint32_t hidden,
+                 std::uint32_t n, hipStream_t stream) {
+  const unsigned grid = (hidden + kBlockThreads - 1) / kBlockThreads;
+  MeanStreamsKernel<<<grid, kBlockThreads, 0, stream>>>(streams, out, hidden,
+                                                        n);
+}
+
+void KdaConv(const float* qkv, const float* taps_q, const float* taps_k,
+             const float* taps_v, float* history, float* conv_out,
+             std::uint32_t inner, std::uint32_t kernel, hipStream_t stream) {
+  const unsigned grid = (3 * inner + kBlockThreads - 1) / kBlockThreads;
+  KdaConvKernel<<<grid, kBlockThreads, 0, stream>>>(
+      qkv, taps_q, taps_k, taps_v, history, conv_out, inner, kernel);
+}
+
+void KdaPrepare(const float* conv_out, float* qn, float* kn,
+                std::uint32_t heads, std::uint32_t dim, float l2_eps,
+                hipStream_t stream) {
+  const unsigned grid = (heads + kBlockThreads - 1) / kBlockThreads;
+  KdaPrepareKernel<<<grid, kBlockThreads, 0, stream>>>(
+      conv_out, qn, kn, heads, dim, heads * dim, l2_eps);
+}
+
+void KdaGates(const float* raw, const float* a, const float* dt,
+              const float* beta_row, float bound, float* gate, float* beta,
+              std::uint32_t inner, std::uint32_t dim, hipStream_t stream) {
+  const std::uint32_t heads = inner / dim;
+  const unsigned grid =
+      (std::max(inner, heads) + kBlockThreads - 1) / kBlockThreads;
+  KdaGatesKernel<<<grid, kBlockThreads, 0, stream>>>(
+      raw, a, dt, beta_row, bound, gate, beta, inner, dim, heads);
+}
+
+void KdaRecurrence(const float* qn, const float* kn, const float* gate,
+                   const float* beta, const float* conv_out, float* state,
+                   float* core, std::uint32_t heads, std::uint32_t dim,
+                   hipStream_t stream) {
+  // The register-column fast path is the bit-identical twin of the generic
+  // kernel; only the model's kda.head_dim is compiled that way.
+  if (dim == 128) {
+    KdaRecurrenceRegKernel<<<heads, 128, 0, stream>>>(
+        qn, kn, gate, beta, conv_out, state, core, heads);
+    return;
+  }
+  KdaRecurrenceKernel<<<heads, dim, 0, stream>>>(qn, kn, gate, beta, conv_out,
+                                                 state, core, heads, dim);
+}
+
+void SigmoidMul(const float* x, const float* g, float* out, std::size_t count,
+                hipStream_t stream) {
+  const unsigned grid =
+      static_cast<unsigned>((count + kBlockThreads - 1) / kBlockThreads);
+  SigmoidMulKernel<<<grid, kBlockThreads, 0, stream>>>(x, g, out, count);
+}
