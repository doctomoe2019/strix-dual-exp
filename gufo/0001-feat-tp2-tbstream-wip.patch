+                  ReadBin(at + ".kda_conv_out.bin", 3 * inner),
+                  download(conv_out, 3 * inner), 5e-5, &worst_kda);
+            check("kda gate", where, ReadBin(at + ".kda_gate.bin", inner),
+                  download(gate, inner), 5e-5, &worst_kda);
+            check("kda qn", where, ReadBin(at + ".kda_qn.bin", inner),
+                  download(qn, inner), 5e-5, &worst_kda);
+            check("kda kn", where, ReadBin(at + ".kda_kn.bin", inner),
+                  download(kn, inner), 5e-5, &worst_kda);
+          }
+          check("kda block out", where, fix_out, download(block_out, hidden),
+                5e-5, &worst_kda_out);
+          check("kda block out", where, fix_out, download(block_out, hidden),
+                5e-5, &worst_kda_out);
+          ++kda_checked;
+        } else if (sub == 0 && !dl.linear) {
+          // The real DSA path: latent caching, indexer, exact selection,
+          // absorbed sparse MLA and the output projection.
+          const rocm::DeviceDsa& m = dl.dsa;
+          const rocm::DeviceIndexer& idx = dl.indexer;
+          const std::uint32_t pos = static_cast<std::uint32_t>(t);
+          const std::uint32_t tokens_seen = pos + 1;
+          rocm::F32Gemm(m.kv_a.f32(), block_x, latent_raw, kv_lora, hidden,
+                        nullptr);
+          rocm::RmsNormRows(latent_raw, m.kv_a_norm.f32(), latent_normed, 1,
+                            kv_lora, 1, c.rms_eps, nullptr);
+          rocm::AppendRows(latent_normed, latents_cache, kv_lora, pos, 1,
+                           nullptr);
+          gufo::hip::LaunchQ8KBlockGEMV(m.q_a.data, q8, block_x, q_resid_raw,
+                                        q_lora, hidden, nullptr);
+          rocm::RmsNormRows(q_resid_raw, m.q_a_norm.f32(), q_resid, 1, q_lora,
+                            1, c.rms_eps, nullptr);
+          rocm::F32Gemm(idx.k.f32(), block_x, idx_k_raw, idim, hidden, nullptr);
+          rocm::F32Gemm(idx.comp_gate.f32(), block_x, idx_g_raw, idim, hidden,
+                        nullptr);
+          rocm::IndexerAppend(idx_k_raw, idx_g_raw, idx.k_norm.f32(),
+                              idx.k_norm_bias.f32(), index_keys, index_gates,
+                              pos, idim, c.layer_norm_eps, nullptr);
+          const std::uint32_t pools = tokens_seen / kpool;
+          if (tokens_seen % kpool == 0) {
+            rocm::IndexerPool(index_keys, index_gates, idx.comp_ape.f32(),
+                              pooled_cache, pools - 1, kpool, idim, nullptr);
+          }
+          rocm::F32Gemm(idx.q_b.f32(), q_resid, iq, c.IndexerQueryDim(), q_lora,
+                        nullptr);
+          rocm::F32Gemm(idx.proj.f32(), block_x, head_weights_raw,
+                        c.indexer_heads, hidden, nullptr);
+          rocm::ScaleRows(
+              head_weights_raw, head_weights,
+              static_cast<float>(
+                  1.0 / std::sqrt(static_cast<double>(c.indexer_heads))),
+              c.indexer_heads, nullptr);
+          std::vector<std::int32_t> selection;
+          const std::uint32_t tail = tokens_seen % kpool;
+          if (pools > 0) {
+            rocm::IndexerScores(
+                iq, pooled_cache, head_weights, index_scores_buf, pools,
+                c.indexer_heads, idim,
+                static_cast<float>(1.0 / std::sqrt(static_cast<double>(idim))),
+                nullptr);
+            const auto pool_scores = download(index_scores_buf, pools);
+            std::vector<std::uint32_t> order(pools);
+            std::iota(order.begin(), order.end(), 0U);
+            std::stable_sort(order.begin(), order.end(),
+                             [&](std::uint32_t a, std::uint32_t b) {
+                               return pool_scores[a] > pool_scores[b];
+                             });
+            if (!boundary) {
+              const auto fix_scores = ReadBin(at + ".index_scores.bin", pools);
+              check("index scores", "t" + std::to_string(t), fix_scores,
+                    pool_scores, 1e-5, &worst_dsa);
+              const auto fix_pooled =
+                  ReadBin(at + ".index_pooled.bin", pools * idim);
+              check("index pooled", "t" + std::to_string(t), fix_pooled,
+                    download(pooled_cache, pools * idim), 5e-5, &worst_dsa);
+            }
+            const std::uint32_t select_pools =
+                std::min(c.indexer_top_k / kpool, pools);
+            for (std::uint32_t i = 0; i < select_pools; ++i) {
+              for (std::uint32_t j = 0; j < kpool; ++j) {
+                selection.push_back(
+                    static_cast<std::int32_t>(order[i] * kpool + j));
+              }
+            }
+            for (std::uint32_t j = 0; j < tail; ++j) {
+              selection.push_back(
+                  static_cast<std::int32_t>(tokens_seen - tail + j));
+            }
+            std::sort(selection.begin(), selection.end());
+            // The GPU kernel must reproduce this exact selection; the
+            // attention consumes the kernel's list.
+            if (!rocm::BatchSelectPools(
+                    index_scores_buf, pools, 1, pools, select_pools, kpool,
+                    tokens_seen - 1, c.indexer_top_k + c.indexer_kpool,
+                    selection_dev, selection_count, nullptr)) {
+              Fail("gpu selection rejected t" + std::to_string(t));
+            } else {
+              const std::size_t gpu_size =
+                  static_cast<std::size_t>(select_pools) * kpool + tail;
+              std::vector<std::int32_t> gpu_sel(gpu_size);
+              CheckHip(hipMemcpy(gpu_sel.data(), selection_dev,
+                                 gpu_size * sizeof(std::int32_t),
+                                 hipMemcpyDeviceToHost),
+                       "gpu selection download");
+              std::uint32_t gpu_count = 0;
+              CheckHip(hipMemcpy(&gpu_count, selection_count,
+                                 sizeof(std::uint32_t), hipMemcpyDeviceToHost),
+                       "gpu selection count");
+              if (gpu_count != gpu_size) {
+                Fail("gpu selection count t" + std::to_string(t));
+              }
+              if (gpu_sel != selection) {
+                Fail("gpu selection mismatch t" + std::to_string(t));
+              }
+              selection = gpu_sel;
+              ++gpu_selections;
+            }
+          } else {
+            for (std::uint32_t j = 0; j < tail; ++j) {
+              selection.push_back(
+                  static_cast<std::int32_t>(tokens_seen - tail + j));
+            }
+          }
+          // The selection must match the oracle's exactly.
+          {
+            std::ifstream sel_file(token_base + std::to_string(layer) +
+                                   ".sel.txt");
+            std::vector<std::int32_t> fix_sel;
+            std::int32_t v = 0;
+            while (sel_file >> v) {
+              fix_sel.push_back(v);
+            }
+            if (fix_sel != selection) {
+              Fail("selection mismatch t" + std::to_string(t) + " (got " +
+                   std::to_string(selection.size()) + ", expected " +
+                   std::to_string(fix_sel.size()) + ")");
+            }
+          }
+          CheckHip(hipMemcpy(selection_dev, selection.data(),
+                             selection.size() * sizeof(std::int32_t),
+                             hipMemcpyHostToDevice),
+                   "selection upload");
+          gufo::hip::LaunchQ8KBlockGEMV(m.q_b.data, q8, q_resid, q_full,
+                                        c.MlaQueryDim(), q_lora, nullptr);
+          // The executor runs the batched kernels one token wide; exercise
+          // exactly those so the oracle checks the production path.
+          const std::uint32_t sel_count =
+              static_cast<std::uint32_t>(selection.size());
+          CheckHip(hipMemcpy(counts_dev, &sel_count, sizeof(std::uint32_t),
+                             hipMemcpyHostToDevice),
+                   "count upload");
+          rocm::BatchMlaAbsorb(m.k_b.f32(), q_full, q_abs, 1, c.head_count,
+                               kv_lora, c.qk_nope_head_dim, nullptr);
+          rocm::BatchMlaAttention(
+              q_abs, latents_cache, selection_dev, counts_dev,
+              c.indexer_top_k + c.indexer_kpool, m.v_b.f32(), attn_out_buf,
+              attn_probs, attn_weighted, 1, c.head_count, kv_lora,
+              c.qk_nope_head_dim, c.v_head_dim,
+              static_cast<float>(
+                  1.0 / std::sqrt(static_cast<double>(c.qk_nope_head_dim))),
+              nullptr);
+          gufo::hip::LaunchQ8KBlockGEMV(m.out.data, q8, attn_out_buf, block_out,
+                                        hidden, c.MlaQueryDim(), nullptr);
+
+          const std::string where = "t" + std::to_string(t);
+          if (!boundary) {
+            check("mla latent", where, ReadBin(at + ".mla_latent.bin", kv_lora),
+                  download(latent_normed, kv_lora), 5e-5, &worst_dsa);
+          }
+          if (!boundary) {
+            check("mla q_abs", where,
+                  ReadBin(at + ".mla_q_abs.bin",
+                          static_cast<std::size_t>(c.head_count) * kv_lora),
+                  download(q_abs,
+                           static_cast<std::size_t>(c.head_count) * kv_lora),
+                  5e-5, &worst_dsa);
+          }
+          check("dsa block out", where, fix_out, download(block_out, hidden),
+                5e-5, &worst_dsa);
+          ++dsa_checked;
+        } else if (sub == 1) {
+          // The real FFN: dense lead layers, the routed Q4_K experts and
+          // the shared expert. Router selection runs on the host with the
+          // reference's exact float/double arithmetic.
+          if (dl.dense_ffn) {
+            gufo::hip::LaunchQ8KBlockGEMV(dl.ffn_gate.data, q8, block_x,
+                                          ffn_gate_out, c.dense_ffn, hidden,
+                                          nullptr);
+            gufo::hip::LaunchQ8KBlockGEMV(dl.ffn_up.data, q8, block_x,
+                                          ffn_up_out, c.dense_ffn, hidden,
+                                          nullptr);
+            rocm::ClampedSwiglu(ffn_gate_out, ffn_up_out, ffn_act, c.dense_ffn,
+                                c.swiglu_limit, nullptr);
+            gufo::hip::LaunchQ8KBlockGEMV(dl.ffn_down.data, q8, ffn_act,
+                                          block_out, hidden, c.dense_ffn,
+                                          nullptr);
+          } else {
+            rocm::F32Gemm(dl.router.f32(), block_x, router_logits,
+                          c.expert_count, hidden, nullptr);
+            const auto logits_h = download(router_logits, c.expert_count);
+            const auto bias_h = download(dl.router_bias.f32(), c.expert_count);
+            std::vector<float> probs(c.expert_count);
+            for (std::uint32_t e = 0; e < c.expert_count; ++e) {
+              probs[e] = 1.0F / (1.0F + std::exp(-logits_h[e]));
+            }
+            std::vector<std::uint32_t> order(c.expert_count);
+            std::iota(order.begin(), order.end(), 0U);
+            std::stable_sort(order.begin(), order.end(),
+                             [&](std::uint32_t a, std::uint32_t b) {
+                               return probs[a] + bias_h[a] >
+                                      probs[b] + bias_h[b];
+                             });
+            double weight_sum = 0.0;
+            for (std::uint32_t k = 0; k < c.experts_used; ++k) {
+              weight_sum += probs[order[k]];
+            }
+            std::vector<float> comb_weights(c.experts_used);
+            for (std::uint32_t k = 0; k < c.experts_used; ++k) {
+              comb_weights[k] = static_cast<float>(
+                  probs[order[k]] / (weight_sum + 1e-20) * c.routed_scaling);
+            }
+            if (!boundary) {
+              const auto fix_probs =
+                  ReadBin(at + ".router_probs.bin", c.expert_count);
+              check("router probs", "t" + std::to_string(t), fix_probs, probs,
+                    5e-5, &worst_ffn);
+            }
+            if (!boundary) {
+              std::ifstream experts_file(at + ".experts.txt");
+              std::vector<std::int32_t> fix_experts;
+              std::int32_t v = 0;
+              while (experts_file >> v) {
+                fix_experts.push_back(v);
+              }
+              std::vector<std::int32_t> got_experts(
+                  order.begin(), order.begin() + c.experts_used);
+              if (got_experts != fix_experts) {
+                Fail("expert ids mismatch t" + std::to_string(t));
+              }
+            }
+            if (!boundary) {
+              check("expert weights", "t" + std::to_string(t),
+                    ReadBin(at + ".expert_weights.bin", c.experts_used),
+                    comb_weights, 5e-5, &worst_ffn);
+            }
+            CheckHip(hipMemcpyAsync(expert_ids, order.data(),
+                                    c.experts_used * sizeof(std::int32_t),
+                                    hipMemcpyHostToDevice, nullptr),
+                     "expert ids upload");
+            CheckHip(
+                hipMemsetAsync(block_out, 0, hidden * sizeof(float), nullptr),
+                "zero moe accumulator");
+            const auto q4 = gufo::core::GgmlType::kQ4_K;
+            const std::size_t gate_bytes = gufo::quant::QuantizedRowBytes(
+                dl.gate_exps.type, c.hidden_size);
+            const std::size_t down_bytes =
+                gufo::quant::QuantizedRowBytes(dl.down_exps.type, c.expert_ffn);
+            for (std::uint32_t k = 0; k < c.experts_used; ++k) {
+              const std::uint32_t e = order[k];
+              gufo::hip::LaunchQ8KBlockGEMV(
+                  static_cast<const std::uint8_t*>(dl.gate_exps.data) +
+                      static_cast<std::size_t>(e) * c.expert_ffn * gate_bytes,
+                  q4, block_x, ffn_gate_out, c.expert_ffn, hidden, nullptr);
+              gufo::hip::LaunchQ8KBlockGEMV(
+                  static_cast<const std::uint8_t*>(dl.up_exps.data) +
+                      static_cast<std::size_t>(e) * c.expert_ffn * gate_bytes,
+                  q4, block_x, ffn_up_out, c.expert_ffn, hidden, nullptr);
+              rocm::ClampedSwiglu(ffn_gate_out, ffn_up_out, ffn_act,
+                                  c.expert_ffn, c.swiglu_limit, nullptr);
+              gufo::hip::LaunchQ8KBlockGEMV(
+                  static_cast<const std::uint8_t*>(dl.down_exps.data) +
+                      static_cast<std::size_t>(e) * hidden * down_bytes,
+                  q4, ffn_act, ffn_partial, hidden, c.expert_ffn, nullptr);
+              rocm::ScaleAddInto(block_out, ffn_partial, comb_weights[k],
+                                 hidden, nullptr);
+            }
+            const auto shared_ff = c.expert_ffn * c.shared_experts;
+            gufo::hip::LaunchQ8KBlockGEMV(dl.gate_shexp.data, q8, block_x,
+                                          ffn_gate_out, shared_ff, hidden,
+                                          nullptr);
+            gufo::hip::LaunchQ8KBlockGEMV(dl.up_shexp.data, q8, block_x,
+                                          ffn_up_out, shared_ff, hidden,
+                                          nullptr);
+            rocm::ClampedSwiglu(ffn_gate_out, ffn_up_out, ffn_act, shared_ff,
+                                c.swiglu_limit, nullptr);
+            gufo::hip::LaunchQ8KBlockGEMV(dl.down_shexp.data, q8, ffn_act,
+                                          ffn_partial, hidden, shared_ff,
+                                          nullptr);
+            rocm::ScaleAddInto(block_out, ffn_partial, 1.0F, hidden, nullptr);
+          }
+          check("ffn block out",
+                "t" + std::to_string(t) + " l" + std::to_string(layer), fix_out,
+                download(block_out, hidden), 5e-5, &worst_ffn);
+          ++ffn_checked;
+        }
+        rocm::HcCombine(hc_post, hc_comb, residual, block_out, streams, hidden,
+                        n, nullptr);
+        ++blocks_checked;
+      }
+    }
+    rocm::MeanStreams(streams, collapsed, hidden, n, nullptr);
+    if (!boundary) {
+      const auto fix_collapsed = ReadBin(
+          base_name + ".token" + std::to_string(t) + ".collapsed.bin", hidden);
+      check("collapsed", "t" + std::to_string(t), fix_collapsed,
+            download(collapsed, hidden), 5e-5, &worst_collapsed);
+    }
+
+    // Vocabulary head: final norm then the Q8_0 output projection.
+    rocm::RmsNormRows(collapsed, slice->output_norm().f32(), normed, 1, hidden,
+                      1, c.rms_eps, nullptr);
+    gufo::hip::LaunchQ8KBlockGEMV(slice->output().data, q8, normed, logits,
+                                  c.vocab_size, hidden, nullptr);
+    if (boundary && t + 1 != tokens.size()) {
+      CheckHip(hipDeviceSynchronize(), "sync");
+      const double skipped_ms =
+          std::chrono::duration<double, std::milli>(
+              std::chrono::steady_clock::now() - token_start)
+              .count();
+      token_ms_total += skipped_ms;
+      token_ms_max = std::max(token_ms_max, skipped_ms);
+      continue;
+    }
+    const auto got_logits = download(logits, c.vocab_size);
+    std::vector<float> fix_logits_row(c.vocab_size);
+    {
+      std::ifstream in(base_name + ".logits.bin", std::ios::binary);
+      in.seekg(static_cast<std::streamoff>(t) *
+               static_cast<std::streamoff>(c.vocab_size) * sizeof(float));
+      in.read(reinterpret_cast<char*>(fix_logits_row.data()),
+              static_cast<std::streamsize>(c.vocab_size) * sizeof(float));
+      if (!in) {
+        Fail("logits fixture row t" + std::to_string(t));
+      }
+    }
+    const Compare cmp_logits = CompareRows(fix_logits_row, got_logits);
+    worst_logits = std::max(worst_logits, cmp_logits.rel_rms);
+    const auto gpu_top =
+        std::max_element(got_logits.begin(), got_logits.end()) -
+        got_logits.begin();
+    const auto cpu_top =
+        std::max_element(fix_logits_row.begin(), fix_logits_row.end()) -
+        fix_logits_row.begin();
+    if (cmp_logits.rel_rms > 2e-4) {
+      Fail("logits t" + std::to_string(t) + " rel_rms " +
+           std::to_string(cmp_logits.rel_rms));
+    }
+    if (gpu_top != cpu_top) {
+      Fail("logits top-1 mismatch t" + std::to_string(t) + ": " +
+           std::to_string(gpu_top) + " vs " + std::to_string(cpu_top));
+    }
+    CheckHip(hipDeviceSynchronize(), "sync");
+    const double token_ms = std::chrono::duration<double, std::milli>(
+                                std::chrono::steady_clock::now() - token_start)
+                                .count();
+    token_ms_total += token_ms;
+    token_ms_max = std::max(token_ms_max, token_ms);
+  }
+
+  if (failures != 0) {
+    return 1;
+  }
+  std::printf(
+      "full slice over %zu blocks (%zu kda + %zu dsa + %zu ffn layer-tokens) "
+      "x %zu tokens: worst kda %.3e/%.3e, dsa %.3e, ffn %.3e, mhc |d| "
+      "%.3e, block-in %.3e, collapsed %.3e, logits %.3e (top-1 matched)\n",
+      blocks_checked, kda_checked, dsa_checked, ffn_checked, tokens.size(),
+      worst_kda, worst_kda_out, worst_dsa, worst_ffn, worst_mhc, worst_block_in,
+      worst_collapsed, worst_logits);
+  std::uint64_t free_after = 0;
+  std::uint64_t total_mem = 0;
+  if (hipMemGetInfo(&free_after, &total_mem) != hipSuccess) {
+    free_after = 0;
+    total_mem = 0;
+  }
+  std::printf(
+      "timing: %zu tokens, avg %.2f ms/token, max %.2f ms (gpu "
+      "selections %zu); hip free %.3f GiB of %.3f\n",
+      tokens.size(), token_ms_total / static_cast<double>(tokens.size()),
+      token_ms_max, gpu_selections,
+      static_cast<double>(free_after) / (1024.0 * 1024.0 * 1024.0),
+      static_cast<double>(total_mem) / (1024.0 * 1024.0 * 1024.0));
+  std::puts("PASS: glm5_next full four-layer slice on real weights");
+  return 0;
+}
diff --git a/tests/models/glm5_next/engine_test.cpp b/tests/models/glm5_next/engine_test.cpp
new file mode 100644
index 0000000..bea7c28
--- /dev/null
+++ b/tests/models/glm5_next/engine_test.cpp
@@ -0,0 +1,283 @@
+// P3.7: the serving-facing GLM-5.3-Flash engine against the qualified
+// executor semantics, on the full 45-layer rank-partial slice (no
+// transport: AllReduce stays null, as in the executor test).
+//
+//   glm5_next_engine_test --model FIRST_SHARD.gguf [--tp-rank R]
+//
+// Checks, over deterministic LCG prompts (seed 7):
+//  - cold Sync determinism: two fresh sessions produce identical state
+//    hashes and byte-identical logits;
+//  - exact-prefix extension: 20+17 split sync reaches the cold 37-token
+//    state exactly; Step-appended tokens reach the cold prefill state of
+//    the longer prompt exactly; a no-op Sync of the executed history
+//    preserves the state;
+//  - divergence and truncation reset and replay in full, reaching the
+//    corresponding cold state exactly;
+//  - resource accounting: SessionBytes matches the session's actual
+//    device bytes; resident and scratch bytes are nonzero;
+//  - tokenizer round trip and the stop-token set.
+#include "src/models/glm5_next/engine.hpp"
+
+#include <hip/hip_runtime.h>
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <span>
+#include <string>
+#include <vector>
+
+namespace glm = gufo::models::glm5_next;
+
+namespace {
+
+int failures = 0;
+
+void Fail(const std::string& message) {
+  std::fprintf(stderr, "FAIL: %s\n", message.c_str());
+  ++failures;
+}
+
+std::vector<std::int32_t> LcgTokens(std::uint32_t count) {
+  std::vector<std::int32_t> tokens;
+  std::uint64_t state = 7;
+  for (std::uint32_t i = 0; i < count; ++i) {
+    state = state * 1664525ULL + 1013904223ULL;
+    tokens.push_back(static_cast<std::int32_t>(1000 + (state >> 33) % 99000U));
+  }
+  return tokens;
+}
+
+std::uint64_t HashOf(const glm::Session& session, const char* what) {
+  std::uint64_t hash = 0;
+  std::string error;
+  if (!session.StateHash(&hash, &error)) {
+    Fail(std::string(what) + " hash: " + error);
+  }
+  return hash;
+}
+
+void ExpectHash(const glm::Session& session, std::uint64_t expected,
+                const char* what) {
+  const std::uint64_t hash = HashOf(session, what);
+  if (hash != expected) {
+    Fail(std::string(what) + ": state hash " + std::to_string(hash) +
+         " != " + std::to_string(expected));
+  }
+}
+
+std::int32_t Argmax(const glm::Session& session) {
+  const auto logits = session.Logits();
+  if (logits.empty()) {
+    Fail("argmax: no logits");
+    return -1;
+  }
+  return static_cast<std::int32_t>(
+      std::max_element(logits.begin(), logits.end()) - logits.begin());
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+  std::string model_path;
+  std::uint32_t rank = 0;
+  for (int i = 1; i < argc; ++i) {
+    const std::string arg = argv[i];
+    if (arg == "--model" && i + 1 < argc) {
+      model_path = argv[++i];
+    } else if (arg == "--tp-rank" && i + 1 < argc) {
+      rank = static_cast<std::uint32_t>(std::atoi(argv[++i]));
+    } else {
+      std::fprintf(stderr, "unknown argument %s\n", arg.c_str());
+      return 2;
+    }
+  }
+  if (model_path.empty()) {
+    std::fprintf(stderr, "--model is required\n");
+    return 2;
+  }
+
+  std::string error;
+  glm::ModelOptions options;
+  options.max_context = 4096;
+  options.prefill_chunk = 512;
+  options.tp_rank = rank;
+  options.tp_world_size = 2;  // rank-partial slice, no transport
+  auto model = glm::Model::Load(model_path, options, &error);
+  if (!model) {
+    Fail("load: " + error);
+    return 1;
+  }
+  std::printf("engine loaded: vocab %u, %u layers, resident %zu MiB\n",
+              model->VocabSize(), model->config().num_layers,
+              model->ResidentBytes() >> 20);
+
+  const std::vector<std::int32_t> tokens37 = LcgTokens(37);
+  const std::vector<std::int32_t> tokens40 = LcgTokens(40);
+  std::vector<std::int32_t> mutated = tokens37;
+  mutated[10] = 151643;
+
+  // Cold determinism and logits bytes.
+  auto cold = [&](const std::vector<std::int32_t>& tokens,
+                  const char* what) -> std::uint64_t {
+    auto session = model->CreateSession(4096, &error);
+    if (!session) {
+      Fail(std::string(what) + " create: " + error);
+      return 0;
+    }
+    if (!session->Sync(tokens, &error)) {
+      Fail(std::string(what) + " sync: " + error);
+      return 0;
+    }
+    return HashOf(*session, what);
+  };
+  const std::uint64_t cold37 = cold(tokens37, "cold37a");
+  const std::uint64_t cold37b = cold(tokens37, "cold37b");
+  if (cold37 == 0 || cold37 != cold37b) {
+    Fail("cold 37-token sync is not deterministic");
+  }
+  const std::uint64_t cold20 =
+      cold(std::vector<std::int32_t>(tokens37.begin(), tokens37.begin() + 20),
+           "cold20");
+  const std::uint64_t cold40 = cold(tokens40, "cold40");
+  const std::uint64_t cold_mutated = cold(mutated, "cold-mutated");
+
+  // Reference logits of the cold 37-token prompt.
+  std::vector<float> reference;
+  {
+    auto session = model->CreateSession(4096, &error);
+    if (!session || !session->Sync(tokens37, &error)) {
+      Fail("reference sync: " + error);
+    } else {
+      reference.assign(session->Logits().begin(), session->Logits().end());
+    }
+  }
+
+  // Split sync 20 + 17 reuses the exact prefix and reaches the cold state.
+  {
+    auto session = model->CreateSession(4096, &error);
+    if (!session) {
+      Fail("split create: " + error);
+    } else {
+      if (!session->Sync(std::span<const std::int32_t>(tokens37).first(20),
+                         &error) ||
+          !session->Sync(tokens37, &error)) {
+        Fail("split sync: " + error);
+      }
+      ExpectHash(*session, cold37, "split 20+17");
+      if (session->Position() != 37) {
+        Fail("split position");
+      }
+      if (session->Logits().empty() ||
+          !std::equal(session->Logits().begin(), session->Logits().end(),
+                      reference.begin())) {
+        Fail("split logits differ from the cold run");
+      }
+    }
+  }
+
+  // Step-appended tokens reach the cold prefill state; a no-op Sync of
+  // the executed history preserves it.
+  {
+    auto session = model->CreateSession(4096, &error);
+    if (!session) {
+      Fail("step create: " + error);
+    } else if (!session->Sync(std::span<const std::int32_t>(tokens40).first(37),
+                              &error)) {
+      Fail("step sync: " + error);
+    } else {
+      for (std::uint32_t i = 37; i < 40; ++i) {
+        if (!session->Evaluate(tokens40[i], &error)) {
+          Fail("step evaluate: " + error);
+        }
+      }
+      ExpectHash(*session, cold40, "prefill 37 + 3 steps");
+      if (!session->Sync(tokens40, &error)) {
+        Fail("no-op sync: " + error);
+      }
+      ExpectHash(*session, cold40, "no-op sync");
+      if (session->Tokens().size() != 40) {
+        Fail("token history size");
+      }
+      if (session->Logits().empty() ||
+          !std::isfinite(session->Logits().front())) {
+        Fail("logits not retained after the no-op sync");
+      }
+    }
+  }
+
+  // Divergence and truncation reset and replay in full.
+  {
+    auto session = model->CreateSession(4096, &error);
+    if (!session) {
+      Fail("replay create: " + error);
+    } else {
+      if (!session->Sync(tokens37, &error)) {
+        Fail("replay first sync: " + error);
+      }
+      if (!session->Sync(mutated, &error)) {
+        Fail("replay divergent sync: " + error);
+      }
+      ExpectHash(*session, cold_mutated, "divergent replay");
+      if (!session->Sync(std::span<const std::int32_t>(tokens37).first(20),
+                         &error)) {
+        Fail("replay truncated sync: " + error);
+      }
+      ExpectHash(*session, cold20, "truncated replay");
+      if (!session->Sync(std::span<const std::int32_t>{}, &error)) {
+        Fail("empty sync: " + error);
+      }
+      if (session->Position() != 0 || !session->Tokens().empty()) {
+        Fail("empty sync did not reset");
+      }
+    }
+  }
+
+  // Resource accounting matches the actual allocations.
+  {
+    auto session = model->CreateSession(4096, &error);
+    if (!session) {
+      Fail("accounting create: " + error);
+    } else {
+      const std::size_t expected = model->SessionBytes(4096);
+      if (expected != session->StateBytes()) {
+        Fail("session bytes " + std::to_string(session->StateBytes()) +
+             " != predicted " + std::to_string(expected));
+      }
+      if (model->ResidentBytes() == 0 || model->ScratchBytes() == 0) {
+        Fail("resident/scratch bytes not reported");
+      }
+      std::printf("session %zu MiB state, %zu MiB scratch\n",
+                  session->StateBytes() >> 20, model->ScratchBytes() >> 20);
+    }
+  }
+
+  // Tokenizer and stop tokens.
+  {
+    const std::string text = "The capital of France is";
+    const auto ids = model->Tokenize(text);
+    if (ids.empty()) {
+      Fail("tokenizer produced no ids");
+    }
+    if (model->Decode(ids) != text) {
+      Fail("tokenizer round trip: '" + model->Decode(ids) + "'");
+    }
+    if (model->VocabSize() != model->config().vocab_size) {
+      Fail("vocab size mismatch");
+    }
+    const std::int32_t eos = model->EosToken();
+    if (eos < 0 || !model->IsStopToken(eos)) {
+      Fail("eos token is not a stop token");
+    }
+    if (model->IsStopToken(151642) && eos == 151642) {
+      Fail("unexpected eos id");
+    }
+  }
+
+  if (failures == 0) {
+    std::printf("PASS: glm5_next engine over the full slice\n");
+    return 0;
+  }
+  return 1;
+}
diff --git a/tests/models/glm5_next/executor_test.cpp b/tests/models/glm5_next/executor_test.cpp
new file mode 100644
index 0000000..c46042d
--- /dev/null
+++ b/tests/models/glm5_next/executor_test.cpp
@@ -0,0 +1,425 @@
+// P3.3: qualifies the extracted Executor/Session against the P2 oracle
+// fixtures — the same gates the dsa ops test enforced, now through the
+// runtime API (embedding through the vocabulary head, per-token logits
+// rows compared to the CPU reference dump).
+//
+//   glm5_next_executor_test --model FIRST_SHARD.gguf --fixtures DIR
+//     [--prefix capfr] [--trace-name slice]
+//     [--tokens 785,6722,315,9621,374] [--random-tokens N SEED] [--timing]
+//     [--skip-oracle]
+//
+// Also verifies Session::Reset: after the run, the session resets, replays
+// the first two tokens and must reproduce their logits exactly.
+// `--skip-oracle` drops the fixed-token fixture phase (no fixture file
+// needed) and qualifies the batched path purely by tokenwise-vs-batched
+// byte equality of the final logits and every persistent state region —
+// used for widths whose oracle rows were not pinned.
+#include "src/models/glm5_next/kernels/rocm/executor.hpp"
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <memory>
+#include <sstream>
+#include <string>
+#include <vector>
+
+#include "src/core/gguf_reader.hpp"
+#include "src/models/glm5_next/kernels/rocm/device_model.hpp"
+#include "src/models/glm5_next/weights.hpp"
+
+namespace glm = gufo::models::glm5_next;
+namespace rocm = glm::rocm;
+
+namespace {
+
+int failures = 0;
+
+void Fail(const std::string& message) {
+  std::fprintf(stderr, "FAIL: %s\n", message.c_str());
+  ++failures;
+}
+
+std::vector<std::int32_t> ParseTokens(const std::string& text) {
+  std::vector<std::int32_t> out;
+  std::stringstream stream(text);
+  std::string item;
+  while (std::getline(stream, item, ',')) {
+    out.push_back(std::atoi(item.c_str()));
+  }
+  return out;
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+  std::string model_path;
+  std::string fixtures_dir;
+  std::string prefix = "capfr";
+  std::string trace_name = "slice";
+  std::string tokens_arg = "785,6722,315,9621,374";
+  std::uint32_t random_count = 0;
+  std::uint32_t random_seed = 1;
+  std::uint32_t prefill_chunk = 0;
+  std::uint32_t slice_layers = 4;
+  std::int32_t tp_rank = -1;  // -1 = unpartitioned slice (full heads)
+  bool timing = false;
+  bool skip_oracle = false;
+  for (int i = 1; i < argc; ++i) {
+    const std::string arg = argv[i];
+    auto next = [&]() -> std::string {
+      return i + 1 < argc ? argv[++i] : std::string();
+    };
+    if (arg == "--model") {
+      model_path = next();
+    } else if (arg == "--fixtures") {
+      fixtures_dir = next();
+    } else if (arg == "--prefix") {
+      prefix = next();
+    } else if (arg == "--trace-name") {
+      trace_name = next();
+    } else if (arg == "--tokens") {
+      tokens_arg = next();
+    } else if (arg == "--random-tokens") {
+      random_count = static_cast<std::uint32_t>(std::atoi(next().c_str()));
+      random_seed = static_cast<std::uint32_t>(std::atoi(next().c_str()));
+    } else if (arg == "--chunks") {
+      prefill_chunk = static_cast<std::uint32_t>(std::atoi(next().c_str()));
+    } else if (arg == "--layers") {
+      slice_layers = static_cast<std::uint32_t>(std::atoi(next().c_str()));
+    } else if (arg == "--tp-rank") {
+      tp_rank = std::atoi(next().c_str());
+    } else if (arg == "--timing") {
+      timing = true;
+    } else if (arg == "--skip-oracle") {
+      skip_oracle = true;
+    } else {
+      std::fprintf(stderr, "unknown argument %s\n", arg.c_str());
+      return 2;
+    }
+  }
+  if (model_path.empty() || fixtures_dir.empty()) {
+    std::fprintf(stderr, "--model and --fixtures are required\n");
+    return 2;
+  }
+  std::vector<std::int32_t> tokens;
+  if (random_count > 0) {
+    std::uint64_t state = random_seed;
+    for (std::uint32_t i = 0; i < random_count; ++i) {
+      state = state * 1664525ULL + 1013904223ULL;
+      tokens.push_back(
+          static_cast<std::int32_t>(1000 + (state >> 33) % 99000U));
+    }
+  } else {
+    tokens = ParseTokens(tokens_arg);
+  }
+
+  std::string error;
+  auto reader = gufo::core::GgufReader::OpenFile(model_path, &error);
+  if (!reader) {
+    Fail("open: " + error);
+    return 1;
+  }
+  auto weights = glm::ModelWeights::Bind(*reader, &error);
+  if (!weights) {
+    Fail("bind: " + error);
+    return 1;
+  }
+  auto partition = glm::distributed::TpPartition::Create(
+      weights->config, static_cast<std::uint32_t>(tp_rank), 2, &error);
+  if (tp_rank >= 0 && !partition) {
+    Fail("partition: " + error);
+    return 1;
+  }
+  auto slice =
+      rocm::DeviceSlice::Upload(*weights, *reader, slice_layers,
+                                partition ? &*partition : nullptr, &error);
+  if (!slice) {
+    Fail("slice upload: " + error);
+    return 1;
+  }
+  // Per-block capture for the chunk-vs-tokenwise bisect, keyed by
+  // (first token, layer, sub-block) so chunked captures align exactly.
+  struct CapturedBlock {
+    std::uint32_t first_token;
+    std::uint32_t layer;
+    int sub;
+    std::uint32_t rows;
+    std::vector<float> data;  // [rows][hidden]
+  };
+  std::vector<CapturedBlock> captured_blocks;
+  bool capturing = false;
+  const std::uint32_t hidden = weights->config.hidden_size;
+  rocm::Executor::Options options;
+  options.block_observer = [&](std::uint32_t layer, int sub,
+                               std::uint32_t first_token, std::uint32_t rows,
+                               const float* dev, hipStream_t stream) {
+    if (!capturing) {
+      return;
+    }
+    CapturedBlock block;
+    block.first_token = first_token;
+    block.layer = layer;
+    block.sub = sub;
+    block.rows = rows;
+    block.data.resize(static_cast<std::size_t>(rows) * hidden);
+    if (hipMemcpyAsync(block.data.data(), dev,
+                       block.data.size() * sizeof(float), hipMemcpyDeviceToHost,
+                       stream) != hipSuccess ||
+        hipStreamSynchronize(stream) != hipSuccess) {
+      Fail("block capture copy");
+      return;
+    }
+    captured_blocks.push_back(std::move(block));
+  };
+  options.prefill_chunk = prefill_chunk;
+  auto executor = rocm::Executor::Create(std::move(slice), options, &error);
+  if (!executor) {
+    Fail("executor: " + error);
+    return 1;
+  }
+  auto session = executor->CreateSession(
+      static_cast<std::uint32_t>(tokens.size()) + 1, &error);
+  if (!session) {
+    Fail("session: " + error);
+    return 1;
+  }
+  const glm::Config& c = executor->config();
+
+  std::ifstream logits_file;
+  if (!skip_oracle) {
+    logits_file.open(
+        fixtures_dir + "/" + trace_name + "." + prefix + ".logits.bin",
+        std::ios::binary);
+    if (!logits_file) {
+      Fail("missing logits fixture");
+      return 1;
+    }
+  }
+
+  double worst = 0.0;
+  double ms_total = 0.0;
+  double ms_max = 0.0;
+  std::vector<float> logits(c.vocab_size);
+  std::vector<float> first_rows;
+  if (!skip_oracle) {
+    for (std::size_t t = 0; t < tokens.size() && failures == 0; ++t) {
+      const auto start = std::chrono::steady_clock::now();
+      if (!executor->Step(*session, tokens[t], logits.data(), &error)) {
+        Fail("step t" + std::to_string(t) + ": " + error);
+        break;
+      }
+      const double ms = std::chrono::duration<double, std::milli>(
+                            std::chrono::steady_clock::now() - start)
+                            .count();
+      ms_total += ms;
+      ms_max = std::max(ms_max, ms);
+      std::vector<float> fix(c.vocab_size);
+      logits_file.read(
+          reinterpret_cast<char*>(fix.data()),
+          static_cast<std::streamsize>(c.vocab_size) * sizeof(float));
+      if (!logits_file) {
+        Fail("short logits fixture at t" + std::to_string(t));
+        break;
+      }
+      bool finite = true;
+      for (std::uint32_t i = 0; i < c.vocab_size; ++i) {
+        if (!std::isfinite(logits[i]) || !std::isfinite(fix[i])) {
+          finite = false;
+          break;
+        }
+      }
+      if (!finite) {
+        Fail("non-finite logits at t" + std::to_string(t));
+        break;
+      }
+      double square_error = 0.0;
+      double square_scale = 0.0;
+      for (std::uint32_t i = 0; i < c.vocab_size; ++i) {
+        const double d = static_cast<double>(logits[i]) - fix[i];
+        square_error += d * d;
+        square_scale += static_cast<double>(fix[i]) * fix[i];
+      }
+      const double rel_rms =
+          square_scale > 0.0 ? std::sqrt(square_error / square_scale) : 0.0;
+      worst = std::max(worst, rel_rms);
+      const auto gpu_top =
+          std::max_element(logits.begin(), logits.end()) - logits.begin();
+      const auto cpu_top =
+          std::max_element(fix.begin(), fix.end()) - fix.begin();
+      if (rel_rms > 2e-4) {
+        Fail("logits t" + std::to_string(t) + " rel_rms " +
+             std::to_string(rel_rms));
+      }
+      if (gpu_top != cpu_top) {
+        Fail("logits top-1 mismatch t" + std::to_string(t));
+      }
+      if (t < 2) {
+        first_rows.insert(first_rows.end(), logits.begin(), logits.end());
+      }
+    }
+  }
+  if (failures != 0) {
+    return 1;
+  }
+
+  // Reset and replay: the first tokens (up to two) must reproduce their
+  // logits exactly, whatever the history length.
+  const std::size_t replay_n = std::min<std::size_t>(2, tokens.size());
+  if (!skip_oracle) {
+    session->Reset();
+    std::vector<float> replay(replay_n *
+                              static_cast<std::size_t>(c.vocab_size));
+    for (std::size_t t = 0; t < replay_n; ++t) {
+      if (!executor->Step(*session, tokens[t], replay.data() + t * c.vocab_size,
+                          &error)) {
+        Fail("replay step: " + error);
+        return 1;
+      }
+    }
+    if (replay != first_rows) {
+      Fail("reset replay logits differ");
+    }
+  }
+
+  // Chunk-vs-tokenwise byte equality: rerun the whole history through
+  // the batched prefill path and compare logits, recurrent state and
+  // caches byte-for-byte.
+  {
+    // Re-run the full history tokenwise so the hashed state corresponds to
+    // the complete sequence (the replay probe above left it at token 2).
+    session->Reset();
+    captured_blocks.clear();
+    capturing = true;
+    for (std::int32_t token : tokens) {
+      if (!executor->Step(*session, token, logits.data(), &error)) {
+        Fail("tokenwise rerun: " + error);
+        return 1;
+      }
+    }
+    capturing = false;
+    std::uint64_t tokenwise_hash = 0;
+    if (!executor->HashState(*session, &tokenwise_hash, &error)) {
+      Fail("tokenwise state hash: " + error);
+      return 1;
+    }
+    const std::vector<float> tokenwise_logits = logits;
+    const std::vector<CapturedBlock> tokenwise_blocks = captured_blocks;
+    captured_blocks.clear();
+    session->Reset();
+    const auto prefill_start = std::chrono::steady_clock::now();
+    capturing = true;
+    if (!executor->Prefill(*session, tokens, logits.data(), &error)) {
+      Fail("prefill: " + error);
+      return 1;
+    }
+    capturing = false;
+    const double prefill_ms =
+        std::chrono::duration<double, std::milli>(
+            std::chrono::steady_clock::now() - prefill_start)
+            .count();
+    std::uint64_t batch_hash = 0;
+    if (!executor->HashState(*session, &batch_hash, &error)) {
+      Fail("batch state hash: " + error);
+      return 1;
+    }
+    // First differing sub-block output between the two paths, compared by
+    // (token, layer, sub-block) identity: each batched capture covers the
+    // chunk's rows, each tokenwise capture one token.
+    {
+      const std::uint32_t layers_n = executor->slice().layer_count();
+      const std::size_t per_token = static_cast<std::size_t>(layers_n) * 2;
+      auto tokenwise_at = [&](std::uint32_t t, std::uint32_t layer,
+                              int sub) -> const CapturedBlock* {
+        const std::ptrdiff_t i = static_cast<std::ptrdiff_t>(t) * per_token +
+                                 static_cast<std::ptrdiff_t>(layer) * 2 + sub;
+        if (i < 0 || static_cast<std::size_t>(i) >= tokenwise_blocks.size()) {
+          return nullptr;
+        }
+        const CapturedBlock& tw = tokenwise_blocks[static_cast<std::size_t>(i)];
+        if (tw.first_token != t || tw.layer != layer || tw.sub != sub ||
+            tw.rows != 1) {
+          return nullptr;
+        }
+        return &tw;
+      };
+      bool reported = false;
+      for (const CapturedBlock& batch : captured_blocks) {
+        for (std::uint32_t r = 0; r < batch.rows && !reported; ++r) {
+          const std::uint32_t t = batch.first_token + r;
+          const CapturedBlock* tw = tokenwise_at(t, batch.layer, batch.sub);
+          if (tw == nullptr) {
+            continue;
+          }
+          double diff = 0.0;
+          for (std::size_t j = 0; j < hidden; ++j) {
+            diff = std::max<double>(
+                diff,
+                std::fabs(
+                    static_cast<double>(tw->data[j]) -
+                    batch.data[static_cast<std::size_t>(r) * hidden + j]));
+          }
+          if (diff != 0.0) {
+            std::fprintf(stderr,
+                         "first block diff: t=%u layer=%u sub=%d "
+                         "max|diff|=%.6g\n",
+                         t, batch.layer, batch.sub, diff);
+            for (std::size_t j = 0; j < 4; ++j) {
+              std::fprintf(
+                  stderr, "  [%zu] tw=%.8g batch=%.8g\n", j, tw->data[j],
+                  batch.data[static_cast<std::size_t>(r) * hidden + j]);
+            }
+            Fail("batched block output differs from tokenwise");
+            reported = true;
+          }
+        }
+      }
+    }
+    double max_diff = 0.0;
+    for (std::size_t i = 0; i < logits.size(); ++i) {
+      max_diff = std::max<double>(
+          max_diff,
+          std::fabs(static_cast<double>(logits[i]) - tokenwise_logits[i]));
+    }
+    std::fprintf(stderr, "prefill logits max|diff| = %.9g\n", max_diff);
+    if (tokenwise_logits != logits) {
+      Fail("batched prefill logits differ from tokenwise");
+    }
+    if (batch_hash != tokenwise_hash) {
+      Fail("batched prefill state differs from tokenwise");
+    }
+    if (failures == 0) {
+      std::printf(
+          "prefill check: %zu tokens batched in %.0f ms (%.2f ms/token); "
+          "logits + state byte-identical\n",
+          tokens.size(), prefill_ms, prefill_ms / tokens.size());
+    }
+  }
+
+  std::uint64_t free_after = 0;
+  std::uint64_t total_mem = 0;
+  (void)hipMemGetInfo(&free_after, &total_mem);
+  if (skip_oracle) {
+    std::printf(
+        "executor over %zu tokens: tokenwise vs batched byte-identical\n",
+        tokens.size());
+  } else {
+    std::printf("executor over %zu tokens: worst logits rel_rms %.3e%s\n",
+                tokens.size(), worst,
+                failures == 0 ? " (top-1 matched; reset replay exact)" : "");
+  }
+  if (timing && !skip_oracle) {
+    std::printf("timing: avg %.2f ms/token, max %.2f ms; hip free %.3f GiB\n",
+                ms_total / static_cast<double>(tokens.size()), ms_max,
+                static_cast<double>(free_after) / (1024 * 1024 * 1024.0));
+  }
+  if (failures != 0) {
+    return 1;
+  }
+  std::puts("PASS: glm5_next executor over the four-layer slice");
+  return 0;
+}
diff --git a/tests/models/glm5_next/inventory_probe.cpp b/tests/models/glm5_next/inventory_probe.cpp
new file mode 100644
index 0000000..f508729
--- /dev/null
+++ b/tests/models/glm5_next/inventory_probe.cpp
@@ -0,0 +1,78 @@
+// Opens a real GLM-5.3-Flash GGUF artifact, binds every tensor, and
+// prints the configuration plus the TP=1 and TP=2 resident-byte ledgers.
+//
+//   glm5_next_inventory_probe --model FIRST_SHARD.gguf
+//
+// Cross-check against evidence/glm53-flash/headers/inventory.json: the
+// full AR byte count and per-rank share must match the header census.
+
+#include <cstdio>
+#include <memory>
+#include <string>
+
+#include "src/core/gguf_reader.hpp"
+#include "src/models/glm5_next/distributed/tp_plan.hpp"
+#include "src/models/glm5_next/weights.hpp"
+
+int main(int argc, char** argv) {
+  std::string model_path;
+  for (int i = 1; i < argc; ++i) {
+    if (std::string(argv[i]) == "--model" && i + 1 < argc) {
+      model_path = argv[++i];
+    } else {
+      std::fprintf(stderr, "usage: %s --model FIRST_SHARD.gguf\n", argv[0]);
+      return 2;
+    }
+  }
+  if (model_path.empty()) {
+    std::fprintf(stderr, "--model is required\n");
+    return 2;
+  }
+
+  std::string error;
+  auto reader_owner = gufo::core::GgufReader::OpenFile(model_path, &error);
+  if (!reader_owner) {
+    std::fprintf(stderr, "open failed: %s\n", error.c_str());
+    return 1;
+  }
+  auto weights =
+      gufo::models::glm5_next::ModelWeights::Bind(*reader_owner, &error);
+  if (!weights) {
+    std::fprintf(stderr, "bind failed: %s\n", error.c_str());
+    return 1;
+  }
+  const auto regions = reader_owner->GetMappedRegions();
+  for (std::size_t r = 0; r < regions.size(); ++r) {
+    std::printf("region %zu: %p + %.3f GiB\n", r, regions[r].data,
+                regions[r].size / 1073741824.0);
+  }
+  const auto& c = weights->config;
+  std::printf(
+      "config: %u trunk layers (%u KDA + %u DSA), hidden %u, vocab "
+      "%u, context %u, experts %u/%u+%u x %u, indexer %ux%u kpool %u "
+      "topk %u\n",
+      c.num_layers, c.KdaLayerCount(), c.DsaLayerCount(), c.hidden_size,
+      c.vocab_size, c.context_length, c.experts_used, c.expert_count,
+      c.shared_experts, c.expert_ffn, c.indexer_heads, c.indexer_head_dim,
+      c.indexer_kpool, c.indexer_top_k);
+
+  for (std::uint32_t world : {1u, 2u}) {
+    const auto ledger = gufo::models::glm5_next::distributed::PlanTpLedger(
+        *weights, world, &error);
+    if (!ledger) {
+      std::fprintf(stderr, "TP=%u plan failed: %s\n", world, error.c_str());
+      return 1;
+    }
+    std::printf(
+        "TP=%u: tensors %zu, full AR %.3f GiB, per-rank %.3f GiB "
+        "(replicated %.3f, row %.3f, col %.3f, head %.3f, nextn %.3f)\n",
+        world, ledger->tensor_count, ledger->FullArBytes() / 1073741824.0,
+        ledger->PerRankBytes(world) / 1073741824.0,
+        ledger->replicated_bytes / 1073741824.0,
+        ledger->row_split_bytes / 1073741824.0,
+        ledger->col_split_bytes / 1073741824.0,
+        ledger->head_split_bytes / 1073741824.0,
+        ledger->excluded_bytes / 1073741824.0);
+  }
+  return 0;
+}
diff --git a/tests/models/glm5_next/kda_ops_test.cpp b/tests/models/glm5_next/kda_ops_test.cpp
new file mode 100644
index 0000000..ff56766
--- /dev/null
+++ b/tests/models/glm5_next/kda_ops_test.cpp
@@ -0,0 +1,433 @@
+// P2.3 qualification: the KDA linear-attention blocks of the real-weight
+// slice executed on the GPU (projections via the shared quantized GEMV,
+// causal conv + history, decay gates, l2 prepare, channel-decayed delta
+// rule, output norm/gate), integrated into the embedding → mHC → norm →
+// combine chain. Layers 0–2 run their real attention path; the DSA
+// layer's block output (and every FFN output) is fed from the CPU
+// oracle's fixtures until P2.4/P2.5 land. Compares every captured KDA
+// intermediate (conv outputs, gates, normalized q/k) plus the block
+// output, and re-checks the mHC chain, collapsed readout and vocabulary
+// head of P2.2.
+//
+//   glm5_next_kda_ops_test --model FIRST_SHARD.gguf --fixtures DIR
+//     [--prefix capfr] [--tokens 785,6722,315,9621,374]
+//
+// Limits: mHC/norm outputs max |Δ| ≤ 1e-6; KDA intermediates, block
+// outputs and the collapsed readout rel RMS ≤ 5e-5; logits rel RMS
+// ≤ 2e-4 with matching top-1.
+
+#include <hip/hip_runtime.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <memory>
+#include <sstream>
+#include <string>
+#include <vector>
+
+#include "src/core/gguf_reader.hpp"
+#include "src/models/glm5_next/kernels/rocm/device_model.hpp"
+#include "src/models/glm5_next/kernels/rocm/kernels.hpp"
+#include "src/models/glm5_next/weights.hpp"
+#include "src/models/qwen/hip/ops/gemm.hpp"
+
+namespace glm = gufo::models::glm5_next;
+namespace rocm = gufo::models::glm5_next::rocm;
+
+namespace {
+
+int failures = 0;
+
+void Fail(const std::string& message) {
+  std::fprintf(stderr, "FAIL: %s\n", message.c_str());
+  ++failures;
+}
+
+std::vector<float> ReadBin(const std::string& path, std::size_t expect) {
+  std::ifstream in(path, std::ios::binary);
+  if (!in) {
+    Fail("missing fixture " + path);
+    return {};
+  }
+  std::vector<float> data(expect);
+  in.read(reinterpret_cast<char*>(data.data()),
+          static_cast<std::streamsize>(expect * sizeof(float)));
+  if (static_cast<std::size_t>(in.gcount()) != expect * sizeof(float)) {
+    Fail("short fixture " + path);
+  }
+  return data;
+}
+
+std::vector<std::int32_t> ParseTokens(const std::string& text) {
+  std::vector<std::int32_t> out;
+  std::stringstream stream(text);
+  std::string item;
+  while (std::getline(stream, item, ',')) {
+    out.push_back(std::atoi(item.c_str()));
+  }
+  return out;
+}
+
+struct Compare {
+  double max_abs = 0.0;
+  double rel_rms = 0.0;
+};
+
+Compare CompareRows(const std::vector<float>& expected,
+                    const std::vector<float>& actual) {
+  Compare result;
+  double square_error = 0.0;
+  double square_scale = 0.0;
+  for (std::size_t i = 0; i < expected.size(); ++i) {
+    if (!std::isfinite(actual[i])) {
+      Fail("non-finite actual value at " + std::to_string(i) + " (" +
+           std::to_string(actual[i]) + ")");
+      return result;
+    }
+    const double d = static_cast<double>(actual[i]) - expected[i];
+    result.max_abs = std::max(result.max_abs, std::fabs(d));
+    square_error += d * d;
+    square_scale += static_cast<double>(expected[i]) * expected[i];
+  }
+  result.rel_rms =
+      square_scale > 0.0 ? std::sqrt(square_error / square_scale) : 0.0;
+  return result;
+}
+
+struct Buffers {
+  std::vector<void*> pointers;
+  ~Buffers() {
+    for (void* p : pointers) {
+      (void)hipFree(p);
+    }
+  }
+  void* Make(std::size_t bytes) {
+    void* p = nullptr;
+    if (hipMalloc(&p, bytes) != hipSuccess) {
+      Fail("device allocation failed");
+      return nullptr;
+    }
+    pointers.push_back(p);
+    return p;
+  }
+};
+
+void CheckHip(hipError_t error, const char* what) {
+  if (error != hipSuccess) {
+    Fail(std::string(what) + ": " + hipGetErrorString(error));
+  }
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+  std::string model_path;
+  std::string fixtures_dir;
+  std::string prefix = "capfr";
+  std::string tokens_arg = "785,6722,315,9621,374";
+  for (int i = 1; i < argc; ++i) {
+    const std::string arg = argv[i];
+    auto next = [&]() -> std::string {
+      return i + 1 < argc ? argv[++i] : std::string();
+    };
+    if (arg == "--model") {
+      model_path = next();
+    } else if (arg == "--fixtures") {
+      fixtures_dir = next();
+    } else if (arg == "--prefix") {
+      prefix = next();
+    } else if (arg == "--tokens") {
+      tokens_arg = next();
+    } else {
+      std::fprintf(stderr, "unknown argument %s\n", arg.c_str());
+      return 2;
+    }
+  }
+  if (model_path.empty() || fixtures_dir.empty()) {
+    std::fprintf(stderr, "--model and --fixtures are required\n");
+    return 2;
+  }
+  const auto tokens = ParseTokens(tokens_arg);
+
+  std::string error;
+  auto reader = gufo::core::GgufReader::OpenFile(model_path, &error);
+  if (!reader) {
+    Fail("open: " + error);
+    return 1;
+  }
+  auto weights = glm::ModelWeights::Bind(*reader, &error);
+  if (!weights) {
+    Fail("bind: " + error);
+    return 1;
+  }
+  const std::uint32_t layers = 4;
+  auto slice =
+      rocm::DeviceSlice::Upload(*weights, *reader, layers, nullptr, &error);
+  if (!slice) {
+    Fail("slice upload: " + error);
+    return 1;
+  }
+  const glm::Config& c = slice->config();
+  const std::uint32_t hidden = c.hidden_size;
+  const std::uint32_t n = c.hc_count;
+  const std::uint32_t mix_dim = c.HcMixDim();
+  const std::uint32_t inner = c.KdaInnerDim();
+  const std::uint32_t dim = c.kda_head_dim;
+  const std::uint32_t kda_layers = [&] {
+    std::uint32_t count = 0;
+    for (const auto& l : slice->layers()) {
+      count += l.linear ? 1U : 0U;
+    }
+    return count;
+  }();
+  const std::string base_name = fixtures_dir + "/slice." + prefix;
+  const auto logits_fix =
+      ReadBin(base_name + ".logits.bin",
+              static_cast<std::size_t>(tokens.size()) * c.vocab_size);
+  if (failures != 0) {
+    return 1;
+  }
+
+  Buffers buffers;
+  const auto make = [&buffers](std::size_t count) {
+    return static_cast<float*>(buffers.Make(count * sizeof(float)));
+  };
+  auto* streams = make(n * hidden);
+  auto* residual = make(n * hidden);
+  auto* flat = make(n * hidden);
+  auto* mixes = make(mix_dim);
+  auto* hc_pre = make(n);
+  auto* hc_post = make(n);
+  auto* hc_comb = make(n * n);
+  auto* collapsed = make(hidden);
+  auto* block_x = make(hidden);
+  auto* block_out = make(hidden);
+  auto* normed = make(hidden);
+  auto* logits = make(c.vocab_size);
+  // KDA working set (shared across layers) and per-layer persistent state.
+  auto* qkv = make(3 * inner);
+  auto* conv_out = make(3 * inner);
+  auto* raw = make(inner);
+  auto* f_a_out = make(dim);
+  auto* g_a_out = make(dim);
+  auto* beta_row = make(c.head_count);
+  auto* gate = make(inner);
+  auto* beta = make(c.head_count);
+  auto* qn = make(inner);
+  auto* kn = make(inner);
+  auto* core = make(inner);
+  auto* core_normed = make(inner);
+  auto* gated = make(inner);
+  std::vector<float*> kda_history(kda_layers);
+  std::vector<float*> kda_state(kda_layers);
+  for (std::uint32_t l = 0; l < kda_layers; ++l) {
+    kda_history[l] = make((c.kda_conv_kernel - 1) * 3 * inner);
+    kda_state[l] = make(static_cast<std::size_t>(c.head_count) * dim * dim);
+    CheckHip(hipMemset(kda_state[l], 0,
+                       static_cast<std::size_t>(c.head_count) * dim * dim *
+                           sizeof(float)),
+             "zero kda state");
+    CheckHip(hipMemset(kda_history[l], 0,
+                       (c.kda_conv_kernel - 1) * 3 * inner * sizeof(float)),
+             "zero kda history");
+  }
+  if (failures != 0) {
+    return 1;
+  }
+
+  double worst_mhc = 0.0;
+  double worst_block_in = 0.0;
+  double worst_collapsed = 0.0;
+  double worst_logits = 0.0;
+  double worst_kda = 0.0;
+  double worst_kda_out = 0.0;
+  std::size_t blocks_checked = 0;
+  std::size_t kda_checked = 0;
+
+  auto download = [&](const float* device, std::size_t count) {
+    std::vector<float> host(count);
+    CheckHip(hipMemcpy(host.data(), device, count * sizeof(float),
+                       hipMemcpyDeviceToHost),
+             "download");
+    return host;
+  };
+  auto upload = [&](float* device, const std::vector<float>& host) {
+    CheckHip(hipMemcpy(device, host.data(), host.size() * sizeof(float),
+                       hipMemcpyHostToDevice),
+             "upload");
+  };
+  auto check = [&](const char* what, const std::string& where,
+                   const std::vector<float>& fix, const std::vector<float>& got,
+                   double rel_limit, double* worst) {
+    const Compare cmp = CompareRows(fix, got);
+    if (cmp.rel_rms > rel_limit) {
+      Fail(std::string(what) + " " + where + " rel_rms " +
+           std::to_string(cmp.rel_rms));
+    }
+    if (worst != nullptr) {
+      *worst = std::max(*worst, cmp.rel_rms);
+    }
+  };
+
+  const auto q8 = gufo::core::GgmlType::kQ8_0;
+
+  for (std::size_t t = 0; t < tokens.size() && failures == 0; ++t) {
+    const std::string token_base =
+        base_name + ".token" + std::to_string(t) + ".layer";
+    rocm::EmbedTokenStreams(slice->token_embd().data,
+                            rocm::WeightTypeOf(slice->token_embd().type),
+                            tokens[t], streams, hidden, n, nullptr);
+    for (std::uint32_t layer = 0; layer < layers; ++layer) {
+      const rocm::DeviceLayer& dl = slice->layers()[layer];
+      static const char* names[2] = {"attn", "ffn"};
+      for (int sub = 0; sub < 2; ++sub) {
+        const rocm::DeviceHc& hc = sub == 0 ? dl.hc_attn : dl.hc_ffn;
+        const rocm::DeviceTensor& norm = sub == 0 ? dl.attn_norm : dl.ffn_norm;
+        CheckHip(
+            hipMemcpyAsync(residual, streams,
+                           static_cast<std::size_t>(n) * hidden * sizeof(float),
+                           hipMemcpyDeviceToDevice, nullptr),
+            "residual copy");
+        rocm::RmsNormRows(streams, nullptr, flat, 1, n * hidden, 1, c.rms_eps,
+                          nullptr);
+        rocm::F32Gemm(static_cast<const float*>(hc.fn.data), flat, mixes,
+                      mix_dim, n * hidden, nullptr);
+        rocm::HcSinkhorn(mixes, static_cast<const float*>(hc.scale.data),
+                         static_cast<const float*>(hc.base.data), hc_pre,
+                         hc_post, hc_comb, n, c.hc_sinkhorn_iters, c.hc_eps,
+                         nullptr);
+        rocm::HcCollapse(hc_pre, streams, collapsed, hidden, n, nullptr);
+        rocm::RmsNormRows(collapsed, norm.f32(), block_x, 1, hidden, 1,
+                          c.rms_eps, nullptr);
+
+        const std::string at =
+            token_base + std::to_string(layer) + "." + names[sub];
+        const auto fix_pre = ReadBin(at + ".hc_pre.bin", n);
+        const auto fix_post = ReadBin(at + ".hc_post.bin", n);
+        const auto fix_comb = ReadBin(at + ".hc_comb.bin", n * n);
+        const auto fix_in = ReadBin(at + ".in.bin", hidden);
+        const auto fix_out = ReadBin(at + ".out.bin", hidden);
+        if (failures != 0) {
+          return 1;
+        }
+        for (const auto& [name, got, fix] :
+             std::vector<std::tuple<const char*, std::vector<float>,
+                                    const std::vector<float>&>>{
+                 {"hc_pre", download(hc_pre, n), fix_pre},
+                 {"hc_post", download(hc_post, n), fix_post},
+                 {"hc_comb", download(hc_comb, n * n), fix_comb}}) {
+          const Compare cmp = CompareRows(fix, got);
+          worst_mhc = std::max(worst_mhc, cmp.max_abs);
+          if (cmp.max_abs > 1e-6) {
+            Fail(std::string(name) + " t" + std::to_string(t) + " l" +
+                 std::to_string(layer) + " s" + std::to_string(sub) +
+                 " max_abs " + std::to_string(cmp.max_abs));
+          }
+        }
+        check("block input",
+              "t" + std::to_string(t) + " l" + std::to_string(layer) + " s" +
+                  std::to_string(sub),
+              fix_in, download(block_x, hidden), 5e-5, &worst_block_in);
+
+        if (sub == 0 && dl.linear) {
+          // The real KDA path: projections, conv, gates, prepare,
+          // recurrence, output norm and projection.
+          const rocm::DeviceKda& kd = dl.kda;
+          gufo::hip::LaunchQ8KBlockGEMV(kd.q.data, q8, block_x, qkv, inner,
+                                        hidden, nullptr);
+          gufo::hip::LaunchQ8KBlockGEMV(kd.k.data, q8, block_x, qkv + inner,
+                                        inner, hidden, nullptr);
+          gufo::hip::LaunchQ8KBlockGEMV(kd.v.data, q8, block_x, qkv + 2 * inner,
+                                        inner, hidden, nullptr);
+          rocm::KdaConv(qkv, kd.conv_q.f32(), kd.conv_k.f32(), kd.conv_v.f32(),
+                        kda_history[layer], conv_out, inner, c.kda_conv_kernel,
+                        nullptr);
+          rocm::F32Gemm(kd.f_a.f32(), block_x, f_a_out, dim, hidden, nullptr);
+          rocm::F32Gemm(kd.f_b.f32(), f_a_out, raw, inner, dim, nullptr);
+          rocm::F32Gemm(kd.beta.f32(), block_x, beta_row, c.head_count, hidden,
+                        nullptr);
+          rocm::KdaGates(raw, kd.a.f32(), kd.dt_bias.f32(), beta_row,
+                         c.kda_gate_lower_bound, gate, beta, inner, dim,
+                         nullptr);
+          rocm::KdaPrepare(conv_out, qn, kn, c.head_count, dim, 1e-6F, nullptr);
+          rocm::KdaRecurrence(qn, kn, gate, beta, conv_out, kda_state[layer],
+                              core, c.head_count, dim, nullptr);
+          rocm::RmsNormRows(core, kd.o_norm.f32(), core_normed, c.head_count,
+                            inner, c.head_count, c.rms_eps, nullptr);
+          rocm::F32Gemm(kd.g_a.f32(), block_x, g_a_out, dim, hidden, nullptr);
+          rocm::F32Gemm(kd.g_b.f32(), g_a_out, raw, inner, dim, nullptr);
+          rocm::SigmoidMul(core_normed, raw, gated, inner, nullptr);
+          gufo::hip::LaunchQ8KBlockGEMV(kd.out.data, q8, gated, block_out,
+                                        hidden, inner, nullptr);
+
+          const std::string where =
+              "t" + std::to_string(t) + " l" + std::to_string(layer);
+          check("kda conv", where, ReadBin(at + ".kda_conv_out.bin", 3 * inner),
+                download(conv_out, 3 * inner), 5e-5, &worst_kda);
+          check("kda gate", where, ReadBin(at + ".kda_gate.bin", inner),
+                download(gate, inner), 5e-5, &worst_kda);
+          check("kda qn", where, ReadBin(at + ".kda_qn.bin", inner),
+                download(qn, inner), 5e-5, &worst_kda);
+          check("kda kn", where, ReadBin(at + ".kda_kn.bin", inner),
+                download(kn, inner), 5e-5, &worst_kda);
+          check("kda block out", where, fix_out, download(block_out, hidden),
+                5e-5, &worst_kda_out);
+          ++kda_checked;
+        } else {
+          upload(block_out, fix_out);
+        }
+        rocm::HcCombine(hc_post, hc_comb, residual, block_out, streams, hidden,
+                        n, nullptr);
+        ++blocks_checked;
+      }
+    }
+    rocm::MeanStreams(streams, collapsed, hidden, n, nullptr);
+    const auto fix_collapsed = ReadBin(
+        base_name + ".token" + std::to_string(t) + ".collapsed.bin", hidden);
+    check("collapsed", "t" + std::to_string(t), fix_collapsed,
+          download(collapsed, hidden), 5e-5, &worst_collapsed);
+
+    // Vocabulary head: final norm then the Q8_0 output projection.
+    rocm::RmsNormRows(collapsed, slice->output_norm().f32(), normed, 1, hidden,
+                      1, c.rms_eps, nullptr);
+    gufo::hip::LaunchQ8KBlockGEMV(slice->output().data, q8, normed, logits,
+                                  c.vocab_size, hidden, nullptr);
+    const auto got_logits = download(logits, c.vocab_size);
+    const auto* fix_row =
+        logits_fix.data() + static_cast<std::size_t>(t) * c.vocab_size;
+    const std::vector<float> fix_logits_row(fix_row, fix_row + c.vocab_size);
+    const Compare cmp_logits = CompareRows(fix_logits_row, got_logits);
+    worst_logits = std::max(worst_logits, cmp_logits.rel_rms);
+    const auto gpu_top =
+        std::max_element(got_logits.begin(), got_logits.end()) -
+        got_logits.begin();
+    const auto cpu_top =
+        std::max_element(fix_logits_row.begin(), fix_logits_row.end()) -
+        fix_logits_row.begin();
+    if (cmp_logits.rel_rms > 2e-4) {
+      Fail("logits t" + std::to_string(t) + " rel_rms " +
+           std::to_string(cmp_logits.rel_rms));
+    }
+    if (gpu_top != cpu_top) {
+      Fail("logits top-1 mismatch t" + std::to_string(t) + ": " +
+           std::to_string(gpu_top) + " vs " + std::to_string(cpu_top));
+    }
+    CheckHip(hipDeviceSynchronize(), "sync");
+  }
+
+  if (failures != 0) {
+    return 1;
+  }
+  std::printf(
+      "KDA path over %zu blocks (%zu kda layers) x %zu tokens: worst kda "
+      "rel rms %.3e, kda block out %.3e, mhc |d| %.3e, block-in %.3e, "
+      "collapsed %.3e, logits %.3e (top-1 matched)\n",
+      blocks_checked, kda_checked, tokens.size(), worst_kda, worst_kda_out,
+      worst_mhc, worst_block_in, worst_collapsed, worst_logits);
+  std::puts("PASS: glm5_next KDA + mHC + head on real weights");
+  return 0;
+}
diff --git a/tests/models/glm5_next/mhc_ops_test.cpp b/tests/models/glm5_next/mhc_ops_test.cpp
new file mode 100644
index 0000000..3338df2
--- /dev/null
+++ b/tests/models/glm5_next/mhc_ops_test.cpp
@@ -0,0 +1,354 @@
+// P2.2 qualification: the embedding → mHC → norm → combine chain over the
+// real-weight slice, driven by the CPU oracle's block outputs so the whole
+// chain is checked without the (later-phase) mixers. Compares every
+// sub-block's hc_pre/post/comb and normalized input, the final collapsed
+// readout and the vocabulary head against the fixtures produced by
+// `glm5_next_reference_probe --layers 4 --deep --trace ... --dump`.
+//
+//   glm5_next_mhc_ops_test --model FIRST_SHARD.gguf --fixtures DIR
+//     [--prefix capfr] [--tokens 785,6722,315,9621,374]
+//
+// Limits are the frozen P2 contract: mHC/norm outputs max |Δ| ≤ 1e-6,
+// block inputs and the collapsed readout rel RMS ≤ 5e-5, logits rel RMS
+// ≤ 2e-4 with matching top-1.
+
+#include <hip/hip_runtime.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <memory>
+#include <sstream>
+#include <string>
+#include <vector>
+
+#include "src/core/gguf_reader.hpp"
+#include "src/models/glm5_next/kernels/rocm/device_model.hpp"
+#include "src/models/glm5_next/kernels/rocm/kernels.hpp"
+#include "src/models/glm5_next/weights.hpp"
+#include "src/models/qwen/hip/ops/gemm.hpp"
+
+namespace glm = gufo::models::glm5_next;
+namespace rocm = gufo::models::glm5_next::rocm;
+
+namespace {
+
+int failures = 0;
+
+void Fail(const std::string& message) {
+  std::fprintf(stderr, "FAIL: %s\n", message.c_str());
+  ++failures;
+}
+
+std::vector<float> ReadBin(const std::string& path, std::size_t expect) {
+  std::ifstream in(path, std::ios::binary);
+  if (!in) {
+    Fail("missing fixture " + path);
+    return {};
+  }
+  std::vector<float> data(expect);
+  in.read(reinterpret_cast<char*>(data.data()),
+          static_cast<std::streamsize>(expect * sizeof(float)));
+  if (static_cast<std::size_t>(in.gcount()) != expect * sizeof(float)) {
+    Fail("short fixture " + path);
+  }
+  return data;
+}
+
+std::vector<std::int32_t> ParseTokens(const std::string& text) {
+  std::vector<std::int32_t> out;
+  std::stringstream stream(text);
+  std::string item;
+  while (std::getline(stream, item, ',')) {
+    out.push_back(std::atoi(item.c_str()));
+  }
+  return out;
+}
+
+struct Compare {
+  double max_abs = 0.0;
+  double rel_rms = 0.0;
+};
+
+Compare CompareRows(const std::vector<float>& expected,
+                    const std::vector<float>& actual) {
+  Compare result;
+  double square_error = 0.0;
+  double square_scale = 0.0;
+  for (std::size_t i = 0; i < expected.size(); ++i) {
+    if (!std::isfinite(actual[i])) {
+      Fail("non-finite actual value at " + std::to_string(i) + " (" +
+           std::to_string(actual[i]) + ")");
+      return result;
+    }
+    const double d = static_cast<double>(actual[i]) - expected[i];
+    result.max_abs = std::max(result.max_abs, std::fabs(d));
+    square_error += d * d;
+    square_scale += static_cast<double>(expected[i]) * expected[i];
+  }
+  result.rel_rms =
+      square_scale > 0.0 ? std::sqrt(square_error / square_scale) : 0.0;
+  return result;
+}
+
+struct Buffers {
+  std::vector<void*> pointers;
+  ~Buffers() {
+    for (void* p : pointers) {
+      (void)hipFree(p);
+    }
+  }
+  void* Make(std::size_t bytes) {
+    void* p = nullptr;
+    if (hipMalloc(&p, bytes) != hipSuccess) {
+      Fail("device allocation failed");
+      return nullptr;
+    }
+    pointers.push_back(p);
+    return p;
+  }
+};
+
+void CheckHip(hipError_t error, const char* what) {
+  if (error != hipSuccess) {
+    Fail(std::string(what) + ": " + hipGetErrorString(error));
+  }
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+  std::string model_path;
+  std::string fixtures_dir;
+  std::string prefix = "capfr";
+  std::string tokens_arg = "785,6722,315,9621,374";
+  for (int i = 1; i < argc; ++i) {
+    const std::string arg = argv[i];
+    auto next = [&]() -> std::string {
+      return i + 1 < argc ? argv[++i] : std::string();
+    };
+    if (arg == "--model") {
+      model_path = next();
+    } else if (arg == "--fixtures") {
+      fixtures_dir = next();
+    } else if (arg == "--prefix") {
+      prefix = next();
+    } else if (arg == "--tokens") {
+      tokens_arg = next();
+    } else {
+      std::fprintf(stderr, "unknown argument %s\n", arg.c_str());
+      return 2;
+    }
+  }
+  if (model_path.empty() || fixtures_dir.empty()) {
+    std::fprintf(stderr, "--model and --fixtures are required\n");
+    return 2;
+  }
+  const auto tokens = ParseTokens(tokens_arg);
+
+  std::string error;
+  auto reader = gufo::core::GgufReader::OpenFile(model_path, &error);
+  if (!reader) {
+    Fail("open: " + error);
+    return 1;
+  }
+  auto weights = glm::ModelWeights::Bind(*reader, &error);
+  if (!weights) {
+    Fail("bind: " + error);
+    return 1;
+  }
+  const std::uint32_t layers = 4;
+  auto slice =
+      rocm::DeviceSlice::Upload(*weights, *reader, layers, nullptr, &error);
+  if (!slice) {
+    Fail("slice upload: " + error);
+    return 1;
+  }
+  const glm::Config& c = slice->config();
+  const std::uint32_t hidden = c.hidden_size;
+  const std::uint32_t n = c.hc_count;
+  const std::uint32_t mix_dim = c.HcMixDim();
+  const std::string base_name = fixtures_dir + "/slice." + prefix;
+  const auto logits_fix =
+      ReadBin(base_name + ".logits.bin",
+              static_cast<std::size_t>(tokens.size()) * c.vocab_size);
+  if (failures != 0) {
+    return 1;
+  }
+
+  Buffers buffers;
+  auto* streams = static_cast<float*>(
+      buffers.Make(static_cast<std::size_t>(n) * hidden * sizeof(float)));
+  auto* residual = static_cast<float*>(
+      buffers.Make(static_cast<std::size_t>(n) * hidden * sizeof(float)));
+  auto* flat = static_cast<float*>(
+      buffers.Make(static_cast<std::size_t>(n) * hidden * sizeof(float)));
+  auto* mixes = static_cast<float*>(buffers.Make(mix_dim * sizeof(float)));
+  auto* hc_pre = static_cast<float*>(buffers.Make(n * sizeof(float)));
+  auto* hc_post = static_cast<float*>(buffers.Make(n * sizeof(float)));
+  auto* hc_comb = static_cast<float*>(buffers.Make(n * n * sizeof(float)));
+  auto* collapsed = static_cast<float*>(buffers.Make(hidden * sizeof(float)));
+  auto* block_x = static_cast<float*>(buffers.Make(hidden * sizeof(float)));
+  auto* block_out = static_cast<float*>(buffers.Make(hidden * sizeof(float)));
+  auto* normed = static_cast<float*>(buffers.Make(hidden * sizeof(float)));
+  auto* logits =
+      static_cast<float*>(buffers.Make(c.vocab_size * sizeof(float)));
+  if (failures != 0) {
+    return 1;
+  }
+
+  double worst_mhc = 0.0;
+  double worst_block_in = 0.0;
+  double worst_collapsed = 0.0;
+  double worst_logits = 0.0;
+  std::size_t blocks_checked = 0;
+
+  auto download = [&](const float* device, std::size_t count) {
+    std::vector<float> host(count);
+    CheckHip(hipMemcpy(host.data(), device, count * sizeof(float),
+                       hipMemcpyDeviceToHost),
+             "download");
+    return host;
+  };
+  auto upload = [&](float* device, const std::vector<float>& host) {
+    CheckHip(hipMemcpy(device, host.data(), host.size() * sizeof(float),
+                       hipMemcpyHostToDevice),
+             "upload");
+  };
+
+  for (std::size_t t = 0; t < tokens.size() && failures == 0; ++t) {
+    const std::string token_base =
+        base_name + ".token" + std::to_string(t) + ".layer";
+    rocm::EmbedTokenStreams(slice->token_embd().data,
+                            rocm::WeightTypeOf(slice->token_embd().type),
+                            tokens[t], streams, hidden, n, nullptr);
+    for (std::uint32_t layer = 0; layer < layers; ++layer) {
+      const rocm::DeviceLayer& dl = slice->layers()[layer];
+      static const char* names[2] = {"attn", "ffn"};
+      for (int sub = 0; sub < 2; ++sub) {
+        const rocm::DeviceHc& hc = sub == 0 ? dl.hc_attn : dl.hc_ffn;
+        const rocm::DeviceTensor& norm = sub == 0 ? dl.attn_norm : dl.ffn_norm;
+        CheckHip(
+            hipMemcpyAsync(residual, streams,
+                           static_cast<std::size_t>(n) * hidden * sizeof(float),
+                           hipMemcpyDeviceToDevice, nullptr),
+            "residual copy");
+        rocm::RmsNormRows(streams, nullptr, flat, 1, n * hidden, 1, c.rms_eps,
+                          nullptr);
+        rocm::F32Gemm(static_cast<const float*>(hc.fn.data), flat, mixes,
+                      mix_dim, n * hidden, nullptr);
+        rocm::HcSinkhorn(mixes, static_cast<const float*>(hc.scale.data),
+                         static_cast<const float*>(hc.base.data), hc_pre,
+                         hc_post, hc_comb, n, c.hc_sinkhorn_iters, c.hc_eps,
+                         nullptr);
+        rocm::HcCollapse(hc_pre, streams, collapsed, hidden, n, nullptr);
+        rocm::RmsNormRows(collapsed, norm.f32(), block_x, 1, hidden, 1,
+                          c.rms_eps, nullptr);
+
+        const std::string at =
+            token_base + std::to_string(layer) + "." + names[sub];
+        const auto fix_pre = ReadBin(at + ".hc_pre.bin", n);
+        const auto fix_post = ReadBin(at + ".hc_post.bin", n);
+        const auto fix_comb = ReadBin(at + ".hc_comb.bin", n * n);
+        const auto fix_in = ReadBin(at + ".in.bin", hidden);
+        const auto fix_out = ReadBin(at + ".out.bin", hidden);
+        if (failures != 0) {
+          return 1;
+        }
+        const auto got_pre = download(hc_pre, n);
+        const auto got_post = download(hc_post, n);
+        const auto got_comb = download(hc_comb, n * n);
+        const auto got_in = download(block_x, hidden);
+        for (const auto& [name, got, fix, limit] :
+             std::vector<std::tuple<const char*, const std::vector<float>&,
+                                    const std::vector<float>&, double>>{
+                 {"hc_pre", got_pre, fix_pre, 1e-6},
+                 {"hc_post", got_post, fix_post, 1e-6},
+                 {"hc_comb", got_comb, fix_comb, 1e-6}}) {
+          const Compare cmp = CompareRows(fix, got);
+          worst_mhc = std::max(worst_mhc, cmp.max_abs);
+          if (cmp.max_abs > limit) {
+            Fail(std::string(name) + " t" + std::to_string(t) + " l" +
+                 std::to_string(layer) + " s" + std::to_string(sub) +
+                 " max_abs " + std::to_string(cmp.max_abs));
+          }
+        }
+        const Compare cmp_in = CompareRows(fix_in, got_in);
+        worst_block_in = std::max(worst_block_in, cmp_in.rel_rms);
+        if (cmp_in.rel_rms > 5e-5) {
+          Fail("block input t" + std::to_string(t) + " l" +
+               std::to_string(layer) + " s" + std::to_string(sub) +
+               " rel_rms " + std::to_string(cmp_in.rel_rms));
+        }
+        upload(block_out, fix_out);
+        rocm::HcCombine(hc_post, hc_comb, residual, block_out, streams, hidden,
+                        n, nullptr);
+        ++blocks_checked;
+      }
+    }
+    rocm::MeanStreams(streams, collapsed, hidden, n, nullptr);
+    const auto fix_collapsed = ReadBin(
+        base_name + ".token" + std::to_string(t) + ".collapsed.bin", hidden);
+    const auto got_collapsed = download(collapsed, hidden);
+    const Compare cmp_collapsed = CompareRows(fix_collapsed, got_collapsed);
+    worst_collapsed = std::max(worst_collapsed, cmp_collapsed.rel_rms);
+    if (cmp_collapsed.rel_rms > 5e-5) {
+      Fail("collapsed t" + std::to_string(t) + " rel_rms " +
+           std::to_string(cmp_collapsed.rel_rms));
+    }
+
+    // Vocabulary head: final norm then the Q8_0 output projection.
+    rocm::RmsNormRows(collapsed, slice->output_norm().f32(), normed, 1, hidden,
+                      1, c.rms_eps, nullptr);
+    gufo::hip::LaunchQ8KBlockGEMV(slice->output().data,
+                                  gufo::core::GgmlType::kQ8_0, normed, logits,
+                                  c.vocab_size, hidden, nullptr);
+    const auto got_logits = download(logits, c.vocab_size);
+    const auto* fix_row =
+        logits_fix.data() + static_cast<std::size_t>(t) * c.vocab_size;
+    const std::vector<float> fix_logits_row(fix_row, fix_row + c.vocab_size);
+    const Compare cmp_logits = CompareRows(fix_logits_row, got_logits);
+    worst_logits = std::max(worst_logits, cmp_logits.rel_rms);
+    const auto gpu_top =
+        std::max_element(got_logits.begin(), got_logits.end()) -
+        got_logits.begin();
+    const auto cpu_top =
+        std::max_element(fix_logits_row.begin(), fix_logits_row.end()) -
+        fix_logits_row.begin();
+    if (failures == 0 && (gpu_top != cpu_top || cmp_logits.rel_rms > 2e-4)) {
+      std::fprintf(stderr,
+                   "logits t%zu: rel_rms %.3e top gpu %ld (%f) cpu %ld "
+                   "(%f), gpu[0]=%f gpu[1]=%f cpu[0]=%f\n",
+                   t, cmp_logits.rel_rms, gpu_top,
+                   static_cast<double>(got_logits[gpu_top]), cpu_top,
+                   static_cast<double>(fix_logits_row[cpu_top]),
+                   static_cast<double>(got_logits[0]),
+                   static_cast<double>(got_logits[1]),
+                   static_cast<double>(fix_logits_row[0]));
+    }
+    if (cmp_logits.rel_rms > 2e-4) {
+      Fail("logits t" + std::to_string(t) + " rel_rms " +
+           std::to_string(cmp_logits.rel_rms));
+    }
+    if (gpu_top != cpu_top) {
+      Fail("logits top-1 mismatch t" + std::to_string(t) + ": " +
+           std::to_string(gpu_top) + " vs " + std::to_string(cpu_top));
+    }
+    CheckHip(hipDeviceSynchronize(), "sync");
+  }
+
+  if (failures != 0) {
+    return 1;
+  }
+  std::printf(
+      "mHC chain over %zu blocks x %zu tokens: worst mhc |d| %.3e, "
+      "block-in rel rms %.3e, collapsed rel rms %.3e, logits rel rms %.3e "
+      "(top-1 matched)\n",
+      blocks_checked, tokens.size(), worst_mhc, worst_block_in, worst_collapsed,
+      worst_logits);
+  std::puts("PASS: glm5_next mHC + norms + head on real weights");
+  return 0;
+}
diff --git a/tests/models/glm5_next/prefill_bench.cpp b/tests/models/glm5_next/prefill_bench.cpp
new file mode 100644
index 0000000..16f0679
--- /dev/null
+++ b/tests/models/glm5_next/prefill_bench.cpp
@@ -0,0 +1,124 @@
+// Prefill throughput benchmark over a real-weight slice. No observers, no
+// host round-trips per block: one stream drain per repetition. Used for
+// kernel-family attribution and A/B timing of prefill optimizations.
+//
+//   glm5_next_prefill_bench --model FIRST_SHARD.gguf [--layers 4]
+//       [--chunks 512] [--random-tokens 4096 1] [--repeat 2] [--tp-rank -1]
+#include <hip/hip_runtime.h>
+
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "src/core/gguf_reader.hpp"
+#include "src/models/glm5_next/kernels/rocm/device_model.hpp"
+#include "src/models/glm5_next/kernels/rocm/executor.hpp"
+#include "src/models/glm5_next/weights.hpp"
+
+namespace glm = gufo::models::glm5_next;
+namespace rocm = glm::rocm;
+
+int main(int argc, char** argv) {
+  std::string model_path;
+  std::uint32_t slice_layers = 4;
+  std::uint32_t prefill_chunk = 512;
+  std::uint32_t token_count = 4096;
+  std::uint32_t seed = 1;
+  std::uint32_t repeat = 2;
+  std::int32_t tp_rank = -1;
+  for (int i = 1; i < argc; ++i) {
+    const std::string arg = argv[i];
+    auto next = [&]() -> std::string {
+      return i + 1 < argc ? argv[++i] : std::string();
+    };
+    if (arg == "--model") {
+      model_path = next();
+    } else if (arg == "--layers") {
+      slice_layers = static_cast<std::uint32_t>(std::atoi(next().c_str()));
+    } else if (arg == "--chunks") {
+      prefill_chunk = static_cast<std::uint32_t>(std::atoi(next().c_str()));
+    } else if (arg == "--random-tokens") {
+      token_count = static_cast<std::uint32_t>(std::atoi(next().c_str()));
+      seed = static_cast<std::uint32_t>(std::atoi(next().c_str()));
+    } else if (arg == "--repeat") {
+      repeat = static_cast<std::uint32_t>(std::atoi(next().c_str()));
+    } else if (arg == "--tp-rank") {
+      tp_rank = std::atoi(next().c_str());
+    } else {
+      std::fprintf(stderr, "unknown argument %s\n", arg.c_str());
+      return 2;
+    }
+  }
+  if (model_path.empty()) {
+    std::fprintf(stderr, "--model is required\n");
+    return 2;
+  }
+  std::string error;
+  auto reader = gufo::core::GgufReader::OpenFile(model_path, &error);
+  if (!reader) {
+    std::fprintf(stderr, "open: %s\n", error.c_str());
+    return 1;
+  }
+  auto weights = glm::ModelWeights::Bind(*reader, &error);
+  if (!weights) {
+    std::fprintf(stderr, "bind: %s\n", error.c_str());
+    return 1;
+  }
+  auto partition = glm::distributed::TpPartition::Create(
+      weights->config, static_cast<std::uint32_t>(tp_rank), 2, &error);
+  if (tp_rank >= 0 && !partition) {
+    std::fprintf(stderr, "partition: %s\n", error.c_str());
+    return 1;
+  }
+  auto slice =
+      rocm::DeviceSlice::Upload(*weights, *reader, slice_layers,
+                                partition ? &*partition : nullptr, &error);
+  if (!slice) {
+    std::fprintf(stderr, "upload: %s\n", error.c_str());
+    return 1;
+  }
+  rocm::Executor::Options options;
+  options.prefill_chunk = prefill_chunk;
+  auto executor = rocm::Executor::Create(std::move(slice), options, &error);
+  if (!executor) {
+    std::fprintf(stderr, "executor: %s\n", error.c_str());
+    return 1;
+  }
+  auto session = executor->CreateSession(token_count + 1, &error);
+  if (!session) {
+    std::fprintf(stderr, "session: %s\n", error.c_str());
+    return 1;
+  }
+  std::vector<std::int32_t> tokens;
+  std::uint64_t state = seed;
+  for (std::uint32_t i = 0; i < token_count; ++i) {
+    state = state * 1664525ULL + 1013904223ULL;
+    tokens.push_back(static_cast<std::int32_t>(1000 + (state >> 33) % 99000U));
+  }
+  const glm::Config& c = executor->config();
+  std::vector<float> logits(c.vocab_size);
+  double best = 0.0;
+  for (std::uint32_t r = 0; r < repeat; ++r) {
+    session->Reset();
+    const auto start = std::chrono::steady_clock::now();
+    if (!executor->Prefill(*session, tokens, logits.data(), &error)) {
+      std::fprintf(stderr, "prefill: %s\n", error.c_str());
+      return 1;
+    }
+    const double ms = std::chrono::duration<double, std::milli>(
+                          std::chrono::steady_clock::now() - start)
+                          .count();
+    const double tps = token_count * 1000.0 / ms;
+    best = r == 0 ? tps : std::max(best, tps);
+    std::printf("prefill pass %u: %u tokens in %.1f ms (%.1f tok/s)\n", r,
+                token_count, ms, tps);
+    std::fflush(stdout);
+  }
+  std::printf("BEST %.1f tok/s (layers %u, chunk %u)\n", best, slice_layers,
+              prefill_chunk);
+  return 0;
+}
diff --git a/tests/models/glm5_next/reference_probe.cpp b/tests/models/glm5_next/reference_probe.cpp
new file mode 100644
index 0000000..13098c3
--- /dev/null
+++ b/tests/models/glm5_next/reference_probe.cpp
@@ -0,0 +1,330 @@
+// Runs the scalar FP32 reference over a prompt on the real artifact and
+// reports the next-token distribution at every position, with optional
+// greedy generation and a full-logits dump. This is the fixed-token logit
+// oracle the P2 slice kernels qualify against.
+//
+//   glm5_next_reference_probe --model FIRST_SHARD.gguf [--prompt TEXT |
+//     --tokens 1,2,3] [--random-tokens N SEED] [--generate N] [--top K]
+//     [--dump FILE.bin] [--trace FILE PREFIX] [--deep] [--layers N]
+//     [--sel-only]
+//
+// --dump writes float32 logits rows (vocabulary width) back to back.
+// --trace writes, for every token and layer, the normalized block input
+// and block output (hidden width each) as
+// FILE.<prefix>.token<T>.layer<L>.{attn,ffn}.{in,out}.bin — the P2 slice
+// oracle. --deep additionally dumps the operator diagnostics
+// (hc_pre/post/comb, KDA conv/gate/qn/kn, DSA latent/q_abs/pooled/scores,
+// router probs/experts/weights) next to them, and the pre-head collapsed
+// readout. --layers N truncates the trunk after N layers (slice oracle).
+// --random-tokens feeds a deterministic LCG sequence (shared with the GPU
+// qualification tests). --sel-only reduces the trace output to the DSA
+// selections, for long-boundary runs.
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <limits>
+#include <memory>
+#include <numeric>
+#include <span>
+#include <string>
+#include <vector>
+
+#include "src/core/gguf_reader.hpp"
+#include "src/models/glm5_next/reference.hpp"
+#include "src/models/glm5_next/weights.hpp"
+#include "src/models/qwen/tokenizer.hpp"
+
+namespace {
+
+std::vector<std::int32_t> ParseTokens(const std::string& text) {
+  std::vector<std::int32_t> out;
+  std::size_t start = 0;
+  while (start <= text.size()) {
+    const std::size_t end = text.find(',', start);
+    out.push_back(std::atoi(text.substr(start, end - start).c_str()));
+    if (end == std::string::npos) {
+      break;
+    }
+    start = end + 1;
+  }
+  return out;
+}
+
+void PrintTop(const std::vector<float>& logits,
+              const gufo::tokenization::QwenTokenizer& tokenizer,
+              std::uint32_t top) {
+  std::vector<std::uint32_t> order(logits.size());
+  std::iota(order.begin(), order.end(), 0U);
+  std::partial_sort(
+      order.begin(), order.begin() + top, order.end(),
+      [&](std::uint32_t a, std::uint32_t b) { return logits[a] > logits[b]; });
+  const float max_logit = logits[order[0]];
+  double denom = 0.0;
+  for (float v : logits) {
+    denom += std::exp(static_cast<double>(v - max_logit));
+  }
+  for (std::uint32_t i = 0; i < top; ++i) {
+    const std::uint32_t id = order[i];
+    const double p =
+        std::exp(static_cast<double>(logits[id] - max_logit)) / denom;
+    std::string text(tokenizer.DecodeToken(id));
+    for (char& ch : text) {
+      if (ch == '\n') {
+        ch = ' ';
+      }
+    }
+    std::printf("    %6u  %9.4f  %6.3f  %s\n", id, logits[id], p, text.c_str());
+  }
+}
+
+void WriteBin(const std::string& path, const float* data, std::size_t count) {
+  std::ofstream out(path, std::ios::binary);
+  out.write(reinterpret_cast<const char*>(data),
+            static_cast<std::streamsize>(count * sizeof(float)));
+}
+
+void WriteBin(const std::string& path, const std::vector<float>& data) {
+  WriteBin(path, data.data(), data.size());
+}
+
+void WriteBin(const std::string& path, std::span<const float> data) {
+  WriteBin(path, data.data(), data.size());
+}
+
+/// Deterministic token sequence shared with the GPU qualification tests.
+/// Ids stay in the ordinary-text range (no control/special tokens).
+std::vector<std::int32_t> RandomTokens(std::uint32_t count,
+                                       std::uint32_t seed) {
+  std::vector<std::int32_t> out;
+  std::uint64_t state = seed;
+  for (std::uint32_t i = 0; i < count; ++i) {
+    state = state * 1664525ULL + 1013904223ULL;
+    out.push_back(static_cast<std::int32_t>(1000 + (state >> 33) % 99000U));
+  }
+  return out;
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+  std::string model_path;
+  std::string prompt;
+  std::string tokens_arg;
+  std::string dump_path;
+  std::string trace_path;
+  std::string trace_prefix = "trace";
+  int generate = 0;
+  std::uint32_t top = 5;
+  bool deep = false;
+  bool sel_only = false;
+  std::uint32_t layer_limit = 0;
+  std::uint32_t random_count = 0;
+  std::uint32_t random_seed = 1;
+  for (int i = 1; i < argc; ++i) {
+    const std::string arg = argv[i];
+    auto next = [&]() -> std::string {
+      return i + 1 < argc ? argv[++i] : std::string();
+    };
+    if (arg == "--model") {
+      model_path = next();
+    } else if (arg == "--prompt") {
+      prompt = next();
+    } else if (arg == "--tokens") {
+      tokens_arg = next();
+    } else if (arg == "--random-tokens") {
+      random_count = static_cast<std::uint32_t>(std::atoi(next().c_str()));
+      random_seed = static_cast<std::uint32_t>(std::atoi(next().c_str()));
+    } else if (arg == "--dump") {
+      dump_path = next();
+    } else if (arg == "--trace") {
+      trace_path = next();
+      if (i + 1 < argc && argv[i + 1][0] != '-') {
+        trace_prefix = next();
+      }
+    } else if (arg == "--deep") {
+      deep = true;
+    } else if (arg == "--sel-only") {
+      sel_only = true;
+    } else if (arg == "--layers") {
+      layer_limit = static_cast<std::uint32_t>(std::atoi(next().c_str()));
+    } else if (arg == "--generate") {
+      generate = std::atoi(next().c_str());
+    } else if (arg == "--top") {
+      top = static_cast<std::uint32_t>(std::atoi(next().c_str()));
+    } else {
+      std::fprintf(stderr, "unknown argument %s\n", arg.c_str());
+      return 2;
+    }
+  }
+  if (model_path.empty()) {
+    std::fprintf(stderr, "--model is required\n");
+    return 2;
+  }
+
+  std::string error;
+  auto reader_owner = gufo::core::GgufReader::OpenFile(model_path, &error);
+  if (!reader_owner) {
+    std::fprintf(stderr, "open failed: %s\n", error.c_str());
+    return 1;
+  }
+  auto weights =
+      gufo::models::glm5_next::ModelWeights::Bind(*reader_owner, &error);
+  if (!weights) {
+    std::fprintf(stderr, "bind failed: %s\n", error.c_str());
+    return 1;
+  }
+  auto tokenizer =
+      gufo::tokenization::QwenTokenizer::CreateFromGguf(*reader_owner, &error);
+  if (!tokenizer) {
+    std::fprintf(stderr, "tokenizer failed: %s\n", error.c_str());
+    return 1;
+  }
+  const auto& c = weights->config;
+  std::printf(
+      "model: %u layers (%u KDA + %u DSA), hidden %u, vocab %u, "
+      "experts %u/%u+%u x %u\n",
+      c.num_layers, c.KdaLayerCount(), c.DsaLayerCount(), c.hidden_size,
+      c.vocab_size, c.experts_used, c.expert_count, c.shared_experts,
+      c.expert_ffn);
+
+  std::vector<std::int32_t> tokens;
+  if (random_count > 0) {
+    tokens = RandomTokens(random_count, random_seed);
+  } else if (!tokens_arg.empty()) {
+    tokens = ParseTokens(tokens_arg);
+  } else {
+    for (auto id : tokenizer->Encode(prompt)) {
+      tokens.push_back(static_cast<std::int32_t>(id));
+    }
+  }
+  std::printf("prompt tokens (%zu):", tokens.size());
+  for (auto t : tokens) {
+    std::printf(" %d", t);
+  }
+  std::printf("\n");
+  if (tokens.empty()) {
+    return 0;
+  }
+
+  std::ofstream dump;
+  if (!dump_path.empty()) {
+    dump.open(dump_path, std::ios::binary);
+  }
+
+  gufo::models::glm5_next::ReferenceModel model(
+      *weights, &error, !trace_path.empty(), deep, layer_limit);
+  if (!error.empty()) {
+    std::fprintf(stderr, "reference init failed: %s\n", error.c_str());
+    return 1;
+  }
+  std::printf("executing %u of %u layers\n", model.ExecutedLayers(),
+              c.num_layers);
+  std::vector<float> logits(c.vocab_size);
+  const std::size_t total = tokens.size() + static_cast<std::size_t>(generate);
+  for (std::size_t i = 0; i < total; ++i) {
+    std::int32_t token = 0;
+    if (i < tokens.size()) {
+      token = tokens[i];
+    } else {
+      token = static_cast<std::int32_t>(
+          std::max_element(logits.begin(), logits.end()) - logits.begin());
+      tokens.push_back(token);
+    }
+    const auto start = std::chrono::steady_clock::now();
+    if (!model.Step(token, logits, &error)) {
+      std::fprintf(stderr, "step %zu failed: %s\n", i, error.c_str());
+      return 1;
+    }
+    const double ms = std::chrono::duration<double, std::milli>(
+                          std::chrono::steady_clock::now() - start)
+                          .count();
+    std::string text(tokenizer->DecodeToken(static_cast<std::uint32_t>(token)));
+    std::printf("pos %zu token %d '%s' (%.0f ms)\n", i, token, text.c_str(),
+                ms);
+    PrintTop(logits, *tokenizer, top);
+    if (dump.is_open()) {
+      dump.write(reinterpret_cast<const char*>(logits.data()),
+                 static_cast<std::streamsize>(logits.size() * sizeof(float)));
+    }
+    if (!trace_path.empty()) {
+      const std::string base = trace_path + "." + trace_prefix + ".token" +
+                               std::to_string(model.position() - 1);
+      for (std::uint32_t layer = 0; layer < c.num_layers; ++layer) {
+        if (c.IsDsaLayer(layer) && layer < model.ExecutedLayers()) {
+          const auto selection = model.LastSelection(layer);
+          std::ofstream out(base + ".layer" + std::to_string(layer) +
+                            ".sel.txt");
+          for (std::size_t k = 0; k < selection.size(); ++k) {
+            out << (k == 0 ? "" : " ") << selection[k];
+          }
+        }
+      }
+      if (sel_only) {
+        continue;
+      }
+      const auto& trace = model.trace();
+      for (std::uint32_t layer = 0; layer < model.ExecutedLayers(); ++layer) {
+        static const char* names[2] = {"attn", "ffn"};
+        for (int sub = 0; sub < 2; ++sub) {
+          const auto& block =
+              trace[model.position() - 1][layer][static_cast<std::size_t>(sub)];
+          const std::string side[2] = {"in", "out"};
+          const std::vector<float>* rows[2] = {&block.input, &block.output};
+          for (int which = 0; which < 2; ++which) {
+            WriteBin(base + ".layer" + std::to_string(layer) + "." +
+                         names[sub] + "." + side[which] + ".bin",
+                     *rows[which]);
+          }
+        }
+      }
+      WriteBin(base + ".collapsed.bin", model.LastCollapsed());
+      if (deep) {
+        const auto& rows = model.deep();
+        for (std::uint32_t layer = 0; layer < model.ExecutedLayers(); ++layer) {
+          static const char* names[2] = {"attn", "ffn"};
+          for (int sub = 0; sub < 2; ++sub) {
+            const auto& d = rows[model.position() - 1][layer]
+                                [static_cast<std::size_t>(sub)];
+            const std::string at =
+                base + ".layer" + std::to_string(layer) + "." + names[sub];
+            if (!d.hc_pre.empty()) {
+              WriteBin(at + ".hc_pre.bin", d.hc_pre);
+              WriteBin(at + ".hc_post.bin", d.hc_post);
+              WriteBin(at + ".hc_comb.bin", d.hc_comb);
+            }
+            if (!d.kda_conv_out.empty()) {
+              WriteBin(at + ".kda_conv_out.bin", d.kda_conv_out);
+              WriteBin(at + ".kda_gate.bin", d.kda_gate);
+              WriteBin(at + ".kda_qn.bin", d.kda_qn);
+              WriteBin(at + ".kda_kn.bin", d.kda_kn);
+            }
+            if (!d.mla_latent.empty()) {
+              WriteBin(at + ".mla_latent.bin", d.mla_latent);
+              WriteBin(at + ".mla_q_abs.bin", d.mla_q_abs);
+              WriteBin(at + ".index_pooled.bin", d.index_pooled);
+              WriteBin(at + ".index_scores.bin", d.index_scores);
+            }
+            if (!d.router_probs.empty()) {
+              WriteBin(at + ".router_probs.bin", d.router_probs);
+              WriteBin(at + ".expert_weights.bin", d.expert_weights);
+              std::ofstream out(at + ".experts.txt");
+              for (std::size_t k = 0; k < d.experts.size(); ++k) {
+                out << (k == 0 ? "" : " ") << d.experts[k];
+              }
+            }
+          }
+        }
+      }
+    }
+  }
+  if (generate > 0) {
+    const std::vector<gufo::tokenization::TokenId> generated(
+        tokens.end() - generate, tokens.end());
+    std::printf("generated: %s\n", tokenizer->Decode(generated).c_str());
+  }
+  return 0;
+}
