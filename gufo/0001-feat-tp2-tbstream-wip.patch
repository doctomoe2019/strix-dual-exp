+glm::Config RealConfig() {
+  glm::Config c;
+  c.num_layers = 45;
+  c.hidden_size = 4096;
+  c.vocab_size = 154880;
+  c.head_count = 64;
+  c.q_lora_rank = 1536;
+  c.kv_lora_rank = 512;
+  c.qk_nope_head_dim = 256;
+  c.v_head_dim = 256;
+  c.kda_head_dim = 128;
+  c.kda_conv_kernel = 4;
+  c.indexer_heads = 32;
+  c.indexer_head_dim = 128;
+  c.indexer_kpool = 4;
+  c.hc_count = 4;
+  c.dense_lead = 1;
+  c.dense_ffn = 12288;
+  c.expert_count = 288;
+  c.experts_used = 8;
+  c.shared_experts = 1;
+  c.expert_ffn = 2048;
+  c.dsa_layer = {false, true};
+  c.num_layers = 2;
+  return c;
+}
+
+// One dense KDA layer and one sparse DSA layer with the artifact's real
+// dimensions and encodings (mirrors the tp_plan fixture).
+glm::ModelWeights TwoLayerWeights() {
+  glm::ModelWeights w;
+  w.config = RealConfig();
+  const auto hidden = w.config.hidden_size;
+  const auto inner = w.config.KdaInnerDim();
+  const auto query = w.config.MlaQueryDim();
+  const auto head_dim = w.config.kda_head_dim;
+  const auto expert_ff = w.config.expert_ffn;
+  const auto experts = w.config.expert_count;
+
+  w.token_embd = Ref(GgmlType::kQ8_0, hidden, w.config.vocab_size, 1, "embd");
+  w.output = Ref(GgmlType::kQ8_0, hidden, w.config.vocab_size, 1, "output");
+  w.output_norm = Ref(GgmlType::kF32, hidden, 1, 1, "output_norm");
+  w.layers.resize(2);
+
+  glm::LayerWeights& kda = w.layers[0];
+  kda.linear = true;
+  kda.attn_norm = Ref(GgmlType::kF32, hidden, 1, 1, "attn_norm");
+  kda.ffn_norm = Ref(GgmlType::kF32, hidden, 1, 1, "ffn_norm");
+  kda.hc_attn.fn =
+      Ref(GgmlType::kF32, w.config.HcDim(), w.config.HcMixDim(), 1, "hc_fn");
+  kda.hc_attn.base = Ref(GgmlType::kF32, w.config.HcMixDim(), 1, 1, "hc_base");
+  kda.hc_attn.scale = Ref(GgmlType::kF32, 3, 1, 1, "hc_scale");
+  kda.hc_ffn = kda.hc_attn;
+  kda.kda.q = Ref(GgmlType::kQ8_0, hidden, inner, 1, "kda_q");
+  kda.kda.k = Ref(GgmlType::kQ8_0, hidden, inner, 1, "kda_k");
+  kda.kda.v = Ref(GgmlType::kQ8_0, hidden, inner, 1, "kda_v");
+  kda.kda.out = Ref(GgmlType::kQ8_0, inner, hidden, 1, "kda_out");
+  kda.kda.conv_q = Ref(GgmlType::kF32, 4, inner, 1, "conv_q");
+  kda.kda.conv_k = Ref(GgmlType::kF32, 4, inner, 1, "conv_k");
+  kda.kda.conv_v = Ref(GgmlType::kF32, 4, inner, 1, "conv_v");
+  kda.kda.f_a = Ref(GgmlType::kF32, hidden, head_dim, 1, "f_a");
+  kda.kda.f_b = Ref(GgmlType::kF32, head_dim, inner, 1, "f_b");
+  kda.kda.g_a = Ref(GgmlType::kF32, hidden, head_dim, 1, "g_a");
+  kda.kda.g_b = Ref(GgmlType::kF32, head_dim, inner, 1, "g_b");
+  kda.kda.beta = Ref(GgmlType::kF32, hidden, 64, 1, "beta");
+  kda.kda.a = Ref(GgmlType::kF32, 64, 1, 1, "a");
+  kda.kda.dt_bias = Ref(GgmlType::kF32, inner, 1, 1, "dt");
+  kda.kda.o_norm = Ref(GgmlType::kF32, head_dim, 1, 1, "o_norm");
+  kda.dense_ffn = true;
+  kda.ffn_gate =
+      Ref(GgmlType::kQ8_0, hidden, w.config.dense_ffn, 1, "ffn_gate");
+  kda.ffn_up = Ref(GgmlType::kQ8_0, hidden, w.config.dense_ffn, 1, "ffn_up");
+  kda.ffn_down =
+      Ref(GgmlType::kQ8_0, w.config.dense_ffn, hidden, 1, "ffn_down");
+
+  glm::LayerWeights& dsa = w.layers[1];
+  dsa.linear = false;
+  dsa.attn_norm = kda.attn_norm;
+  dsa.ffn_norm = kda.ffn_norm;
+  dsa.hc_attn = kda.hc_attn;
+  dsa.hc_ffn = kda.hc_ffn;
+  dsa.dsa.q_a = Ref(GgmlType::kQ8_0, hidden, w.config.q_lora_rank, 1, "q_a");
+  dsa.dsa.q_a_norm =
+      Ref(GgmlType::kF32, w.config.q_lora_rank, 1, 1, "q_a_norm");
+  dsa.dsa.q_b = Ref(GgmlType::kQ8_0, w.config.q_lora_rank, query, 1, "q_b");
+  dsa.dsa.kv_a = Ref(GgmlType::kF32, hidden, w.config.kv_lora_rank, 1, "kv_a");
+  dsa.dsa.kv_a_norm =
+      Ref(GgmlType::kF32, w.config.kv_lora_rank, 1, 1, "kv_a_norm");
+  dsa.dsa.k_b = Ref(GgmlType::kF32, w.config.qk_nope_head_dim,
+                    w.config.kv_lora_rank, 64, "k_b");
+  dsa.dsa.v_b = Ref(GgmlType::kF32, w.config.kv_lora_rank, w.config.v_head_dim,
+                    64, "v_b");
+  dsa.dsa.out = Ref(GgmlType::kQ8_0, query, hidden, 1, "dsa_out");
+  dsa.indexer.q_b = Ref(GgmlType::kF32, w.config.q_lora_rank,
+                        w.config.IndexerQueryDim(), 1, "idx_q");
+  dsa.indexer.k =
+      Ref(GgmlType::kF32, hidden, w.config.indexer_head_dim, 1, "idx_k");
+  dsa.indexer.k_norm =
+      Ref(GgmlType::kF32, w.config.indexer_head_dim, 1, 1, "idx_k_norm");
+  dsa.indexer.k_norm_bias =
+      Ref(GgmlType::kF32, w.config.indexer_head_dim, 1, 1, "idx_k_norm_b");
+  dsa.indexer.proj =
+      Ref(GgmlType::kF32, hidden, w.config.indexer_heads, 1, "idx_proj");
+  dsa.indexer.comp_gate =
+      Ref(GgmlType::kF32, hidden, w.config.indexer_head_dim, 1, "idx_gate");
+  dsa.indexer.comp_ape = Ref(GgmlType::kF32, w.config.indexer_head_dim,
+                             w.config.indexer_kpool, 1, "idx_ape");
+  dsa.router = Ref(GgmlType::kF32, hidden, experts, 1, "router");
+  dsa.router_bias = Ref(GgmlType::kF32, experts, 1, 1, "router_bias");
+  dsa.gate_exps = Ref(GgmlType::kQ4_K, hidden, expert_ff, experts, "gate_exps");
+  dsa.up_exps = Ref(GgmlType::kQ4_K, hidden, expert_ff, experts, "up_exps");
+  dsa.down_exps = Ref(GgmlType::kQ4_K, expert_ff, hidden, experts, "down_exps");
+  dsa.gate_shexp = Ref(GgmlType::kQ8_0, hidden, expert_ff, 1, "gate_shexp");
+  dsa.up_shexp = Ref(GgmlType::kQ8_0, hidden, expert_ff, 1, "up_shexp");
+  dsa.down_shexp = Ref(GgmlType::kQ8_0, expert_ff, hidden, 1, "down_shexp");
+  return w;
+}
+
+const glm::distributed::PlannedTensor* Find(
+    const std::vector<glm::distributed::PlannedTensor>& plan,
+    const char* name) {
+  for (const auto& entry : plan) {
+    if (entry.tensor->name == name) {
+      return &entry;
+    }
+  }
+  return nullptr;
+}
+
+}  // namespace
+
+int main() {
+  std::string error;
+  auto weights = TwoLayerWeights();
+
+  const auto part0 = TpPartition::Create(weights.config, 0, 2, &error);
+  const auto part1 = TpPartition::Create(weights.config, 1, 2, &error);
+  Require(part0.has_value() && part1.has_value(), error);
+  Require(part0->head_begin == 0 && part0->head_count == 32, "rank 0 heads");
+  Require(part1->head_begin == 32 && part1->head_count == 32, "rank 1 heads");
+  Require(part0->KdaChannelBegin() == 0 && part0->KdaChannelCount() == 4096,
+          "rank 0 KDA channels");
+  Require(part1->KdaChannelBegin() == 4096, "rank 1 KDA channels");
+  Require(part0->expert_ff_begin == 0 && part0->expert_ff_count == 1024,
+          "rank 0 expert rows");
+  Require(part1->expert_ff_begin == 1024, "rank 1 expert rows");
+  Require(part0->dense_ff_count == 6144, "dense intermediate splits");
+
+  const auto single = TpPartition::Create(weights.config, 0, 1, &error);
+  Require(single.has_value(), error);
+
+  auto plan0 = PlanModelTensors(weights, *part0, &error);
+  auto plan1 = PlanModelTensors(weights, *part1, &error);
+  Require(plan0.has_value(), error);
+  Require(plan1.has_value(), error);
+  Require(plan0->size() == plan1->size(), "both ranks plan every tensor");
+
+  // Every split axis is covered exactly, disjointly, by the two ranks, and
+  // replicated tensors carry whole-tensor bytes.
+  std::size_t local0 = 0;
+  std::size_t local1 = 0;
+  for (std::size_t i = 0; i < plan0->size(); ++i) {
+    const auto& a = (*plan0)[i];
+    const auto& b = (*plan1)[i];
+    Require(a.tensor == b.tensor, "plans walk the same tensors in order");
+    const auto& span_a = a.span;
+    const auto& span_b = b.span;
+    local0 += span_a.local_bytes;
+    local1 += span_b.local_bytes;
+    Require(
+        span_a.kind == span_b.kind && span_a.per_expert == span_b.per_expert,
+        std::string(a.tensor->name) + ": ranks agree on the span kind");
+    const glm::TensorRef& t = *a.tensor;
+    switch (span_a.kind) {
+      case glm::distributed::TensorSpanKind::kFull:
+        Require(span_a.local_bytes == t.SizeBytes() &&
+                    span_b.local_bytes == t.SizeBytes(),
+                std::string(t.name) + ": replicated bytes");
+        break;
+      case glm::distributed::TensorSpanKind::kRows:
+      case glm::distributed::TensorSpanKind::kColumns:
+      case glm::distributed::TensorSpanKind::kStack:
+      case glm::distributed::TensorSpanKind::kElements:
+        Require(span_a.begin + span_a.count == span_b.begin,
+                std::string(t.name) + ": spans are adjacent");
+        Require(span_a.count == span_b.count,
+                std::string(t.name) + ": spans are equal");
+        Require(span_a.local_bytes == span_b.local_bytes,
+                std::string(t.name) + ": split bytes are equal");
+        break;
+    }
+  }
+
+  // The per-rank encoded total must equal the P0 ledger's per-rank bytes.
+  const auto ledger = PlanTpLedger(weights, 2, &error);
+  Require(ledger.has_value(), error);
+  Require(local0 == ledger->PerRankBytes(2),
+          "descriptor walk matches the TP ledger per-rank bytes");
+  Require(local0 == local1, "both ranks hold the same encoded bytes");
+
+  // The single-rank plan is the whole model.
+  const auto plan_single = PlanModelTensors(weights, *single, &error);
+  Require(plan_single.has_value(), error);
+  std::size_t single_bytes = 0;
+  for (const auto& entry : *plan_single) {
+    single_bytes += entry.span.local_bytes;
+    Require(entry.span.kind == glm::distributed::TensorSpanKind::kFull,
+            std::string(entry.tensor->name) + ": single rank holds all");
+  }
+  Require(single_bytes == ledger->FullArBytes(),
+          "single-rank plan covers the full AR bytes");
+
+  // Geometry spot checks on the axes the loader uploads.
+  using TK = glm::distributed::TensorSpanKind;
+  const auto* conv = Find(*plan0, "conv_q");
+  Require(conv != nullptr && conv->span.kind == TK::kRows &&
+              conv->span.begin == 0 && conv->span.count == 4096 &&
+              conv->span.local_bytes == 4096 * 4 * sizeof(float),
+          "KDA conv splits by channel rows");
+  const auto* dt = Find(*plan1, "dt");
+  Require(dt != nullptr && dt->span.kind == TK::kElements &&
+              dt->span.begin == 4096 && dt->span.count == 4096,
+          "KDA dt bias splits by channel elements");
+  const auto* beta = Find(*plan1, "beta");
+  Require(beta != nullptr && beta->span.kind == TK::kRows &&
+              beta->span.begin == 32 && beta->span.count == 32,
+          "KDA beta splits by head rows");
+  const auto* a_vec = Find(*plan0, "a");
+  Require(a_vec != nullptr && a_vec->span.kind == TK::kElements &&
+              a_vec->span.begin == 0 && a_vec->span.count == 32,
+          "KDA decay a splits by head elements");
+  const auto* q_b = Find(*plan1, "q_b");
+  Require(q_b != nullptr && q_b->span.kind == TK::kRows &&
+              q_b->span.begin == 32U * 256U && q_b->span.count == 32U * 256U,
+          "MLA q_b splits by head query rows");
+  const auto* k_b = Find(*plan0, "k_b");
+  Require(k_b != nullptr && k_b->span.kind == TK::kStack &&
+              k_b->span.begin == 0 && k_b->span.count == 32 &&
+              k_b->span.local_bytes == 256 * 512 * sizeof(float) * 32,
+          "k_b keeps whole head matrices");
+  const auto* gate = Find(*plan1, "gate_exps");
+  Require(gate != nullptr && gate->span.kind == TK::kRows &&
+              gate->span.per_expert && gate->span.begin == 1024 &&
+              gate->span.count == 1024,
+          "expert gate rows repeat inside every expert");
+  const auto* down = Find(*plan0, "down_exps");
+  // Q4_K: 1024 columns = 4 super-blocks of 144 bytes per row.
+  Require(down != nullptr && down->span.kind == TK::kColumns &&
+              down->span.per_expert && down->span.begin == 0 &&
+              down->span.count == 1024 &&
+              down->span.local_bytes ==
+                  static_cast<std::size_t>(4 * 144) * 4096 * 288,
+          "expert down columns halve on super-block boundaries");
+  const auto* idx = Find(*plan1, "idx_proj");
+  Require(idx != nullptr && idx->span.kind == TK::kFull,
+          "indexer tensors stay replicated");
+
+  // A split that would cut a quantization block is rejected: an expert
+  // intermediate of 384 gives 192 columns per rank (Q4_K needs 256).
+  auto bad = TwoLayerWeights();
+  bad.config.expert_ffn = 384;
+  bad.layers[1].gate_exps = Ref(GgmlType::kQ4_K, 4096, 384, 288, "gate_exps");
+  bad.layers[1].up_exps = Ref(GgmlType::kQ4_K, 4096, 384, 288, "up_exps");
+  bad.layers[1].down_exps = Ref(GgmlType::kQ4_K, 384, 4096, 288, "down_exps");
+  const auto bad_part = TpPartition::Create(bad.config, 0, 2, &error);
+  if (bad_part.has_value()) {
+    Require(!PlanModelTensors(bad, *bad_part, &error).has_value(),
+            "a split that cuts a quantization block is rejected");
+  }
+
+  // Odd heads are rejected at partition creation.
+  auto odd = TwoLayerWeights();
+  odd.config.head_count = 63;
+  Require(!TpPartition::Create(odd.config, 0, 2, &error).has_value(),
+          "an odd head count is rejected");
+
+  std::printf("PASS: glm5_next TP partition descriptors (per-rank %zu bytes)\n",
+              local0);
+  return 0;
+}
diff --git a/tests/models/glm5_next/tp_plan_test.cpp b/tests/models/glm5_next/tp_plan_test.cpp
new file mode 100644
index 00000000..cffdeeee
--- /dev/null
+++ b/tests/models/glm5_next/tp_plan_test.cpp
@@ -0,0 +1,235 @@
+#include "src/models/glm5_next/distributed/tp_plan.hpp"
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <optional>
+#include <string>
+
+namespace {
+
+using gufo::core::GgmlType;
+namespace glm = gufo::models::glm5_next;
+using glm::distributed::PlanTpLedger;
+
+void Require(bool condition, const char* message) {
+  if (!condition) {
+    std::fprintf(stderr, "FAIL: %s\n", message);
+    std::exit(1);
+  }
+}
+
+glm::TensorRef Ref(GgmlType type, std::uint64_t cols, std::uint64_t rows,
+                   std::uint64_t experts, const char* name) {
+  return glm::TensorRef{reinterpret_cast<const void*>(0x1000),
+                        type,
+                        cols,
+                        rows,
+                        experts,
+                        0,
+                        0,
+                        name};
+}
+
+glm::Config RealConfig() {
+  glm::Config c;
+  c.num_layers = 45;
+  c.nextn_layers = 1;
+  c.hidden_size = 4096;
+  c.vocab_size = 154880;
+  c.head_count = 64;
+  c.q_lora_rank = 1536;
+  c.kv_lora_rank = 512;
+  c.qk_nope_head_dim = 256;
+  c.v_head_dim = 256;
+  c.kda_head_dim = 128;
+  c.kda_conv_kernel = 4;
+  c.indexer_heads = 32;
+  c.indexer_head_dim = 128;
+  c.indexer_kpool = 4;
+  c.hc_count = 4;
+  c.dense_lead = 3;
+  c.dense_ffn = 12288;
+  c.expert_count = 288;
+  c.experts_used = 8;
+  c.shared_experts = 1;
+  c.expert_ffn = 2048;
+  c.dsa_layer.assign(45, false);
+  for (std::uint32_t i = 3; i < 45; i += 4)
+    c.dsa_layer[i] = true;
+  return c;
+}
+
+// One dense-KDA layer and one sparse-DSA layer with the artifact's real
+// dimensions and quantization, plus the global tensors.
+glm::ModelWeights TwoLayerWeights() {
+  glm::ModelWeights w;
+  w.config = RealConfig();
+  w.config.num_layers = 2;
+  w.config.nextn_layers = 0;
+  w.config.dense_lead = 1;
+  w.config.dsa_layer = {false, true};
+
+  const auto hidden = w.config.hidden_size;
+  const auto inner = w.config.KdaInnerDim();
+  const auto query = w.config.MlaQueryDim();
+  const auto head_dim = w.config.kda_head_dim;
+  const auto expert_ff = w.config.expert_ffn;
+  const auto experts = w.config.expert_count;
+
+  w.token_embd = Ref(GgmlType::kQ8_0, hidden, w.config.vocab_size, 1, "embd");
+  w.output = Ref(GgmlType::kQ8_0, hidden, w.config.vocab_size, 1, "output");
+  w.output_norm = Ref(GgmlType::kF32, hidden, 1, 1, "output_norm");
+  w.layers.resize(2);
+
+  glm::LayerWeights& kda = w.layers[0];
+  kda.linear = true;
+  kda.attn_norm = Ref(GgmlType::kF32, hidden, 1, 1, "attn_norm");
+  kda.ffn_norm = Ref(GgmlType::kF32, hidden, 1, 1, "ffn_norm");
+  kda.hc_attn.fn = Ref(GgmlType::kF32, w.config.HcDim(), w.config.HcMixDim(), 1,
+                       "hc_attn_fn");
+  kda.hc_attn.base =
+      Ref(GgmlType::kF32, w.config.HcMixDim(), 1, 1, "hc_attn_base");
+  kda.hc_attn.scale = Ref(GgmlType::kF32, 3, 1, 1, "hc_attn_scale");
+  kda.hc_ffn = kda.hc_attn;
+  kda.kda.q = Ref(GgmlType::kQ8_0, hidden, inner, 1, "kda_q");
+  kda.kda.k = Ref(GgmlType::kQ8_0, hidden, inner, 1, "kda_k");
+  kda.kda.v = Ref(GgmlType::kQ8_0, hidden, inner, 1, "kda_v");
+  kda.kda.out = Ref(GgmlType::kQ8_0, inner, hidden, 1, "kda_wo");
+  kda.kda.conv_q = Ref(GgmlType::kF32, 4, inner, 1, "conv_q");
+  kda.kda.conv_k = Ref(GgmlType::kF32, 4, inner, 1, "conv_k");
+  kda.kda.conv_v = Ref(GgmlType::kF32, 4, inner, 1, "conv_v");
+  kda.kda.f_a = Ref(GgmlType::kF32, hidden, head_dim, 1, "f_a");
+  kda.kda.f_b = Ref(GgmlType::kF32, head_dim, inner, 1, "f_b");
+  kda.kda.g_a = Ref(GgmlType::kF32, hidden, head_dim, 1, "g_a");
+  kda.kda.g_b = Ref(GgmlType::kF32, head_dim, inner, 1, "g_b");
+  kda.kda.beta = Ref(GgmlType::kF32, hidden, 64, 1, "beta");
+  kda.kda.a = Ref(GgmlType::kF32, 64, 1, 1, "a");
+  kda.kda.dt_bias = Ref(GgmlType::kF32, inner, 1, 1, "dt");
+  kda.kda.o_norm = Ref(GgmlType::kF32, head_dim, 1, 1, "o_norm");
+  kda.dense_ffn = true;
+  kda.ffn_gate =
+      Ref(GgmlType::kQ8_0, hidden, w.config.dense_ffn, 1, "ffn_gate");
+  kda.ffn_up = Ref(GgmlType::kQ8_0, hidden, w.config.dense_ffn, 1, "ffn_up");
+  kda.ffn_down =
+      Ref(GgmlType::kQ8_0, w.config.dense_ffn, hidden, 1, "ffn_down");
+
+  glm::LayerWeights& dsa = w.layers[1];
+  dsa.linear = false;
+  dsa.attn_norm = Ref(GgmlType::kF32, hidden, 1, 1, "attn_norm");
+  dsa.ffn_norm = Ref(GgmlType::kF32, hidden, 1, 1, "ffn_norm");
+  dsa.hc_attn = kda.hc_attn;
+  dsa.hc_ffn = kda.hc_ffn;
+  dsa.dsa.q_a = Ref(GgmlType::kQ8_0, hidden, w.config.q_lora_rank, 1, "q_a");
+  dsa.dsa.q_a_norm =
+      Ref(GgmlType::kF32, w.config.q_lora_rank, 1, 1, "q_a_norm");
+  dsa.dsa.q_b = Ref(GgmlType::kQ8_0, w.config.q_lora_rank, query, 1, "q_b");
+  dsa.dsa.kv_a = Ref(GgmlType::kF32, hidden, w.config.kv_lora_rank, 1, "kv_a");
+  dsa.dsa.kv_a_norm =
+      Ref(GgmlType::kF32, w.config.kv_lora_rank, 1, 1, "kv_a_norm");
+  dsa.dsa.k_b = Ref(GgmlType::kF32, w.config.qk_nope_head_dim,
+                    w.config.kv_lora_rank, 64, "k_b");
+  dsa.dsa.v_b = Ref(GgmlType::kF32, w.config.kv_lora_rank, w.config.v_head_dim,
+                    64, "v_b");
+  dsa.dsa.out = Ref(GgmlType::kQ8_0, query, hidden, 1, "wo");
+  dsa.indexer.q_b = Ref(GgmlType::kF32, w.config.q_lora_rank,
+                        w.config.IndexerQueryDim(), 1, "idx_q");
+  dsa.indexer.k =
+      Ref(GgmlType::kF32, hidden, w.config.indexer_head_dim, 1, "idx_k");
+  dsa.indexer.k_norm =
+      Ref(GgmlType::kF32, w.config.indexer_head_dim, 1, 1, "idx_k_norm");
+  dsa.indexer.k_norm_bias =
+      Ref(GgmlType::kF32, w.config.indexer_head_dim, 1, 1, "idx_k_norm_b");
+  dsa.indexer.proj =
+      Ref(GgmlType::kF32, hidden, w.config.indexer_heads, 1, "idx_proj");
+  dsa.indexer.comp_gate =
+      Ref(GgmlType::kF32, hidden, w.config.indexer_head_dim, 1, "idx_gate");
+  dsa.indexer.comp_ape = Ref(GgmlType::kF32, w.config.indexer_head_dim,
+                             w.config.indexer_kpool, 1, "idx_ape");
+  dsa.router = Ref(GgmlType::kF32, hidden, experts, 1, "router");
+  dsa.router_bias = Ref(GgmlType::kF32, experts, 1, 1, "router_bias");
+  dsa.gate_exps = Ref(GgmlType::kQ4_K, hidden, expert_ff, experts, "gate_exps");
+  dsa.up_exps = Ref(GgmlType::kQ4_K, hidden, expert_ff, experts, "up_exps");
+  dsa.down_exps = Ref(GgmlType::kQ4_K, expert_ff, hidden, experts, "down_exps");
+  dsa.gate_shexp = Ref(GgmlType::kQ8_0, hidden, expert_ff, 1, "gate_shexp");
+  dsa.up_shexp = Ref(GgmlType::kQ8_0, hidden, expert_ff, 1, "up_shexp");
+  dsa.down_shexp = Ref(GgmlType::kQ8_0, expert_ff, hidden, 1, "down_shexp");
+  return w;
+}
+
+}  // namespace
+
+int main() {
+  std::string error;
+  auto weights = TwoLayerWeights();
+
+  const auto single = PlanTpLedger(weights, 1, &error);
+  Require(single.has_value(), error.c_str());
+  Require(single->PerRankBytes(1) == single->FullArBytes(),
+          "one rank holds every AR byte");
+  Require(single->excluded_bytes == 0, "no nextn in this fixture");
+
+  const auto split = PlanTpLedger(weights, 2, &error);
+  Require(split.has_value(), error.c_str());
+  Require(split->PerRankBytes(2) ==
+              split->replicated_bytes +
+                  (split->row_split_bytes + split->col_split_bytes +
+                   split->head_split_bytes) /
+                      2,
+          "per-rank bytes are replicated plus half of every split");
+
+  // Byte math on one Q4_K expert family: 2048-wide gate/up rows and a
+  // 2048 -> 4096 down, 288 experts, halved for two ranks.
+  const std::size_t q4_row_4096 = 4096 / 256 * 144;
+  const std::size_t q4_row_2048 = 2048 / 256 * 144;
+  const std::size_t exps_full =
+      (2 * q4_row_4096 * 2048 + q4_row_2048 * 4096) * 288;
+  Require(weights.layers[1].gate_exps.SizeBytes() +
+                  weights.layers[1].up_exps.SizeBytes() +
+                  weights.layers[1].down_exps.SizeBytes() ==
+              exps_full,
+          "Q4_K expert family bytes");
+  Require(split->col_split_bytes >= q4_row_2048 / 2 * 2 * 4096 * 288 / 288,
+          "down columns halve on super-block boundaries");
+
+  // A Q4_K down whose share would cut a 256-value super-block: 384 / 2 =
+  // 192 columns per rank is not a whole number of super-blocks.
+  auto bad = TwoLayerWeights();
+  bad.config.expert_ffn = 384;
+  bad.layers[1].gate_exps = Ref(GgmlType::kQ4_K, 4096, 384, 288, "gate_exps");
+  bad.layers[1].up_exps = Ref(GgmlType::kQ4_K, 4096, 384, 288, "up_exps");
+  bad.layers[1].down_exps = Ref(GgmlType::kQ4_K, 384, 4096, 288, "down_exps");
+  Require(!PlanTpLedger(bad, 2, &error).has_value(),
+          "a split that cuts a quantization block is rejected");
+
+  // An odd head count cannot halve.
+  auto odd = TwoLayerWeights();
+  odd.config.head_count = 63;
+  Require(!PlanTpLedger(odd, 2, &error).has_value(),
+          "an odd head count is rejected");
+
+  // The nextn block is excluded wholesale.
+  auto with_nextn = TwoLayerWeights();
+  with_nextn.config.nextn_layers = 1;
+  glm::NextnWeights nextn;
+  nextn.eh_proj = Ref(GgmlType::kQ8_0, 2 * with_nextn.config.hidden_size,
+                      with_nextn.config.hidden_size, 1, "eh_proj");
+  nextn.enorm =
+      Ref(GgmlType::kF32, with_nextn.config.hidden_size, 1, 1, "enorm");
+  nextn.hnorm = nextn.enorm;
+  nextn.shared_head_norm = nextn.enorm;
+  nextn.block = with_nextn.layers[1];  // a DSA layer
+  with_nextn.nextn = nextn;
+  const auto ledger = PlanTpLedger(with_nextn, 2, &error);
+  Require(ledger.has_value(), error.c_str());
+  Require(ledger->excluded_bytes > nextn.eh_proj.SizeBytes(),
+          "the whole nextn block lands in the excluded bucket");
+  Require(ledger->FullArBytes() == split->FullArBytes(),
+          "AR bytes ignore the nextn block");
+
+  Require(!PlanTpLedger(weights, 3, &error).has_value(),
+          "world size above two is rejected");
+
+  std::puts("PASS: glm5_next TP plan ledger and split boundaries");
+  return 0;
+}
diff --git a/tests/models/glm5_next/tp_probe.cpp b/tests/models/glm5_next/tp_probe.cpp
new file mode 100644
index 00000000..6aa95bf8
--- /dev/null
+++ b/tests/models/glm5_next/tp_probe.cpp
@@ -0,0 +1,608 @@
+// P3.4: two-rank tokenwise TP over tbstream — the lockstep probe.
+//
+//   rank 0 (host A): glm5_next_tp_probe --model FIRST_SHARD.gguf --tp-rank 0
+//                        [--oracle-dir DIR] [--decode N] [--trace-blocks]
+//   rank 1 (host B): glm5_next_tp_probe --model ... --tp-rank 1
+//                        --tp-bootstrap-host HOST_A
+//
+// Both ranks load the full trunk with their TP partition, meet at a
+// zero-byte exchange, then run the same fixed-token prompts from the CPU
+// oracle corpus (token ids parsed from its position lines, so no tokenizer
+// is involved): Paris (5 tokens + N greedy continuation), a text prompt
+// and a code prompt. Every sub-block partial is summed across ranks before
+// its mHC combine; the block observer hashes each summed output so diffing
+// the two rank logs finds the first diverging operator. With --oracle-dir
+// (normally rank 0, which holds the evidence tree) each token's logits are
+// also compared against the CPU oracle rows: rel RMS and top-1.
+//
+// Rank agreement is judged by diffing the two logs' hash/token lines.
+#include <hip/hip_runtime.h>
+
+#include <algorithm>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <map>
+#include <memory>
+#include <sstream>
+#include <string>
+#include <tuple>
+#include <vector>
+
+#include "src/core/gguf_reader.hpp"
+#include "src/models/glm5_next/distributed/tp_partition.hpp"
+#include "src/models/glm5_next/kernels/rocm/device_model.hpp"
+#include "src/models/glm5_next/kernels/rocm/executor.hpp"
+#include "src/models/glm5_next/kernels/rocm/kernels.hpp"
+#include "src/models/glm5_next/weights.hpp"
+#include "src/models/qwen38_flash_next/kernels/rocm/tbstream.hpp"
+
+namespace glm = gufo::models::glm5_next;
+namespace rocm = glm::rocm;
+namespace qrocm = gufo::models::qwen38_flash_next::rocm;
+
+namespace {
+
+int failures = 0;
+
+void Fail(const std::string& message) {
+  std::fprintf(stderr, "FAIL: %s\n", message.c_str());
+  ++failures;
+}
+
+void Say(const std::string& line) {
+  std::printf("[glm-tp %s]\n", line.c_str());
+  std::fflush(stdout);
+}
+
+/// FNV-1a over raw bytes.
+std::uint64_t Hash(const void* data, std::size_t bytes) {
+  const auto* p = static_cast<const std::uint8_t*>(data);
+  std::uint64_t h = 1469598103934665603ULL;
+  for (std::size_t i = 0; i < bytes; ++i) {
+    h ^= p[i];
+    h *= 1099511628211ULL;
+  }
+  return h;
+}
+
+struct Prompt {
+  std::string name;
+  std::vector<std::int32_t> tokens;
+  std::vector<std::int32_t> generated;  // oracle continuation, if any
+};
+
+/// Parses "pos N token ID ..." lines from a reference-probe log.
+std::vector<std::int32_t> ParsePositionTokens(const std::string& path) {
+  std::vector<std::int32_t> tokens;
+  std::ifstream in(path);
+  std::string line;
+  while (std::getline(in, line)) {
+    if (line.rfind("pos ", 0) != 0) {
+      continue;
+    }
+    std::istringstream fields(line);
+    std::string pos_word;
+    std::uint32_t pos = 0;
+    std::string token_word;
+    std::int32_t id = 0;
+    fields >> pos_word >> pos >> token_word >> id;
+    if (fields) {
+      if (tokens.size() != pos) {
+        return {};
+      }
+      tokens.push_back(id);
+    }
+  }
+  return tokens;
+}
+
+std::vector<float> ReadLogitsRow(std::ifstream& file, std::uint32_t vocab,
+                                 std::size_t row) {
+  std::vector<float> data(vocab);
+  file.seekg(static_cast<std::streamoff>(row) * vocab * sizeof(float));
+  file.read(reinterpret_cast<char*>(data.data()),
+            static_cast<std::streamsize>(vocab) * sizeof(float));
+  if (!file) {
+    data.clear();
+  }
+  return data;
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+  std::string model_path;
+  std::string oracle_dir;
+  std::string bootstrap_host;
+  std::uint32_t rank = 0;
+  std::uint16_t bootstrap_port = 18515;
+  std::string tbstream_dev = "/dev/tbstream0";
+  std::uint32_t decode = 8;
+  std::uint32_t lcg_tokens = 0;
+  // 0 = tokenwise Step for every position; >0 = chunked batched prefill
+  // over each prompt with this executor chunk width (decode continuations
+  // stay tokenwise).
+  std::uint32_t prefill_chunk = 0;
+  // Second pass per prompt: rerun tokenwise and batched from a reset
+  // session and require byte-equal final logits + state hashes.
+  bool prefill_compare = false;
+  bool trace_blocks = true;
+  for (int i = 1; i < argc; ++i) {
+    const std::string arg = argv[i];
+    auto next = [&]() -> std::string {
+      return i + 1 < argc ? argv[++i] : std::string();
+    };
+    if (arg == "--model") {
+      model_path = next();
+    } else if (arg == "--oracle-dir") {
+      oracle_dir = next();
+    } else if (arg == "--tp-rank") {
+      rank = static_cast<std::uint32_t>(std::atoi(next().c_str()));
+    } else if (arg == "--tp-bootstrap-host") {
+      bootstrap_host = next();
+    } else if (arg == "--tp-bootstrap-port") {
+      bootstrap_port = static_cast<std::uint16_t>(std::atoi(next().c_str()));
+    } else if (arg == "--tp-tbstream-dev") {
+      tbstream_dev = next();
+    } else if (arg == "--decode") {
+      decode = static_cast<std::uint32_t>(std::atoi(next().c_str()));
+    } else if (arg == "--prefill") {
+      prefill_chunk = static_cast<std::uint32_t>(std::atoi(next().c_str()));
+    } else if (arg == "--prefill-compare") {
+      prefill_compare = true;
+    } else if (arg == "--lcg-tokens") {
+      lcg_tokens = static_cast<std::uint32_t>(std::atoi(next().c_str()));
+    } else if (arg == "--no-trace-blocks") {
+      trace_blocks = false;
+    } else {
+      std::fprintf(stderr, "unknown argument %s\n", arg.c_str());
+      return 2;
+    }
+  }
+  if (model_path.empty() || rank > 1) {
+    std::fprintf(stderr, "--model and --tp-rank 0|1 are required\n");
+    return 2;
+  }
+
+  std::string error;
+  qrocm::TbstreamConfig config;
+  config.rank = rank;
+  config.world_size = 2;
+  config.bootstrap_host = bootstrap_host;
+  config.bootstrap_port = bootstrap_port;
+  config.device_path = tbstream_dev;
+  auto communicator = qrocm::CreateTbstreamCommunicator(config, &error);
+  if (!communicator) {
+    Fail("transport: " + error);
+    return 1;
+  }
+  Say("transport up: " + communicator->Describe());
+  constexpr std::uint64_t kScope = 0x474C4D54ULL;  // "GLMT"
+  if (!communicator->BeginOperation(kScope, &error)) {
+    Fail("scope: " + error);
+    return 1;
+  }
+
+  auto reader = gufo::core::GgufReader::OpenFile(model_path, &error);
+  if (!reader) {
+    Fail("open: " + error);
+    return 1;
+  }
+  auto weights = glm::ModelWeights::Bind(*reader, &error);
+  if (!weights) {
+    Fail("bind: " + error);
+    return 1;
+  }
+  auto partition =
+      glm::distributed::TpPartition::Create(weights->config, rank, 2, &error);
+  if (!partition) {
+    Fail("partition: " + error);
+    return 1;
+  }
+  std::uint64_t free_before = 0;
+  std::uint64_t total_mem = 0;
+  (void)hipMemGetInfo(&free_before, &total_mem);
+  const auto probe_start = std::chrono::steady_clock::now();
+  const auto load_start = probe_start;
+  auto slice = rocm::DeviceSlice::Upload(
+      *weights, *reader, weights->config.num_layers, &*partition, &error);
+  if (!slice) {
+    Fail("upload: " + error);
+    return 1;
+  }
+  const auto load_ms = std::chrono::duration<double, std::milli>(
+                           std::chrono::steady_clock::now() - load_start)
+                           .count();
+  std::uint64_t free_after = 0;
+  (void)hipMemGetInfo(&free_after, &total_mem);
+  Say("loaded rank " + std::to_string(rank) + ": " +
+      std::to_string(slice->tensor_count()) + " tensors, " +
+      std::to_string(slice->encoded_bytes() >> 20) + " MiB encoded, " +
+      std::to_string(static_cast<long>(load_ms)) + " ms, hip free " +
+      std::to_string(free_after >> 30) + " GiB");
+
+  const std::uint32_t hidden = weights->config.hidden_size;
+  // Coarse exchange-cost census (diagnostic; the wall-clock split of the
+  // lockstep all-reduce: total ExchangePartial time vs peer-add enqueue).
+  std::chrono::steady_clock::duration exchange_total{0};
+  std::uint64_t exchange_count = 0;
+  std::uint64_t exchange_bytes = 0;
+  rocm::Executor::Options options;
+  std::uint64_t block_hash = 0;
+  options.all_reduce = [&](float* data, std::uint32_t rows, hipStream_t stream,
+                           std::string* err) -> bool {
+    const std::size_t bytes =
+        static_cast<std::size_t>(rows) * hidden * sizeof(float);
+    const auto exchange_start = std::chrono::steady_clock::now();
+    qrocm::TbstreamWire wire = qrocm::TbstreamWire::kF32;
+    const float* peer =
+        communicator->ExchangePartial(data, bytes, &wire, stream, err);
+    exchange_total += std::chrono::steady_clock::now() - exchange_start;
+    ++exchange_count;
+    exchange_bytes += bytes;
+    if (peer == nullptr) {
+      return false;
+    }
+    if (wire != qrocm::TbstreamWire::kF32) {
+      if (err != nullptr) {
+        *err = "glm tp probe requires the f32 wire";
+      }
+      return false;
+    }
+    rocm::AddInto(data, peer, bytes / sizeof(float), stream);
+    return true;
+  };
+  std::vector<float> block_row(hidden);
+  // Per (layer, sub-block, first-token) first-row hashes, so a compare
+  // pass can name the first diverging sub-block output.
+  bool capture_blocks = false;
+  std::map<std::tuple<std::uint32_t, int, std::uint32_t>, std::uint64_t>
+      block_map;
+  options.block_observer = [&](std::uint32_t layer, int sub,
+                               std::uint32_t first_token, std::uint32_t rows,
+                               const float* device, hipStream_t stream) {
+    if (!trace_blocks) {
+      return;
+    }
+    (void)rows;
+    if (hipMemcpyAsync(block_row.data(), device,
+                       block_row.size() * sizeof(float), hipMemcpyDeviceToHost,
+                       stream) != hipSuccess ||
+        hipStreamSynchronize(stream) != hipSuccess) {
+      return;
+    }
+    const std::uint64_t row_hash =
+        Hash(block_row.data(), block_row.size() * sizeof(float)) ^
+        (layer * 131 + sub);
+    block_hash = row_hash ^ (block_hash << 1);
+    if (capture_blocks) {
+      block_map[{layer, sub, first_token}] = row_hash;
+    }
+  };
+  options.prefill_chunk = prefill_chunk;
+  auto executor = rocm::Executor::Create(std::move(slice), options, &error);
+  if (!executor) {
+    Fail("executor: " + error);
+    return 1;
+  }
+  // The LCG mode needs room for the prompt plus the decode tail.
+  const std::uint32_t lcg_count = lcg_tokens != 0 ? lcg_tokens : 32;
+  const std::uint32_t capacity =
+      lcg_tokens != 0 ? lcg_count + decode + 1 : 4096;
+  auto session = executor->CreateSession(capacity, &error);
+  if (!session) {
+    Fail("session: " + error);
+    return 1;
+  }
+  const glm::Config& c = executor->config();
+
+  // Load-ready rendezvous: a zero-byte exchange once both ranks resident.
+  {
+    float dummy = 0.0F;
+    qrocm::TbstreamWire wire = qrocm::TbstreamWire::kF32;
+    if (communicator->ExchangePartial(&dummy, 0, &wire, nullptr, &error) ==
+        nullptr) {
+      Fail("rendezvous: " + error);
+      return 1;
+    }
+    Say("rendezvous complete");
+  }
+
+  std::vector<Prompt> prompts;
+  if (!oracle_dir.empty()) {
+    for (const char* name : {"paris", "text", "code"}) {
+      Prompt p;
+      p.name = name;
+      p.tokens = ParsePositionTokens(oracle_dir + "/" + name + ".out");
+      if (p.tokens.empty()) {
+        Fail("no oracle tokens for " + p.name);
+      }
+      prompts.push_back(std::move(p));
+    }
+    Prompt cont;
+    cont.name = "cont-paris";
+    cont.tokens = ParsePositionTokens(oracle_dir + "/paris.out");
+    cont.generated = ParsePositionTokens(oracle_dir + "/cont-paris.out");
+    // The continuation log contains all positions (prompt + generated);
+    // keep only the generated ids.
+    if (cont.generated.size() > cont.tokens.size()) {
+      cont.generated.erase(cont.generated.begin(),
+                           cont.generated.begin() +
+                               static_cast<std::ptrdiff_t>(cont.tokens.size()));
+    }
+    prompts.push_back(std::move(cont));
+  } else {
+    // Deterministic LCG prompts when no oracle dir is given: the ranks
+    // still exercise the full path and agreement. `--lcg-tokens N` makes
+    // the prompt long enough to hit the batched chunk boundaries at full
+    // model depth.
+    Prompt p;
+    p.name = "lcg";
+    const std::uint32_t lcg_count = lcg_tokens != 0 ? lcg_tokens : 32;
+    std::uint64_t state = 7;
+    for (std::uint32_t i = 0; i < lcg_count; ++i) {
+      state = state * 1664525ULL + 1013904223ULL;
+      p.tokens.push_back(
+          static_cast<std::int32_t>(1000 + (state >> 33) % 99000U));
+    }
+    prompts.push_back(std::move(p));
+  }
+  if (failures != 0) {
+    return 1;
+  }
+
+  for (const Prompt& prompt : prompts) {
+    session->Reset();
+    block_hash = 0;
+    Say("prompt " + prompt.name + ": " + std::to_string(prompt.tokens.size()) +
+        " tokens");
+    std::ifstream oracle_rows;
+    if (!oracle_dir.empty()) {
+      oracle_rows.open(oracle_dir + "/" + prompt.name + ".logits.bin",
+                       std::ios::binary);
+      if (prompt.name == "cont-paris" && oracle_rows) {
+        // cont-paris shares paris's prompt rows; its own file holds all.
+      }
+    }
+    double worst = 0.0;
+    std::vector<float> logits(c.vocab_size);
+    std::vector<std::int32_t> chosen;
+    const std::size_t total =
+        prompt.tokens.size() +
+        (prompt.name == "cont-paris" ? prompt.generated.size() : 0);
+    auto verify_row = [&](std::size_t t) {
+      const auto top = static_cast<std::int32_t>(
+          std::max_element(logits.begin(), logits.end()) - logits.begin());
+      const double rms = [&] {
+        if (!oracle_rows) {
+          return -1.0;
+        }
+        const std::vector<float> fix =
+            ReadLogitsRow(oracle_rows, c.vocab_size, t);
+        if (fix.empty()) {
+          return -1.0;
+        }
+        bool finite = true;
+        double se = 0.0;
+        double ss = 0.0;
+        for (std::uint32_t i = 0; i < c.vocab_size; ++i) {
+          if (!std::isfinite(logits[i]) || !std::isfinite(fix[i])) {
+            finite = false;
+            break;
+          }
+          const double d = static_cast<double>(logits[i]) - fix[i];
+          se += d * d;
+          ss += static_cast<double>(fix[i]) * fix[i];
+        }
+        const auto fix_top = static_cast<std::int32_t>(
+            std::max_element(fix.begin(), fix.end()) - fix.begin());
+        if (fix_top != top) {
+          Fail(prompt.name + " t" + std::to_string(t) + " top-1 mismatch: " +
+               std::to_string(top) + " vs " + std::to_string(fix_top));
+        }
+        if (!finite) {
+          Fail(prompt.name + " t" + std::to_string(t) + " non-finite logits");
+        }
+        return ss > 0.0 ? std::sqrt(se / ss) : 0.0;
+      }();
+      worst = std::max(worst, rms < 0.0 ? 0.0 : rms);
+      if (rms > 2e-4) {
+        Fail(prompt.name + " t" + std::to_string(t) + " rel_rms " +
+             std::to_string(rms));
+      }
+      char line[256];
+      std::snprintf(line, sizeof(line),
+                    "t=%03zu ms=%.0f top=%d h=%016llx bh=%016llx rms=%.3e", t,
+                    std::chrono::duration<double, std::milli>(
+                        std::chrono::steady_clock::now() - probe_start)
+                        .count(),
+                    top,
+                    static_cast<unsigned long long>(Hash(
+                        logits.data(), static_cast<std::size_t>(c.vocab_size) *
+                                           sizeof(float))),
+                    static_cast<unsigned long long>(block_hash), rms);
+      Say(line);
+    };
+    std::size_t t = 0;
+    if (prefill_chunk != 0 && !prompt.tokens.empty()) {
+      const auto prefill_start = std::chrono::steady_clock::now();
+      if (!executor->Prefill(*session, prompt.tokens, logits.data(), &error)) {
+        Fail("prefill: " + error);
+      } else {
+        const double prefill_ms =
+            std::chrono::duration<double, std::milli>(
+                std::chrono::steady_clock::now() - prefill_start)
+                .count();
+        Say("prefill " + prompt.name + ": " +
+            std::to_string(prompt.tokens.size()) + " tokens in " +
+            std::to_string(prefill_ms) + " ms");
+        verify_row(prompt.tokens.size() - 1);
+        chosen.push_back(static_cast<std::int32_t>(
+            std::max_element(logits.begin(), logits.end()) - logits.begin()));
+      }
+      t = prompt.tokens.size();
+    }
+    for (; t < total && failures == 0; ++t) {
+      const std::int32_t token =
+          t < prompt.tokens.size() ? prompt.tokens[t] : chosen.back();
+      if (!executor->Step(*session, token, logits.data(), &error)) {
+        Fail("step: " + error);
+        break;
+      }
+      verify_row(t);
+      if (t + 1 >= prompt.tokens.size()) {
+        chosen.push_back(static_cast<std::int32_t>(
+            std::max_element(logits.begin(), logits.end()) - logits.begin()));
+      }
+    }
+    if (!prompt.generated.empty()) {
+      for (std::size_t i = 0; i < prompt.generated.size(); ++i) {
+        if (i >= chosen.size()) {
+          Fail(prompt.name + " continuation ended early");
+          break;
+        }
+        if (chosen[i] != prompt.generated[i]) {
+          Fail(prompt.name + " continuation token " + std::to_string(i) + ": " +
+               std::to_string(chosen[i]) + " vs oracle " +
+               std::to_string(prompt.generated[i]));
+        }
+      }
+    }
+    // Greedy decode tail after the prompt (and any oracle continuation):
+    // exercises decode over the prefill-ed caches and gives per-step logit
+    // hashes the ranks can agree on.
+    for (std::size_t g = 0; g < decode && failures == 0; ++g) {
+      if (chosen.empty()) {
+        break;
+      }
+      if (!executor->Step(*session, chosen.back(), logits.data(), &error)) {
+        Fail("decode step: " + error);
+        break;
+      }
+      verify_row(total + g);
+      chosen.push_back(static_cast<std::int32_t>(
+          std::max_element(logits.begin(), logits.end()) - logits.begin()));
+    }
+    if (prefill_compare && !prompt.tokens.empty() && failures == 0) {
+      struct CompareSide {
+        std::vector<float> final_logits;
+        std::uint64_t state{0};
+        std::vector<std::int32_t> picks;
+        std::vector<std::uint64_t> step_hashes;
+        std::map<std::tuple<std::uint32_t, int, std::uint32_t>, std::uint64_t>
+            blocks;
+      };
+      CompareSide tw;
+      CompareSide bt;
+      auto attach_blocks = [&](CompareSide* side) {
+        std::map<std::tuple<std::uint32_t, int, std::uint32_t>, std::uint64_t>
+            taken;
+        taken.swap(block_map);
+        side->blocks = std::move(taken);
+      };
+      auto pick = [&]() {
+        return static_cast<std::int32_t>(
+            std::max_element(logits.begin(), logits.end()) - logits.begin());
+      };
+      auto step_argmax = [&](std::int32_t token) {
+        if (!executor->Step(*session, token, logits.data(), &error)) {
+          Fail("compare step: " + error);
+          return false;
+        }
+        return true;
+      };
+      const auto run_side = [&](bool batched, CompareSide* side) {
+        session->Reset();
+        capture_blocks = true;
+        std::size_t t2 = 0;
+        if (batched) {
+          if (!executor->Prefill(*session, prompt.tokens, logits.data(),
+                                 &error)) {
+            Fail("compare prefill: " + error);
+            return;
+          }
+          t2 = prompt.tokens.size();
+        } else {
+          for (; t2 < prompt.tokens.size(); ++t2) {
+            if (!step_argmax(prompt.tokens[t2])) {
+              return;
+            }
+          }
+        }
+        side->final_logits = logits;
+        side->picks.push_back(pick());
+        for (std::size_t g = 1; g <= decode; ++g) {
+          if (!step_argmax(side->picks.back())) {
+            return;
+          }
+          side->picks.push_back(pick());
+          side->step_hashes.push_back(
+              Hash(logits.data(),
+                   static_cast<std::size_t>(c.vocab_size) * sizeof(float)));
+        }
+        if (!executor->HashState(*session, &side->state, &error)) {
+          Fail("compare hash: " + error);
+          return;
+        }
+        capture_blocks = false;
+        attach_blocks(side);
+      };
+      run_side(false, &tw);
+      run_side(true, &bt);
+      const bool same =
+          tw.final_logits == bt.final_logits && tw.picks == bt.picks &&
+          tw.step_hashes == bt.step_hashes && tw.state == bt.state;
+      if (!same) {
+        // Name the first diverging sub-block between the two passes.
+        bool named = false;
+        for (const auto& entry : bt.blocks) {
+          auto it = tw.blocks.find(entry.first);
+          if (it == tw.blocks.end() || it->second == entry.second) {
+            continue;
+          }
+          Say("first diverging block: layer=" +
+              std::to_string(std::get<0>(entry.first)) +
+              " sub=" + std::to_string(std::get<1>(entry.first)) +
+              " token=" + std::to_string(std::get<2>(entry.first)));
+          named = true;
+          break;
+        }
+        if (!named) {
+          Say("first diverging block: none within captured rows");
+        }
+      }
+      Say("compare " + prompt.name + ": tw=" + std::to_string(tw.state) +
+          " batch=" + std::to_string(bt.state) +
+          (same ? " MATCH" : " MISMATCH"));
+      if (!same) {
+        Fail("prefill compare mismatch: " + prompt.name);
+      }
+    }
+    Say("prompt " + prompt.name + " done: worst rel_rms " +
+        std::to_string(worst));
+    if (failures != 0) {
+      break;
+    }
+  }
+
+  (void)communicator->EndOperation(kScope, &error);
+  {
+    const double ms =
+        std::chrono::duration<double, std::milli>(exchange_total).count();
+    std::printf(
+        "[glm-tp exchanges: %llu totalling %.1f ms (%.1f ms each, %.2f GiB)]\n",
+        static_cast<unsigned long long>(exchange_count), ms,
+        exchange_count != 0 ? ms / exchange_count : 0.0,
+        static_cast<double>(exchange_bytes) / (1024.0 * 1024.0 * 1024.0));
+    std::fflush(stdout);
+  }
+  if (failures != 0) {
+    return 1;
+  }
+  Say("PASS: glm5_next tp probe rank " + std::to_string(rank));
+  return 0;
+}
