+/// Wire representation of a tbstream exchange payload. f32 is the original
+/// byte-for-byte form; f16 and q8 trade precision for link bytes (2x and
+/// ~3.76x respectively) on large frames. Both ranks must agree, which the
+/// tbstream bootstrap handshake enforces.
+enum class TbstreamWire : std::uint8_t {
+  kF32 = 0,
+  kF16 = 1,
+  kQ8 = 2,
+};
+
+/// Bytes the wire carries for an f32 payload of `fp32_bytes` elements-bytes
+/// in `wire`. q8 packs per-32-element blocks: an fp16 scale array first
+/// (16-byte aligned) then the int8 data. Pure function: both ranks derive
+/// frame sizes from the same inputs.
+[[nodiscard]] constexpr std::size_t TbstreamWireBytes(
+    std::size_t fp32_bytes, TbstreamWire wire) noexcept {
+  const std::size_t count = fp32_bytes / sizeof(float);
+  switch (wire) {
+    case TbstreamWire::kF32:
+      return fp32_bytes;
+    case TbstreamWire::kF16:
+      return count * sizeof(std::uint16_t);
+    case TbstreamWire::kQ8: {
+      const std::size_t scales = ((count + 31) / 32) * sizeof(std::uint16_t);
+      const std::size_t aligned = (scales + 15) & ~std::size_t{15};
+      return aligned + count;
+    }
+  }
+  return fp32_bytes;
+}
+
+/// Offset of the int8 data inside a q8 payload (the aligned scales array
+/// precedes it). Only valid for q8 payloads.
+[[nodiscard]] constexpr std::size_t TbstreamQ8DataOffset(
+    std::size_t fp32_bytes) noexcept {
+  const std::size_t count = fp32_bytes / sizeof(float);
+  const std::size_t scales = ((count + 31) / 32) * sizeof(std::uint16_t);
+  return (scales + 15) & ~std::size_t{15};
+}
