+      fixtures_dir = next();
+    } else if (arg == "--prefix") {
+      prefix = next();
+    } else if (arg == "--trace-name") {
+      trace_name = next();
+    } else if (arg == "--tokens") {
+      tokens_arg = next();
+    } else if (arg == "--random-tokens") {
