+/*
+ * Rotate DMA ring HopIDs across sessions. Empirically, reusing the
+ * same HopID immediately after a heavy session raises the probability
+ * of the NHI control-plane wedge on teardown dramatically (with the
+ * stock lowest-free allocator, re-attach after a self-heal event
+ * wedged near-deterministically; with rotation, ~25% per restart).
+ * Rotation is a mitigation, not a cure — the wedge trigger is
+ * cable-end correlated (see docs/wedge-investigation.md).
+ */
+#define TBSTREAM_HOP_ROT_MIN	10
+#define TBSTREAM_HOP_ROT_MAX	31
+
+static atomic_t tbstream_hop_seq = ATOMIC_INIT(0);
+
+static struct tb_ring *tbstream_alloc_ring(struct tb_nhi *nhi, bool is_tx,
+					   unsigned int size, unsigned int flags,
+					   int e2e_tx_hop, u16 sof_mask,
+					   u16 eof_mask)
+{
+	struct tb_ring *ring;
+	int i, hop, hop_max;
+
+	/* Clamp to the NHI's actual HopID space: v2 hosts reject ring
+	 * HopIDs >= hop_count ("invalid hop"). */
+	hop_max = min_t(int, TBSTREAM_HOP_ROT_MAX, (int)nhi->hop_count - 1);
+
+	for (i = 0; i < hop_max - TBSTREAM_HOP_ROT_MIN + 1; i++) {
+		unsigned int seq = atomic_inc_return(&tbstream_hop_seq);
+		hop = TBSTREAM_HOP_ROT_MIN +
+		      seq % (hop_max - TBSTREAM_HOP_ROT_MIN + 1);
+		if (is_tx)
+			ring = tb_ring_alloc_tx(nhi, hop, size, flags);
+		else
+			ring = tb_ring_alloc_rx(nhi, hop, size, flags,
+						e2e_tx_hop, sof_mask, eof_mask,
+						NULL, NULL);
+		if (ring)
+			return ring;
+	}
+
+	/* Exhausted: fall back to automatic allocation. */
+	if (is_tx)
+		return tb_ring_alloc_tx(nhi, -1, size, flags);
+	return tb_ring_alloc_rx(nhi, -1, size, flags, e2e_tx_hop, sof_mask,
+				eof_mask, NULL, NULL);
+}
