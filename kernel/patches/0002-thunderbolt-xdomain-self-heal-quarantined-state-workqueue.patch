+/*
+ * Persistent XDomain properties failure with a healthy local control
+ * channel means the peer host is wedged: its control channel desyncs
+ * (one lost config reply advances the router sequence counters past
+ * the host's; every later exchange is treated as stale) and nothing
+ * short of a link retrain resynchronises it. We cannot heal the
+ * remote host directly, but the shared link can be retrained from
+ * either end by rewriting the local lane adapter target speed. This
+ * resets both link controllers and clears the desync, letting the
+ * peer's XDomain state machine recover without a reboot.
+ *
+ * The counter counts consecutive failed properties attempts (both
+ * EAGAIN retries and give-ups) and must fire within a single failed
+ * retry pass (XDOMAIN_RETRIES = 10), because the stock state machine
+ * parks in XDOMAIN_STATE_ERROR after one pass. Guarded by
+ * have-seen-success so that boot-time handshake failures against a
+ * not-yet-ready peer never force a pointless retrain. Kept as
+ * file-statics (keyed by route) to avoid changing the exported
+ * struct layout; safe because the state work is serialized per
+ * XDomain.
+ */
+#define TBSTREAM_XD_RETRAIN_STREAK	8
+/* Unarmed fallback: a peer that wedged during its boot settle would
+ * otherwise never arm the detector (3 consecutive successes never
+ * happen). ~36 consecutive failed probes ≈ 100+ s — well past any
+ * normal boot settle, short enough to recover promptly. */
+#define TBSTREAM_XD_RETRAIN_STREAK_UNARMED	36
+
+static u64 tb_xd_streak_route;
+static unsigned int tb_xd_streak;
+static bool tb_xd_streak_seen;
+static unsigned int tb_xd_streak_ok;
+static unsigned int tb_xd_retrains;
+
+static void tb_xdomain_force_retrain(struct tb_xdomain *xd);
+
+struct tb_xd_retrain_work {
+	struct work_struct work;
+	struct tb_xdomain *xd;
+};
+
+/*
+ * Runs on system_wq: the lane-adapter writes below are local register
+ * operations, but keeping the retrain out of the XDomain state work
+ * means a slow peer can never stall the thunderbolt workqueue.
+ */
+static void tb_xd_retrain_workfn(struct work_struct *work)
+{
+	struct tb_xd_retrain_work *rw = container_of(work, typeof(*rw), work);
+	struct tb_xdomain *xd = rw->xd;
+	struct tb_port *port = tb_xdomain_downstream_port(xd);
+	u32 val, off;
+	int ret;
+
+	if (port) {
+		ret = tb_port_read(port, &val, TB_CFG_PORT,
+				   port->cap_phy + LANE_ADP_CS_1, 1);
+		if (!ret) {
+			dev_info(&xd->dev,
+				 "peer unresponsive, forcing link disconnect\n");
+
+			/* Lane Disable: the link controller drops the
+			 * link — the software equivalent of unplugging
+			 * the cable, and the only transition that resets
+			 * the router config relay a wedged peer hangs
+			 * on. The peer sees a real unplug/plug sequence
+			 * and re-enumerates. */
+			off = val | LANE_ADP_CS_1_LD;
+			tb_port_write(port, &off, TB_CFG_PORT,
+				      port->cap_phy + LANE_ADP_CS_1, 1);
+			msleep(2000);
+			tb_port_write(port, &val, TB_CFG_PORT,
+				      port->cap_phy + LANE_ADP_CS_1, 1);
+		}
+	}
+
+	tb_xdomain_put(xd);
+	kfree(rw);
+}
+
+static void tb_xdomain_force_retrain(struct tb_xdomain *xd)
+{
+	struct tb_xd_retrain_work *rw;
+
+	rw = kmalloc(sizeof(*rw), GFP_KERNEL);
+	if (!rw)
+		return;
+	rw->xd = tb_xdomain_get(xd);
+	if (!rw->xd) {
+		kfree(rw);
+		return;
+	}
+	INIT_WORK(&rw->work, tb_xd_retrain_workfn);
+	schedule_work(&rw->work);
+}
